 (java.lang.InterruptedException ex) {\n1436:                 project = oldProject;\n1437:                 success = false;\n1438:                 LOG.error(\"Project loading interrupted by user\");\n1439:             } catch (UmlVersionException ex) {\n1440:                 project = oldProject;\n1441:                 success = false;\n1442:                 reportError(\n1443:                         Translator.localize(\n1444:                                 \"dialog.error.file.version.error\",\n1445:                                 new Object[] {ex.getMessage()}),\n1446:                         showUI, ex);\n1447:             } catch (XmiFormatException ex) {\n1448:                 project = oldProject;\n1449:                 success = false;\n1450:                 reportError(\n1451:                         Translator.localize(\n1452:                                 \"dialog.error.xmi.format.error\",\n1453:                                 new Object[] {ex.getMessage()}),\n1454:                         showUI, ex);\n1455:             } catch (Exception ex) {\n1456:                 success = false;\n1457:                 project = oldProject;\n1458:                 LOG.error(\"Exception while loading project\", ex);\n1459:                 reportError(\n1460:                         Translator.localize(\n1461:                                 \"dialog.error.open.error\",\n1462:                                 new Object[] {file.getName()}),\n1463:                         showUI, ex);\n1464:             } finally {\n1465: \n1466:                 if (!LastLoadInfo.getInstance().getLastLoadStatus()) {\n1467:                     project = oldProject;\n1468:                     success = false;\n1469:                     // TODO: This seems entirely redundant\n1470:                     // for now I've made the message more generic, but it\n1471:                     // should be removed at a convenient time - tfm\n1472:                     reportError(\n1473:                             \"Problem loading the project \"\n1474:                             + file.getName()\n1475:                             + \"\\n\"\n1476:                             + \"Error message:\\n\"\n1477:                             + LastLoadInfo.getInstance().getLastLoadMessage()\n1478:                             + \"\\n\"\n1479:                             + \"Some (or all) information may be missing \"\n1480:                             + \"from the project.\\n\"\n1481:                             + \"Please report this problem at \"\n1482:                             + \"http://argouml.tigris.org\\n\",\n1483:                             showUI);\n1484:                 } else if (oldProject != null) {\n1485:                     // if p equals oldProject there was an exception and we do\n1486:                     // not have to gc (garbage collect) the old project\n1487:                     if (project != null && !project.equals(oldProject)) {\n1488:                         //prepare the old project for gc\n1489:                         LOG.info(\"There are \" + oldProject.getMembers().size()\n1490:                                 + \" members in the old project\");\n1491:                         LOG.info(\"There are \" + project.getMembers().size()\n1492:                                 + \" members in the new project\");\n1493:                         // Set new project before removing old so we always have\n1494:                         // a valid current project\n1495:                         ProjectManager.getManager().setCurrentProject(project);\n1496:                         ProjectManager.getManager().removeProject(oldProject);\n1497:                     }\n1498:                 }\n1499: \n1500:                 if (project == null) {\n1501:                     LOG.info(\"The current project is null\");\n1502:                 } else {\n1503:                     LOG.info(\"There are \" + project.getMembers().size()\n1504:                            