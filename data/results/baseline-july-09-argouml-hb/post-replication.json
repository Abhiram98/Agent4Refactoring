 import java.util.List;\n33: import java.util.Set;\n34: import java.util.Vector;\n35: \n36: import org.argouml.kernel.Project;\n37: import org.argouml.kernel.ProjectManager;\n38: import org.argouml.model.ModelFacade;\n39: import org.argouml.model.ModelManagementHelper;\n40: \n41: import ru.novosoft.uml.foundation.core.MModelElement;\n42: import ru.novosoft.uml.foundation.core.MNamespace;\n43: import ru.novosoft.uml.model_management.MModel;\n44: import ru.novosoft.uml.model_management.MSubsystem;\n45: \n46: import org.apache.log4j.Logger;\n47: \n48: /**\n49:  * Helper class for UML ModelManagement Package.<p>\n50:  *\n51:  * Current implementation is a placeholder.<p>\n52:  *\n53:  * @since ARGO0.11.2\n54:  * @author Thierry Lach\n55:  */\n56: class ModelManagementHelperImpl implements ModelManagementHelper {\n57:     /**\n58:      * Logger.\n59:      */\n60:     private static final Logger LOG =\n61: \tLogger.getLogger(ModelManagementHelperImpl.class);\n62: \n63:     /**\n64:      * The model implementation.\n65:      */\n66:     private NSUMLModelImplementation nsmodel;\n67: \n68:     /**\n69:      * Don't allow instantiation.\n70:      *\n71:      * @param implementation To get other helpers and factories.\n72:      */\n73:     ModelManagementHelperImpl(NSUMLModelImplementation implementation) {\n74:         nsmodel = implementation;\n75:     }\n76: \n77:     /**\n78:      * Returns all subsystems found in this namespace and in its children.\n79:      *\n80:      * @param ns is the namespace\n81:      * @return Collection\n82:      */\n83:     public Collection getAllSubSystems(Object ns) {\n84:         if (ns == null) {\n85:             return new ArrayList();\n86:         }\n87:         if (!(ns instanceof MNamespace)) {\n88:             throw new IllegalArgumentException();\n89:         }\n90: \n91:         Iterator it = ((MNamespace) ns).getOwnedElements().iterator();\n92:         List list = new ArrayList();\n93:         while (it.hasNext()) {\n94:             Object o = it.next();\n95:             if (o instanceof MNamespace) {\n96:                 list.addAll(getAllSubSystems(o));\n97:             }\n98:             if (o instanceof MSubsystem) {\n99:                 list.add(o);\n100:             }\n101: \n102:         }\n103:         return list;\n104:     }\n105: \n106:     /**\n107:      * Returns all namespaces found in this namespace and in its children\n108:      *\n109:      * This method is CPU intensive and therefore needs to be as efficient as\n110:      * possible.\n111:      *\n112:      * @param ns namespace to process\n113:      * @return Collection of all namespaces found\n114:      */\n115:     public Collection getAllNamespaces(Object ns) {\n116:         if (ns == null || !(ns instanceof MNamespace)) {\n117:             return new ArrayList();\n118:         }\n119: \n120:         Collection namespaces = ((MNamespace) ns).getOwnedElements();\n121:         // the list of namespaces to return\n122:         List list = Collections.EMPTY_LIST;\n123: \n124:         // if there are no owned elements then return empty list\n125:         if (namespaces == Collections.EMPTY_LIST\n126: \t    || namespaces.size() == 0) {\n127:             return Collections.EMPTY_LIST;\n128:         }\n129: \n130:         // work with an array instead of iterator.\n131:         Object[] nsArray = namespaces.toArray();\n132: \n133:         for (int i = 0; i < nsArray.length; i++) {\n134: \n135:             Object o = nsArray[i];\n136:             if (o instanceof MNamespace) {\n137: \n138:                 // only build a namepace if needed, with\n139:                 if (list == Collections.EMPTY_LIST) {\n140:                     list = new ArrayList(nsArray.length);\n141:                 }\n142: \n143:                 list.add(o);\n144: \n145:                 Collection namespaces1 = getAllNamespaces(o);\n146:                 // only add all if there are some to add.\n147:                 if (namespaces1 != Collections.EMPTY_LIST\n148:                         && namespaces1.size() > 0) {\n149:                     list.addAll(namespaces1);\n150:                 }\n151:             }\n152:         }\n153:         return list;\n154:     }\n155: \n156:     /**\n157:      * Returns all modelelements of the given kind.\n158:      *\n159:      * @param type is the class kind\n160:      * @return Collection\n161:      */\n162:     public Collection getAllModelElementsOfKindWithModel(Object type) {\n163:         Class kind = (Class) type;\n164:         if (kind == null) {\n165:             return Collections.EMPTY_LIST;\n166:         }\n167:         Project p = ProjectManager.getManager().getCurrentProject();\n168:         MNamespace model = (MModel) p.getRoot();\n169:         Collection ret = getAllModelElementsOfKind(model, kind);\n170:         if (kind.isAssignableFrom(model.getClass())) {\n171:             ret = new ArrayList(ret);\n172:             ret.add(model);\n173:         }\n174:         return ret;\n175:     }\n176: \n177:     /**\n178:      * Returns all modelelements found in this namespace and its children\n179:      * that are of some class kind.<p>\n180:      *\n181:      * This method is CPU intensive and therefore needs to be as efficient as\n182:      * possible.<p>\n183:      *\n184:      * @param nsa is the namespace\n185:      * @param type is the class kind\n186:      * @return Collection\n187:      */\n188:     public Collection getAllModelElementsOfKind(Object nsa, Object type) {\n189:         if (type instanceof String) {\n190:             return getAllModelElementsOfKind(nsa, (String) type);\n191:         }\n192:         Class kind = (Class) type;\n193:         if (nsa == null || kind == null) {\n194:             return Collections.EMPTY_LIST;\n195:         }\n196: \n197:         if (!ModelFacade.isANamespace(nsa)) {\n198:             throw new IllegalArgumentException(\n199:                 \"given argument \" + nsa + \" is not a namespace\");\n200:         }\n201: \n202:         Collection elementsCol = ModelFacade.getOwnedElements(nsa);\n203: \n204:         // only continue if there are owned elements\n205:         if (elementsCol == Collections.EMPTY_LIST\n206: \t    || elementsCol.size() == 0) {\n207:             return Collections.EMPTY_LIST;\n208:         }\n209: \n210:         // use array for speed over iterator\n211:         Object[] elements = elementsCol.toArray();\n212:         Object element = null;\n213:         // only instantiate arraylist when needed\n214:         List list = Collections.EMPTY_LIST;\n215: \n216:         for (int i = 0; i < elements.length; i++) {\n217: \n218:             element = elements[i];\n219: \n220:             if (element instanceof MNamespace) {\n221: \n222:                 if (list == Collections.EMPTY_LIST) {\n223:                     list = new ArrayList(elements.length);\n224:                 }\n225: \n226:                 // get child model elements recursively\n227:                 Collection elementsCol1 =\n228: \t\t    getAllModelElementsOfKind(element, kind);\n229: \n230:                 // only add model elements if there are some\n231:                 if (!(elementsCol1 == Collections.EMPTY_LIST)\n232: \t\t    && !(elementsCol1.size() == 0)) {\n233: \n234: \t\t    list.addAll(elementsCol1);\n235: \n236:                 }\n237: \n238:             }\n239:             if (kind.isAssignableFrom(element.getClass())) {\n240: \n241:                 if (list == Collections.EMPTY_LIST) {\n242:                     list = new ArrayList(elements.length);\n243:                 }\n244: \n245:                 list.add(element);\n246:             }\n247:         }\n248:         return list;\n249: \n250:     }\n251: \n252:     /**\n253:      * Helper method for {@link #getAllModelElementsOfKind(Object, Class)}.\n254:      *\n255:      * @param nsa namespace.\n256:      * @param kind name of class to find, this implementation will add the \"M\"\n257:      *             for NSUML.\n258:      * @return a Collection.\n259:      */\n260:     public Collection getAllModelElementsOfKind(Object nsa, String kind) {\n261: \n262:         if (nsa == null || kind == null) {\n263:             return Collections.EMPTY_LIST;\n264:         }\n265:         if (!ModelFacade.isANamespace(nsa)) {\n266:             throw new IllegalArgumentException(\n267:                 \"given argument \" + nsa + \" is not a namespace\");\n268:         }\n269:         Collection col = null;\n270:         try {\n271:             // TODO: This assumes we are working with MThings\n272:             col = getAllModelElementsOfKind(nsa, Class.forName(\"M\" + kind));\n273:         } catch (ClassNotFoundException cnfe) {\n274:             LOG.error(cnfe);\n275:             return Collections.EMPTY_LIST;\n276:         }\n277:         return col;\n278:     }\n279: \n280:     /**\n281:      * Returns all surrounding namespaces of some namespace ns. See\n282:      * section 2.5.3.24 of the UML 1.3 spec for a definition.\n283:      * @param ns to process\n284:      * @return Collection of surrounding namespaces.\n285:      */\n286:     public Collection getAllSurroundingNamespaces(Object ns) {\n287:         if (!(ns instanceof MNamespace)) {\n288:             throw new IllegalArgumentException();\n289:         }\n290: \n291:         Set set = new HashSet();\n292:         set.add(ns);\n293:         MNamespace namespace = ((MNamespace) ns);\n294:         if (namespace.getNamespace() != null) {\n295:             set.addAll(getAllSurroundingNamespaces(namespace.getNamespace()));\n296:         }\n297:         return set;\n298:     }\n299: \n300:     /**\n301:      * @param ns the given namespace\n302:      * @return a collection of all behavioralfeatures in the given namespace\n303:      */\n304:     public Collection getAllBehavioralFeatures(Object ns) {\n305:         Collection classifiers =\n306:             getAllModelElementsOfKind(ns, ModelFacade.CLASSIFIER);\n307:         ArrayList features = new Arra