ava.awt.event.MouseEvent;\n32: import java.beans.PropertyChangeEvent;\n33: import java.beans.PropertyVetoException;\n34: import java.text.ParseException;\n35: import java.util.ArrayList;\n36: import java.util.Collection;\n37: import java.util.Iterator;\n38: import java.util.Vector;\n39: \n40: import javax.swing.Action;\n41: \n42: import org.apache.log4j.Logger;\n43: import org.argouml.i18n.Translator;\n44: import org.argouml.model.AddAssociationEvent;\n45: import org.argouml.model.Model;\n46: import org.argouml.model.RemoveAssociationEvent;\n47: import org.argouml.ui.ArgoJMenu;\n48: import org.argouml.ui.ProjectBrowser;\n49: import org.argouml.ui.targetmanager.TargetManager;\n50: import org.argouml.uml.diagram.ui.ActionAddNote;\n51: import org.argouml.uml.diagram.ui.ActionCompartmentDisplay;\n52: import org.argouml.uml.diagram.ui.ActionEdgesDisplay;\n53: import org.argouml.uml.diagram.ui.AttributesCompartmentContainer;\n54: import org.argouml.uml.diagram.ui.CompartmentFigText;\n55: import org.argouml.uml.diagram.ui.FigAttributesCompartment;\n56: import org.argouml.uml.diagram.ui.FigEmptyRect;\n57: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n58: import org.argouml.uml.diagram.ui.FigStereotypesCompartment;\n59: import org.argouml.uml.generator.ParserDisplay;\n60: import org.tigris.gef.base.Editor;\n61: import org.tigris.gef.base.Globals;\n62: import org.tigris.gef.base.Selection;\n63: import org.tigris.gef.graph.GraphModel;\n64: import org.tigris.gef.presentation.Fig;\n65: import org.tigris.gef.presentation.FigGroup;\n66: import org.tigris.gef.presentation.FigRect;\n67: import org.tigris.gef.presentation.FigText;\n68: \n69: /**\n70:  * Class to display graphics for a UML Class in a diagram.<p>\n71:  */\n72: public class FigClass extends FigClassifierBox\n73:         implements AttributesCompartmentContainer {\n74: \n75:     /**\n76:      * Logger.\n77:      */\n78:     private static final Logger LOG =\n79:         Logger.getLogger(FigClass.class);\n80: \n81:     FigAttributesCompartment attributesFigCompartment;\n82: \n83:     Fig borderFig;\n84: \n85:     /**\n86:      * Text highlighted by mouse actions on the diagram.<p>\n87:      */\n88:     private CompartmentFigText highlightedFigText = null;\n89: \n90:     /**\n91:      * Flag to indicate that we have just been created. This is to fix the\n92:      * problem with loading classes that have stereotypes already\n93:      * defined.<p>\n94:      */\n95:     private boolean newlyCreated = false;\n96: \n97:     /**\n98:      * <p>Manages residency of a class within a component on a deployment\n99:      *   diagram.</p>\n100:      */\n101:     private Object resident =\n102:             Model.getCoreFactory().createElementResidence();\n103: \n104:     ////////////////////////////////////////////////////////////////\n105:     // constructors\n106: \n107:     /**\n108:      * Main constructor for a {@link FigClass}.<p>\n109:      *\n110:      * Parent {@link FigNodeModelElement} will have created the main\n111:      * box {@link #getBigPort()} and its name {@link #getNameFig()}\n112:      * and stereotype (@link #getStereotypeFig()}. This constructor\n113:      * creates a box for the attributes and operations.<p>\n114:      *\n115:      * The properties of all these graphic elements are adjusted\n116:      * appropriately. The main boxes are all filled and have\n117:      * outlines.<p>\n118:      *\n119:      * For reasons I don't understand the stereotype is created in a\n120:      * box with lines. So we have to created a blanking rectangle to\n121:      * overlay the bottom line, and avoid four compartments\n122:      * showing.<p>\n123:      *\n124:      * There is some complex logic to allow for the possibility that\n125:      * stereotypes may not be displayed (unlike operations and\n126:      * attributes this is not a standard thing for UML). Some care is\n127:      * needed to ensure that additional space is not added, each time\n128:      * a stereotyped class is loaded.<p>\n129:      *\n130:      * There is a particular problem when loading diagrams with\n131:      * stereotyped classes. Because we create a FigClass indicating\n132:      * the stereotype is not displayed, we then add extra space for\n133:      * such classes when they are first rendered. This ought to be\n134:      * fixed by correctly saving the class dimensions, but that needs\n135:      * more work. The solution here is to use a simple flag to\n136:      * indicate the FigClass has just been created.<p>\n137:      *\n138:      * <em>Warning</em>. Much of the graphics positioning is hard\n139:      * coded. The overall figure is placed at location (10,10). The\n140:      * name compartment (in the parent {@link FigNodeModelElement} is\n141:      * 21 pixels high. The stereotype compartment is created 15 pixels\n142:      * high in the parent, but we change it to 19 pixels, 1 more than\n143:      * ({@link #STEREOHEIGHT} here. The attribute and operations boxes\n144:      * are created at 19 pixels, 2 more than {@link #ROWHEIGHT}.<p>\n145:      *\n146:      * CAUTION: This constructor (with no arguments) is the only one\n147:      * that does enableSizeChecking(false), all others must set it\n148:      * true.  This is because this constructor is the only one called\n149:      * when loading a project. In this case, the parsed size must be\n150:      * maintained.<p>\n151:      */\n152:     public FigClass() {\n153: \n154:         getBigPort().setLineWidth(0);\n155:         getBigPort().setFillColor(Color.white);\n156: \n157:         // Attributes inside. First one is the attribute box itself.\n158:         attributesFigCompartment =\n159:             new FigAttributesCompartment(10, 30, 60, ROWHEIGHT + 2);\n160: \n161:         // The operations compartment is built in the ancestor FigClassifierBox\n162: \n163:         // Set properties of the stereotype box. Make it 1 pixel higher than\n164:         // before, so it overlaps the name box, and the blanking takes out both\n165:         // lines. Initially not set to be displayed, but this will be changed\n166:         // when we try to render it, if we find we have a stereotype.\n167:         getStereotypeFig().setFilled(false);\n168:         getStereotypeFig().setHeight(STEREOHEIGHT + 1);\n169:         // +1 to have 1 pixel overlap with getNameFig()\n170:         getStereotypeFig().setVisible(true);\n171: \n172:         borderFig = new FigEmptyRect(10, 10, 0, 0);\n173:         borderFig.setLineWidth(1);\n174:         borderFig.setLineColor(Color.black);\n175: \n176:         getStereotypeFig().setLineWidth(0);\n177: \n178:         // Mark this as newly created. This is to get round the problem with\n179:         // creating figs for loaded classes that had stereotypes. They are\n180:         // saved with their dimensions INCLUDING the stereotype, but since we\n181:         // pretend the stereotype is not visible, we add height the first time\n182:         // we render such a class. This is a complete fudge, and really we\n183:         // ought to address how class objects with stereotypes are saved. But\n184:         // that will be hard work.\n185:         newlyCreated = true;\n186: \n187:         // Put all the bits together, suppressing bounds calculations until\n188:         // we're all done for efficiency.\n189:         enableSizeChecking(false);\n190:         setSuppressCalcBounds(true);\n191:         addFig(getBigPort());\n192:         addFig(getStereotypeFig());\n193:         addFig(getNameFig());\n194:         addFig(operationsFig);\n195:         addFig(attributesFigCompartment);\n196:         addFig(borderFig);\n197: \n198:         setSuppressCalcBounds(false);\n199:         // Set the bounds of the figure to the total of the above (hardcoded)\n200:         setBounds(10, 10, 60, 22 + 2 * ROWHEIGHT);\n201:     }\n202: \n203:     /**\n204:      * Constructor for use if this figure is created for an existing class\n205:      * node in the metamodel.\n206:      *\n207:      * @param gm   Not actually used in the current implementation\n208:      *\n209:      * @param node The UML object being placed.\n210:      */\n211:     public FigClass(GraphModel gm, Object node) {\n212:         this();\n213:         setOwner(node);\n214:         enableSizeChecking(true);\n215: \n216:     }\n217: \n218:     /**\n219:      * @see java.lang.Object#clone()\n220:      */\n221:     public Object clone() {\n222:         FigClass figClone = (FigClass) super.clone();\n223:         Iterator thisIter = this.getFigs().iterator();\n224:         Iterator cloneIter = figClone.getFigs().iterator();\n225:         while (thisIter.hasNext()) {\n226:             Fig thisFig = (Fig) thisIter.next();\n227:             Fig cloneFig = (Fig) cloneIter.next();\n228:             if (thisFig == borderFig) {\n229:                 figClone.borderFig = (FigRect) thisFig;\n230:             }\n231:         }\n232:         return figClone;\n233:     }\n234: \n235: \n236:     /**\n237:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#placeString()\n238:      */\n239:     public String placeString() {\n240:         return \"new Class\";\n241:     }\n242: \n243:     ////////////////////////////////////////////////////////////////\n244:     // accessors\n245: \n246:     /**\n247:      * @see org.tigris.gef.presentation.Fig#makeSelection()\n248:      */\n249:     public Selection makeSelection() {\n250:         return new SelectionClass(this);\n251:     }\n252: \n253:     /**\n254:      * Build a collection of menu items relevant for a right-click\n255:      * popup menu on a Class.\n256:      *\n257:      * @param     me     a mouse event\n258:      * @return           a collection of menu items\n259:      *\n260:      * @see org.tigris.gef.ui.PopupGenerator#getPopUpActions(java.awt.event.MouseEvent)\n261:      */\n262:     public Vector getPopUpActions(MouseEvent me) {\n263:         Vector popUpActions = super.getPopUpActions(me);\n264: \n265:         // Add...\n266:         ArgoJMenu addMenu = new ArgoJMenu(\"menu.popup.add\");\n267:         addMenu.add(TargetManager.getInstance().getAddAttributeAction());\n268:         addMenu.add(TargetManager.getInstance().getAddOperationAction());\n269:         addMenu.add(new ActionAddNote());\n270:         addMenu.add(ActionEdgesDisplay.getShowEdges());\n271:         addMenu.add(ActionEdgesDisplay.getHideEdges());\n272:         popUpActions.insertElementAt(addMenu,\n273:             popUpActions.size() - getPopupAddOffset());\n274: \n275:         // Show ...\n276:         ArgoJMenu showMenu = new ArgoJMenu(\"menu.popup.show\");\n277:         Iterator i = ActionCompartmentDisplay.getActions().iterator();\n278:         while (i.hasNext()) {\n279:             showMenu.add((Action) i.next());\n280:         }\n281:         popUpActions.insertElementAt(showMenu,\n282:             popUpActions.size() - getPopupAddOffset());\n283: \n284:         // Modifiers ...\n285:         popUpActions.insertElementAt(\n286:                 buildModifierPopUp(ABSTRACT | LEAF | ROOT | ACTIVE),\n287:                 popUpActions.size() - getPopupAddOffset());\n288: \n289:         // Visibility ...\n290:         popUpActions.insertElementAt(buildVisibilityPopUp(),\n291:                 popUpActions.size() - getPopupAddOffset());\n292: \n293:         return popUpActions;\n294:     }\n295: \n296:     /**\n297:      * @return The bounds of the attributes compartment.\n298:      */\n299:     public Rectangle getAttributesBounds() {\n300:         return attributesFigCompartment.getBounds();\n301:     }\n302: \n303:     /**\n304:      * @return The vector of graphics for operations (if any).\n305:      * First one is the rectangle for the entire operations box.\n306:      */\n307:     private FigAttributesCompartment getAttributesFig() {\n308:         return attributesFigCompartment;\n309:     }\n310: \n311:     /**\n312:      * Returns the status of the attribute field.\n313:      * @return true if the attributes are visible, false otherwise\n314:      *\n315:      * @see org.argouml.uml.diagram.ui.AttributesCompartmentContainer#isAttributesVisible()\n316:      */\n317:     public boolean isAttributesVisible() {\n318:         return getAttributesFig().isVisible();\n319:     }\n320: \n321:     /**\n322:      * @param isVisible true if the attribute compartment is visible\n323:      *\n324:      * @see org.argouml.uml.diagram.ui.AttributesCompartmentContainer#setAttributesVisible(boolean)\n325:      */\n326:     public void setAttributesVisible(boolean isVisible) {\n327:         Rectangle rect = getBounds();\n328: //        int h;\n329: //    \tif (isCheckSize()) {\n330: //    \t    h = ((ROWHEIGHT\n331: //                * Math.max(1, getAttributesFig().getFigs().size() - 1) + 2)\n332: //                * rect.height\n333: //                / getMinimumSize().height);\n334: //        } else {\n335: //            h = 0;\n336: //        }\n337:         if (getAttributesFig().isVisible()) {\n338:             if (!isVisible) {  // hide compartment\n339:                 damage();\n340:                 Iterator it = getAttributesFig().getFigs().iterator();\n341:                 while (it.hasNext()) {\n342:                     ((Fig) (it.next())).setVisible(false);\n343:                 }\n344:                 getAttributesFig().setVisible(false);\n345:                 Dimension aSize = this.getMinimumSize();\n346:                 setBounds(rect.x, rect.y,\n347: \t\t\t  (int) aSize.getWidth(), (int) aSize.getHeight());\n348:             }\n349:         } else {\n350:             if (isVisible) { // show compartement\n351:                 Iterator it = getAttributesFig().getFigs().iterator();\n352:                 while (it.hasNext()) {\n353:                     ((Fig) (it.next())).setVisible(true);\n354:                 }\n355:                 getAttributesFig().setVisible(true);\n356:                 Dimension aSize = this.getMinimumSize();\n357:                 setBounds(rect.x, rect.y,\n358: \t\t\t  (int) aSize.getWidth(), (int) aSize.getHeight());\n359:                 damage();\n360:             }\n361:         }\n362:     }\n363: \n364:     /**\n365:      * @param isVisible true if the operation compartment is visible\n366:      *\n367:      * @see org.argouml.uml.diagram.ui.OperationsCompartmentContainer#setOperationsVisible(boolean)\n368:      */\n369:     public void setOperationsVisible(boolean isVisible) {\n370:         Rectangle rect = getBounds();\n371: //        int h =\n372: //    \t    isCheckSize()\n373: //    \t    ? ((ROWHEIGHT\n374: //                * Math.max(1, getOperationsFig().getFigs().size() - 1) + 2)\n375: //    \t        * rect.height\n376: //    \t        / getMinimumSize().height)\n377: //    \t    : 0;\n378:         if (isOperationsVisible()) { // if displayed\n379:             if (!isVisible) {\n380:                 damage();\n381:                 Iterator it = getOperationsFig().getFigs().iterator();\n382:                 while (it.hasNext()) {\n383:                     ((Fig) (it.next())).setVisible(false);\n384:                 }\n385:                 getOperationsFig().setVisible(false);\n386:                 Dimension aSize = this.getMinimumSize();\n387:                 setBounds(rect.x, rect.y,\n388: \t\t\t  (int) aSize.getWidth(), (int) aSize.getHeight());\n389:             }\n390:         } else {\n391:             if (isVisible) {\n392:                 Iterator it = getOperationsFig().getFigs().iterator();\n393:                 while (it.hasNext()) {\n394:                     ((Fig) (it.next())).setVisible(true);\n395:                 }\n396:                 getOperationsFig().setVisible(true);\n397:                 Dimension aSize = this.getMinimumSize();\n398:                 setBounds(rect.x, rect.y,\n399:                     (int) aSize.getWidth(), (int) aSize.getHeight());\n400:                 damage();\n401:             }\n402:         }\n403:     }\n404: \n405:     /**\n406:      * @see org.tigris.gef.presentation.Fig#setLineWidth(int)\n407:      */\n408:     public void setLineWidth(int w) {\n409:         borderFig.setLineWidth(w);\n410:     }\n411: \n412:     /**\n413:      * @see org.tigris.gef.presentation.Fig#getLineWidth()\n414:      */\n415:     public int getLineWidth() {\n416:         return borderFig.getLineWidth();\n417:     }\n418: \n419:     /**\n420:      * USED BY PGML.tee.\n421:      * @return the class name and bounds together with compartment\n422:      * visibility.\n423:      */\n424:     public String classNameAndBounds() {\n425:         return super.classNameAndBounds()\n426:             + \"operationsVisible=\" + isOperationsVisible() + \";\"\n427:             + \"attributesVisible=\" + isAttributesVisible();\n428:     }\n429: \n430:     /**\n431:      * Gets the minimum size permitted for a class on the diagram.<p>\n432:      *\n433:      * Parts of this are hardcoded, notably the fact that the name\n434:      * compartment has a minimum height of 21 pixels.<p>\n435:      *\n436:      * @return  the size of the minimum bounding box.\n437:      */\n438:     public Dimension getMinimumSize() {\n439:         // Use \"aSize\" to build up the minimum size. Start with the size of the\n440:         // name compartment and build up.\n441: \n442:         Dimension aSize = getNameFig().getMinimumSize();\n443: \n444:         // If we have a stereotype displayed, then allow some space for that\n445:         // (width and height)\n446: \n447:         if (getStereotypeFig().isVisible()) {\n448:             Dimension stereoMin = getStereotypeFig().getMinimumSize();\n449:             aSize.width = Math.max(aSize.width, stereoMin.width);\n450:             aSize.height += stereoMin.height;\n451:         }\n452: \n453:         // Allow space for each of the attributes we have\n454: \n455:         if (getAttributesFig().isVisible()) {\n456:             Dimension attrMin = getAttributesFig().getMinimumSize();\n457:             aSize.width = Math.max(aSize.width, attrMin.width);\n458:             aSize.height += attrMin.height;\n459:         }\n460: \n461:         // Allow space for each of the operations we have\n462: \n463:         if (isOperationsVisible()) {\n464:             Dimension operMin = getOperationsFig().getMinimumSize();\n465:             aSize.width = Math.max(aSize.width, operMin.width);\n466:             aSize.height += operMin.height;\n467:         }\n468: \n469:         // we want to maintain a minimum width for the class\n470:         aSize.width = Math.max(60, aSize.width);\n471: \n472:         // And now aSize has the answer\n473: \n474:         return aSize;\n475:     }\n476:     /**\n477:      * Gets the minimum size permitted for a class on the diagram.<p>\n478:      *\n479:      * @return  the size of the minimum bounding box.\n480:      */\n481:     public Dimension getMinimumSizeSingleStereotype() {\n482: \n483:         // Use \"aSize\" to build up the minimum size. Start with the size of the\n484:         // name compartment and build up.\n485: \n486:         Dimension aSize = getNameFig().getMinimumSize();\n487: \n488:         // If we have a stereotype displayed, then allow some space for that\n489:         // (width and height)\n490: \n491:         if (getStereotypeFig().isVisible()) {\n492:             aSize.width =\n493: \t\tMath.max(aSize.width,\n494: \t\t\t getStereotypeFig().getMinimumSize().width);\n495:             aSize.height += STEREOHEIGHT;\n496:         }\n497: \n498:         // Allow space for each of the attributes we have\n499: \n500:         if (getAttributesFig().isVisible()) {\n501: \n502:             // Loop through all the attributes, to find the widest (remember\n503:             // the first fig is the box for the whole lot, so ignore it).\n504: \n505:             Iterator it = getAttributesFig().getFigs().iterator();\n506:             it.next(); // Ignore first element\n507: \n508:             while (it.hasNext()) {\n509:                 int elemWidth =\n510: \t\t    ((FigText) it.next()).getMinimumSize().width + 2;\n511:                 aSize.width = Math.max(aSize.width, elemWidth);\n512:             }\n513: \n514:             // Height allows one row for each attribute (remember to ignore the\n515:             // first element.\n516: \n517:             aSize.height +=\n518: \t\tROWHEIGHT * Math.max(1,\n519: \t\t        getAttributesFig().getFigs().size() - 1) + 1;\n520:         }\n521: \n522:         // Allow space for each of the operations we have\n523: \n524:         if (isOperationsVisible()) {\n525: \n526:             // Loop through all the operations, to find the widest (remember\n527:             // the first fig is the box for the whole lot, so ignore it).\n528: \n529:             Iterator it = getOperationsFig().getFigs().iterator();\n530:             it.next(); // ignore\n531: \n532:             while (it.hasNext()) {\n533:                 int elemWidth =\n534: \t\t    ((FigText) it.next()).getMinimumSize().width + 2;\n535:                 aSize.width = Math.max(aSize.width, elemWidth);\n536:             }\n537: \n538:             aSize.height +=\n539: \t\tROWHEIGHT * Math.max(1,\n540: \t\t        getOperationsFig().getFigs().size() - 1) + 1;\n541:         }\n542: \n543:         // we want to maintain a minimum width for the class\n544:         aSize.width = Math.max(60, aSize.width);\n545: \n546:         // And now aSize has the answer\n547: \n548:         return aSize;\n549:     }\n550: \n551:     /**\n552:      * @see org.tigris.gef.presentation.Fig#translate(int, int)\n553:      */\n554:     public void translate(int dx, int dy) {\n555:         super.translate(dx, dy);\n556:         Editor ce = Globals.curEditor();\n557:         Selection sel = ce.getSelectionManager().findSelectionFor(this);\n558:         if (sel instanceof SelectionClass) {\n559:             ((SelectionClass) sel).hideButtons();\n560:         }\n561:     }\n562: \n563:     ////////////////////////////////////////////////////////////////\n564:     // user interaction methods\n565: \n566:     /**\n567:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n568:      */\n569:     // TODO: Review - should be keyTyped() - Bob\n570:     public void keyTyped(KeyEvent ke) {\n571:         int key = ke.getKeyCode();\n572:         if (key == KeyEvent.VK_UP || key == KeyEvent.VK_DOWN) {\n573:             CompartmentFigText ft = unhighlight();\n574:             if (ft != null) {\n575:                 int i = new Vector(getAttributesFig().getFigs()).indexOf(ft);\n576:                 FigGroup fg = getAttributesFig();\n577:                 if (i == -1) {\n578:                     i = new Vector(getOperationsFig().getFigs()).indexOf(ft);\n579:                     fg = getOperationsFig();\n580:                 }\n581:                 if (i != -1) {\n582:                     if (key == KeyEvent.VK_UP) {\n583:                         ft = (CompartmentFigText)\n584: \t\t\t    getPreviousVisibleFeature(fg, ft, i);\n585:                     } else {\n586:                         ft = (CompartmentFigText)\n587: \t\t\t    getNextVisibleFeature(fg, ft, i);\n588:                     }\n589:                     if (ft != null) {\n590:                         ft.setHighlighted(true);\n591:                         highlightedFigText = ft;\n592:                         return;\n593:                     }\n594:                 }\n595:             }\n596:         } else if (key == KeyEvent.VK_ENTER && highlightedFigText != null) {\n597:             highlightedFigText.startTextEditor(ke);\n598:             ke.consume();\n599:             return;\n600:         }\n601:         super.keyPressed(ke);\n602:     }\n603: \n604:     ////////////////////////////////////////////////////////////////\n605:     // internal methods\n606: \n607:     /**\n608:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEdited(org.tigris.gef.presentation.FigText)\n609:      */\n610:     protected void textEdited(FigText ft) throws PropertyVetoException {\n611:         super.textEdited(ft);\n612:         Object classifier = getOwner();\n613:         if (classifier == null) {\n614:             return;\n615:         }\n616:         int i = new Vector(getAttributesFig().getFigs()).indexOf(ft);\n617:         if (i != -1) {\n618:             highlightedFigText = (CompartmentFigText) ft;\n619:             highlightedFigText.setHighlighted(true);\n620:             try {\n621:                 Object attribute = highlightedFigText.getOwner();\n622:                 ParserDisplay.SINGLETON.parseAttributeFig(\n623:                         classifier,\n624:                         attribute,\n625:                         highlightedFigText.getText().trim());\n626:                 ProjectBrowser.getInstance().getStatusBar().showStatus(\"\");\n627:             } catch (ParseException pe) {\n628:                 String msg = \"statusmsg.bar.error.parsing.attribute\";\n629:                 Object[] args = {pe.getLocalizedMessage(),\n630:                     new Integer(pe.getErrorOffset())};\n631:                 ProjectBrowser.getInstance().getStatusBar().showStatus(\n632:                         Translator.messageFormat(msg, args));\n633:             }\n634:             return;\n635:         }\n636:         i = new Vector(getOperationsFig().getFigs()).indexOf(ft);\n637:         if (i != -1) {\n638:             highlightedFigText = (CompartmentFigText) ft;\n639:             highlightedFigText.setHighlighted(true);\n640:             try {\n641:                 Object operation = highlightedFigText.getOwner();\n642:                 ParserDisplay.SINGLETON.parseOperationFig(\n643:                     classifier,\n644:                     operation,\n645:                     highlightedFigText.getText().trim());\n646:                 ProjectBrowser.getInstance().getStatusBar().showStatus(\"\");\n647:             } catch (ParseException pe) {\n648:                 String msg = \"statusms