ileOutputStream;\n32: import java.io.IOException;\n33: import java.io.InputStream;\n34: import java.io.OutputStream;\n35: import java.io.OutputStreamWriter;\n36: import java.util.ArrayList;\n37: import java.util.Iterator;\n38: \n39: import org.apache.log4j.Logger;\n40: import org.argouml.i18n.Translator;\n41: import org.argouml.kernel.Project;\n42: import org.argouml.kernel.ProjectManager;\n43: import org.argouml.kernel.ProjectMember;\n44: import org.argouml.model.Model;\n45: import org.argouml.uml.cognitive.ProjectMemberTodoList;\n46: \n47: /**\n48:  * To persist to and from XMI file storage.\n49:  *\n50:  * @author Bob Tarling\n51:  */\n52: public class XmiFilePersister extends AbstractFilePersister implements XmiExtensionParser {\n53:     /**\n54:      * Logger.\n55:      */\n56:     private static final Logger LOG =\n57:         Logger.getLogger(XmiFilePersister.class);\n58: \n59:     private ArrayList pgmlStrings = new ArrayList();\n60:     \n61:     private String todoString;\n62:     \n63:     private String argoString;\n64:     \n65:     /**\n66:      * The constructor.\n67:      */\n68:     public XmiFilePersister() {\n69:     }\n70: \n71:     /**\n72:      * @see org.argouml.persistence.AbstractFilePersister#getExtension()\n73:      */\n74:     public String getExtension() {\n75:         return \"xmi\";\n76:     }\n77: \n78:     /**\n79:      * @see org.argouml.persistence.AbstractFilePersister#getDesc()\n80:      */\n81:     protected String getDesc() {\n82:         return Translator.localize(\"combobox.filefilter.xmi\");\n83:     }\n84: \n85:     /**\n86:      * Save a project to a file in XMI format.\n87:      *\n88:      * @param project the project to save.\n89:      * @param file The file to write.\n90:      * @throws SaveException if anything goes wrong.\n91:      * @throws InterruptedException     if the thread is interrupted\n92:      */\n93:     public void doSave(Project project, File file)\n94:         throws SaveException, InterruptedException {\n95: \n96:         ProgressMgr progressMgr = new ProgressMgr();\n97:         progressMgr.setNumberOfPhases(4);\n98:         progressMgr.nextPhase();\n99:         \n100:         File lastArchiveFile = new File(file.getAbsolutePath() + \"~\");\n101:         File tempFile = null;\n102: \n103:         try {\n104:             tempFile = createTempFile(file);\n105:         } catch (FileNotFoundException e) {\n106:             throw new SaveException(\n107:                     \"Failed to archive the previous file version\", e);\n108:         } catch (IOException e) {\n109:             throw new SaveException(\n110:                     \"Failed to archive the previous file version\", e);\n111:         }\n112: \n113:         OutputStreamWriter writer = null;\n114:         try {\n115:             //project.setFile(file);\n116: \n117:             OutputStream stream = new FileOutputStream(file);\n118:             OutputStream bout = new BufferedOutputStream(stream);\n119:             writer = new OutputStreamWriter(bout, getEncoding());\n120: \n121:             int size = project.getMembers().size();\n122:             for (int i = 0; i < size; i++) {\n123:                 ProjectMember projectMember =\n124:                     (ProjectMember) project.getMembers().get(i);\n125:                 if (projectMember.getType().equalsIgnoreCase(getExtension())) {\n126:                     if (LOG.isInfoEnabled()) {\n127:                         LOG.info(\"Saving member of type: \"\n128:                               + ((ProjectMember) project.getMembers()\n129:                                     .get(i)).getType());\n130:                     }\n131:                     MemberFilePersister persister\n132:                         = new ModelMemberFilePersister();\n133:                     persister.save(projectMember, writer, null);\n134:                 }\n135:             }\n136:             progressMgr.nextPhase();\n137: \n138:             // if save did not raise an exception\n139:             // and name+\"#\" exists move name+\"#\" to name+\"~\"\n140:             // this is the correct backup file\n141:             if (lastArchiveFile.exists()) {\n142:                 lastArchiveFile.delete();\n143:             }\n144:             if (tempFile.exists() && !lastArchiveFile.exists()) {\n145:                 tempFile.renameTo(lastArchiveFile);\n146:             }\n147:             if (tempFile.exists()) {\n148:                 tempFile.delete();\n149:             }\n150:         } catch (InterruptedException exc) {\n151:             throw exc;\n152:         } catch (Exception e) {\n153:             LOG.error(\"Exception occured during save attempt\", e);\n154:             try {\n155:                 writer.close();\n156:             } catch (IOException ex) { }\n157: \n158:             // frank: in case of exception\n159:             // delete name and mv name+\"#\" back to name if name+\"#\" exists\n160:             // this is the \"rollback\" to old file\n161:             file.delete();\n162:             tempFile.renameTo(file);\n163:             // we have to give a message to user and set the system to unsaved!\n164:             throw new SaveException(e);\n165:         }\n166: \n167:         try {\n168:             writer.close();\n169:         } catch (IOException ex) {\n170:             LOG.error(\"Failed to close save output writer\", ex);\n171:         }\n172:         progressMgr.nextPhase();\n173:     }\n174: \n175: \n176:     /**\n177:      * This method creates a project from the specified URL\n178:      *\n179:      * Unlike the constructor which forces an .argo extension This\n180:      * method will attempt to load a raw XMI file\n181:      *\n182:      * This method can fail in several different ways. Either by\n183:      * throwing an exception or by having the\n184:      * ArgoParser.SINGLETON.getLastLoadStatus() set to not true.\n185:      *\n186:      * @param file The file to load the project from.\n187:      * @return The newly loaded project.\n188:      * @throws OpenException if the file can not be opened\n189:      * @throws InterruptedException     if the thread is interrupted\n190:      *\n191:      * @see org.argouml.persistence.ProjectFilePersister#doLoad(java.io.File)\n192:      */\n193:     public Project doLoad(File file)\n194:         throws OpenException, InterruptedException {\n195: \n196:         ProgressMgr progressMgr = new ProgressMgr();\n197:         progressMgr.setNumberOfPhases(3);\n198:         progressMgr.nextPhase();\n199: \n200:         try {\n201:             Project p = new Project();\n202:             XMIParser.getSingleton().readModels(p, file.toURL(), this);\n203:             Object model = XMIParser.getSingleton().getCurModel();\n204:             progressMgr.nextPhase();\n205:             Model.getUmlHelper().addListenersToModel(model);\n206:             p.setUUIDRefs(XMIParser.getSingleton().getUUIDRefs());\n207:             p.addMember(model);\n208:             parseXmiExtensions(p);\n209:             XMIParser.getSingleton().registerDiagrams(p);\n210:             \n211:             p.setRoot(model);\n212:             progressMgr.nextPhase();\n213:             ProjectManager.getManager().setSaveEnabled(false);\n214:             return p;\n215:         } catch (IOException e) {\n216:             throw new OpenException(e);\n217:         }\n218:     }\n219: \n220:     /**\n221:      * Returns true. All Argo specific files have an icon.\n222:      * \n223:      * @see org.argouml.persistence.AbstractFilePersister#hasAnIcon()\n224:      */\n225:     public boolean hasAnIcon() {\n226:         return true;\n227:     }\n228: \n229:     /**\n230:      * Parse a string of XML that is the XMI.extension contents.\n231:      * This implementation simply stores the xml strings to process\n232:      * in one hit after all the standard XMI has been read.\n233:      * @see org.argouml.persistence.XmiExtensionParser#parse(java.lang.String, java.lang.String)\n234:      */\n235:     public void parse(String label, String xmiExtensionString) {\n236:         if (label.equals(\"pgml\")) {\n237:             pgmlStrings.add(xmiExtensionString);\n238:         } else if (label.equals(\"argo\")) {\n239:             argoString = xmiExtensionString;\n240:         } else if (label.equals(\"todo\")) {\n241:             todoString = xmiExtensionString;\n242:         }\n243:     }\n244: \n245:     /**\n246:      * Parse all the extensions that were found when reading XMI\n247:      */\n248:     public void parseXmiExtensions(Project project) throws OpenException {\n249:         \n250:         if (argoString != null) {\n251:             LOG.info(\"Parsing argoString \" + argoString.length());\n252:             InputStream inputStream = new ByteArrayInputStream(todoString.getBytes());\n253:             ArgoParser parser = new ArgoParser();\n254:             try {\n255:                 parser.readProject(project, inputStream);\n256:             } catch (Exception e) {\n257:                 throw new OpenException(\"Exception caught\", e);\n258:             }\n259:         } else {\n260:             project.addMember(new ProjectMemberTodoList(\"\", project));\n261:         }\n262:         for (Iterator it = pgmlStrings.iterator(); it.hasNext(); ) {\n263:             String pgml = (String) it.next();\n264:             LOG.info(\"Parsing pgml \" + pgml.length());\n265:             InputStream inputStream = new ByteArrayInputStream(pgml.getBytes());\n266:             MemberFilePersister persister =\n267:                 PersistenceManager.getInstance()\n268:                         .getDiagramMemberFilePersister();\n269:             persister.load(project, inputStream);\n270:         }\n271:         if (todoString != null) {\n272:             LOG.info(\"Parsing todoString \" + todoString.length());\n273:             InputStream inputStream = new ByteArrayInputStream(todoString.getBytes());\n274:             MemberFilePersister persister = null;\n275:             persister = new TodoListMemberFilePersister();\n276:             persister.load(project, inputStream);\n277:         } else {\n278:             project.addMember(new ProjectMemberTodoList(\"\", project));\n279:         }\n280:     }\n281: }",
