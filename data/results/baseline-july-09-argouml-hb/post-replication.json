event.*;\n33: import java.util.*;\n34: import java.beans.*;\n35: \n36: import ru.novosoft.uml.foundation.core.*;\n37: import ru.novosoft.uml.foundation.data_types.*;\n38: \n39: import org.apache.log4j.Category;\n40: import org.tigris.gef.base.*;\n41: import org.tigris.gef.presentation.*;\n42: import org.tigris.gef.graph.*;\n43: \n44: /** A Mode to interpret user input while creating an edge.  Basically\n45:  *  mouse down starts creating an edge from a source port Fig, mouse\n46:  *  motion paints a rubberband line, mouse up finds the destination port\n47:  *  and finishes creating the edge and makes an FigEdge and sends\n48:  *  it to the back of the Layer.\n49:  *\n50:  *  The argument \"edgeClass\" determines the type if edge to suggest\n51:  *  that the Editor's GraphModel construct.  The GraphModel is\n52:  *  responsible for acutally making an edge in the underlying model\n53:  *  and connecting it to other model elements. */\n54: \n55: public class ModeCreateEdgeAndNode extends ModeCreate {\n56:     protected static Category cat = Category.getInstance(ModeCreateEdgeAndNode.class);\n57:   ////////////////////////////////////////////////////////////////\n58:   // static variables\n59:   public static int Drags_To_Existing = 0;\n60:   public static int Drags_To_New = 0;\n61: \n62:   ////////////////////////////////////////////////////////////////\n63:   // instance variables\n64: \n65:   /** The NetPort where the arc is paintn from */\n66:   private Object _startPort;\n67: \n68:   /** The Fig that presents the starting NetPort */\n69:   private Fig _startPortFig;\n70: \n71:   /** The FigNode on the NetNode that owns the start port */\n72:   private FigNode _sourceFigNode;\n73: \n74:   /** The new NetEdge that is being created */\n75:   private Object _newEdge;\n76: \n77:   /** False if drawing from source and destination.  True if drawing\n78:    *  from destination to source. */\n79:   private boolean _destToSource = false;\n80: \n81:   /** The number of points added so far. */\n82:   //protected int _npoints = 0;\n83:   protected Handle _handle = new Handle(-1);\n84: \n85:   protected FigNode _fn;\n86: \n87:   protected FigEdge _fe;\n88: \n89:   protected boolean _postProcessEdge = false;\n90: \n91:   ////////////////////////////////////////////////////////////////\n92:   // constructor\n93: \n94:   public ModeCreateEdgeAndNode() { super(); }\n95:   public ModeCreateEdgeAndNode(Editor ed, Class edgeClass,\n96: \t\t\t       Class nodeClass, boolean post) {\n97:     super(ed);\n98:     setArg(\"edgeClass\", edgeClass);\n99:     setArg(\"nodeClass\", nodeClass);\n100:     _postProcessEdge = post;\n101:   }\n102: \n103:   ////////////////////////////////////////////////////////////////\n104:   // accessors\n105: \n106:   public void setup(FigNode fn, Object port, int x, int y, boolean reverse) {\n107:     start();\n108:     _sourceFigNode = fn;\n109:     _startPortFig = fn.getPortFig(port);\n110:     _startPort = port;\n111:     _newItem = createNewItem(null, x, y);\n112:     _destToSource = reverse;\n113:     setCursor(Cursor.getPredefinedCursor(Cursor.CROSSHAIR_CURSOR));\n114:   }\n115: \n116:   ////////////////////////////////////////////////////////////////\n117:   // Mode API\n118: \n119:   public String instructions() {\n120:     return \"Drag to define an edge (and a new node)\";\n121:   }\n122: \n123:   ////////////////////////////////////////////////////////////////\n124:   // ModeCreate API\n125: \n126:   /** Create the new item that will be drawn. In this case I would\n127:    *  rather create the FigEdge when I am done. Here I just\n128:    *  create a rubberband FigLine to show during dragging. */\n129:   public Fig createNewItem(MouseEvent me, int snapX, int snapY) {\n130:     FigPoly p = new FigPoly(snapX, snapY);\n131:     p.setLineColor(Globals.getPrefs().getRubberbandColor());\n132:     p.setFillColor(null);\n133:     p.addPoint(snapX, snapY); // add the first point twice\n134:     //_npoints = 2;\n135:     return p;\n136:   }\n137: \n138:   public void done() {\n139:     super.done();\n140:     if (_newItem != null) editor.damaged(_newItem);\n141:     _newItem = null;// use this as the fig for the new FigEdge\n142:     _sourceFigNode = null;\n143:     _startPort = null;\n144:     _startPortFig = null;\n145:   }\n146: \n147:   ////////////////////////////////////////////////////////////////\n148:   // mouse event handlers\n149: \n150:   /** On mousePressed determine what port the user is dragging from.\n151:    *  The mousePressed event is sent via ModeSelect. */\n152:   public void mousePressed(MouseEvent me) {\n153:   }\n154: \n155:   /** On mouseReleased, find the destination port, ask the GraphModel\n156:    *  to connect the two ports.  If that connection is allowed, then\n157:    *  construct a new FigEdge and add it to the Layer and send it to\n158:    *  the back. */\n159: \tpublic void mouseReleased(MouseEvent me) {\n160: \t\tif (me.isConsumed()) return;\n161: \t\tif (_sourceFigNode == null) { done(); return; }\n162: \t\tboolean nodeWasCreated = false;\n163: \n164: \t\tint x = me.getX(), y = me.getY();\n165: \t\tClass arcClass;\n166: \t\tEditor ce = Globals.curEditor();\n167: \t\tFig f = ce.hit(x, y);\n168: \t\tif (f == null) { f = ce.hit(x-16, y-16, 32, 32); }\n169: \t\tGraphModel gm = ce.getGraphModel();\n170: \t\tif (!(gm instanceof MutableGraphModel)) f = null;\n171: \t\tMutableGraphModel mgm = (MutableGraphModel) gm;\n172: \t\t// TODO: potential class cast exception\n173: \n174: \t\tif (f == null) {\n175: \t\t\tcat.debug(\"make new node\");\n176: \t\t\tDrags_To_New++;\n177: \t\t\tObject newNode = null;\n178: \t\t\tClass nodeClass = (Class) getArg(\"nodeClass\");\n179: \t\t\ttry { newNode = nodeClass.newInstance(); }\n180: \t\t\tcatch (java.lang.IllegalAccessException ignore) { return; }\n181: \t\t\tcatch (java.lang.InstantiationException ignore) { return; }\n182: \n183: \t\t\tif (newNode instanceof GraphNodeHooks)\n184: \t\t\t\t((GraphNodeHooks)newNode).initialize(_args);\n185: \n186: \t\t\tif (mgm.canAddNode(newNode)) {\n187: \t\t\t\tGraphNodeRenderer renderer = editor.getGraphNodeRenderer();\n188: \t\t\t\tLayer lay = editor.getLayerManager().getActiveLayer();\n189: \t\t\t\t_fn = renderer.getFigNodeFor(gm, lay, newNode);\n190: \t\t\t\teditor.add(_fn);\n191: \t\t\t\tmgm.addNode(newNode);\n192: \t\t\t\tFig encloser = null;\n193: \t\t\t\tRectangle bbox = _fn.getBounds();\n194: \t\t\t\tVector otherFigs = lay.getContents();\n195: \t\t\t\tjava.util.Enumeration others = otherFigs.elements();\n196: \t\t\t\twhile (others.hasMoreElements()) {\n197: \t\t\t\t\tFig otherFig = (Fig) others.nextElement();\n198: \t\t\t\t\tif (!(otherFig instanceof FigNode)) continue;\n199: \t\t\t\t\tif (otherFig.equals(_fn)) continue;\n200: \t\t\t\t\tRectangle trap = otherFig.getTrapRect();\n201: \t\t\t\t\tif (trap != null && (trap.contains(bbox.x, bbox.y) &&\n202: \t\t\t\t\t\t\t\t\t\t trap.contains(bbox.x + bbox.width,\n203: \t\t\t\t\t\t\t\t\t\t\t\t\t   bbox.y + bbox.height)))\n204: \t\t\t\t\t\tencloser = otherFig;\n205: \t\t\t\t}\n206: \t\t\t\t_fn.setEnclosingFig(encloser);\n207: \t\t\t\tif (newNode instanceof GraphNodeHooks)\n208: \t\t\t\t\t((GraphNodeHooks)newNode).postPlacement(editor);\n209: \t\t\t\teditor.getSelectionManager().select(_fn);\n210: \t\t\t\tnodeWasCreated = true;\n211: \t\t\t\tf = _fn;\n212: \t\t\t\tf.setLocation(x - f.getWidth() / 2, y - f.getHeight() / 2);\n213: \t\t\t}\n214: \t\t}\n215: \t\telse {\n216: \t\t\tDrags_To_Existing++;\n217: \t\t}\n218: \n219: \n220: \t\tif (f instanceof FigNode) {\n221: \t\t\tFigNode destFigNode = (FigNode) f;\n222: \t\t\t// If its a FigNode, then check within the  \n223: \t\t\t// FigNode to see if a port exists \n224: \t\t\tObject foundPort = destFigNode.deepHitPort(x, y);\n225: \t\t\tif (foundPort == null) {\n226: \t\t\t\tVector portFigs = destFigNode.getPortFigs();\n227: \t\t\t\tif (portFigs.size() > 0)\n228: \t\t\t\t\tfoundPort = ((Fig)portFigs.elementAt(0)).getOwner();\n229: \t\t\t}\n230: \t\t\t\n231: \t\t\tFigPoly p = (FigPoly) _newItem;\n232: \t\t\teditor.damaged(p);\n233: \t\t\tp._isComplete = true;\n234: \n235: \t\t\tif (foundPort != null && foundPort != _startPort) {\n236: \t\t\t\tFig destPortFig = destFigNode.getPortFig(foundPort);\n237: \t\t\t\tClass edgeClass = (Class) getArg(\"edgeClass\");\n238: \t\t\t\tif (_destToSource) {\n239: \t\t\t\t\tObject temp = _startPort;\n240: \t\t\t\t\t_startPort = foundPort;\n241: \t\t\t\t\tfoundPort = temp;\n242: \t\t\t\t\tFigNode tempFN = destFigNode;\n243: \t\t\t\t\tdestFigNode = _sourceFigNode;\n244: \t\t\t\t\t_sourceFigNode = tempFN;\n245: \t\t\t\t\tFig tempFigPort = _startPortFig;\n246: \t\t\t\t\t_startPortFig = destPortFig;\n247: \t\t\t\t\tdestPortFig = tempFigPort;\n248: \t\t\t\t}\n249: \t\t\t\tif (edgeClass != null) {\n250: \t\t\t\t\t_newEdge = mgm.connect(_startPort, foundPort, edgeClass); }\n251: \t\t\t\telse\n252: \t\t\t\t\t_newEdge = mgm.connect(_startPort, foundPort);\n253: \n254: \t\t\t\t// Calling connect() will add the edge to the GraphModel and\n255: \t\t\t\t// any LayerPersectives on that GraphModel will get a\n256: \t\t\t\t// edgeAdded event and will add an appropriate FigEdge\n257: \t\t\t\t// (determined by the GraphEdgeRenderer).\n258: \n259: \t\t\t\tif (_newEdge != null) {\n260: \t\t\t\t\tif (_postProcessEdge) postProcessEdge();\n261: \t\t\t\t\tce.damaged(_newItem);\n262: \t\t\t\t\t_sourceFigNode.damage();\n263: \t\t\t\t\tdestFigNode.damage();\n264: \n265: \t\t\t\t\tLayerManager lm = ce.getLayerManager();\n266: \t\t\t\t\t_fe = (FigEdge) lm.getActiveLayer().presentationFor(_newEdge);\n267: \t\t\t\t\t_newItem.setLineColor(Color.black);\n268: \t\t\t\t\t_fe.setLineColor(Color.black);\n269: \t\t\t\t\t_fe.setFig(_newItem);\n270: \t\t\t\t\t_fe.setSourcePortFig(_startPortFig);\n271: \t\t\t\t\t_fe.setSourceFigNode(_sourceFigNode);\n272: \t\t\t\t\t_fe.setDestPortFig(destPortFig);\n273: \t\t\t\t\t_fe.setDestFigNode(destFigNode);\n274: \t\t\t\t\t_fe.setSourcePortFig(_startPortFig);\n275: \t\t\t\t\t_fe.setSourceFigNode(_sourceFigNode);\n276: \t\t\t\t\t_fe.setDestPortFig(destPortFig);\n277: \t\t\t\t\t_fe.setDestFigNode(destFigNode);\n278: \t\t\t\t\tif (_fe != null && !nodeWasCreated)\n279: \t\t\t\t\t\tce.getSelectionManager().select(_fe);\n280: \t\t\t\t\tdone();\n281: \t\t\t\t\t//me.consume();\n282: \t\t\t\t\t_newItem = null;\n283:                                         \n284:                                          if (_fe instanceof MouseListener) ((MouseListener) _fe).mouseReleased(me);\n285: \n286:                                         // set the new edge in place\n287:                                         if (_sourceFigNode != null) _sourceFigNode.updateEdges();\n288:                                         if (destFigNode != null) destFigNode.updateEdges();\n289: \n290: \t\t\t\t\treturn;\n291: \t\t\t\t}\n292: \t\t\t\telse\n293: \t\t\t\t\tcat.warn(\"connection return null\");\n294: \t\t\t}\n295: \t\t\telse\n296: \t\t\t\tcat.warn(\"in dest node but no port\");\n297: \t\t}\n298: \n299: \t\t_sourceFigNode.damage();\n300: \t\tce.damaged(_newItem);\n301: \t\t_newItem = null;\n302: \t\tdone();\n303: \t\t//me.consume();\n304: \t}\n305: \n306: \tpublic void mouseMoved(MouseEvent me) {\n307: \t\tmouseDragged(me);\n308: \t}\n309: \n310: \tpublic void mouseDragged(MouseEvent me) {\n311: \t\tif (me.isConsumed()) return;\n312: \t\tint x = me.getX(), y = me.getY();\n313: \t\t//if (_npoints == 0) { me.consume(); return; }\n314: \t\tif (_newItem == null) { me.consume(); return; }\n315: \t\tFigPoly p = (FigPoly)_newItem;\n316: \t\teditor.damaged(_newItem); // startTrans?\n317: \t\tPoint snapPt = new Point(x, y);\n318: \t\teditor.snap(snapPt);\n319: \t\t_handle.index = p.getNumPoints() - 1;\n320: \t\tp.moveVertex(_handle, snapPt.x, snapPt.y, true);\n321: \t\teditor.damaged(_newItem); // endTrans?\n322: \t\tme.consume();\n323: \t}\n324: \n325: \t////////////////////////////////////////////////////////////////\n326: \t// key events\n327: \n328: \tpublic void keyTyped(KeyEvent ke) {\n329: \t\tif (ke.getKeyChar() == '\u001b') { // escape\n330: \t\t\tdone();\n331: \t\t\tke.consume();\n332: \t\t}\n333: \t}\n334: \n335: \t////////////////////////////////////////////////////////////////\n336: \t// internal methods\n337: \n338: \tpublic void postProcessEdge() {\n339: \t\tif (_newEdge instanceof MAssociation) {\n340: \t\t\tjava.util.List conn = ((MAssociation)_newEdge).getConnections();\n341: \t\t\tMAssociationEnd ae0 = (MAssociationEnd) conn.get(0);\n342: \t\t\tae0.setAggregation(MAggregationKind.COMPOSITE);\n343: \t\t}\n344: \t}\n345: \n346: \tstatic final long serialVersionUID = -427957543380196265L;\n347: } /* end class ModeCreateEdgeAndNode */\n348: ",
