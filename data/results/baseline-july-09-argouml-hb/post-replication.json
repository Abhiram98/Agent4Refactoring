79: import org.xml.sax.InputSource;\n80: import org.xml.sax.SAXException;\n81: \n82: /**\n83:  * A datastructure that represents the designer's current project.  A\n84:  *  Project consists of diagrams and UML models.\n85:  */\n86: public class Project implements java.io.Serializable, TargetListener {\n87: \n88:     /** logger */\n89:     private static final Logger LOG = Logger.getLogger(Project.class);\n90:     \n91:     ////////////////////////////////////////////////////////////////\n92:     // constants\n93: \n94:     private static final String ARGO_TEE = \"/org/argouml/xml/dtd/argo.tee\";\n95: \n96:     /**\n97:      * Default name for a project.\n98:      */\n99:     private static final String UNTITLED_FILE = \"Untitled\";\n100: \n101:     ////////////////////////////////////////////////////////////////\n102:     // static variables\n103:     \n104:     /**\n105:      * This is used in the save process for PGML.\n106:      */\n107:     protected static OCLExpander expander;\n108: \n109:     static final long serialVersionUID = 1399111233978692444L;\n110: \n111:     ////////////////////////////////////////////////////////////////\n112:     // instance variables\n113: \n114:     /** TODO: should just be the directory to write\n115:      */\n116:     private URL url;\n117:     protected ChangeRegistry saveRegistry;\n118: \n119:     private String authorname;\n120:     private String description;\n121:     private String version;\n122: \n123:     private Vector searchpath;\n124:     private Vector members;\n125:     private String historyFile;\n126: \n127:     /**\n128:      * The version number of the persistence format that last\n129:      * saved this project.\n130:      */\n131:     private int persistenceVersion;\n132: \n133:     /**\n134:      * Instances of the uml model.\n135:      */\n136:     private Vector models;\n137: \n138:     /**\n139:      * Instances of the uml diagrams.\n140:      */\n141:     private Vector diagrams;\n142:     private Object defaultModel;\n143:     private boolean needsSave;\n144:     private Object currentNamespace;\n145:     private HashMap uuidRefs;\n146:     private GenerationPreferences cgPrefs;\n147:     private transient VetoableChangeSupport vetoSupport;\n148: \n149:     /**\n150:      * The root of the modeltree the user is working on. (The untitled_model in\n151:      * the navpane).\n152:      */\n153:     private Object treeRoot;\n154:     \n155:     /**\n156:      * The active diagram, pointer to a diagram in the list with diagrams.\n157:      */\n158:     private ArgoDiagram activeDiagram;\n159: \n160:     /** Cache for the default model.\n161:      */\n162:     private HashMap defaultModelCache;\n163: \n164:     /**\n165:      * Constructor.\n166:      * \n167:      * @param file File to read from.\n168:      * @throws MalformedURLException if the file name is incorrect.\n169:      * @throws IOException if we cannot read the file.\n170:      */\n171:     public Project(File file) throws MalformedURLException, IOException {\n172:         this(Util.fileToURL(file));\n173:     }\n174: \n175:     /**\n176:      * Constructor.\n177:      *\n178:      * @param theProjectUrl Url to read the project from.\n179:      */\n180:     public Project(URL theProjectUrl) {\n181:         this();\n182:         url = Util.fixURLExtension(theProjectUrl, \n183:                 FileConstants.COMPRESSED_FILE_EXT);\n184:         saveRegistry = new UMLChangeRegistry();\n185: \n186:     }\n187: \n188:     /**\n189:      * Constructor.\n190:      */\n191:     public Project() {\n192:         \n193:         authorname = \"\";\n194:         description = \"\";\n195:         // this should be moved to a ui action.\n196:         version = ArgoVersion.getVersion();\n197:         \n198:         searchpath = new Vector();\n199:         members = new Vector();\n200:         historyFile = \"\";\n201:         models = new Vector();\n202:         diagrams = new Vector();\n203:         cgPrefs = new GenerationPreferences();\n204:         defaultModelCache = new HashMap();\n205:         \n206:         saveRegistry = new UMLChangeRegistry();\n207:         LOG.info(\"making empty project with empty model\");\n208:         // Jaap Branderhorst 2002-12-09\n209:         // load the default model\n210:         // this is NOT the way how it should be since this makes argo\n211:         // depend on Java even more.\n212:         setDefaultModel(ProfileJava.loadProfileModel());\n213:         addSearchPath(\"PROJECT_DIR\");\n214:         setNeedsSave(false);\n215:         TargetManager.getInstance().addTargetListener(this);\n216: \n217:     }\n218: \n219:     /**\n220:      * Makes a just created project to an untitled project with a\n221:      * class diagram and a usecase diagram and an untitled model.\n222:      */\n223:     protected void makeUntitledProject() {\n224:         if (getRoot() != null)\n225:             throw new IllegalStateException(\"Tried to make a non-empty project \"\n226: \t\t\t\t\t    + \"to an untitled project\");\n227:         Object model =\n228:             UmlFactory.getFactory().getModelManagement().createModel();\n229:         ModelFacade.setName(model, \"untitledModel\");\n230:         setRoot(model);\n231:         setCurrentNamespace(model);\n232:         addMember(new ProjectMemberTodoList(\"\", this));\n233:         addMember(new UMLClassDiagram(model));\n234:         addMember(new UMLUseCaseDiagram(model));\n235:         setNeedsSave(false);       \n236:         setActiveDiagram((ArgoDiagram) getDiagrams().get(0));\n237:     }\n238:  \n239:     /**\n240:      * Constructor.\n241:      * \n242:      * @param model The new model.\n243:      */\n244:     public Project(Object model) {\n245:         this();\n246:         \n247:         if (!ModelFacade.isAModel(model)) {\n248:             throw new IllegalArgumentException();\n249: \t}\n250:         \n251:         LOG.info(\"making empty project with model: \"\n252: \t\t + ModelFacade.getName(model));\n253:         setRoot(model);\n254:         setCurrentNamespace(model);\n255:         setNeedsSave(false);\n256: \n257:     }\n258:     \n259:     /**\n260:      * Loads a model (XMI only) from a .zargo file. BE ADVISED this\n261:      * method has a side effect. It sets _UUIDREFS to the model.\n262:      * \n263:      * If there is a problem with the xmi file, an error is set in the\n264:      * ArgoParser.SINGLETON.getLastLoadStatus() field. This needs to be\n265:      * examined by the calling function.\n266:      *\n267:      * @param theUrl The url with the .zargo file\n268:      * @return MModel The model loaded\n269:      * @throws IOException Thrown if the model or the .zargo file is corrupted.\n270:      * @throws SAXException If the parser template is syntactically incorrect. \n271:      * @throws ParserConfigurationException If the initialization of \n272:      *         the parser fails.\n273:      */\n274:     protected Object loadModelFromXMI(URL theUrl)\n275:         throws IOException, SAXException, ParserConfigurationException {\n276:         ZipInputStream zis = new ZipInputStream(theUrl.openStream());\n277: \n278:         String name = zis.getNextEntry().getName();\n279:         while (!name.endsWith(\".xmi\")) {\n280:             name = zis.getNextEntry().getName();\n281:         }\n282:         \n283:         if (LOG.isInfoEnabled()) {\n284:             LOG.info(\"Loading Model from \" + theUrl);\n285:         }\n286:         // 2002-07-18\n287:         // Jaap Branderhorst\n288:         // changed the loading of the projectfiles to solve hanging \n289:         // of argouml if a project is corrupted. Issue 913\n290:         // Created xmireader with method getErrors to check if parsing went well\n291:         XMIReader xmiReader = null;\n292:         try {\n293:             xmiReader = new XMIReader();\n294:         } catch (SAXException se) { // duh, this must be caught and handled\n295:             LOG.error(\"SAXException caught\", se);\n296:             throw se;\n297:         } catch (ParserConfigurationException pc) { \n298: \t        // duh, this must be caught and handled\n299:             LOG.error(\"ParserConfigurationException caught\", pc);\n300:             throw pc;\n301:         }\n302:         Object mmodel = null;\n303: \n304:         InputSource source = new InputSource(zis);\n305:         source.setEncoding(\"UTF-8\");\n306:         mmodel = xmiReader.parseToModel(source);        \n307:         if (xmiReader.getErrors()) {\n308:             ArgoParser.SINGLETON.setLastLoadStatus(false);\n309:             ArgoParser.SINGLETON.setLastLoadMessage(\"XMI file \" + theUrl\n310: \t\t\t\t\t\t    + \" could not be parsed.\");\n311:             LOG.error(\"XMI file \" + theUrl + \" could not be parsed.\");\n312:             throw new SAXException(\n313:                     \"XMI file \" + theUrl + \" could not be parsed.\");\n314:         }\n315: \n316:         // This should probably be inside xmiReader.parse\n317:         // but there is another place in this source\n318:         // where XMIReader is used, but it appears to be\n319:         // the NSUML XMIReader.  When Argo XMIReader is used\n320:         // consistently, it can be responsible for loading\n321:         // the listener.  Until then, do it here.\n322:         UmlHelper.getHelper().addListenersToModel(mmodel);\n323: \n324:         addMember(mmodel);\n325: \n326:         uuidRefs = new HashMap(xmiReader.getXMIUUIDToObjectMap());\n327:         return mmodel;\n328:     }\n329: \n330:     /**\n331:      * Loads all the members from a zipped input stream.\n332:      *\n333:      * @param theUrl The URL to the input stream.\n334:      * @throws IOException if there is something wrong with the zipped archive\n335:      *                     or with the model.\n336:      * @throws ParserConfigurationException if the parser is misconfigured.\n337:      * @throws SAXException if the input is not correctly formatted XML.\n338:      */\n339:     protected void loadZippedProjectMembers(URL theUrl)\n340:         throws IOException, ParserConfigurationException, SAXException {\n341: \n342:         loadModelFromXMI(theUrl); // throws a IOException if things go wrong\n343:         // user interface has to handle that one\n344:         try {\n345: \n346:             // now close again, reopen and read the Diagrams.\n347: \n348:             PGMLParser.SINGLETON.setOwnerRegistry(uuidRefs);\n349: \n350:             //zis.close();\n351:             ZipInputStream zis = new ZipInputStream(theUrl.openStream());\n352:             SubInputStream sub = new SubInputStream(zis);\n353: \n354:             ZipEntry currentEntry = null;\n355:             while ((currentEntry = sub.getNextEntry()) != null) {\n356:                 if (currentEntry.getName().endsWith(\".pgml\")) {\n357:                     if (LOG.isInfoEnabled()) {\n358:                         LOG.info(\"Now going to load \"\n359:                                  + currentEntry.getName()\n360:                                  + \" from ZipInputStream\");\n361:                     }\n362: \n363:                     // \"false\" means the stream shall not be closed,\n364:                     // but it doesn't seem to matter...\n365:                     ArgoDiagram d =\n366:                         (ArgoDiagram) PGMLParser.SINGLETON.readDiagram(\n367: \t\t\t\t\t\t\t\t      sub,\n368: \t\t\t\t\t\t\t\t      false);\n369:                     if (d != null) {                  \n370:                         addMember(d);\n371:                     }\n372:                     else {\n373:                         LOG.error(\"An error occurred while loading \" \n374:                             + currentEntry.getName());\n375:                     }\n376:                     // sub.closeEntry();\n377:                     if (LOG.isInfoEnabled()) {\n378:                         LOG.info(\"Finished loading \" + currentEntry.getName());\n379:                     }\n380:                 }\n381:                 if (currentEntry.getName().endsWith(\".todo\")) {\n382:                     ProjectMemberTodoList pm =\n383:                         new ProjectMemberTodoList(currentEntry.getName(), this);\n384:                     pm.load(sub);\n385:                     addMember(pm);\n386:                 }\n387:             }\n388:             zis.close();\n389: \n390: \t} catch (IOException e) {\n391:             ArgoParser.SINGLETON.setLastLoadStatus(false);\n392:             ArgoParser.SINGLETON.setLastLoadMessage(e.toString());\n393:             LOG.error(\"Something went wrong in \" \n394: \t\t              + \"Project.loadZippedProjectMembers()\", e);\n395:             throw e;\n396:         }\n397:     }\n398: \n399:     /**\n400:      * Find the base name of this project.<p>\n401:      * \n402:      * Previous javadoc comment that Linus don't understand:\n403:      * Added Eugenio's patches to load 0.8.1 projects.\n404:      * \n405:      * @return The name (a String).\n406:      */\n407:     public String getBaseName() {\n408:         String n = getName();\n409: \n410:         if (n.endsWith(FileConstants.COMPRESSED_FILE_EXT)) {\n411:             return n.substring(0,\n412: \t\t\t       n.length()\n413: \t\t\t       - FileConstants.COMPRESSED_FILE_EXT.length());\n414:         }\n415:         if (n.endsWith(FileConstants.UNCOMPRESSED_FILE_EXT)) {\n416:             return n.substring(0,\n417: \t\t\t       n.length()\n418: \t\t\t       - FileConstants.UNCOMPRESSED_FILE_EXT.length());\n419:         }\n420:         return n;\n421:     }\n422: \n423:     public String getName() {\n424:         // TODO: maybe separate name\n425:         if (url == null)\n426:             return UNTITLED_FILE;\n427:         String name = url.getFile();\n428:         int i = name.lastIndexOf('/');\n429:         return name.substring(i + 1);\n430:     }\n431: \n432:     /**\n433:      * Set the project URL.\n434:      * \n435:      * @param n The new URL (as a String).\n436:      * @throws MalformedURLException if the argument cannot be converted to \n437:      *         an URL.\n438:      */\n439:     public void setName(String n)\n440:         throws MalformedURLException {\n441:         String s = \"\";\n442:         if (getURL() != null)\n443:             s = getURL().toString();\n444:         s = s.substring(0, s.lastIndexOf(\"/\") + 1) + n;\n445:         setURL(new URL(s));\n446:     }\n447: \n448:     /**\n449:      * Get the URL for this project.\n450:      * \n451:      * @return The URL.\n452:      */\n453:     public URL getURL() {\n454:         return url;\n455:     }\n456: \n457:     /**\n458:      * Set the URL for this project.\n459:      * \n460:      * @param theUrl The URL to set.\n461:      */\n462:     public void setURL(URL theUrl) {\n463:         if (theUrl != null) {\n464:             theUrl = Util.fixURLExtension(theUrl, \n465:                     FileConstants.COMPRESSED_FILE_EXT);\n466:         }\n467: \n468:         if (LOG.isDebugEnabled()) {\n469:             LOG.debug(\"Setting project URL from \\\"\" + url \n470:                       + \"\\\" to \\\"\" + theUrl + \"\\\".\");\n471:         }\n472: \n473:         url = theUrl;\n474:     }\n475: \n476:     /**\n477:      * Set the project file.\n478:      * \n479:      * This only works if it is possible to convert the File to an url.\n480:      *\n481:      * @param file File to set the project to.\n482:      */\n483:     public void setFile(File file) {\n484:         try {\n485:             URL theProjectUrl = Util.fileToURL(file);\n486: \n487:             if (LOG.isDebugEnabled()) {\n488:                 LOG.debug(\"Setting project file name from \\\"\" \n489:                           + url \n490:                           + \"\\\" to \\\"\" \n491:                           + theProjectUrl \n492:                           + \"\\\".\");\n493:             }\n494: \n495:             url = theProjectUrl;\n496:         } catch (MalformedURLException murle) {\n497:             LOG.error(\"problem in setFile:\" + file, murle);\n498:         } catch (IOException ex) {\n499:             LOG.error(\"problem in setFile:\" + file, ex);\n500:         }\n501:     }\n502: \n503:     public Vector getSearchPath() {\n504:         return searchpath;\n505:     }\n506: \n507:     public void addSearchPath(String searchPathElement) {\n508:         this.searchpath.addElement(searchPathElement);\n509:     }\n510: \n511:     public URL findMemberURLInSearchPath(String name) {\n512:         //ignore searchpath, just find it relative to the project file\n513:         String u = \"\";\n514:         if (getURL() != null)\n515:             u = getURL().toString();\n516:         u = u.substring(0, u.lastIndexOf(\"/\") + 1);\n517:         URL theUrl = null;\n518:         try {\n519:             theUrl = new URL(u + name);\n520:         } catch (MalformedURLException murle) {\n521:             LOG.error(\n522: \t\t      \"MalformedURLException in findMemberURLInSearchPath:\"\n523: \t\t      + u\n524: \t\t      + name,\n525: \t\t      murle);\n526:         }\n527:         return theUrl;\n528:     }\n529: \n530:     /**\n531:      * Get all members of the project.\n532:      * \n533:      * @return a Vector with all members.\n534:      */\n535:     public Vector getMembers() {\n536:         return members;\n537:     }\n538: \n539:     /**\n540:      * Add a member to this project.\n541:      * \n542:      * @param name The name of the member.\n543:      * @param type The type of the member. \n544:      * \t\t   One of <tt>\"pgml\"</tt> or <tt>\"xmi\"</tt>.\n545:      */\n546:     public void addMember(String name, String type) {\n547:         \n548:         URL memberURL = findMemberURLInSearchPath(name);\n549:         if (memberURL == null) {\n550:             LOG.debug(\"null memberURL\");\n551:             return;\n552:         } else\n553:             LOG.debug(\"memberURL = \" + memberURL);\n554:         ProjectMember pm = findMemberByName(name);\n555:         if (pm != null)\n556:             return;\n557:         if (\"pgml\".equals(type))\n558:             pm = new ProjectMemberDiagram(name, this);\n559:         else if (\"xmi\".equals(type))\n560:             pm = new ProjectMemberModel(name, this);\n561:         else\n562:             throw new RuntimeException(\"Unknown member type \" + type);\n563:         members.addElement(pm);\n564:     }\n565: \n566:     public void addMember(ArgoDiagram d) {\n567:         ProjectMember pm = new ProjectMemberDiagram(d, this);\n568:         addDiagram(d);\n569:         // if diagram added successfully, add the member too\n570:         members.addElement(pm);\n571:     }\n572: \n573:     public void addMember(ProjectMemberTodoList pm) {\n574:         Iterator iter = members.iterator();\n575:         Object currentMember = null;\n576:         while (iter.hasNext()) {\n577:             currentMember = iter.next();\n578:             if (currentMember instanceof ProjectMemberTodoList) {\n579:                 /* No need to have several of these */\n580:                 return;\n581:             }\n582:         }\n583:         // got past the veto, add the member\n584:         members.addElement(pm);\n585:     }\n586: \n587:     public void addMember(Object m) {\n588:         \n589:         if (!ModelFacade.isAModel(m)) {\n590:             throw new IllegalArgumentException();\n591: \t}\n592:         \n593:         Iterator iter = members.iterator();\n594:         Object currentMember = null;\n595:         boolean memberFound = false;\n596:         while (iter.hasNext()) {\n597:             currentMember = iter.next();\n598:             if (currentMember instanceof ProjectMemberModel) {\n599:                 Object currentModel =\n600:                     ((ProjectMemberModel) currentMember).getModel();\n601:                 if (currentModel == m) {\n602:                     memberFound = true;\n603:                     break;\n604:                 }\n605:             }\n606:         }\n607:         if (!memberFound) {\n608:             if (!models.contains(m)) {\n609:                 addModel(m);\n610:             }\n611:             // got past the veto, add the member\n612:             ProjectMember pm = new ProjectMemberModel(m, this);\n613:             members.addElement(pm);\n614:         }\n615:     }\n616: \n617:     /**\n618:      * @param m a namespace\n619:      */\n620:     public void addModel(Object m) {\n621:         \n622:         if (!ModelFacade.isANamespace(m)) {\n623:             throw new IllegalArgumentException();\n624: \t}\n625:         \n626:         // fire indeterminate change to avoid copying vector\n627:         if (!models.contains(m))\n628:             models.addElement(m);\n629:         setCurrentNamespace(m);\n630:         setNeedsSave(true);\n631:     }\n632: \n633:     /**\n634:      * Removes a project member diagram completely from the project.\n635:      * @param d the ArgoDiagram\n636:      */\n637:     protected void removeProjectMemberDiagram(ArgoDiagram d) {\n638: \n639:         removeDiagram(d);\n640: \n641:         // should remove the corresponding ProjectMemberDiagram not\n642:         // the ArgoDiagram from the members\n643: \n644:         // _members.removeElement(d);\n645:         // ehhh lets remove the diagram really and remove it from its\n646:         // corresponding projectmember too\n647:         Iterator it = members.iterator();\n648:         while (it.hasNext()) {\n649:             Object obj = it.next();\n650:             if (obj instanceof ProjectMemberDiagram) {\n651:                 ProjectMemberDiagram pmd = (ProjectMemberDiagram) obj;\n652:                 if (pmd.getDiagram() == d) {\n653:                     members.removeElement(pmd);\n654:                     break;\n655:                 }\n656:             }\n657:         }\n658:     }\n659: \n660:     public ProjectMember findMemberByName(String name) {\n661:         if (LOG.isDebugEnabled()) {\n662:             LOG.debug(\"findMemberByName called for \\\"\" + name + \"\\\".\");\n663:         }\n664:         for (int i = 0; i < members.size(); i++) {\n665:             ProjectMember pm = (ProjectMember) members.elementAt(i);\n666:             if (name.equals(pm.getPlainName()))\n667:                 return pm;\n668:         }\n669:         if (LOG.isDebugEnabled()) {\n670:             LOG.debug(\"Member \\\"\" + name + \"\\\" not found.\");\n671:         }\n672:         return null;\n673:     }\n674: \n675: \n676:     public void loadMembersOfType(String type) {\n677:         if (type == null) {\n678:             return;\n679:         }\n680:         java.util.Enumeration enumeration = getMembers().elements();\n681:         try {\n682:             while (enumeration.hasMoreElements()) {\n683:                 ProjectMember pm = (ProjectMember) enumeration.nextElement();\n684:                 if (type.equalsIgnoreCase(pm.getType())) {\n685:                     pm.load();\n686:                 }\n687:             }\n688:         } catch (IOException ignore) {\n689:             LOG.error(\"IOException in makeEmptyProject\", ignore);\n690:         } catch (org.xml.sax.SAXException ignore) {\n691:             LOG.error(\"SAXException in makeEmptyProject\", ignore);\n692:         }\n693:     }\n694: \n695:     public void loadAllMembers() {\n696:         loadMembersOfType(\"xmi\");\n697:         loadMembersOfType(\"argo\");\n698:         loadMembersOfType(\"pgml\");\n699:         loadMembersOfType(\"todo\");\n700:         loadMembersOfType(\"text\");\n701:         loadMembersOfType(\"html\");\n702:     }\n703: \n704:     /**\n705:      * Get the author name.\n706:      * \n707:      * @return The author name.\n708:      */\n709:     public String getAuthorname() {\n710:         return authorname;\n711:     }\n712:     \n713:     /**\n714:      * Set the author name.\n715:      * \n716:      * @param s The new author name.\n717:      */\n718:     public void setAuthorname(String s) {\n719:         authorname = s;\n720:     }\n721: \n722:     /**\n723:      * Get the version.\n724:      * \n725:      * @return the version.\n726:      */\n727:     public String getVersion() {\n728:         return version;\n729:     }\n730:     \n731:     /**\n732:      * Set the new version.\n733:      * @param s The new version.\n734:      */\n735:     public void setVersion(String s) {\n736:         version = s;\n737:     }\n738: \n739:     /**\n740:      * Get the description.\n741:      * \n742:      * @return the description.\n743:      */\n744:     public String getDescription() {\n745:         return description;\n746:     }\n747: \n748:     /**\n749:      * Set a new description.\n750:      *  \n751:      * @param s The new description.\n752:      */\n753:     public void setDescription(String s) {\n754:         description = s;\n755:     }\n756: \n757:     /**\n758:      * Get the history file.\n759:      * \n760:      * @return The history file.\n761:      */\n762:     public String getHistoryFile() {\n763:         return historyFile;\n764:     }\n765: \n766:     /**\n767:      * Set the history file.\n768:      * \n769:      * @param s The new history file.\n770:      */\n771:     public void setHistoryFile(String s) {\n772:         historyFile = s;\n773:     }\n774: \n775:     /**\n776:      * Set the needs-to-be-saved flag.\n777:      * \n778:      * @param newValue The new value.\n779:      */\n780:     public void setNeedsSave(boolean newValue) {\n781:         saveRegistry.setChangeFlag(newValue);\n782:     }\n783:     \n784:     /**\n785:      * Test if the model needs to be saved.\n786:      * \n787:      * @return <tt>true</tt> if the model needs to be saved.\n788:      */\n789:     public boolean needsSave() {\n790:         return saveRegistry.hasChanged();\n791:     }\n792: \n793:     /**\n794:      * Returns all models defined by the user. I.e. this does not return the\n795:      * default model but all other models.\n796:      * \n797:      * @return A Vector of all user defined models.\n798:      */\n799:     public Vector getUserDefinedModels() {\n800:         return models;\n801:     }\n802: \n803:     /**\n804:      * Returns all models, including the default model (default.xmi).\n805:      * \n806:      * @return A Collection containing all models.\n807:      */\n808:     public Collection getModels() {\n809:         Set ret = new HashSet();\n810:         ret.addAll(models);\n811:         ret.add(defaultModel);\n812:         return ret;\n813:     }\n814: \n815:     /**\n816:      * Return the model.<p>\n817:      * \n818:      * If there isn't exactly one model, <tt>null</tt> is returned.\n819:      * \n820:      * @return the model.\n821:      */\n822:     public Object getModel() {\n823:         if (models.size() != 1) {\n824:             return null;\n825:         }\n826:         return models.elementAt(0);\n827:     }\n828: \n829:     /**\n830:      * Searches for a type/classifier with name s. If the type is not found,\n831:      * a new type is created and added to the current namespace.\n832:      * @param s the name of the type/classifier to be found\n833:      * @return MClassifier\n834:      */\n835:     public Object findType(String s) {\n836:         return findType(s, true);\n837:     }\n838: \n839:     /**\n840:      * Searches for a type/classifier with name s. If defineNew is\n841:      * true, a new type is defined if the type/classifier is not\n842:      * found. The newly created type is added to the currentNamespace\n843:      * and given the name s.\n844:      * @param s the name of the type/classifier to be found\n845:      * @param defineNew\n846:      * @return MClassifier\n847:      */\n848:     public Object findType(String s, boolean defineNew) {\n849:         if (s != null) {\n850:             s = s.trim();\n851:         }\n852:         if (s == null || s.length() == 0) {\n853:             return null;\n854:         }\n855:         Object cls = null;\n856:         int numModels = models.size();\n857:         for (int i = 0; i < numModels; i++) {\n858:             cls = findTypeInModel(s, models.elementAt(i));\n859:             if (cls != null) {\n860:                 return cls;\n861:             }\n862:         }\n863:         cls = findTypeInModel(s, defaultModel);\n864:         // hey, now we should move it to the model the user is working in\n865:         if (cls != null) {\n866:             cls = ModelManagementHelper.\n867:                 getHelper().getCorrespondingElement(cls, getRoot());\n868:         }\n869:         if (cls == null && defineNew) {\n870:             LOG.debug(\"new Type defined!\");\n871:             cls = UmlFactory.getFactory().getCore()\n872:         \t\t  .buildClass(getCurrentNamespace());\n873:             ModelFacade.setName(cls, s);\n874:         }\n875:         return cls;\n876:     }\n877: \n878:     /**\n879:      * Finds all figs on the diagrams for some project member,\n880:      * including the figs containing the member (so for some\n881:      * operation, the containing figclass is returned).\n882:      * \n883:      * @param member The member we are looking for. \n884:      *               This can be a NSUML object but also another object.\n885:      * @return Collection The collection with the figs.\n886:      */\n887:     public Collection findFigsForMember(Object member) {\n888:         Collection figs = new ArrayList();\n889:         Iterator it = getDiagrams().iterator();\n890:         while (it.hasNext()) {\n891:             ArgoDiagram diagram = (ArgoDiagram) it.next();\n892:             Object fig = diagram.getContainingFig(member);\n893:             if (fig != null) {\n894:                 figs.add(fig);\n895:             }\n896:         }\n897:         return figs;\n898:     }\n899: \n900:     /** \n901:      * Finds a classifier with a certain name.<p>\n902:      * \n903:      * Will only return first classifier with the matching name.\n904:      *\n905:      * @param s is short name.\n906:      * @param ns Namespace where we do the search.\n907:      * @return the found classifier (or <tt>null</tt> if not found).\n908:      */\n909:     public Object findTypeInModel(String s, Object ns) {\n910:         \n911:         if (!ModelFacade.isANamespace(ns)) {\n912:             throw new IllegalArgumentException();\n913:     \t}\n914:         \n915:         Collection allClassifiers =\n916:             ModelManagementHelper.getHelper()\n917: \t        .getAllModelElementsOfKind(ns, (Class) ModelFacade.CLASSIFIER);\n918:         \n919:         Object[] classifiers = allClassifiers.toArray();\n920:         Object classifier = null;\n921:         \n922:         for (int i = 0; i < classifiers.length; i++) {\n923:             \n924:             classifier = classifiers[i];\n925:             if (ModelFacade.getName(classifier) != null\n926:             \t\t&& ModelFacade.getName(classifier).equals(s)) {\n927:                 return classifier;\n928:             }\n929:         }\n930:         \n931:         return null;\n932:     }\n933: \n934:     public void setCurrentNamespace(Object m) {\n935:         \n936:         if (m != null && !ModelFacade.isANamespace(m)) {\n937:             throw new IllegalArgumentException();\n938:     \t}\n939:         \n940:         currentNamespace = m;\n941:     }\n942: \n943:     public Object getCurrentNamespace() {\n944:         return currentNamespace;\n945:     }\n946: \n947:     public Vector getDiagrams() {\n948:         return diagrams;\n949:     }\n950: \n951:     /**\n952:      * Finds a diagram with a specific name or UID.\n953:      *\n954:      * @return the diagram object (if found). Otherwize null.\n955:      * @param name is the name to search for.\n956:      */\n957:     public ArgoDiagram getDiagram(String name) {\n958:         Iterator it = diagrams.iterator();\n959:         while (it.hasNext()) {\n960:             ArgoDiagram ad = (ArgoDiagram) it.next();\n961:             if (ad.getName() != null && ad.getName().equals(name)) {\n962:                 return ad;\n963:             }\n964:             if (ad.getItemUID() != null\n965:                     && ad.getItemUID().toString().equals(name)) {\n966:                 return ad;\n967:             }\n968:         }\n969:         return null;\n970:     } \n971: \n972:     public void addDiagram(ArgoDiagram d) {\n973:         // send indeterminate new value instead of making copy of vector\n974:         diagrams.addElement(d);\n975:         d.addChangeRegistryAsListener(saveRegistry);\n976:         setNeedsSave(true);\n977:     }\n978: \n979:     /**\n980:      * Removes a diagram from the list with diagrams. \n981:      * \n982:      * Removes (hopefully) the event listeners for this diagram.  Does\n983:      * not remove the diagram from the project members. This should\n984:      * not be called directly. Use moveToTrash if you want to remove a\n985:      * diagram.\n986:      * \n987:      * @param d the ArgoDiagram\n988:      */\n989:     protected void removeDiagram(ArgoDiagram d) {\n990:         diagrams.removeElement(d);\n991:         // if the diagram is a statechart,\n992:         // remove its associated statemachine model elements\n993:         if (d instanceof UMLStateDiagram) {\n994:             UMLStateDiagram statediagram = (UMLStateDiagram) d;\n995:             // if the statemachine has already been deleted,\n996:             // and is now null,\n997:             // don't attempt to delete it!\n998:             if (statediagram.getStateMachine() != null) {\n999:                 this.moveToTrash(statediagram.getStateMachine());\n1000:             }\n1001:         }\n1002:         d.removeChangeRegistryAsListener(saveRegistry);\n1003:         setNeedsSave(true);\n1004:     }\n1005: \n1006:     public int getPresentationCountFor(Object me) {\n1007:         \n1008:         if (!ModelFacade.isAModelElement(me)) {\n1009:             throw new IllegalArgumentException();