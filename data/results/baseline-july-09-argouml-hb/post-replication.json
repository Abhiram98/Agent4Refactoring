 import java.awt.GridBagConstraints;\n34: import java.awt.GridBagLayout;\n35: import java.awt.GridLayout;\n36: import java.awt.event.ActionEvent;\n37: import java.util.Iterator;\n38: import java.util.MissingResourceException;\n39: import java.util.ResourceBundle;\n40: import java.util.Vector;\n41: \n42: import javax.swing.Icon;\n43: import javax.swing.ImageIcon;\n44: import javax.swing.JComponent;\n45: import javax.swing.JLabel;\n46: import javax.swing.JPanel;\n47: import javax.swing.JToolBar;\n48: import javax.swing.SwingConstants;\n49: import javax.swing.SwingUtilities;\n50: import javax.swing.event.EventListenerList;\n51: \n52: import org.argouml.application.helpers.ResourceLoaderWrapper;\n53: import org.argouml.kernel.ProjectManager;\n54: import org.argouml.model.ModelFacade;\n55: import org.argouml.model.uml.UmlModelEventPump;\n56: import org.argouml.swingext.LabelledLayout;\n57: import org.argouml.swingext.Orientation;\n58: import org.argouml.swingext.Vertical;\n59: import org.argouml.ui.LookAndFeelMgr;\n60: import org.argouml.ui.TabSpawnable;\n61: import org.argouml.ui.targetmanager.TargetEvent;\n62: import org.argouml.ui.targetmanager.TargetListener;\n63: import org.argouml.ui.targetmanager.TargetManager;\n64: import org.argouml.ui.targetmanager.TargettableModelView;\n65: import org.argouml.uml.Profile;\n66: import org.argouml.uml.ProfileJava;\n67: import org.tigris.gef.presentation.Fig;\n68: import org.tigris.toolbar.ToolBar;\n69: \n70: import ru.novosoft.uml.MElementEvent;\n71: import ru.novosoft.uml.MElementListener;\n72: \n73: /**\n74:  * This abstract class provides the basic layout and event dispatching\n75:  * support for all Property Panels.<p>\n76:  *\n77:  * The property panel is {@link org.argouml.swingext.LabelledLayout layed out}\n78:  * as a number (specified in the constructor) of equally sized panels\n79:  * that split the available space.  Each panel has a column of\n80:  * \"captions\" and matching column of \"fields\" which are laid out\n81:  * indepently from the other panels.<p>\n82:  *\n83:  * The Properties panels for UML Model Elements are structured in an\n84:  * inheritance hierarchy that matches the UML 1.3 metamodel.\n85:  */\n86: public abstract class PropPanel\n87:     extends TabSpawnable\n88:     implements TabModelTarget, MElementListener, UMLUserInterfaceContainer\n89: {\n90:     ////////////////////////////////////////////////////////////////\n91:     // instance vars\n92:     private Object target;\n93:     private Object modelElement;\n94:     private static Profile profile;\n95: \n96:     private ResourceBundle bundle = null;\n97: \n98:     private Vector panels = new Vector();\n99: \n100:     private int lastRow;\n101: \n102:     private EventListenerList listenerList;\n103: \n104:     /**\n105:      * The metaclass/property pairs for the third party listener (if we have\n106:      * set one up. We use this when creating a new listener on target\n107:      * change.<p>\n108:      */\n109:     private JPanel center;\n110: \n111:     protected JToolBar buttonPanel;\n112:     private JPanel buttonPanelWithFlowLayout = new JPanel();\n113: \n114:     private JLabel titleLabel;\n115: \n116:     private JPanel captionPanel = new JPanel();\n117: \n118:     protected static ImageIcon _deleteIcon =\n119: \tResourceLoaderWrapper\n120: \t    .lookupIconResource(\"RedDelete\");\n121:     protected static ImageIcon _navUpIcon =\n122: \tResourceLoaderWrapper\n123: \t    .lookupIconResource(\"NavigateUp\");\n124: \n125:     protected Font smallFont = LookAndFeelMgr.getInstance().getSmallFont();\n126: \n127:     /**\n128:      * Construct new PropPanel using LabelledLayout.<p>\n129:      *\n130:      * @param icon The icon to display for the panel\n131:      * @param title The title of the panel\n132:      *\n133:      * @param orientation the orientation\n134:      */\n135:     public PropPanel(String title, ImageIcon icon, Orientation orientation) {\n136:         super(title);\n137:         setOrientation(orientation);\n138:         buttonPanel = new ToolBar();\n139:         buttonPanel.putClientProperty(\"JToolBar.isRollover\",  Boolean.TRUE);\n140:         buttonPanel.setFloatable(false);\n141:         //buttonPanel.putClientProperty(\"JToolBar.isRollover\",  Boolean.TRUE);\n142: \n143:         setLayout(new LabelledLayout(orientation == Vertical.getInstance()));\n144: \n145:         if (icon != null) {\n146:             setTitleLabel(new JLabel(localize(title), icon, \n147:                     SwingConstants.LEFT));\n148:         }\n149:         else {\n150:             setTitleLabel(new JLabel(localize(title)));\n151:         }\n152:         //buttonPanel = new JPanel(new SerialLayout());\n153:         getTitleLabel().setLabelFor(buttonPanel);\n154:         add(getTitleLabel());\n155:         add(buttonPanel);\n156:     }\n157: \n158:     /**\n159:      * Constructs a new Proppanel without an icon. If there is an icon it's\n160:      * updated at runtime via settarget.<p>\n161:      *\n162:      * @param title\n163:      * @param orientation\n164:      */\n165:     public PropPanel(String title, Orientation orientation) {\n166:         this (title, null, orientation);\n167:     }\n168: \n169:     /**\n170:      * Set the orientation of the panel\n171:      *\n172:      * @see org.argouml.swingext.Orientable#setOrientation(org.argouml.swingext.Orientation)\n173:      */\n174:     public void setOrientation(Orientation orientation) {\n175:         super.setOrientation(orientation);\n176:     }\n177: \n178:     /**\n179:      * Add a component with the specified label.<p>\n180:      *\n181:      * @param label the label for the component\n182:      * @param component the component\n183:      * @return the label added\n184:      */\n185:     public JLabel addField(String label, Component component) {\n186:         JLabel jlabel = new JLabel(localize(label));\n187:         jlabel.setFont(LookAndFeelMgr.getInstance().getSmallFont());\n188:         component.setFont(LookAndFeelMgr.getInstance().getSmallFont());\n189:         jlabel.setLabelFor(component);\n190:         add(jlabel);\n191:         add(component);\n192:         return jlabel;\n193:     }\n194: \n195:     /**\n196:      * Add a component with the specified label positioned after\n197:      * another component.\n198:      *\n199:      * @param label the label for the component\n200:      * @param component the component\n201:      *\n202:      * @param afterComponent the component before\n203:      * @return the newly added label\n204:      */\n205:     public JLabel addFieldAfter(String label, Component component,\n206: \t\t\t\tComponent afterComponent) {\n207:         int nComponent = this.getComponentCount();\n208:         for (int i = 0; i < nComponent; ++i) {\n209:             if (getComponent(i) == afterComponent) {\n210:                 JLabel jlabel = new JLabel(localize(label));\n211:                 jlabel.setFont(LookAndFeelMgr.getInstance().getSmallFont());\n212:                 component.setFont(LookAndFeelMgr.getInstance().getSmallFont());\n213:                 jlabel.setLabelFor(component);\n214:                 add(jlabel, ++i);\n215:                 add(component, ++i);\n216:                 return jlabel;\n217:             }\n218:         }\n219:         throw new IllegalArgumentException(\"Component not found\");\n220:     }\n221: \n222:     /**\n223:      * Add a component with the specified label positioned before\n224:      * another component.<p>\n225:      *\n226:      * @param label the label for the component\n227:      * @param component the component\n228:      * @param beforeComponent the component\n229:      *\n230:      * @return the newly added component\n231:      */\n232:     public JLabel addFieldBefore(String label, Component component,\n233: \t\t\t\t Component beforeComponent) {\n234:         int nComponent = this.getComponentCount();\n235:         for (int i = 0; i < nComponent; ++i) {\n236:             if (getComponent(i) == beforeComponent) {\n237:                 JLabel jlabel = new JLabel(localize(label));\n238:                 jlabel.setFont(LookAndFeelMgr.getInstance().getSmallFont());\n239:                 component.setFont(LookAndFeelMgr.getInstance().getSmallFont());\n240:                 jlabel.setLabelFor(component);\n241:                 add(jlabel, i);\n242:                 add(component, ++i);\n243:                 return jlabel;\n244:             }\n245:         }\n246:         throw new IllegalArgumentException(\"Component not found\");\n247:     }\n248: \n249:     /**\n250:      *   Adds a component to the fields of the specified panel\n251:      *     and sets the background and color to indicate\n252:      *     the field is a link.\n253:      *   @param label the required string label\n254:      *   @param component Component to be added\n255:      *   @deprecated replaced by according widgets as of version 0.17.1\n256:      */\n257:     public final void addLinkField(String label, JComponent component) {\n258:         component.setBackground(getBackground());\n259:         component.setForeground(Color.blue);\n260:         addField(label, component);\n261:     }\n262: \n263:     /**\n264:      * @see org.argouml.uml.ui.UMLUserInterfaceContainer#localize(java.lang.String)\n265:      */\n266:     public final String localize(String key) {\n267:         String localized = key;\n268:         if (bundle == null) {\n269:             bundle = getResourceBundle();\n270:         }\n271:         if (bundle != null) {\n272:             try {\n273:                 localized = bundle.getString(key);\n274:             } catch (MissingResourceException e) {\n275:             }\n276:             if (localized == null) {\n277:                 localized = key;\n278:             }\n279:         }\n280:         return localized;\n281:     }\n282: \n283:     protected final void addSeperator() {\n284:         add(LabelledLayout.getSeperator());\n285:     }\n286: \n287:     public ResourceBundle getResourceBundle() {\n288:         return null;\n289:     }\n290: \n291:     /**\n292:      * @see org.argouml.uml.ui.UMLUserInterfaceContainer#getProfile()\n293:      */\n294:     public Profile getProfile() {\n295:         if (profile == null) {\n296:             profile = ProfileJava.getInstance();\n297:         }\n298:         return profile;\n299:     }\n300: \n301:     /**\n302:        This method (and addMElementListener) can be overriden if the\n303:        prop panel wants to monitor additional objects.\n304:        ONLY use it if the target is a NSUML modelelement\n305: \n306:        @param theTarget target of prop panel\n307: \n308:     */\n309:     protected void removeMElementListener(Object theTarget) {\n310:         UmlModelEventPump.getPump().removeModelEventListener(this, theTarget);\n311:     }\n312: \n313:     /**\n314:        This method (and removeMElementListener) can be overriden if the\n315:        prop panel wants to monitor additional objects.  This method\n316:        is public only since it is called from a Runnable object.\n317: \n318:        @param theTarget target of prop panel\n319:     */\n320:     public void addMElementListener(Object theTarget) {\n321:         UmlModelEventPump.getPump().addModelEventListener(this, theTarget);\n322:     }\n323: \n324:     /**\n325:      * Set the target to be associated with a particular property panel.<p>\n326:      *\n327:      * This involves resetting the third party listeners.<p>\n328:      * @deprecated As Of Argouml version 0.13.5,\n329:      *             This will change visibility from release 0.16\n330:      * @param t  The object to be set as a target.\n331:      */\n332: \n333:     public void setTarget(Object t) {\n334:         t = (t instanceof Fig) ? ((Fig) t).getOwner() : t;\n335: \n336:         // If the target has changed notify the third party listener if it\n337:         // exists and dispatch a new NSUML element listener to\n338:         // ourself. Otherwise dispatch a target reasserted to ourself.\n339:         Runnable dispatch = null;\n340:         if (t != target) {\n341: \n342:             // Set up the target and its model element variant.\n343: \n344:             target = t;\n345:             modelElement = null;\n346:             if (listenerList == null) {\n347:                 listenerList = registrateTargetListeners(this);\n348:             }\n349: \n350:             if (ModelFacade.isAModelElement(target)) {\n351:                 modelElement = target;\n352:             }\n353: \n354:             // This will add a new MElement listener after update is complete\n355: \n356:             dispatch =\n357: \t\tnew UMLChangeDispatch(this,\n358: \t\t\t\t      UMLChangeDispatch.TARGET_CHANGED_ADD);\n359: \n360:         }\n361:         else {\n362:             dispatch =\n363: \t\tnew UMLChangeDispatch(this,\n364: \t\t\t\t      UMLChangeDispatch.TARGET_REASSERTED);\n365: \n366:         }\n367:         SwingUtilities.invokeLater(dispatch);\n368: \n369:         // update the titleLabel\n370:         if (getTitleLabel() != null) {\n371:             Icon icon =\n372: \t\tResourceLoaderWrapper.getInstance().lookupIcon(t);\n373:             if (icon != null)\n374:                 getTitleLabel().setIcon(icon);\n375:         }\n376:     }\n377: \n378:     /**\n379:      * Builds a eventlistenerlist of all targetlisteners that are part of this\n380:      * container and its children.\n381:      *\n382:      * @param container the container to search for targetlisteners\n383:      * @return an EventListenerList with all TargetListeners on this\n384:      * container and its children.\n385:      */\n386:     private EventListenerList registrateTargetListeners(Container container) {\n387:         Component[] components = container.getComponents();\n388:         EventListenerList list = new EventListenerList();\n389:         for (int i = 0; i < components.length; i++) {\n390:             if (components[i] instanceof TargetListener) {\n391:                 list.add(TargetListener.class, (TargetListener) components[i]);\n392:             }\n393:             if (components[i] instanceof TargettableModelView) {\n394:                 list.add(TargetListener.class,\n395: \t\t\t ((TargettableModelView) components[i])\n396: \t\t\t     .getTargettableModel());\n397:             }\n398:             if (components[i] instanceof Container) {\n399:                 EventListenerList list2 =\n400: \t\t    registrateTargetListeners((Container) components[i]);\n401:                 Object[] objects = list2.getListenerList();\n402:                 for (int j = 1; j < objects.length; j += 2) {\n403:                     list.add(TargetListener.class, (TargetListener) objects[j]);\n404:                 }\n405:             }\n406:         }\n407:         return list;\n408:     }\n409: \n410:     /**\n411:      * @see org.argouml.ui.TabTarget#getTarget()\n412:      */\n413:     public final Object getTarget() {\n414:         return target;\n415:     }\n416: \n417:     /**\n418:      * @see org.argouml.uml.ui.UMLUserInterfaceContainer#getModelElement()\n419:      */\n420:     public final Object getModelElement() {\n421:         return modelElement;\n422:     }\n423: \n424:     /**\n425:      * @see org.argouml.ui.TabTarget#refresh()\n426:      */\n427:     public void refresh() {\n428:         SwingUtilities.invokeLater(new UMLChangeDispatch(this, 0));\n429:     }\n430: \n431:     /**\n432:      * @see org.argouml.ui.TabTarget#shouldBeEnabled(java.lang.Object)\n433:      */\n434:     public boolean shouldBeEnabled(Object target) {\n435:         target = (target instanceof Fig) ? ((Fig) target).getOwner() : target;\n436:         return ModelFacade.isAModelElement(target);\n437:     }\n438: \n439:     /**\n440:      * @see ru.novosoft.uml.MElementListener#propertySet(ru.novosoft.uml.MElementEvent)\n441:      */\n442:     public void propertySet(MElementEvent mee) {\n443:         UMLChangeDispatch dispatch = new UMLChangeDispatch(this, 0);\n444:         dispatch.propertySet(mee);\n445:         SwingUtilities.invokeLater(dispatch);\n446:     }\n447: \n448:     /**\n449:      * @see ru.novosoft.uml.MElementListener#listRoleItemSet(ru.novosoft.uml.MElementEvent)\n450:      */\n451:     public void listRoleItemSet(MElementEvent mee) {\n452:         UMLChangeDispatch dispatch = new UMLChangeDispatch(this, 0);\n453:         dispatch.listRoleItemSet(mee);\n454:         SwingUtilities.invokeLater(dispatch);\n455:     }\n456: \n457:     /**\n458:      * @see ru.novosoft.uml.MElementListener#recovered(ru.novosoft.uml.MElementEvent)\n459:      */\n460:     public void recovered(MElementEvent mee) {\n461:         UMLChangeDispatch dispatch = new UMLChangeDispatch(this, 0);\n462:         dispatch.recovered(mee);\n463:         SwingUtilities.invokeLater(dispatch);\n464:     }\n465: \n466:     /**\n467:      * @see ru.novosoft.uml.MElementListener#removed(ru.novosoft.uml.MElementEvent)\n468:      */\n469:     public void removed(MElementEvent mee) {\n470:         UMLChangeDispatch dispatch = new UMLChangeDispatch(this, 0);\n471:         dispatch.removed(mee);\n472:         SwingUtilities.invokeLater(dispatch);\n473:     }\n474: \n475:     /**\n476:      * @see ru.novosoft.uml.MElementListener#roleAdded(ru.novosoft.uml.MElementEvent)\n477:      */\n478:     public void roleAdded(MElementEvent mee) {\n479:         UMLChangeDispatch dispatch = new UMLChangeDispatch(this, 0);\n480:         dispatch.roleAdded(mee);\n481:         SwingUtilities.invokeLater(dispatch);\n482:     }\n483: \n484:     /**\n485:      * @see ru.novosoft.uml.MElementListener#roleRemoved(ru.novosoft.uml.MElementEvent)\n486:      */\n487:     public void roleRemoved(MElementEvent mee) {\n488:         UMLChangeDispatch dispatch = new UMLChangeDispatch(this, 0);\n489:         dispatch.roleRemoved(mee);\n490:         SwingUtilities.invokeLater(dispatch);\n491:     }\n492: \n493:     /**\n494:      * This method can be overriden in derived Panels where the\n495:      * appropriate namespace for display may not be the same as\n496:      * the namespace of the target\n497:      *\n498:      * @return the namespace\n499:      */\n500:     protected Object getDisplayNamespace() {\n501:         Object ns = null;\n502:         Object theTarget = getTarget();\n503:         if (ModelFacade.isAModelElement(theTarget)) {\n504:             ns = ModelFacade.getNamespace(theTarget);\n505:         }\n506:         return ns;\n507:     }\n508: \n509:     /**\n510:      * @see org.argouml.uml.ui.UMLUserInterfaceContainer#formatElement(java.lang.Object)\n511:      */\n512:     public String formatElement(/*MModelElement*/Object element) {\n513:         return getProfile().formatElement(element, getDisplayNamespace());\n514:     }\n515: \n516:     /**\n517:      * @see org.argouml.uml.ui.UMLUserInterfaceContainer#formatNamespace(java.lang.Object)\n518:      */\n519:     public String formatNamespace(/*MNamespace*/Object namespace) {\n520:         return getProfile().formatElement(namespace, null);\n521:     }\n522: \n523:     /**\n524:      * @see org.argouml.uml.ui.UMLUserInterfaceContainer#formatCollection(java.util.Iterator)\n525:      */\n526:     public String formatCollection(Iterator iter) {\n527:         Object namespace = getDisplayNamespace();\n528:         return getProfile().formatCollection(iter, namespace);\n529:     }\n530: \n531:     /**\n532:      * @deprecated As of ArgoUml version 0.13.5, replaced by\n533:      * {@link TargetManager#navigateBackward()}.\n534:      */\n535:     public void navigateBackAction() {\n536:         TargetManager.getInstance().navigateBackward();\n537:     }\n538: \n539:     /**\n540:      * Calling this method with an array of metaclasses (for example,\n541:      * MClassifier.class) will result in the prop panel propagating\n542:      * any name changes or removals on any object that on the same\n543:      * event queue as the target that is assignable to one of the\n544:      * metaclasses.<p>\n545:      *\n546:      * <em>Note</em>. Despite the name, the old implementation tried\n547:      * to listen for ownedElement and baseClass events as well as name\n548:      * events. We incorporate all these.<p>\n549:      *\n550:      * <em>Note</em> Reworked the implementation to use the new\n551:      * UmlModelEventPump mechanism. In the future proppanels should\n552:      * register directly with UmlModelEventPump IF they are really\n553:      * interested in the events themselves. If components on the\n554:      * proppanels are interested, these components should register\n555:      * themselves.<p>\n556:      *\n557:      * @deprecated As of ArgoUml version unknown(earlier than 0.13.5),\n558:      *             replaced by\n559:      * {@link org.argouml.model.uml.UmlModelEventPump#addModelEventListener(\n560:      *            Object , Object)}.\n561:      *             since components should register themselves.\n562:      *\n563:      * @param metaclasses  The metaclass array we wish to listen to.\n564:      */\n565:     public void setNameEventListening(Class[] metaclasses) {\n566: \n567:         /*\n568: \t   old implementation\n569: \n570: \t   // Convert to the third party listening pair list\n571: \n572: \t   Vector targetList = new Vector (metaclasses.length * 6);\n573: \n574: \t   for (int i = 0 ; i < metaclasses.length ; i++) {\n575: \t   Class mc = metaclasses[i];\n576: \n577: \t   targetList.add(mc);\n578: \t   targetList.add(\"name\");\n579: \n580: \t   targetList.add(mc);\n581: \t   targetList.add(\"baseClass\");\n582: \n583: \t   targetList.add(mc);\n584: \t   targetList.add(\"ownedElement\");\n585: \t   }\n586: \n587: \t   addThirdPartyEventListening(targetList.toArray());\n588:         */\n589:         for (int i = 0; i < metaclasses.length; i++) {\n590:             Class clazz = metaclasses[i];\n591:             if (((Class) ModelFacade.NAMESPACE).isAssignableFrom(clazz)) {\n592:                 UmlModelEventPump.getPump()\n593: \t\t    .addClassModelEventListener(this, clazz, \"ownedElement\");\n594:             }\n595:             if (((Class) ModelFacade.MODELELEMENT).isAssignableFrom(clazz)) {\n596:                 UmlModelEventPump.getPump()\n597: \t\t    .addClassModelEventListener(this, clazz, \"name\");\n598:             }\n599:             if (clazz.equals(ModelFacade.STEREOTYPE)) {\n600:                 UmlModelEventPump.getPump()\n601: \t\t    .addClassModelEventListener(this, clazz, \"baseClass\");\n602:             }\n603:         }\n604:     }\n605: \n606:     public void removeElement() {\n607:         Object theTarget = getTarget();\n608:         if (ModelFacade.isABase(theTarget)) {\n609:             Object newTarget = ModelFacade.getModelElementContainer(theTarget);\n610:             Object base = theTarget;\n611:             TargetManager.getInstance().setTarget(base);\n612:             ActionEvent event = new ActionEvent(this, 1, \"delete\");\n613:             new ActionRemoveFromModel().actionPerformed(event);\n614:             if (newTarget != null) {\n615:                 TargetManager.getInstance().setTarget(newTarget);\n616:             }\n617:         }\n618:     }\n619: \n620:     /**\n621:      * Check whether this element can be deleted.\n622:      * Currently it only checks whether we delete the main model.\n623:      * ArgoUML does not like that.\n624:      *\n625:      * @since 0.13.2\n626:      * @return whether this element can be deleted\n627:      */\n628:     public boolean isRemovableElement() {\n629:         return ((getTarget() != null)\n630: \t\t&& (getTarget()\n631: \t\t    != (ProjectManager.getManager().getCurrentProject()\n632: \t\t\t.getModel())));\n633:     }\n634: \n635:     /**\n636:      * @see TargetListener#targetAdded(TargetEvent)\n637:      */\n638:     public void targetAdded(TargetEvent e) {\n639:         // we can neglect this, the TabProps allways selects the first target\n640: \t// in a set of targets. The first target can only be\n641: \t// changed in a targetRemoved or a TargetSet event\n642:         fireTargetAdded(e);\n643:     }\n644: \n645:     /**\n646:      * @see TargetListener#targetRemoved(TargetEvent)\n647:      */\n648:     public void targetRemoved(TargetEvent e) {\n649:         // how to handle empty target lists?\n650:         // probably the TabProps should only show an empty pane in that case\n651:         fireTargetRemoved(e);\n652:         // setTarget(e.getNewTarget());\n653:         \n654: \n655:     }\n656: \n657:     /**\n658:      * @see TargetListener#targetSet(TargetEvent)\n659:      */\n660:     public void targetSet(TargetEvent e) {\n661:         setTarget(e.getNewTarget());\n662:         fireTargetSet(e);\n663: \n664:     }\n665: \n666:     private void fireTargetSet(TargetEvent targetEvent) {\n667: \t//          Guaranteed to return a non-null array\n668: \tObject[] listeners = listenerList.getListenerList();\n669: \tfor (int i = listeners.length - 2; i >= 0; i -= 2) {\n670: \t    if (listeners[i] == TargetListener.class) {\n671: \t\t// Lazily create the event:\n672: \t\t((TargetListener) listeners[i + 1]).targetSet(targetEvent);\n673: \t    }\n674: \t}\n675:     }\n676: \n677:     private void fireTargetAdded(TargetEvent targetEvent) {\n678: \t// Guaranteed to return a non-null array\n679: \tObject[] listeners = listenerList.getListenerList();\n680: \n681: \tfor (int i = listeners.length - 2; i >= 0; i -= 2) {\n682: \t    if (listeners[i] == TargetListener.class) {\n683: \t\t// Lazily create the event:\n684: \t\t((TargetListener) listeners[i + 1]).targetAdded(targetEvent);\n685: \t    }\n686: \t}\n687:     }\n688: \n689:     private void fireTargetRemoved(TargetEvent targetEvent) {\n690: \t// Guaranteed to return a non-null array\n691: \tObject[] listeners = listenerList.getListenerList();\n692: \tfor (int i = listeners.length - 2; i >= 0; i -= 2) {\n693: \t    if (listeners[i] == TargetListener.class) {\n694: \t\t// Lazily create the event:\n695: \t\t((TargetListener) listeners[i + 1]).targetRemoved(targetEvent);\n696: \t    }\n697: \t}\n698:     }\n699: \n700:     protected void setTitleLabel(JLabel theTitleLabel) {\n701:         this.titleLabel = theTitleLabel;\n702:     }\n703: \n704:     protected JLabel getTitleLabel() {\n705:         return titleLabel;\n706:     }\n707: } /* end class PropPanel */\n708: ",
