797:                         token = st.nextToken();\n798:                         if (\">>\".equals(token))\n799:                             break;\n800:                         stereotype += token;\n801:                     }\n802:                 } else if (\"{\".equals(token)) {\n803:                     String propname = \"\";\n804:                     String propvalue = null;\n805: \n806:                     if (properties == null)\n807:                         properties = new Vector();\n808:                     while (true) {\n809:                         token = st.nextToken();\n810:                         if (\",\".equals(token) || \"}\".equals(token)) {\n811:                             if (propname.length() > 0) {\n812:                                 properties.add(propname);\n813:                                 properties.add(propvalue);\n814:                             }\n815:                             propname = \"\";\n816:                             propvalue = null;\n817: \n818:                             if (\"}\".equals(token))\n819:                                 break;\n820:                         } else if (\"=\".equals(token)) {\n821:                             if (propvalue != null)\n822:                                 throw new ParseException(\"Property \" + propname\n823:                                         + \" cannot have two values\", st\n824:                                         .getTokenIndex());\n825:                             propvalue = \"\";\n826:                         } else if (propvalue == null) {\n827:                             propname += token;\n828:                         } else {\n829:                             propvalue += token;\n830:                         }\n831:                     }\n832:                     if (propname.length() > 0) {\n833:                         properties.add(propname);\n834:                         properties.add(propvalue);\n835:                     }\n836:                 } else if (\":\".equals(token)) {\n837:                     hasColon = true;\n838:                 } else if (\"=\".equals(token)) {\n839:                     throw new ParseException(\"Operations cannot have \"\n840:                             + \"default values\", st.getTokenIndex());\n841:                 } else if (token.charAt(0) == '(' && !hasColon) {\n842:                     if (parameterlist != null)\n843:                         throw new ParseException(\"Operations cannot have two \"\n844:                                 + \"parameter lists\", st.getTokenIndex());\n845: \n846:                     parameterlist = token;\n847:                 } else {\n848:                     if (hasColon) {\n849:                         if (type != null)\n850:                             throw new ParseException(\"Operations cannot have \"\n851:                                     + \"two types\", st.getTokenIndex());\n852: \n853:                         if (token.length() > 0\n854:                                 && (token.charAt(0) == '\\\"' \n855:                                     || token.charAt(0) == '\\''))\n856:                             throw new ParseException(\"Type cannot be quoted\",\n857:                                     st.getTokenIndex());\n858: \n859:                         if (token.length() > 0 && token.charAt(0) == '(')\n860:                             throw new ParseException(\"Type cannot be an \"\n861:                                     + \"expression\", st.getTokenIndex());\n862: \n863:                         type = token;\n864:                     } else {\n865:                         if (name != null && visibility != null)\n866:                             throw new ParseException(\"Extra text in Operation\",\n867:                                     st.getTokenIndex());\n868: \n869:                         if (token.length() > 0\n870:                                 && (token.charAt(0) == '\\\"' \n871:                       