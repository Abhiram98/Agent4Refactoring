                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/persistence/ZipFilePersister.java: \n1: // $Id$\n2: // Copyright (c) 1996-2006 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.persistence;\n26: \n27: import java.io.BufferedOutputStream;\n28: import java.io.File;\n29: import java.io.FileNotFoundException;\n30: import java.io.FileOutputStream;\n31: import java.io.IOException;\n32: import java.io.InputStream;\n33: import java.io.OutputStream;\n34: import java.io.OutputStreamWriter;\n35: import java.net.URL;\n36: import java.util.zip.ZipEntry;\n37: import java.util.zip.ZipInputStream;\n38: import java.util.zip.ZipOutputStream;\n39: \n40: import org.apache.log4j.Logger;\n41: import org.argouml.i18n.Translator;\n42: import org.argouml.kernel.Project;\n43: import org.argouml.kernel.ProjectManager;\n44: import org.argouml.kernel.ProjectMember;\n45: import org.argouml.model.Model;\n46: import org.argouml.uml.ProjectMemberModel;\n47: import org.argouml.uml.cognitive.ProjectMemberTodoList;\n48: import org.argouml.uml.diagram.ProjectMemberDiagram;\n49: import org.xml.sax.InputSource;\n50: \n51: /**\n52:  * To persist to and from zipped xmi file storage.\n53:  *\n54:  * @author Bob Tarling\n55:  * @author Ludovic Ma&icirc;tre\n56:  */\n57: public class ZipFilePersister extends XmiFilePersister {\n58:     /**\n59:      * Logger.\n60:      */\n61:     private static final Logger LOG =\n62:         Logger.getLogger(ZipFilePersister.class);\n63: \n64:     /**\n65:      * The constructor.\n66:      */\n67:     public ZipFilePersister() {\n68:     }\n69: \n70:     /**\n71:      * @see org.argouml.persistence.AbstractFilePersister#getExtension()\n72:      */\n73:     public String getExtension() {\n74:         return \"zip\";\n75:     }\n76: \n77:     /**\n78:      * @see org.argouml.persistence.AbstractFilePersister#getDesc()\n79:      */\n80:     protected String getDesc() {\n81:         return Translator.localize(\"combobox.filefilter.zip\");\n82:     }\n83: \n84:     /**\n85:      * It is being considered to save out individual xmi's from individuals\n86:      * diagrams to make it easier to modularize the output of Argo.\n87:      *\n88:      * @param file\n89:      *            The file to write.\n90:      * @param project\n91:      *            the project to save\n92:      * @throws SaveException\n93:      *             when anything goes wrong\n94:      *\n95:      * @see org.argouml.persistence.ProjectFilePersister#save(\n96:      *      org.argouml.kernel.Project, java.io.File)\n97:      */\n98:     public void doSave(Project project, File file) throws SaveException {\n99: \n100:         LOG.info(\"Receiving file '\" + file.getName() + \"'\");\n101: \n102:         File lastArchiveFile = new File(file.getAbsolutePath() + \"~\");\n103:         File tempFile = null;\n104: \n105:         try {\n106:             tempFile = createTempFile(file);\n107:         } catch (FileNotFoundException e) {\n108:             throw new SaveException(\n109:                     \"Failed to archive the previous file version\", e);\n110:         } catch (IOException e) {\n111:             throw new SaveException(\n112:                     \"Failed to archive the previous file version\", e);\n113:         }\n114: \n115:         OutputStreamWriter writer = null;\n116:         try {\n117:             //project.setFile(file);\n118: \n119:             ZipOutputStream stream =\n120:                 new ZipOutputStream(new FileOutputStream(file));\n121:             String fileName = file.getName();\n122:             ZipEntry xmiEntry =\n123:                 new ZipEntry(fileName.substring(0, fileName.lastIndexOf(\".\")));\n124:             stream.putNextEntry(xmiEntry);\n125:             OutputStream bout = new BufferedOutputStream(stream);\n126:             writer = new OutputStreamWriter(bout, getEncoding());\n127: \n128:             int size = project.getMembers().size();\n129:             for (int i = 0; i < size; i++) {\n130:                 ProjectMember projectMember =\n131:                     (ProjectMember) project.getMembers().get(i);\n132:                 if (projectMember.getType().equalsIgnoreCase(\"xmi\")) {\n133:                     if (LOG.isInfoEnabled()) {\n134:                         LOG.info(\"Saving member of type: \"\n135:                               + ((ProjectMember) project.getMembers()\n136:                                     .get(i)).getType());\n137:                     }\n138:                     MemberFilePersister persister\n139:                         = new ModelMemberFilePersister();\n140:                     persister.save(projectMember, writer, null);\n141:                 }\n142:             }\n143:             stream.close();\n144:             // if save did not raise an exception\n145:             // and name+\"#\" exists move name+\"#\" to name+\"~\"\n146:             // this is the correct backup file\n147:             if (lastArchiveFile.exists()) {\n148:                 lastArchiveFile.delete();\n149:             }\n150:             if (tempFile.exists() && !lastArchiveFile.exists()) {\n151:                 tempFile.renameTo(lastArchiveFile);\n152:             }\n153:             if (tempFile.exists()) {\n154:                 tempFile.delete();\n155:             }\n156:         } catch (Exception e) {\n157:             LOG.error(\"Exception occured during save attempt\", e);\n158:             try {\n159:                 writer.close();\n160:             } catch (IOException ex) { }\n161: \n162:             // frank: in case of exception\n163:             // delete name and mv name+\"#\" back to name if name+\"#\" exists\n164:             // this is the \"rollback\" to old file\n165:             file.delete();\n166:             tempFile.renameTo(file);\n167:             // we have to give a message to user and set the system to unsaved!\n168:             throw new SaveException(e);\n169:         }\n170: \n171:         try {\n172:             writer.close();\n173:         } catch (IOException ex) {\n174:             LOG.error(\"Failed to close save output writer\", ex);\n175:         }\n176:     }\n177: \n178:     /**\n179:      * Get a MemberFilePersister based on a given ProjectMember.\n180:      *\n181:      * @param pm the project member\n182:      * @return the persister\n183:      */\n184:     protected MemberFilePersister getMemberFilePersister(ProjectMember pm) {\n185:         MemberFilePersister persister = null;\n186:         if (pm instanceof ProjectMemberDiagram) {\n187:             persister =\n188:                 PersistenceManager.getInstance()\n189:                     .getDiagramMemberFilePersister();\n190:         } else if (pm instanceof ProjectMemberTodoList) {\n191:             persister = new TodoListMemberFilePersister();\n192:         } else if (pm instanceof ProjectMemberModel) {\n193:             persister = new ModelMemberFilePersister();\n194:         }\n195:         return persister;\n196:     }\n197: \n198:     /**\n199:      * @see org.argouml.persistence.ProjectFilePersister#doLoad(java.io.File)\n200:      */\n201:     public Project doLoad(File file)\n202:         throws OpenException {\n203: \n204:         LOG.info(\"Receiving file '\" + file.getName() + \"'\");\n205: \n206:         try {\n207:             Project p = new Project();\n208:             String fileName = file.getName();\n209:             String extension =\n210:                 fileName.substring(\n211:                         fileName.indexOf('.'),\n212:                         fileName.lastIndexOf('.'));\n213:             InputStream stream = openZipStreamAt(file.toURL(), extension);\n214:             InputSource is = new InputSource(stream);\n215:             is.setSystemId(file.toURL().toExternalForm());\n216:             XMIParser.getSingleton().readModels(p, is);\n217:             XMIParser.getSingleton().registerDiagrams(p);            \n218:             Object model = XMIParser.getSingleton().getCurModel();\n219:             Model.getUmlHelper().addListenersToModel(model);\n220:             p.setUUIDRefs(XMIParser.getSingleton().getUUIDRefs());\n221:             p.addMember(new ProjectMemberTodoList(\"\", p));\n222:             p.addMember(model);\n223:             p.setRoot(model);\n224:             ProjectManager.getManager().setSaveEnabled(false);\n225:             return p;\n226:         } catch (IOException e) {\n227:             throw new OpenException(e);\n228:         }\n229: \n230:     }\n231: \n232:     /**\n233:      * Open a ZipInputStream to the first file found with a given extension.\n234:      *\n235:      * @param uri\n236:      *            The URL of the zip file.\n237:      * @param ext\n238:      *            The required extension.\n239:      * @return the zip stream positioned at the required location.\n240:      * @throws IOException\n241:      *             if there is a problem opening the file.\n242:      */\n243:     private ZipInputStream openZipStreamAt(URL uri, String ext)\n244:         throws IOException {\n245:         ZipInputStream zis = new ZipInputStream(uri.openStream());\n246:         ZipEntry entry = zis.getNextEntry();\n247:         while (entry != null && !entry.getName().endsWith(ext)) {\n248:             entry = zis.getNextEntry();\n249:         }\n250:         return zis;\n251:     }\n252: \n253:     /**\n254:      * Returns false. Only Argo specific files have an icon.\n255:      * \n256:      * @see org.argouml.persistence.AbstractFilePersister#hasAnIcon()\n257:      */\n258:     public boolean hasAnIcon() {\n259:         return false;\n260:     }\n261: }\n262: ",
