 (name.toLowerCase().endsWith(\".\" + defaultPersister.getExtension()))\n94:             return defaultPersister;\n95:         Iterator iter = otherPersisters.iterator();\n96:         while (iter.hasNext()) {\n97:             AbstractFilePersister persister =\n98:                 (AbstractFilePersister) iter.next();\n99:             if (name.toLowerCase().endsWith(\".\" + persister.getExtension())) {\n100:                 return persister;\n101:             }\n102:         }\n103:         return null;\n104:     }\n105: \n106:     /**\n107:      * @param chooser the filechooser of which the filters will be set\n108:      */\n109:     public void setFileChooserFilters(JFileChooser chooser) {\n110:         chooser.addChoosableFileFilter(defaultPersister);\n111:         Iterator iter = otherPersisters.iterator();\n112:         while (iter.hasNext()) {\n113:             chooser.addChoosableFileFilter((AbstractFilePersister) iter.next());\n114:         }\n115:         chooser.setFileFilter(defaultPersister);\n116:     }\n117: \n118:     /**\n119:      * @return the extension of the default persister\n120:      *         (just the text, not the \".\")\n121:      */\n122:     public String getDefaultExtension() {\n123:         return defaultPersister.getExtension();\n124:     }\n125: \n126:     /**\n127:      * @param in the input file or path name which may or may not\n128:      *           have a recognised extension\n129:      * @return the amended file or pathname, guaranteed to have\n130:      *         a recognised extension\n131:      */\n132:     public String fixExtension(String in) {\n133:         if (getPersisterFromFileName(in) == null) {\n134:             in += \".\" + getDefaultExtension();\n135:         }\n136:         return in;\n137:     }\n138: \n139:     /**\n140:      * @param in the input url which may or may not have a recognised extension\n141:      * @return the url with default extension added,\n142:      *         if it did not have a valid extension yet\n143:      */\n144:     public URL fixUrlExtension(URL in) {\n145:         URL newUrl;\n146:         String n = in.toString();\n147:         n = fixExtension(n);\n148:         try {\n149:             newUrl = new URL(n);\n150:         } catch (java.net.MalformedURLException e) {\n151:             throw new UnexpectedException(e);\n152:         }\n153:         return newUrl;\n154:     }\n155: \n156:     /**\n157:      * Find the base name of the given filename.<p>\n158:      *\n159:      * This is the name minus any valid file extension.\n160:      * Invalid extensions are left alone.\n161:      *\n162:      * @param n the given file name\n163:      * @return the name (a String) without extension\n164:      */\n165:     public String getBaseName(String n) {\n166:         AbstractFilePersister p = getPersisterFromFileName(n);\n167:         if (p == null) {\n168:             return n;\n169:         }\n170:         int extLength = p.getExtension().length() + 1;\n171:         return n.substring(0, n.length() - extLength);\n172:     }\n173: \n174:     /**\n175:      * Generates a String dump of the current model for quick viewing.\n176:      *\n177:      * @param project The project to generate.\n178:      * @return The whole model in a String.\n179:      */\n180:     public String getQuickViewDump(Project project) {\n181:         OutputStream stream = new ByteArrayOutputStream();\n182:         try {\n183:             quickViewDump.writeProject(project, stream);\n184:         } catch (SaveException e) {\n185:             // If anything goes wrong return the stack\n186:             // trace as a string so that we get some\n187:             // useful feedback.\n188:             e.printStackTrace(new PrintStream(stream));\n189:         }\n190:         return stream.toString();\n191:     }\n192: }\n193: ",
