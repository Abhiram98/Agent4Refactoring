                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/notation/Notation.java: \n1: // $Id$\n2: // Copyright (c) 1996-2005 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.notation;\n26: \n27: import java.beans.PropertyChangeEvent;\n28: import java.beans.PropertyChangeListener;\n29: import java.util.ArrayList;\n30: import java.util.Collection;\n31: import java.util.Iterator;\n32: \n33: import javax.swing.Icon;\n34: \n35: import org.apache.log4j.Logger;\n36: import org.argouml.application.api.Configuration;\n37: import org.argouml.application.api.ConfigurationKey;\n38: import org.argouml.application.events.ArgoEventPump;\n39: import org.argouml.application.events.ArgoEventTypes;\n40: import org.argouml.application.events.ArgoNotationEvent;\n41: import org.argouml.model.Model;\n42: import org.argouml.uml.generator.GeneratorDisplay;\n43: \n44: /**\n45:  * Provides centralized methods dealing with notation.\n46:  *\n47:  * @stereotype singleton\n48:  * @author Thierry Lach\n49:  * @since 0.9.4\n50:  */\n51: public final class Notation implements PropertyChangeListener {\n52: \n53:     /**\n54:      * Define a static log4j category variable for ArgoUML notation.\n55:      */\n56:     private static final Logger LOG =\n57:         Logger.getLogger(Notation.class);\n58: \n59:     /**\n60:      * The name of the default ArgoUML notation.  This notation is\n61:      * part of ArgoUML core distribution.\n62:      */\n63:     private static NotationName notationArgo =\n64:         GeneratorDisplay.getInstance().getNotation();\n65:     /*\n66:      * Remark:\n67:      * There is also a java-like notation, which is also\n68:      * part of ArgoUML core distribution.\n69:      */\n70: \n71:     /**\n72:      * The configuration key for the preferred notation.\n73:      */\n74:     public static final ConfigurationKey KEY_DEFAULT_NOTATION =\n75:         Configuration.makeKey(\"notation\", \"default\");\n76: \n77:     /**\n78:      * The configuration key that indicates whether to show stereotypes\n79:      * in the navigation panel.\n80:      */\n81:     public static final ConfigurationKey KEY_SHOW_STEREOTYPES =\n82:         Configuration.makeKey(\"notation\", \"navigation\", \"show\", \"stereotypes\");\n83: \n84:     /**\n85:      * The configuration key that indicates whether to use guillemots\n86:      * or greater/lessthan characters in stereotypes.\n87:      */\n88:     public static final ConfigurationKey KEY_USE_GUILLEMOTS =\n89:         Configuration.makeKey(\"notation\", \"guillemots\");\n90: \n91:     /**\n92:      * Indicates if the user only wants to see UML notation.\n93:      */\n94:     public static final ConfigurationKey KEY_UML_NOTATION_ONLY =\n95:         Configuration.makeKey(\"notation\", \"only\", \"uml\");\n96: \n97:     /**\n98:      * Indicates if the user wants to see visibility signs (public,\n99:      * private, protected or # + -).\n100:      */\n101:     public static final ConfigurationKey KEY_SHOW_VISIBILITY =\n102:         Configuration.makeKey(\"notation\", \"show\", \"visibility\");\n103: \n104:     /**\n105:      * Indicates if the user wants to see multiplicity in attributes\n106:      * and classes.\n107:      */\n108:     public static final ConfigurationKey KEY_SHOW_MULTIPLICITY =\n109:         Configuration.makeKey(\"notation\", \"show\", \"multiplicity\");\n110: \n111:     /**\n112:      * Indicates if the user wants to see the initial value.\n113:      */\n114:     public static final ConfigurationKey KEY_SHOW_INITIAL_VALUE =\n115:         Configuration.makeKey(\"notation\", \"show\", \"initialvalue\");\n116: \n117:     /**\n118:      * Indicates if the user wants to see the properties (everything\n119:      * between braces), that is for example the concurrency.\n120:      */\n121:     public static final ConfigurationKey KEY_SHOW_PROPERTIES =\n122:         Configuration.makeKey(\"notation\", \"show\", \"properties\");\n123: \n124:     /**\n125:      * Indicates if the user wants to see the types and parameters\n126:      * of attributes and operations.\n127:      */\n128:     public static final ConfigurationKey KEY_SHOW_TYPES =\n129:         Configuration.makeKey(\"notation\", \"show\", \"types\");\n130: \n131:     /**\n132:      * Default value for the shadow size of classes, interfaces etc.\n133:      */\n134:     public static final ConfigurationKey KEY_DEFAULT_SHADOW_WIDTH =\n135:         Configuration.makeKey(\"notation\", \"default\", \"shadow-width\");\n136: \n137:     /**\n138:      * The instance.\n139:      */\n140:     private static final Notation SINGLETON = new Notation();\n141: \n142: \n143:     /**\n144:      * The constructor.\n145:      */\n146:     private Notation() {\n147:         Configuration.addListener(KEY_USE_GUILLEMOTS, this);\n148:         Configuration.addListener(KEY_DEFAULT_NOTATION, this);\n149:         Configuration.addListener(KEY_UML_NOTATION_ONLY, this);\n150:         Configuration.addListener(KEY_SHOW_TYPES, this);\n151:         Configuration.addListener(KEY_SHOW_MULTIPLICITY, this);\n152:         Configuration.addListener(KEY_SHOW_PROPERTIES, this);\n153:         Configuration.addListener(KEY_SHOW_VISIBILITY, this);\n154:         Configuration.addListener(KEY_SHOW_INITIAL_VALUE, this);\n155:     }\n156: \n157:     /**\n158:      * Remove the notation change listener.\n159:      * <code>finalize</code> should never happen, but play it safe.\n160:      *\n161:      * TODO: Explain why we don't call super.finalize()!\n162:      */\n163:     protected void finalize() {\n164:         Configuration.removeListener(KEY_DEFAULT_NOTATION, this);\n165:         Configuration.removeListener(KEY_USE_GUILLEMOTS, this);\n166:         Configuration.removeListener(KEY_UML_NOTATION_ONLY, this);\n167:         Configuration.removeListener(KEY_SHOW_TYPES, this);\n168:         Configuration.removeListener(KEY_SHOW_MULTIPLICITY, this);\n169:         Configuration.removeListener(KEY_SHOW_PROPERTIES, this);\n170:         Configuration.removeListener(KEY_SHOW_VISIBILITY, this);\n171:         Configuration.removeListener(KEY_SHOW_INITIAL_VALUE, this);\n172:     }\n173: \n174:     private static NotationProvider2 getProvider(NotationName notation) {\n175:         NotationProvider2 np;\n176:         np = NotationProviderFactory.getInstance().getProvider(notation);\n177:         LOG.debug(\"getProvider(\" + notation + \") returns \" + np);\n178:         return np;\n179:     }\n180: \n181:     /**\n182:      * @param n the NotationName that will become default\n183:      */\n184:     public static void setDefaultNotation(NotationName n) {\n185:         LOG.info(\"default notation set to \" + n.getConfigurationValue());\n186:         Configuration.setString(\n187:             KEY_DEFAULT_NOTATION,\n188:             n.getConfigurationValue());\n189:     }\n190: \n191:     /**\n192:      * Convert a String into a NotationName.\n193:      * @param s the String\n194:      * @return the matching Notationname\n195:      */\n196:     public static NotationName findNotation(String s) {\n197:         return NotationNameImpl.findNotation(s);\n198:     }\n199: \n200:     /**\n201:      * Returns the Notation as set in the menu.\n202:      *\n203:      * @return the default NotationName\n204:      */\n205:     public static NotationName getConfigueredNotation() {\n206:         NotationName n =\n207:             NotationNameImpl.findNotation(\n208:                 Configuration.getString(\n209:                     KEY_DEFAULT_NOTATION,\n210:                     notationArgo.getConfigurationValue()));\n211:         // This is needed for the case when the default notation is\n212:         // not loaded at this point.\n213:         if (n == null) {\n214:             n = NotationNameImpl.findNotation(\"UML 1.4\");\n215: \t}\n216:         LOG.debug(\"default notation is \" + n.getConfigurationValue());\n217:         return n;\n218:     }\n219: \n220:     ////////////////////////////////////////////////////////////////\n221:     // class accessors\n222: \n223:     /**\n224:      * General accessor for an extension point.<p>\n225:      *\n226:      * @param notation    Name of the notation to be used.\n227:      *\n228:      * @param ep          The extension point to generate for.\n229:      *\n230:      * @return            The generated text.\n231:      */\n232:     protected static String generateExtensionPoint(\n233:         NotationName notation,\n234:         Object/*MExtensionPoint*/ ep) {\n235:         return getProvider(notation)\n236: \t    .generateExtensionPoint(ep);\n237:     }\n238: \n239:     private static String generateOperation(\n240:         NotationName notation,\n241:         Object/*MOperation*/ op,\n242:         boolean documented) {\n243:         return getProvider(notation).generateOperation(op, documented);\n244:     }\n245: \n246:     private static String generateAttribute(\n247:         NotationName notation,\n248:         Object/*MAttribute*/ attr,\n249:         boolean documented) {\n250:         return getProvider(notation).generateAttribute(attr, documented);\n251:     }\n252: \n253:     private static String generateParameter(\n254:         NotationName notation,\n255:         Object/*MParameter*/ param) {\n256:         return getProvider(notation).generateParameter(param);\n257:     }\n258: \n259:     private static String generateName(NotationName notation, String name) {\n260:         return getProvider(notation).generateName(name);\n261:     }\n262: \n263:     private static String generatePackage(NotationName notation,\n264: \t\t\t\t     Object/*MPackage*/ pkg) {\n265:         return getProvider(notation).generatePackage(pkg);\n266:     }\n267: \n268:     private static String generateExpression(\n269:         NotationName notation,\n270:         Object/*MExpression*/ expr) {\n271:         return getProvider(notation).generateExpression(expr);\n272:     }\n273: \n274:     private static String generateClassifier(\n275:         NotationName notation,\n276:         Object/*MClassifier*/ cls) {\n277:         return getProvider(notation).generateClassifier(cls);\n278:     }\n279: \n280:     private static String generateStereotype(NotationName notation,\n281: \t\t\t\t\tObject/*MStereotype*/ s) {\n282:         return getProvider(notation).generateStereotype(s);\n283:     }\n284: \n285:     private static String generateTaggedValue(\n286:         NotationName notation,\n287:         Object/*MTaggedValue*/ s) {\n288:         return getProvider(notation).generateTaggedValue(s);\n289:     }\n290: \n291:     private static String generateAssociation(\n292:         NotationName notation,\n293:         Object/*MAssociation*/ a) {\n294:         return getProvider(notation).generateAssociation(a);\n295:     }\n296: \n297:     private static String generateAssociationEnd(\n298:         NotationName notation,\n299:         Object/*MAssociationEnd*/ ae) {\n300:         return getProvider(notation)\n301: \t    .generateAssociationEnd(ae);\n302:     }\n303: \n304:     private static String generateMultiplicity(\n305:         NotationName notation,\n306:         Object/*MMultiplicity*/ m) {\n307:         return getProvider(notation).generateMultiplicity(m);\n308:     }\n309: \n310:     private static String generateState(NotationName notation,\n311: \t\t\t\t\t  Object/*MState*/ m) {\n312:         return getProvider(notation).generateState(m);\n313:     }\n314: \n315:     private static String generateSubmachine(NotationName notation,\n316:                       Object/*MSubmachineState*/ m) {\n317:         return getProvider(notation).generateSubmachine(m);\n318:     }\n319: \n320:     private static String generateObjectFlowState(NotationName notation,\n321:           Object/*MObjectFlowState*/ m) {\n322:         return getProvider(notation).generateObjectFlowState(m);\n323:     }\n324: \n325:     private static String generateClassifierInState(NotationName notation,\n326:             Object/*MObjectFlowState*/ m) {\n327:         Collection c = Model.getFacade().getInStates(m);\n328:         // MVW: I have no idea how to handle multiple states,\n329:         // so we go for the 1st one..\n330:         Iterator i = c.iterator();\n331:         if (i.hasNext()) {\n332:             return getProvider(notation).generateState(i.next());\n333:         }\n334:         return \"\";\n335:     }\n336: \n337:     private static String generateStateBody(NotationName notation,\n338:                                         Object/*MState*/ stt) {\n339:         return getProvider(notation).generateStateBody(stt);\n340:     }\n341: \n342:     private static String generateTransition(NotationName notation,\n343: \t\t\t\t\tObject/*MTransition*/ m) {\n344:         return getProvider(notation).generateTransition(m);\n345:     }\n346: \n347:     private static String generateVisibility(NotationName notation,\n348: \t\t\t\t\tObject /*MVisibilityKind*/ m) {\n349:         return getProvider(notation).generateVisibility(m);\n350:     }\n351: \n352:     private static String generateAction(NotationName notation, Object m) {\n353:         return getProvider(notation).generateAction(m);\n354:     }\n355: \n356:     private static String generateActionState(NotationName notation, Object m) {\n357:         return getProvider(notation).generateActionState(m);\n358:     }\n359: \n360:     private static String generateGuard(NotationName notation,\n361: \t\t\t\t\t  Object/*MGuard*/ m) {\n362:         return getProvider(notation).generateGuard(m);\n363:     }\n364: \n365:     private static String generateMessage(NotationName notation,\n366: \t\t\t\t     Object/*MMessage*/ m) {\n367:         return getProvider(notation).generateMessage(m);\n368:     }\n369: \n370:     private static String generateClassifierRef(\n371:         NotationName notation,\n372:         Object/*MClassifier*/ m) {\n373:         return getProvider(notation).generateClassifierRef(m);\n374:     }\n375: \n376:     private static String generateAssociationRole(\n377:         NotationName notation,\n378:         Object/*MAssociationRole*/ m) {\n379:         return getProvider(notation)\n380: \t    .generateAssociationRole(m);\n381:     }\n382: \n383:     ////////////////////////////////////////////////////////////////\n384:     // static accessors\n385: \n386:     /**\n387:      * @return the singleton\n388:      */\n389:     public static Notation getInstance() {\n390:         return SINGLETON;\n391:     }\n392: \n393:     /**\n394:      * Static accessor for extension point generation. Invokes our protected\n395:      * accessor from the singleton instance with the \"documented\" flag set\n396:      * false.<p>\n397:      *\n398:      * @param ctx  Context used to identify the notation\n399:      *\n400:      * @param ep   The extension point to generate for.\n401:      *\n402:      * @return     The generated text.\n403:      */\n404:     public static String generateExtensionPoint(\n405:         NotationContext ctx,\n406:         Object/*MExtensionPoint*/ ep) {\n407:         return generateExtensionPoint(Notation.getNotation(ctx), ep);\n408:     }\n409: \n410:     /**\n411:      * Static accessor for operation generation.  Invokes our protected\n412:      * accessor from the singleton instance with the \"documented\" flag set\n413:      * false.<p>\n414:      *\n415:      * @param ctx  Context used to identify the notation\n416:      * @param op   The operation to generate for.\n417:      * @return     The generated text.\n418:      */\n419:     public static String generateOperation(\n420:         NotationContext ctx,\n421:         Object/*MOperation*/ op) {\n422:         return generateOperation(Notation.getNotation(ctx), op, false);\n423:     }\n424: \n425:     /**\n426:      * @param ctx  Context used to identify the notation\n427:      * @param op   The operation to generate for.\n428:      * @param documented <code>true</code> if documentation shall be generated.\n429:      * @return     The generated text.\n430:      */\n431:     public static String generateOperation(\n432:         NotationContext ctx,\n433:         Object/*MOperation*/ op,\n434:         boolean documented) {\n435:         return generateOperation(Notation.getNotation(ctx), op, documented);\n436:     }\n437: \n438:     /**\n439:      * @param ctx  Context used to identify the notation\n440:      * @param attr   The attribute to generate for.\n441:      * @return     The generated text.\n442:      */\n443:     public static String generateAttribute(\n444:         NotationContext ctx,\n445:         Object/*MAttribute*/ attr) {\n446:         return generateAttribute(Notation.getNotation(ctx), attr, false);\n447:     }\n448: \n449:     /**\n450:      * @param ctx  Context used to identify the notation\n451:      * @param attr   The attribute to generate for.\n452:      * @param documented <code>true</code> if documentation shall be generated.\n453:      * @return     The generated text.\n454:      */\n455:     public static String generateAttribute(\n456:         NotationContext ctx,\n457:         Object/*MAttribute*/ attr,\n458:         boolean documented) {\n459:         return generateAttribute(Notation.getNotation(ctx), attr, documented);\n460:     }\n461: \n462:     /**\n463:      * @param ctx  Context used to identify the notation\n464:      * @param param   The parameter to generate for.\n465:      * @return     The generated text.\n466:      */\n467:     public static String generateParameter(\n468:         NotationContext ctx,\n469:         Object/*MParameter*/ param) {\n470:         return generateParameter(Notation.getNotation(ctx), param);\n471:     }\n472: \n473:     /**\n474:      * @param ctx  Context used to identify the notation\n475:      * @param p   The UML element to generate for.\n476:      * @return     The generated text.\n477:      */\n478:     public static String generatePackage(NotationContext ctx,\n479: \t\t\t\t\t Object/*MPackage*/ p) {\n480:         return generatePackage(Notation.getNotation(ctx), p);\n481:     }\n482: \n483:     /**\n484:      * @param ctx  Context used to identify the notation\n485:      * @param cls   The UML element to generate for.\n486:      * @return     The generated text.\n487:      */\n488:     public static String generateClassifier(\n489:         NotationContext ctx,\n490:         Object/*MClassifier*/ cls) {\n491:         return generateClassifier(Notation.getNotation(ctx), cls);\n492:     }\n493: \n494:     /**\n495:      * There is no need for a version that handles a Collection of\n496:      * Stereotypes, since that is only needed for display, \n497:      * and hence already handled in ParserDisplay, e.g. for attributes.\n498:      * \n499:      * @param ctx  Context used to identify the notation\n500:      * @param s   The UML element to generate for.\n501:      * @return     The generated text.\n502:      */\n503:     public static String generateStereotype(\n504:             NotationContext ctx,\n505:             Object/*MStereotype*/ s) {\n506:         return generateStereotype(Notation.getNotation(ctx), s);\n507:     }\n508: \n509:     /**\n510:      * @param ctx  Context used to identify the notation\n511:      * @param s   The UML element to generate for.\n512:      * @return     The generated text.\n513:      */\n514:     public static String generateTaggedValue(\n515:         NotationContext ctx,\n516:         Object/*MTaggedValue*/ s) {\n517:         return generateTaggedValue(Notation.getNotation(ctx), s);\n518:     }\n519: \n520:     /**\n521:      * @param ctx  Context used to identify the notation\n522:      * @param a   The UML element to generate for.\n523:      * @return     The generated text.\n524:      */\n525:     public static String generateAssociation(\n526:         NotationContext ctx,\n527:         Object/*MAssociation*/ a) {\n528:         return generateAssociation(Notation.getNotation(ctx), a);\n529:     }\n530: \n531:     /**\n532:      * @param ctx  Context used to identify the notation\n533:      * @param ae   The UML element to generate for.\n534:      * @return     The generated text.\n535:      */\n536:     public static String generateAssociationEnd(\n537:         NotationContext ctx,\n538:         Object/*MAssociationEnd*/ ae) {\n539:         return generateAssociationEnd(Notation.getNotation(ctx), ae);\n540:     }\n541: \n542:     /**\n543:      * @param ctx  Context used to identify the notation\n544:      * @param m   The UML element to generate for.\n545:      * @return     The generated text.\n546:      */\n547:     public static String generateMultiplicity(\n548:         NotationContext ctx,\n549:         Object/*MMultiplicity*/ m) {\n550:         return generateMultiplicity(Notation.getNotation(ctx), m);\n551:     }\n552: \n553:     /**\n554:      * @param ctx  Context used to identify the notation\n555:      * @param m   The UML element to generate for.\n556:      * @return     The generated text.\n557:      */\n558:     public static String generateState(NotationContext ctx,\n559: \t\t\t\t       Object/*MState*/ m) {\n560:         return generateState(Notation.getNotation(ctx), m);\n561:     }\n562: \n563:     /**\n564:      * @param ctx  Context used to identify the notation\n565:      * @param m   The UML element to generate for.\n566:      * @return     The generated text.\n567:      */\n568:     public static String generateStateBody(NotationContext ctx,\n569: \t\t\t\t\t   Object/*MState*/ m) {\n570:         return generateStateBody(Notation.getNotation(ctx), m);\n571:     }\n572: \n573:     /**\n574:      * @param ctx  Context used to identify the notation\n575:      * @param m   The UML element to generate for.\n576:      * @return     The generated text.\n577:      */\n578:     public static String generateTransition(\n579:         NotationContext ctx,\n580:         Object/*MTransition*/ m) {\n581:         return generateTransition(Notation.getNotation(ctx), m);\n582:     }\n583: \n584:     /**\n585:      * @param ctx  Context used to identify the notation\n586:      * @param m   The UML element to generate for.\n587:      * @return     The generated text.\n588:      */\n589:     public static String generateVisibility(\n590:         NotationContext ctx,\n591:         Object m) {\n592:         return generateVisibility(Notation.getNotation(ctx), m);\n593:     }\n594: \n595:     /**\n596:      * @param ctx  Context used to identify the notation\n597:      * @param m   The UML element to generate for.\n598:      * @return     The generated text.\n599:      */\n600:     public static String generateAction(NotationContext ctx, Object m) {\n601:         return generateAction(Notation.getNotation(ctx), m);\n602:     }\n603: \n604:     /**\n605:      * @param ctx  Context used to identify the notation\n606:      * @param m   The UML element to generate for.\n607:      * @return     The generated text.\n608:      */\n609:     public static String generateGuard(NotationContext ctx,\n610: \t\t\t\t       Object/*MGuard*/ m) {\n611:         return generateGuard(Notation.getNotation(ctx), m);\n612:     }\n613: \n614:     /**\n615:      * @param ctx  Context used to identify the notation\n616:      * @param m   The UML element to generate for.\n617:      * @return     The generated text.\n618:      */\n619:     public static String generateMessage(NotationContext ctx,\n620: \t\t\t\t\t Object/*MMessage*/ m) {\n621:         return generateMessage(Notation.getNotation(ctx), m);\n622:     }\n623: \n624:     /**\n625:      * @param ctx  Context used to identify the notation\n626:      * @param cls   The UML element to generate for.\n627:      * @return     The generated text.\n628:      */\n629:     public static String generateClassifierRef(\n630:         NotationContext ctx,\n631:         Object/*MClassifier*/ cls) {\n632:         return generateClassifierRef(Notation.getNotation(ctx), cls);\n633:     }\n634: \n635:     /**\n636:      * @param ctx  Context used to identify the notation\n637:      * @param m   The UML element to generate for.\n638:      * @return     The generated text.\n639:      */\n640:     public static String generateAssociationRole(\n641:         NotationContext ctx,\n642:         Object/*MAssociationRole*/ m) {\n643:         return generateAssociationRole(Notation.getNotation(ctx), m);\n644:     }\n645: \n646:     /**\n647:      * General purpose static generator for any object that wishes to set\n648:      * the documented flag.<p>\n649:      *\n650:      * Uses the class of the object to determine which method to\n651:      * invoke. Only actually looks for MOperation and MAttribute. All others\n652:      * invoke the simpler version with no documented flag, so taking the\n653:      * default version.\n654:      *\n655:      * @param ctx        The context to look up the notation generator.\n656:      *\n657:      * @param o          The object to generate.\n658:      *\n659:      * @param documented  This flag only has any effect for\n660:      * Operations and Attributes.\n661:      * See {@link GeneratorJava#generateConstraintEnrichedDocComment()}.\n662:      *\n663:      * @return            The generated string.\n664:      */\n665:     public static String generate(\n666:         NotationContext ctx,\n667:         Object o,\n668:         boolean documented) {\n669:         if (o == null) {\n670:             return \"\";\n671: \t}\n672:         return generate(getNotation(ctx), o, documented);\n673:     }\n674: \n675:     /**\n676:      * General purpose static generator for any object that wishes to set\n677:      * the documented flag.<p>\n678:      *\n679:      * Uses the class of the object to determine which method to\n680:      * invoke. Only actually looks for MOperation and MAttribute. All others\n681:      * invoke the simpler version with no documented flag, so taking the\n682:      * default version.\n683:      *\n684:      * @param nn         The notation name.\n685:      *\n686:      * @param o          The object to generate.\n687:      *\n688:      * @param documented  This flag only has any effect for Operations and\n689:      * Attributes.\n690:      * See {@link GeneratorJava#generateConstraintEnrichedDocComment()}.\n691:      *\n692:      * @return            The generated string.\n693:      */\n694:     public static String generate(\n695:         NotationName nn,\n696:         Object o,\n697:         boolean documented) {\n698:         if (o == null) {\n699:             return \"\";\n700: \t}\n701:         if (Model.getFacade().isAOperation(o)) {\n702:             return generateOperation(nn, /*(MOperation)*/ o,\n703:                     \t\t     documented);\n704: \t}\n705:         if (Model.getFacade().isAAttribute(o)) {\n706:             return generateAttribute(nn, /*(MAttribute)*/ o,\n707: \t\t\t\t     documented);\n708: \t}\n709:         return generate(nn, o);\n710:     }\n711: \n712:     /**\n713:      * @param ctx  Context used to identify the notation\n714:      * @param o    The UML element to generate for.\n715:      * @return     The generated string.\n716:      */\n717:     public static String generate(NotationContext ctx, Object o) {\n718:         if (o == null) {\n719:             return \"\";\n720: \t}\n721:         return generate(getNotation(ctx), o);\n722:     }\n723: \n724:     /**\n725:      * @param nn   The NotationName to be used for the generation\n726:      * @param o    The UML element to generate for.\n727:      * @return     The generated string.\n728:      */\n729:     public static String generate(NotationName nn, Object o) {\n730:         if (o == null) {\n731:             return \"\";\n732: \t}\n733:         //added to support association roles\n734:         if (Model.getFacade().isAAssociationRole(o)) {\n735:             return generateAssociationRole(nn, o);\n736:         }\n737: \n738:         // Added to support extension points\n739:         if (Model.getFacade().isAExtensionPoint(o)) {\n740:             return generateExtensionPoint(nn, o);\n741:         }\n742: \n743:         if (Model.getFacade().isAOperation(o)) {\n744:             return generateOperation(nn, o, false);\n745: \t}\n746:         if (Model.getFacade().isASubmachineState(o)) {\n747:             return generateSubmachine(nn, o);\n748: \t}\n749:         if (Model.getFacade().isAAttribute(o)) {\n750:             return generateAttribute(nn, o, false);\n751: \t}\n752:         if (Model.getFacade().isAParameter(o)) {\n753:             return generateParameter(nn, o);\n754: \t}\n755:         if (Model.getFacade().isAPackage(o)) {\n756:             return generatePackage(nn, o);\n757: \t}\n758:         if (Model.getFacade().isAClassifier(o)) {\n759:             return generateClassifier(nn, o);\n760: \t}\n761:         if (Model.getFacade().isAExpression(o)) {\n762:             return generateExpression(nn, o);\n763: \t}\n764:         if (o instanceof String) {\n765:             return generateName(nn, (String) o);\n766: \t}\n767:         // if (o instanceof String) {\n768:         //     return generateUninterpreted(nn,(String) o);\n769: \t// }\n770:         if (Model.getFacade().isAStereotype(o)) {\n771:             return generateStereotype(nn, o);\n772: \t}\n773:         if (Model.getFacade().isATaggedValue(o)) {\n774:             return generateTaggedValue(nn, o);\n775: \t}\n776:         if (Model.getFacade().isAAssociation(o)) {\n777:             return generateAssociation(nn, o);\n778: \t}\n779:         if (Model.getFacade().isAAssociationEnd(o)) {\n780:             return generateAssociationEnd(nn, o);\n781: \t}\n782:         if (Model.getFacade().isAMultiplicity(o)) {\n783:             return generateMultiplicity(nn, o);\n784: \t}\n785:         if (Model.getFacade().isAActionState(o)) {\n786:             return generateActionState(nn, o);\n787:         }\n788:         if (Model.getFacade().isAObjectFlowState(o)) {\n789:             return generateObjectFlowState(nn, o);\n790:         }\n791:         if (Model.getFacade().isAClassifierInState(o)) {\n792:             return generateClassifierInState(nn, o);\n793:         }\n794:         if (Model.getFacade().isAState(o)) {\n795:             return generateState(nn, o);\n796: \t}\n797:         if (Model.getFacade().isATransition(o)) {\n798:             return generateTransition(nn, o);\n799: \t}\n800:         if (Model.getFacade().isAAction(o)) {\n801:             return generateAction(nn, o);\n802: \t}\n803:         if (Model.getFacade().isACallAction(o)) {\n804:             return generateAction(nn, o);\n805: \t}\n806:         if (Model.getFacade().isAGuard(o)) {\n807:             return generateGuard(nn, o);\n808: \t}\n809:         if (Model.getFacade().isAMessage(o)) {\n810:             return generateMessage(nn, o);\n811: \t}\n812:         if (Model.getFacade().isAVisibilityKind(o)) {\n813:             return generateVisibility(nn, o);\n814: \t}\n815: \n816:         if (Model.getFacade().isAModelElement(o)) {\n817:             return generateName(nn, Model.getFacade().getName(o));\n818: \t}\n819:         return o.toString();\n820:     }\n821: \n822:     /**\n823:      * @param context the notation context\n824:      * @return the notation name\n825:      */\n826:     public static NotationName getNotation(NotationContext context) {\n827:         // UML is the default language\n828:         if (Configuration.getBoolean(Notation.KEY_UML_NOTATION_ONLY, false)) {\n829:             return notationArgo;\n830:         }\n831:         // Otherwise we use the given context\n832:         return context.getContextNotation();\n833:     }\n834: \n835:     /**\n836:      * Called after the notation default property gets changed.\n837:      *\n838:      * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n839:      */\n840:     public void propertyChange(PropertyChangeEvent pce) {\n841:         LOG.info(\n842:             \"Notation change:\"\n843:                 + pce.getOldValue()\n844:                 + \" to \"\n845:                 + pce.getNewValue());\n846:         ArgoEventPump.fireEvent(\n847:             new ArgoNotationEvent(ArgoEventTypes.NOTATION_CHANGED, pce));\n848:     }\n849: \n850:     ////////////////////////////////////////////////////////////////\n851:     // TODO:  The following accessors are commented out\n852:     //                   and should 