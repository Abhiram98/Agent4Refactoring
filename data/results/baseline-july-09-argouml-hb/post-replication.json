or toolbar\n82:     \n83:     /**\n84:      * Tool to add a comment node.<p>\n85:      */\n86:     protected static Action _actionComment =\n87: \tnew RadioAction(new CmdCreateNode(ModelFacade.COMMENT, \"Note\"));\n88: \n89:     /**\n90:      * Tool to create an relationship between a comment node and some other node\n91:      * using a polyedge.<p>\n92:      */\n93:     protected static Action _actionCommentLink = new RadioAction(\n94:         new CmdSetMode(\n95:             ModeCreatePolyEdge.class,  \n96:             \"edgeClass\",\n97:             CommentEdge.class,\n98:             \"CommentLink\"));\n99: \n100: \n101:     protected static Action _actionSelect =\n102:         new CmdSetMode(ModeSelect.class, \"Select\");\n103: \n104:     protected static Action _actionBroom =\n105:         new CmdSetMode(ModeBroom.class, \"Broom\");\n106: \n107:     protected static Action _actionRectangle =\n108:         new RadioAction(new CmdSetMode(ModeCreateFigRect.class, \"Rectangle\",\n109:         Translator.localize(\"misc.primitive.rectangle\")));\n110: \n111:     protected static Action _actionRRectangle =\n112:         new RadioAction(new CmdSetMode(ModeCreateFigRRect.class, \"RRect\",\n113:         Translator.localize(\"misc.primitive.rounded-rectangle\")));\n114: \n115:     protected static Action _actionCircle =\n116:         new RadioAction(new CmdSetMode(ModeCreateFigCircle.class, \"Circle\",\n117:         Translator.localize(\"misc.primitive.circle\")));\n118: \n119:     protected static Action _actionLine =\n120:         new RadioAction(new CmdSetMode(ModeCreateFigLine.class, \"Line\",\n121:         Translator.localize(\"misc.primitive.line\")));\n122: \n123:     protected static Action _actionText =\n124:         new RadioAction(new CmdSetMode(ModeCreateFigText.class, \"Text\",\n125:         Translator.localize(\"misc.primitive.text\")));\n126: \n127:     protected static Action _actionPoly =\n128:         new RadioAction(new CmdSetMode(ModeCreateFigPoly.class, \"Polygon\",\n129:         Translator.localize(\"misc.primitive.polygon\")));\n130: \n131:     protected static Action _actionSpline =\n132:         new RadioAction(new CmdSetMode(ModeCreateFigSpline.class, \"Spline\",\n133:         Translator.localize(\"misc.primitive.spline\")));\n134: \n135:     protected static Action _actionInk =\n136:         new RadioAction(new CmdSetMode(ModeCreateFigInk.class, \"Ink\",\n137:         Translator.localize(\"misc.primitive.ink\")));\n138: \n139:     ////////////////////////////////////////////////////////////////\n140:     // instance variables\n141:     protected Object _namespace;\n142:     protected DiagramInfo _diagramName = new DiagramInfo(this);\n143: \n144:     private JToolBar toolBar;\n145: \n146:     ////////////////////////////////////////////////////////////////\n147:     // constructors\n148: \n149:     public UMLDiagram() {\n150:         super();\n151:     }\n152: \n153:     public UMLDiagram(Object handle) {\n154:         this();\n155: \n156:         if (!ModelFacade.isANamespace(handle))\n157:             throw new IllegalArgumentException();\n158: \n159:         setNamespace(handle);\n160:     }\n161: \n162:     public UMLDiagram(String diagramName, Object ns) {\n163:         this(ns);\n164:         try {\n165:             setName(diagramName);\n166:         } catch (PropertyVetoException pve) {\n167:             cat.fatal(\"Name not allowed in construction of diagram\");\n168:         }\n169:     }\n170: \n171:     public void initialize(Object owner) {\n172:         super.initialize(owner);\n173:         if (org.argouml.model.ModelFacade.isANamespace(owner))\n174:             setNamespace(owner);\n175:         else\n176:             cat.debug(\"unknown object in UMLDiagram initialize:\" + owner);\n177:     }\n178: \n179:     ////////////////////////////////////////////////////////////////\n180:     // accessors\n181: \n182:     public Object getNamespace() {\n183:         return _namespace;\n184:     }\n185: \n186:     /**\n187:      * sets the namespace of the Diagram, and\n188:      * adds the diagram as a listener of its namspace in the UML model.\n189:      * (so that it can delete itself when the model element is deleted).\n190:      */\n191:     public void setNamespace(Object ns) {\n192:         if (!ModelFacade.isANamespace(ns)) {\n193:             cat.error(\"Not a namespace\");\n194:             cat.error(ns);\n195:             throw new IllegalArgumentException(\"Given object not a namespace\");\n196:         }\n197:         _namespace = ns;\n198:         // add the diagram as a listener to the namspace so\n199:         // that when the namespace is remove()d the diagram is deleted also.\n200:         UmlModelEventPump.getPump().addModelEventListener(\n201:             this,\n202:             _namespace,\n203:             UmlModelEventPump.REMOVE);\n204:     }\n205: \n206:     public String getClassAndModelID() {\n207:         String s = super.getClassAndModelID();\n208:         if (getOwner() == null)\n209:             return s;\n210:         String id = ModelFacade.getUUID(getOwner());\n211:         return s + \"|\" + id;\n212:     }\n213: \n214:     // TODO: should be overwritten by each subclass of UMLDiagram\n215: \n216:     public Object getOwner() {\n217:         return getNamespace();\n218:     }\n219: \n220:     public void setName(String n) throws PropertyVetoException {\n221:         super.setName(n);\n222:         _diagramName.updateName();\n223:     }\n224: \n225:     static final long serialVersionUID = -401219134410459387L;\n226: \n227:     /**\n228:      * Get the toolbar for the diagram\n229:      * @return the diagram toolbar\n230:      */\n231:     public JToolBar getJToolBar() {\n232:         if (toolBar == null) {\n233:             initToolBar();\n234:         }\n235:         return toolBar;\n236:     }\n237: \n238:     /**\n239:      * Create the toolbar based on actions for the spcific diagram\n240:      * subclass.\n241:      * @s