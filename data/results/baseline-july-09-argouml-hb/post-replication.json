t>null</tt>.\n86:      */\n87:     public static NavigatorPane getInstance() {\n88: \tif (!theInstanceIsSet) {\n89: \t    theInstance = new NavigatorPane();\n90: \t    theInstanceIsSet = true;\n91: \t}\n92: \treturn theInstance;\n93:     }\n94:     \n95:     /**\n96:      * Allow setting of the navigator pane instance.\n97:      * Currently this is only applicable for unit tests that sets it to \n98:      * <tt>null</tt>.\n99:      * \n100:      * @param pane A new NavigatorPane or <tt>null</tt>.\n101:      * @deprecated without replacement - this is a temporary hack\n102:      * until the model is cleaned up\n103:      */\n104:     public static void setInstance(NavigatorPane pane) {\n105: \ttheInstance = pane;\n106: \ttheInstanceIsSet = true;\n107:     }\n108:     \n109:     /**\n110:      * Constructs a new navigator panel.\n111:      * \n112:      * <p>This panel consists of a Combobox to select a navigation\n113:      * perspective, a JTree to display the UML model, some history\n114:      * (back and forward arrows) buttons that are currently disabled,\n115:      * and a configuration dialog to tailor the perspectives (but this\n116:      * is not saved).\n117:      */\n118:     private NavigatorPane() {\n119:         this(SplashScreen.getDoSplash());\n120:     }\n121:     \n122:     /**\n123:      * Constructs a new navigator panel.\n124:      * \n125:      * <p>This panel consists of a Combobox to select a navigation\n126:      * perspective, a JTree to display the UML model, some history\n127:      * (back and forward arrows) buttons that are currently disabled,\n128:      * and a configuration dialog to tailor the perspectives (but this\n129:      * is not saved).\n130:      */\n131:     private NavigatorPane(boolean showSplashScreen) {\n132:         \n133:         JComboBox combo = new PerspectiveComboBox();\n134:         JComboBox orderByCombo = new JComboBox();\n135:         ExplorerTree tree = new ExportExplorer(); //DnDExplorerTree();\n136:         ToolBar toolbar = new ToolBar();\n137:         \n138:         toolbar.putClientProperty(\"JToolBar.isRollover\",  Boolean.TRUE);\n139:         toolbar.setFloatable(false);\n140:         toolbar.add(combo);\n141:         toolbar.add(new ActionPerspectiveConfig());\n142:         \n143:         ToolBar toolbar2 = new ToolBar();\n144:         \n145:         toolbar2.putClientProperty(\"JToolBar.isRollover\",  Boolean.TRUE);\n146:         toolbar2.setFloatable(false);\n147:         \n148:         orderByCombo.addItem(new TypeThenNameOrder());\n149:         orderByCombo.addItem(new NameOrder());\n150: \n151:         toolbar2.add(orderByCombo);\n152: \n153:         JPanel toolbarpanel = new JPanel();\n154:         toolbarpanel.setLayout(new BorderLayout());\n155:         toolbarpanel.add(toolbar, BorderLayout.NORTH);\n156:         toolbarpanel.add(toolbar2, BorderLayout.SOUTH);\n157:         \n158:         setLayout(new BorderLayout());\n159:         add(toolbarpanel, BorderLayout.NORTH);\n160:         add(new JScrollPane(tree), BorderLayout.CENTER);\n161: \n162:         if (showSplashScreen) {\n163:             SplashScreen splash = SplashScreen.getInstance();\n164: \t    splash.getStatusBar().showStatus(Translator.localize(\n165:                     BUNDLE, \n166: \t\t    \"statusmsg.bar.making-navigator-pane-perspectives\"));\n167:             splash.getStatusBar().showProgress(25);\n168:         }\n169:         \n170:         combo.addItemListener((ExplorerTreeModel) tree.getModel());\n171:         orderByCombo.addItemListener((ExplorerTreeModel) tree.getModel());\n172:         PerspectiveManager.getInstance().loadDefaultPerspectives();\n173:     }\n174: \n175:     ////////////////////////////////////////////////////////////////\n176:     // methods\n177: \n178:     /**\n179:      * Does nothing.\n180:      *\n181:      * Notification from Argo that the model has changed and\n182:      * the Tree view needs updating.\n183:      *\n184:      * TODO: More specific informat