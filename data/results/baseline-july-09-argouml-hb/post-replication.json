d diagrams in initPanels to\n29: // eliminate messages when trying to find the panel.\n30: \n31: package org.argouml.uml.ui;\n32: \n33: import java.awt.BorderLayout;\n34: import java.util.ArrayList;\n35: import java.util.Hashtable;\n36: import java.util.ListIterator;\n37: \n38: import javax.swing.JPanel;\n39: import javax.swing.event.EventListenerList;\n40: \n41: import org.apache.log4j.Category;\n42: import org.argouml.application.api.Argo;\n43: import org.argouml.application.api.PluggablePropertyPanel;\n44: import org.argouml.application.events.ArgoEventPump;\n45: import org.argouml.application.events.ArgoEventTypes;\n46: import org.argouml.application.events.ArgoModuleEvent;\n47: import org.argouml.application.events.ArgoModuleEventListener;\n48: import org.argouml.model.ModelFacade;\n49: import org.argouml.swingext.Orientable;\n50: import org.argouml.swingext.ignoreSplittersFlag;\n51: import org.argouml.ui.ArgoDiagram;\n52: import org.argouml.ui.TabSpawnable;\n53: import org.argouml.ui.targetmanager.TargetEvent;\n54: import org.argouml.ui.targetmanager.TargetListener;\n55: import org.argouml.ui.targetmanager.TargetManager;\n56: import org.argouml.uml.diagram.activity.ui.UMLActivityDiagram;\n57: import org.argouml.uml.diagram.collaboration.ui.UMLCollaborationDiagram;\n58: import org.argouml.uml.diagram.deployment.ui.UMLDeploymentDiagram;\n59: import org.argouml.uml.diagram.sequence.ui.UMLSequenceDiagram;\n60: import org.argouml.uml.diagram.state.ui.PropPanelUMLStateDiagram;\n61: import org.argouml.uml.diagram.state.ui.UMLStateDiagram;\n62: import org.argouml.uml.diagram.static_structure.ui.UMLClassDiagram;\n63: import org.argouml.uml.diagram.ui.PropPanelDiagram;\n64: import org.argouml.uml.diagram.ui.PropPanelString;\n65: import org.argouml.uml.diagram.ui.PropPanelUMLActivityDiagram;\n66: import org.argouml.uml.diagram.ui.PropPanelUMLClassDiagram;\n67: import org.argouml.uml.diagram.ui.PropPanelUMLCollaborationDiagram;\n68: import org.argouml.uml.diagram.ui.PropPanelUMLDeploymentDiagram;\n69: import org.argouml.uml.diagram.ui.PropPanelUMLSequenceDiagram;\n70: import org.argouml.uml.diagram.ui.PropPanelUMLUseCaseDiagram;\n71: import org.argouml.uml.diagram.use_case.ui.UMLUseCaseDiagram;\n72: import org.argouml.uml.ui.behavior.state_machines.PropPanelSimpleState;\n73: import org.argouml.uml.ui.behavior.use_cases.PropPanelUseCase;\n74: import org.argouml.uml.ui.foundation.core.PropPanelClass;\n75: import org.argouml.util.ConfigLoader;\n76: import org.tigris.gef.presentation.Fig;\n77: import org.tigris.gef.presentation.FigText;\n78: \n79: import ru.novosoft.uml.behavior.state_machines.MStateImpl;\n80: import ru.novosoft.uml.behavior.use_cases.MUseCaseImpl;\n81: import ru.novosoft.uml.foundation.core.MClassImpl;\n82: \n83: /**\n84:  * <p>\n85:  * This is the tab on the details panel (DetailsPane) that holds the property\n86:  * panel. On change of target, the property panel in TabProps is changed. \n87:  * </p>\n88:  * <p>\n89:  * With the introduction of the TargetManager, this class holds its original power\n90:  * of controlling its target. The property panels (subclasses of PropPanel) for\n91:  * which this class is the container are being registrated as TargetListeners in\n92:  * the setTarget method of this class. They are not registrated with TargetManager\n93:  * but with this class to prevent race-conditions while firing TargetEvents from\n94:  * TargetManager.\n95:  *</p>\n96:  * @author unknown\n97:  */\n98: public class TabProps\n99:     extends TabSpawnable\n100:     implements TabModelTarget, ArgoModuleEventListener {\n101:     protected static Category cat = Category.getInstance(TabProps.class);\n102:     ////////////////////////////////////////////////////////////////\n103:     // instance variables\n104:     protected boolean _shouldBeEnabled = false;\n105:     protected JPanel _blankPanel = new JPanel();\n106:     protected Hashtable _panels = new Hashtable();\n107:     protected JPanel _lastPanel = null;\n108:     protected String _panelClassBaseName = \"\";\n109: \n110:     private Object _target;\n111: \n112:     /**\n113:     * The list with targetlisteners, this are the property panels managed by TabProps\n114:     * It should only contain one listener at a time.\n115:     */\n116:     private EventListenerList _listenerList = new EventListenerList();\n117: \n118:     ////////////////////////////////////////////////////////////////\n119:     // constructor\n120:     public TabProps() {\n121:         this(\"tab.properties\", \"ui.PropPanel\");\n122:     }\n123: \n124:     public TabProps(String tabName, String panelClassBase) {\n125:         super(tabName);\n126:         TargetManager.getInstance().addTarget(this);\n127:         setIgnoreSplitters(ConfigLoader.getTabPropsOrientation());\n128:         _panelClassBaseName = panelClassBase;\n129:         setLayout(new BorderLayout());\n130:         //setFont(new Font(\"Dialog\", Font.PLAIN, 10));\n131: \n132:         ArrayList list = Argo.getPlugins(PluggablePropertyPanel.class);\n133:         ListIterator iterator = list.listIterator();\n134:         while (iterator.hasNext()) {\n135:             Object o = iterator.next();\n136:             PluggablePropertyPanel ppp = (PluggablePropertyPanel) o;\n137:             _panels.put(ppp.getClassForPanel(), ppp.getPropertyPanel());\n138:         }\n139: \n140:         ArgoEventPump.addListener(ArgoEventTypes.ANY_MODULE_EVENT, this);\n141: \n142:         initPanels();\n143:     }\n144: \n145:     public void finalize() {\n146:         ArgoEventPump.removeListener(ArgoEventTypes.ANY_MODULE_EVENT, this);\n147:     }\n148: \n149:     /*\n150:      * Set the orientation of the property panel\n151:      * @param orientation the new orientation for this preoprty panel\n152:      */\n153:     public void setIgnoreSplitters(ignoreSplittersFlag orientation) {\n154:         super.setIgnoreSplitters(orientation);\n155:         Enumeration enum = _panels.elements();\n156:         while (enum.hasMoreElements()) {\n157:             Object o = enum.nextElement();\n158:             if (o instanceof Orientable) {\n159:                 Orientable orientable = (Orientable) o;\n160:                 orientable.setOrientation(orientation);\n161:             }\n162:         }\n163:     }\n164: \n165:     /** Preload property panels that are commonly used within the first\n166:      *  few seconds after the tool is launched. */\n167:     protected void initPanels() {\n168: \n169:         _panels.put(MClassImpl.class, new PropPanelClass());\n170:         _panels.put(ArgoDiagram.class, new PropPanelDiagram());\n171: \n172:         // Put all the diagram PropPanels here explicitly. They would eventually\n173:         // pick up their superclass ArgoDiagram, but in the meantime\n174:         // panelClassFor() would moan that they can't be found.\n175: \n176:         // Note that state digrams do actually have a diagram property panel!\n177: \n178:         _panels.put(UMLActivityDiagram.class, new PropPanelUMLActivityDiagram());\n179:         _panels.put(UMLClassDiagram.class, new PropPanelUMLClassDiagram());\n180:         _panels.put(UMLCollaborationDiagram.class, new PropPanelUMLCollaborationDiagram());\n181:         _panels.put(UMLDeploymentDiagram.class, new PropPanelUMLDeploymentDiagram());\n182:         _panels.put(UMLSequenceDiagram.class, new PropPanelUMLSequenceDiagram());\n183:         _panels.put(UMLStateDiagram.class, new PropPanelUMLStateDiagram());\n184:         _panels.put(UMLUseCaseDiagram.class, new PropPanelUMLUseCaseDiagram());\n185: \n186:         // FigText has no owner, so we do it directly\n187:         _panels.put(FigText.class, new PropPanelString());\n188:         // now a plugin\n189:         // _panels.put(MModelImpl.class, new PropPanelModel());\n190:         _panels.put(MUseCaseImpl.class, new PropPanelUseCase());\n191:         //important: MStateImpl corresponds to PropPanelSimpleState not to PropPanelState!!\n192:         //otherwise, spawing will not ne successful!!\n193:         _panels.put(MStateImpl.class, new PropPanelSimpleState());       \n194:     }\n195: \n196:     /** Adds a property panel to the internal list. This allows a plugin to\n197:      *  add a register a new property panel an run-time. This property panel will then\n198:      *  be displayed in the detatils pane whenever an element of the given metaclass is\n199:      *  selected.\n200:      *\n201:      * @param c the metaclass whose details show be displayed in the property panel p\n202:      * @param p an instance of the property panel for the metaclass m\n203:      *\n204:      */\n205:     public void addPanel(Class c, PropPanel p) {\n206:         _panels.put(c, p);\n207:     }\n208: \n209:    \n210:     ////////////////////////////////////////////////////////////////\n211:     // accessors\n212:     /**\n213:      * Sets the target of the property panel. The given target t may either be a \n214:      * Diagram or a modelelement. If the target given is a Fig, a check is made if the fig has an owning modelelement and occurs on\n215:      * the current diagram. If so, that modelelement is the target.\n216:      *\n217:      * @deprecated As of ArgoUml version 0.13.5,\n218:      *             the visibility of this method will change in the future,\n219:      *             replaced by {@link org.argouml.ui.targetmanager.TargetManager}.\n220:      */\n221:     public void setTarget(Object t) {\n222:         // targets ought to be modelelements or diagrams \n223:         t = (t instanceof Fig) ? ((Fig) t).getOwner() : t;\n224:         if (!(t == null || ModelFacade.isABase(t) || t instanceof ArgoDiagram))\n225:             return;\n226: \n227:         if (_lastPanel != null) {\n228:             remove(_lastPanel);\n229:             if (_lastPanel instanceof TargetListener)\n230:                 removeTargetListener((TargetListener) _lastPanel);\n231:         }\n232:         _target = t;\n233:         if (t == null) {\n234:             add(_blankPanel, BorderLayout.CENTER);\n235:             _shouldBeEnabled = false;\n236:             _lastPanel = _blankPanel;\n237:         } else {\n238:             _shouldBeEnabled = true;\n239:             TabModelTarget newPanel = null;\n240:             Class targetClass = t.getClass();\n241:             while (newPanel == null) {\n242:                 newPanel = findPanelFor(targetClass);\n243:                 targetClass = targetClass.getSuperclass();\n244:                 if (targetClass == java.lang.Object.class)\n245:                     break;\n246:             }\n247:             if (newPanel != null) {\n248:                 addTargetListener(newPanel);\n249:             }\n250:             if (newPanel instanceof JPanel) {\n251:                 add((JPanel) newPanel, BorderLayout.CENTER);\n252:                 _shouldBeEnabled = true;\n253:                 _lastPanel = (JPanel) newPanel;\n254:             } else {\n255:                 add(_blankPanel, BorderLayout.CENTER);\n256:                 _shouldBeEnabled = false;\n257:                 _lastPanel = _blankPanel;\n258:             }\n259: \n260:         }\n261:     }\n262: \n263:     public void refresh() {\n264:         setTarget(TargetManager.getInstance().getTarget());\n265:     }\n266: \n267:     public TabModelTarget findPanelFor(Class targetClass) {\n268:         TabModelTarget p = (TabModelTarget) _panels.get(targetClass);\n269:         cat.debug(\"Getting prop panel for:\" + targetClass + \", found\" + p);\n270:         if (p == null) {\n271:             Class panelClass = panelClassFor(targetClass);\n272:             if (panelClass == null)\n273:                 return null;\n274:             try {\n275:                 p = (TabModelTarget) panelClass.newInstance();\n276:                 // moved next line inside try block to avoid filling the hashmap with\n277:                 // bogus values. \n278:                 _panels.put(targetClass, p);\n279:             }\n280:             // doubtfull if the next ones must be ignored.\n281:             catch (IllegalAccessException ignore) {\n282:                 return null;\n283:             } catch (InstantiationException ignore) {\n284:                 return null;\n285:             }\n286: \n287:         } else\n288:             cat.debug(\"found props for \" + targetClass.getName());\n289:         return p;\n290:     }\n291: \n292:     public Class panelClassFor(Class targetClass) {\n293:         String panelClassName = \"\";\n294:         String pack = \"org.argouml.uml\";\n295:         String base = \"\";\n296: \n297:         String targetClassName = targetClass.getName();\n298:         int lastDot = targetClassName.lastIndexOf(\".\");\n299: \n300:         //remove \"ru.novosoft.uml\"\n301:         if (lastDot > 0)\n302:             base = targetClassName.substring(16, lastDot + 1);\n303:         else\n304:             base = targetClassName.substring(16);\n305: \n306:         if (lastDot > 0)\n307:             targetClassName = targetClassName.substring(lastDot + 1);\n308: \n309:         if (targetClassName.startsWith(\"M\"))\n310:             targetClassName = targetClassName.substring(1); //remove M\n311:         if (targetClassName.endsWith(\"Impl\"))\n312:             targetClassName =\n313:                 targetClassName.substring(0, targetClassName.length() - 4);\n314:         //remove Impl\n315: \n316:         // This doesn't work for panel property tabs - they are being put in the\n317:         // wrong place. Really we should have defined these are preloaded them\n318:         // along with ArgoDiagram in initPanels above.\n319: \n320:         try {\n321:             panelClassName =\n322:                 pack + \".ui.\" + base + \"PropPanel\" + targetClassName;\n323:             return Class.forName(panelClassName);\n324:         } catch (ClassNotFoundException ignore) {\n325:             cat.error(\n326:                 \"Class \" + panelClassName + \" for Panel not found!\",\n327:                 ignore);\n328:         }\n329:         return null;\n330:     }\n331: \n332:     protected String getClassBaseName() {\n333:         return _panelClassBaseName;\n334:     }\n335: \n336:     /**\n337:      * Returns the current target.\n338:      * @deprecated As of ArgoUml version 0.13.5,\n339:      *             the visibility of this method will change in the future,\n340:      *             replaced by {@link org.argouml.ui.targetmanager.TargetManager#getTarget() TargetManager.getInstance().getTarget()}.\n341:      */\n342:     public Object getTarget() {\n343:         return _target;\n344:     }\n345: \n346:     /**\n347:      * Determines if the property panel should be enabled. Returns true if it\n348:      * should be enabled. The property panel should allways be enabled if the\n349:      * target is an instance of a modelelement or an argodiagram. If the target given\n350:      * is a Fig, a check is made if the fig has an owning modelelement and occurs on\n351:      * the current diagram. If so, that modelelement is the target.\n352:      * @see org.argouml.ui.TabTarget#shouldBeEnabled(Object)\n353:      */\n354:     public boolean shouldBeEnabled(Object target) {\n355:         target = (target instanceof Fig) ? ((Fig) target).getOwner() : target;\n356:         if (ModelFacade.isADiagram(target) || ModelFacade.isABase(target)) {\n357:             _shouldBeEnabled = true;\n358:         } else {\n359:             _shouldBeEnabled = false;\n360:         }\n361: \n362:         return _shouldBeEnabled;\n363:     }\n364: \n365:     public void moduleLoaded(ArgoModuleEvent event) {\n366:         if (event.getSource() instanceof PluggablePropertyPanel) {\n367:             PluggablePropertyPanel p =\n368:                 (PluggablePropertyPanel) event.getSource();\n369:             _panels.put(p.getClassForPanel(), p.getPropertyPanel());            \n370: \n371:         }\n372:     }\n373:     public void moduleUnloaded(ArgoModuleEvent event) {\n374:     }\n375:     public void moduleEnabled(ArgoModuleEvent event) {\n376:     }\n377:     public void moduleDisabled(ArgoModuleEvent event) {\n378:     }\n379: \n380:     /**\n381:      * @see org.argouml.ui.targetmanager.TargetListener#targetAdded(org.argouml.ui.targetmanager.TargetEvent)\n382:      */\n383:     public void targetAdded(TargetEvent e) {\n384:         // we can neglect this, the TabProps allways selects the first target\n385:         // in a set of targets. The first target can only be \n386:         // changed in a targetRemoved or a TargetSet event\n387:         fireTargetAdded(e);\n388:         if (_listenerList.getListenerCount() > 0) {\n389:             validate();\n390:             repaint();\n391:         }\n392: \n393:     }\n394: \n395:     /**\n396:      * @see org.argouml.ui.targetmanager.TargetListener#targetRemoved(org.argouml.ui.targetmanager.TargetEvent)\n397:      */\n398:     public void targetRemoved(TargetEvent e) {\n399:         setTarget(e.getNewTargets()[0]);\n400:         fireTargetRemoved(e);\n401:         validate();\n402:         repaint(); \n403:     }\n404: \n405:     /**\n406:      * @see org.argouml.ui.targetmanager.TargetListener#targetSet(org.argouml.ui.targetmanager.TargetEvent)\n407:      */\n408:     public void targetSet(TargetEvent e) {\n409:         setTarget(e.getNewTargets()[0]);\n410:         fireTargetSet(e);        \n411:         validate();\n412:         repaint();        \n413:     }\n414: \n415:     /**\n416:      * Adds a listener.\n417:      * @param listener the listener to add\n418:      */\n419:     private void addTargetListener(TargetListener listener) {\n420:         _listenerList.add(TargetListener.class, listener);\n421:     }\n422: \n423:     /**\n424:      * Removes a target listener.\n425:      * @param listener the listener to remove\n426:      */\n427:     private void removeTargetListener(TargetListener listener) {\n428:         _listenerList.remove(TargetListener.class, listener);\n429:     }\n430: \n431:     private void fireTargetSet(TargetEvent targetEvent) {\n432:         //      Guaranteed to return a non-null array\n433:         Object[] listeners = _listenerList.getListenerList();\n434:         for (int i = listeners.length - 2; i >= 0; i -= 2) {\n435:             if (listeners[i] == TargetListener.class) {\n436:                 // Lazily create the event:                     \n437:                  ((TargetListener) listeners[i + 1]).targetSet(targetEvent);\n438:             }\n439:         }\n440:     }\n441: \n442:     private void fireTargetAdded(TargetEvent targetEvent) {\n443:         // Guaranteed to return a non-null array\n444:         Object[] listeners = _listenerList.getListenerList();\n445: \n446:         for (int i = listeners.length - 2; i >= 0; i -= 2) {\n447:             if (listeners[i] == TargetListener.class) {\n448:                 // Lazily create the event:                     \n449:                  ((TargetListener) listeners[i + 1]).targetAdded(targetEvent);\n450:             }\n451:         }\n452:     }\n453: \n454:     private void fireTargetRemoved(TargetEvent targetEvent) {\n455:         // Guaranteed to return a non-null array\n456:         Object[] listeners = _listenerList.getListenerList();\n457:         for (int i = listeners.length - 2; i >= 0; i -= 2) {\n458:             if (listeners[i] == TargetListener.class) {\n459:                 // Lazily create the event:                     \n460:                 ((TargetListener) listeners[i + 1]).targetRemoved(targetEvent);\n461:             }\n462:         }\n463:     }\n464: \n465: } /* end class TabProps */\n466: \n467: ",
