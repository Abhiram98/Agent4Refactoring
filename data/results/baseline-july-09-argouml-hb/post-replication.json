e is an AggregationKind\n917:      */\n918:     public static boolean isAAggregationKind(Object handle) {\n919:         return handle instanceof MAggregationKind;\n920:     }\n921: \n922:     /**\n923:      * Recognizer for Association.\n924:      *\n925:      * @param handle candidate\n926:      * @return true if handle is an Association\n927:      */\n928:     public static boolean isAAssociation(Object handle) {\n929:         return handle instanceof MAssociation;\n930:     }\n931: \n932:     /**\n933:      * Recognizer for AssociationEnd.\n934:      *\n935:      * @param handle candidate\n936:      * @return true if handle is an AssociationEnd\n937:      */\n938:     public static boolean isAAssociationEnd(Object handle) {\n939:         return handle instanceof MAssociationEnd;\n940:     }\n941: \n942:     /**\n943:      * Recognizer for AssociationRole.\n944:      *\n945:      * @param handle candidate\n946:      * @return true if handle is an AssociationRole\n947:      */\n948:     public static boolean isAAssociationRole(Object handle) {\n949:         return handle instanceof MAssociationRole;\n950:     }\n951: \n952:     /**\n953:      * Recognizer for AssociationEndRole.\n954:      *\n955:      * @param handle candidate\n956:      * @return true if handle is an AssociationEndRole\n957:      */\n958:     public static boolean isAAssociationEndRole(Object handle) {\n959:         return handle instanceof MAssociationEndRole;\n960:     }\n961: \n962:     /**\n963:      * Recognizer for Attribute.\n964:      *\n965:      * @param handle candidate\n966:      * @return true if handle is an Attribute\n967:      */\n968:     public static boolean isAAttribute(Object handle) {\n969:         return handle instanceof MAttribute;\n970:     }\n971: \n972:     /**\n973:      * Recognizer for asynchronisity of an action.\n974:      *\n975:      * @param handle candidate\n976:      * @return true if the argument is asynchronous\n977:      */\n978:     public static boolean isAsynchronous(Object handle) {\n979:         if (handle instanceof MAction) {\n980:             return ((MAction) handle).isAsynchronous();\n981:         }\n982: \treturn illegalArgumentBoolean(handle);\n983:     }\n984: \n985:     /**\n986:      * Recognizer for abstract classes and operations.\n987:      *\n988:      * @param handle candidate\n989:      * @return true if handle is abstract.\n990:      */\n991:     public static boolean isAbstract(Object handle) {\n992:         if (handle instanceof MOperation) {\n993:             return ((MOperation) handle).isAbstract();\n994:         }\n995:         if (handle instanceof MGeneralizableElement) {\n996:             return ((MGeneralizableElement) handle).isAbstract();\n997:         }\n998:         if (handle instanceof MAssociation) {\n999:             return ((MAssociation) handle).isAbstract();\n1000:         }\n1001:         // isAbstarct() is not a typo! mistake in nsuml!\n1002:         if (handle instanceof MReception) {\n1003:             return ((MReception) handle).isAbstarct();\n1004:         }\n1005:         // ...\n1006: \treturn illegalArgumentBoolean(handle);\n1007:     }\n1008: \n1009: \n1010: \n1011:     /**\n1012:      * Recognizer for ActivityGraph.\n1013:      *\n1014:      * @param handle candidate\n1015:      * @return true if handle is ActivityGraph.\n1016:      */\n1017:     public static boolean isAActivityGraph(Object handle) {\n1018:         return handle instanceof MActivityGraph;\n1019:     }\n1020: \n1021:     /**\n1022:      * Recognizer for bases. A base is an object that is some form of\n1023:      * an element in the model. MBase in Novosoft terms.\n1024:      *\n1025:      * @param handle candidate\n1026:      * @return true if handle is a base.\n1027:      */\n1028:     public static boolean isABase(Object handle) {\n1029:         return handle instanceof MBase;\n1030:     }\n1031: \n1032: \n1033:     /**\n1034:      * Recognizer for behavioral features.\n1035:      *\n1036:     