nstraints.BOTH;\n83:     c.weightx = 0.0;\n84:     c.ipadx = 0; c.ipady = 0;\n85: \n86: \n87:     //_visField.getEditor().getEditorComponent().setBackground(Color.white);\n88:     //_keywordsField.getEditor().getEditorComponent().setBackground(Color.white);\n89:     _typeField.setEditable(true);\n90:     _typeField.getEditor().getEditorComponent().setBackground(Color.white);    \n91: \n92:     c.gridx = 0;\n93:     c.gridwidth = 1;\n94:     c.gridy = 1;\n95:     gb.setConstraints(_visLabel, c);\n96:     add(_visLabel);\n97:     c.gridy = 2;\n98:     gb.setConstraints(_keywordsLabel, c);\n99:     add(_keywordsLabel);\n100:     c.gridy = 3;\n101:     gb.setConstraints(_typeLabel, c);\n102:     add(_typeLabel);\n103: \n104:     \n105:     c.weightx = 1.0;\n106:     c.gridx = 1;\n107:     //c.gridwidth = GridBagConstraints.REMAINDER;\n108:     c.gridy = 1;\n109:     gb.setConstraints(_visField, c);\n110:     add(_visField);\n111:     c.gridy = 2;\n112:     gb.setConstraints(_keywordsField, c);\n113:     add(_keywordsField);\n114:     c.gridy = 3;\n115:     gb.setConstraints(_typeField, c);\n116:     add(_typeField);\n117: \n118:     c.weightx = 0.0;\n119:     c.gridx = 2;\n120:     c.gridy = 0;\n121:     gb.setConstraints(_spacer, c);\n122:     add(_spacer);\n123:     \n124: \n125:     c.weightx = 1.0;\n126:     c.gridwidth = 3;\n127:     c.gridx = 3;\n128:     //c.gridwidth = GridBagConstraints.REMAINDER;\n129:     c.gridy = 0;\n130:     gb.setConstraints(_argsLabel, c);\n131:     add(_argsLabel);\n132:     c.gridy = 1;\n133:     c.gridheight = GridBagConstraints.REMAINDER;\n134:     gb.setConstraints(_argsTable, c);\n135:     add(_argsTable);\n136: \n137:     _visField.addItemListener(this);\n138:     _keywordsField.addItemListener(this);\n139:     _typeField.addItemListener(this);\n140: \n141:     remove(_namespaceLabel);\n142:     remove(_namespaceField);\n143:   }\n144: \n145: \n146:   \n147:   ////////////////////////////////////////////////////////////////\n148:   // accessors\n149: \n150:   protected void setTargetInternal(Object t) {\n151:     super.setTargetInternal(t);\n152:     MOperation oper = (MOperation) _target;\n153: \n154:     Vector offeredTypes = getOfferedTypes();\n155:     if (offeredTypes != null)\n156:       _typeField.setModel(new DefaultComboBoxModel(Converter.convert(offeredTypes)));\n157: \n158:     MVisibilityKind vk = oper.getVisibility();\n159: \tif (vk != null)\n160: \t\t_visField.setSelectedItem(vk.getName());\n161: \n162:     MScopeKind sk = oper.getOwnerScope();\n163:     MCallConcurrencyKind ck = oper.getConcurrency();\n164:     // needs-more-work: concurrency\n165:     // needs-more-work: final methods?\n166:     if (MScopeKind.CLASSIFIER.equals(sk)) {\n167:       if (MCallConcurrencyKind.GUARDED.equals(ck))\n168: \t_keywordsField.setSelectedItem(\"static synchronized\");\n169:       else\n170: \t_keywordsField.setSelectedItem(\"static\");\n171:     }\n172:     else {\n173:       if (MCallConcurrencyKind.GUARDED.equals(ck))\n174: \t_keywordsField.setSelectedItem(\"synchronized\");\n175:       else\n176: \t_keywordsField.setSelectedItem(\"None\");\n177:     }\n178: \n179: \tVector parameters = new Vector(oper.getParameters());\n180: \n181: \tMParameter returnParameter = MMUtil.SINGLETON.getReturnParameter(oper);\n182: \tif (returnParameter != null && returnParameter.getType() != null && returnParameter.getType().getName() != null)\n183: \t\t_typeField.setSelectedItem(returnParameter.getType().getName());\n184: \n185: \tDefaultTableModel _argsModel = new DefaultTableModel(0,2);\n186: \tparameters.remove(returnParameter);\n187: \n188: \tfor (int i = 0; i<parameters.size();i++) {\n189: \t\tMParameter p = (MParameter)parameters.elementAt(i);\n190: \t\tString[] row = {p.getName(), p.getType().getName()};\n191: \t\t_argsModel.addRow(row);\n192: \t}\n193: \t_argsTable.setModel(_argsModel);\n194:   }\n195: \n196: \n197: \n198:   public void setTargetVisibility() {\n199:     if (_target == null) return;\n200:     if (_inChange) return;\n201:     MVisibilityKind vk = MVisibilityKind.forName((String)_visField.getSelectedItem());\n202:     MOperation oper = (MOperation) _target;\n203: \toper.setVisibility(vk);\n204:   }\n205: \n206:   // needs-more-work: how to model abstract methods?\n207:   // needs-more-work: how to model final methods?\n208:   \n209:   public void setTargetKeywords() {\n210:     if (_target == null) return;\n211:     if (_inChange) return;\n212:     String keys = (String) _keywordsField.getSelectedItem();\n213:     if (keys == null) {\n214:       //System.out.println(\"keywords are null\");\n215:       return;\n216:     }\n217:     MOperation oper = (MOperation) _target;\n218: \tif (keys.equals(\"None\")) {\n219: \t\toper.setOwnerScope(MScopeKind.INSTANCE);\n220: \t\toper.setConcurrency(MCallConcurrencyKind.CONCURRENT);\n221: \t}\n222: \telse if (keys.equals(\"static\")) {\n223: \t\toper.setOwnerScope(MScopeKind.CLASSIFIER);\n224: \t\toper.setConcurrency(MCallConcurrencyKind.CONCURRENT);\n225: \t}\n226: \telse if (keys.equals(\"final\")) {\n227: \t\toper.setOwnerScope(MScopeKind.INSTANCE);\n228: \t\toper.setConcurrency(MCallConcurrencyKind.CONCURRENT);\n229: \t}\n230: \telse if (keys.equals(\"static final\")) {\n231: \t\toper.setOwnerScope(MScopeKind.INSTANCE);\n232: \t\toper.setConcurrency(MCallConcurrencyKind.CONCURRENT);\n233: \t}\n234: \telse if (keys.equals(\"synchronized\")) {\n235: \t\toper.setOwnerScope(MScopeKind.INSTANCE);\n236: \t\toper.setConcurrency(MCallConcurrencyKind.GUARDED);\n237: \t}\n238: \telse if (keys.equals(\"static synchronized\")) {\n239: \t\toper.setOwnerScope(MScopeKind.CLASSIFIER);\n240: \t\toper.setConcurrency(MCallConcurrencyKind.GUARDED);\n241: \t}\n242: \telse if (keys.equals(\"final synchronized\")) {\n243: \t\toper.setOwnerScope(MScopeKind.INSTANCE);\n244: \t\toper.setConcurrency(MCallConcurrencyKind.GUARDED);\n245: \t}\n246: \telse if (keys.equals(\"static final synchronized\")) {\n247: \t\toper.setOwnerScope(MScopeKind.CLASSIFIER);\n248: \t\toper.setConcurrency(MCallConcurrencyKind.GUARDED);\n249: \t}\n250:   }\n251: \n252:   public void setTargetType() {\n253:     if (_target == null) return;\n254:     if (_inChange) return;\n255:     MOperation op = (MOperation) _target;\n256:     Object rtObj = _typeField.getSelectedItem();\n257:     MClassifier rt = null;\n258:     if (rtObj instanceof String) {\n259:       String rtStr = (String) _typeField.getSelectedItem();\n260:       ProjectBrowser pb = ProjectBrowser.TheInstance;\n261:       Project p = pb.getProject();\n262:       rt = p.findType(rtStr);\n263:     }\n264:     else if (rtObj instanceof MClassifier) {\n265:       rt = (MClassifier) rtObj;\n266:     }\n267:     else {\n268:       // watch out for null rtObj\n269: //       System.out.println(\"selected return type was a \" + rtObj.getClass());\n270: //       System.out.println(\"selected return type is \" + rtObj);\n271:       // needs-more-work: selected predefined class\n272:     }\n273:     if (rt != null) {\n274: \t//System.out.println(\"Props setting return type: \" + rt);\n275: \t\tMParameter p = new MParameterImpl();\n276: \t\tp.setType(rt);\n277: \t\tMMUtil.SINGLETON.setReturnParameter(op,p);\n278:     }\n279:   }\n280: \n281: \n282:   public static Vector getOfferedTypes() {\n283:     // needs-more-work: should update when project changes\n284:     Project p = ProjectBrowser.TheInstance.getProject();\n285:     Vector types = p.getDefinedTypesVector();\n286:     Vector res = new Vector();\n287:     for (int i = 0; i<types.size();i++) {\n288: \tres.add(((MClassifier)types.get(i)).getName());\n289:     }\n290:     return res;\n291:   }\n292: \n293:   ////////////////////////////////////////////////////////////////\n294:   // event handlers\n295: \n296: \n297:   public void focusLost(DocumentEvent e) {\n298:     //System.out.println(getClass().getName() + \" insert\");\n299:     Component ed = _typeField.getEditor().getEditorComponent();\n300:     Document ty