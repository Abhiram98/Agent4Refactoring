ont;\n33: import java.awt.Graphics;\n34: import java.awt.Point;\n35: import java.awt.Rectangle;\n36: import java.awt.event.KeyEvent;\n37: import java.awt.event.KeyListener;\n38: import java.awt.event.MouseEvent;\n39: import java.awt.event.MouseListener;\n40: import java.beans.PropertyChangeEvent;\n41: import java.beans.PropertyChangeListener;\n42: import java.beans.VetoableChangeListener;\n43: import java.util.Iterator;\n44: import java.util.Vector;\n45: \n46: import javax.swing.Icon;\n47: import javax.swing.JSeparator;\n48: import javax.swing.SwingUtilities;\n49: \n50: import org.apache.log4j.Logger;\n51: import org.argouml.application.api.ArgoEventListener;\n52: import org.argouml.application.api.Notation;\n53: import org.argouml.application.api.NotationContext;\n54: import org.argouml.application.api.NotationName;\n55: import org.argouml.application.events.ArgoEvent;\n56: import org.argouml.application.events.ArgoEventPump;\n57: import org.argouml.application.events.ArgoNotationEvent;\n58: import org.argouml.application.events.ArgoNotationEventListener;\n59: import org.argouml.cognitive.Designer;\n60: import org.argouml.cognitive.ItemUID;\n61: import org.argouml.cognitive.ToDoItem;\n62: import org.argouml.cognitive.ToDoList;\n63: import org.argouml.kernel.DelayedChangeNotify;\n64: import org.argouml.kernel.DelayedVChangeListener;\n65: import org.argouml.kernel.Project;\n66: import org.argouml.kernel.ProjectManager;\n67: import org.argouml.model.ModelFacade;\n68: import org.argouml.model.uml.UmlFactory;\n69: import org.argouml.model.uml.UmlHelper;\n70: import org.argouml.model.uml.UmlModelEventPump;\n71: import org.argouml.model.uml.foundation.core.CoreHelper;\n72: import org.argouml.ui.ActionAutoResize;\n73: import org.argouml.ui.ActionGoToCritique;\n74: import org.argouml.ui.ArgoDiagram;\n75: import org.argouml.ui.ArgoJMenu;\n76: import org.argouml.ui.Clarifier;\n77: import org.argouml.ui.cmd.CmdSetPreferredSize;\n78: import org.argouml.uml.UUIDManager;\n79: import org.argouml.util.Trash;\n80: import org.tigris.gef.base.Globals;\n81: import org.tigris.gef.base.Selection;\n82: import org.tigris.gef.presentation.Fig;\n83: import org.tigris.gef.presentation.FigEdgePoly;\n84: import org.tigris.gef.presentation.FigNode;\n85: import org.tigris.gef.presentation.FigPoly;\n86: import org.tigris.gef.presentation.FigText;\n87: import org.tigris.gef.presentation.Handle;\n88: \n89: import ru.novosoft.uml.MElementEvent;\n90: import ru.novosoft.uml.MElementListener;\n91: \n92: \n93: /**\n94:  * Abstract class to display diagram arcs for UML ModelElements that\n95:  * look like arcs and that have editiable names.\n96:  */\n97: public abstract class FigEdgeModelElement\n98:     extends FigEdgePoly\n99:     implements\n100:         VetoableChangeListener,\n101:         DelayedVChangeListener,\n102:         MouseListener,\n103:         KeyListener,\n104:         PropertyChangeListener,\n105:         MElementListener,\n106:         NotationContext,\n107:         ArgoNotationEventListener {\n108: \n109:     private static final Logger LOG =\n110:         Logger.getLogger(FigEdgeModelElement.class);\n111:         \n112:     /**\n113:      * <code>BUNDLE</code>\n114:      */\n115:     protected static final String BUNDLE = \"UMLMenu\";\n116:         \n117:     ////////////////////////////////////////////////////////////////\n118:     // constants\n119: \n120:     private static final Font LABEL_FONT;\n121:     private static final Font ITALIC_LABEL_FONT;\n122: \n123:     static {\n124:         LABEL_FONT = new Font(\"Dialog\", Font.PLAIN, 10);\n125:         ITALIC_LABEL_FONT =\n126:             new Font(LABEL_FONT.getFamily(), Font.ITALIC, LABEL_FONT.getSize());\n127:     }\n128: \n129:     //public static final int MARGIN = 2;\n130: \n131:     /**\n132:      * Offset from the end of the set of popup actions at which new items\n133:      * should be inserted by concrete figures.\n134:     **/\n135:     protected static final int POPUP_ADD_OFFSET = 3;\n136: \n137:     ////////////////////////////////////////////////////////////////\n138:     // instance variables\n139: \n140:     /**\n141:      * The Fig that displays the name of this model element.\n142:      * Use getNameFig(), no setter should be required.\n143:      */\n144:     private FigText name;\n145:     /**\n146:      * The Fig that displays the stereotype of this model element.\n147:      * Use getStereotypeFig(), no setter should be required.\n148:      */\n149:     private FigText stereo = new FigText(10, 30, 90, 20);\n150:     \n151:     private ItemUID id;\n152:     \n153:     /**\n154:      * The current notation for this fig. The notation is for example\n155:      * UML 1.3 or Java\n156:      */\n157:     private NotationName currentNotationName;\n158: \n159:     ////////////////////////////////////////////////////////////////\n160:     // constructors\n161: \n162:     /** Partially construct a new FigNode.  This method creates the\n163:      *  _name element that holds the name of the model element and adds\n164:      *  itself as a listener. */\n165:     public FigEdgeModelElement() {\n166:         name = new FigText(10, 30, 90, 20);\n167:         name.setFont(LABEL_FONT);\n168:         name.setTextColor(Color.black);\n169:         name.setTextFilled(false);\n170:         name.setFilled(false);\n171:         name.setLineWidth(0);\n172:         name.setExpandOnly(false);\n173:         name.setMultiLine(false);\n174:         name.setAllowsTab(false);\n175: \n176:         stereo.setFont(LABEL_FONT);\n177:         stereo.setTextColor(Color.black);\n178:         stereo.setTextFilled(false);\n179:         stereo.setFilled(false);\n180:         stereo.setLineWidth(0);\n181:         stereo.setExpandOnly(false);\n182:         stereo.setMultiLine(false);\n183:         stereo.setAllowsTab(false);\n184: \n185:         setBetweenNearestPoints(true);\n186:         ((FigPoly) _fig).setRectilinear(false);\n187:         ArgoEventPump.addListener(ArgoEvent.ANY_NOTATION_EVENT, this);\n188:     }\n189: \n190:     /**\n191:      * the constructor that hooks the Fig into the UML model element\n192:      * \n193:      * @param edge the UML element \n194:      */\n195:     public FigEdgeModelElement(Object edge) {\n196:         this();\n197:         setOwner(edge);\n198:         ArgoEventPump.addListener(ArgoEvent.ANY_NOTATION_EVENT, this);\n199:     }\n200: \n201:     /**\n202:      * @see java.lang.Object#finalize()\n203:      */\n204:     public void finalize() {\n205:         ArgoEventPump.removeListener(ArgoEvent.ANY_NOTATION_EVENT, this);\n206:     }\n207: \n208:     ////////////////////////////////////////////////////////////////\n209:     // accessors\n210: \n211:     /**\n212:      * Setter for the UID\n213:      * @param newId the new UID\n214:      */\n215:     public void setItemUID(ItemUID newId) {\n216:         id = newId;\n217:     }\n218: \n219:     /**\n220:      * Getter for the UID\n221:      * @return the UID\n222:      */\n223:     public ItemUID getItemUID() {\n224:         return id;\n225:     }\n226: \n227:     /**\n228:      * @see org.tigris.gef.presentation.Fig#getTipString(java.awt.event.MouseEvent)\n229:      */\n230:     public String getTipString(MouseEvent me) {\n231:         ToDoItem item = hitClarifier(me.getX(), me.getY());\n232:         String tip = \"\";\n233:         if (item != null \n234:             && Globals.curEditor().getSelectionManager().containsFig(this))\n235:             tip = item.getHeadline();\n236:         else if (getOwner() != null)\n237:             tip = getOwner().toString();\n238:         else\n239:             tip = toString();\n240:         if (tip != null && tip.length() > 0 && !tip.endsWith(\" \"))\n241:             tip += \" \";\n242:         return tip;\n243:     }\n244: \n245:     /**\n246:      * @see org.tigris.gef.ui.PopupGenerator#getPopUpActions(java.awt.event.MouseEvent)\n247:      */\n248:     public Vector getPopUpActions(MouseEvent me) {\n249:         Vector popUpActions = super.getPopUpActions(me);\n250:         ToDoList list = Designer.theDesigner().getToDoList();\n251:         Vector items = (Vector) list.elementsForOffender(getOwner()).clone();\n252:         if (items != null && items.size() > 0) {\n253:             ArgoJMenu critiques = new ArgoJMenu(BUNDLE, \"menu.popup.critiques\");\n254:             ToDoItem itemUnderMouse = hitClarifier(me.getX(), me.getY());\n255:             if (itemUnderMouse != null) {\n256:                 critiques.add(new ActionGoToCritique(itemUnderMouse));\n257:                 critiques.addSeparator();\n258:             }\n259:             int size = items.size();\n260:             for (int i = 0; i < size; i++) {\n261:                 ToDoItem item = (ToDoItem) items.elementAt(i);\n262:                 if (item == itemUnderMouse)\n263:                     continue;\n264:                 critiques.add(new ActionGoToCritique(item));\n265:             }\n266:             popUpActions.insertElementAt(new JSeparator(), 0);\n267:             popUpActions.insertElementAt(critiques, 0);\n268:         }\n269:         // POPUP_ADD_OFFSET should be equal to the number of items added here:\n270:         popUpActions.addElement(new JSeparator());\n271:         popUpActions.addElement(ActionProperties.getSingleton());\n272:         popUpActions.addElement(ActionDeleteFromDiagram.getSingleton());\n273:         return popUpActions;\n274:     }\n275: \n276:     \n277:     /**\n278:      * distance formula: (x-h)^2 + (y-k)^2 = distance^2\n279:      * \n280:      * @param p1 point\n281:      * @param p2 point\n282:      * @return the square of the distance\n283:      */\n284:     public int getSquaredDistance(Point p1, Point p2) {\n285:         int xSquared = p2.x - p1.x;\n286:         xSquared *= xSquared;\n287:         int ySquared = p2.y - p1.y;\n288:         ySquared *= ySquared;\n289:         return xSquared + ySquared;\n290:     }\n291: \n292:     /**\n293:      * @param g the <code>Graphics</code> object\n294:      */\n295:     public void paintClarifiers(Graphics g) {\n296:         int iconPos = 25, gap = 1, xOff = -4, yOff = -4;\n297:         Point p = new Point();\n298:         ToDoList list = Designer.theDesigner().getToDoList();\n299:         Vector items = list.elementsForOffender(getOwner());\n300:         int size = items.size();\n301:         for (int i = 0; i < size; i++) {\n302:             ToDoItem item = (ToDoItem) items.elementAt(i);\n303:             Icon icon = item.getClarifier();\n304:             if (icon instanceof Clarifier) {\n305:                 ((Clarifier) icon).setFig(this);\n306:                 ((Clarifier) icon).setToDoItem(item);\n307:             }\n308:             if (icon != null) {\n309:                 stuffPointAlongPerimeter(iconPos, p);\n310:                 icon.paintIcon(null, g, p.x + xOff, p.y + yOff);\n311:                 iconPos += icon.getIconWidth() + gap;\n312:             }\n313:         }\n314:         items = list.elementsForOffender(this);\n315:         size = items.size();\n316:         for (int i = 0; i < size; i++) {\n317:             ToDoItem item = (ToDoItem) items.elementAt(i);\n318:             Icon icon = item.getClarifier();\n319:             if (icon instanceof Clarifier) {\n320:                 ((Clarifier) icon).setFig(this);\n321:                 ((Clarifier) icon).setToDoItem(item);\n322:             }\n323:             if (icon != null) {\n324:                 stuffPointAlongPerimeter(iconPos, p);\n325:                 icon.paintIcon(null, g, p.x + xOff, p.y + yOff);\n326:                 iconPos += icon.getIconWidth() + gap;\n327:             }\n328:         }\n329:     }\n330: \n331:     public ToDoItem hitClarifier(int x, int y) {\n332:         int iconPos = 25, xOff = -4, yOff = -4;\n333:         Point p = new Point();\n334:         ToDoList list = Designer.theDesigner().getToDoList();\n335:         Vector items = list.elementsForOffender(getOwner());\n336:         int size = items.size();\n337:         for (int i = 0; i < size; i++) {\n338:             ToDoItem item = (ToDoItem) items.elementAt(i);\n339:             Icon icon = item.getClarifier();\n340:             stuffPointAlongPerimeter(iconPos, p);\n341:             int width = icon.getIconWidth();\n342:             int height = icon.getIconHeight();\n343:             if (y >= p.y + yOff\n344:                 && y <= p.y + height + yOff\n345:                 && x >= p.x + xOff\n346:                 && x <= p.x + width + xOff)\n347:                 return item;\n348:             iconPos += width;\n349:         }\n350:         for (int i = 0; i < size; i++) {\n351:             ToDoItem item = (ToDoItem) items.elementAt(i);\n352:             Icon icon = item.getClarifier();\n353:             if (icon instanceof Clarifier) {\n354:                 ((Clarifier) icon).setFig(this);\n355:                 ((Clarifier) icon).setToDoItem(item);\n356:                 if (((Clarifier) icon).hit(x, y))\n357:                     return item;\n358:             }\n359:         }\n360:         items = list.elementsForOffender(this);\n361:         size = items.size();\n362:         for (int i = 0; i < size; i++) {\n363:             ToDoItem item = (ToDoItem) items.elementAt(i);\n364:             Icon icon = item.getClarifier();\n365:             stuffPointAlongPerimeter(iconPos, p);\n366:             int width = icon.getIconWidth();\n367:             int height = icon.getIconHeight();\n368:             if (y >= p.y + yOff\n369:                 && y <= p.y + height + yOff\n370:                 && x >= p.x + xOff\n371:                 && x <= p.x + width + xOff)\n372:                 return item;\n373:             iconPos += width;\n374:         }\n375:         for (int i = 0; i < size; i++) {\n376:             ToDoItem item = (ToDoItem) items.elementAt(i);\n377:             Icon icon = item.getClarifier();\n378:             if (icon instanceof Clarifier) {\n379:                 ((Clarifier) icon).setFig(this);\n380:                 ((Clarifier) icon).setToDoItem(item);\n381:                 if (((Clarifier) icon).hit(x, y))\n382:                     return item;\n383:             }\n384:         }\n385:         return null;\n386:     }\n387: \n388:     /**\n389:      * Returns a {@link SelectionRerouteEdge} object that manages selection\n390:      * and rerouting of the edge.\n391:      *\n392:      * @return the SelectionRerouteEdge.\n393:      */\n394:     public Selection makeSelection() {\n395:         return new SelectionRerouteEdge(this);\n396:     }\n397: \n398:     /**\n399:      * Getter for name, the name Fig\n400:      * @return the nameFig\n401:      */\n402:     public FigText getNameFig() {\n403:         return name;\n404:     }\n405:     \n406:     /**\n407:      * Getter for stereo, the stereotype Fig\n408:      * @return the stereo Fig\n409:      */\n410:     public FigText getStereotypeFig() {\n411:         return stereo;\n412:     }\n413: \n414:     /**\n415:      * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n416:      */\n417:     public void vetoableChange(PropertyChangeEvent pce) {\n418:         Object src = pce.getSource();\n419:         if (src == getOwner()) {\n420:             DelayedChangeNotify delayedNotify =\n421:                 new DelayedChangeNotify(this, pce);\n422:             SwingUtilities.invokeLater(delayedNotify);\n423:         }\n424:     }\n425: \n426:     /**\n427:      * @see org.argouml.kernel.DelayedVChangeListener#delayedVetoableChange(java.beans.PropertyChangeEvent)\n428:      */\n429:     public void delayedVetoableChange(PropertyChangeEvent pce) {\n430:         // update any text, colors, fonts, etc.\n431:         modelChanged(null);\n432:         // update the relative sizes and positions of internel Figs\n433:         Rectangle bbox = getBounds();\n434:         setBounds(bbox.x, bbox.y, bbox.width, bbox.height);\n435:         endTrans();\n436:     }\n437: \n438:     /**\n439:      * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n440:      */\n441:     public void propertyChange(PropertyChangeEvent pve) {\n442:         Object src = pve.getSource();\n443:         String pName = pve.getPropertyName();\n444:         if (pName.equals(\"editing\")\n445:             && Boolean.FALSE.equals(pve.getNewValue())) {\n446:             LOG.debug(\"finished editing\");\n447:             textEdited((FigText) src);\n448:             calcBounds();\n449:             endTrans();\n450:         } else\n451:             super.propertyChange(pve);\n452:     }\n453: \n454:     /**\n455:      * This method is called after the user finishes editing a text\n456:      * field that is in the FigEdgeModelElement.  Determine which field\n457:      * and update the model.  This class handles the name, subclasses\n458:      * should override to handle other text elements.\n459:      *\n460:      * @param ft the text Fig that has been edited\n461:      */\n462:     protected void textEdited(FigText ft) {\n463:         if (ft == name) {\n464:             if (getOwner() == null)\n465:                 return;\n466:             ModelFacade.setName(getOwner(), ft.getText());\n467:         }\n468:     }\n469: \n470:     /**\n471:      * @param f the Fig\n472:      * @return true if editable\n473:      */\n474:     protected boolean canEdit(Fig f) {\n475:         return true;\n476:     }\n477: \n478:     ////////////////////////////////////////////////////////////////\n479:     // event handlers - MouseListener implementation\n480: \n481:     /**\n482:      * @see java.awt.event.MouseListener#mousePressed(java.awt.event.MouseEvent)\n483:      */\n484:     public void mousePressed(MouseEvent me) {\n485:     }\n486: \n487:     /**\n488:      * @see java.awt.event.MouseListener#mouseReleased(java.awt.event.MouseEvent)\n489:      */\n490:     public void mouseReleased(MouseEvent me) {\n491:     }\n492: \n493:     /**\n494:      * @see java.awt.event.MouseListener#mouseEntered(java.awt.event.MouseEvent)\n495:      */\n496:     public void mouseEntered(MouseEvent me) {\n497:     }\n498: \n499:     /**\n500:      * @see java.awt.event.MouseListener#mouseExited(java.awt.event.MouseEvent)\n501:      */\n502:     public void mouseExited(MouseEvent me) {\n503:     }\n504: \n505:     /**\n506:      * If the user double clicks on anu part of this FigNode, pass it\n507:      * down to one of the internal Figs.  This allows the user to\n508:      * initiate direct text editing.\n509:      *\n510:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n511:      */\n512:     public void mouseClicked(MouseEvent me) {\n513:         if (me.isConsumed())\n514:             return;\n515:         if (me.getClickCount() >= 2) {\n516:             Fig f = hitFig(new Rectangle(me.getX() - 2, me.getY() - 2, 4, 4));\n517:             if (f instanceof MouseListener && canEdit(f))\n518: \t\t((MouseListener) f).mouseClicked(me);\n519:         }\n520:         me.consume();\n521:     }\n522: \n523:     /**\n524:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n525:      */\n526:     public void keyPressed(KeyEvent ke) {\n527:         if (ke.isConsumed())\n528:             return;\n529:         if (name != null && canEdit(name))\n530:             name.keyPressed(ke);\n531:     }\n532: \n533:     /**\n534:      * @see java.awt.event.KeyListener#keyReleased(java.awt.event.KeyEvent)\n535:      *\n536:      * Not used, do nothing.\n537:      */\n538:     public void keyReleased(KeyEvent ke) {\n539:     }\n540: \n541:     /**\n542:      * @see java.awt.event.KeyListener#keyTyped(java.awt.event.KeyEvent)\n543:      */\n544:     public void keyTyped(KeyEvent ke) {\n545:     }\n546: \n547:     ////////////////////////////////////////////////////////////////\n548:     // internal methods\n549: \n550:     /**\n551:      * This is called after any part of the UML MModelElement has