e current model.<p>\n248:      *\n249:      * @param modelElement is the model element\n250:      * @param stereotype is the stereotype\n251:      */\n252:     public void setStereoType(Object modelElement, Object stereotype) {\n253: \tif (stereotype != null)\n254: \t    stereotype =\n255: \t\tModelManagementHelper.getHelper().getCorrespondingElement(\n256: \t\t\tstereotype,\n257: \t\t\tModelFacade.getModel(modelElement),\n258: \t\t\ttrue);\n259:         ModelFacade.setStereotype(\n260: \t\tmodelElement,\n261: \t\tstereotype);\n262:     }\n263: \n264:     /**\n265:      * Tests if a stereotype is a stereotype with some name and base class.\n266:      *\n267:      * @param object is the stereotype.\n268:      * @param name is the name of the stereotype.\n269:      * @param base is the base class of the stereotype.\n270:      * @return true if object is a stereotype with the desired characteristics.\n271:      */\n272:     public boolean isStereotype(Object object, String name, String base) {\n273: \tif (object == null || !(object instanceof MStereotype))\n274: \t    return false;\n275: \n276: \tMStereotype st = (MStereotype) object;\n277: \tif (name == null && st.getName() != null)\n278: \t    return false;\n279: \tif (base == null && st.getBaseClass() != null)\n280: \t    return false;\n281: \n282: \treturn name.equals(st.getName()) && base.equals(st.getBaseClass());\n283:     }\n284: \n285:     /**\n286:      * Tests if a stereotype is or inherits from a stereotype with some\n287:      * name and base class.\n288:      *\n289:      * @param object is the stereotype.\n290:      * @param name is the name of the stereotype.\n291:      * @param base is the base class of the stereotype.\n292:      * @return true if object is a (descendant of a) stereotype with the\n293:      *\tdesired characteristics.\n294:      */\n295:     public boolean isStereotypeInh(Object object, String name, String base) {\n296: \tif (object == null || !(object instanceof MStereotype))\n297: \t