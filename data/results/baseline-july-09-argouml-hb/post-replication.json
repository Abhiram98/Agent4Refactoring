til.ArrayList;\n33: import java.util.Collection;\n34: import java.util.HashMap;\n35: import java.util.HashSet;\n36: import java.util.Iterator;\n37: import java.util.Set;\n38: import java.util.Vector;\n39: \n40: import org.apache.log4j.Logger;\n41: import org.argouml.application.ArgoVersion;\n42: import org.argouml.cognitive.ProjectMemberTodoList;\n43: import org.argouml.model.ModelFacade;\n44: import org.argouml.model.uml.UmlFactory;\n45: import org.argouml.model.uml.modelmanagement.ModelManagementHelper;\n46: import org.argouml.ui.ArgoDiagram;\n47: import org.argouml.ui.ProjectBrowser;\n48: import org.argouml.ui.explorer.ExplorerEventAdaptor;\n49: import org.argouml.ui.targetmanager.TargetEvent;\n50: import org.argouml.ui.targetmanager.TargetListener;\n51: import org.argouml.ui.targetmanager.TargetManager;\n52: import org.argouml.uml.ProfileJava;\n53: import org.argouml.uml.ProjectMemberModel;\n54: import org.argouml.uml.UMLChangeRegistry;\n55: import org.argouml.uml.diagram.ProjectMemberDiagram;\n56: import org.argouml.uml.diagram.state.ui.UMLStateDiagram;\n57: import org.argouml.uml.diagram.static_structure.ui.UMLClassDiagram;\n58: import org.argouml.uml.diagram.ui.UMLDiagram;\n59: import org.argouml.uml.diagram.use_case.ui.UMLUseCaseDiagram;\n60: import org.argouml.uml.generator.GenerationPreferences;\n61: import org.argouml.util.ChangeRegistry;\n62: import org.argouml.util.FileConstants;\n63: import org.argouml.util.Trash;\n64: \n65: import org.tigris.gef.base.Diagram;\n66: import org.tigris.gef.presentation.Fig;\n67: import org.tigris.gef.util.Util;\n68: \n69: /**\n70:  * A datastructure that represents the designer's current project.  A\n71:  *  Project consists of diagrams and UML models.\n72:  */\n73: public class Project implements java.io.Serializable, TargetListener {\n74: \n75:     /** logger */\n76:     private static final Logger LOG = Logger.getLogger(Project.class);\n77:     \n78:     ////////////////////////////////////////////////////////////////\n79:     // constants\n80: \n81:     private static final String ARGO_TEE = \"/org/argouml/xml/dtd/argo.tee\";\n82: \n83:     /**\n84:      * Default name for a project.\n85:      */\n86:     private static final String UNTITLED_FILE = \"Untitled\";\n87: \n88:     ////////////////////////////////////////////////////////////////\n89:     // static variables\n90:     \n91:     static final long serialVersionUID = 1399111233978692444L;\n92: \n93:     ////////////////////////////////////////////////////////////////\n94:     // instance variables\n95: \n96:     /** TODO: should just be the directory to write\n97:      */\n98:     private URL url;\n99:     private ChangeRegistry saveRegistry;\n100: \n101:     private String authorname;\n102:     private String description;\n103:     private String version;\n104: \n105:     private Vector searchpath;\n106:     private Vector members;\n107:     private String historyFile;\n108: \n109:     /**\n110:      * The version number of the persistence format that last\n111:      * saved this project.\n112:      */\n113:     private int persistenceVersion;\n114: \n115:     /**\n116:      * Instances of the uml model.\n117:      */\n118:     private Vector models;\n119: \n120:     /**\n121:      * Instances of the uml diagrams.\n122:      */\n123:     private Vector diagrams;\n124:     private Object defaultModel;\n125:     private boolean needsSave;\n126:     private Object currentNamespace;\n127:     private HashMap uuidRefs;\n128:     private GenerationPreferences cgPrefs;\n129:     private transient VetoableChangeSupport vetoSupport;\n130: \n131:     /**\n132:      * The root of the modeltree the user is working on. (The untitled_model in\n133:      * the navpane).\n134:      */\n135:     private Object treeRoot;\n136:     \n137:     /**\n138:      * The active diagram, pointer to a diagram in the list with diagrams.\n139:      */\n140:     private ArgoDiagram activeDiagram;\n141: \n142:     /** Cache for the default model.\n143:      */\n144:     private HashMap defaultModelCache;\n145: \n146:     /**\n147:      * Constructor.\n148:      * \n149:      * @param file File to read from.\n150:      * @throws MalformedURLException if the file name is incorrect.\n151:      * @throws IOException if we cannot read the file.\n152:      */\n153:     public Project(File file) throws MalformedURLException, IOException {\n154:         this(Util.fileToURL(file));\n155:     }\n156: \n157:     /**\n158:      * Constructor.\n159:      *\n160:      * @param theProjectUrl Url to read the project from.\n161:      */\n162:     public Project(URL theProjectUrl) {\n163:         this();\n164:         url = Util.fixURLExtension(theProjectUrl, \n165:                 FileConstants.COMPRESSED_FILE_EXT);\n166:         saveRegistry = new UMLChangeRegistry();\n167: \n168:     }\n169: \n170:     /**\n171:      * Constructor.\n172:      */\n173:     public Project() {\n174:         \n175:         authorname = \"\";\n176:         description = \"\";\n177:         // this should be moved to a ui action.\n178:         version = ArgoVersion.getVersion();\n179:         \n180:         searchpath = new Vector();\n181:         members = new Vector();\n182:         historyFile = \"\";\n183:         models = new Vector();\n184:         diagrams = new Vector();\n185:         cgPrefs = new GenerationPreferences();\n186:         defaultModelCache = new HashMap();\n187:         \n188:         saveRegistry = new UMLChangeRegistry();\n189:         LOG.info(\"making empty project with empty model\");\n190:         // Jaap Branderhorst 2002-12-09\n191:         // load the default model\n192:         // this is NOT the way how it should be since this makes argo\n193:         // depend on Java even more.\n194:         setDefaultModel(ProfileJava.loadProfileModel());\n195:         addSearchPath(\"PROJECT_DIR\");\n196:         setNeedsSave(false);\n197:         TargetManager.getInstance().addTargetListener(this);\n198: \n199:     }\n200: \n201:     /**\n202:      * Makes a just created project to an untitled project with a\n203:      * class diagram and a usecase diagram and an untitled model.\n204:      */\n205:     protected void makeUntitledProject() {\n206:         if (getRoot() != null)\n207:             throw new IllegalStateException(\n208:                     \"Tried to make a non-empty project \"\n209:                     + \"to an untitled project\");\n210:         Object model =\n211:             UmlFactory.getFactory().getModelManagement().createModel();\n212:         ModelFacade.setName(model, \"untitledModel\");\n213:         setRoot(model);\n214:         setCurrentNamespace(model);\n215:         addMember(new ProjectMemberTodoList(\"\", this));\n216:         addMember(new UMLClassDiagram(model));\n217:         addMember(new UMLUseCaseDiagram(model));\n218:         setNeedsSave(false);       \n219:         setActiveDiagram((ArgoDiagram) getDiagrams().get(0));\n220:     }\n221:  \n222:     /**\n223:      * Constructor.\n224:      * \n225:      * @param model The new model.\n226:      */\n227:     public Project(Object model) {\n228:         this();\n229:         \n230:         if (!ModelFacade.isAModel(model)) {\n231:             throw new IllegalArgumentException();\n232:         }\n233:         \n234:         LOG.info(\"making empty project with model: \"\n235: \t\t        + ModelFacade.getName(model));\n236:         setRoot(model);\n237:         setCurrentNamespace(model);\n238:         setNeedsSave(false);\n239:     }\n240:     \n241:     /**\n242:      * Find the base name of this project.<p>This is the name minus\n243:      * any file extension.\n244:      * \n245:      * @return The name (a String).\n246:      */\n247:     public String getBaseName() {\n248:         String n = getName();\n249: \n250:         if (n.endsWith(FileConstants.COMPRESSED_FILE_EXT)) {\n251:             return n.substring(0,\n252: \t\t\t       n.length()\n253: \t\t\t       - FileConstants.COMPRESSED_FILE_EXT.length());\n254:         }\n255:         if (n.endsWith(FileConstants.UNCOMPRESSED_FILE_EXT)) {\n256:             return n.substring(0,\n257: \t\t\t       n.length()\n258: \t\t\t       - FileConstants.UNCOMPRESSED_FILE_EXT.length());\n259:         }\n260:         return n;\n261:     }\n262: \n263:     /**\n264:      * @return the name of the project\n265:      */\n266:     public String getName() {\n267:         // TODO: maybe separate name\n268:         if (url == null)\n269:             return UNTITLED_FILE;\n270:         String name = url.getFile();\n271:         int i = name.lastIndexOf('/');\n272:         return name.substring(i + 1);\n273:     }\n274: \n275:     /**\n276:      * Set the project URL.\n277:      * \n278:      * @param n The new URL (as a String).\n279:      * @throws MalformedURLException if the argument cannot be converted to \n280:      *         an URL.\n281:      */\n282:     public void setName(String n)\n283:         throws MalformedURLException {\n284:         String s = \"\";\n285:         if (getURL() != null)\n286:             s = getURL().toString();\n287:         s = s.substring(0, s.lastIndexOf(\"/\") + 1) + n;\n288:         setURL(new URL(s));\n289:     }\n290: \n291:     /**\n292:      * Get the URL for this project.\n293:      * \n294:      * @return The URL.\n295:      */\n296:     public URL getURL() {\n297:         return url;\n298:     }\n299: \n300:     /**\n301:      * Set the URL for this project.\n302:      * \n303:      * @param theUrl The URL to set.\n304:      */\n305:     public void setURL(URL theUrl) {\n306:         if (theUrl != null) {\n307:             theUrl = Util.fixURLExtension(theUrl, \n308:                     FileConstants.COMPRESSED_FILE_EXT);\n309:         }\n310: \n311:         if (LOG.isDebugEnabled()) {\n312:             LOG.debug(\"Setting project URL from \\\"\" + url \n313:                       + \"\\\" to \\\"\" + theUrl + \"\\\".\");\n314:         }\n315: \n316:         url = theUrl;\n317:     }\n318: \n319:     /**\n320:      * Set the project file.\n321:      * \n322:      * This only works if it is possible to convert the File to an url.\n323:      *\n324:      * @param file File to set the project to.\n325:      */\n326:     public void setFile(File file) {\n327:         try {\n328:             URL theProjectUrl = Util.fileToURL(file);\n329: \n330:             if (LOG.isDebugEnabled()) {\n331:                 LOG.debug(\"Setting project file name from \\\"\" \n332:                           + url \n333:                           + \"\\\" to \\\"\" \n334:                           + theProjectUrl \n335:                           + \"\\\".\");\n336:             }\n337: \n338:             url = theProjectUrl;\n339:         } catch (MalformedURLException murle) {\n340:             LOG.error(\"problem in setFile:\" + file, murle);\n341:         } catch (IOException ex) {\n342:             LOG.error(\"problem in setFile:\" + file, ex);\n343:         }\n344:     }\n345: \n346:     /**\n347:      * @return the search path\n348:      */\n349:     public Vector getSearchPath() {\n350:         return searchpath;\n351:     }\n352: \n353:     /**\n354:      * @param searchPathElement the element to be added to the searchpath\n355:      */\n356:     public void addSearchPath(String searchPathElement) {\n357:         this.searchpath.addElement(searchPathElement);\n358:     }\n359: \n360:     /**\n361:      * Get all members of the project.\n362:      * \n363:      * @return a Vector with all members.\n364:      */\n365:     public Vector getMembers() {\n366:         return members;\n367:     }\n368: \n369:     /**\n370:      * @param d the diagram\n371:      */\n372:     public void addMember(ArgoDiagram d) {\n373:         ProjectMember pm = new ProjectMemberDiagram(d, this);\n374:         addDiagram(d);\n375:         // if diagram added successfully, add the member too\n376:         members.addElement(pm);\n377:     }\n378: \n379:     /**\n380:      * @param pm the member to be added\n381:      */\n382:     public void addMember(ProjectMemberTodoList pm) {\n383:         Iterator iter = members.iterator();\n384:         Object currentMember = null;\n385:         while (iter.hasNext()) {\n386:             currentMember = iter.next();\n387:             if (currentMember instanceof ProjectMemberTodoList) {\n388:                 /* No need to have several of these */\n389:                 return;\n390:             }\n391:         }\n392:         // got past the veto, add the member\n393:         members.addElement(pm);\n394:     }\n395: \n396:     /**\n397:      * @param m the member to be added\n398:      */\n399:     public void addMember(Object m) {\n400:         \n401:         if (!ModelFacade.isAModel(m)) {\n402:             throw new IllegalArgumentException(\n403:                 \"The member must be a UML model. It is \" \n404:                     + m.getClass().getName());\n405:         }\n406:         \n407:         Iterator iter = members.iterator();\n408:         Object currentMember = null;\n409:         boolean memberFound = false;\n410:         while (iter.hasNext()) {\n411:             currentMember = iter.next();\n412:             if (currentMember instanceof ProjectMemberModel) {\n413:                 Object currentModel =\n414:                     ((ProjectMemberModel) currentMember).getModel();\n415:                 if (currentModel == m) {\n416:                     memberFound = true;\n417:                     break;\n418:                 }\n419:             }\n420:         }\n421:         if (!memberFound) {\n422:             if (!models.contains(m)) {\n423:                 addModel(m);\n424:             }\n425:             // got past the veto, add the member\n426:             ProjectMember pm = new ProjectMemberModel(m, this);\n427:             members.addElement(pm);\n428:         }\n429:     }\n430: \n431:     /**\n432:      * @param m a namespace\n433:      */\n434:     public void addModel(Object m) {\n435:         \n436:         if (!ModelFacade.isANamespace(m)) {\n437:             throw new IllegalArgumentException();\n438: \t}\n439:         \n440:         // fire indeterminate change to avoid copying vector\n441:         if (!models.contains(m))\n442:             models.addElement(m);\n443:         setCurrentNamespace(m);\n444:         setNeedsSave(true);\n445:     }\n446: \n447:     /**\n448:      * Removes a project member diagram completely from the project.\n449:      * @param d the ArgoDiagram\n450:      */\n451:     protected void removeProjectMemberDiagram(ArgoDiagram d) {\n452: \n453:         removeDiagram(d);\n454: \n455:         // should remove the corresponding ProjectMemberDiagram not\n456:         // the ArgoDiagram from the members\n457: \n458:         // _members.removeElement(d);\n459:         // ehhh lets remove the diagram really and remove it from its\n460:         // corresponding projectmember too\n461:         Iterator it = members.iterator();\n462:         while (it.hasNext()) {\n463:             Object obj = it.next();\n464:             if (obj instanceof ProjectMemberDiagram) {\n465:                 ProjectMemberDiagram pmd = (ProjectMemberDiagram) obj;\n466:                 if (pmd.getDiagram() == d) {\n467:                     members.removeElement(pmd);\n468:                     break;\n469:                 }\n470:             }\n471:         }\n472:     }\n473: \n474:     /**\n475:      * @param name the name of the member to be found\n476:      * @return the member\n477:      */\n478:     public ProjectMember findMemberByName(String name) {\n479:         if (LOG.isDebugEnabled()) {\n480:             LOG.debug(\"findMemberByName called for \\\"\" + name + \"\\\".\");\n481:         }\n482:         for (int i = 0; i < members.size(); i++) {\n483:             ProjectMember pm = (ProjectMember) members.elementAt(i);\n484:             if (name.equals(pm.getPlainName()))\n485:                 return pm;\n486:         }\n487:         if (LOG.isDebugEnabled()) {\n488:             LOG.debug(\"Member \\\"\" + name + \"\\\" not found.\");\n489:         }\n490:         return null;\n491:     }\n492: \n493:     /**\n494:      * Get the author name.\n495:      * \n496:      * @return The author name.\n497:      */\n498:     public String getAuthorname() {\n499:         return authorname;\n500:     }\n501:     \n502:     /**\n503:      * Set the author name.\n504:      * \n505:      * @param s The new author name.\n506:      */\n507:     public void setAuthorname(String s) {\n508:         authorname = s;\n509:     }\n510: \n511:     /**\n512:      * Get the version.\n513:      * \n514:      * @return the version.\n515:      */\n516:     public String getVersion() {\n517:         return version;\n518:     }\n519:     \n520:     /**\n521:      * Set the new version.\n522:      * @param s The new version.\n523:      */\n524:     public void setVersion(String s) {\n525:         version = s;\n526:     }\n527: \n528:     /**\n529:      * Get the description.\n530:      * \n531:      * @return the description.\n532:      */\n533:     public String getDescription() {\n534:         return description;\n535:     }\n536: \n537:     /**\n538:      * Set a new description.\n539:      *  \n540:      * @param s The new description.\n541:      */\n542:     public void setDescription(String s) {\n543:         description = s;\n544:     }\n545: \n546:     /**\n547:      * Get the history file.\n548:      * \n549:      * @return The history file.\n550:      */\n551:     public String getHistoryFile() {\n552:         return historyFile;\n553:     }\n554: \n555:     /**\n556:      * Set the history file.\n557:      * \n558:      * @param s The new history file.\n559:      */\n560:     public void setHistoryFile(String s) {\n561:         historyFile = s;\n562:     }\n563: \n564:     /**\n565:      * Set the needs-to-be-saved flag.\n566:      * \n567:      * @param newValue The new value.\n568:      */\n569:     public void setNeedsSave(boolean newValue) {\n570:         saveRegistry.setChangeFlag(newValue);\n571:     }\n572:     \n573:     /**\n574:      * Test if the model needs to be saved.\n575:      * \n576:      * @return <tt>true</tt> if the model needs to be saved.\n577:      */\n578:     public boolean needsSave() {\n579:         return saveRegistry.hasChanged();\n580:     }\n581: \n582:     /**\n583:      * Returns all models defined by the user. I.e. this does not return the\n584:      * default model but all other models.\n585:      * \n586:      * @return A Vector of all user defined models.\n587:      */\n588:     public Vector getUserDefinedModels() {\n589:         return models;\n590:     }\n591: \n592:     /**\n593:      * Returns all models, including the default model (default.xmi).\n594:      * \n595:      * @return A Collection containing all models.\n596:      */\n597:     public Collection getModels() {\n598:         Set ret = new HashSet();\n599:         ret.addAll(models);\n600:         ret.add(defaultModel);\n601:         return ret;\n602:     }\n603: \n604:     /**\n605:      * Return the model.<p>\n606:      * \n607:      * If there isn't exactly one model, <tt>null</tt> is returned.\n608:      * \n609:      * @return the model.\n610:      */\n611:     public Object getModel() {\n612:         if (models.size() != 1) {\n613:             return null;\n614:         }\n615:         return models.elementAt(0);\n616:     }\n617: \n618:     /**\n619:      * Searches for a type/classifier with name s. If the type is not found,\n620:      * a new type is created and added to the current namespace.\n621:      * @param s the name of the type/classifier to be found\n622:      * @return MClassifier\n623:      */\n624:     public Object findType(String s) {\n625:         return findType(s, true);\n626:     }\n627: \n628:     /**\n629:      * Searches for a type/classifier with name s. If defineNew is\n630:      * true, a new type is defined if the type/classifier is not\n631:      * found. The newly created type is added to the currentNamespace\n632:      * and given the name s.\n633:      * @param s the name of the type/classifier to be found\n634:      * @param defineNew if true, define a new one \n635:      * @return MClassifier the found classifier\n636:      */\n637:     public Object findType(String s, boolean defineNew) {\n638:         if (s != null) {\n639:             s = s.trim();\n640:         }\n641:         if (s == null || s.length() == 0) {\n642:             return null;\n643:         }\n644:         Object cls = null;\n645:         int numModels = models.size();\n646:         for (int i = 0; i < numModels; i++) {\n647:             cls = findTypeInModel(s, models.elementAt(i));\n648:             if (cls != null) {\n649:                 return cls;\n650:             }\n651:         }\n652:         cls = findTypeInModel(s, defaultModel);\n653:         // hey, now we should move it to the model the user is working in\n654:         if (cls != null) {\n655:             cls = ModelManagementHelper.\n656:                 getHelper().getCorrespondingElement(cls, getRoot());\n657:         }\n658:         if (cls == null && defineNew) {\n659:             LOG.debug(\"new Type defined!\");\n660:             cls = UmlFactory.getFactory().getCore()\n661:         \t\t  .buildClass(getCurrentNamespace());\n662:             ModelFacade.setName(cls, s);\n663:         }\n664:         return cls;\n665:     }\n666: \n667:     /**\n668:      * Finds all figs on the diagrams for some project member,\n669:      * including the figs containing the member (so for some\n670:      * operation, the containing figclass is returned).\n671:      * \n672:      * @param member The member we are looking for. \n673:      *               This can be a NSUML object but also another object.\n674:      * @return Collection The collection with the figs.\n675:      */\n676:     public Collection findFigsForMember(Object member) {\n677:         Collection figs = new ArrayList();\n678:         Iterator it = getDiagrams().iterator();\n679:         while (it.hasNext()) {\n680:             ArgoDiagram diagram = (ArgoDiagram) it.next();\n681:             Object fig = diagram.getContainingFig(member);\n682:             if (fig != null) {\n683:                 figs.add(fig);\n684:             }\n685:         }\n686:         return figs;\n687:     }\n688: \n689:     /** \n690:      * Finds a classifier with a certain name.<p>\n691:      * \n692:      * Will only return first classifier with the matching name.\n693:      *\n694:      * @param s is short name.\n695:      * @param ns Namespace where we do the search.\n696:      * @return the found classifier (or <tt>null</tt> if not found).\n697:      */\n698:     public Object findTypeInModel(String s, Object ns) {\n699:         \n700:         if (!ModelFacade.isANamespace(ns)) {\n701:             throw new IllegalArgumentException();\n702:     \t}\n703:         \n704:         Collection allClassifiers =\n705:             ModelManagementHelper.getHelper()\n706: \t        .getAllModelElementsOfKind(ns, (Class) ModelFacade.CLASSIFIER);\n707:         \n708:         Object[] classifiers = allClassifiers.toArray();\n709:         Object classifier = null;\n710:         \n711:         for (int i = 0; i < classifiers.length; i++) {\n712:             \n713:             classifier = classifiers[i];\n714:             if (ModelFacade.getName(classifier) != null\n715:             \t\t&& ModelFacade.getName(classifier).equals(s)) {\n716:                 return classifier;\n717:             }\n718:         }\n719:         \n720:         return null;\n721:     }\n722: \n723:     /**\n724:      * @param m the namespace\n725:      */\n726:     public void setCurrentNamespace(Object m) {\n727:         \n728:         if (m != null && !ModelFacade.isANamespace(m)) {\n729:             throw new IllegalArgumentException();\n730:     \t}\n731:         \n732:         currentNamespace = m;\n733:     }\n734: \n735: 