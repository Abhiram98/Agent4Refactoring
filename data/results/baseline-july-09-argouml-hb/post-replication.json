\n286:     /**\n287:      * @see javax.swing.ListModel#getElementAt(int)\n288:      */\n289:     public Object getElementAt(int index) {\n290:         if (index >= 0 && index < _objects.size())\n291:             return _objects.get(index);\n292:         return null;\n293:     }\n294: \n295:     /**\n296:      * @see javax.swing.ListModel#getSize()\n297:      */\n298:     public int getSize() {\n299:         return _objects.size();\n300:     }\n301:     \n302:     public int getIndexOf(Object o) {\n303:         return _objects.indexOf(o);\n304:     }\n305:     \n306:     public void addElement(Object o) {\n307:         if (!_objects.contains(o)) {\n308:             _objects.add(o);\n309:             fireIntervalAdded(this, _objects.size()-1, _objects.size()-1);\n310:         }\n311:     }\n312:     \n313:     public void setSelectedItem(Object o) {\n314:         if ((_selectedObject != null && !_selectedObject.equals( o )) || _selectedObject == null && o != null) {\n315:             _selectedObject = o;\n316:             fireContentsChanged(this, -1, -1);\n317:         }\n318:     }\n319:     \n320:     public void removeElement(Object o) {       \n321:         int index = _objects.indexOf(o);\n322:         if ( getElementAt( index ) == _selectedObject ) {\n323:             if ( index == 0 ) {\n324:                 setSelectedItem( getSize() == 1 ? null : getElementAt( index + 1 ) );\n325:             }\n326:             else {\n327:                 setSelectedItem( getElementAt( index - 1 ) );\n328:             }\n329:         }\n330:         _objects.remove(index);\n331: \n332:         fireIntervalRemoved(this, index, index);\n333:     }\n334:     \n335:     public void removeAllElements() {\n336:         int startIndex = 0;\n337:         int endIndex = _objects.size()-1;\n338:         if (!_objects.isEmpty()) {\n339:             _objects.clear();\n340:             _selectedObject = null;\n341:             fireIntervalRemoved(this, startIndex, endIndex);\n342:         }\n343:     }\n344:     \n345:     public Object getSelectedItem() {\n346:         return _selectedObject;\n347:     }\n348:     \n349:     /**\n350:      * Returns true if some object elem is contained by the list of choices\n351:      * @param elem\n352:      * @return boolean\n353:      */\n354:     public boolean contains(Object elem) {\n355:         if (_objects.contains(elem)) return true;\n356:         if (elem instanceof Collection) {\n357:             Iterator it = ((Collection)elem).iterator();      \n358:             while(it.hasNext()) {\n359:                 if (!_objects.contains(it.next())) return false;\n360:             }\n361:             return true;\n362:         }\n363:         return false;\n364:     }\n365:     \n366:     /**\n367:      * Returns true if some event is valid. An event is valid if the element\n368:      * changed in the event is valid. This is determined via a call to isValidElement.\n369:      * This method can be overriden by subclasses if they cannot determine if\n370:      * it is a valid event just by checking the changed element.\n371:      * @param e\n372:      * @return boolean\n373:      */\n374:     protected boolean isValidEvent(MElementEvent e) {\n375:         boolean valid = false;\n376:         if (!(getChangedElement(e) instanceof Collection)) {\n377:             valid = isValidElement((MBase)getChangedElement(e));\n378:             if (!valid && e.getNewValue() == null && e.getOldValue() != null) {\n379:                 valid = true; // we tried to remove a value\n380:             }\n381:         } else {\n382:             Collection col = (Collection)getChangedElement(e);\n383:             Iterator it = col.iterator();\n384:             if (!col.isEmpty()) {\n385:                 valid = true;\n386:                 while (it.hasNext()) {\n387:                     Object o = it.next();\n388:                     if (!isValidElement((MBase)o)) {\n389:                         valid = false;\n390:                