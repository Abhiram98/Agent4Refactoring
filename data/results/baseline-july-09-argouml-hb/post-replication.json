Change the current Locale.\n88:      *\n89:      * @param locale the new Locale\n90:      */\n91:     public static void setLocale(Locale locale) {\n92:         org.workingfrog.i18n.util.Translator.setLocale(locale);\n93:     }\n94: \n95:     /**   \n96:      * Loads image bindings from a File.\n97:      *\n98:      * @param file the properties file\n99:      * @return the properties in file\n100:      */\n101:     private static Properties doLoad(String file) {\n102: \n103:         InputStream inputStream = null;\n104:         Properties properties = new Properties();\n105: \n106:         try {\n107:             inputStream = Translator.class.getResourceAsStream(propertiesFile);\n108:             properties.load(inputStream);\n109:             inputStream.close();\n110:         } catch (IOException ex) {\n111:             LOG.fatal(\"Unable to load properties from file: \" + file, ex);\n112:             System.exit(1);\n113:         }\n114: \n115:         return properties;\n116:     }\n117: \n118:     /**   \n119:      * Provide a \"gef compliant\" image file name.\n120:      *\n121:      * @param name the new i18n key\n122:      * @return the old i18n key\n123:      */\n124:     public static String getImageBinding(String name) {\n125: \n126:         String binding = null;\n127: \n128:         if (images == null) {\n129:             images = doLoad(propertiesFile);\n130:         }\n131: \n132:         binding = images.getProperty(name);\n133: \n134:         if (binding == null) {\n135:             return name;\n136:         } else {\n137:             return binding;\n138:         }\n139:     }\n140: \n141:     /** \n142:      * Helper for localization to eliminate the need to import\n143:      * the gef util library.<p>\n144:      *\n145:      * This is only used when retrieving the strings localized in GEF.\n146:      *\n147:      * @deprecated by Linus Tolke as of 0.17.2.\n148:      *             Use {@link #localize(String key)}.\n149:      * @param bundle a binding to a bundle of i18n resources\n150:      * @param key the key to loacalize\n151:      * @return the translation\n152:      */\n153:     public static String localize(String bundle, String key) {\n154:         String gefValue = org.tigris.gef.util.Localizer.localize(bundle, key);\n155:         return org.workingfrog.i18n.util.Translator.localize(key, gefValue);\n156:     }\n157: \n158:     /**\n159:      * Helper for those that don't want to give the bundle.<p>\n160:      *\n161:      * <em>Note:</em> This one argument <code>key</code>\n162:      * doesn't seem to work for tags that aren't prefixed with the\n163:      * property file name. We get a NullPointerException. \n164:      *\n165:      * @param key The key to localize.\n166:      * @return The localized String.\n167:      */\n168:     public static String localize(String key) {\n169:         return org.workingfrog.i18n.util.Translator.localize(key, key);\n170:     }\n171:     \n172:     \n173:     /**\n174:      * Generates an localized String with arguments.<p>\n175:      *\n176:      * The localized string is a pattern to be processed by\n177:      * {@link MessageFormat}.\n178:      *\n179:      * @deprecated by Linus Tolke as of 0.17.2.\n180:      *             Use {@link #messageFormat(String key, Object[] args)}.\n181:      * @param bundle a binding to a bundle of i18n resources\n182:      * @param key the key to localize\n183:      * @param args the args as Objects, inserted in the localized String\n184:      * @return the localized String with inserted arguments\n185:      */\n186:     public static String messageFormat(String bundle, \n187: \t\t\t\t       String key, Object[] args)\n188:     {\n189:     \tMessageFormat msgFmt = new MessageFormat(localize(bundle, key));\n190: \treturn msgFmt.format(args);\n191:     }\n192:     \n193:    \n194:     /**\n195:      * Generates an localized String with arguments.<p>\n196:      *\n197:      * The localized string is a pattern to be processed by\n19