                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/kernel/Project.java: \n1: // $Id$\n2: // Copyright (c) 1996-2006 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.kernel;\n26: \n27: import java.beans.PropertyChangeEvent;\n28: import java.beans.PropertyVetoException;\n29: import java.beans.VetoableChangeListener;\n30: import java.beans.VetoableChangeSupport;\n31: import java.io.File;\n32: import java.io.IOException;\n33: import java.net.MalformedURLException;\n34: import java.net.URL;\n35: import java.util.ArrayList;\n36: import java.util.Collection;\n37: import java.util.HashMap;\n38: import java.util.HashSet;\n39: import java.util.Iterator;\n40: import java.util.Set;\n41: import java.util.Vector;\n42: \n43: import org.apache.log4j.Logger;\n44: import org.argouml.application.ArgoVersion;\n45: import org.argouml.application.api.Argo;\n46: import org.argouml.application.api.Configuration;\n47: import org.argouml.model.Model;\n48: import org.argouml.persistence.PersistenceManager;\n49: import org.argouml.ui.ArgoDiagram;\n50: import org.argouml.ui.explorer.ExplorerEventAdaptor;\n51: import org.argouml.ui.targetmanager.TargetEvent;\n52: import org.argouml.ui.targetmanager.TargetListener;\n53: import org.argouml.ui.targetmanager.TargetManager;\n54: import org.argouml.uml.Profile;\n55: import org.argouml.uml.ProfileException;\n56: import org.argouml.uml.ProfileJava;\n57: import org.argouml.uml.ProjectMemberModel;\n58: import org.argouml.uml.cognitive.ProjectMemberTodoList;\n59: import org.argouml.uml.diagram.DiagramFactory;\n60: import org.argouml.uml.diagram.ProjectMemberDiagram;\n61: import org.argouml.uml.diagram.static_structure.ui.CommentEdge;\n62: import org.argouml.uml.diagram.static_structure.ui.UMLClassDiagram;\n63: import org.argouml.uml.diagram.ui.UMLDiagram;\n64: import org.argouml.uml.generator.GenerationPreferences;\n65: import org.tigris.gef.base.Diagram;\n66: import org.tigris.gef.presentation.Fig;\n67: import org.tigris.gef.util.Util;\n68: \n69: /**\n70:  * The Project is a datastructure that represents the designer's\n71:  * current project. It manages the list of diagrams and UML models.\n72:  */\n73: public class Project implements java.io.Serializable, TargetListener {\n74: \n75:     /**\n76:      * Logger.\n77:      */\n78:     private static final Logger LOG = Logger.getLogger(Project.class);\n79: \n80:     ////////////////////////////////////////////////////////////////\n81:     // constants\n82: \n83:     /**\n84:      * Default name for a project.\n85:      */\n86:     private static final String UNTITLED_FILE = \"Untitled\";\n87: \n88:     ////////////////////////////////////////////////////////////////\n89:     // static variables\n90: \n91:     /**\n92:      * The UID.\n93:      */\n94:     static final long serialVersionUID = 1399111233978692444L;\n95: \n96:     ////////////////////////////////////////////////////////////////\n97:     // instance variables\n98: \n99:     /**\n100:      * TODO: should just be the directory to write.\n101:      */\n102:     private URL projectUri;\n103: \n104:     /* The preferences with project-scope: */\n105:     private String authorname;\n106:     private String authoremail;\n107:     private String description;\n108:     /* The ArgoUML version with which this project was last saved: */\n109:     private String version;\n110: \n111:     private ProjectSettings projectSettings;\n112: \n113:     private Vector searchpath;\n114: \n115:     // TODO: break into 3 main member types\n116:     // model, diagram and other\n117:     private MemberList members;\n118: \n119:     private String historyFile;\n120: \n121:     /**\n122:      * The version number of the persistence format that last\n123:      * saved this project.\n124:      */\n125:     private int persistenceVersion;\n126: \n127:     /**\n128:      * Instances of the uml model.\n129:      */\n130:     private Vector models;\n131: \n132:     /**\n133:      * Instances of the uml diagrams.\n134:      */\n135:     private Vector diagrams;\n136:     private Object defaultModel;\n137:     private Object currentNamespace;\n138:     private HashMap uuidRefs;\n139:     private GenerationPreferences cgPrefs;\n140:     private transient VetoableChangeSupport vetoSupport;\n141: \n142:     private Profile profile;\n143: \n144:     /**\n145:      * The active diagram, pointer to a diagram in the list with diagrams.\n146:      */\n147:     private ArgoDiagram activeDiagram;\n148: \n149:     /**\n150:      * Cache for the default model.\n151:      */\n152:     private HashMap defaultModelTypeCache;\n153: \n154:     private Collection trashcan = new ArrayList();\n155: \n156:     /**\n157:      * Constructor.\n158:      *\n159:      * @param theProjectUri Url to read the project from.\n160:      */\n161:     public Project(URL theProjectUri) {\n162:         this();\n163:         this.projectUri = PersistenceManager.getInstance().fixUrlExtension(theProjectUri);\n164:     }\n165: \n166:     /**\n167:      * Constructor.\n168:      */\n169:     public Project() {\n170:         profile = new ProfileJava();\n171:         projectSettings = new ProjectSettings();\n172:         \n173:         Model.getModelManagementFactory().setRootModel(null);\n174: \n175:         authorname = Configuration.getString(Argo.KEY_USER_FULLNAME);\n176:         authoremail = Configuration.getString(Argo.KEY_USER_EMAIL);\n177:         description = \"\";\n178:         // this should be moved to a ui action.\n179:         version = ArgoVersion.getVersion();\n180: \n181:         searchpath = new Vector();\n182:         members = new MemberList();\n183:         historyFile = \"\";\n184:         models = new Vector();\n185:         diagrams = new Vector();\n186:         cgPrefs = new GenerationPreferences();\n187:         defaultModelTypeCache = new HashMap();\n188: \n189:         LOG.info(\"making empty project with empty model\");\n190:         try {\n191:             // Jaap Branderhorst 2002-12-09\n192:             // load the default model\n193:             // this is NOT the way how it should be since this makes argo\n194:             // depend on Java even more.\n195:             setDefaultModel(profile.getProfileModel());\n196:         } catch (ProfileException e) {\n197:             // TODO: how are we going to handle exceptions here?\n198:             // I think we need a ProjectException.\n199:             LOG.error(\"Exception setting the default profile\", e);\n200:         }\n201:         addSearchPath(\"PROJECT_DIR\");\n202:         TargetManager.getInstance().addTargetListener(this);\n203:     }\n204: \n205:     /**\n206:      * Find the base name of this project.<p>\n207:      *\n208:      * This is the name minus any valid file extension.\n209:      *\n210:      * @return The name (a String).\n211:      */\n212:     public String getBaseName() {\n213:         String n = getName();\n214:         n = PersistenceManager.getInstance().getBaseName(n);\n215:         return n;\n216:     }\n217: \n218:     /**\n219:      * @return the name of the project\n220:      */\n221:     public String getName() {\n222:         // TODO: maybe separate name\n223:         if (projectUri == null) {\n224:             return UNTITLED_FILE;\n225:         }\n226:         String name = projectUri.getFile();\n227:         int i = name.lastIndexOf('/');\n228:         return name.substring(i + 1);\n229:     }\n230: \n231:     /**\n232:      * Set the project URL.\n233:      *\n234:      * @param n The new URL (as a String).\n235:      * @throws MalformedURLException if the argument cannot be converted to\n236:      *         an URL.\n237:      */\n238:     public void setName(String n)\n239:         throws MalformedURLException {\n240:         String s = \"\";\n241:         if (getURL() != null) {\n242:             s = getURL().toString();\n243:         }\n244:         s = s.substring(0, s.lastIndexOf(\"/\") + 1) + n;\n245:         setURL(new URL(s));\n246:     }\n247: \n248:     /**\n249:      * Get the URL for this project.\n250:      *\n251:      * @return The URL.\n252:      */\n253:     public URL getURL() {\n254:         return projectUri;\n255:     }\n256: \n257:     /**\n258:      * Set the URL for this project.\n259:      *\n260:      * @param theUrl The URL to set.\n261:      */\n262:     public void setURL(URL theUrl) {\n263:         if (theUrl != null) {\n264:             theUrl = PersistenceManager.getInstance().fixUrlExtension(theUrl);\n265:         }\n266: \n267:         if (LOG.isDebugEnabled()) {\n268:             LOG.debug(\"Setting project URL from \\\"\" + projectUri\n269:                       + \"\\\" to \\\"\" + theUrl + \"\\\".\");\n270:         }\n271: \n272:         projectUri = theUrl;\n273:     }\n274: \n275:     /**\n276:      * Set the project file.\n277:      *\n278:      * This only works if it is possible to convert the File to an url.\n279:      *\n280:      * @param file File to set the project to.\n281:      */\n282:     public void setFile(File file) {\n283:         try {\n284:             URL theProjectUrl = Util.fileToURL(file);\n285: \n286:             if (LOG.isDebugEnabled()) {\n287:                 LOG.debug(\"Setting project file name from \\\"\"\n288:                           + projectUri\n289:                           + \"\\\" to \\\"\"\n290:                           + theProjectUrl\n291:                           + \"\\\".\");\n292:             }\n293: \n294:             projectUri = theProjectUrl;\n295:         } catch (MalformedURLException murle) {\n296:             LOG.error(\"problem in setFile:\" + file, murle);\n297:         } catch (IOException ex) {\n298:             LOG.error(\"problem in setFile:\" + file, ex);\n299:         }\n300:     }\n301: \n302:     /**\n303:      * @return the search path\n304:      */\n305:     public Vector getSearchPath() {\n306:         return searchpath;\n307:     }\n308: \n309:     /**\n310:      * @param searchPathElement the element to be added to the searchpath\n311:      */\n312:     public void addSearchPath(String searchPathElement) {\n313:         if (!this.searchpath.contains(searchPathElement)) {\n314:             this.searchpath.addElement(searchPathElement);\n315:         }\n316:     }\n317: \n318:     /**\n319:      * Get all members of the project.\n320:      *\n321:      * @return a Vector with all members.\n322:      */\n323:     public MemberList getMembers() {\n324:         LOG.info(\"Getting the members there are \" + members.size());\n325:         return members;\n326:     }\n327: \n328:     /**\n329:      * @param d the diagram\n330:      */\n331:     private void addDiagramMember(ArgoDiagram d) {\n332:         ProjectMember pm = new ProjectMemberDiagram(d, this);\n333:         addDiagram(d);\n334:         // if diagram added successfully, add the member too\n335:         members.add(pm);\n336:     }\n337: \n338:     /**\n339:      * @param pm the member to be added\n340:      */\n341:     private void addTodoMember(ProjectMemberTodoList pm) {\n342:         // Adding a todo member removes any existing one.\n343:         members.add(pm);\n344:         LOG.info(\"Added todo member, there are now \" + members.size());\n345:     }\n346: \n347:     /**\n348:      * @param m the member to be added\n349:      */\n350:     public void addMember(Object m) {\n351: \n352:         if (m == null) {\n353:             throw new IllegalArgumentException(\n354:                     \"A model member must be suppleid\");\n355:         } else if (m instanceof ArgoDiagram) {\n356:             LOG.info(\"Adding diagram member\");\n357:             addDiagramMember((ArgoDiagram) m);\n358:         } else if (m instanceof ProjectMemberTodoList) {\n359:             LOG.info(\"Adding todo member\");\n360:             addTodoMember((ProjectMemberTodoList) m);\n361:         } else if (Model.getFacade().isAModel(m)) {\n362:             LOG.info(\"Adding model member\");\n363:             addModelMember(m);\n364:         } else {\n365:             throw new IllegalArgumentException(\n366:                     \"The member must be a UML model todo member or diagram.\"\n367:                     + \"It is \" + m.getClass().getName());\n368:         }\n369:         LOG.info(\"There are now \" + members.size() + \" members\");\n370:     }\n371: \n372:     /**\n373:      * @param m the model\n374:      */\n375:     private void addModelMember(Object m) {\n376: \n377:         boolean memberFound = false;\n378:         Object currentMember =\n379:             members.getMember(ProjectMemberModel.class);\n380:         if (currentMember != null) {\n381:             Object currentModel =\n382:                 ((ProjectMemberModel) currentMember).getModel();\n383:             if (currentModel == m) {\n384:                 memberFound = true;\n385:             }\n386:         }\n387: \n388:         if (!memberFound) {\n389:             if (!models.contains(m)) {\n390:                 addModel(m);\n391:             }\n392:             // got past the veto, add the member\n393:             ProjectMember pm = new ProjectMemberModel(m, this);\n394:             LOG.info(\"Adding model member to start of member list\");\n395:             members.add(pm);\n396:         } else {\n397:             LOG.info(\"Attempted to load 2 models\");\n398:             throw new IllegalArgumentException(\n399:                     \"Attempted to load 2 models\");\n400:         }\n401:     }\n402: \n403:     /**\n404:      * @param model a namespace\n405:      */\n406:     public void addModel(Object model) {\n407: \n408:         if (!Model.getFacade().isANamespace(model)) {\n409:             throw new IllegalArgumentException();\n410: \t}\n411: \n412:         // fire indeterminate change to avoid copying vector\n413:         if (!models.contains(model)) {\n414:             models.addElement(model);\n415:         }\n416:         setCurrentNamespace(model);\n417:         ProjectManager.getManager().setSaveEnabled(true);\n418:     }\n419: \n420:     /**\n421:      * Removes a project member diagram completely from the project.\n422:      * @param d the ArgoDiagram\n423:      */\n424:     protected void removeProjectMemberDiagram(ArgoDiagram d) {\n425:         if (activeDiagram == d) {\n426:             ArgoDiagram defaultDiagram;\n427:             if (diagrams.size() == 1) {\n428:                 // We're deleting the last diagram so lets create a new one\n429:                 // TODO: Once we go MDI we won't need this.\n430:                 Object treeRoot = \n431:                     Model.getModelManagementFactory().getRootModel();\n432:                 defaultDiagram =\n433:                     DiagramFactory.getInstance()\n434:                         .createDiagram(UMLClassDiagram.class, treeRoot, null);\n435:                 addMember(defaultDiagram);\n436:             } else {\n437:                 // Make the topmost diagram (that is not the one being deleted)\n438:                 // current.\n439:                 defaultDiagram = (ArgoDiagram) diagrams.get(0);\n440:                 if (defaultDiagram == d) {\n441:                     defaultDiagram = (ArgoDiagram) diagrams.get(1);\n442:                 }\n443:             }\n444:             activeDiagram = defaultDiagram;\n445:             TargetManager.getInstance().setTarget(defaultDiagram);\n446:         }\n447: \n448:         removeDiagram(d);\n449:         members.remove(d);\n450:         d.remove();\n451:         ProjectManager.getManager().setSaveEnabled(true);\n452:     }\n453: \n454: \n455:     /**\n456:      * Get the author name.\n457:      *\n458:      * @return The author name.\n459:      */\n460:     public String getAuthorname() {\n461:         return authorname;\n462:     }\n463: \n464:     /**\n465:      * Set the author name.\n466:      *\n467:      * @param s The new author name.\n468:      */\n469:     public void setAuthorname(String s) {\n470:         authorname = s;\n471:     }\n472: \n473:     /**\n474:      * Get the author name.\n475:      *\n476:      * @return The author name.\n477:      */\n478:     public String getAuthoremail() {\n479:         return authoremail;\n480:     }\n481: \n482:     /**\n483:      * Set the author name.\n484:      *\n485:      * @param s The new author name.\n486:      */\n487:     public void setAuthoremail(String s) {\n488:         authoremail = s;\n489:     }\n490: \n491:     /**\n492:      * Get the version.\n493:      *\n494:      * @return the version.\n495:      */\n496:     public String getVersion() {\n497:         return version;\n498:     }\n499: \n500:     /**\n501:      * Set the new version.\n502:      * @param s The new version.\n503:      */\n504:     public void setVersion(String s) {\n505:         version = s;\n506:     }\n507: \n508:     /**\n509:      * Get the description.\n510:      *\n511:      * @return the description.\n512:      */\n513:     public String getDescription() {\n514:         return description;\n515:     }\n516: \n517:     /**\n518:      * Set a new description.\n519:      *\n520:      * @param s The new description.\n521:      */\n522:     public void setDescription(String s) {\n523:         description = s;\n524:     }\n525: \n526:     /**\n527:      * Get the history file.\n528:      *\n529:      * @return The history file.\n530:      */\n531:     public String getHistoryFile() {\n532:         return historyFile;\n533:     }\n534: \n535:     /**\n536:      * Set the history file.\n537:      *\n538:      * @param s The new history file.\n539:      */\n540:     public void setHistoryFile(String s) {\n541:         historyFile = s;\n542:     }\n543: \n544:     /**\n545:      * Returns all models defined by the user. I.e. this does not return the\n546:      * default model but all other models.\n547:      *\n548:      * @return A Vector of all user defined models.\n549:      */\n550:     public Vector getUserDefinedModels() {\n551:         return models;\n552:     }\n553: \n554:     /**\n555:      * Returns all models, including the default model (default.xmi).\n556:      *\n557:      * @return A Collection containing all models.\n558:      */\n559:     public Collection getModels() {\n560:         Set ret = new HashSet();\n561:         ret.addAll(models);\n562:         ret.add(defaultModel);\n563:         return ret;\n564:     }\n565: \n566:     /**\n567:      * Return the model.<p>\n568:      *\n569:      * If there isn't exactly one model, <code>null</code> is returned.\n570:      *\n571:      * @return the model.\n572:      */\n573:     public Object getModel() {\n574:         if (models.size() != 1) {\n575:             return null;\n576:         }\n577:         return models.elementAt(0);\n578:     }\n579: \n580:     /**\n581:      * Searches for a type/classifier with name s. If the type is not found,\n582:      * a new type is created and added to the current namespace.\n583:      * @param s the name of the type/classifier to be found\n584:      * @return MClassifier\n585:      */\n586:     public Object findType(String s) {\n587:         return findType(s, true);\n588:     }\n589: \n590:     /**\n591:      * Searches for a type/classifier with name s. If defineNew is\n592:      * true, a new type is defined if the type/classifier is not\n593:      * found. The newly created type is added to the currentNamespace\n594:      * and given the name s.\n595:      * @param s the name of the type/classifier to be found\n596:      * @param defineNew if true, define a new one\n597:      * @return MClassifier the found classifier\n598:      */\n599:     public Object findType(String s, boolean defineNew) {\n600:         if (s != null) {\n601:             s = s.trim();\n602:         }\n603:         if (s == null || s.length() == 0) {\n604:             return null;\n605:         }\n606:         Object cls = null;\n607:         int numModels = models.size();\n608:         for (int i = 0; i < numModels; i++) {\n609:             cls = findTypeInModel(s, models.elementAt(i));\n610:             if (cls != null) {\n611:                 return cls;\n612:             }\n613:         }\n614:         cls = findTypeInModel(s, defaultModel);\n615:         // hey, now we should move it to the model the user is working in\n616:         if (cls != null) {\n617:             cls =\n618:                 Model.getModelManagementHelper()\n619:                 \t.getCorrespondingElement(cls, getRoot());\n620:         }\n621:         if (cls == null && defineNew) {\n622:             LOG.debug(\"new Type defined!\");\n623:             cls =\n624:                 Model.getCoreFactory().buildClass(getCurrentNamespace());\n625:             Model.getCoreHelper().setName(cls, s);\n626:         }\n627:         return cls;\n628:     }\n629: \n630:     /**\n631:      * Finds all figs on the diagrams for some project member,\n632:      * including the figs containing the member (so for some\n633:      * operation, the containing figclass is returned).\n634:      *\n635:      * @param member The member we are looking for.\n636:      *              This can be a model element object but also another object.\n637:      * @return Collection The collection with the figs.\n638:      */\n639:     public Collection findFigsForMember(Object member) {\n640:         Collection figs = new ArrayList();\n641:         Iterator it = diagrams.iterator();\n642:         while (it.hasNext()) {\n643:             ArgoDiagram diagram = (ArgoDiagram) it.next();\n644:             Object fig = diagram.getContainingFig(member);\n645:             if (fig != null) {\n646:                 figs.add(fig);\n647:             }\n648:         }\n649:         return figs;\n650:     }\n651: \n652:     /**\n653:      * Returns a list with all figs for some UML object on all diagrams.\n654:      *\n655:      * @param obj the given UML object\n656:      * @return List the list of figs\n657:      */\n658:     public Collection findAllPresentationsFor(Object obj) {\n659:         Collection figs = new ArrayList();\n660:         Iterator it = diagrams.iterator();\n661:         while (it.hasNext()) {\n662:             Diagram diagram = (Diagram) it.next();\n663:             Fig aFig = diagram.presentationFor(obj);\n664:             if (aFig != null) {\n665:                 figs.add(aFig);\n666:             }\n667:         }\n668:         return figs;\n669:     }\n670: \n671:     /**\n672:      * Finds a classifier with a certain name.<p>\n673:      *\n674:      * Will only return first classifier with the matching name.\n675:      *\n676:      * @param s is short name.\n677:      * @param ns Namespace where we do the search.\n678:      * @return the found classifier (or <code>null</code> if not found).\n679:      */\n680:     public Object findTypeInModel(String s, Object ns) {\n681: \n682:         if (!Model.getFacade().isANamespace(ns)) {\n683:             throw new IllegalArgumentException(\n684:                     \"Looking for the classifier \" + s\n685:                     + \" in a non-namespace object of \" + ns\n686:                     + \". A namespace was expected.\");\n687:     \t}\n688: \n689:         Collection allClassifiers =\n690:             Model.getModelManagementHelper()\n691: \t        .getAllModelElementsOfKind(ns,\n692: \t                Model.getMetaTypes().getClassifier());\n693: \n694:         Object[] classifiers = allClassifiers.toArray();\n695:         Object classifier = null;\n696: \n697:         for (int i = 0; i < classifiers.length; i++) {\n698: \n699:             classifier = classifiers[i];\n700:             if (Model.getFacade().getName(classifier) != null\n701:             \t\t&& Model.getFacade().getName(classifier).equals(s)) {\n702:                 return classifier;\n703:             }\n704:         }\n705: \n706:         return null;\n707:     }\n708: \n709:     /**\n710:      * @param m the namespace\n711:      */\n712:     public void setCurrentNamespace(Object m) {\n713: \n714:         if (m != null && !Model.getFacade().isANamespace(m)) {\n715:             throw new IllegalArgumentException();\n716:     \t}\n717: \n718:         currentNamespace = m;\n719:     }\n720: \n721:     /**\n722:      * @return the namespace\n723:      */\n724:     public Object getCurrentNamespace() {\n725:         return currentNamespace;\n726:     }\n727: \n728:     /**\n729:      * @return the diagrams\n730:      */\n731:     public Vector getDiagrams() {\n732:         return diagrams;\n733:     }\n734: \n735:     /**\n736:      * Get the number of diagrams in this project.\n737:      * Used by argo2.tee!!\n738:      * @return the number of diagrams in this project.\n739:      */\n740:     public int getDiagramCount() {\n741:         return diagrams.size();\n742:     }\n743: \n744:     /**\n745:      * Finds a diagram with a specific name or UID.\n746:      *\n747:      * @return the diagram object (if found). Otherwize null.\n748:      * @param name is the name to search for.\n749:      */\n750:     public ArgoDiagram getDiagram(String name) {\n751:         Iterator it = diagrams.iterator();\n752:         while (it.hasNext()) {\n753:             ArgoDiagram ad = (ArgoDiagram) it.next();\n754:             if (ad.getName() != null && ad.getName().equals(name)) {\n755:                 return ad;\n756:             }\n757:             if (ad.getItemUID() != null\n758:                     && ad.getItemUID().toString().equals(name)) {\n759:                 return ad;\n760:             }\n761:         }\n762:         return null;\n763:     }\n764: \n765:     /**\n766:      * @param d the diagram to be added\n767:      */\n768:     public void addDiagram(ArgoDiagram d) {\n769:         // send indeterminate new value instead of making copy of vector\n770:         diagrams.addElement(d);\n771:         d.addVetoableChangeListener(new Vcl());\n772:         ProjectManager.getManager().setSaveEnabled(true);\n773:     }\n774: \n775:     /**\n776:      * Removes a diagram from the list with diagrams.\n777:      *\n778:      * Removes (hopefully) the event listeners for this diagram.  Does\n779:      * not remove the diagram from the project members. This should\n780:      * not be called directly. Use moveToTrash if you want to remove a\n781:      * diagram.\n782:      *\n783:      * @param d the ArgoDiagram\n784:      */\n785:     protected void removeDiagram(ArgoDiagram d) {\n786:         d.removeVetoableChangeListener(new Vcl());\n787:         diagrams.removeElement(d);\n788:         if (d instanceof UMLDiagram) {\n789:             /* If this is a UML diagram, then remove the dependent\n790:              * modelelements, such as the statemachine\n791:              * for a statechartdiagram.\n792:              */\n793:             Object o = ((UMLDiagram) d).getDependentElement();\n794:             if (o != null) {\n795:                 moveToTrash(o);\n796:             }\n797:         }\n798:     }\n799: \n800:     /**\n801:      * Listener to events from the Diagram class. <p>\n802:      *\n803:      * Purpose: changing the name of a diagram shall set the need save flag.\n804:      *\n805:      * @author mvw@tigris.org\n806:      */\n807:     private static class Vcl implements VetoableChangeListener {\n808:         /**\n809:          * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n810:          */\n811:         public void vetoableChange(PropertyChangeEvent evt)\n812:             throws PropertyVetoException {\n813:             if (evt.getPropertyName().equals(\"name\")) {\n814:                 ProjectManager.getManager().setSaveEnabled(true);\n815:             }\n816:         }\n817:     }\n818: \n819:     /**\n820:      * @param me the given modelelement\n821:      * @return the total number of presentation\n822:      *         for the given modelelement in the project\n823:      */\n824:     public int getPresentationCountFor(Object me) {\n825: \n826:         if (!Model.getFacade().isAModelElement(me)) {\n827:             throw new IllegalArgumentException();\n828:     \t}\n829: \n830:         int presentations = 0;\n831:         int size = diagrams.size();\n832:         for (int i = 0; i < size; i++) {\n833:             Diagram d = (Diagram) diagrams.elementAt(i);\n834:             presentations += d.getLayer().presentationCountFor(me);\n835:         }\n836:         return presentations;\n837:     }\n838: \n839:     /**\n840:      * @return an initial target, in casu a diagram or a model\n841:      */\n842:     public Object getInitialTarget() {\n843:         if (diagrams.size() > 0) {\n844:             return diagrams.elementAt(0);\n845:         }\n846:         if (models.size() > 0) {\n847:             return models.elementAt(0);\n848:         }\n849:         return null;\n850:     }\n851: \n852: \n853:     /**\n854:      * @param cgp the generation preferences\n855:      */\n856:     public void setGenerationPrefs(GenerationPreferences cgp) {\n857:         cgPrefs = cgp;\n858:     }\n859: \n860:     /**\n861:      * @return the generation preferences\n862:      */\n863:     public GenerationPreferences getGenerationPrefs() {\n864:         return cgPrefs;\n865:     }\n866: \n867:     ////////////////////////////////////////////////////////////////\n868:     // event handling\n869: \n870:     /**\n871:      * @return the VetoableChangeSupport\n872:      */\n873:     public VetoableChangeSupport getVetoSupport() {\n874:         if (vetoSupport == null) {\n875:             vetoSupport = new VetoableChangeSupport(this);\n876:         }\n877:         return vetoSupport;\n878:     }\n879: \n880:     /**\n881:      * This is executed before a save.\n882:      */\n883:     public void preSave() {\n884:         for (int i = 0; i < diagrams.size(); i++) {\n885:             ((Diagram) diagrams.elementAt(i)).preSave();\n886:         }\n887:         // TODO: is preSave needed for models?\n888:     }\n889: \n890:     /**\n891:      * This is execcuted after a save.\n892:      */\n893:     public void postSave() {\n894:         for (int i = 0; i < diagrams.size(); i++) {\n895:             ((Diagram) diagrams.elementAt(i)).postSave();\n896:         }\n897:         // TODO: is postSave needed for models?\n898:         ProjectManager.getManager().setSaveEnabled(true);\n899:     }\n900: \n901:     /**\n902:      * This is executed after a load.\n903:      */\n904:     public void postLoad() {\n905:         for (int i = 0; i < diagrams.size(); i++) {\n906:             ((Diagram) diagrams.elementAt(i)).postLoad();\n907:         }\n908:         // issue 1725: the root is not set, which leads to problems\n909:         // with displaying prop panels\n910:         Object model = getModel();\n911: \n912:         LOG.info(\"Setting root model to \" + model);\n913: \n914:         setRoot(model);\n915: \n916:         ProjectManager.getManager().setSaveEnabled(true);\n917:         // we don't need this HashMap anymore so free up the memory\n918:         uuidRefs = null;\n919:     }\n920: \n921:     ////////////////////////////////////////////////////////////////\n922:     // trash related methods\n923: \n924:     /**\n925:      * Moves some object to trash, i.e. deletes it completely with all\n926:      * dependent structures. <p>\n927:      *\n928:      * Deleting an object involves: <pre>\n929:      * - Removing Target history\n930:      * - Deleting all Fig representations for the object\n931:      * - Deleting the UML element\n932:      * - Deleting all dependent UML modelelements\n933:      * - Deleting CommentEdges (which are not UML elements)\n934:      * - Move to trash for enclosed objects, i.e. graphically drawn on top of\n935:      * - Move to trash subdiagrams for the object\n936:      * - Saveguard that there is always at least 1 diagram left\n937:      * - If the current diagram has been deleted, select a new one to show\n938:      * - Trigger the explorer when a diagram is deleted\n939:      * - Set the needsSave (dirty) flag of the projectmanager\n940:      * </pre>\n941:      *\n942:      * @param obj The object to be deleted\n943:      * @see org.argouml.kernel.Project#trashInternal(Object)\n944:      */\n945:     public void moveToTrash(Object obj) {\n946:         if (trashcan.contains(obj)) {\n947:             return;\n948:         }\n949:         trashInternal(obj);\n950:     }\n951: \n952:     /**\n953:      * Removes some object from the project.\n954:      *\n955:      * @param obj the object to be thrown away\n956:      */\n957:     protected void trashInternal(Object obj) {\n958:         if (Model.getFacade().isAModel(obj)) {\n959:             return; //Can not delete the model\n960:         }\n961: \n962:         if (obj != null) {\n963:             trashcan.add(obj);\n964:         }\n965:         if (Model.getFacade().isAModelElement(obj)) {\n966: \n967:             Model.getUmlFactory().delete(obj);\n968: \n969:             if (obj instanceof ProjectMember\n970:                     && members.contains(obj)) {\n971:                 // TODO: Bob says - can this condition ever be reached?\n972:                 // Surely obj cannot be both a model element (previous if) and\n973:                 // a ProjectMember (this if)\n974:                 members.remove(obj);\n975:             }\n976: \n977:             // TODO: Presumably this is only relevant if \n978:             // obj is actually a Model.\n979:             // An added test of Model.getFacade.isAModel(obj) would clarify what\n980:             // is going on here.\n981:             if (models.contains(obj)) {\n982:                 models.remove(obj);\n983:             }\n984:         } else if (obj instanceof ArgoDiagram) {\n985:             TargetManager.getInstance().removeTarget(obj);\n986:             TargetManager.getInstance().removeHistoryElement(obj);\n987:             removeProjectMemberDiagram((ArgoDiagram) obj);\n988:             // only need to manually delete diagrams because they\n989:             // don't have a decent event system set up.\n990:             ExplorerEventAdaptor.getInstance().modelElementRemoved(obj);\n991:         } else if (obj instanceof Fig) {\n992:             TargetManager.getInstance().removeTarget(obj);\n993:             TargetManager.getInstance().removeHistoryElement(obj);\n994:             ((Fig) obj).deleteFromModel();\n995:             // TODO: Bob says - I've never seen this appear in the log.\n996:             // I believe this code is never reached. If we delete a FigEdge\n997:             // or FigNode we actually call this method with the owner not\n998:             // the Fig itself.\n999:             // For Figs with no owner (primitives like circle etc) then they\n1000:             // are not deleted (crtl-Del) they are removed (Del)\n1001:             LOG.error(\"Request to delete a Fig \" + obj.getClass().getName());\n1002:         } else if (obj instanceof CommentEdge) {\n1003:             TargetManager.getInstance().removeTarget(obj);\n1004:             TargetManager.getInstance().removeHistoryElement(obj);\n1005:             CommentEdge ce = (CommentEdge) obj;\n1006:             LOG.info(\"Removing the link from \" + ce.getAnnotatedElement() \n1007:                     + \" to \" + ce.getComment());\n1008:             Model.getCoreHelper().removeAnnotatedElement(\n1009:                     ce.getComment(), ce.getAnnotatedElement());\n1010:         }\n1011:     }\n1012: \n1013:     /**\n1014:      * @param obj the object\n1015:      * @return true if the object is trashed\n1016:      */\n1017:     public boolean isInTrash(Object obj) {\n1018:         return trashcan.contains(obj);\n1019:     }\n1020: \n1021:     /**\n1022:      * @param theDefaultModel a uml model\n1023:      */\n1024:     public void setDefaultModel(Object theDefaultModel) {\n1025: \n1026:         if (!Model.getFacade().isAModel(theDefaultModel)) {\n1027:             throw new IllegalArgumentException(\n1028:                     \"The default model must be a Model type. Received a \"\n1029:                     + theDefaultModel.getClass().getName());\n1030:         }\n1031: \n1032:         defaultModel = theDefaultModel;\n1033:         defaultModelTypeCache = new HashMap();\n1034:     }\n1035: \n1036:     /**\n1037:      * Get the default model.\n1038:      *\n1039:      * @return A model.\n1040:      */\n1041:     public Object getDefaultModel() {\n1042:         return defaultModel;\n1043:     }\n1044: \n1045:     /**\n1046:      * Find a type by name in the default model.\n1047:      *\n1048:      * @param name the name.\n1049:      * @return the type.\n1050:      */\n1051:     public Object findTypeInDefaultModel(String name) {\n1052:         if (defaultModelTypeCache.containsKey(name)) {\n1053:             return defaultModelTypeCache.get(name);\n1054:         }\n1055: \n1056:         Object result = findTypeInModel(name, getDefaultModel());\n1057:         defaultModelTypeCache.put(name, result);\n1058:         return result;\n1059:     }\n1060: \n1061:     /**\n1062:      * Returns the root.\n1063:      * @return MModel\n1064:      */\n1065:     public Object getRoot() {\n1066:         return Model.getModelManagementFactory().getRootModel();\n1067:     }\n1068: \n1069:     /**\n1070:      * Sets the root.\n1071:      * @param root The root to set, a uml model\n1072:      */\n1073:     public void setRoot(Object root) {\n1074: \n1075:         if (!Model.getFacade().isAModel(root)) {\n1076:             throw new IllegalArgumentException();\n1077:         }\n1078: \n1079:         Object treeRoot = Model.getModelManagementFactory().getRootModel();\n1080:         if (treeRoot != null) {\n1081:             models.remove(treeRoot);\n1082:         }\n1083:         Model.getModelManagementFactory().setRootModel(root);\n1084:         addModel(root);\n1085:     }\n1086: \n1087:     /**\n1088:      * Returns true if the given name is a valid name for a diagram. Valid means\n1089:      * that it does not occur as a name for a diagram yet.\n1090:      * @param name The name to test\n1091:      * @return boolean True if there are no problems with this name, false if\n1092:      * it's not valid.\n1093:      */\n1094:     public boolean isValidDiagramName(String name) {\n1095:         Iterator it = diagrams.iterator();\n1096:         boolean rv = true;\n1097:         while (it.hasNext()) {\n1098:             ArgoDiagram diagram = (ArgoDiagram) it.next();\n1099:             if (diagram.getName().equals(name)) {\n1100:                 rv = false;\n1101:                 break;\n1102:             }\n1103:         }\n1104:         return rv;\n1105:     }\n1106: \n1107:     /**\n1108:      * Returns the cgPrefs.\n1109:      *\n1110:      * @deprecated use getGenerationPrefs() instead\n1111:      * @return GenerationPreferences\n1112:      */\n1113:     public GenerationPreferences getCgPrefs() {\n1114:         return cgPrefs;\n1115:     }\n1116: \n1117:     /**\n1118:      * Returns the searchpath.\n1119:      * @return Vector\n1120:      */\n1121:     public Vector getSearchpath() {\n1122:         return searchpath;\n1123:     }\n1124: \n1125:     /**\n1126:      * Returns the url.\n1127:      * @return URL\n1128:      */\n1129:     public URL getUrl() {\n1130:         return projectUri;\n1131:     }\n1132: \n1133:     /**\n1134:      * Returns the uUIDRefs.\n1135:      * @return HashMap\n1136:      */\n1137:     public HashMap getUUIDRefs() {\n1138:         return uuidRefs;\n1139:     }\n1140: \n1141:     /**\n1142:      * Sets the cgPrefs.\n1143:      * @deprecated use setGenerationPrefs() instead\n1144:      * @param theCgPrefs The cgPrefs to set\n1145:      */\n1146:     public void setCgPrefs(GenerationPreferences theCgPrefs) {\n1147:         this.cgPrefs = theCgPrefs;\n1148:     }\n1149: \n1150:     /**\n1151:      * Sets the searchpath.\n1152:      * @param theSearchpath The searchpath to set\n1153:      */\n1154:     public void setSearchpath(Vector theSearchpath) {\n1155:         this.searchpath = theSearchpath;\n1156:     }\n1157: \n1158:     /**\n1159:      * Sets the url.\n1160:      * @param theUrl The url to set\n1161:      */\n1162:     public void setUrl(URL theUrl) {\n1163:         projectUri = theUrl;\n1164:     }\n1165: \n1166:     /**\n1167:      * Sets the uUIDRefs.\n1168:      * @param uUIDRefs The uUIDRefs to set\n1169:      */\n1170:     public void setUUIDRefs(HashMap uUIDRefs) {\n1171:         uuidRefs = uUIDRefs;\n1172:     }\n1173: \n1174:     /**\n1175:      * Sets the vetoSupport.\n1176:      * @param theVetoSupport The vetoSupport to set\n1177:      */\n1178:     public void setVetoSupport(VetoableChangeSupport theVetoSupport) {\n1179:         this.vetoSupport = theVetoSupport;\n1180:     }\n1181: \n1182:     /**\n1183:      * Get the current viewed diagram.\n1184:      *\n1185:      * @return the current viewed diagram\n1186:      */\n1187:     public ArgoDiagram getActiveDiagram() {\n1188:         return activeDiagram;\n1189:     }\n1190: \n1191:     /**\n1192:      * @param theDiagram the ArgoDiagram\n1193:      */\n1194:     public void setActiveDiagram(ArgoDiagram theDiagram) {\n1195:         activeDiagram = theDiagram;\n1196:     }\n1197: \n1198:     /**\n1199:      * @see TargetListener#targetAdded(TargetEvent)\n1200:      */\n1201:     public void targetAdded(TargetEvent e) {\n1202:     \tsetTarget(e.getNewTarget());\n1203:     }\n1204: \n1205:     /**\n1206:      * @see TargetListener#targetRemoved(TargetEvent)\n1207:      */\n1208:     public void targetRemoved(TargetEvent e) {\n1209:     \tsetTarget(e.getNewTarget());\n1210:     }\n1211: \n1212:     /**\n1213:      * @see TargetListener#targetSet(TargetEvent)\n1214:      */\n1215:     public void targetSet(TargetEvent e) {\n1216:     \tsetTarget(e.getNewTarget());\n1217:     }\n1218: \n1219:     /**\n1220:      * Called to update the current namespace and active diagram after\n1221:      * the target has changed.\n1222:      *\n1223:      * TODO: The parameter is not used. Why?\n1224:      * @param target Not used.\n1225:      */\n1226:     private void setTarget(Object target) {\n1227:         Object theCurrentNamespace = null;\n1228:         target = TargetManager.getInstance().getModelTarget();\n1229:         if (target instanceof UMLDiagram) {\n1230:             theCurrentNamespace = ((UMLDiagram) target).getNamespace();\n1231:         } else if (Model.getFacade().isANamespace(target)) {\n1232:             theCurrentNamespace = target;\n1233:         } else if (Model.getFacade().isAModelElement(target)) {\n1234:             theCurrentNamespace = Model.getFacade().getNamespace(target);\n1235:         } else {\n1236:             theCurrentNamespace = getRoot();\n1237:         }\n1238:         setCurrentNamespace(theCurrentNamespace);\n1239: \n1240:         if (target instanceof ArgoDiagram) {\n1241:             activeDiagram = (ArgoDiagram) target;\n1242:         }\n1243:     }\n1244: \n1245:     /**\n1246:      * Remove the project.\n1247:      */\n1248:     public void remove() {\n1249: \n1250:         if (diagrams != null) {\n1251:             for (Iterator it = diagrams.iterator(); it.hasNext();) {\n1252:                 Diagram diagram = (Diagram) it.next();\n1253:                 diagram.remove();\n1254:             }\n1255:         }\n1256:         \n1257:         if (members != null) {\n1258:             members.clear();\n1259:         }\n1260: \n1261:         if (models != null) {\n1262:             for (Iterator it = models.iterator(); it.hasNext();) {\n1263:                 Object model = it.next();\n1264:                 LOG.debug(\"Deleting project model \" \n1265:                         + Model.getFacade().getName(model));\n1266:                 Model.getUmlFactory().delete(model);\n1267:             }\n1268:             models.clear();\n1269:         }\n1270:         \n1271:         if (defaultModel != null) {\n1272:             LOG.debug(\"Deleting profile model \" \n1273:                     + Model.getFacade().getName(defaultModel));\n1274:             Model.getUmlFactory().delete(defaultModel);\n1275:             defaultModel = null;\n1276:         }\n1277: \n1278:         if (diagrams != null) {\n1279:             diagrams.clear();\n1280:         }\n1281: \n1282:         if (uuidRefs != null) {\n1283:             uuidRefs.clear();\n1284:         }\n1285: \n1286:         if (defaultModelTypeCache != null) {\n1287:             defaultModelTypeCache.clear();\n1288:         }\n1289: \n1290:         members = null;\n1291:         models = null;\n1292:         diagrams = null;\n1293:         uuidRefs = null;\n1294:         defaultModelTypeCache = null;\n1295: \n1296:         projectUri = null;\n1297:         authorname = null;\n1298:         authoremail = null;\n1299:         description = null;\n1300:         version = null;\n1301:         searchpath = null;\n1302:         historyFile = null;\n1303:         defaultModel = null;\n1304:         currentNamespace = null;\n1305:         cgPrefs = null;\n1306:         vetoSupport = null;\n1307:         activeDiagram = null;\n1308: \n1309:         TargetManager.getInstance().removeTargetListener(this);\n1310:         trashcan.clear();\n1311:     }\n1312: \n1313:     /**\n1314:      * @return Returns the persistenceVersion.\n1315:      */\n1316:     public int getPersistenceVersion() {\n1317:         return persistenceVersion;\n1318:     }\n1319: \n1320:     /**\n1321:      * @param pv The persistenceVersion to set.\n1322:      */\n1323:     public void setPersistenceVersion(int pv) {\n1324:         persistenceVersion = pv;\n1325:     }\n1326: \n1327:     /**\n1328:      * @return Returns the profile.\n1329:      */\n1330:     public Profile getProfile() {\n1331:         return profile;\n1332:     }\n1333:     \n1334:     /**\n1335:      * Repair all parts of the project before a save takes place.\n1336:      * @return a report of any fixes\n1337:      */\n1338:     public String repair() {\n1339:         String report = \"\";\n1340:         Iterator it = members.iterator();\n1341:         while (it.hasNext()) {\n1342:             ProjectMember member = (ProjectMember) it.next();\n1343:             report += member.repair();\n1344:         }\n1345:         return report;\n1346:     }\n1347: \n1348:     /**\n1349:      * @return the settings of this project\n1350:      */\n1351:     public ProjectSettings getProjectSettings() {\n1352:         return projectSettings;\n1353:     }\n1354: \n1355: } /* end class Project */\n1356: ",
