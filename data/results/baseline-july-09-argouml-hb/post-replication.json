import java.util.HashMap;\n33: import java.util.Iterator;\n34: import java.util.Map;\n35: \n36: import javax.xml.parsers.DocumentBuilder;\n37: import javax.xml.parsers.DocumentBuilderFactory;\n38: import javax.xml.parsers.ParserConfigurationException;\n39: \n40: import org.apache.log4j.Logger;\n41: import org.argouml.model.ModelFacade;\n42: import org.argouml.model.uml.modelmanagement.ModelManagementHelper;\n43: import org.w3c.dom.Document;\n44: import org.w3c.dom.Element;\n45: import org.w3c.dom.NodeList;\n46: import org.xml.sax.SAXException;\n47: \n48: import ru.novosoft.uml.MBase;\n49: import ru.novosoft.uml.MElementEvent;\n50: import ru.novosoft.uml.MElementListener;\n51: import ru.novosoft.uml.MFactoryImpl;\n52: \n53: \n54: /**\n55:  * This class implements an event pump for all modelevents (MEvents\n56:  * with the current NSUML model). Two kinds of listeners can be\n57:  * registred to the pump: listeners to class events and listeners to\n58:  * object events. The pump dispatches all events fired by objects of a\n59:  * certain class to the class listeners (listeners that are registred\n60:  * via addClassModelEventListener). Furthermore, it dispatches all\n61:  * events to listeners that are registered for a certain object if\n62:  * this object fired the original event.<p>\n63:  *\n64:  * Maybe this class should dispatch a thread to handle the incoming\n65:  * event in the future.\n66:  * @since Oct 14, 2002\n67:  * @author jaap.branderhorst@xs4all.nl\n68:  * @deprecated by Linus Tolke as of 0.17.1. This class is part of the \n69:  *             NSUML-dependant API of the model component. Use the NSUML-free \n70:  *             {@link org.argouml.model.Model#getPump()} and the\n71:  *             {@link org.argouml.model.ModelEventPump} interface.\n72:  */\n73: public final class UmlModelEventPump implements MElementListener {\n74: \n75:     /** The Logger */\n76:     private static final Logger LOG = \n77: \t    Logger.getLogger(UmlModelEventPump.class);\n78: \n79:     /**\n80:      * Indicate wether we pump events to listeners yes or no. \n81:      * There is some fault in the NSUML implementation\n82:      * but where...\n83:      */\n84:     private boolean pumping = true;\n85: \n86:     /**\n87:      * \"remove\"\n88:      */\n89:     public static final String REMOVE = \"remove\";\n90: \n91:     private static UmlModelEventPump theInstance = new UmlModelEventPump();\n92: \n93:     /**\n94:      * The 'map' with the eventlistenerlists per modelelement\n95:      */\n96:     private EventListenerHashMap listenerMap = new EventListenerHashMap();\n97: \n98:     private ClassListenerHashMap classListenerMap = new ClassListenerHashMap();\n99: \n100:     private EventTreeDefinition definition = new EventTreeDefinition();\n101: \n102:     /**\n103:      * Singleton access method\n104:      * @return UmlModelEventPump\n105:      */\n106:     public static synchronized UmlModelEventPump getPump() {\n107:         return theInstance;\n108:     }\n109: \n110:     /**\n111:      * Constructor for UmlModelEventPump, initialises the NSUML event policy.\n112:      */\n113:     private UmlModelEventPump() {\n114:         super();\n115:         // Initialize NSUML\n116: \tMFactoryImpl.setEventPolicy(MFactoryImpl.EVENT_POLICY_IMMEDIATE);\n117: \n118:     }\n119: \n120:     /**\n121:      * Adds a listener that listens to all modelevents that are named\n122:      * eventNames and that occur to instances of a given\n123:      * modelClass.<p>\n124:      *\n125:      * If you want the listener to be registred for remove events\n126:      * (that is: an instance of the class the listener is listening\n127:      * too is removed), then you have to register for the eventname\n128:      * \"remove\".<p>\n129:      *\n130:      * @param listener is the listener to add.\n131:      * @param metaType is the given model class\n132:      * @param eventNames is a array of strings with event names.\n133:      * @throws IllegalArgumentException if one of the arguments is null or if\n134:      * the modelClass is not a subclass of MBase.\n135:      * @throws IllegalStateException if the listener is allready registred\n136:      */\n137:     public void addClassModelEventListener(MElementListener listener,\n138: \t\t\t\t\t   Class metaType,\n139: \t\t\t\t\t   String[] eventNames) {\n140: //      We don't support non-NSUML modeleventlisteners yet, \n141: //      so we return without addition.\n142:         if (!MBase.class.isAssignableFrom(metaType))\n143:             return;\n144:         if (listener == null\n145:             || metaType == null\n146:             || eventNames == null           \n147:             || eventNames.length == 0)\n148:             throw new IllegalArgumentException(\"Tried to add illegal class\"\n149: \t\t\t\t\t       + \" modeleventlistener to \"\n150: \t\t\t\t\t       + \"possible null class\");\n151:         for (int i = 0; i < eventNames.length; i++) {\n152:             executeAddClassModelEventListener(\n153: \t\t\t\t\t      listener,\n154:                     metaType,\n155: \t\t\t\t\t      eventNames[i]);\n156:         }\n157:     }\n158: \n159:     /**\n160:      * Convinience method to add a listener that only listens to one specific \n161:      * event\n162:      * @param listener The listener to add\n163:      * @param modelClass The listener should listen to instances of this class\n164:      * @param eventName The name of the event the listener wants to listen \n165:      * too.\n166:      */\n167:     public void addClassModelEventListener(\n168: \t\t\t\t\t   MElementListener listener,\n169: \t\t\t\t\t   Class modelClass,\n170: \t\t\t\t\t   String eventName) {\n171:         // We don't support non-NSUML modeleventlisteners yet, \n172:         // so we return without addition.\n173:         if (!MBase.class.isAssignableFrom(modelClass)) \n174:             return;\n175:         if (listener == null\n176:             || modelClass == null\n177:             || eventName == null\n178:             || eventName.equals(\"\"))\n179:             throw new IllegalArgumentException();\n180:         executeAddClassModelEventListener(listener, modelClass, eventName);\n181:     }\n182: \n183:     /**\n184:      * Does the actual adding\n185:      * @param listener The listener to add\n186:      * @param modelClass The listener should listen to instances of this class\n187:      * @param eventName The name of the event the listener wants to listen \n188:      */\n189:     private synchronized void executeAddClassModelEventListener(\n190: \t    MElementListener listener,\n191: \t    Class modelClass,\n192: \t    String eventName) \n193:     {\n194:         // first register the listener for all elements allready in\n195:         // the model modelClass = formatClass(modelClass);\n196:         Collection col =\n197:             ModelManagementHelper.getHelper()\n198: \t        .getAllModelElementsOfKind(modelClass);\n199:         \n200:         if (col == Collections.EMPTY_LIST)\n201:             col = new ArrayList();\n202:         \n203:         /*\n204:         if (modelClass.isAssignableFrom(MModel.class)) {\n205:             Object root =\n206:                 ProjectManager.getManager().getCurrentProject().getRoot();\n207:             if (root != null)\n208:                 col.add(root);\n209:         }\n210:         */\n211:         modelClass = formatClass(modelClass);\n212:         EventKey[] keys = definition.getEventTypes(modelClass, eventName);\n213:         Iterator it = col.iterator();\n214:         while (it.hasNext()) {\n215:             MBase base = (MBase) it.next();\n216:             for (int i = 0; i < keys.length; i++) {\n217:                 listenerMap.put(base, keys[i], listener);\n218:             }\n219:         }\n220:         // add the class to the 'interested classes list' so the listener is \n221:         // added on creation of a modelelement\n222:         for (int i = 0; i < keys.length; i++) {\n223:             classListenerMap.put(modelClass, keys[i], listener);\n224:         }\n225:     }\n226:     /**\n227:      * Retrieves the  implementation class belonging to some given class. For \n228:      * example, retrieves ClassImpl.class if the input was Class.class or \n229:      * ClassImpl.class.\n230:      * @param inputClass An interface or implementation class from NSUML\n231:      * @return The implementation class from NSUML\n232:      */\n233:     private Class formatClass(Class inputClass) {\n234:         String name = inputClass.getName();\n235:         if (name.endsWith(\"Impl\"))\n236:             return inputClass;\n237:         else {\n238:             try {\n239:                 Class returnClass = Class.forName(name + \"Impl\");\n240:                 return returnClass;\n241:             } catch (ClassNotFoundException ignorable) {\n242:                 // cannot happen\n243:             }\n244:         }\n245:         return null;\n246: \n247:     }\n248: \n249:     /**\n250:      * Removes a listener that listens to all modelevents fired by instances of\n251:      * modelClass and that have the original name eventNames.\n252:      * @param listener The listener to remove\n253:      * @param modelClass The class the listener does not want to listen to \n254:      * instances anymore\n255:      * @param eventNames The eventnames the listener does not want to listen to\n256:      * anymore\n257:      */\n258:     public void removeClassModelEventListener(\n259: \t\t\t\t\t      MElementListener listener,\n260: \t\t\t\t\t      Class modelClass,\n261: \t\n262: \t\t\t\t\t      String[] eventNames) {\n263: //      we don't support eventlisteners other then NSUML ModelEventListener.\n264:         // to be forward compatible with other ModelEventListeners, \n265:         // we do not throw an exception but\n266:         // simply return.\n267:         if (!MBase.class.isAssignableFrom(modelClass))\n268:             // throw new IllegalArgumentException();\n269:             return;\n270:         if (listener == null\n271:             || modelClass == null\n272:             || eventNames == null\n273:             || eventNames.length == 0)\n274:             throw new IllegalArgumentException(\n275:                     \"Tried to remove invalid listener\");\t       \n276:         for (int i = 0; i < eventNames.length; i++) {\n277:             executeRemoveClassModelEventListener(\n278: \t\t\t\t\t\t listener,\n279: \t\t\t\t\t\t modelClass,\n280: \t\t\t\t\t\t eventNames[i]);\n281:         }\n282:     }\n283: \n284:     /**\n285:      * Convinience method to remove a listener that listens to events named \n286:      * eventName that are fired by instances of modelClass\n287:      * @param listener The listener to remove\n288:      * @param modelClass The class the listener does not want to listen to \n289:      * instances anymore\n290:      * @param eventName The eventname the listener does not want to listen to\n291:      * anymore\n292:      */\n293:     public void removeClassModelEventListener(\n294: \t\t\t\t\t      MElementListener listener,\n295: \t\t\t\t\t      Class modelClass,\n296: \t\t\t\t\t      String eventName) {\n297: //      we don't support eventlisteners other then NSUML ModelEventListener.\n298:         // to be forward compatible with other ModelEventListeners, \n299:         // we do not throw an exception but\n300:         // simply return.\n301:         if (!MBase.class.isAssignableFrom(modelClass))\n302:             // throw new IllegalArgumentException();\n303:             return;\n304:         if (listener == null\n305:             || modelClass == null\n306:             || eventName == null)\n307:             throw new IllegalArgumentException(\n308:                     \"Tried to remove invalid listener\");\t\n309:         executeRemoveClassModelEventListener(listener, modelClass, eventName);\n310:     }\n311: \n312:     /**\n313:      * Removes a listener that listens to all modelevents fired by instances of\n314:      * modelClass.\n315:      *\n316:      * @param listener The listener to remove\n317:      * @param modelClass The class the listener does not want to listen to \n318:      * instances anymore\n319:      */\n320:     public void removeClassModelEventListener(MElementListener listener,\n321: \t\t\t\t\t      Class modelClass) {\n322: //      we don't support eventlisteners other then NSUML ModelEventListener.\n323:         // to be forward compatible with other ModelEventListeners, \n324:         // we do not throw an exception but\n325:         // simply return.\n326:         if (!MBase.class.isAssignableFrom(modelClass))\n327:             // throw new IllegalArgumentException();\n328:             return;\n329:         if (listener == null\n330:             || modelClass == null)\n331:             throw new IllegalArgumentException(\"Tried to remove null listener \"\n332: \t\t\t\t\t       + \"from null class\");\n333:         executeRemoveClassModelEventListener(listener, modelClass, null);\n334:     }\n335: \n336:     /**\n337:      * Executes the removal of a listener to a class\n338:      * @param listener The listener to remove\n339:      * @param modelClass The class the listener does not want to listen to \n340:      * instances anymore\n341:      * @param eventName The eventname the listener does not want to listen to\n342:      * anymore\n343:      */\n344:     private synchronized void executeRemoveClassModelEventListener(\n345: \t    MElementListener listener,\n346: \t    Class modelClass,\n347: \t    String eventName)\n348:     {\n349:         // remove all registrations of this listener with all instances of \n350:         // modelClass       \n351:         //modelClass = formatClass(modelClass);\n352:         Iterator it =\n353:             ModelManagementHelper.getHelper()\n354: \t        .getAllModelElementsOfKind(modelClass)\n355: \t            .iterator();\n356:         while (it.hasNext()) {\n357:             MBase base = (MBase) it.next();\n358:             removeModelEventListener(listener, base, eventName);\n359:         }\n360:         // remove the listener from the registry\n361:         EventKey[] keys = definition.getEventTypes(modelClass, eventName);\n362:         for (int i = 0; i < keys.length; i++) {\n363:             classListenerMap.remove(modelClass, keys[i], listener);\n364:         }\n365:     }\n366: \n367:     /**\n368:      * Adds a listener to modelevents that are fired by some given modelelement \n369:      * and that have the name eventNames.\n370:      * <p>\n371:      * If you want the listener to be registred for remove events (that is: the\n372:      * instance the listener is listening too is removed), then you have to\n373:      * register for the eventname \"remove\"\n374:      * </p>\n375:      * @param listener The listener to add\n376:      * @param modelelement The modelelement the listener should be added too\n377:      * @param eventNames The array of eventnames the listener should listen \n378:      * to\n379:      */\n380:     public void addModelEventListener(\n381: \t\t\t\t      Object listener,\n382: \t\t\t\t      Object modelelement,\n383: \t\t\t\t      String[] eventNames) {\n384:         // we just return if the modelelement is not a base. \n385:         // we don't support non-nsuml elements yet.\n386:         if (modelelement == null || !ModelFacade.isABase(modelelement))\n387:             return;\n388:         if (listener == null\n389:             || eventNames == null\n390:             || eventNames.length == 0\n391:             || !(listener instanceof MElementListener)\n392:             || !(modelelement instanceof MBase))\n393:             throw new IllegalArgumentException(\"Wrong argument types while \"\n394: \t\t\t\t\t       + \"adding a modelelement \"\n395: \t\t\t\t\t       + \"listener\");\n396:         for (int i = 0; i < eventNames.length; i++) {\n397:             EventKey[] keys =\n398:                 definition.getEventTypes(\n399: \t\t\t\t\t  modelelement.getClass(),\n400: \t\t\t\t\t  eventNames[i]);\n401:             for (int j = 0; j < keys.length; j++) {\n402:                 listenerMap.remove(\n403: \t\t\t\t    (MBase) modelelement,\n404: \t\t\t\t    keys[j],\n405: \t\t\t\t    (MElementListener) listener);\n406:                 listenerMap.put(\n407: \t\t\t\t (MBase) modelelement,\n408: \t\t\t\t keys[j],\n409: \t\t\t\t (MElementListener) listener);\n410:             }\n411:         }\n412:     }\n413: \n414:     /**\n415:      * Convenience method to add a listener that only listens to one specific \n416:      * event.<p>\n417:      *\n418:      * @param listener The listener to add.\n419:      * @param modelelement The modelelement the listener should be added to.\n420:      * @param eventName The eventname the listener should listen to.\n421:      */\n422:     public void addModelEventListener(Object listener,\n423: \t\t\t\t      Object modelelement,\n424: \t\t\t\t      String eventName) {    \n425:         \n426: //      we just return if the modelelement to add is not a NSUML class. \n427:         // we don't support other event listeners yet.\n428:         if (modelelement == null || !ModelFacade.isABase(modelelement))\n429:             return;\n430:         if (listener == null          \n431:             || !(listener instanceof MElementListener)\n432:             || eventName == null)\n433:             throw new IllegalArgumentException();\n434:         EventKey[] keys =\n435:             definition.getEventTypes(modelelement.getClass(), eventName);\n436:         for (int i = 0; i < keys.length; i++) {\n437:             listenerMap.remove((MBase) modelelement,\n438: \t\t\t\tkeys[i],\n439: \t\t\t\t(MElementListener) listener);\n440:             listenerMap.put((MBase) modelelement,\n441: \t\t\t     keys[i],\n442: \t\t\t     (MElementListener) listener);\n443:         }\n444:     }\n445: \n446:     /**\n447:      * Adds a listener to all events fired by some modelelement.\n448:      *\n449:      * <em>Note:</em> Due to the fact that ALL events are pumped for\n450:      * some modelelement, this is a rather powerfull method but also\n451:      * one that can hog performance. Use this with care!</p>\n452:      *\n453:      * @param listener is the listener to add\n454:      * @param modelelement is the model element\n455:      */\n456:     public void addModelEventListener(Object listener, Object modelelement) {\n457:         // we just return if the modelelement to add is not a NSUML class. \n458:         // we don't support other event listeners yet.\n459:         if (modelelement == null || !ModelFacade.isABase(modelelement))\n460:             return;\n461:         if (listener == null\n462:             || modelelement == null\n463:             || !(listener instanceof MElementListener))\n464:             throw new IllegalArgumentException();\n465:         EventKey[] keys = definition.getEventTypes(modelelement.getClass());\n466:         for (int i = 0; i < keys.length; i++) {\n467:             listenerMap.remove(\n468: \t\t\t\t(MBase) modelelement,\n469: \t\t\t\tkeys[i],\n470: \t\t\t\t(MElementListener) listener);\n471:             listenerMap.put(\n472: \t\t\t     (MBase) modelelement,\n473: \t\t\t     keys[i],\n474: \t\t\t     (MElementListener) listener);\n475:         }\n476: \n477:     }\n478: \n479:     /**\n480:      * Removes a listener that listens to modelevents with name\n481:      * eventNames that are fired by the given modelelement.<p>\n482:      *\n483:      * @param listener The listener to remove\n484:      * @param handle The modelelement that fires the events the\n485:      * listener is listening to\n486:      * @param eventNames The list of event names the listener is\n487:      * interested in\n488:      */\n489:     public void removeModelEventListener(Object/*MElementListener*/ listener,\n490: \t\t\t\t\t Object handle,\n491: \t\t\t\t\t String[] eventNames) {\n492:         if (handle == null)\n493:             return;\n494:         // we don't support eventlisteners other then NSUML ModelEventListener.\n495:         // to be forward compatible with other ModelEventListeners, \n496:         // we do not throw an exception but\n497:         // simply return.\n498:         if (!(handle instanceof MBase))\n499:             // throw new IllegalArgumentException();\n500:             return;\n501:         MBase modelElement = (MBase) handle;\n502:         if (listener == null\n503:             || !(listener instanceof MElementListener)\n504:             || modelElement == null\n505:             || eventNames == null\n506:             || eventNames.length == 0)\n507:             throw new IllegalArgumentException();\n508:         for (int i = 0; i < eventNames.length; i++) {\n509:             EventKey[] keys =\n510:                 definition.getEventTypes(\n511: \t\t\t\t\t  modelElement.getClass(),\n512: \t\t\t\t\t  eventNames[i]);\n513:             for (int j = 0; j < keys.length; j++) {\n514:                 listenerMap.remove(modelElement,\n515: \t\t\t\t    keys[j],\n516: \t\t\t\t    (MElementListener) listener);\n517:             }\n518:         }\n519:     }\n520: \n521:     /**\n522:      * Removes a listener that listens to all events fired by the\n523:      * given modelelement.<p>\n524:      *\n525:      * @param listener is the listener\n526:      * @param handle is the model element\n527:      */\n528:     public void removeModelEventListener(Object/*MElementListener*/ listener,\n529: \t\t\t\t\t Object handle)\n530:     {\n531:         if (handle == null)\n532:             return;\n533:         // we don't support eventlisteners other then NSUML ModelEventListener.\n534:         // to be forward compatible with other ModelEventListeners, \n535:         // we do not throw an exception but\n536:         // simply return.\n537:         if (!(handle instanceof MBase))\n538:             // throw new IllegalArgumentException();\n539:             return;\n540: \n541: \tMBase modelElement = (MBase) handle;\n542:         if (listener == null\n543: \t    || modelElement == null\n544: \t    || !(listener instanceof MElementListener)) {\n545: \n546:             throw new IllegalArgumentException(\"listener is null or \"\n547: \t\t\t\t\t       + \"an illegal type\");\n548: \n549: \t}\n550:         EventKey[] keys = definition.getEventTypes(modelElement.getClass());\n551:         for (int i = 0; i < keys.length; i++) {\n552:             listenerMap.remove(\n553: \t\t\t\tmodelElement,\n554: \t\t\t\tkeys[i],\n555: \t\t\t\t(MElementListener) listener);\n556:         }\n557:     }\n558: \n559:     /**\n560:      * Convenience method to remove a listener to some event.<p>\n561:      *\n562:      * @param listener is the listener to remove\n563:      * @param handle is the object\n564:      * @param eventName is the name of the event\n565:      */\n566:     public void removeModelEventListener(Object/*MElementListener*/ listener,\n567: \t\t\t\t\t Object handle,\n568: \t\t\t\t\t String eventName)\n569:     {\n570:         if (handle == null)\n571:             return;\n572:         // we don't support eventlisteners other then NSUML ModelEventListener.\n573:         // to be forward compatible with other ModelEventListeners, \n574:         // we do not throw an exception but\n575:         // simply return.\n576:         if (!(handle instanceof MBase))\n577:             // throw new IllegalArgumentException();\n578:             return;\n579:         MBase modelElement = (MBase) handle;\n580:         if (listener == null\n581: \t    || modelElement == null\n582: \t    || eventName == null\n583: \t    || !(listener instanceof MElementListener)) {\n584: \n585:             throw new IllegalArgumentException(\"null listener or illegal type\");\n586: \t}\n587:         EventKey[] keys =\n588:             definition.getEventTypes(modelElement.getClass(), eventName);\n589:         for (int j = 0; j < keys.length; j++) {\n590:             listenerMap.remove(modelElement,\n591: \t\t\t\tkeys[j],\n592: \t\t\t\t(MElementListener) listener);\n593:         }\n594: \n595:     }\n596: \n597:     /**\n598:      * Method to remove some element from the listenerObjectMap. Used by\n599:      * delete on UmlFactory to make sure all listeners are removed.\n600:      * @param element\n601:      */\n602:     synchronized void cleanUp(MBase element) {\n603:         listenerMap.remove(element);\n604:     }\n605: \n606:     /**\n607:      * Make all event sources described by the given document\n608:      * available to the UMLModelEventPump. The document must match the\n609:      * pattern given by the following example:\n610:      * \n611:      * <pre>\n612:      * &lt;eventtree&gt;\n613:      *   &lt;source classname=\"classname of a model element\"&gt;\n614:      *     &lt;eventtype name=\"event fired by this model element\"&gt;\n615:      *       &lt;type&gt;1&lt;/type&gt;\n616:      *     &lt;/eventtype&gt;\n617:      *   &lt;/source&gt;\n618:      * &lt;/eventtree&gt;\n619:      * </pre>\n620:      *\n621:      * The classname is fully qualified.<p>\n622:      *\n623:      * The type is one of the numbers defined in {@link\n624:      * MElementEvent}. Each of the elements can be used multiple\n625:      * times.\n626:      * \n627:      * This operation is particularly provided for use by modules\n628:      * which add custom model elements.\n629:      * \n630:      * @param doc the document, the contents of which should be made available.\n631:      *            This must be preparsed.\n632:      */\n633:     public void addEventSourcesFromDocument (Document doc) {\n634:         definition.addSourcesFromDocument (doc);\n635:     }\n636: \n637:     /**\n638:      * <p>Make event types for a single event source available to this \n639:      * UMLModelEventPump.\n640:      * \n641:      * <p>This operation is particularly provided for use by modules which add \n642:      * custom model elements.\n643:      * \n644:      * @param cSource the source class for which to make event types available.\n645:      * \n646:      * @param mpNameMap a map of the event types to add for the source class.\n647:      *                  The keys are Strings indicating the names of events, \n648:      *                  while the values are int[] which contain all the event\n649:      *                  types the indicated event represents. The specific int \n650:      *                  values used can be found in {@link MElementEvent}.\n651:      */\n652:     public void addEventSource (Class cSource, Map mpNameMap) {\n653:         definition.addSource (cSource, mpNameMap);\n654:     }\n655: \n656:     /**\n657:      * @see MElementListener#listRoleItemSet(MElementEvent)\n658:      */\n659:     public void listRoleItemSet(MElementEvent e) {\n660:         MElementListener[] listeners = getListenerList(e);\n661:         for (int i = 0; i < listeners.length; i++) {\n662: \t    try {\n663: \t\tlisteners[i].listRoleItemSet(e);\n664: \t    } catch (Exception re) {\n665: \t\tLOG.error(\"Listener \" + listeners[i]\n666: \t\t\t  + \" threw an unhandled Exception\", re);\n667: \t    }\n668:         }\n669:     }\n670: \n671:     private MElementListener[] getListenerList(MElementEvent e) {\n672:         return listenerMap.getListeners(\n673: \t\t\t\t\t (MBase) e.getSource(),\n674: \t\t\t\t\t new EventKey(e.getType(), \n675: \t\t\t\t\t\t      e.getName()));\n676:     }\n677: \n678:     /**\n679:      * @see MElementListener#propertySet(MElementEvent)\n680:      */\n681:     public void propertySet(MElementEvent e) {\n682:         if (!pumping) return;\n683:         if (e.getNewValue() == null\n684:             || !(e.getNewValue().equals(e.getOldValue()))) {\n685:             MElementListener[] listeners = getListenerList(e);\n686:             for (int i = 0; i < listeners.length; i++) {\n687: \t\ttry {\n688: \t\t    listeners[i].propertySet(e);\n689: \t\t} catch (Exception re) {\n690: \t\t    LOG.error(\"Listener \" + listeners[i]\n691: \t\t\t      + \" threw an unhandled Exception\", re);\n692: \t\t}\n693:             }\n694:         }\n695:     }\n696: \n697:     /**\n698:      * @see MElementListener#recovered(MElementEvent)\n699:      */\n700:     public void recovered(MElementEvent e) {\n701:         if (!pumping) return;\n702:         MElementListener[] listeners = getListenerList(e);\n703:         for (int i = 0; i < listeners.length; i++) {\n704: \t    try {\n705: \t\tlisteners[i].recovered(e);\n706: \t    } catch (Exception re) {\n707: \t\tLOG.error(\"Listener \" + listeners[i]\n708: \t\t\t  + \" threw an unhandled Exception\", re);\n709: \t    }\n710:         }\n711:     }\n712: \n713:     /**\n714:      * @see MElementListener#removed(MElementEvent)\n715:      */\n716:     public void removed(MElementEvent e) {\n717:         if (!pumping) return;\n718:         MElementListener[] listeners = getListenerList(e);\n719:         for (int i = 0; i < listeners.length; i++) {\n720: \t    try {\n721: \t\tlisteners[i].removed(e);\n722: \t    } catch (Exception re) {\n723: \t\tLOG.error(\"Listener \" + listeners[i]\n724: \t\t\t  + \" threw an unhandled Exception\", re);\n725: \t    }\n726:         }\n727:     }\n728: \n729:     /**\n730:      * @see MElementListener#roleAdded(MElementEvent)\n731:      */\n732:     public void roleAdded(MElementEvent e) {\n733:         if (!pumping) return;\n734:         MElementListener[] listeners = getListenerList(e);\n735:         for (int i = 0; i < listeners.length; i++) {\n736: \t    try {\n737: \t\tlisteners[i].roleAdded(e);\n738: \t    } catch (Exception re) {\n739: \t\tLOG.error(\"Listener \" + listeners[i]\n740: \t\t\t  + \" threw an unhandled Exception\", re);\n741: \t    }\n742:         }\n743:     }\n744: \n745:     /**\n746:      * @see MElementListener#roleRemoved(MElementEvent)\n747:      */\n748:     public void roleRemoved(MElementEvent e) {\n749:         if (!pumping) return;\n750:         MElementListener[] listeners = getListenerList(e);\n751:         for (int i = 0; i < listeners.length; i++) {\n752: \t    try {\n753: \t\tlisteners[i].roleRemoved(e);\n754: \t    } catch (Exception re) {\n755: \t\tLOG.error(\"Listener \" + listeners[i]\n756: \t\t\t  + \" threw an unhandled Exception\", re);\n757: \t    }\n758:         }\n759:     }\n760: \n761:     /**\n762:      * Clears the hashmaps with listeners. This is only needed by the JUnit\n763:      * tests. It's an implementation detail that the visibility is public. \n764:      * THIS METHOD SHOULD NOT BE \n765:      * USED OUTSIDE JUNIT TESTS.\n766:      */\n767:     public void cleanUp() {\n768:         listenerMap = null;\n769:         listenerMap = new EventListenerHashMap();\n770:         classListenerMap = null;\n771:         classListenerMap = new ClassListenerHashMap();\n772:     }\n773: \n774:     ClassListenerHashMap getClassListenerMap() {\n775:         return classListenerMap;\n776:     }\n777: \n778:     EventListenerHashMap getEventListenerMap() {\n779:         return listenerMap;\n780:     }\n781:     \n782:     /**\n783:      * changes the NSUML event policy in order to stop udating the ui.\n784:      */\n785:     public void stopPumpingEvents() {\n786:         pumping = false;\n787: \n788:         MFactoryImpl.setEventPolicy(MFactoryImpl.EVENT_POLICY_DISABLED);\n789:     }\n790:     \n791:     /**\n792:      * changes the NSUML event policy in order to start udating the ui.\n793:      */\n794:     public void startPumpingEvents() {\n795:         pumping = true;\n796: \n797:         MFactoryImpl.flushEvents();\n798:         MFactoryImpl.setEventPolicy(MFactoryImpl.EVENT_POLICY_IMMEDIATE);\n799:     }\n800:     \n801:     /**\n802:      * changes the NSUML event policy to flush model events.\n803:      */\n804:     public void flushModelEvents() {\n805: \n806:         MFactoryImpl.flushEvents();\n807:     }\n808: }\n809: \n810: /**\n811:  * Value object class to find the correct eventlistenerlist in the\n812:  * eventhashmap.<p>\n813:  *\n814:  * @author jaap.branderhorst@xs4all.nl\n815:  */\n816: class EventKey {\n817:     private Integer type;\n818:     private String name;\n819: \n820:     static final EventKey EMPTY_KEY = new EventKey(null, null);\n821: \n822:     public EventKey(int t, String n) {\n823:         setType(t);\n824:         setName(n);\n825:     }\n826: \n827:     public EventKey(Integer t, String n) {\n828:         type = t;\n829:         setName(n);\n830:     }\n831: \n832:     private void setType(int t) {\n833:         if (t < 0 || t > 10)\n834:             throw new IllegalArgumentException(\n835:                 \"This is not a legal eventtype: \" + t);\n836:         type = new Integer(t);\n837:     }\n838: \n839:     public Integer getType() {\n840:         return type;\n841:     }\n842: \n843:     private void setName(String n) {\n844:         name = n;\n845:     }\n846: \n847:     public String getName() {\n848:         return name;\n849:     }\n850: \n851:     /**\n852:      * TODO: Write a hashCode() function?\n853:      * @see java.lang.Object#equals(java.lang.Object)\n854:      */\n855:     public boolean equals(Object o) {\n856:         if (o instanceof EventKey) {\n857:             EventKey key = (EventKey) o;\n858:             if ((key.getType() == null && getType() == null)\n859:                 || (key.getType() != null\n860: \t\t    && key.getType().equals(getType())\n861: \t\t    && key.getName() != null\n862: \t\t    && key.getName().equals(getName()))) {\n863:                 return true;\n864:             }\n865:         }\n866:         return false;\n867:     }\n868: \n869: }\n870: \n871: /**\n872:  * A wrapped object array that contains triples of eventtype,\n873:  * eventname, interested listener. I used an Object array for this\n874:  * purpose since it performs fast. Copied a lot of the code from\n875:  * javax.swing.EventListenerList.\n876:  * @author jaap.branderhorst@xs4all.nl\n877:  */\n878: class EventListenerList {\n879:     /**\n880:      *  A null array to be shared by all empty listener lists\n881:      */\n882:     private static final Object[] NULL_ARRAY = new Object[0];\n883:     /**\n884:      *  The list of EventKey - Listener pairs. It's visibility is default since\n885:      * it's used in AbstractUmlModelFactory in a performant but quite awkward\n886:      * way from an encapsulation point of view. \n887:      */\n888:     private Object[] listenerList = NULL_ARRAY;\n889: \n890:     /**\n891:      * Returns an array of listeners that are interested in an event\n892:      * that is typed by the given EventKey. If the name is null of the\n893:      * EventKey, all listeners are returned that have the\n894:      * corresponding name filled or null. Same is true for the type.\n895:      * @param key\n896:      * @return An array of listeners that are interested in the event typed by\n897:      * the given EventKey\n898:      */\n899:     public synchronized MElementListener[] getListeners(EventKey key) {\n900:         Object[] lList = listenerList;\n901:         int n = getListenerCount(lList, key);\n902:         MElementListener[] result =\n903:             (MElementListener[]) Array.newInstance(MElementListener.class, n);\n904:         int j = 0;\n905:         // if the event name is not set we should return all listeners\n906:         // interested\n907:         if (key.getType().intValue() == 0) {\n908:             Integer type = key.getType();\n909:             for (int i = lList.length - 3; i >= 0; i -= 3) {\n910:                 if (type.equals(lList[i]))\n911:                     result[j++] = (MElementListener) lList[i + 2];\n912:             }\n913:         } else if (key.getName() != null && key.getType() != null) {\n914:             Integer type = key.getType();\n915:             String name = key.getName();\n916:             for (int i = lList.length - 3; i >= 0; i -= 3) {\n917:                 if (name.equals(lList[i + 1]) && type.equals(lList[i]))\n918:                     result[j++] = (MElementListener) lList[i + 2];\n919:             }\n920:         } else\n921:             throw new IllegalArgumentException(\"Illegal eventkey!\");\n922:         return result;\n923:     }\n924: \n925:     /**\n926:      * Registers the given listeners for the event typed by\n927:      * EventKey. If the name is null (of the EventKey), the listener\n928:      * is registred for all events that have a type corresponding to\n929:      * the type in the given key, no matter what the name of the event\n930:      * is. Vice versa for the type.<p>\n931:      *\n932:      * <strong>A listener that has been added twice will get the\n933:      * events for which it registred twice. Be careful with\n934:      * registring listeners!</strong>\n935:      *\n936:      * @param key\n937:      * @param listener\n938:      */\n939:     public synchronized void add(EventKey key, MElementListener listener) {\n940:         if (listener == null || key == null)\n941:             throw new IllegalArgumentException(\"Null key or null listener\");\n942:         // check if there allready is a listener\n943:         // if (!Arrays.asList(getListeners(key)).contains(listener)) {\n944: \n945:         if (listenerList == NULL_ARRAY) {\n946:             // if this is the first listener added, \n947:             // initialize the lists\n948:             listenerList =\n949:                 new Object[] {\n950: \t\t    key.getType(), key.getName(), listener\n951: \t\t};\n952:         } else {\n953:             if (!contains(key, listener)) {\n954:             // Otherwise copy the array and add the new listener\n955:                 int i = listenerList.length;\n956:                 Object[] tmp = new Object[i + 3];\n957:                 System.arraycopy(listenerList, 0, tmp, 0, i);\n958:                 \n959:                 tmp[i] = key.getType();\n960:                 tmp[i + 1] = key.getName();\n961:                 tmp[i + 2] = listener;            \n962:                 \n963:                 listenerList = tmp;\n964:             }\n965:         }\n966:         // }\n967:     }\n968:     \n969:     public boolean contains(EventKey key, MElementListener listener) {       \n970:         if (key == null) System.out.println(\" KEy null\");\n971:         for (int i = listenerList.length - 1; i > 0; i -= 3) {\n972:             if (listenerList[i] == listener \n973:                 && ( (listenerList[i - 1] == null && key.getName() == null) \n974:                     || (listenerList[i - 1] != null \n975:                         && listenerList[i - 1].equals(key.getName())) \n976:                     && ((listenerList[i - 2] == null && key.getType() == null) \n977:                         || (listenerList[i - 2] != null  \n978:                             && listenerList[i - 2].equals(key.getType()))))) \n979:                 return true;             \n980:         }\n981:         return false;\n982:     }\n983: \n984:     /**\n985:      * Removes a listener from the list.\n986:      * @param key\n987:      * @param listener\n988:      */\n989:     public void remove(EventKey key, MElementListener listener) {   \n990:         if (key.getName() != null && key.getType() != null)\n991:             for (int i = listenerList.length - 3; i >= 0; i -= 3) {\n992:                 if (listenerList[i + 2] == listener\n993:                     && key.getName().equals(listenerList[i + 1])\n994: \t\t    && key.getType().equals(listenerList[i]))\n995: \t\t{\n996:                     removeElement(i);\n997:                     break;\n998:                 }\n999:             }\n1000: \telse if (key.equals(EventKey.EMPTY_KEY)) {\n1001:             for (int i = listenerList.length - 1; i >= 0; i -= 3) {\n1002:                 if (listenerList[i] == listener) {\n1003:                     removeElement(i - 2);\n1004:                 }\n1005:             }\n1006:         }\n1007: \telse if (key.getName() != null) {\n1008:             String name = key.getName();\n1009:             for (int i = listenerList.length - 1; i >= 0; i -= 3) {\n1010:                 if (listenerList[i] == listener\n1011:                     && name.equals(listenerList[i - 1])) {\n1012:                     removeElement(i - 2);\n1013:                 }\n1014:             }\n1015:         }\n1016: \telse {\n1017:             Integer type = key.getType();\n1018:             for (int i = listenerList.length - 1; i >= 0; i -= 3) {\n1019:                 if (listenerList[i] == listener\n1020:                     && type.equals(listenerList[i - 2])) {\n1021:                     removeElement(i - 2);\n1022:                 }\n1023:             }\n1024:         }\n1025: \n1026:     }\n1027: \n1028:     /**\n1029:      * Does the actual removal of an element at the given index in the list.\n1030:      * @param index\n1031:      */\n1032:     private synchronized void removeElement(int index) {\n1033:         Object[] tmp = new Object[listenerList.length - 3];\n1034:         // Copy the list up to index\n1035:         System.arraycopy(listenerList, 0, tmp, 0, index);\n1036:         // Copy from two past the index, up to\n1037:         // the end of tmp (which is three elements\n1038:         // shorter than the old list)\n1039:         if (index < tmp.length)\n1040:             System.arraycopy(listenerList,\n1041: \t\t\t     index + 3,\n1042: \t\t\t     tmp,\n1043: \t\t\t     index,\n1044: \t\t\t     tmp.length - index);\n1045:         // set the listener array to the new array or null\n1046:         listenerList = (tmp.length == 0) ? NULL_ARRAY : tmp;\n1047:     }\n1048: \n1049:     /**\n1050:      * Returns the number of listeners that are interested in the given key and \n1051:      * exist in the given object array.\n1052:      * @param list\n1053:      * @param key\n1054:      * @return\n1055:      */\n1056:     private int getListenerCount(Object[] list, EventKey key) {\n1057:         int count = 0;\n1058:         String name = key.getName();\n1059:         Integer type = key.getType();\n1060:         if (type.intValue() == 0) {\n1061:             for (int i = 0; i < list.length; i += 3) {\n1062:                 if (type.equals(list[i])) {\n1063:                     count++;\n1064:                 }\n1065:             }\n1066:         } else if (name != null && type != null) {\n1067:             for (int i = 0; i < list.length; i += 3) {\n1068:                 if (type.equals(list[i]) && name.equals(list[i + 1]))\n1069:                     count++;\n1070:             }\n1071:         } else\n1072:             throw new IllegalArgumentException(\"Illegal eventkey!\");\n1073:         return count;\n1074:     }\n1075: \n1076:     /**\n1077:     * Returns the total number of listeners of the supplied type \n1078:     * for this listener list.\n1079:     */\n1080:     public synchronized int getListenerCount(EventKey key) {\n1081:         return getListenerCount(listenerList, key);\n1082:     }\n1083: \n1084:     /**\n1085:      * Returns the total number of listeners for this listener list.\n1086:      */\n1087:     public synchronized int getListenerCount() {\n1088:         return listenerList.length / 3;\n1089:     }\n1090: \n1091:     /**\n1092:      * @param ll The listenerList to set.\n1093:      */\n1094:     void setListenerList(Object[] ll) {\n1095:         this.listenerList = ll;\n1096:     }\n1097: \n1098:     /**\n1099:      * @return Returns the listenerList.\n1100:      */\n1101:     Object[] getListenerList() {\n1102:         return listenerList;\n1103:     }\n1104: \n1105: }\n1106: \n1107: /**\n1108:  * A map containing instances of meta-classes (modelelements) as keys and \n1109:  * EventListenerLists as values. The class is a wrapper around an underlying\n1110:  * java.util.HashMap and provides some custom methods for easy access to the \n1111:  * underlying data structure. \n1112:  * @author jaap.branderhorst@xs4all.nl\n1113:  */\n1114: class EventListenerHashMap {\n1115: \n1116:     /**\n1117:      *  A null array to be shared by all empty listener lists\n1118:      */\n1119:     private static final MElementListener[] NULL_ARRAY =\n1120:         new MElementListener[0];\n1121: \n1122:     /**\n1123:      *  The list of ListenerType - Listener pairs \n1124:      */\n1125:     private transient Map listenerMap = new HashMap();\n1126: \n1127:     /**\n1128:      * Puts the given listener as listener to the given modelelement\n1129:      * and given eventKey in the map.\n1130:      * @param element\n1131:      * @param key\n1132:      * @param listener\n1133:      */\n1134:     public synchronized void put(\n1135:         MBase element,\n1136:         EventKey key,\n1137:         MElementListener listener) {     \n1138:         EventListenerList list = (EventListenerList) listenerMap.get(element);\n1139:         if (list == null) {\n1140:             list = new EventListenerList();\n1141:             listenerMap.put(element, list);\n1142:         }\n1143:         list.add(key, listener);\n1144:     }\n1145: \n1146:     /**\n1147:      * Removes a listener for a given eventkey and a given modelelement.\n1148:      * @param element\n1149:      * @param key\n1150:      * @param listener\n1151:      */\n1152:     public synchronized void remove(\n1153:         MBase element,\n1154:         EventKey key,\n1155:         MElementListener listener) {    \n1156:         EventListenerList list = (EventListenerList) listenerMap.get(element);\n1157:         if (list != null) {\n1158:             list.remove(key, listener);\n1159:         }\n1160:     }\n1161: \n1162:     /**\n1163:      * Removes the complete EventListenerList for the given element.\n1164:      * @param element\n1165:      */\n1166:     public synchronized void remove(MBase element) {\n1167:         listenerMap.remove(element);\n1168:     }\n1169: \n1170:     /**\n1171:      * Returns all listeners that are registered for the given modelElement and\n1172:      * the given EventKey.\n1173:      * @param element\n1174:      * @param key\n1175:      * @return\n1176:      */\n1177:     public MElementListener[] getListeners(MBase element, EventKey key) {\n1178:         EventListenerList list = (EventListenerList) listenerMap.get(element);\n1179:         return list == null ? NULL_ARRAY : list.getListeners(key);\n1180:     }\n1181: \n1182:     /**\n1183:      * Tests wether there are any listeners registred for any\n1184:      * modelelements and eventkeys.\n1185:      *\n1186:      * @return true if empty.\n1187:      */\n1188:     public boolean isEmpty() {\n1189:         return listenerMap.isEmpty();\n1190:     }\n1191: }\n1192: \n1193: /**\n1194:  * A map that holds ElementListenerLists with lists of listeners that\n1195:  * are interested in each and every event of a certain type of the\n1196:  * instances of a certain meta-class.\n1197:  * @author jaap.branderhorst@xs4all.nl\n1198:  */\n1199: class ClassListenerHashMap {\n1200: \n1201:     /**\n1202:      *  A null array to be shared by all empty listener lists\n1203:      */\n1204:     private static final MElementListener[] NULL_ARRAY =\n1205:         new MElementListener[0];\n1206: \n1207:     /**\n1208:      *  The list of ListenerType - Listener pairs \n1209:      */\n1210:     private transient Map listenerMap = new HashMap();\n1211: \n1212:     /**\n1213:      * Puts a listener that is interested in a certain event that will be send\n1214:      * by instances of the given meta-class.\n1215:      * @param element The meta-class the listener is interested in\n1216:      * @param key The type/name pair designating the event type\n1217:      * @param listener The listener that's interested in the given event type\n1218:      */\n1219:     public synchronized void put(\n1220:         Class element,\n1221:         EventKey key,\n1222:         MElementListener listener) {\n1223:         if (element == null || listener == null)\n1224:             throw new IllegalArgumentException(\"Modelelement or listener null\");\n1225:         EventListenerList list = \n1226:             (EventListenerList) listenerMap.get(element.getName());\n1227:         if (list == null) {\n1228:             list = new EventListenerList();\n1229:             listenerMap.put(element.getName(), list);\n1230:         }\n1231:         list.add(key, listener);\n1232:     }\n1233: \n1234:     /**\n1235:      * Removes a listener as being interested in the given event.\n1236:      * @param element\n1237:      * @param key\n1238:      * @param listener\n1239:      */\n1240:     public synchronized void remove(\n1241:         Class element,\n1242:         EventKey key,\n1243:         MElementListener listener) {\n1244:         if (element == null || listener == null)\n1245:             throw new IllegalArgumentException(\"Modelelement or listener null\");\n1246:         EventListenerList list = \n1247:             (EventListenerList) listenerMap.get(element.getName());\n1248:         if (list != null) {\n1249:             list.remove(key, listener);\n1250:         }\n1251:     }\n1252: \n1253:     /**\n1254:      * Removes the list of listeners for the given meta-class.\n1255:      * @param element\n1256:      */\n1257:     public synchronized void remove(Class element) {\n1258:         listenerMap.remove(element);\n1259:     }\n1260: \n1261:     /**\n1262:      * Returns all listeners that are interested in the given event.\n1263:      * @param element\n1264:      * @param key\n1265:      * @return\n1266:      */\n1267:     public MElementListener[] getListeners(Class element, EventKey key) {\n1268:         EventListenerList list = (EventListenerList) listenerMap.get(element);\n1269:         return list == null ? NULL_ARRAY : list.getListeners(key);\n1270:     }\n1271: \n1272:     /** \n1273:      * Returns an EventListenerList with listeners that are interested\n1274:      * in certain events of the given meta-class.\n1275:      * @param element\n1276:      * @return\n1277:      */\n1278:     public EventListenerList[] getListenerList(Class element) {\n1279:         // element = formatClass(element);\n1280:         Class[] hierarchy = getHierarchy(element);\n1281:         EventListenerList[] lists = new EventListenerList[hierarchy.length];\n1282:         EventListenerList list = null;\n1283:         for (int i = 0; i < lists.length; i++) {\n1284:             list = (EventListenerList) listenerMap.get(hierarchy[i].getName());\n1285:             lists[i] = list == null ? new EventListenerList() : list;\n1286:         }\n1287:         return lists;\n1288:     }\n1289: \n1290:     private Class[] getHierarchy(Class clazz) {\n1291:         Class[] returnClass = null;\n1292:         if (clazz != Object.class) {\n1293:             Class[] tmp = getHierarchy(clazz.getSuperclass());\n1294:             returnClass =\n1295:                 (Class[]) Array.newInstance(Class.class, tmp.length + 1);\n1296:             System.arraycopy(tmp, 0, returnClass, 0, tmp.length);\n1297:             returnClass[tmp.length] = clazz;\n1298:         } else {\n1299:             returnClass = new Class[] {\n1300: \t\tclazz \n1301: \t    };\n1302:         }\n1303:         return returnClass;\n1304:     }\n1305: \n1306:     /**\n1307:      * Tests if the hashmap is empty.\n1308:      *\n1309:      * @return true if empty.\n1310:      */\n1311:     public boolean isEmpty() {\n1312:         return listenerMap.isEmpty();\n1313:     }\n1314: \n1315: }\n1316: \n1317: /**\n1318:  * Class containing the definitions of all events in NSUML. The file\n1319:  * eventtree.xml is loaded by this class and converted to a hashmap\n1320:  * containing the classes firing events as keys and hashmaps\n1321:  * containing eventnames as keys and eventtypes as values as values.\n1322:  * @author jaap.branderhorst@xs4all.nl\n1323:  */\n1324: class EventTreeDefinition {\n1325:     private static final Logger LOG = \n1326:         Logger.getLogger(EventTreeDefinition.class);\n1327:     private static final String FILE_NAME = \"org/argouml/eventtree.xml\";\n1328:     private Map definition = new HashMap();\n1329: \n1330:     /**\n1331:      * Create an instance of EventTreeDefinition, reading\n1332:      * org/argouml/eventtree.xml to obtain the initial configuration.\n1333:      */\n1334:     public EventTreeDefinition() {\n1335:         Document doc = loadDocument();\n1336:         synchronized (doc) { // TODO: Why is this synchronized??\n1337:             addSourcesFromDocument (doc);\n1338:         }\n1339:     }\n1340: \n1341:     /**\n1342:      * <p>Add all event sources described by the given document.\n1343:      * The document must match  the pattern given by the following example:\n1344:      * \n1345:      * <pre>\n1346:      * &lt;eventtree&gt;\n1347:      *   &lt;source classname=\"classname of a model element\"&gt;\n1348:      *     &lt;eventtype name=\"event fired by this model element\"&gt;\n1349:      *       &lt;type&gt;1&lt;/type&gt;\n1350:      *     &lt;/eventtype&gt;\n1351:      *   &lt;/source&gt;\n1352:      * &lt;/eventtree&gt;\n1353:      * </pre>\n1354:      *\n1355:      * The classname is fully qualified.<p>\n1356:      * \n1357:      * <p>The type is one of the numbers defined in {@link MElementEvent}. Each \n1358:      * of the elements can be used multiple times.\n1359:      * \n1360:      * @param doc the document, the contents of which should be added to this \n1361:      *            event tree definition. This must be preparsed.\n1362:      */\n1363:     synchronized void addSourcesFromDocument (final Document doc) {\n1364:         NodeList sources = doc.getChildNodes().item(0).getChildNodes();\n1365:         for (int i = 0; i < sources.getLength(); i++) {\n1366:             Element source = (Element) sources.item(i);\n1367:             String className = source.getAttribute(\"classname\");\n1368:             Class sourceClass = null;\n1369:             try {\n1370:                 sourceClass = Class.forName(className);\n1371:             } catch (ClassNotFoundException e) {\n1372:                 LOG.error(e);\n1373:             }\n1374:             Map nameMap = new HashMap();\n1375:             NodeList eventTypes = source.getChildNodes();\n1376:             for (int j = 0; j < eventTypes.getLength(); j++) {\n1377:                 Element eventType = (Element) eventTypes.item(j);\n1378:                 String name = eventType.getAttribute(\"name\");\n1379:                 NodeList typeNodes = eventType.getChildNodes();\n1380:                 int typeLength = typeNodes.getLength();\n1381:                 int[] types = new int[typeLength];\n1382:                 for (int k = 0; k < typeLength; k++) {\n1383:                     Element typeNode = (Element) typeNodes.item(k);\n1384:                     types[k] =\n1385:                         Integer.parseInt(\n1386:                             typeNode.getFirstChild().getNodeValue());\n1387:                 }\n1388:                 nameMap.put(name, types);\n1389:             }\n1390:             // remove case\n1391:             nameMap.put(UmlModelEventPump.REMOVE, new int[] {\n1392:                 0\n1393:             });\n1394:             addSource (sourceClass, nameMap);\n1395:         }\n1396:     }\n1397: \n1398:     /**\n1399:      * Add event types for a single source to this event tree.\n1400:      * \n1401:      * @param cSource the source class for which to add event types.\n1402:      * \n1403:      * @param mpNameMap a map of the event types to add for the source class.\n1404:      *                  The keys are Strings indicating the names of events, \n1405:      *                  while the values are int[] which contain all the event\n1406:      *                  types the indicated event represents. The specific int \n1407:      *                  values used can be found in {@link MElementEvent}.\n1408:      */\n1409:     synchronized void addSource (Class cSource, Map mpNameMap) {\n1410:         definition.put (cSource, mpNameMap);\n1411:     }\n1412: \n1413:     /**\n1414:      * Returns all eventkeys that an instance of the given modelClass\n1415:      * could possibly fire.\n1416:      * @param modelClass\n1417:      * @return\n1418:      */\n1419:     public synchronized EventKey[] getEventTypes(Class modelClass) {\n1420:         modelClass = formatClass(modelClass);\n1421:         Map nameMap = (Map) definition.get(modelClass);\n1422:         Iterator it = nameMap.keySet().iterator();\n1423:         int size = 0;\n1424:         while (it.hasNext()) {\n1425:             size += ((int[]) nameMap.get(it.next())).length;\n1426:         }\n1427:         EventKey[] result = new EventKey[size + 1];\n1428:         int counter = 0;\n1429:         it = nameMap.keySet().iterator();\n1430:         while (it.hasNext()) {\n1431:             String name = (String) it.next();\n1432:             int[] types = (int[]) nameMap.get(name);\n1433:             EventKey[] keys = new EventKey[types.length];\n1434:             for (int i = 0; i < types.length; i++) {\n1435:                 keys[i] = new EventKey(types[i], name);\n1436:             }\n1437:             System.arraycopy(keys, 0, result, counter, keys.length);\n1438:             counter += keys.length;\n1439:         }\n1440:         // remove event\n1441:         System.arraycopy(new EventKey[] {\n1442: \t    new EventKey(0, null)\n1443: \t},\n1444: \t\t\t 0,\n1445: \t\t\t result,\n1446: \t\t\t counter,\n1447: \t\t\t 1);\n1448:         return result;\n1449:     }\n1450: \n1451:     /**\n1452:      * Returns all EventKeys (eventdefinitions) with the given eventName \n1453:      * that the given modelClass can fire.\n1454:      * @param modelClass\n1455:      * @param name\n1456:      * @return\n1457:      */\n1458:     public synchronized EventKey[] getEventTypes(Class modelClass,\n1459:                                                  String name) {\n1460:         modelClass = formatClass(modelClass);\n1461:         Map nameMap = (Map) definition.get(modelClass);\n1462:         if (nameMap != null) {\n1463:             int[] types = (int[]) nameMap.get(name);\n1464:             if (types != null) {\n1465: \n1466:                 EventKey[] keys = new EventKey[types.length];\n1467:                 for (int i = 0; i < types.length; i++) {\n1468:                     keys[i] = new EventKey(types[i], name);\n1469:                 }\n1470:                 return keys;\n1471:             }\n1472:         }\n1473:         return new EventKey[0];\n1474:     }\n1475: \n1476:     private synchronized Document loadDocument() {\n1477:         DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();\n1478:         try {\n1479:             DocumentBuilder builder = factory.newDocumentBuilder();\n1480:             Document eventNamesDoc =\n1481:                 builder.parse(\n1482:                     getClass().getClassLoader().getResourceAsStream(FILE_NAME));\n1483:             return eventNamesDoc;\n1484:         } catch (ParserConfigurationException e) {\n1485:             LOG.fatal(e);\n1486:             System.exit(-1);\n1487:         } catch (SAXException e) {\n1488:             LOG.fatal(e);\n1489:             System.exit(-1);\n1490:         } catch (IOException e) {\n1491:             LOG.fatal(e);\n1492:             System.exit(-1);\n1493:         }\n1494:         return null;\n1495:     }\n1496: \n1497:     private Class formatClass(Class inputClass) {\n1498:         String name = inputClass.getName();\n1499:         if (name.endsWith(\"Impl\"))\n1500:             return inputClass;\n1501:         else {\n1502:             try {\n1503:                 Class returnClass = Class.forName(name + \"Impl\");\n1504:                 return returnClass;\n1505:             } catch (ClassNotFoundException ignorable) {\n1506:                 // cannot happen\n1507:             }\n1508:         }\n1509:         return null;\n1510: \n1511:     }\n1512:     \n1513: }\n1514: ",
