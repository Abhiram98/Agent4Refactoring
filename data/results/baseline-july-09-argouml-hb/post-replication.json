n;\n33: import java.awt.Rectangle;\n34: import java.awt.event.MouseEvent;\n35: import java.awt.event.MouseListener;\n36: import java.util.Iterator;\n37: import java.util.Vector;\n38: \n39: import javax.swing.Icon;\n40: import javax.swing.JPanel;\n41: import javax.swing.JTabbedPane;\n42: import javax.swing.event.ChangeEvent;\n43: import javax.swing.event.ChangeListener;\n44: import javax.swing.event.EventListenerList;\n45: \n46: import org.apache.log4j.Category;\n47: import org.argouml.application.api.Argo;\n48: import org.argouml.application.api.QuadrantPanel;\n49: import org.argouml.cognitive.ui.TabToDo;\n50: import org.argouml.cognitive.ui.TabToDoTarget;\n51: import org.argouml.model.ModelFacade;\n52: import org.argouml.swingext.Orientable;\n53: import org.argouml.swingext.ignoreSplitters;\n54: import org.argouml.ui.targetmanager.TargetEvent;\n55: import org.argouml.ui.targetmanager.TargetListener;\n56: import org.argouml.ui.targetmanager.TargetManager;\n57: import org.argouml.uml.ui.PropPanel;\n58: import org.argouml.uml.ui.TabModelTarget;\n59: import org.argouml.uml.ui.TabProps;\n60: import org.argouml.util.ConfigLoader;\n61: \n62: /**\n63:  * The lower-right pane of the main Argo/UML window, which shows\n64:  * the details of a selected model element. \n65:  * \n66:  * This panel has several tabs that show details of the selected ToDoItem, or the\n67:  * selected model element in the NavigationPane, or the\n68:  * MultiEditorPane.\n69:  *\n70:  * There are requests to have the cursor automatically\n71:  * be set to the primary field.\n72:  *\n73:  * $Id$\n74:  */\n75: public class DetailsPane\n76:     extends JPanel\n77:     implements ChangeListener, MouseListener, QuadrantPanel, Orientable, TargetListener {\n78: \n79:     protected static Category cat = Category.getInstance(DetailsPane.class);\n80:     ////////////////////////////////////////////////////////////////\n81:     // constants\n82: \n83:     public static int WIDTH = 690;\n84:     public static int HEIGHT = 520;\n85:     public static int INITIAL_WIDTH = 400;\n86:     public static int INITIAL_HEIGHT = 200;\n87: \n88:     ////////////////////////////////////////////////////////////////\n89:     // instance variables\n90: \n91:     /**\n92:      * The currently selected todo item.\n93:      */\n94:     protected Object _item = null;\n95: \n96:     /**\n97:      * The top level pane, which is a tabbed pane.\n98:      */\n99:     protected JTabbedPane _tabs = new JTabbedPane();\n100: \n101:     /** \n102:      * The current target\n103:      */\n104:     private Object _target;\n105: \n106:     /**\n107:      * a list of all the tabs, which are JPanels, in the JTabbedPane _tabs.\n108:      */\n109:     protected Vector _tabPanels = new Vector();\n110: \n111:     /**\n112:      * index of the selected tab in the JTabbedPane.\n113:      */\n114:     protected int _lastNonNullTab = -1;\n115: \n116:     /**\n117:      *\n118:      */\n119:     private ignoreSplitters orientation;\n120: \n121:     /**\n122:        * The list with targetlisteners, this are the property panels managed by TabProps\n123:        * It should only contain one listener at a time.\n124:        */\n125:     private EventListenerList _listenerList = new EventListenerList();\n126: \n127:     /**\n128:         * Adds a listener.\n129:         * @param listener the listener to add\n130:         */\n131:     private void addTargetListener(TargetListener listener) {\n132:         _listenerList.add(TargetListener.class, listener);\n133:     }\n134: \n135:     /**\n136:      * Removes a target listener.\n137:      * @param listener the listener to remove\n138:      */\n139:     private void removeTargetListener(TargetListener listener) {\n140:         _listenerList.remove(TargetListener.class, listener);\n141:     }\n142:     ////////////////////////////////////////////////////////////////\n143:     // constructors\n144: \n145:     /**\n146:      * Gets all of the _tabPanels from the ConfigLoader, then \n147:      * adds them to the JTabbedPane.\n148:      *\n149:      * sets the target to null.\n150:      *\n151:      * registers listeners.\n152:      */\n153:     public DetailsPane(String pane, ignoreSplitters orientation) {\n154:         Argo.log.info(\"making DetailsPane(\" + pane + \")\");\n155: \n156:         this.orientation = orientation;\n157:         ConfigLoader.loadTabs(_tabPanels, pane, orientation);\n158:         setLayout(new BorderLayout());\n159:         setFont(new Font(\"Dialog\", Font.PLAIN, 10));\n160:         add(_tabs, BorderLayout.CENTER);\n161: \n162:         for (int i = 0; i < _tabPanels.size(); i++) {\n163:             String title = \"tab\";\n164:             JPanel t = (JPanel) _tabPanels.elementAt(i);\n165:             if (t instanceof TabSpawnable)\n166:                 title = ((TabSpawnable) t).getTitle();\n167:             title = Argo.localize(\"UMLMenu\", title);\n168:             if (t instanceof TabToDoTarget) {\n169:                 _tabs.addTab(title, _leftArrowIcon, t);\n170:             } else if (t instanceof TabModelTarget) {\n171:                 _tabs.addTab(title, _upArrowIcon, t);\n172:             } else if (t instanceof TabFigTarget) {\n173:                 _tabs.addTab(title, _upArrowIcon, t);\n174:             } else {\n175:                 _tabs.addTab(title, t);\n176:             } /*\n177:                         if (t instanceof TargetListener) {\n178:                             TargetManager.getInstance().addTargetListener((TargetListener)t);\n179:                         }\n180:                         */\n181:         }\n182: \n183:         // set the tab that should be shown on first entrance\n184:         _lastNonNullTab = -1;\n185:         Component[] tabs = _tabs.getComponents();\n186:         for (int i = 0; i < tabs.length; i++) {\n187:             // tabprops should be shown if loaded\n188:             if (tabs[i] instanceof TabProps) {\n189:                 _lastNonNullTab = i;\n190:           