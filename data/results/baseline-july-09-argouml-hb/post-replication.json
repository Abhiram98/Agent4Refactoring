Polygon;\n32: import java.awt.Rectangle;\n33: import java.awt.event.InputEvent;\n34: import java.awt.event.KeyEvent;\n35: import java.awt.event.KeyListener;\n36: import java.awt.event.MouseEvent;\n37: import java.awt.event.MouseListener;\n38: import java.beans.PropertyChangeEvent;\n39: import java.beans.PropertyChangeListener;\n40: import java.beans.VetoableChangeListener;\n41: import java.util.Iterator;\n42: \n43: import javax.swing.SwingUtilities;\n44: \n45: import org.apache.log4j.Logger;\n46: import org.argouml.kernel.DelayedChangeNotify;\n47: import org.argouml.kernel.DelayedVChangeListener;\n48: import org.argouml.kernel.SingleStereotypeEnabler;\n49: import org.argouml.model.Model;\n50: import org.argouml.uml.diagram.ui.FigMultiLineText;\n51: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n52: import org.argouml.util.CollectionUtil;\n53: import org.tigris.gef.base.Geometry;\n54: import org.tigris.gef.base.Selection;\n55: import org.tigris.gef.graph.GraphModel;\n56: import org.tigris.gef.presentation.Fig;\n57: import org.tigris.gef.presentation.FigPoly;\n58: import org.tigris.gef.presentation.FigRect;\n59: import org.tigris.gef.presentation.FigText;\n60: \n61: /**\n62:  * Class to display a UML comment in a diagram.\n63:  *\n64:  * @author Andreas Rueckert\n65:  */\n66: public class FigComment\n67:     extends FigNodeModelElement\n68:     implements VetoableChangeListener,\n69: \t       DelayedVChangeListener,\n70: \t       MouseListener,\n71: \t       KeyListener,\n72: \t       PropertyChangeListener {\n73:     /**\n74:      * Logger.\n75:      */\n76:     private static final Logger LOG = Logger.getLogger(FigComment.class);\n77: \n78:     ////////////////////////////////////////////////////////////////\n79:     // constants\n80: \n81:     private int x = 0;\n82:     private int y = 0;\n83:     private int width = 80;\n84:     private int height = 60;\n85:     private int dogear = 10; // a dog-ear = a bent corner in a book\n86: \n87:     private boolean readyToEdit = true;\n88: \n89:     ////////////////////////////////////////////////////////////////\n90:     // instance variables\n91: \n92:     // The figure that holds the text of the note.\n93:     private FigText text;\n94: \n95:     private FigPoly body;\n96:     private FigPoly urCorner; // the upper right corner\n97:     \n98:     /**\n99:      * Flag to indicate that we have just been created. This is to fix the\n100:      * problem with loading comments that have stereotypes already\n101:      * defined.<p>\n102:      */\n103:     private boolean newlyCreated = false;\n104: \n105:     ////////////////////////////////////////////////////////////////\n106:     // constructors\n107: \n108:     /**\n109:      * The main constructor used for file loading.\n110:      */\n111:     public FigComment() {\n112: \n113:         body = new FigPoly(Color.black, Color.white);\n114:         body.addPoint(x, y);\n115:         body.addPoint(x + width - 1 - dogear, y);\n116:         body.addPoint(x + width - 1, y + dogear);\n117:         body.addPoint(x + width - 1, y + height - 1);\n118:         body.addPoint(x, y + height - 1);\n119:         body.addPoint(x, y);\n120:         body.setFilled(true);\n121:         body.setLineWidth(1);\n122: \n123:         urCorner = new FigPoly(Color.black, Color.white);\n124:         urCorner.addPoint(x + width - 1 - dogear, y);\n125:         urCorner.addPoint(x + width - 1, y + dogear);\n126:         urCorner.addPoint(x + width - 1 - dogear, y + dogear);\n127:         urCorner.addPoint(x + width - 1 - dogear, y);\n128:         urCorner.setFilled(true);\n129:         Color col = body.getFillColor();\n130:         urCorner.setFillColor(col.darker());\n131:         urCorner.setLineWidth(1);\n132: \n133:         if (SingleStereotypeEnabler.isEnabled()) {\n134:             getStereotypeFig().setHeight(STEREOHEIGHT);\n135:             getStereotypeFig().setVisible(false);\n136:         }\n137:         \n138:         setBigPort(new FigRect(x, y, width, height, null, null));\n139:         getBigPort().setFilled(false);\n140:         getBigPort().setLineWidth(0);\n141: \n142:         text = new FigMultiLineText(x + 2, y + 2, width - 2 - dogear, height - 4, true);\n143: \n144:         // add Figs to the FigNode in back-to-front order\n145:         addFig(getBigPort());\n146:         addFig(body);\n147:         addFig(urCorner);\n148:         addFig(getStereotypeFig());\n149:         addFig(text);\n150: \n151:         setBlinkPorts(false); //make port invisble unless mouse enters\n152:         Rectangle r = getBounds();\n153:         setBounds(r.x, r.y, r.width, r.height);\n154:         updateEdges();\n155: \n156:         readyToEdit = false;\n157:         // Mark this as newly created. This is to get round the problem with\n158:         // creating figs for loaded comments that had stereotypes. They are\n159:         // saved with their dimensions INCLUDING the stereotype, but since we\n160:         // pretend the stereotype is not visible, we add height the first time\n161:         // we render such a comment. This is a complete fudge, and really we\n162:         // ought to address how comment objects with stereotypes are saved. But\n163:         // that will be hard work.\n164:         newlyCreated = true;\n165:     }\n166: \n167:     /**\n168:      * Construct a new comment.\n169:      *\n170:      * @param gm the graphmodel\n171:      * @param node the underlying UML Comment\n172:      */\n173:     public FigComment(GraphModel gm, Object node) {\n174:         this();\n175:         setOwner(node);\n176:     }\n177: \n178:     /**\n179:      * Get the default text for this figure.\n180:      *\n181:      * @return The default text for this figure.\n182:      */\n183:     public String placeString() {\n184:         String placeString = retrieveNote();\n185:         if (placeString == null) {\n186:             placeString = \"new note\";\n187:         }\n188:         return placeString;\n189:     }\n190: \n191:     /**\n192:      * Clone this figure.\n193:      *\n194:      * @return The cloned figure.\n195:      */\n196:     public Object clone() {\n197:         FigComment figClone = (FigComment) super.clone();\n198:         Iterator thisIter = this.getFigs().iterator();\n199:         while (thisIter.hasNext()) {\n200:             Object thisFig = thisIter.next();\n201:             if (thisFig == body) {\n202:                 figClone.body = (FigPoly) thisFig;\n203:             }\n204:             if (thisFig == urCorner) {\n205:                 figClone.urCorner = (FigPoly) thisFig;\n206:             }\n207:             if (thisFig == text) {\n208:                 figClone.text = (FigText) thisFig;\n209:             }\n210:         }\n211:         return figClone;\n212:     }\n213: \n214:     ////////////////////////////////////////////////////////////////\n215:     // event handlers\n216: \n217:     /**\n218:      * See FigNodeModelElement.java for more info on these methods.\n219:      */\n220: \n221:     /**\n222:      * If the user double clicks on any part of this FigNode, pass it\n223:      * down to one of the internal Figs.  This allows the user to\n224:      * initiate direct text editing.\n225:      *\n226:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n227:      */\n228:     public void mouseClicked(MouseEvent me) {\n229:         if (!readyToEdit) {\n230:             if (Model.getFacade().isAModelElement(getOwner())) {\n231:                 readyToEdit = true;\n232:             } else {\n233:                 LOG.debug(\"not ready to edit note\");\n234:                 return;\n235:             }\n236:         }\n237:         if (me.isConsumed()) {\n238:             return;\n239:         }\n240:         if (me.getClickCount() >= 2\n241: \t    && !(me.isPopupTrigger()\n242: \t\t || me.getModifiers() == InputEvent.BUTTON3_MASK)) {\n243:             if (getOwner() == null) {\n244:                 return;\n245:             }\n246:             Fig f = hitFig(new Rectangle(me.getX() - 2, me.getY() - 2, 4, 4));\n247:             if (f instanceof MouseListener) {\n248:                 ((MouseListener) f).mouseClicked(me);\n249:             }\n250:         }\n251:         me.consume();\n252:     }\n253: \n254:     /**\n255:      * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n256:      */\n257:     public void vetoableChange(PropertyChangeEvent pce) {\n258:         Object src = pce.getSource();\n259:         if (src == getOwner()) {\n260:             DelayedChangeNotify delayedNotify =\n261: \t\tnew DelayedChangeNotify(this, pce);\n262:             SwingUtilities.invokeLater(delayedNotify);\n263:         } else {\n264:             LOG.debug(\"FigNodeModelElement got vetoableChange\"\n265: \t\t      + \" from non-owner:\" + src);\n266:         }\n267:     }\n268: \n269:     /**\n270:      * @see org.argouml.kernel.DelayedVChangeListener#delayedVetoableChange(java.beans.PropertyChangeEvent)\n271:      */\n272:     public void delayedVetoableChange(PropertyChangeEvent pce) {\n273:         // update any text, colors, fonts, etc.\n274:         renderingChanged();\n275:         // update the relative sizes and positions of internel Figs\n276:         endTrans();\n277:     }\n278: \n279:     /**\n280:      * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n281:      */\n282:     public void propertyChange(PropertyChangeEvent pve) {\n283:         Object src = pve.getSource();\n284:         String pName = pve.getPropertyName();\n285:         if (pName.equals(\"editing\")\n286: \t    && Boolean.FALSE.equals(pve.getNewValue())) {\n287:             //parse the text that was edited\n288:             textEdited((FigText) src);\n289:             // resize the FigNode to accomodate the new text\n290:             Rectangle bbox = getBounds();\n291:             Dimension minSize = getMinimumSize();\n292:             bbox.width = Ma