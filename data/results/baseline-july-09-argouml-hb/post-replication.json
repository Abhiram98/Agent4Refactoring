       int res = 0;\n137:         Iterator it = figs.iterator();\n138:         while (it.hasNext()) {\n139:             Fig f = (Fig) it.next();\n140:             if (ModelFacade.isAMessage(f.getOwner())) {\n141:                 res++;\n142:             }\n143:         }\n144:         return res;\n145:     }\n146: \n147:     /** \n148:      * Method to perform a number of important initializations of a\n149:      * <I>CollaborationDiagram</I>.<p>\n150:      * \n151:      * Each diagram type has a similar <I>UMLxxxDiagram</I> class.<p>\n152:      *\n153:      * Changed <I>lay</I> from <I>LayerPerspective</I> to\n154:      * <I>LayerPerspectiveMutable</I>.  This class is a child of\n155:      * <I>LayerPerspective</I> and was implemented to correct some\n156:      * difficulties in changing the model.  <I>Lay</I> is used mainly\n157:      * in <I>LayerManager</I>(GEF) to control the adding, changing and\n158:      * deleting layers on the diagram...\n159:      * \n160:      * @param handle  the namespace object\n161:      * @author psager@tigris.org Jan. 24, 2002\n162:      */\n163:     public void setNamespace(Object handle) {\n164:         if (!ModelFacade.isANamespace(handle)) {\n165:             cat.error(\n166:                 \"Illegal argument. Object \" + handle + \" is not a namespace\");\n167:             throw new IllegalArgumentException(\n168:                 \"Illegal argument. Object \" + handle + \" is not a namespace\");\n169:         }\n170:         Object handle = /*(MNamespace)*/ handle;\n171:         super.setNamespace(handle);\n172:         CollabDiagramGraphModel gm = new CollabDiagramGraphModel();\n173:         gm.setNamespace(handle);\n174:         LayerPerspective lay =\n175:             new LayerPerspectiveMutable(ModelFacade.getName(handle), gm);\n176:         CollabDiagramRenderer rend = new CollabDiagramRenderer(); // singleton\n177:         lay.setGraphNodeRenderer(rend);\n178:         lay.setGraphEdgeRenderer(rend);\n179:         setLayer(lay);\n180: \n181:     }\n182: \n183:     /**\n184:      * Get the actions from which to create a toolbar or equivilent\n185:      * graphic triggers\n186:      */\n187:     protected Object[] getUmlActions() {\n188:         Object actions[] = {\n189: \t    _actionClassifierRole,\n190: \t    null,\n191: \t    getAssociationActions(),\n192: \t    ActionAddMessage.SINGLETON,\n193: \t    _actionGeneralize,\n194: \t    _actionDepend,\n195: \t    null,\n196: \t    _actionComment,\n197:             _actionCommentLink};\n198:         return actions;\n199:     }\n200: \n201:     private Object[] getAssociationActions() {\n202:         Object actions[][] = {\n203: \t    {_actionAssociation, _actionUniAssociation },\n204: \t    {_actionAggregation, _actionUniAggregation },\n205: \t    {_actionComposition, _actionUniComposition }\n206:         };\n207: \n208:         return actions;\n209:     }\n210: \n211:     /**  After loading the diagram it?s necessary to connect\n212:      *  every FigMessage to its FigAssociationRole. \n213:      *  This is done by adding the FigMessage \n214:      *  to the PathItems of its FigAssociationRole */\n215:     public void postLoad() {\n216: \n217:         super.postLoad();\n218: \n219:         Collection messages;\n220:         Iterator msgIterator;\n221:         if (getNamespace() == null) {\n222:             cat.error(\"Collaboration Diagram does not belong to a namespace\");\n223:             return;\n224:         }\n225:         Collection ownedElements = ModelFacade.getOwnedElements(getNamespace());\n226:         Iterator oeIterator = ownedElements.iterator();\n227:         Layer lay = getLayer();\n228:         while (oeIterator.hasNext()) {\n229:             Object me = /*(MModelElement)*/\n230: \t\toeIterator.next();\n231:             if (org.argouml.model.ModelFacade.isAAssociationRole(me)) {\n232:                 messages = ModelFacade.getMessages(me);\n233:                 msgIterator = messages.iterator();\n234:                 while (msgIterator.hasNext()) {\n235:                     Object message = /*(MMessage)*/\n236: \t\t\tmsgIterator.next();\n237:                     FigMessage figMessage =\n238:                         (FigMessage) lay.presentationFor(message);\n239:                     if (figMessage != null) {\n240:                         figMessage.addPathItemToFigAssociationRole(lay);\n241:                     }\n242:                 }\n243:             }\n244:         }\n245:     }\n246: \n247:     /**\n248:      * Creates a new diagramname.\n249:      * @return String\n250:      */\n251:     protected static String getNewDiagramName() {\n252:         String name = null;\n253:         name = \"Collaboration Diagram \" + _CollaborationDiagramSerial;\n254:         _CollaborationDiagramSerial++;\n255:         if (!ProjectManager.getManager().getCurrentProject()\n256: \t        .isValidDiagramName(name)) {\n257:             name = getNewDiagramName();\n258:         }\n259:         return name;\n260:     }\n261: } /* end class UMLCollaborationDiagram */\n262: ",
