port org.tigris.gef.base.Editor;\n34: import org.tigris.gef.base.Globals;\n35: import org.tigris.gef.base.ModeCreate;\n36: import org.tigris.gef.graph.GraphModel;\n37: import org.tigris.gef.graph.MutableGraphModel;\n38: import org.tigris.gef.presentation.Fig;\n39: import org.tigris.gef.presentation.FigLine;\n40: import org.tigris.gef.presentation.FigNode;\n41: \n42: /**\n43:  * Mode to create a link between two figobjects. This mode extends\n44:  * ModeCreate and not ModeCreateEdge because ModeCreateEdge hides its\n45:  * variables a bit too much...\n46:  *\n47:  * @author jaap.branderhorst@xs4all.nl\n48:  */\n49: public class ModeCreateLink extends ModeCreate {\n50: \n51:     private static final Logger LOG =\n52: \tLogger.getLogger(ModeCreateLink.class);\n53: \n54:     /** The NetPort where the arc is paintn from */\n55:     private Object startPort;\n56: \n57:     /** The Fig that presents the starting NetPort */\n58:     private Fig startPortFig;\n59: \n60:     /** The FigNode on the NetNode that owns the start port */\n61:     private FigNode sourceFigNode;\n62: \n63:     /** The new NetEdge that is being created */\n64:     private Object newEdge;\n65: \n66:     /**\n67:      * The constructor.\n68:      *\n69:      */\n70:     public ModeCreateLink() {\n71:         super();\n72:     }\n73: \n74:     /**\n75:      * The constructor.\n76:      *\n77:      * @param par the editor\n78:      */\n79:     public ModeCreateLink(Editor par) {\n80:         super(par);\n81:     }\n82: \n83:     /**\n84:      * @see org.tigris.gef.base.ModeCreate#createNewItem(\n85:      * java.awt.event.MouseEvent, int, int)\n86:      */\n87:     public Fig createNewItem(MouseEvent me, int snapX, int snapY) {\n88:         return new FigLine(\n89:             snapX,\n90:             snapY,\n91:             me.getX(),\n92:             snapY,\n93:             Globals.getPrefs().getRubberbandColor());\n94:     }\n95: \n96:     /**\n97:      * @see org.tigris.gef.base.FigModifyingMode#instructions()\n98:      */\n99:     public String instructions() {\n100:         return \"Drag to define a link to another port\";\n101:     }\n102: \n103:     /**\n104:      * On mousePressed determine what port the user is dragging from.\n105:      * The mousePressed event is sent via ModeSelect.\n106:      *\n107:      * @see java.awt.event.MouseListener#mousePressed(java.awt.event.MouseEvent)\n108:      */\n109:     public void mousePressed(MouseEvent me) {\n110:         if (me.isConsumed())\n111:             return;\n112:         int x = me.getX(), y = me.getY();\n113:         Editor ce = Globals.curEditor();\n114:         Fig underMouse = ce.hit(x, y);\n115:         if (underMouse == null) {\n116:             underMouse = ce.hit(x - 16, y - 16, 32, 32);\n117:         }\n118:         if (underMouse == null) {\n119:             done();\n120:             me.consume();\n121:             return;\n122:         }\n123:         if (!(underMouse instanceof FigNode)) {\n124:             done();\n125:             me.consume();\n126:             return;\n127:         }\n128:         sourceFigNode = (FigNode) underMouse;\n129:         startPort = sourceFigNode.deepHitPort(x, y);\n130:         if (startPort == null) {\n131:             done();\n132:             me.consume();\n133:             return;\n134:         }\n135:         startPortFig = sourceFigNode.getPortFig(startPort);\n136:         start();\n137:         Point snapPt = new Point();\n138:         synchronized (snapPt) {\n139:             snapPt.setLocation(\n140:                 startPortFig.getX() + FigObject.WIDTH / 2,\n141:                 startPortFig.getY());\n142:             editor.snap(snapPt);\n143:             anchorX = snapPt.x;\n144:             anchorY = snapPt.y;\n145:         }\n146:         _newItem = createNewItem(me, anchorX, anchorY);\n147:         me.consume();\n148:         setCursor(Cursor.getPredefinedCursor(Cursor.CROSSHAIR_CURSOR));\n149:     }\n150: \n151:     /**\n152:      * On mouseReleased, find the port in the destination node that's\n153:      * on the same height as the source port fig, ask the GraphModel\n154:      * to connect the two ports.  If that connection is allowed, then\n155:      * construct a new FigEdge and add it to the Layer and send it to\n156:      * the back.\n157:      *\n158:      * @see java.awt.event.MouseListener#mouseReleased(java.awt.event.MouseEvent)\n159:      */\n160:     public void mouseReleased(MouseEvent me) {\n161:         if (me.isConsumed())\n162:             return;\n163:         if (sourceFigNode == null) {\n164:             done();\n165:             me.consume();\n166:             return;\n167:         }\n168: \n169:         int x = me.getX(), y = me.getY();\n170:         Editor ce = Globals.curEditor();\n171:         Fig f = ce.hit(x, y);\n172:         if (f == null) {\n173:             f = ce.hit(x - 16, y - 16, 32, 32);\n174:         }\n175:         GraphModel gm = ce.getGraphModel();\n176:         if (!(gm instanceof MutableGraphModel))\n177:             f = null;\n178:         MutableGraphModel mgm = (MutableGraphModel) gm;\n179:         // TODO: potential class cast exception\n180:         if (f == sourceFigNode) {\n181:             done();\n182:             me.consume();\n183:             return;\n184:         }\n185:         if (f instanceof FigNode) {\n186:             FigNode destFigNode = (FigNode) f;\n187:             // If its a FigNode, then check within the\n188:             // FigNode to see if a port exists\n189:             Object foundPort = null;\n190:             if (destFigNode != sourceFigNode) {\n191:                 y = startPortFig.getY();\n192:                 foundPort = destFigNode.deepHitPort(x, y);\n193:             } else {\n194:                 foundPort = destFigNode.deepHitPort(x, y);\n195:             }\n196: \n197:             if (foundPort != null && foundPort != startPort) {\n198:                 Fig destPortFig = destFigNode.getPortFig(foundPort);\n199:                 Object edgeType = getArg(\"edgeClass\");\n200:                 if (edgeType != null) {\n201:                     newEdge =\n202:                         mgm.connect(startPort, foundPort, (Class) edgeType);\n203:                 } else {\n204:                     newEdge = mgm.connect(startPort, foundPort);\n205:                 }\n206: \n207:                 // Calling connect() will add the edge to the GraphModel and\n208:                 // any LayerPersectives on that GraphModel will get a\n209:                 // edgeAdded event and will add an appropriate FigEdge\n210:                 // (determined by the GraphEdgeRenderer).\n211: \n212:                 if (null != newEdge) {\n213:                     ce.damaged(_newItem);\n214:                     sourceFigNode.damage();\n215:                     destFigNode.damage();\n216:                     _newItem = null;\n217:                     FigMessage fe =\n218:                         (FigMessage) ce.getLayerManager()\n219:                             .getActiveLayer().presentationFor(newEdge);\n220:                     fe.setSourcePortFig(startPortFig);\n221:                     fe.setSourceFigNode(sourceFigNode);\n222:                     fe.setDestPortFig(destPortFig);\n223:                     fe.setDestFigNode(destFigNode);\n224: \t\t\t\t// set the new edge in place\n225:                     if (sourceFigNode != null)\n226:                         sourceFigNode.updateEdges();\n227:                     if (destFigNode != null)\n228:                         destFigNode.updateEdges();\n229:                     if (fe != null)\n230:                         ce.getSelectionManager().select(fe);\n231:                     done();\n232:                     me.consume();\n233:                     return;\n234:                 } else\n235:                     LOG.debug(\"connection return null\");\n236:             }\n237:         }\n238:         sourceFigNode.damage();\n239:         ce.damaged(_newItem);\n240:         _newItem = null;\n241:         done();\n242:         me.consume();\n243:     }\n244: \n245:     /**\n246:      * @see java.awt.event.MouseMotionListener#mouseDragged(java.awt.event.MouseEvent)\n247:      */\n248:     public void mouseDragged(MouseEvent me) {\n249:         if (me.isConsumed())\n250:             return;\n251:         if (_newItem != null) {\n252:             editor.damaged(_newItem);\n253:             creationDrag(me.getX(), startPortFig.getY());\n254:             editor.damaged(_newItem);\n255:         }\n256:         editor.scrollToShow(me.getX(), startPortFig.getY());\n257:         me.consume();\n258:     }\n259: } /* end class ModeCreateEdge */\n260: ",
