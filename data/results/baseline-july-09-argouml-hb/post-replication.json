er;\n32: import java.util.ArrayList;\n33: import java.util.Iterator;\n34: import java.util.List;\n35: import java.util.Vector;\n36: \n37: import javax.swing.JPanel;\n38: import javax.swing.JTabbedPane;\n39: import javax.swing.event.ChangeEvent;\n40: import javax.swing.event.ChangeListener;\n41: \n42: import org.apache.log4j.Category;\n43: import org.argouml.application.api.Argo;\n44: import org.argouml.application.api.QuadrantPanel;\n45: import org.argouml.swingext.Horizontal;\n46: import org.argouml.ui.targetmanager.TargetEvent;\n47: import org.argouml.ui.targetmanager.TargetListener;\n48: import org.argouml.ui.targetmanager.TargetManager;\n49: import org.argouml.uml.diagram.ui.TabDiagram;\n50: import org.argouml.uml.ui.TabModelTarget;\n51: import org.argouml.util.ConfigLoader;\n52: import org.tigris.gef.base.Diagram;\n53: import org.tigris.gef.base.Editor;\n54: import org.tigris.gef.graph.presentation.JGraph;\n55: import org.tigris.gef.presentation.Fig;\n56: \n57: /** The upper right pane in the Argo/UML user interface.  It has\n58:  *  several tabs with different kinds of \"major\" editors that allow\n59:  *  the user to edit whatever is selected in the NavigatorPane. */\n60: \n61: public class MultiEditorPane\n62:     extends JPanel\n63:     implements ChangeListener, MouseListener, QuadrantPanel, TargetListener {\n64:     protected static Category cat = Category.getInstance(MultiEditorPane.class);\n65: \n66:     ////////////////////////////////////////////////////////////////\n67:     // instance variables\n68: \n69:     protected Object _target;\n70:     protected JTabbedPane _tabs = new JTabbedPane(JTabbedPane.BOTTOM);\n71:     protected Editor _ed;\n72:     // protected ForwardingPanel _awt_comp;\n73:     protected Vector _tabPanels = new Vector();\n74:     protected Component _lastTab;\n75: \n76:     ////////////////////////////////////////////////////////////////\n77:     // constructors\n78: \n79:     /**\n80:      * Constructs the MultiEditorPane. This is the pane in which the tabs with\n81:      * the diagrams are drawn in ArgoUML. The MultiEditorPane is a JTabbedPane\n82:      * that holds 0-* JPanels that can show several editors but only show one\n83:      * editor at the moment (argouml version 0.13.3). With this editor diagrams\n84:      * can be edited.\n85:      */\n86:     public MultiEditorPane() {\n87:         Argo.log.info(\"making MultiEditorPane\");\n88:         ConfigLoader.loadTabs(_tabPanels, \"multi\", Horizontal.getInstance());\n89: \n90:         setLayout(new BorderLayout());\n91:         add(_tabs, BorderLayout.CENTER);\n92: \n93:         // _tabs.addChangeListener(this);\n94:         for (int i = 0; i < _tabPanels.size(); i++) {\n95:             String title = \"tab\";\n96:             JPanel t = (JPanel) _tabPanels.elementAt(i);\n97:             if (t instanceof TabSpawnable)\n98:                 title = ((TabSpawnable) t).getTitle();\n99:             _tabs.addTab(\"As \" + title, t);\n100:             _tabs.setEnabledAt(i, false);\n101:             if (t instanceof TargetListener) {\n102:                 TargetManager.getInstance().addTargetListener((TargetListener)t);\n103:             }\n104:         } /* end for */\n105: \n106:         \n107: \n108:         _tabs.addChangeListener(this);\n109:         _tabs.addMouseListener(this);\n110:         setTarget(null);\n111:     }\n112:     \n113:     public Dimension getPreferredSize() {\n114:         return new Dimension(400, 500);\n115:     }\n116:     public Dimension getMinimumSize() {\n117:         return new Dimension(100, 100);\n118:     }\n119: \n120:     /**\n121:      * Sets the target of the multieditorpane. The multieditorpane can have several \n122:      * tabs. If a tab is an instance of tabmodeltarget (that is a tab that displays\n123:      * model elements) that tab should display the target if the target is an \n124:      * ArgoDiagram.\n125:      * @param target\n126:      * @deprecated As of ArgoUml version 0.13.5, \n127:      *             this method will change visibility in the near future\n128:      */\n129:     public void setTarget(Object target) {\n130:         enableTabs(target);\n131:         for (int i = 0; i < _tabs.getTabCount(); i++) {\n132:             Component tab = _tabs.getComponentAt(i);\n133:             if (tab.isEnabled()) {\n134:                 _tabs.setSelectedComponent(tab);\n135:                 break;\n136:             }\n137:         }       \n138:     }\n139:     \n140:     /**\n141:      * Enables the tabs on the MultiEditorPane depending on the result of its\n142:      * shouldBeEnabled method.\n143:      * @param target The target for which the shouldBeEnabled test should hold true.\n144:      */\n145:     private void enableTabs(Object target) {\n146:         for (int i = 0; i < _tabs.getTabCount(); i++) {\n147:             Component tab = _tabs.getComponentAt(i);\n148:             if (tab instanceof TabTarget) {\n149:                 TabTarget targetTab = (TabTarget)tab;\n150:                 boolean shouldBeEnabled = targetTab.shouldBeEnabled(target);\n151:                 _tabs.setEnabledAt(i, shouldBeEnabled);                \n152:             }\n153:         }\n154:     }\n155:     \n156:     \n157:     /**\n158:      * Returns the current target of the multieditorpane.\n159:      * TODO: check if the target is needed for the multieditorpane as an\n160:      * instance variable.\n161:      * @return Object\n162:      * @deprecated As of ArgoUml version 0.13.5, \n163:      *             use {@link org.argouml.ui.targetmanager.TargetManager.getTarget() TargetManager.getInstance().getTarget()} instead\n164:      */\n165:     public Object getTarget() {\n166:         return TargetManager.getInstance().getTarget();\n167:     }\n168: \n169:     ////////////////////////////////////////////////////////////////\n170:     // actions\n171: \n172:     /**\n173:      * Returns the index of a tab with a certain name in the JTabbedPane which\n174:      * is the component shown by the multieditorpane. At the moment (version\n175:      * 0.13.3 of ArgoUML) there is only 1 tab, the Diagram tab.\n176:      */\n177:     public int getIndexOfNamedTab(String tabName) {\n178:         for (int i = 0; i < _tabPanels.size(); i++) {\n179:             String title = _tabs.getTitleAt(i);\n180:             if (title != null && title.equals(tabName))\n181:                 return i;\n182:         }\n183:         return -1;\n184:     }\n185: \n186:     /**\n187:      * Selects a certain tab and shows it. At the moment (version\n188:      * 0.13.3 of ArgoUML) there is only 1 tab, the Diagram tab.\n189:      * @param tabName\n190:      */\n191:     public void selectTabNamed(String tabName) {\n192:         int index = getIndexOfNamedTab(tabName);\n193:         if (index != -1)\n194:             _tabs.setSelectedIndex(index);\n195:     }\n196: \n197:     /**\n198:      * Selects the next tab in the JTabbedPane. At the moment (version 0.13.3 of\n199:      * ArgoUML) there is only 1 tab, the Diagram tab.\n200:      */\n201:     public void selectNextTab() {\n202:         int size = _tabPanels.size();\n203:         int currentTab = _tabs.getSelectedIndex();\n204:         for (int i = 1; i < _tabPanels.size(); i++) {\n205:             int newTab = (currentTab + i) % size;\n206:             if (_tabs.isEnabledAt(newTab)) {\n207:                 _tabs.setSelectedIndex(newTab);\n208:                 return;\n209:             }\n210:         }\n211:     }\n212: \n213:     /**\n214:      * Selects a Fig on a TabDiagram if the TabDiagram is currently shown. \n215:      * @param o The Fig or the owner of the Fig to select.\n216:      *\n217:      * @deprecated As of ArgoUml version 0.13.5,\n218:      *             The tabdiagram arranges for it's own selection now via \n219:      *             it's {@link org.argouml.ui.targetmanager.TargetListener}.\n220:      */\n221:     public void select(Object o) {\n222:         Component curTab = _tabs.getSelectedComponent();\n223:         if (curTab instanceof TabDiagram) {\n224:             JGraph jg = ((TabDiagram) curTab).getJGraph();\n225:             if (jg.getEditor().getLayerManager().getContents().contains(o))\n226:                 jg.selectByOwnerOrFig(o);\n227:         }\n228:         //TODO: handle tables\n229:     }\n230: \n231:     \n232: \n233: \n234:       /**\n235:        *  called when the user selects a tab, by clicking or otherwise. \n236:        */\n237:     public void stateChanged(ChangeEvent  e) {\n238:         //TODO: should fire its own event and ProjectBrowser\n239:         //should register a listener\n240:         if (_lastTab != null) {\n241:             _lastTab.setVisible(false);\n242:         }\n243:         _lastTab = _tabs.getSelectedComponent();\n244:         cat.debug(\n245:             \"MultiEditorPane state changed:\" + _lastTab.getClass().getName());\n246:         _lastTab.setVisible(true);\n247:         if (_lastTab instanceof TabModelTarget)\n248:              ((TabModelTarget) _lastTab).refresh();\n249:     }\n250: \n251:     public void mousePressed(MouseEvent me) {\n252:     }\n253:     public void mouseReleased(MouseEvent me) {\n254:     }\n255:     public void mouseEntered(MouseEvent me) {\n256:     }\n257:     public void mouseExited(MouseEvent me) {\n258:     }\n259: \n260:     /**\n261:      * Catches a mouseevent and calls mySingleClick and myDoubleClick if a tab\n262:      * is clicked which is selected.\n263:      * @see java.awt.event.MouseListener#mouseClicked(MouseEvent)\n264:      */\n265:     public void mouseClicked(MouseEvent me) {\n266:         int tab = _tabs.getSelectedIndex();\n267:         if (tab != -1) {\n268:             Rectangle tabBounds = _tabs.getBoundsAt(tab);\n269:             if (!tabBounds.contains(me.getX(), me.getY()))\n270:                 return;\n271:             if (me.getClickCount() == 1) {\n272:                 mySingleClick(tab);\n273:                 me.consume();\n274:             } else if (me.getClickCount() >= 2) {\n275:                 myDoubleClick(tab);\n276:                 me.consume();\n277:             }\n278:         }\n279:     }\n280: \n281:     /** called when the user clicks once on a tab. */\n282:     public void mySingleClick(int tab) {\n283:         //TODO: should fire its own event and ProjectBrowser\n284:         //should register a listener\n285:         cat.debug(\"single: \" + _tabs.getComponentAt(tab).toString());\n286:     }\n287: \n288:     /**\n289:      * When the user double clicks on a tab, this tab is spawned by this method\n290:      * if it is selected.\n291:      * @param tab\n292:      */\n293:     public void myDoubleClick(int tab) {\n294:         //TODO: should fire its own event and ProjectBrowser\n295:         //should register a listener\n296:         cat.debug(\"double: \" + _tabs.getComponentAt(tab).toString());\n297:         JPanel t = (JPanel) _tabPanels.elementAt(tab);\n298:         if (t instanceof TabSpawnable)\n299:              ((TabSpawnable) t).spawn();\n300:     }\n301: \n302:     public int getQuadrant() {\n303:         return Q_TOP_RIGHT;\n304:     }\n305: \n306:     /**\n307:      * Removes all figs from all diagrams for some object obj. Does not remove \n308:      * the owner of the objects (does not do a call to dispose).\n309:      * TODO move this to ProjectManager for example, in any case: out of the GUI\n310:      * @param obj\n311:      */\n312:     public void removePresentationFor(Object obj, Vector diagrams) {\n313:         for (int i = 0; i < _tabs.getComponentCount(); i++) {\n314:             Component comp = _tabs.getComponentAt(i);\n315:             if (comp instanceof TabDiagram) {\n316:                 TabDiagram tabDia = (TabDiagram) comp;\n317:                 Object oldDia = tabDia.getTarget();\n318:                 Iterator it = diagrams.iterator();\n319:                 while (it.hasNext()) {\n320:                     Diagram diagram = (Diagram) it.next();\n321:                     Fig aFig = diagram.presentationFor(obj);\n322:                     if (aFig != null) {\n323:                         tabDia.getJGraph().setDiagram(diagram);\n324:                         if (aFig.getOwner() == obj) {\n325:                             aFig.delete();\n326:                         }\n327:                     }\n328:                 }\n329:             }\n330:         }\n331:     }\n332: \n333:     /**\n334:      * Returns a list with all figs for some object o on the given diagrams.\n335:      * TODO move this to ProjectManager for example, in any case: out of the GUI\n336:      * @param o\n337:      * @param diagrams\n338:      * @return List\n339:      */\n340:     public List findPresentationsFor(Object o, Vector diagrams) {\n341:         List returnList = new ArrayList();\n342:         for (int i = 0; i < _tabs.getComponentCount(); i++) {\n343:             Component comp = _tabs.getComponentAt(i);\n344:             if (comp instanceof TabDiagram) {\n345:                 TabDiagram tabDia = (TabDiagram) comp;\n346:                 Object oldDia = tabDia.getTarget();\n347:                 Iterator it = diagrams.iterator();\n348:                 while (it.hasNext()) {\n349:                     Diagram diagram = (Diagram) it.next();\n350:                     Fig aFig = diagram.presentationFor(o);\n351:                     if (aFig != null)\n352:                         returnList.add(aFig);\n353:                 }\n354:             }\n355:         }\n356:         return returnList;\n357:     }\n358: \n359: \t/**\n360:      * @see org.argouml.ui.targetmanager.TargetListener#targetAdded(org.argouml.ui.targetmanager.TargetEvent)\n361:      */\n362:     public void targetAdded(TargetEvent e) {\n363:         // we can neglect this, the MultiEditorPane allways selects the first target\n364:         // in a set of targets. The first target can only be \n365:         // changed in a targetRemoved or a TargetSet event\n366:     }\n367: \n368:     /**\n369:      * @see org.argouml.ui.targetmanager.TargetListener#targetRemoved(org.argouml.ui.targetmanager.TargetEvent)\n370:      */\n371:     public void targetRemoved(TargetEvent e) {\n372:         // how to handle empty target lists?\n373:         // probably the MultiEditorPane should only show an empty pane in that case\n374:         setTarget(e.getNewTargets()[0]);\n375:     }\n376: \n377:     /**\n378:      * @see org.argouml.ui.targetmanager.TargetListener#targetSet(org.argouml.ui.targetmanager.TargetEvent)\n379:      */\n380:     public void targetSet(TargetEvent e) {\n381:         setTarget(e.getNewTargets()[0]);\n382:     }\n383: \n384: }\n385: \n386: /* end class MultiEditorPane */\n387: ",
