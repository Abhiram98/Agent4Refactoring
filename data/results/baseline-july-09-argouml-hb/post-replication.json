n32: import java.io.OutputStreamWriter;\n33: import java.io.PrintWriter;\n34: import java.io.Writer;\n35: import java.net.URL;\n36: import java.util.ArrayList;\n37: import java.util.Collection;\n38: import java.util.HashMap;\n39: import java.util.Iterator;\n40: \n41: import org.apache.log4j.Logger;\n42: import org.argouml.application.ArgoVersion;\n43: import org.argouml.application.api.Argo;\n44: import org.argouml.application.api.Configuration;\n45: import org.argouml.kernel.Project;\n46: import org.argouml.kernel.ProjectMember;\n47: import org.argouml.model.Facade;\n48: import org.argouml.model.Model;\n49: import org.argouml.model.UmlException;\n50: import org.argouml.model.XmiException;\n51: import org.argouml.model.XmiReader;\n52: import org.argouml.model.XmiWriter;\n53: import org.argouml.ui.ArgoDiagram;\n54: import org.argouml.uml.ProjectMemberModel;\n55: import org.argouml.uml.cognitive.ProjectMemberTodoList;\n56: import org.argouml.uml.diagram.DiagramFactory;\n57: import org.argouml.uml.diagram.ProjectMemberDiagram;\n58: import org.argouml.uml.diagram.activity.ui.UMLActivityDiagram;\n59: import org.argouml.uml.diagram.state.ui.UMLStateDiagram;\n60: import org.argouml.uml.diagram.static_structure.ui.UMLClassDiagram;\n61: import org.xml.sax.InputSource;\n62: \n63: /**\n64:  * The file persister for the UML model.\n65:  * @author Bob Tarling\n66:  */\n67: class ModelMemberFilePersister extends MemberFilePersister \n68:     implements XmiExtensionParser {\n69: \n70:     /**\n71:      * Logger.\n72:      */\n73:     private static final Logger LOG =\n74:         Logger.getLogger(ModelMemberFilePersister.class);\n75: \n76:     /**\n77:      * Loads a model (XMI only) from an input source. BE ADVISED this\n78:      * method has a side effect. It sets _UUIDREFS to the model.<p>\n79:      *\n80:      * If there is a problem with the xmi file, an error is set in the\n81:      * getLastLoadStatus() field. This needs to be examined by the\n82:      * calling function.<p>\n83:      *\n84:      * @see org.argouml.persistence.MemberFilePersister#load(org.argouml.kernel.Project,\n85:      * java.io.InputStream)\n86:      */\n87:     public void load(Project project, InputStream inputStream)\n88:         throws OpenException {\n89: \n90:         InputSource source = new InputSource(inputStream);\n91:         Object mmodel = null;\n92: \n93:         // 2002-07-18\n94:         // Jaap Branderhorst\n95:         // changed the loading of the projectfiles to solve hanging\n96:         // of argouml if a project is corrupted. Issue 913\n97:         // Created xmireader with method getErrors to check if parsing went well\n98:         try {\n99:             source.setEncoding(PersistenceManager.getEncoding());\n100:             readModels(project, source);\n101:             mmodel = getCurModel();\n102:         } catch (OpenException e) {\n103:             PersistenceManager.getInstance().setLastLoadStatus(false);\n104:             PersistenceManager.getInstance().setLastLoadMessage(\n105:                     \"UmlException parsing XMI.\");\n106:             LOG.error(\"UmlException caught\", e);\n107:             throw e;\n108:         }\n109:         // This should probably be inside xmiReader.parse\n110:         // but there is another place in this source\n111:         // where XMIReader is used, but it appears to be\n112:         // the NSUML XMIReader.  When Argo XMIReader is used\n113:         // consistently, it can be responsible for loading\n114:         // the listener.  Until then, do it here.\n115:         Model.getUmlHelper().addListenersToModel(mmodel);\n116: \n117:         project.addMember(mmodel);\n118: \n119:         project.setUUIDRefs(new HashMap(getUUIDRefs()));\n120:     }\n121: \n122:     /*\n123:      * @see org.argouml.persistence.MemberFilePersister#getMainTag()\n124:      */\n125:     public String getMainTag() {\n126:         return \"XMI\";\n127:     }\n128: \n129:     /**\n130:      * Save the project model to XMI.\n131:      *\n132:      * @see org.argouml.persistence.MemberFilePersister#save(\n133:      *         org.argouml.kernel.ProjectMember, java.io.Writer,\n134:      *         java.lang.Integer)\n135:      */\n136:     public void save(ProjectMember member, Writer w, Integer xmlFragment)\n137:     \tthrows SaveException {\n138: \n139:         if (w == null) {\n140:             throw new IllegalArgumentException(\"No Writer specified!\");\n141:         }\n142: \n143:         try {\n144:             ProjectMemberModel pmm = (ProjectMemberModel) member;\n145:             Object model = pmm.getModel();\n146: //            XmiWriter xmiWriter = \n147: //                Model.getXmiWriter(model, w, \n148: //                        ArgoVersion.getVersion() + \"(\" \n149: //                        + UmlFilePersister.PERSISTENCE_VERSION + \")\");\n150: //            LOG.info(\"Registering extension writer to XmiWriter\");\n151: //            //xmiWriter.setXmiExtensionWriter(this);\n152: //            xmiWriter.write();\n153:             \n154:             \n155:             if (xmlFragment != null) {\n156:                 // If we have an indent then we are adding this file\n157:                 // to a superfile.\n158:                 // That is most likely inserting the XMI into the .uml file\n159:                 File tempFile = File.createTempFile(\"xmi\", null);\n160:                 tempFile.deleteOnExit();\n161: \n162:                 Writer writer =\n163:                     new BufferedWriter(\n164:                         new OutputStreamWriter(\n165:                                 new FileOutputStream(tempFile), \"UTF-8\"));\n166:                 XmiWriter xmiWriter = \n167:                     Model.getXmiWriter(model, writer, \n168:                             ArgoVersion.getVersion() + \"(\" \n169:                             + UmlFilePersister.PERSISTENCE_VERSION + \")\");\n170:                 \n171:                 xmiWriter.write();\n172:                 addXmlFileToWriter((PrintWriter) w, tempFile,\n173:                                    xmlFragment.intValue());\n174:             } else {\n175:                 // Othewise we are writing into a zip writer or to XMI.\n176:                 XmiWriter xmiWriter = \n177:                     Model.getXmiWriter(model, w, \n178:                             ArgoVersion.getVersion() + \"(\" \n179:                             + UmlFilePersister.PERSISTENCE_VERSION + \")\");\n180:                 xmiWriter.write();\n181:             }\n182:         } catch (IOException e) {\n183:             throw new SaveException(e);\n184:         } catch (UmlException e) {\n185:             throw new SaveException(e);\n186:         }\n187: \n188:     }\n189:     \n190:     /**\n191:      * Get a MemberFilePersister based on a given ProjectMember.\n192:      *\n193:      * @param pm the project member\n194:      * @return the persister\n195:      */\n196:     protected MemberFilePersister getMemberFilePersister(ProjectMember pm) {\n197:         MemberFilePersister persister = null;\n198:         if (pm instanceof ProjectMemberDiagram) {\n199:             persister =\n200:                 PersistenceManager.getInstance()\n201:                     .getDiagramMemberFilePersister();\n202:         } else if (pm instanceof ProjectMemberTodoList) {\n203:             persister = new TodoListMemberFilePersister();\n204:         }\n205:         return persister;\n206:     }\n207: \n208:     public void parse(String label, String xmiExtensionString) {\n209:         LOG.info(\"Parsing an extension for \" + label);\n210:     }\n211:     \n212:     private Object curModel;\n213:     private Project proj;\n214:     private HashMap uUIDRefs;\n215: \n216:     private Collection elementsRead;\n217: \n218:     ////////////////////////////////////////////////////////////////\n219:     // accessors\n220: \n221:     /**\n222:      * @return the current model\n223:      */\n224:     public Object getCurModel() {\n225:         return curModel;\n226:     }\n227: \n228:     /**\n229:      * @param p the project\n230:      */\n231:     public void setProject(Project p) {\n232:         proj = p;\n233:     }\n234: \n235:     /**\n236:      * Return XMI id to object map for the most recently read XMI file.\n237:      * \n238:      * @return the UUID\n239:      */\n240:     public HashMap getUUIDRefs() {\n241:         return uUIDRefs;\n242:     }\n243: \n244:     ////////////////////////////////////////////////////////////////\n245:     // main parsing methods\n246: \n247:     /**\n248:      * Read an XMI file from the given URL.\n249:      *\n250:      * @param p the project\n251:      * @param url the URL\n252:      * @param xmiExtensionParser the XmiExtensionParser\n253:      * @throws OpenException when there is an IO error\n254:      */\n255:     public synchronized void readModels(Project p, URL url,\n256:             XmiExtensionParser xmiExtensionParser) throws OpenException {\n257:         LOG.info(\"=======================================\");\n258:         LOG.info(\"== READING MODEL \" + url);\n259:         try {\n260:             InputSource source = new InputSource(new XmiInputStream(\n261:                     url.openStream(), xmiExtensionParser, 10000000, 100000));\n262:             \n263:             source.setSystemId(url.toString());\n264:             readModels(p, source);\n265:         } catch (IOException ex) {\n266:             throw new OpenException(ex);\n267:         }\n268:     }\n269: \n270:     /**\n271:      * Read a XMI file from the given inputsource.\n272:      * @param p Project to which load the inputsource.\n273:      * @param source The InputSource\n274:      * @throws OpenException If an error occur while reading the source\n275:      */\n276:     public synchronized void readModels(Project p, InputSource source)\n277:         throws OpenException {\n278: \n279:         proj = p;\n280: \n281:         XmiReader reader = null;\n282:         try {\n283:             reader = Model.getXmiReader();\n284:             \n285:             if (Configuration.getBoolean(Argo.KEY_XMI_STRIP_DIAGRAMS, false)) {\n286:                 reader.setIgnoredElements(new String[] {\"UML:Diagram\"});\n287:             } else {\n288:                 reader.setIgnoredElements(null);\n289:             }\n290:             \n291:             curModel = null;\n292:             elementsRead = reader.parse(source, false);\n293:             if (elementsRead != null && !elementsRead.isEmpty()) {\n294:                 Facade facade = Model.getFacade();\n295:                 Object current;\n296:                 Iterator elements = elementsRead.iterator();\n297:                 while (elements.hasNext()) {\n298:                     current = elements.next();\n299:                     if (facade.isAModel(current)) {\n300:                         LOG.info(\"Loaded model '\" + facade.getName(current)\n301:                                  + \"'\");\n302:                         if (curModel == null) {\n303:                             curModel = current;\n304:                         }\n305:                     }\n306:                 }\n307:             }\n308:             uUIDRefs = new HashMap(reader.getXMIUUIDToObjectMap());\n309:         } catch (XmiException ex) {\n310:             throw new XmiFormatException(ex);\n311:         } catch (UmlException ex) {\n312:             // Could this be some other type of internal error that we want\n313:             // to handle differently?  Don't think so.  - tfm\n314:             throw new XmiFormatException(ex);\n315:         }\n316:         LOG.info(\"=======================================\");\n317:     }\n318: \n319:     /**\n320:      * Create and register diagrams for activity and statemachines in the\n321:      * model(s) of the project. If no other diagrams are created and atLeastOne\n322:      * is true, than a default Class Diagram will be created.  ArgoUML currently\n323:      * requires at least one diagram for proper operation.\n324:      * TODO: Move to XmiFilePersister (protected)\n325:      *\n326:      * @param project The project\n327:      */\n328:     public void registerDiagrams(Project project) {\n329:         Facade facade = Model.getFacade();\n330:         Collection diagramsElement = new ArrayList();\n331:         Iterator it = elementsRead.iterator();\n332:         while (it.hasNext()) {\n333:             Object element = it.next();\n334:             if (facade.isAModel(element)) {\n335:                 diagramsElement.addAll(Model.getModelManagementHelper()\n336:                         .getAllModelElementsOfKind(element,\n337:                                 Model.getMetaTypes().getStateMachine()));\n338:             } else if (facade.isAStateMachine(element)) {\n339:                 diagramsElement.add(element);\n340:             }\n341:         }\n342:         DiagramFactory diagramFactory = DiagramFactory.getInstance();\n343:         it = diagramsElement.iterator();\n344:         while (it.hasNext()) {\n345:             Object statemachine = it.next();\n346:             Object namespace = facade.getNamespace(statemachine);\n347:             if (namespace == null) {\n348:                 namespace = facade.getContext(statemachine);\n349:                 Model.getCoreHelper().setNamespace(statemachine, namespace);\n350:             }\n351:             ArgoDiagram diagram = null;\n352:             if (facade.isAActivityGraph(statemachine)) {\n353:                 LOG.info(\"Creating activity diagram for \"\n354:                         + facade.getUMLClassName(statemachine)\n355:                         + \"<<\" + facade.getName(statemachine) + \">>\");\n356:                 diagram =\n357:                     diagramFactory.createDiagram(UMLActivityDiagram.class,\n358:                                                  namespace, statemachine);\n359:             } else {\n360:                 LOG.info(\"Creating state diagram for \"\n361:                         + facade.getUMLClassName(statemachine)\n362:                         + \"<<\" + facade.getName(statemachine) + \">>\");\n363:                 diagram =\n364:                     diagramFactory.createDiagram(UMLStateDiagram.class,\n365:                                                  namespace, statemachine);\n366:             }\n367:             if (diagram != null) {\n368:                 proj.addMember(diagram);\n369:             }\n370:         }\n371:         // ISSUE 3516 : Make sure there is at least one diagram because\n372:         // ArgoUML requires it for correct operation\n373:         if (proj.getDiagramCount() < 1) {\n374:             ArgoDiagram d =\n375:                 diagramFactory.createDiagram(UMLClassDiagram.class,\n376:                                              curModel, null);\n377:             proj.addMember(d);\n378:         }\n379:         if (proj.getDiagramCount() >= 1 && proj.getActiveDiagram() == null) {\n380:             proj.setActiveDiagram((ArgoDiagram) proj.getDiagrams().get(0));\n381:         }\n382:     }\n383:     \n384:     /**\n385:      * Create and register diagrams for activity and statemachines in the\n386:      * model(s) of the project. If no other diagrams are created and atLeastOne\n387:      * is true, than a default Class Diagram will be created.  ArgoUML currently\n388:      * requires at least one diagram for proper operation.\n389:      *\n390:      * @param project\n391:      *            The project\n392:      * @param elements\n393:      *            Collection of top level model elements to process\n394:      * @param atLeastOne\n395:      *            If true, forces at least one diagram to be created.\n396:      * @deprecated in 0.23.3 use registerDiagrams(Project)\n397:      */\n398:     public void registerDiagrams(Project project, Collection elements,\n399:             boolean atLeastOne) {\n400:         Facade facade = Model.getFacade();\n401:         Collection diagramsElement = new ArrayList();\n402:         Iterator it = elements.iterator();\n403:         while (it.hasNext()) {\n404:             Object element = it.next();\n405:             if (facade.isAModel(element)) {\n406:                 diagramsElement.addAll(Model.getModelManagementHelper()\n407:                         .getAllModelElementsOfKind(element,\n408:                                 Model.getMetaTypes().getStateMachine()));\n409:             } else if (facade.isAStateMachine(element)) {\n410:                 diagramsElement.add(element);\n411:             }\n412:         }\n413:         DiagramFactory diagramFactory = DiagramFactory.getInstance();\n414:         it = diagramsElement.iterator();\n415:         while (it.hasNext()) {\n416:             Object statemachine = it.next();\n417:             Object namespace = facade.getNamespace(statemachine);\n418:             if (namespace == null) {\n419:                 namespace = facade.getContext(statemachine);\n420:                 Model.getCoreHelper().setNamespace(statemachine, namespace);\n421:             }\n422:             if (proj.getDiagramCount() == 0) {\n423:                 ArgoDiagram diagram = null;\n424:                 if (facade.isAActivityGraph(statemachine)) {\n425:                     LOG.info(\"Creating activity diagram for \"\n426:                             + facade.getUMLClassName(statemachine)\n427:                             + \"<<\" + facade.getName(statemachine) + \">>\");\n428:                     diagram =\n429:                         diagramFactory.createDiagram(UMLActivityDiagram.class,\n430:                                                      namespace, statemachine);\n431:                 } else {\n432:                     LOG.info(\"Creating state diagram for \"\n433:                             + facade.getUMLClassName(statemachine)\n434:                             + \"<<\" + facade.getName(statemachine) + \">>\");\n435:                     diagram =\n436:                         diagramFactory.createDiagram(UMLStateDiagram.class,\n437:                                                      namespace, statemachine);\n438:                 }\n439:                 if (diagram != null) {\n440:                     proj.addMember(diagram);\n441:                 }\n442:             }\n443:         }\n444:         // ISSUE 3516 : Make sure there is at least one diagram because\n445:         // ArgoUML requires it for correct operation\n446:         if (atLeastOne && proj.getDiagramCount() < 1) {\n447:             ArgoDiagram d =\n448:                 diagramFactory.createDiagram(UMLClassDiagram.class,\n449:                                              curModel, null);\n450:             proj.addMember(d);\n451:         }\n452:         if (proj.getDiagramCount() >= 1 && proj.getActiveDiagram() == null) {\n453:             proj.setActiveDiagram((ArgoDiagram) proj.getDiagrams().get(0));\n454:         }\n455:     }\n456: \n457:     /**\n458:      * @return Returns the elementsRead.\n459:      */\n460:     public Collection getElementsRead() {\n461:         return elementsRead;\n462:     }\n463: \n464:     /**\n465:      * @param elements The elementsRead to set.\n466:      */\n467:     public void setElementsRead(Collection elements) {\n468:         this.elementsRead = elements;\n469:     }\n470: }\n471: ",
