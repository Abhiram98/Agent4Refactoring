.ui.PropPanelUMLDeploymentDiagram;\n71: import org.argouml.uml.diagram.ui.PropPanelUMLSequenceDiagram;\n72: import org.argouml.uml.diagram.ui.PropPanelUMLStateDiagram;\n73: import org.argouml.uml.diagram.ui.PropPanelUMLUseCaseDiagram;\n74: import org.argouml.uml.diagram.use_case.ui.UMLUseCaseDiagram;\n75: import org.argouml.uml.ui.behavior.state_machines.PropPanelSimpleState;\n76: import org.argouml.uml.ui.foundation.core.PropPanelClass;\n77: import org.argouml.util.ConfigLoader;\n78: import org.tigris.gef.presentation.Fig;\n79: import org.tigris.gef.presentation.FigText;\n80: \n81: /**\n82:  * <p>\n83:  * This is the tab on the details panel (DetailsPane) that holds the property\n84:  * panel. On change of target, the property panel in TabProps is changed. \n85:  * </p>\n86:  * <p>\n87:  * With the introduction of the TargetManager, this class holds its original power\n88:  * of controlling its target. The property panels (subclasses of PropPanel) for\n89:  * which this class is the container are being registrated as TargetListeners in\n90:  * the setTarget method of this class. They are not registrated with TargetManager\n91:  * but with this class to prevent race-conditions while firing TargetEvents from\n92:  * TargetManager.\n93:  *</p>\n94:  * @author unknown\n95:  */\n96: public class TabProps\n97:     extends TabSpawnable\n98:     implements TabModelTarget, ArgoModuleEventListener {\n99:     protected static Logger cat = Logger.getLogger(TabProps.class);\n100:     ////////////////////////////////////////////////////////////////\n101:     // instance variables\n102:     protected boolean _shouldBeEnabled = false;\n103:     protected JPanel _blankPanel = new JPanel();\n104:     protected Hashtable _panels = new Hashtable();\n105:     protected JPanel _lastPanel = null;\n106:     protected String _panelClassBaseName = \"\";\n107: \n108:     private Object _target;\n109: \n110:     /**\n111:      * The list with targetlisteners, this are the property panels managed by TabProps\n112:      * It should only contain one listener at a time.\n113:      */\n114:     private EventListenerList _listenerList = new EventListenerList();\n115: \n116:     ////////////////////////////////////////////////////////////////\n117:     // constructor\n118:     public TabProps() {\n119:         this(\"tab.properties\", \"ui.PropPanel\");\n120:     }\n121: \n122:     public TabProps(String tabName, String panelClassBase) {\n123:         super(tabName);\n124:         TargetManager.getInstance().addTarget(this);\n125:         setOrientation(ConfigLoader.getTabPropsOrientation());\n126:         _panelClassBaseName = panelClassBase;\n127:         setLayout(new BorderLayout());\n128:         //setFont(new Font(\"Dialog\", Font.PLAIN, 10));\n129: \n130:         ArrayList list = Argo.getPlugins(PluggablePropertyPanel.class);\n131:         ListIterator iterator = list.listIterator();\n132:         while (iterator.hasNext()) {\n133:             Object o = iterator.next();\n134:             PluggablePropertyPanel ppp = (PluggablePropertyPanel) o;\n135:             _panels.put(ppp.getClassForPanel(), ppp.getPropertyPanel());\n136:         }\n137: \n138:         ArgoEventPump.addListener(ArgoEventTypes.ANY_MODULE_EVENT, this);\n139: \n140:         initPanels();\n141:     }\n142: \n143:     public void finalize() {\n144:         ArgoEventPump.removeListener(ArgoEventTypes.ANY_MODULE_EVENT, this);\n145:     }\n146: \n147:     /*\n148:      * Set the orientation of the property panel\n149:      * @param orientation the new orientation for this preoprty panel\n150:      */\n151:     public void setOrientation(Orientation orientation) {\n152:         super.setOrientation(orientation);\n153:         Enumeration pps = _panels.elements();\n154:         while (pps.hasMoreElements()) {\n155:             Object o = pps.nextElement();\n156:             if (o instanceof Orientable) {\n157:                 Orientable orientable = (Orientable) o;\n158:                 orientable.setOrientation(orientation);\n159:             }\n160:         }\n161:     }\n162: \n163:     /** Preload property panels that are commonly used within the first\n164:      *  few seconds after the tool is launched. */\n165:     protected void initPanels() {\n166: \n167:         _panels.put(ModelFacade.CLASS/*MClassImpl.class*/, new PropPanelClass());\n168:         _panels.put(ArgoDiagram.class, new PropPanelDiagram());\n169: \n170:         // Put all the diagram PropPanels here explicitly. They would eventually\n171:         // pick up their superclass ArgoDiagram, but in the meantime\n172:         // panelClassFor() would moan that they can't be found.\n173: \n174:         // Note that state digrams do actually have a diagram property panel!\n175: \n176:         _panels.put(UMLActivityDiagram.class, new PropPanelUMLActivityDiagram());\n177:         _panels.put(UMLClassDiagram.class, new PropPanelUMLClassDiagram());\n178:         _panels.put(UMLCollaborationDiagram.class, new PropPanelUMLCollaborationDiagram());\n179:         _panels.put(UMLDeploymentDiagram.class, new PropPanelUMLDeploymentDiagram());\n180:         _panels.put(UMLSequenceDiagram.class, new PropPanelUMLSequenceDiagram());\n181:         _panels.put(UMLStateDiagram.class, new PropPanelUMLStateDiagram());\n182:         _panels.put(UMLUseCaseDiagram.class, new PropPanelUMLUseCaseDiagram());\n183: \n184:         // FigText has no owner, so we do it directly\n185:         _panels.put(FigText.class, new PropPanelString());\n186:         // now a plugin\n187:         // _panels.put(MModelImpl.class, new PropPanelModel());\n188:         //_panels.put((Class)ModelFacade.USE_CASE/*MUseCaseImpl.class*/, new PropPanelUseCase());\n189:         //important: MStateImpl corresponds to PropPanelSimpleState not to PropPanelState!!\n190:         //otherwise, spawing will not ne successful!!\n191:         _panels.put(ModelFacade.STATEIMPL/*MStateImpl.class*/, new PropPanelSimpleState());       \n192:     }\n193: \n194:     /** Adds a property panel to the internal list. This allows a plugin to\n195:      *  add a register a new property panel an run-time. This property panel will then\n196:      *  be displayed in the detatils pane whenever an element of the given metaclass is\n197:      *  selected.\n198:      *\n199:      * @param c the metaclass whose details show be displayed in the property panel p\n200:      * @param p an instance of the property panel for the metaclass m\n201:      *\n202:      */\n203:     public void addPanel(Class c, PropPanel p) {\n204:         _panels.put(c, p);\n205:     }\n206: \n207:    \n208:     ////////////////////////////////////////////////////////////////\n209:     // accessors\n210:     /**\n211:      * Sets the target of the property panel. The given target t may either be a \n212:      * Diagram or a modelelement. If the target given is a Fig, a check is made if the fig has an owning modelelement and occurs on\n213:      * the current diagram. If so, that modelelement is the target.\n214:      *\n215:      * @deprecated As of ArgoUml version 0.13.5,\n216:      *             the visibility of this method will change in the future,\n217:      *             replaced by {@link org.argouml.ui.targetmanager.TargetManager}.\n218:      */\n219:     public void setTarget(Object t) {\n220:         // targets ought to be modelelements or diagrams \n221:         t = (t instanceof Fig) ? ((Fig) t).getOwner() : t;\n222:         if (!(t == null || ModelFacade.isABase(t) || t instanceof ArgoDiagram))\n223:             return;\n224: \n225:         if (_lastPanel != null) {\n226:             remove(_lastPanel);\n227:             if (_lastPanel instanceof TargetListener)\n228:                 removeTargetListener((TargetListener) _lastPanel);\n229:         }\n230:         _target = t;\n231:         if (t == null) {\n232:             add(_blankPanel, BorderLayout.CENTER);\n233:             _shouldBeEnabled = false;\n234:             _lastPanel = _blankPanel;\n235:         } else {\n236:             _shouldBeEnabled = true;\n237:             TabModelTarget newPanel = null;\n238:             Class targetClass = t.getClass();\n239:             while (newPanel == null) {\n240:                 newPanel = findPanelFor(targetClass);\n241:                 targetClass = targetClass.getSuperclass();\n242:                 if (targetClass == java.lang.Object.class)\n243:                     break;\n244:             }\n245:             if (newPanel != null) {\n246:                 addTargetListener(newPanel);\n247:             }\n248:             if (newPanel instanceof JPanel) {\n249:                 add((JPanel) newPanel, BorderLayout.CENTER);\n250:                 _shouldBeEnabled = true;\n251:                 _lastPanel = (JPanel) newPanel;\n252:             } else {\n253:                 add(_blankPanel, BorderLayout.CENTER);\n254:                 _shouldBeEnabled = false;\n255:                 _lastPanel = _blankPanel;\n256:             }\n257: \n258:         }\n259:     }\n260: \n261:     public void refresh() {\n262:         setTarget(TargetManager.getInstance().getTarget());\n263:     }\n264: \n265:     public TabModelTarget findPanelFor(Class targetClass) {\n266:         TabModelTarget p = (TabModelTarget) _panels.get(targetClass);\n267:         cat.info(\"Getting prop panel for:\" + targetClass + \", found (in cache?) \" + p);\n268:         if (p == null) {\n269:             Class panelClass = panelClassFor(targetClass);\n270:             if (panelClass == null)\n271:                 return null;\n272:             cat.info(\"panelClass for found: \" + panelClass);\n273:             try {\n274:                 // if a class is abstract we do not need to try\n275:                 // to instantiate it.\n276:                 if (Modifier.isAbstract(panelClass.getModifiers()))\n277:                     return null;\n278:                 p = (TabModelTarget) panelClass.newInstance();\n279:                 // moved next line inside try block to avoid filling the hashmap with\n280:                 // bogus values. \n281:                 _panels.put(targetClass, p);\n282:             }\n283:             // doubtfull if the next ones must be ignored.\n284:             catch (IllegalAccessException ignore) {\n285:                 cat.error(ignore);\n286:                 return null;\n287:             } catch (InstantiationException ignore) {\n288:                 cat.error(ignore);\n289:                 return null;\n290:             }\n291: \n292:         } else\n293:             cat.info(\"found props for \" + targetClass.getName());\n294:         return p;\n295:     }\n296: \n297:     public Class panelClassFor(Class targetClass) {\n298:         String panelClassName = \"\";\n299:         String pack = \"org.argouml.uml\";\n300:         String base = \"\";\n301: \n302:         String targetClassName = targetClass.getName();\n303:         cat.info(\"Trying to locate panel for: \" + targetClassName);\n304:         int lastDot = targetClassName.lastIndexOf(\".\");\n305: \n306:         //remove \"ru.novosoft.uml\"\n307:         if (lastDot > 0)\n308:             base = targetClassName.substring(16, lastDot + 1);\n309:         else\n310:             base = targetClassName.substring(16);\n311: \n312:         if (lastDot > 0)\n313:             targetClassName = targetClassName.substring(lastDot + 1);\n314: \n315:         if (targetClassName.startsWith(\"M\"))\n316:             targetClassName = targetClassName.substring(1); //remove M\n317:         if (targetClassName.endsWith(\"Impl\"))\n318:             targetClassName =\n319:                 targetClassName.substring(0, targetClassName.length() - 4);\n320:         //remove Impl\n321: \n322:         // This doesn't work for panel property tabs - they are being put in the\n323:         // wrong place. Really we should have defined these are preloaded them\n324:         // along with ArgoDiagram in initPanels above.\n325: \n326:         try {\n327:             panelClassName =\n328:                 pack + \".ui.\" + base + \"PropPanel\" + targetClassName;\n329:             cat.info(\"Looking for: \" + panelClassName);\n330:             return Class.forName(panelClassName);\n331:         } catch (ClassNotFoundException ignore) {\n332:             cat.error(\n333: \t\t      \"Class \" + panelClassName + \" for Panel not found!\",\n334: \t\t      ignore);\n335:         }\n336:         return null;\n337:     }\n338: \n339:     protected String getClassBaseName() {\n340:         return _panelClassBaseName;\n341:     }\n342: \n343:     /**\n344:      * Returns the current target.\n345:      * @deprecated As of ArgoUml version 0.13.5,\n346:      *             the visibility of this method will change in the future,\n347:      *             replaced by {@link org.argouml.ui.targetmanager.TargetManager#getTarget() TargetManager.getInstance().getTarget()}.\n348:      */\n349:     public Object getTarget() {\n350:         return _target;\n351:     }\n352: \n353:     /**\n354:      * Determines if the property panel should be enabled. Returns true if it\n355:      * should be enabled. The property panel should allways be enabled if the\n356:      * target is an instance of a modelelement or an argodiagram. If the target given\n357:      * is a Fig, a check is made if the fig has an owning modelelement and occurs on\n358:      * the current diagram. If so, that modelelement is the target.\n359:      * @see org.argouml.ui.TabTarget#shouldBeEnabled(Object)\n360:      */\n361:     public boolean shouldBeEnabled(Object target) {\n362:         target = (target instanceof Fig) ? ((Fig) target).getOwner() : target;\n363:         if (ModelFacade.isADiagram(target) || ModelFacade.isABase(target)) {\n364:             _shouldBeEnabled = true;\n365:         } else {\n366:             _shouldBeEnabled = false;\n367:         }\n368: \n369:         return _shouldBeEnabled;\n370:     }\n371: \n372:     public void moduleLoaded(ArgoModuleEvent event) {\n373:         if (event.getSource() instanceof PluggablePropertyPanel) {\n374:             PluggablePropertyPanel p =\n375:                 (PluggablePropertyPanel) event.getSource();\n376:             _panels.put(p.getClassForPanel(), p.getPropertyPanel());            \n377: \n378:         }\n379:     }\n380:     public void moduleUnloaded(ArgoModuleEvent event) {\n381:     }\n382:     public void moduleEnabled(ArgoModuleEvent event) {\n383:     }\n384:     public void moduleDisabled(ArgoModuleEvent event) {\n385:     }\n386: \n387:     /**\n388:      * @see org.argouml.ui.targetmanager.TargetListener#targetAdded(org.argouml.ui.targetmanager.TargetEvent)\n389:      */\n390:     public void targetAdded(TargetEvent e) {\n391:         setTarget(e.getNewTarget());\n392:         fireTargetAdded(e);\n393:         if (_listenerList.getListenerCount() > 0) {\n394:             validate();\n395:             repaint();\n396:         }\n397: \n398:     }\n399: \n400:     /**\n401:      * @see org.argouml.ui.targetmanager.TargetListener#targetRemoved(org.argouml.ui.targetmanager.TargetEvent)\n402:      */\n403:     public void targetRemoved(TargetEvent e) {\n404:         //setTarget(e.getNewTarget());\n405:         fireTargetRemoved(e);\n406:         //validate();\n407:         //repaint(); \n408:     }\n409: \n410:     /**\n411:      * @see org.argouml.ui.targetmanager.TargetListener#targetSet(org.argouml.ui.targetmanager.TargetEvent)\n412:      */\n413:     public void targetSet(TargetEvent e) {\n414:         setTarget(e.getNewTarget());\n415:         fireTargetSet(e);        \n416:         validate();\n417:         repaint();        \n418:     }\n419: \n420:     /**\n421:      * Adds a listener.\n422:      * @param listener the listener to add\n423:      */\n424:     private void addTargetListener(TargetListener listener) {\n425:         _listenerList.add(TargetListener.class, listener);\n426:     }\n427: \n428:     /**\n429:      * Removes a target listener.\n430:      * @param listener the listener to remove\n431:      */\n432:     private void removeTargetListener(TargetListener listener) {\n433:         _listenerList.remove(TargetListener.class, listener);\n434:     }\n435: \n436:     private void fireTargetSet(TargetEvent targetEvent) {\n437:         //      Guaranteed to return a non-null array\n438:         Object[] listeners = _listenerList.getListenerList();\n439:         for (int i = listeners.length - 2; i >= 0; i -= 2) {\n440:             if (listeners[i] == TargetListener.class) {\n441:                 // Lazily create the event:                     \n442: \t\t((TargetListener) listeners[i + 1]).targetSet(targetEvent);\n443:             }\n444:         }\n445:     }\n446: \n447:     private void fireTargetAdded(TargetEvent targetEvent) {\n448:         // Guaranteed to return a non-null array\n449:         Object[] listeners = _listenerList.getListenerList();\n450: \n451:         for (int i = listeners.length - 2; i >= 0; i -= 2) {\n452:             if (listeners[i] == TargetListener.class) {\n453:                 // Lazily create the event:                     \n454: \t\t((TargetListener) listeners[i + 1]).targetAdded(targetEvent);\n455:             }\n456:         }\n457:     }\n458: \n459:     private void fireTargetRemoved(TargetEvent targetEvent) {\n460:         // Guaranteed to return a non-null array\n461:         Object[] listeners = _listenerList.getListenerList();\n462:         for (int i = listeners.length - 2; i >= 0; i -= 2) {\n463:             if (listeners[i] == TargetListener.class) {\n464:                 // Lazily create the event:                     \n465:                 ((TargetListener) listeners[i + 1]).targetRemoved(targetEvent);\n466:             }\n467:         }\n468:     }\n469: \n470: } /* end class TabProps */\n471: \n472: ",
