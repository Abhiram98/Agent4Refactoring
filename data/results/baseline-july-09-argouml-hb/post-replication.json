ter);\n90: \t    \n91:             int retval = chooser.showOpenDialog(pb);\n92: \n93:             if (retval == 0) {\n94:                 File theFile = chooser.getSelectedFile();\n95:                 if (theFile != null) {\n96: \t\t    silk.Scheme.load(theFile.getCanonicalPath());\n97: \n98: \t\t    Symbol init = Symbol.intern(\"main\");      \n99: \t\t    if (init != null) {\n100: \t\t\tsilk.Scheme.eval(\n101: \t\t\t        new Pair(init,\n102: \t\t\t                new Pair(this, Pair.EMPTY)));\n103: \t\t    }\n104:                 }\n105:             }\n106:         } catch (Exception exception) {\n107:             LOG.error(\"Exception in ActionExecSilk\", exception);\n108:         }\n109:     }\n110: \n111: \n112: \n113:     /**\n114:      * @see org.argouml.application.api.ArgoModule#initializeModule()\n115:      */\n116:     public boolean initializeModule() {\n117:         boolean initialized = false;\n118: \ttry {\n119:             Class c = Class.forName(SILK_CLASS);\n120: \t    // Make sure we can instantiate it also.\n121: \t    c.newInstance();\n122:             LOG.info(\"JScheme scripting enabled!\");\n123: \t    initialized = true;\n124: \t} catch (Exception e) {\n125: \t    LOG.error(\"JScheme does not appear to be in the classpath.\");\n126: \t    LOG.error(\"Unable to initialize JScheme scripting plugin.\");\n127: \t}\n128:         return initialized;\n129:     }\n130: \n131:     /**\n132:      * @see org.argouml.application.api.PluggableMenu#buildContext(\n133:      *          javax.swing.JMenuItem, java.lang.String)\n134:      */\n135:     public Object[] buildContext(JMenuItem a, String b) {\n136:         return new Object[] {\n137: \t    a, b\n138: \t};\n139:     }\n140: \n141:     /**\n142:      * @see org.argouml.application.api.ArgoModule#setModuleEnabled(boolean)\n143:      */\n144:     public void setModuleEnabled(boolean enabled) { }\n145: \n146:     /**\n147:      * @see org.argouml.application.api.ArgoModule#isModuleEnabled()\n148:  