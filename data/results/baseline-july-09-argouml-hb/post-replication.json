33: import java.awt.Polygon;\n34: import java.awt.Rectangle;\n35: import java.beans.PropertyVetoException;\n36: import java.text.ParseException;\n37: import java.util.Iterator;\n38: import java.util.Vector;\n39: \n40: import org.argouml.application.api.Notation;\n41: import org.argouml.model.ModelFacade;\n42: import org.argouml.ui.ProjectBrowser;\n43: import org.argouml.uml.diagram.collaboration.ui.FigAssociationRole;\n44: import org.argouml.uml.generator.ParserDisplay;\n45: import org.tigris.gef.base.Layer;\n46: import org.tigris.gef.graph.GraphModel;\n47: import org.tigris.gef.presentation.Fig;\n48: import org.tigris.gef.presentation.FigPoly;\n49: import org.tigris.gef.presentation.FigText;\n50: \n51: /** Class to display graphics for a UML message in a diagram. \n52:  * \n53:  */\n54: public class FigMessage extends FigNodeModelElement {\n55: \n56:     ////////////////////////////////////////////////////////////////\n57:     // constants\n58:     private static final int PADDING = 5;\n59:     private static Vector arrowDirections = new Vector();\n60: \n61:     ////////////////////////////////////////////////////////////////\n62:     // instance variables\n63: \n64:     private FigPoly figPoly;\n65:     \n66:     /**\n67:      * The <code>arrowDirection</code> values are:\n68:      * 1: South\n69:      * 2: East\n70:      * 3: West\n71:      * 4: North\n72:      */\n73:     private int arrowDirection = 0;\n74: \n75: \n76:     ////////////////////////////////////////////////////////////////\n77:     // constructors\n78: \n79:     /**\n80:      * The main constructor\n81:      */\n82:     public FigMessage() {\n83: \tgetNameFig().setLineWidth(0);\n84: \tgetNameFig().setMultiLine(true);\n85: \tgetNameFig().setFilled(false);\n86: \tDimension nameMin = getNameFig().getMinimumSize();\n87: \tgetNameFig().setBounds(10, 10, 90, nameMin.height);\n88: \n89: \tfigPoly = new FigPoly(Color.black, Color.black);\n90: \tint[] xpoints = {75, 75, 77, 75, 73, 75};\n91: \tint[] ypoints = {33, 24, 24, 15, 24, 24};\n92: \tPolygon polygon = new Polygon(xpoints, ypoints, 6);\n93: \tfigPoly.setPolygon(polygon);\n94: \tfigPoly.setBounds(100, 10, 5, 18);\n95: \n96: \tarrowDirections.addElement(\"North\");\n97: \tarrowDirections.addElement(\"South\");\n98: \tarrowDirections.addElement(\"East\");\n99: \tarrowDirections.addElement(\"West\");\n100: \n101: \t// add Figs to the FigNode in back-to-front order\n102: \taddFig(getNameFig());\n103: \taddFig(figPoly);\n104: \n105: \tRectangle r = getBounds();\n106: \tsetBounds(r.x, r.y, r.width, r.height);\n107:     }\n108: \n109:     /**\n110:      * The constructor that hooks the Fig into an existing UML element\n111:      * @param gm ignored\n112:      * @param lay the layer\n113:      * @param node the UML element\n114:      */\n115:     public FigMessage(GraphModel gm, Layer lay, Object node) {\n116: \tthis();\n117: \tsetLayer(lay);\n118: \tsetOwner(node);\n119:     }\n120: \n121:     /**\n122:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#placeString()\n123:      */\n124:     public String placeString() { return \"new Message\"; }\n125: \n126:     /**\n127:      * @see java.lang.Object#clone()\n128:      */\n129:     public Object clone() {\n130: \tFigMessage figClone = (FigMessage) super.clone();\n131: \tIterator it = figClone.getFigs(null).iterator();\n132: \tfigClone.setNameFig((FigText) it.next());\n133: \tfigClone.figPoly = (FigPoly) it.next();\n134: \t//figClone._polygon = (Polygon) _polygon.clone();\n135: \treturn figClone;\n136:     }\n137: \n138: \n139: \n140:     ////////////////////////////////////////////////////////////////\n141:     // Fig accessors\n142: \n143:     /**\n144:      * @see org.tigris.gef.presentation.Fig#setLineColor(java.awt.Color)\n145:      */\n146:     public void setLineColor(Color col) {\n147: \tfigPoly.setLineColor(col);\n148: \tgetNameFig().setLineColor(col);\n149:     }\n150:     \n151:     /**\n152:      * @see org.tigris.gef.presentation.Fig#getLineColor()\n153:      */\n154:     public Color getLineColor() { return figPoly.getLineColor(); }\n155: \n156:     /**\n157:      * @see org.tigris.gef.presentation.Fig#setFillColor(java.awt.Color)\n158:      */\n159:     public void setFillColor(Color col) {\n160: \tfigPoly.setFillColor(col);\n161: \tgetNameFig().setFillColor(col);\n162:     }\n163:     /**\n164:      * @see org.tigris.gef.presentation.Fig#getFillColor()\n165:      */\n166:     public Color getFillColor() { return figPoly.getFillColor(); }\n167: \n168:     /**\n169:      * @see org.tigris.gef.presentation.Fig#setFilled(boolean)\n170:      */\n171:     public void setFilled(boolean f) {  }\n172: \n173:     /**\n174:      * @see org.tigris.gef.presentation.Fig#getFilled()\n175:      */\n176:     public boolean getFilled() { return true; }\n177: \n178:     /**\n179:      * @see org.tigris.gef.presentation.Fig#setLineWidth(int)\n180:      */\n181:     public void setLineWidth(int w) { figPoly.setLineWidth(w); }\n182:     \n183:     /**\n184:      * @see org.tigris.gef.presentation.Fig#getLineWidth()\n185:      */\n186:     public int getLineWidth() { return figPoly.getLineWidth(); }\n187: \n188:     /**\n189:      * @param direction for the arrow \n190:      * 1: South\n191:      * 2: East\n192:      * 3: West\n193:      * 4: North\n194:      */\n195:     public void setArrow(int direction) {\n196: \tRectangle bbox = getBounds();\n197:     \n198: \tarrowDirection = direction;\n199: \tswitch (direction) {\n200: \t    // south\n201: \tcase 1: {\n202: \t    int[] xpoints = {75, 75, 77, 75, 73, 75};\n203: \t    int[] ypoints = {15, 24, 24, 33, 24, 24};\n204: \t    Polygon polygon = new Polygon(xpoints, ypoints, 6);\n205: \t    figPoly.setPolygon(polygon);\n206: \t    break;\n207: \t}\n208: \t    // east\n209: \tcase 2: {\n210: \t    int[] xpoints = {66, 75, 75, 84, 75, 75};\n211: \t    int[] ypoints = {24, 24, 26, 24, 22, 24};\n212: \t    Polygon polygon = new Polygon(xpoints, ypoints, 6);\n213: \t    figPoly.setPolygon(polygon);\n214: \t    break;\n215: \t}\n216: \t    // west\n217: \tcase 3: {\n218: \t    int[] xpoints = {84, 75, 75, 66, 75, 75};\n219: \t    int[] ypoints = {24, 24, 26, 24, 22, 24};\n220: \t    Polygon polygon = new Polygon(xpoints, ypoints, 6);\n221: \t    figPoly.setPolygon(polygon);\n222: \t    break;\n223: \t}\n224: \t    // north\n225: \tdefault: {\n226: \t    int[] xpoints = {75, 75, 77, 75, 73, 75};\n227: \t    int[] ypoints = {33, 24, 24, 15, 24, 24};\n228: \t    Polygon polygon = new Polygon(xpoints, ypoints, 6);\n229: \t    figPoly.setPolygon(polygon);\n230: \t}\n231: \t}\n232: \tsetBounds(bbox);\n233:     }\n234:     \n235:     /**\n236:      * @return the arrow direction\n237:      */\n238:     public int getArrow() { return arrowDirection; }\n239: \n240:     /**\n241:      * @see org.tigris.gef.presentation.Fig#getMinimumSize()\n242:      */\n243:     public Dimension getMinimumSize() {\n244: \tDimension nameMin = getNameFig().getMinimumSize();\n245: \tDimension figPolyMin = figPoly.getSize();\n246: \n247: \tint h = Math.max(figPolyMin.height, nameMin.height);\n248: \tint w = figPolyMin.width + nameMin.width;\n249: \treturn new Dimension(w, h);\n250:     }\n251: \n252:     /** Override setBounds to keep shapes looking right \n253:      * @see org.tigris.gef.presentation.Fig#setBounds(int, int, int, int)\n254:      */\n255:     public void setBounds(int x, int y, int w, int h) {\n256: \tif (getNameFig() == null) {\n257: \t    return;\n258: \t}\n259: \n260: \tRectangle oldBounds = getBounds();\n261: \n262: \tDimension nameMin = getNameFig().getMinimumSize();\n263: \n264: \tint ht = 0;\n265: \n266: \tif (nameMin.height > figPoly.getHeight()) \n267: \t    ht = (nameMin.height - figPoly.getHeight()) / 2;\n268: \n269: \tgetNameFig().setBounds(x, y, w - figPoly.getWidth(), nameMin.height);\n270: \tfigPoly.setBounds(x + getNameFig().getWidth(), y + ht,\n271: \t\t\t   figPoly.getWidth(), figPoly.getHeight());\n272: \n273: \tfirePropChange(\"bounds\", oldBounds, getBounds());\n274: \tcalcBounds(); //_x = x; _y = y; _w = w; _h = h;\n275: \tupdateEdges();\n276:     }\n277: \n278:     /**\n279:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEdited(org.tigris.gef.presentation.FigText)\n280:      */\n281:     protected void textEdited(FigText ft) throws PropertyVetoException {\n282: \tObject message = getOwner();\n283: \tif (message != null && ft == getNameFig()) {\n284: \t    String s = ft.getText();\n285: \t    try {\n286: \t\tParserDisplay.SINGLETON.parseMessage(message, s);\n287: \t\tProjectBrowser.getInstance().getStatusBar().showStatus(\"\");\n288: \t    } catch (ParseException pe) {\n289: \t\tProjectBrowser.getInstance().getStatusBar()\n290: \t\t    .showStatus(\"Error: \" + pe + \" at \" + pe.getErrorOffset());\n291: \t    }\n292: \t}\n293: \telse\n294: \t    super.textEdited(ft);\n295:     }\n296: \n297:     /**\n298:      * Determines the direction of the message arrow. Deetermination of the \n299:      * type of arrow happens in modelchanged\n300:      */\n301:     protected void updateArrow() {\n302:   \tObject mes = getOwner(); // MMessage\n303: \tif (mes == null || getLayer() == null) return;\n304: \tObject sender = ModelFacade.getSender(mes); // MClassifierRole\n305: \tObject receiver = ModelFacade.getReceiver(mes); // MClassifierRole\n306: \tFig senderPort = getLayer().presentationFor(sender);\n307: \tFig receiverPort = getLayer().presentationFor(receiver);\n308: \tif (senderPort == null || receiverPort == null) return;\n309: \tint sx = senderPort.getX();\n310: \tint sy = senderPort.getY();\n311: \tint rx = receiverPort.getX();\n312: \tint ry = receiverPort.getY();\n313: \tif (sx < rx && Math.abs(sy - ry) <= Math.abs(sx - rx)) { // east\n314: \t    setArrow(2);\n315: \t} else \n316: \t    if (sx > rx && Math.abs(sy - ry) <= Math.abs(sx - rx)) { // west\n317: \t\tsetArrow(3);\n318: \t    } else \n319: \t\tif (sy < ry) { // south\n320: \t\t    setArrow(1);\n321: \t\t} else\n322: \t\t    setArrow(4);\n323:     }\n324: \n325:     /**\n326:      * Add the FigMessage to the Path Items of its FigAssociationRole.\n327:      * @param lay the Layer\n328:      */\n329:     public void addPathItemToFigAssociationRole(Layer lay) {\n330: \n331: \tObject associationRole =\n332: \t    ModelFacade.getCommunicationConnection(getOwner());\n333: \tif (associationRole != null && lay != null) {\n334: \t    FigAssociationRole figAssocRole =\n335: \t\t(FigAssociationRole) lay.presentationFor(associationRole);\n336: \t    if (figAssocRole != null) {\n337: \t\tfigAssocRole.addMessage(this);\n338: \t\tfigAssocRole.updatePathItemLocations();\n339: \t\tlay.bringToFront(this);\n340: \t    }\n341: \t}\n342:     }\n343: \n344:  \n345: \t\n346: \n347: \t\n348: \n349:     /**\n350:      * @see org.tigris.gef.presentation.Fig#paint(Graphics)\n351:      */\n352:     public void paint(Graphics g) {\n353: \tupdateArrow();\n354: \tsuper.paint(g);\n355:     }\n356: \n357:     \n358: \n359:     /**\n360:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateNameText()\n361:      */\n362:     protected void updateNameText() {\n363:         Object mes =  getOwner();\n364:         if (mes == null) return;\n365:         getNameFig().setText(Notation.generate(this, mes));\n366:     }\n367: \n368:     /**\n369:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#renderingChanged()\n370:      */\n371:     public void renderingChanged() {\n372:         super.renderingChanged();\n373:         updateArrow();\n374:     }\n375: \n376:     /**\n377:      * @return Returns the arrowDirections.\n378:      */\n379:     public static Vector getArrowDirections() {\n380:         return arrowDirections;\n381:     }\n382: } /* end class FigMessage */\n383: ",
