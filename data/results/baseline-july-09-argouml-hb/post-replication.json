   File parentDir = new File(file.getParent());\n1250:             if (!parentDir.exists()) {\n1251:                 parentDir.mkdirs();\n1252:             }\n1253: \n1254:             bwOutput = new BufferedWriter(new FileWriter(file));\n1255:             bwOutput.write(sOutput);\n1256:         } catch (IOException exp) {\n1257:             LOG.error(\"    Catched IOException: \" + exp\n1258:                     + \", for file \" + file.getPath());\n1259:             bReturn = false;\n1260:         } finally {\n1261:             try {\n1262:                 if (bwOutput != null) {\n1263:                     bwOutput.close();\n1264:                 }\n1265:             } catch (IOException exp) {\n1266:                 LOG.error(\"    Catched IOException: \" + exp\n1267:                         + \", for file \" + file.getPath());\n1268: \n1269:                 bReturn = false;\n1270:             }\n1271:         }\n1272: \n1273:         return bReturn;\n1274:     }\n1275: \n1276:     /**\n1277:      * Updates the output file for a model element.\n1278:      *\n1279:      * @param modelElement The model element to update file for.\n1280:      * @param fileOrig     The original (previous) output file.\n1281:      *\n1282:      * @throws Exception\n1283:      */\n1284:     private final void updateFile(Object modelElement, File fileOrig)\n1285:         throws Exception {\n1286:         if (!ModelFacade.isAClassifier(modelElement)) {\n1287:             throw new ClassCastException(modelElement.getClass()\n1288:                 + \" has wrong object type, Classifier required\");\n1289:         }\n1290: \n1291:         objSection = new Section();\n1292: \n1293:         File fileNew    = new File(fileOrig.getAbsolutePath() + \".out\");\n1294:         File fileBackup = new File(fileOrig.getAbsolutePath() + \".bak\");\n1295: \n1296:         LOG.debug(\"    Parsing sections from \" + fileOrig.getPath());\n1297:         objSection.read(fileOrig.getAbsolutePath());\n1298: \n1299:         if (fileBackup.exists()) {\n1300:             LOG.debug(\"    Delete (old) backup \" + fileBackup.getPath());\n1301:             fileBackup.delete();\n1302:         }\n1303: \n1304:         LOG.debug(\"    Backup \" + fileOrig.getPath() + \" to \"\n1305:                 + fileBackup.getPath());\n1306:         fileOrig.renameTo(fileBackup);\n1307: \n1308:         if (this.createFile(modelElement, fileOrig)) {\n1309:             LOG.debug(\"    Merging sections into \" + fileNew.getPath());\n1310:             objSection.write(fileOrig.getAbsolutePath(), INDENT, true);\n1311: \n1312:             LOG.debug(\"    Renaming \" + fileNew.getPath()\n1313:                     + \" to \" + fileOrig.getPath());\n1314:             fileOrig.delete();\n1315:             fileNew.renameTo(fileOrig);\n1316:         } else {\n1317:             if (fileBackup.exists()) {\n1318:                 LOG.debug(\"    Renaming (restore) \" + fileBackup.getPath()\n1319:                         + \" to \" + fileOrig.getPath());\n1320:                 fileBackup.renameTo(fileOrig);\n1321:             }\n1322: \n1323:             LOG.error(\"    Updating \" + fileOrig.getPath() + \" failed\");\n1324:         }\n1325:     }\n1326: \n1327:     /**\n1328:      * Generates classifier attributes\n1329:      *\n1330:      * @param modelElement classifier\n1331:      *\n1332:      * @return source code for class attributes\n1333:      */\n1334:     private String generateClassifierAttributes(Object modelElement) {\n1335:         if (!ModelFacade.isAClassifier(modelElement)) {\n1336:             throw new ClassCastException(modelElement.getClass()\n1337:                     + \" has wrong object type, Classifier required\");\n1338:         }\n1339: \n1340:         String sClsAttr = \"\";\n1341: \n1342:         if (ModelFacade.isAClass(modelElement)) {\n1343:             sClsAttr += INDENT + \"// --- ATTRIBUTES ---\\n\";\n1344: \n1345:             Collection colAttributes =\n1346:               