0);\n93:     figClone._cover = (FigCube) v.elementAt(1);\n94:     figClone._stereo = (FigText) v.elementAt(2);\n95:     figClone._name = (FigText) v.elementAt(3);\n96:     figClone._test = (FigRect) v.elementAt(4);\n97:     return figClone;\n98:   }\t\n99: \n100:   ////////////////////////////////////////////////////////////////\n101:   // acessors\n102: \n103:   public void setLineColor(Color c) {\n104: //     super.setLineColor(c);\n105:      _cover.setLineColor(c);\n106:      _stereo.setFilled(false);\n107:      _stereo.setLineWidth(0);\n108:      _name.setFilled(false);\n109:      _name.setLineWidth(0);\n110:      _test.setLineColor(c);\n111:   }\n112: \n113:   public Selection makeSelection() {\n114:       return new SelectionNode(this);\n115:   }\n116: \n117:   public void setOwner(Object node) {\n118:     super.setOwner(node);\n119:     bindPort(node, _bigPort);\n120:   }\n121: \n122:   public Dimension getMinimumSize() {\n123:     Dimension stereoDim = _stereo.getMinimumSize();\n124:     Dimension nameDim = _name.getMinimumSize();\n125:     \n126:     int w = Math.max(stereoDim.width, nameDim.width);\n127:     int h = stereoDim.height + nameDim.height - 4;\n128:     return new Dimension(w, h);\n129:   }\n130: \n131:   public void setBounds(int x, int y, int w, int h) {\n132:     if (_name == null) return;\n133: \n134:     Rectangle oldBounds = getBounds();\n135:     _bigPort.setBounds(x , y, w , h);\n136:     _cover.setBounds(x , y, w, h);\n137: \n138:     Dimension stereoDim = _stereo.getMinimumSize();\n139:     Dimension nameDim = _name.getMinimumSize();\n140:     _name.setBounds(x, y + stereoDim.height + 1, w, nameDim.height);\n141:     _stereo.setBounds(x+1,y+1,w-2,stereoDim.height);\n142:     _x = x; _y = y; _w = w; _h = h;\n143:     firePropChange(\"bounds\", oldBounds, getBounds());\n144:     updateEdges();\n145:   }\n146: \n147:   ////////////////////////////////////////////////////////////////\n148:   // user interaction methods\n149: \n150:   public void mouseClicked(MouseEvent me) {\n151:     super.mouseClicked(me);\n152:     setLineColor(Color.black);\n153:   }\n154: \n155: \n156:   public void setEnclosingFig(Fig encloser) {\n157:     super.setEnclosingFig(encloser);\n158:     \n159:     Vector figures = getEnclosedFigs();\n160:    \n161:     if (getLayer() != null) {\n162:       // elementOrdering(figures); \n163:       Vector contents = getLayer().getContents();\n164:       int contentsSize = contents.size();\n165:       for (int j=0; j<contentsSize; j++) {\n166:         Object o = contents.elementAt(j);\n167:         if (o instanceof FigEdgeModelElement) {\n168:           FigEdgeModelElement figedge = (FigEdgeModelElement) o;\n169:           figedge.getLayer().bringToFront(figedge);\n170:         }\n171:       }\n172:     }\n173:     \n174:   }\n175: \n176:   protected void updateStereotypeText() {\n177:     MModelElement me = (MModelElement) getOwner();\n178:     if (me == null) return;\n179:     MStereotype stereo = me.getStereotype();\n180:     if (stereo == null || stereo.getName() == null || stereo.getName().length() == 0)\n181:         _stereo.setText(\"\");\n182:     else {\n183:         _stereo.setText(Notation.generateStereotype(this, stereo));\n184:     }\n185:   }\n186: \n187:   protected void modelChanged() {\n188:     super.updateNameText();\n189:   }\n190: \n191:   public boolean getUseTrapRect() { return true; }\n192: \t\n193:   static final long serialVersionUID = 8822005566372687713L;\n194: \n195: } /* end class FigMNode */\n196: \n197: ",
