dNudge.LEFT));\n444:     nudge.add(new CmdNudge(CmdNudge.RIGHT));\n445:     nudge.add(new CmdNudge(CmdNudge.UP));\n446:     nudge.add(new CmdNudge(CmdNudge.DOWN));\n447: \n448:     JMenu generate = (JMenu) _menuBar.add(new JMenu(\"Generation\"));\n449:     generate.setMnemonic('G');\n450:     generate.add(_actionGenerateOne);\n451:     JMenuItem genAllItem = generate.add(_actionGenerateAll);\n452:     genAllItem.setAccelerator(F7);\n453:     generate.add(_actionGenerateWeb);\n454: \n455:     Menu critique = (Menu) _menuBar.add(new Menu(\"Critique\"));\n456:     critique.setMnemonic('R');\n457:     critique.addCheckItem(_actionAutoCritique);\n458:     critique.addSeparator();\n459:     critique.add(_actionOpenDecisions);\n460:     critique.add(_actionOpenGoals);\n461:     critique.add(_actionOpenCritics);\n462: \n463:     // Help Menu\n464:     JMenu help = new JMenu(\"Help\");\n465:     help.setMnemonic('H');\n466:     help.add(_actionAboutArgoUML);\n467:     //_menuBar.setHelpMenu(help);\n468:     _menuBar.add(help);\n469:   }\n470: \n471: \n472:   protected Component createPanels() {\n473:     _topSplit = new JSplitPane(JSplitPane.HORIZONTAL_SPLIT, _navPane, _multiPane);\n474:     _botSplit = new JSplitPane(JSplitPane.HORIZONTAL_SPLIT,\n475: \t\t\t       _toDoPane, _detailsPane);\n476:     _mainSplit = new JSplitPane(JSplitPane.VERTICAL_SPLIT, _topSplit, _botSplit);\n477:     _topSplit.setDividerSize(2);\n478:     _topSplit.setDividerLocation(270);\n479:     _botSplit.setDividerSize(2);\n480:     _mainSplit.setDividerSize(2);\n481:     //_botSplit.setOneTouchExpandable(true);\n482:     return _mainSplit;\n483:   }\n484: \n485:   ////////////////////////////////////////////////////////////////\n486:   // accessors\n487: \n488:   public void setProject(Project p) {\n489:     _project = p;\n490:     _navPane.setRoot(_project);\n491:     updateTitle();\n492:     Actions.updateAllEnabled();\n493:     //Designer.TheDesigner.getToDoList().removeAllElements();\n494:     D