dth\n113:      * @return The breadth of the <code>Component</code>.\n114:      */\n115:     public int getBreadth(Component comp) {\n116:         return comp.getWidth();\n117:     }\n118: \n119:     /**\n120:      * Get the position of a <code>Point</code>.\n121:      *\n122:      * @parameter point The <code>Point</code> of which to determine the position\n123:      * @return The position of the <code>Point</code>.\n124:      */\n125:     public int getPosition(Point point) {\n126:         return (int)point.getY();\n127:     }\n128: \n129:     /**\n130:      * Get the offset of a <code>Point</code>.\n131:      *\n132:      * @parameter point The <code>Point</code> of which to determine the offset.\n133:      * @return The position of the <code>Point</code>.\n134:      */\n135:     public int getOffset(Point point) {\n136:         return (int)point.getX();\n137:     }\n138: \n139:     /**\n140:      * Determines the last usable position in a <code>Container</code>. This takes into account\n141:      * the <code>Insets</code> of the <code>Container</code>.\n142:      *\n143:      * @parameter cont the <code>Container</code> from which to determine the last usable \n144:      *                 position.\n145:      * @return The offset of the <code>Container</code>.\n146:      */\n147:     public int getLastUsablePosition(Container cont) {\n148:         return cont.getHeight() - cont.getInsets().bottom;\n149:     }\n150: \n151:     /**\n152:      * Determines the first usable offset in a <code>Container</code>. This takes into account\n153:      * the <code>Insets</code> of the <code>Container</code>.\n154:      *\n155:      * @parameter cont the <code>Container</code> from which to determine the first usable \n156:      *                 position.\n157:      * @return The offset of the <code>Container</code>.\n158:      */\n159:     public int getFirstUsableOffset(Container cont) {\n160:         return cont.getInsets().top;\n161:     }\n162: \n163:     \n164:     /**\