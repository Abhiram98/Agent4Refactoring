:             LOG.error(\"Generating classifier DocBlock FAILED: \"\n536:                     + exp.getMessage());\n537:         } finally {\n538:             if (objPHPDoc != null) {\n539:                 sClassifier += objPHPDoc.toString();\n540:             }\n541:         }\n542: \n543:         String sClassName =\n544:                 NameGenerator.generate(modelElement, iLanguageMajorVersion);\n545: \n546:         sClassifier += sClassType + \" \" + sClassName + \"\\n\";\n547: \n548:         sClassifier += generateClassifierGeneralisations(modelElement);\n549:         sClassifier += generateClassifierSpecifications(modelElement);\n550: \n551:         sClassifier += \"{\\n\";\n552: \n553:         sClassifier += generateClassifierAttributes(modelElement);\n554:         sClassifier += generateClassifierOperations(modelElement);\n555: \n556:         sClassifier += \"\\n} /* end of \" + sClassType + \" \" + sClassName + \" */\";\n557: \n558:         return sClassifier;\n559:     }\n560: \n561:     /**\n562:      * Generates tagged value\n563:      *\n564:      * @param modelElement Model element to generate notation for.\n565:      *\n566:      * @return Generated notation for model element.\n567:      */\n568:     public String generateTaggedValue(Object modelElement) {\n569:         // TODO: Auto-generated method stub\n570:         LOG.debug(\"generateTaggedValue(MTaggedValue modelElement)\");\n571: \n572:         if (!ModelFacade.isATaggedValue(modelElement)) {\n573:             throw new ClassCastException(modelElement.getClass()\n574:                     + \" has wrong object type, TaggedValue required\");\n575:         }\n576: \n577:         return \"generateTaggedValue(MTaggedValue modelElement)\";\n578:     }\n579: \n580:     /**\n581:      * Generates association\n582:      *\n583:      * @param modelElement Model element to generate notation for.\n584:      *\n585:      * @return Generated notation for model element.\n586:      */\n587:     public String 