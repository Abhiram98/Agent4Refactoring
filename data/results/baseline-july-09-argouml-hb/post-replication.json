                    "kwargs": {
                        "content": "Here is the source code to modify: \nsrc/model/src/org/argouml/model/ModelEventPump.java: \n1: // $Id$\n2: // Copyright (c) 2004-2005 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.model;\n26: \n27: import java.beans.PropertyChangeListener;\n28: \n29: import javax.swing.Action;\n30: \n31: /**\n32:  * This is the interface for registering interest in events sent from\n33:  * the model component.<p>\n34:  *\n35:  * Neither the registration or unregistration, nor the events themselves\n36:  * contain any reference to the model implementation (NSUML).  Instead they\n37:  * use the {@link java.beans.PropertyChangeListener},\n38:  * {@link java.beans.PropertyChangeEvent} to\n39:  * deliver events.<p>\n40:  *\n41:  * The reference to the listener is a WeakReference so you don't need to\n42:  * call removeWHATEVERListener, you can just forget about your listener\n43:  * and it is eventually finalized and removed. This also means that you\n44:  * will have to keep a reference to your listener while it is active.\n45:  * Since the garbage collecting mechanism is not really deterministic\n46:  * a forgotten about listener might still receive events. Unless it can\n47:  * handle them in a harmless way, this approach should not be used.<p>\n48:  *\n49:  * The event names generated are {@link String}s and their values and\n50:  * meanings are not really well documented. For a full list you will have\n51:  * to dig down in the NSUML implementation and eventtree.xml.<p>\n52:  *\n53:  * Here are some highlights:<ul>\n54:  * <li>\"remove\" - event sent when the element is removed.\n55:  * </ul>\n56:  *\n57:  * @author Linus Tolke\n58:  */\n59: public interface ModelEventPump {\n60:     // Operations that work on elements:\n61: \n62:     /**\n63:      * Adds a listener to modelevents that are fired by some given modelelement\n64:      * and that have any of the names in eventNames.<p>\n65:      *\n66:      * @param listener The listener to add\n67:      * @param modelelement The modelelement the listener should be added too\n68:      * @param propertyNames The array of eventnames the listener should listen\n69:      * to.\n70:      */\n71:     void addModelEventListener(PropertyChangeListener listener,\n72:             \t\t       Object modelelement,\n73: \t\t\t       String[] propertyNames);\n74: \n75:     /**\n76:      * Adds a listener to modelevents that are fired by some given modelelement\n77:      * and that have the name in eventName.<p>\n78:      *\n79:      * @param listener The listener to add\n80:      * @param modelelement The modelelement the listener should be added too\n81:      * @param propertyName The eventname the listener should listen to.\n82:      */\n83:     void addModelEventListener(PropertyChangeListener listener,\n84: \t\t\t       Object modelelement,\n85: \t\t\t       String propertyName);\n86: \n87:     /**\n88:      * Adds a listener to all events fired by some modelelement.\n89:      *\n90:      * @param listener is the listener to add\n91:      * @param modelelement is the model element\n92:      */\n93:     void addModelEventListener(PropertyChangeListener listener,\n94:             \t\t       Object modelelement);\n95: \n96:     /**\n97:      * Removes a listener that listens to modelevents with name\n98:      * eventNames that are fired by the given modelelement.<p>\n99:      *\n100:      * @param listener The listener to remove\n101:      * @param modelelement The modelelement that fires the events the\n102:      * listener is listening to.\n103:      * @param propertyNames The list of event names the listener is\n104:      * no longer interested in.\n105:      */\n106:     void removeModelEventListener(PropertyChangeListener listener,\n107: \t\t\t\t  Object modelelement,\n108: \t\t\t\t  String[] propertyNames);\n109: \n110:     /**\n111:      * Removes a listener that listens to modelevents with name\n112:      * eventName that are fired by the given modelelement.<p>\n113:      *\n114:      * @param listener The listener to remove.\n115:      * @param modelelement The modelelement that fires the events the\n116:      * listener is listening to.\n117:      * @param propertyName The name the listener is no longer interested in.\n118:      */\n119:     void removeModelEventListener(PropertyChangeListener listener,\n120: \t\t\t\t  Object modelelement,\n121: \t\t\t\t  String propertyName);\n122: \n123:     /**\n124:      * Removes a listener that listens to all events fired by the\n125:      * given modelelement.<p>\n126:      *\n127:      * @param listener is the listener\n128:      * @param modelelement is the model element\n129:      */\n130:     void removeModelEventListener(PropertyChangeListener listener,\n131: \t\t\t\t  Object modelelement);\n132: \n133:     // Operations that work on classes of objects:\n134: \n135:     /**\n136:      * Adds a listener that listens to all events that are named\n137:      * eventNames and that occur to instances of the given\n138:      * modelClass.<p>\n139:      *\n140:      * @param listener is the listener to add.\n141:      * @param modelClass is the given model class\n142:      * @param eventNames is a array of strings with event names.\n143:      * @throws IllegalArgumentException if one of the arguments is null or if\n144:      * the modelClass is not a subclass of MBase.\n145:      * @throws IllegalStateException if the listener is already registred.\n146:      */\n147:     void addClassModelEventListener(PropertyChangeListener listener,\n148: \t\t\t\t    Object modelClass,\n149: \t\t\t\t    String[] eventNames);\n150: \n151:     /**\n152:      * Adds a listener that listens to the event that is named\n153:      * eventName and that occur to instances of the given\n154:      * modelClass.<p>\n155:      *\n156:      * @param listener is the listener to add.\n157:      * @param modelClass is the given model class\n158:      * @param eventName is the event name.\n159:      * @throws IllegalArgumentException if one of the arguments is null or if\n160:      * the modelClass is not a subclass of MBase.\n161:      * @throws IllegalStateException if the listener is already registred.\n162:      */\n163:     void addClassModelEventListener(PropertyChangeListener listener,\n164: \t\t\t\t    Object modelClass,\n165: \t\t\t\t    String eventName);\n166: \n167:     /**\n168:      * Removes a listener that listens to all modelevents fired by instances of\n169:      * modelClass and that have the original name eventNames.\n170:      *\n171:      * @param listener The listener to remove\n172:      * @param modelClass The class the listener does not want to listen to\n173:      * instances anymore\n174:      * @param eventNames The eventnames the listener does not want to listen to\n175:      * anymore\n176:      */\n177:     void removeClassModelEventListener(PropertyChangeListener listener,\n178: \t\t\t\t       Object modelClass,\n179: \t\t\t\t       String[] eventNames);\n180: \n181:     /**\n182:      * Removes a listener that listens to all modelevents fired by instances of\n183:      * modelClass and that have the name eventName.\n184:      *\n185:      * @param listener The listener to remove\n186:      * @param modelClass The class the listener does not want to listen to\n187:      * instances anymore.\n188:      * @param eventName The eventname the listener does not want to listen to\n189:      * anymore.\n190:      */\n191:     void removeClassModelEventListener(PropertyChangeListener listener,\n192: \t\t\t\t       Object modelClass,\n193: \t\t\t\t       String eventName);\n194: \n195:     /**\n196:      * Register an Action with the pump that is used to perform saving.\n197:      * This action will be enabled by any change to the model.\n198:      *\n199:      * @param saveAction the action to enable on change to model.\n200:      */\n201:     void setSaveAction(Action saveAction);\n202:     \n203:     /**\n204:      * Start the ModelEventPump firing events.\n205:      */\n206:     void startPumpingEvents();\n207:     \n208:     /**\n209:      * Stop the ModelEventPump firing events.\n210:      */\n211:     void stopPumpingEvents();\n212:     \n213:     /**\n214:      * Flush events from the ModelEventPump.\n215:      */\n216:     void flushModelEvents();\n217: }\n218: ",
