                        "content": "Here is the source code to modify: \nsrc/uci/argo/kernel/Designer.java: \n1: // Copyright (c) 1995, 1996 Regents of the University of California.\n2: // All rights reserved.\n3: //\n4: // This software was developed by the Arcadia project\n5: // at the University of California, Irvine.\n6: //\n7: // Redistribution and use in source and binary forms are permitted\n8: // provided that the above copyright notice and this paragraph are\n9: // duplicated in all such forms and that any documentation,\n10: // advertising materials, and other materials related to such\n11: // distribution and use acknowledge that the software was developed\n12: // by the University of California, Irvine.  The name of the\n13: // University may not be used to endorse or promote products derived\n14: // from this software without specific prior written permission.\n15: // THIS SOFTWARE IS PROVIDED ``AS IS'' AND WITHOUT ANY EXPRESS OR\n16: // IMPLIED WARRANTIES, INCLUDING, WITHOUT LIMITATION, THE IMPLIED\n17: // WARRANTIES OF MERCHANTIBILITY AND FITNESS FOR A PARTICULAR PURPOSE.\n18: \n19: // File: Designer.java\n20: // Classes: Designer\n21: // Original Author: jrobbins@ics.uci.edu\n22: // $Id$\n23: \n24: package uci.argo.kernel;\n25: \n26: import java.util.*;\n27: \n28: import uci.util.*;\n29: \n30: /** This class models the designer who is building a complex design in\n31:  *  some application domain and needs continuous feedback to aid in the\n32:  *  making of good design decisions. */\n33: \n34: public class Designer implements Poster, Runnable, java.io.Serializable {\n35:   ////////////////////////////////////////////////////////////////\n36:   // instance variables\n37: \n38:   public static Designer TheDesigner = new Designer();\n39: \n40:   /** ToDoList items that are on the designers ToDoList because of\n41:    *  this material. */\n42:   private ToDoList _toDoList;\n43: \n44:   /** Preferences -- very ill defined */\n45:   private Properties _prefs;\n46: \n47:   /** The email address where other designers can send this designer\n48:    * email. This is not used yet. */\n49:   private String _emailAddr;\n50: \n51:   /** The decisions currently being considered by the designer.\n52:    *  Decisions are currently modeled as simple descriptive strings.\n53:    *  Each decision also has a priority number which is ill defined,\n54:    *  but positive Ints mean that the designer is considering it. This\n55:    *  explicit representation of what decisions the designer is\n56:    *  interested in at a given moment allows the Agency to select\n57:    *  relevant critics for execution. */\n58: \n59:   private DecisionModel _decisions;\n60: \n61:   /** The goals of the designer are likewise used by the Agency to\n62:    *  determine what critics are relevant. */\n63: \n64:   private GoalModel _goals;\n65: \n66:   /** Each designer has their own Agency instance that is responsible\n67:    *  for selecting and executing critics that are relevant to thid\n68:    *  designer on an on going basis. */\n69: \n70:   private Agency _agency;\n71: \n72:   private Thread _critiquer;\n73:   private int _critiquingInterval = 3000;\n74:   private boolean _autoCritique = true;\n75: \n76:   private ChildGenerator _cg = new ChildGenDMElements();\n77:   //needs-more-work: theInstance()\n78: \n79:   private static Object _CritiquingRoot;\n80: \n81:   ////////////////////////////////////////////////////////////////\n82:   // constructor and singeton methods\n83: \n84:   public Designer() {\n85:     _decisions = new DecisionModel();\n86:     _goals = new GoalModel();\n87:     _agency = new Agency();\n88:     _prefs = new Properties();\n89:     _toDoList = new ToDoList();\n90:     _toDoList.spawnValidityChecker(this);\n91:     _emailAddr = \"jrobbins@ics.uci.edu\";\n92:     TheDesigner = this;\n93:   }\n94: \n95:   public static void theDesigner(Designer d) { TheDesigner = d; }\n96:   public static Designer theDesigner() { return TheDesigner; }\n97: \n98: \n99:   ////////////////////////////////////////////////////////////////\n100:   // critiquing\n101: \n102:   /** Start a separate thread to continually select and execute\n103:    *  critics that are relevant to this designer's work. */\n104:   public void spawnCritiquer(Object root) {\n105:     /* needs-more-work really should be a separate class */\n106:     _critiquer = new Thread(this, \"CritiquingThread\");\n107:     _critiquer.setDaemon(true);\n108:     _critiquer.start();\n109:     _CritiquingRoot = root;\n110:   }\n111: \n112:   /** Continuously select and execute critics against this designer's\n113:    *  design. spawnCritiquer is used to start a Thread that runs\n114:    *  this. */\n115:   public void run() {\n116:     Vector alreadyCritiqued = new Vector();       // jer added 970911\n117:     Vector toCritique = new Vector();     // jer added 970911\n118:     while (true) {\n119:       if (_CritiquingRoot != null && getAutoCritique()) {\n120:         synchronized (_CritiquingRoot) {\n121:           _agency.determineActiveCritics(this);\n122:           // jer added 970911\n123:           // now use ChildGenerators instead of elements()\n124:           //- _CritiquingRoot.critique(this);\n125:           alreadyCritiqued.removeAllElements();\n126:           toCritique.removeAllElements();\n127:           toCritique.addElement(_CritiquingRoot);\n128:           while (toCritique.size() > 0) {\n129:             Object dm = toCritique.elementAt(toCritique.size()-1);\n130:             toCritique.removeElement(dm);\n131:             if (!alreadyCritiqued.contains(dm)) {\n132:               alreadyCritiqued.addElement(dm);\n133:               Agency.applyAllCritics(dm, theDesigner());\n134:               Enumeration subDMs = _cg.gen(dm);\n135:               while (subDMs.hasMoreElements())\n136:                 toCritique.addElement(subDMs.nextElement());\n137:             }\n138:           }\n139:         }\n140:       }\n141:       // needs-more-work: limit % CPU time used\n142:       try { _critiquer.sleep(getCritiquingInterval()); }\n143:       catch (InterruptedException ignore) {\n144:         System.out.println(\"InterruptedException!!!\");\n145:       }\n146:     }\n147:   }\n148: \n149: \n150:   /** Look for potential problems or open issues in the given design. */\n151:   public void critique(Design des) { des.critique(this); }\n152: \n153:   ////////////////////////////////////////////////////////////////\n154:   // criticism control\n155: \n156:   /** Ask this designer's agency to select which critics should be active. */\n157:   public void determineActiveCritics() {\n158:     _agency.determineActiveCritics(this);\n159:   }\n160: \n161:   ////////////////////////////////////////////////////////////////\n162:   // accessors\n163: \n164:   /** autoCritique and critiquingInterval are two prameters that\n165:    *  control how the critiquing thread operates. If autoCritique is\n166:    *  false then now critiquing is done in the background. The\n167:    *  critiquingInterval determines how often the critiquing thread\n168:    *  executes. The concept of an interval between runs will become\n169:    *  less important as Argo is redesigned to be more trigger\n170:    *  driven. */\n171: \n172:   public boolean getAutoCritique() { return _autoCritique; }\n173:   public void setAutoCritique(boolean b) { _autoCritique = b; }\n174:   public int getCritiquingInterval() { return _critiquingInterval; }\n175:   public void setCritiquingInterval(int i) { _critiquingInterval = i; }\n176: \n177:    public static void setCritiquingRoot(Object d) {\n178:      synchronized (_CritiquingRoot) {\n179:        _CritiquingRoot = d;\n180:        theDesigner()._toDoList.removeAllElements();\n181:      }\n182:    }\n183:    public static Object getCritiquingRoot() { return _CritiquingRoot; }\n184: \n185:    public ChildGenerator getChildGenerator() { return _cg; }\n186:    public void setChildGenerator(ChildGenerator cg) { _cg = cg; }\n187: \n188:   public DecisionModel getDecisionModel() { return _decisions; }\n189:   public Vector getDecisions() { return _decisions.getDecisions(); }\n190:   public GoalModel getGoalModel() { return _goals; }\n191:   public Vector getGoals() { return _goals.getGoals(); }\n192:   //public SkillsModel getSkillsModel() { return _skills; }\n193: \n194:   /** ToDoItem's that are posted by the designer are assumed to be\n195:    *  valid until the designer explicitly removes them. Perhaps in the\n196:    *  future the designer could specify a condition to determine when\n197:    *  his items expire.\n198:    * @see ToDoItem\n199:    * @see Critic#stillValid\n200:    */\n201:   public boolean stillValid(ToDoItem i, Designer d) { return true; }\n202: \n203:   public static Vector UNSPEC_DECISION_VECTOR = null;\n204:   public static Vector UNSPEC_GOAL_VECTOR = null;\n205:   static {\n206:       UNSPEC_DECISION_VECTOR = new Vector();\n207:       UNSPEC_DECISION_VECTOR.addElement(Decision.UNSPEC);\n208:       UNSPEC_GOAL_VECTOR = new Vector();\n209:       UNSPEC_GOAL_VECTOR.addElement(Goal.UNSPEC);\n210:   }  \n211:   public boolean supports(Decision d) { return d == Decision.UNSPEC; }\n212:   public Vector getSupportedDecisions() { return UNSPEC_DECISION_VECTOR; }\n213: \n214:   public boolean supports(Goal g) { return true; }\n215:   public Vector getSupportedGoals() { return UNSPEC_GOAL_VECTOR; }\n216: \n217:   public boolean containsKnowledgeType(int type) { return true; }\n218:   public Vector getSupportedKnowledgeType() {\n219:     //needs-more-work\n220:     return null;\n221:   }\n222: \n223: \n224:   /** Reply this Designer's ToDoList, a list of pending problems and\n225:    *  issues that the designer might be interested in.\n226:    * @see ToDoList */\n227:   public ToDoList getToDoList() {\n228:     return _toDoList;\n229:   }\n230: \n231:   /** Add all the items in the given list to my list. */\n232:   public void addToDoItems(ToDoList list) {\n233:     _toDoList.addAll(list);\n234:   }\n235: \n236:   /** Remove all the items in the given list from my list. */\n237:   public void removeToDoItems(ToDoList list) {\n238:     _toDoList.removeAll(list);\n239:   }\n240: \n241:   /** Reply the designers personal preferneces. */\n242:   public Properties getPrefs() {\n243:     return _prefs;\n244:   }\n245: \n246:   /** Reply true iff the designer is currently considering the given\n247:    *  decison. */\n248:   public boolean isConsidering(String decision) {\n249:     return _decisions.isConsidering(decision);\n250:   }\n251: \n252:   public boolean isConsidering(Decision d) {\n253:     return d.getPriority() > 0;\n254:   }\n255: \n256:   /** Record the extent to which the designer is considering the given\n257:    *  decision. */\n258:   public void setDecisionPriority(String decision, int priority) {\n259:     _decisions.setDecisionPriority(decision, priority);\n260:   }\n261: \n262:   public void defineDecision(String decision, int priority) {\n263:     _decisions.defineDecision(decision, priority);\n264:   }\n265: \n266:   public void startConsidering(String decision) {\n267:     _decisions.startConsidering(decision);\n268:   }\n269: \n270:   public void startConsidering(Decision d) {\n271:     _decisions.startConsidering(d);\n272:   }\n273: \n274:   public void stopConsidering(String decision) {\n275:     _decisions.stopConsidering(decision);\n276:   }\n277: \n278:   public void stopConsidering(Decision d) {\n279:     _decisions.stopConsidering(d);\n280:   }\n281: \n282:   /** Record the extent to which the designer desires the given goal. */\n283:   public boolean hasGoal(String goal) { return _goals.hasGoal(goal); }\n284: \n285:   public void setGoalPriority(String goal, int priority) {\n286:     _goals.setGoalPriority(goal, priority);\n287:   }\n288: \n289: //   public Object getGoalInfo(String goal){\n290: //     return _goals.getGoalInfo(goal);\n291: //   }\n292: \n293: //   public void setGoalInfo(String 