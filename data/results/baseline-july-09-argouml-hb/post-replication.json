 }\n243: \n244: \n245: /**\n246:  * This is the base class of relays of events.\n247:  *\n248:  * @author Linus Tolke\n249:  */\n250: abstract class NSUMLEventListener implements MElementListener {\n251:     /**\n252:      * Contains a WeakReference.\n253:      */\n254:     Reference listenerRef;\n255:     Object element;\n256:     String[] events;\n257: \n258:     /**\n259:      * Constructor for the NSUMLEventListener.\n260:      * \n261:      * @param l The PropertyChangeListener.\n262:      * @param e The object we are monitoring, can be a class.\n263:      * @param evs The strings that we are interested in.\n264:      */\n265:     NSUMLEventListener(PropertyChangeListener l, Object e, String[] evs) {\n266:         listenerRef = new WeakReference(l);\n267:         element = e;\n268:         events = evs;\n269:     }\n270:     \n271:     /**\n272:      * Returns the listener or <tt>null</tt> if the listener is \n273:      * already Garbage collected.\n274:      * \n275:      * @return Returns the listener.\n276:      */\n277:     PropertyChangeListener getListener() {\n278:         PropertyChangeListener pcl = (PropertyChangeListener) listenerRef.get();\n279:         if (pcl == null) {\n280:             delete();\n281:         }\n282:         return pcl;\n283:     }\n284: \n285:     /**\n286:      * @return Returns the element.\n287:      */\n288:     Object getElement() {\n289:         return element;\n290:     }\n291:     /**\n292:      * @return Returns the events.\n293:      */\n294:     String[] getEvents() {\n295:         return events;\n296:     }\n297:     \n298:     /**\n299:      * Unregister this event listener and remove all information about it.\n300:      */\n301:     public abstract void delete();\n302:     \n303:     /**\n304:      * Returns <tt>true</tt> if this event listener matches the object\n305:      * and event names.\n306:      * \n307:      * @param e The object to match.\n308:      * @param evs The event names to match.\n309:      * @re