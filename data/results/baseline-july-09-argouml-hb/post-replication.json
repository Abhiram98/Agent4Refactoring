g.apache.xpath.operations.String;\n34: import org.argouml.kernel.ProjectManager;\n35: import org.argouml.model.ModelFacade;\n36: import org.argouml.model.uml.ExtensionMechanismsFactory;\n37: import org.argouml.model.uml.ExtensionMechanismsHelper;\n38: import org.argouml.model.uml.UmlFactory;\n39: import org.argouml.model.uml.UmlHelper;\n40: \n41: import ru.novosoft.uml.behavior.collaborations.MClassifierRole;\n42: import ru.novosoft.uml.foundation.core.MAttribute;\n43: import ru.novosoft.uml.foundation.core.MClassifier;\n44: import ru.novosoft.uml.foundation.core.MNamespace;\n45: import ru.novosoft.uml.foundation.core.MOperation;\n46: import ru.novosoft.uml.foundation.core.MParameter;\n47: import ru.novosoft.uml.foundation.data_types.MMultiplicity;\n48: import ru.novosoft.uml.foundation.data_types.MParameterDirectionKind;\n49: import ru.novosoft.uml.foundation.extension_mechanisms.MStereotype;\n50: \n51: /**\n52:  * Testing the ParserDisplay class.<p>\n53:  *\n54:  * For some mysterious reason these tests depend on the ProjectBrowser\n55:  * which means that they cannot be run in Headless mode.\n56:  */\n57: public class GUITestParserDisplay extends TestCase {\n58:     private static final String ATTR01 = \"name\";\n59:     private static final String ATTR02 = \"+name\";\n60:     private static final String ATTR03 = \"-name : void\";\n61:     private static final String ATTR04 = \"#name [1..1] : int {a=b}\";\n62:     private static final String ATTR05 = \n63: \t\"public name {a=b, c = d } : [1..*] int = 0\";\n64:     private static final String ATTR06 =\n65: \t\"private name {a=b, c = d } [*..*] : int = 15 {frozen}\";\n66:     private static final String ATTR07 = \"+name : String = \\'val[15] \\'\";\n67:     private static final String ATTR08 = \n68: \t\"  + name : String = \\\"a <<string>>\\\"\";\n69:     private static final String ATTR09 = \"+name : String = (a * (b+c) - d)\";\n70:     private static final String ATTR10 =\n71: \t\"+name << attrstereo1 >> : String = 2 * (b+c) - 10\";\n72:     private static final String ATTR11 =\n73: \t\"<<attrstereo2>> +name : String = a[15]\";\n74:     private static final String ATTR12 = \"+ name : String = a << 5\";\n75: \n76:     private static final String NATTR01 = \"too many string in an attribute\";\n77:     private static final String NATTR02 = \"+vis name\";\n78:     private static final String NATTR03 = \"vis name : type : type\";\n79:     private static final String NATTR04 = \"vis name = 0 = 1\";\n80:     private static final String NATTR05 = \"vis name [1..1] [1..1]\";\n81:     private static final String NATTR06 = \"vis name [1..1\";\n82:     private static final String NATTR07 = \"vis name { a = b, cv = \";\n83:     private static final String NATTR08 = \"vis \\\"name\\\"\";\n84:     private static final String NATTR09 = \"\\\"vis\\\" name\";\n85:     private static final String NATTR10 = \"vis (name)\";\n86:     private static final String NATTR11 = \"(vis) name\";\n87:     private static final String NATTR12 = \"vis name : \\\"type\\\"\";\n88:     private static final String NATTR13 = \"vis name : (type)\";\n89: \n90:     private static final String OPER01 = \"name()\";\n91:     private static final String OPER02 =\n92: \t\"<<opstereo1>> -name(in foo: float = 0) \"\n93: \t+ \"{root, abstract = false} : int\";\n94:     private static final String OPER03 =\n95: \t\"<< opstereo2 >> protected name2(\"\n96: \t+ \"out foo: double = 0., inout bar = \\\"\\\"some\\\"\\\":String) \"\n97: \t+ \"{leaf,query} : String\";\n98:     private static final String OPER04 = \"<<>> # name2()\";\n99: \n100:     private static final String NOPER01 = \"name(\";\n101:     private static final String NOPER02 = \"\\\"name\\\"()\";\n102:     private static final String NOPER03 = \"\\\"vis\\\" name()\";\n103:     private static final String NOPER04 = \"\\'name\\'()\";\n104:     private static final String NOPER05 = \"\\'vis\\' name()\";\n105:     private static final String NOPER06 = \"(name)()\";\n106:     private static final String NOPER07 = \"(vis) name()\";\n107:     private static final String NOPER08 = \"name() : \\\"type\\\"\";\n108:     private static final String NOPER09 = \"name() : \\'type\\'\";\n109:     private static final String NOPER10 = \"name() : (type)\";\n110: \n111: \n112:     /**\n113:      * @see junit.framework.TestCase#TestCase()\n114:      */\n115:     public GUITestParserDisplay(String str) {\n116: \tsuper(str);\n117:     }\n118: \n119:     /**\n120:      * Test the parsing of an attribute name.\n121:      *\n122:      * @throws ParseException if the parsing fails.\n123:      */\n124:     public void testAttributeName()\n125: \tthrows ParseException\n126:     {\n127:         Object feature;\n128:         \n129:         MNamespace ns = (MNamespace)\n130:             ProjectManager.getManager().getCurrentProject().getModel();\n131:         \n132:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n133:         ModelFacade.setNamespace(feature, ns);\n134:         \n135:         checkName(feature, ATTR01, \"name\");\n136:         \n137:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n138:         ModelFacade.setNamespace(feature, ns);\n139:         \n140:         checkName(feature, ATTR02, \"name\");\n141:         \n142:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n143:         ModelFacade.setNamespace(feature, ns);\n144:         \n145:         checkName(feature, ATTR03, \"name\");\n146:         \n147:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n148:         ModelFacade.setNamespace(feature, ns);\n149:         \n150:         checkName(feature, ATTR04, \"name\");\n151:         \n152:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n153:         ModelFacade.setNamespace(feature, ns);\n154:         \n155:         checkName(feature, ATTR05, \"name\");\n156:         \n157:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n158:         ModelFacade.setNamespace(feature, ns);\n159:         \n160:         checkName(feature, ATTR06, \"name\");\n161:     }\n162: \n163: \n164:     /**\n165:      * Test the parsing of an attribute's type.\n166:      *\n167:      * @throws ParseException if the parsing fails.\n168:      */\n169:     public void testAttributeType() throws ParseException {\n170:         Object feature;\n171:         \n172:         MNamespace ns =  (MNamespace)\n173:             ProjectManager.getManager().getCurrentProject().getModel();\n174:         \n175:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n176:         ModelFacade.setNamespace(feature, ns);\n177:         \n178:         checkType(feature, ATTR03, \"void\");\n179:         \n180:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n181:         ModelFacade.setNamespace(feature, ns);\n182:         \n183:         checkType(feature, ATTR04, \"int\");\n184:         \n185:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n186:         ModelFacade.setNamespace(feature, ns);\n187:         \n188:         checkType(feature, ATTR05, \"int\");\n189:         \n190:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n191:         ModelFacade.setNamespace(feature, ns);\n192:         \n193:         checkType(feature, ATTR06, \"int\");\n194:     }\n195: \n196:     /**\n197:      * Test the parsing of the attribute's visibility.\n198:      *\n199:      * @throws ParseException if the parsing fails.\n200:      */\n201:     public void testAttributeVisibility() throws ParseException {\n202:         Object feature;\n203:         \n204:         MNamespace ns =  (MNamespace)\n205:             ProjectManager.getManager().getCurrentProject().getModel();\n206:         \n207:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n208:         ModelFacade.setNamespace(feature, ns);\n209:         \n210:         checkVisibility(feature, ATTR02, \"public\");\n211:         \n212:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n213:         ModelFacade.setNamespace(feature, ns);\n214:         \n215:         checkVisibility(feature, ATTR03, \"private\");\n216:         \n217:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n218:         ModelFacade.setNamespace(feature, ns);\n219:         \n220:         checkVisibility(feature, ATTR04, \"protected\");\n221:         \n222:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n223:         ModelFacade.setNamespace(feature, ns);\n224:         \n225:         checkVisibility(feature, ATTR05, \"public\");\n226:         checkVisibility(feature, ATTR01, \"public\");\n227:         \n228:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n229:         ModelFacade.setNamespace(feature, ns);\n230:         \n231:         checkVisibility(feature, ATTR06, \"private\");\n232:         checkVisibility(feature, ATTR01, \"private\");\n233:         \n234:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n235:         ModelFacade.setNamespace(feature, ns);\n236:         \n237:         checkVisibility(feature, ATTR08, \"public\");\n238:         \n239:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n240:         ModelFacade.setNamespace(feature, ns);\n241:         \n242:         checkVisibility(feature, ATTR11, \"public\");\n243:     }\n244: \n245:     /**\n246:      * Test the parsing of an attribute's property.\n247:      *\n248:      * @throws ParseException if the parsing fails.\n249:      */\n250:     public void testAttributeProperty() throws ParseException {\n251:         Object feature;\n252:         String res1[] = {\n253:             \"a\", \"b\" \n254:         };\n255:         String res2[] = {\n256:             \"a\", \"b\", \"c\", \"d\"\n257:         };\n258:         String res3[] = {\n259:             \"a\", \"b\", \"c\", \"d\", \"frozen\", null \n260:         };\n261:         \n262:         MNamespace ns =  (MNamespace)\n263:             ProjectManager.getManager().getCurrentProject().getModel();\n264:         \n265:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n266:         ModelFacade.setNamespace(feature, ns);\n267:         \n268:         checkProperties(feature, ATTR04, res1);\n269:         \n270:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n271:         ModelFacade.setNamespace(feature, ns);\n272:         \n273:         checkProperties(feature, ATTR05, res2);\n274:         \n275:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n276:         ModelFacade.setNamespace(feature, ns);\n277:         \n278:         checkProperties(feature, ATTR06, res3);\n279:     }\n280: \n281:     /**\n282:      * Test parsing an attribute's multiplicity.\n283:      *\n284:      * @throws ParseException if the parsing fails.\n285:      */\n286:     public void testAttributeMultiplicity() throws ParseException {\n287:         Object feature;\n288:         \n289:         MNamespace ns =  (MNamespace)\n290:             ProjectManager.getManager().getCurrentProject().getModel();\n291:         \n292:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n293:         ModelFacade.setNamespace(feature, ns);\n294:         \n295:         checkMultiplicity(feature, ATTR04, new MMultiplicity(\"1..1\"));\n296:         \n297:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n298:         ModelFacade.setNamespace(feature, ns);\n299:         \n300:         checkMultiplicity(feature, ATTR05, new MMultiplicity(\"1..*\"));\n301:         \n302:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n303:         ModelFacade.setNamespace(feature, ns);\n304:         \n305:         checkMultiplicity(feature, ATTR06, new MMultiplicity(\"*..*\"));\n306:     }\n307: \n308:     /**\n309:      * Test that the parser throws the correct exceptions.\n310:      *\n311:      * @throws ParseException if the parsing fails.\n312:      */\n313:     public void testAttributeParseExceptions() throws ParseException {\n314:         Object attr;\n315:         \n316:         MNamespace ns =  (MNamespace)\n317:             ProjectManager.getManager().getCurrentProject().getModel();\n318:         \n319:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n320:         ModelFacade.setNamespace(attr, ns);\n321:         \n322:         checkThrows(attr, NATTR01, true, false, false);\n323:         checkThrows(attr, NATTR02, true, false, false);\n324:         checkThrows(attr, NATTR03, true, false, false);\n325:         checkThrows(attr, NATTR04, true, false, false);\n326:         checkThrows(attr, NATTR05, true, false, false);\n327:         checkThrows(attr, NATTR06, true, false, false);\n328:         checkThrows(attr, NATTR07, true, false, false);\n329:         checkThrows(attr, NATTR08, true, false, false);\n330:         checkThrows(attr, NATTR09, true, false, false);\n331:         checkThrows(attr, NATTR10, true, false, false);\n332:         checkThrows(attr, NATTR11, true, false, false);\n333:         checkThrows(attr, NATTR12, true, false, false);\n334:         checkThrows(attr, NATTR13, true, false, false);\n335:     }\n336: \n337:     /**\n338:      * Test the parsing of an attribute's value.\n339:      *\n340:      * @throws ParseException if the parsing fails.\n341:      */\n342:     public void testAttributeValue() throws ParseException {\n343:         Object attr;\n344:         \n345:         MNamespace ns =  (MNamespace)\n346:             ProjectManager.getManager().getCurrentProject().getModel();\n347:         \n348:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n349:         ModelFacade.setNamespace(attr, ns);\n350:         \n351:         checkValue(attr, ATTR05, \"0\");\n352:         checkValue(attr, ATTR01, \"0\");\n353:         checkValue(attr, ATTR06, \"15\");\n354:         \n355:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n356:         ModelFacade.setNamespace(attr, ns);\n357:         \n358:         checkValue(attr, ATTR07, \"\\'val[15] \\'\");\n359:         \n360:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n361:         ModelFacade.setNamespace(attr, ns);\n362:         \n363:         checkValue(attr, ATTR08, \"\\\"a <<string>>\\\"\");\n364:         \n365:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n366:         ModelFacade.setNamespace(attr, ns);\n367:         \n368:         checkValue(attr, ATTR09, \"(a * (b+c) - d)\");\n369:         \n370:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n371:         ModelFacade.setNamespace(attr, ns);\n372:         \n373:         checkValue(attr, ATTR10, \"2 * (b+c) - 10\");\n374:         \n375:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n376:         ModelFacade.setNamespace(attr, ns);\n377:         \n378:         checkValue(attr, ATTR11, \"a[15]\");\n379:         \n380:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n381:         ModelFacade.setNamespace(attr, ns);\n382:         \n383:         checkValue(attr, ATTR12, \"a << 5\");\n384:     }\n385: \n386:     private void softAddStereotype(String name, Object elem)\n387:         throws ParseException {\n388:         MNamespace ns =  (MNamespace)\n389:             ProjectManager.getManager().getCurrentProject().getModel();\n390:         \n391:         Iterator it =\n392:             ExtensionMechanismsHelper.getHelper()\n393:                 .getStereotypes(ns).iterator();\n394:         while (it.hasNext()) {\n395:             MStereotype s = (MStereotype) it.next();\n396:             if (name.equals(s.getName())) {\n397:                 return;\n398:             }\n399:         }\n400:         ExtensionMechanismsFactory.getFactory().buildStereotype(\n401:             elem, \n402:             name,\n403:             ns);\n404:     }\n405: \n406: \n407:     /**\n408:      * Test the parsing of an attribute's stereotype.\n409:      *\n410:      * @throws ParseException if the parsing fails.\n411:      */\n412:     public void testAttributeStereotype() throws ParseException {\n413:         Object attr;\n414:         \n415:         MNamespace ns =  (MNamespace)\n416:             ProjectManager.getManager().getCurrentProject().getModel();\n417:         \n418:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n419:         ModelFacade.setNamespace(attr, ns);\n420:         \n421:         softAddStereotype(\"attrstereo1\", attr);\n422:         softAddStereotype(\"attrstereo2\", attr);\n423:         \n424:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n425:         ModelFacade.setNamespace(attr, ns);\n426:         \n427:         checkStereotype(attr, ATTR01, null);\n428:         \n429:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n430:         ModelFacade.setNamespace(attr, ns);\n431:         \n432:         checkStereotype(attr, ATTR10, \"attrstereo1\");\n433:         \n434:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n435:         ModelFacade.setNamespace(attr, ns);\n436:         \n437:         checkStereotype(attr, ATTR11, \"attrstereo2\");\n438:         checkStereotype(attr, ATTR01, \"attrstereo2\");\n439:     }\n440: \n441:     /**\n442:      * Test the parsing of an operation's name.\n443:      *\n444:      * @throws ParseException if the parsing fails.\n445:      */\n446:     public void testOperationName() throws ParseException {\n447:         MOperation op;\n448:         Object cl = UmlFactory.getFactory().getCore().buildClass();\n449:         \n450:         MNamespace ns =  (MNamespace)\n451:             ProjectManager.getManager().getCurrentProject().getModel();\n452:         \n453:         ModelFacade.setNamespace(cl, ns);\n454:         \n455:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n456:         checkName(op, OPER01, \"name\");\n457:         \n458:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n459:         checkName(op, OPER02, \"name\");\n460:         \n461:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n462:         checkName(op, OPER03, \"name2\");\n463:     }\n464: \n465:     /**\n466:      * Test the parsing of an operation's type.\n467:      *\n468:      * @throws ParseException if the parsing fails.\n469:      */\n470:     public void testOperationType() throws ParseException {\n471:         MOperation op;\n472:         Object cl = UmlFactory.getFactory().getCore().buildClass();\n473:         \n474:         MNamespace ns =  (MNamespace)\n475:             ProjectManager.getManager().getCurrentProject().getModel();\n476:         \n477:         ModelFacade.setNamespace(cl, ns);\n478:         \n479:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n480:         checkType(op, OPER01, \"void\");\n481:         \n482:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n483:         checkType(op, OPER02, \"int\");\n484:         checkType(op, OPER01, \"int\");\n485:         \n486:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n487:         checkType(op, OPER03, \"String\");\n488:     }\n489: \n490:     /**\n491:      * Test the parsing of an operation's visibility.\n492:      *\n493:      * @throws ParseException if the parsing fails.\n494:      */\n495:     public void testOperationVisibility() throws ParseException {\n496:         MOperation op;\n497:         Object cl = UmlFactory.getFactory().getCore().buildClass();\n498:         MNamespace ns =  (MNamespace)\n499:             ProjectManager.getManager().getCurrentProject().getModel();\n500:         \n501:         ModelFacade.setNamespace(cl, ns);\n502:         \n503:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n504:         che