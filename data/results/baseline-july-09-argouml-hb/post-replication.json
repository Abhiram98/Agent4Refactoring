2: import org.argouml.model.Model;\n33: import org.argouml.uml.ui.UMLModelElementOrderedListModel2;\n34: \n35: /**\n36:  * The list model for the connections of the association. <p>\n37:  * \n38:  * The specialty of this list model, is that it need to be aware \n39:  * of name changes in the ends connected to the association. \n40:  * Most other listmodels only listen to \n41:  * model changes in one UML element, but in this case, we also have to listen to\n42:  * changes in some related elements. <p>\n43:  * \n44:  * Why is this case different: because it is possible to modify the \n45:  * associationend names on the diagram, without changing the target - i.e.\n46:  * the target remains the association throughout this modification.\n47:  *\n48:  * @author jaap.branderhorst@xs4all.nl\n49:  * @since Jan 4, 2003\n50:  */\n51: public class UMLAssociationConnectionListModel\n52:     extends UMLModelElementOrderedListModel2 {\n53: \n54:     private Collection others;\n55: \n56:     /**\n57:      * Constructor for UMLModelElementClientDependencyListModel.\n58:      */\n59:     public UMLAssociationConnectionListModel() {\n60:         super(\"connection\");\n61:     }\n62: \n63:      /**\n64:      * @see org.argouml.uml.ui.UMLModelElementListModel2#addOtherModelEventListeners(java.lang.Object)\n65:      */\n66:     protected void addOtherModelEventListeners(Object newTarget) {\n67:         super.addOtherModelEventListeners(newTarget);\n68:         /* Make a copy of the modelelements: */\n69:         others = new ArrayList(Model.getFacade().getConnections(newTarget));\n70:         Iterator i = others.iterator();\n71:         while (i.hasNext()) {\n72:             Object end = i.next();\n73:             Model.getPump().addModelEventListener(this, end, \"name\");\n74:         }\n75:     }\n76: \n77:     /**\n78:      * @see org.argouml.uml.ui.UMLModelElementListModel2#removeOtherModelEventListeners(java.lang.Object)\n79:      */\n80:     protected void removeOtherModelEventListeners(Object oldTarget) {\n81:         super.removeOtherModelEventListeners(oldTarget);\n82:         Iterator i = others.iterator();\n83:         while (i.hasNext()) {\n84:             Object end = i.next();\n85:             Model.getPump().removeModelEventListener(this, end, \"name\");\n86:         }\n87:         others.clear();\n88:     }\n89: \n90:     /**\n91:      * @see org.argouml.uml.ui.UMLModelElementListModel2#buildModelList()\n92:      */\n93:     protected void buildModelList() {\n94:         if (getTarget() != null) {\n95:             setAllElements(Model.getFacade().getConnections(getTarget()));\n96:         }\n97:     }\n98: \n99:     /**\n100:      * @see org.argouml.uml.ui.UMLModelElementListModel2#isValidElement(Object)\n101:      */\n102:     protected boolean isValidElement(Object/*MBase*/ o) {\n103:         return Model.getFacade().isAAssociationEnd(o)\n104:             && Model.getFacade().getConnections(getTarget()).contains(o);\n105:     }\n106: \n107: \n108:     /**\n109:      * @see org.argouml.uml.ui.UMLModelElementOrderedListModel2#moveTo(int, int)\n110:      */\n111:     public void swap(int index1, int index2) {\n112:         Object assoc = getTarget();\n113:         List c = new ArrayList(Model.getFacade().getConnections(assoc));\n114:         Object mem1 = c.get(index1);\n115:         Object mem2 = c.get(index2);\n116:         c.set(index1, mem2);\n117:         c.set(index2, mem1);\n118:         Model.getCoreHelper().setConnections(assoc, c);\n119:         buildModelList();\n120:     }\n121: }\n122: ",
