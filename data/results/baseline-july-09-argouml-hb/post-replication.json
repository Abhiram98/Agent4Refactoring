wt.event.ItemListener;\n33: import java.awt.event.KeyEvent;\n34: import java.awt.event.KeyListener;\n35: \n36: import javax.swing.JColorChooser;\n37: import javax.swing.JComboBox;\n38: import javax.swing.JLabel;\n39: import javax.swing.JTextField;\n40: import javax.swing.text.Document;\n41: \n42: import org.argouml.i18n.Translator;\n43: import org.argouml.kernel.ProjectManager;\n44: import org.argouml.swingext.SpacerPanel;\n45: import org.argouml.uml.diagram.ui.FigEdgeModelElement;\n46: import org.tigris.gef.ui.ColorRenderer;\n47: \n48: /**\n49:  * The basic stylepanel which provides the boundaries box,\n50:  * line and fill color information.\n51:  *\n52:  */\n53: public class StylePanelFig\n54:     extends StylePanel\n55:     implements ItemListener,\n56:         FocusListener, KeyListener {\n57:     private static final String CUSTOM_ITEM =\n58:         Translator.localize(\"label.stylepane.custom\") + \"...\";\n59: \n60:     private JLabel bboxLabel =\n61:         new JLabel(Translator.localize(\"label.stylepane.bounds\") + \": \");\n62: \n63:     private JTextField bboxField = new JTextField();\n64: \n65:     private JLabel fillLabel =\n66:         new JLabel(Translator.localize(\"label.stylepane.fill\") + \": \");\n67: \n68:     private JComboBox fillField = new JComboBox();\n69: \n70:     private JLabel lineLabel =\n71:         new JLabel(Translator.localize(\"label.stylepane.line\") + \": \");\n72: \n73:     private JComboBox lineField = new JComboBox();\n74: \n75:     private SpacerPanel spacer = new SpacerPanel();\n76: \n77:     private SpacerPanel spacer2 = new SpacerPanel();\n78: \n79:     private SpacerPanel spacer3 = new SpacerPanel();\n80: \n81:     /**\n82:      * The constructor of the style panel of a Fig.\n83:      * This constructor does not create any contents of the panel.\n84:      *\n85:      * @param title the title string\n86:      */\n87:     public StylePanelFig(String title) {\n88:         super(title);\n89:     }\n90: \n91:     /**\n92:      * The constructor.\n93:      *\n94:      */\n95:     public StylePanelFig() {\n96:         super(\"Fig Appearance\");\n97:         initChoices();\n98: \n99:         Document bboxDoc = bboxField.getDocument();\n100:         bboxDoc.addDocumentListener(this);\n101:         bboxField.addKeyListener(this);\n102:         bboxField.addFocusListener(this);\n103:         fillField.addItemListener(this);\n104:         lineField.addItemListener(this);\n105: \n106:         fillField.setRenderer(new ColorRenderer());\n107:         lineField.setRenderer(new ColorRenderer());\n108: \n109:         bboxLabel.setLabelFor(bboxField);\n110:         add(bboxLabel);\n111:         add(bboxField);\n112: \n113:         fillLabel.setLabelFor(fillField);\n114:         add(fillLabel);\n115:         add(fillField);\n116: \n117:         lineLabel.setLabelFor(lineField);\n118:         add(lineLabel);\n119:         add(lineField);\n120:     }\n121: \n122:     /**\n123:      * Fill in the user-choices.\n124:      */\n125:     protected void initChoices() {\n126:         fillField.addItem(Translator.localize(\"label.stylepane.no-fill\"));\n127:         fillField.addItem(Color.black);\n128:         fillField.addItem(Color.white);\n129:         fillField.addItem(Color.gray);\n130:         fillField.addItem(Color.lightGray);\n131:         fillField.addItem(Color.darkGray);\n132:         fillField.addItem(new Color(255, 255, 200));\n133:         fillField.addItem(new Color(255, 200, 255));\n134:         fillField.addItem(new Color(200, 255, 255));\n135:         fillField.addItem(new Color(200, 200, 255));\n136:         fillField.addItem(new Color(200, 255, 200));\n137:         fillField.addItem(new Color(255, 200, 200));\n138:         fillField.addItem(new Color(200, 200, 200));\n139:         fillField.addItem(Color.red);\n140:         fillField.addItem(Color.blue);\n141:         fillField.addItem(Color.cyan);\n142:         fillField.addItem(Color.yellow);\n143:         fillField.addItem(Color.magenta);\n144:         fillField.addItem(Color.green);\n145:         fillField.addItem(Color.orange);\n146:         fillField.addItem(Color.pink);\n147:         fillField.addItem(CUSTOM_ITEM);\n148: \n149:         lineField.addItem(Translator.localize(\"label.stylepane.no-line\"));\n150:         lineField.addItem(Color.black);\n151:         lineField.addItem(Color.white);\n152:         lineField.addItem(Color.gray);\n153:         lineField.addItem(Color.lightGray);\n154:         lineField.addItem(Color.darkGray);\n155:         lineField.addItem(new Color(60, 60, 200));\n156:         lineField.addItem(new Color(60, 200, 60));\n157:         lineField.addItem(new Color(200, 60, 60));\n158:         lineField.addItem(Color.red);\n159:         lineField.addItem(Color.blue);\n160:         lineField.addItem(Color.cyan);\n161:         lineField.addItem(Color.yellow);\n162:         lineField.addItem(Color.magenta);\n163:         lineField.addItem(Color.green);\n164:         lineField.addItem(Color.orange);\n165:         lineField.addItem(Color.pink);\n166:         lineField.addItem(CUSTOM_ITEM);\n167:     }\n168: \n169:     /**\n170:      * set whether this Fig has a editable boundingbox. This is done normally in\n171:      * <code>refresh()</code>, e.g. for FigEdgeModelElements where it does\n172:      * not make sense to edit the bounding box.\n173:      *\n174:      * @param value\n175:      *            the boolean value of the bounding box property\n176:      */\n177: \n178:     protected void hasEditableBoundingBox(boolean value) {\n179:         bboxField.setEnabled(value);\n180:         bboxLabel.setEnabled(value);\n181:     }\n182: \n183:     /**\n184:      * Handle a refresh of the style panel after the fig has moved.<p>\n185:      *\n186:      * <em>Warning</em>. There is a circular trap here. Editing the\n187:      * boundary box will also trigger a refresh, and so we reset the\n188:      * boundary box, which causes funny behaviour (the cursor keeps\n189:      * jumping to the end of the text).\n190:      *\n191:      * The solution is to not reset the boundary box field if the boundaries\n192:      * have not changed.<p>\n193:      */\n194:     public void refresh() {\n195: \n196:         if (getPanelTarget() instanceof FigEdgeModelElement) {\n197:             hasEditableBoundingBox(false);\n198:         } else {\n199:             hasEditableBoundingBox(true);\n200:         }\n201: \n202:         // The boundary box as held in the target fig, and as listed in\n203:         // the\n204:         // boundary box style field (null if we don't have anything\n205:         // valid)\n206: \n207:         Rectangle figBounds = getPanelTarget().getBounds();\n208:         Rectangle styleBounds = parseBBox();\n209: \n210:         // Only reset the text if the two are not the same (i.e the fig\n211:         // has\n212:         // moved, rather than we've just edited the text, when\n213:         // setTargetBBox()\n214:         // will have made them the same). Note that styleBounds could\n215:         // be null,\n216:         // so we do the test this way round.\n217: \n218:         if (!(figBounds.equals(styleBounds))) {\n219:             bboxField.setText(figBounds.x + \",\" + figBounds.y + \",\"\n220:                     + figBounds.width + \",\" + figBounds.height);\n221:         }\n222: \n223:         // Change the fill colour\n224: \n225:         if (getPanelTarget().getFilled()) {\n226:             Color c = getPanelTarget().getFillColor();\n227:             fillField.setSelectedItem(c);\n228:             if (c != null && !fillField.getSelectedItem().equals(c)) {\n229:                 fillField.insertItemAt(c, fillField.getItemCount() - 1);\n230:                 fillField.setSelectedItem(c);\n231:             }\n232:         } else {\n233:             fillField.setSelectedIndex(0);\n234:         }\n235: \n236:         // Change the line colour\n237: \n238:         if (getPanelTarget().getLineWidth() > 0) {\n239:             Color c = getPanelTarget().getLineColor();\n240:             lineField.setSelectedItem(c);\n241:             if (c != null && !lineField.getSelectedItem().equals(c)) {\n242:                 lineField.insertItemAt(c, lineField.getItemCount() - 1);\n243:                 lineField.setSelectedItem(c);\n244:             }\n245:         } else {\n246:             lineField.setSelectedIndex(0);\n247:         }\n248: \n249:     }\n250: \n251:     /**\n252:      * Change the bounds of the target fig. Called whenever the bounds box is\n253:      * edited. <p>\n254:      *\n255:      * Format of the bounds is four integers representing x, y, width and height\n256:      * separated by spaces or commas. An empty field is treated as no change and\n257:      * leading and trailing spaces are ignored. <p>\n258:      *\n259:      * <em>Note</em>. There is a note in the old code that more work might be\n260:      * needed, because this could change the graph model. I don't see how that\n261:      * could ever be.\n262:      */\n263:     protected void setTargetBBox() {\n264:         // Can't do anything if we don't have a fig.\n265:         if (getPanelTarget() == null) { return; }\n266:         // Parse the boundary box text. Null is\n267:         // returned if it is empty or\n268:         // invalid, which causes no change. Otherwise we tell\n269:         // GEF we are making\n270:         // a change, make the change and tell GEF we've\n271:         // finished.\n272:         Rectangle bounds = parseBBox();\n273:         if (bounds == null) { return; }\n274: \n275:         if (!getPanelTarget().getBounds().equals(bounds)) {\n276:             getPanelTarget().setBounds(bounds.x, bounds.y, bounds.width,\n277:                     bounds.height);\n278:             getPanelTarget().endTrans();\n279:             ProjectManager.getManager().setNeedsSave(true);\n280:         }\n281:     }\n282: \n283:     /**\n284:      * Parse the boundary box string and return the rectangle it\n285:      * represents.<p>\n286:      *\n287:      * The syntax are four integers separated by spaces or commas. We\n288:      * ignore leading and trailing blanks.<p>\n289:      *\n290:      * If we have the empty string we return <code>null</code>.<p>\n291:      *\n292:      * If we fail to parse, then we return <code>null</code> and print\n293:      * out a rude message.<p>\n294:      *\n295:      * @return The size of the box, or <code>null</code> if the bounds string\n296:      *         is empty or invalid.\n297:      */\n298:     protected Rectangle parseBBox() {\n299:         // Get the text in the field, and don't do anything if the\n300:         // field is\n301:         // empty.\n302:         String bboxStr = bboxField.getText().trim();\n303:         if (bboxStr.length() == 0) {\n304:             return null;\n305:         } // Parse the string as if\n306:         // possible\n307:         Rectangle res = new Rectangle();\n308:         java.util.StringTokenizer st =\n309:             new java.util.StringTokenizer(bboxStr, \", \");\n310:         try {\n311:             boolean changed = false;\n312:             if (!st.hasMoreTokens()) {\n313:                 return getPanelTarget().getBounds();\n314:             }\n315:             res.x = Integer.parseInt(st.nextToken());\n316:             if (!st.hasMoreTokens()) {\n317:                 res.y = getPanelTarget().getBounds().y;\n318:                 res.width = getPanelTarget().getBounds().width;\n319:                 res.height = getPanelTarget().getBounds().height;\n320:                 return res;\n321:             }\n322:             res.y = Integer.parseInt(st.nextToken());\n323:             if (!st.hasMoreTokens()) {\n324:                 res.width = getPanelTarget().getBounds().width;\n325:                 res.height = getPanelTarget().getBounds().height;\n326:                 return res;\n327:             }\n328:             res.width = Integer.parseInt(st.nextToken());\n329:             if ((res.width + res.x) > 6000) {\n330:                 res.width = 6000 - res.x;\n331:                 changed = true;\n332:             }\n333:             if (!st.hasMoreTokens()) {\n334:                 res.width = getPanelTarget().getBounds().width;\n335:                 return res;\n336:             }\n337:             res.height = Integer.parseInt(st.nextToken());\n338:             if ((res.height + res.y) > 6000) {\n339:                 res.height = 6000 - res.y;\n340:                 changed = true;\n341:             }\n342:             if (changed) {\n343:                 StringBuffer sb = new StringBuffer();\n344:                 sb.append(Integer.toString(res.x));\n345:                 sb.append(\",\");\n346:                 sb.append(Integer.toString(res.y));\n347:                 sb.append(\",\");\n348:                 sb.append(Integer.toString(res.width));\n349:                 sb.append(\",\");\n350:                 sb.append(Integer.toString(res.height));\n351:                 bboxField.setText(sb.toString());\n352:             }\n353:         } catch (NumberFormatException ex) {\n354:             return null;\n355:         }\n356: \n357:         return res;\n358:     }\n359: \n360:     /**\n361:      * Prompts the user for a new custom color and adds that color to the combo\n362:      * box.\n363:      *\n364:      * @param field the combobox to enter a new color for\n365:      * @param title the title for the dialog box\n366:      * @param targetColor the initial Color set when the color-chooser is shown\n367:      */\n368:     protected void handleCustomColor(JComboBox field, String title,\n369:             Color targetColor) {\n370:         Color newColor =\n371:             JColorChooser.showDialog(ProjectBrowser.getInstance(),\n372:                 title, targetColor);\n373:         if (newColor != null) {\n374:             field.insertItemAt(newColor, field.getItemCount() - 1);\n375:             field.setSelectedItem(newColor);\n376:         } else if (getPanelTarget() != null) {\n377:             field.setSelectedItem(targetColor);\n378:         }\n379:     }\n380: \n381:     /**\n382:      * Change the fill.\n383:      */\n384:     public void setTargetFill() {\n385:         Object c = fillField.getSelectedItem();\n386:         if (getPanelTarget() == null || c == null) {\n387:             return;\n388:         }\n389:         Color oldColor = getPanelTarget().getFillColor();\n390:         if (c instanceof Color) {\n391:             getPanelTarget().setFillColor((Color) c);\n392:         }\n393:         getPanelTarget().setFilled(c instanceof Color);\n394:         getPanelTarget().endTrans();\n395:         if (!c.equals(oldColor)) {\n396:             ProjectManager.getManager().setNeedsSave(true);\n397:         }\n398:     }\n399: \n400:     /**\n401:      * Change the line.\n402:      */\n403:     public void setTargetLine() {\n404:         Object c = lineField.getSelectedItem();\n405:         if (getPanelTarget() == null || c == null) {\n406:             return;\n407:         }\n408:         Color oldColor = getPanelTarget().getLineColor();\n409:         if (c instanceof Color) {\n410:             getPanelTarget().setLineColor((Color) c);\n411:         }\n412:         getPanelTarget().setLineWidth((c instanceof Color) ? 1 : 0);\n413:         getPanelTarget().endTrans();\n414:         if (!c.equals(oldColor)) {\n415:             ProjectManager.getManager().setNeedsSave(true);\n416:         }\n417:     }\n418: \n419:     /**\n420:      * @see java.awt.event.ItemListener#itemStateChanged(java.awt.event.ItemEvent)\n421:      */\n422:     public void itemStateChanged(ItemEvent e) {\n423:         Object src = e.getSource();\n424:         if (e.getStateChange() == ItemEvent.SELECTED\n425:                 && getPanelTarget() != null) {\n426:             if (src == fillField) {\n427:                 if (e.getItem() == CUSTOM_ITEM) {\n428:                     handleCustomColor(fillField, \"Custom Fill Color\",\n429:                             getPanelTarget().getFillColor());\n430:                 }\n431:                 setTargetFill();\n432:             } else if (src == lineField) {\n433:                 if (e.getItem() == CUSTOM_ITEM) {\n434:                     handleCustomColor(lineField, \"Custom Line Color\",\n435:                             getPanelTarget().getLineColor());\n436:                 }\n437:                 setTargetLine();\n438:             }\n439:         }\n440:     }\n441: \n442:     /**\n443:      * @see java.awt.event.FocusListener#focusGained(java.awt.event.FocusEvent)\n444:      */\n445:     public void focusGained(FocusEvent e) {\n446:     }\n447: \n448:     /**\n449:      * Makes sure that the fig is updated when the bboxField loses focus.\n450:      *\n451:      * @see java.awt.event.FocusListener#focusLost(java.awt.event.FocusEvent)\n452:      */\n453:     public void focusLost(FocusEvent e) {\n454:         if (e.getSource() == bboxField) {\n455:             setTargetBBox();\n456:         }\n457:     }\n458: \n459:     /**\n460:      * @see java.awt.event.KeyListener#keyTyped(java.awt.event.KeyEvent)\n461:      */\n462:     public void keyTyped(KeyEvent e) {\n463:     }\n464: \n465:     /**\n466:      * @see java.awt.event.KeyListener#keyReleased(java.awt.event.KeyEvent)\n467:      */\n468:     public void keyReleased(KeyEvent e) {\n469:     }\n470: \n471:     /**\n472:      * Tests if enter is pressed in the _bbodField so we need to set the target\n473:      * bounds.\n474:      *\n475:      * @see java.awt.event.KeyListener#keyTyped(java.awt.event.KeyEvent)\n476:      */\n477:     public void keyPressed(KeyEvent e) {\n478:         if (e.getSource().equals(bboxField) && e.getKeyChar() == '\\n') {\n479:             setTargetBBox();\n480:         }\n481:     }\n482: \n483:     /**\n484:      * @return Returns the _bboxLabel.\n485:      */\n486:     protected JLabel getBBoxLabel() {\n487:         return bboxLabel;\n488:     }\n489: \n490:     /**\n491:   