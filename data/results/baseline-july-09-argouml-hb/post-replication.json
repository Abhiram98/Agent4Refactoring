column indicates that the connection \n176:      * is valid in one direction only.\n177:      * </ul>\n178:      */\n179:     private static final Object[][] VALID_CONNECTIONS = \n180:     {\n181: \t{ModelFacade.GENERALIZATION,   ModelFacade.CLASSIFIER_ROLE},\n182: \t{ModelFacade.GENERALIZATION,   ModelFacade.CLASS},\n183: \t{ModelFacade.GENERALIZATION,   ModelFacade.INTERFACE},\n184: \t{ModelFacade.GENERALIZATION,   ModelFacade.PACKAGE},\n185: \t{ModelFacade.GENERALIZATION,   ModelFacade.USE_CASE},\n186: \t{ModelFacade.GENERALIZATION,   ModelFacade.ACTOR},\n187: \t{ModelFacade.DEPENDENCY,       ModelFacade.PACKAGE},\n188: \t{ModelFacade.DEPENDENCY,       ModelFacade.CLASS},\n189: \t{ModelFacade.DEPENDENCY,       ModelFacade.INTERFACE},\n190: \t{ModelFacade.DEPENDENCY,       ModelFacade.INTERFACE,\n191: \t ModelFacade.CLASS},\n192: \t{ModelFacade.DEPENDENCY,       ModelFacade.INTERFACE,\n193: \t ModelFacade.PACKAGE},\n194: \t{ModelFacade.DEPENDENCY,       ModelFacade.CLASS,\n195: \t ModelFacade.PACKAGE},\n196: \t{ModelFacade.DEPENDENCY,       ModelFacade.USE_CASE},\n197: \t{ModelFacade.DEPENDENCY,       ModelFacade.ACTOR},\n198: \t{ModelFacade.DEPENDENCY,       ModelFacade.ACTOR,\n199: \t ModelFacade.USE_CASE},\n200: \t{ModelFacade.DEPENDENCY,       ModelFacade.COMPONENT},\n201: \t{ModelFacade.DEPENDENCY,       ModelFacade.COMPONENT_INSTANCE},\n202: \t{ModelFacade.DEPENDENCY,       ModelFacade.OBJECT},\n203: \t{ModelFacade.DEPENDENCY,       ModelFacade.COMPONENT,\n204: \t ModelFacade.NODE,               null},\n205: \t{ModelFacade.DEPENDENCY,       ModelFacade.OBJECT,\n206: \t ModelFacade.COMPONENT,          null},\n207: \t{ModelFacade.DEPENDENCY,       ModelFacade.COMPONENT_INSTANCE,\n208: \t ModelFacade.NODE_INSTANCE,      null},\n209: \t{ModelFacade.DEPENDENCY,       ModelFacade.OBJECT,\n210: \t ModelFacade.COMPONENT_INSTANCE, null},\n211: \t{ModelFacade.DEPENDENCY,       ModelFacade.CLASSIFIER_ROLE},\n212: \t{ModelFacade.USAGE,            ModelFacade.CLASS},\n213: \t{ModelFacade.USAGE,            ModelFacade.INTERFACE},\n214: \t{ModelFacade.USAGE,            ModelFacade.PACKAGE},\n215: \t{ModelFacade.USAGE,            ModelFacade.CLASS,\n216: \t ModelFacade.PACKAGE},\n217: \t{ModelFacade.USAGE,            ModelFacade.CLASS,\n218: \t ModelFacade.INTERFACE},\n219: \t{ModelFacade.USAGE,            ModelFacade.INTERFACE,\n220: \t ModelFacade.PACKAGE},\n221: \t{ModelFacade.PERMISSION,       ModelFacade.CLASS},\n222: \t{ModelFacade.PERMISSION,       ModelFacade.INTERFACE},\n223: \t{ModelFacade.PERMISSION,       ModelFacade.PACKAGE},\n224: \t{ModelFacade.PERMISSION,       ModelFacade.CLASS,\n225: \t ModelFacade.PACKAGE},\n226: \t{ModelFacade.PERMISSION,       ModelFacade.CLASS,\n227: \t ModelFacade.INTERFACE},\n228: \t{ModelFacade.PERMISSION,       ModelFacade.INTERFACE,\n229: \t ModelFacade.PACKAGE},\n230: \t{ModelFacade.ABSTRACTION,      ModelFacade.CLASS,\n231: \t ModelFacade.INTERFACE,          null},\n232: \t{ModelFacade.ASSOCIATION,      ModelFacade.CLASS},\n233: \t{ModelFacade.ASSOCIATION,      ModelFacade.CLASS,\n234: \t ModelFacade.INTERFACE},\n235: \t{ModelFacade.ASSOCIATION,      ModelFacade.ACTOR},\n236: \t{ModelFacade.ASSOCIATION,      ModelFacade.USE_CASE},\n237: \t{ModelFacade.ASSOCIATION,      ModelFacade.ACTOR,\n238: \t ModelFacade.USE_CASE},\n239: \t{ModelFacade.ASSOCIATION,      ModelFacade.NODE},\n240: \t{ModelFacade.ASSOCIATION_ROLE, ModelFacade.CLASSIFIER_ROLE},\n241: \t{ModelFacade.EXTEND,           ModelFacade.USE_CASE},\n242: \t{ModelFacade.INCLUDE,          ModelFacade.USE_CASE},\n243: \t{ModelFacade.LINK,             ModelFacade.NODE_INSTANCE},\n244: \t{ModelFacade.LINK,             ModelFacade.OBJECT},\n245: \t{CommentEdge.class,            ModelFacade.MODELELEMENT,\n246: \t ModelFacade.COMMENT},\n247: \t{CommentEdge.class,            ModelFacade.COMMENT,\n248:          ModelFacade.MODELELEMENT},\n249:         {ModelFacade.TRANSITION,       ModelFacade.STATEVERTEX}\n250:     };\n251: \n252:     /** Singleton instance.\n253:      */\n254:     private static final UmlFactory SINGLETON = new UmlFactory();\n255: \n256:     private static Hashtable elements;\n257: \n258:     /** Singleton instance access method.\n259:      * @return the singleton.\n260:      */\n261:     public static UmlFactory getFactory() {\n262:         return SINGLETON;\n263:     }\n264: \n265:     /** Don't allow external instantiation.\n266:      */\n267:     private UmlFactory() {\n268:         buildValidConnectionMap();\n269:         initializeFactoryMethods();\n270:     }\n271: \n272:     private void buildValidConnectionMap() {\n273:         // A list of valid connections between elements, the\n274:         // connection type first and then the elements to be connected\n275:         \n276:         Object connection = null;\n277:         for (int i = 0; i < VALID_CONNECTIONS.length; ++i) {\n278:             connection = VALID_CONNECTIONS[i][0];\n279:             ArrayList validItems =\n280:                 (ArrayList) validConnectionMap.get(connection);\n281:             if (validItems == null) {\n282:                 validItems = new ArrayList();\n283:                 validConnectionMap.put(connection, validItems);\n284:             }\n285:             if (VALID_CONNECTIONS[i].length < 3) {\n286:                 // If there isn't a 3rd column then this represents a connection\n287:                 // of elements of the same type.\n288:                 Object[] modeElementPair = new Class[2];\n289:                 modeElementPair[0] = VALID_CONNECTIONS[i][1];\n290:                 modeElementPair[1] = VALID_CONNECTIONS[i][1];\n291:                 validItems.add(modeElementPair);\n292:             } else {\n293:                 // If there is a 3rd column then this represents a connection\n294:                 // of between 2 different types of element.\n295:                 Object[] modeElementPair = new Class[2];\n296:                 modeElementPair[0] = VALID_CONNECTIONS[i][1];\n297:                 modeElementPair[1] = VALID_CONNECTIONS[i][2];\n298:                 validItems.add(modeElementPair);\n299:                 // If the array hasn't been flagged to indicate otherwise\n300:                 // swap elements the elemnts and add again.\n301:                 if (VALID_CONNECTIONS[i].length < 4) {\n302:                     Object[] reversedModeElementPair = new Class[2];\n303:                     reversedModeElementPair[0] = VALID_CONNECTIONS[i][2];\n304:                     reversedModeElementPair[1] = VALID_CONNECTIONS[i][1];\n305:                     validItems.add(reversedModeElementPair);\n306:                 }\n307:             }\n308:         }\n309:     }\n310: \n311:     private void initializeFactoryMethods() {\n312:         MFactory factory = MFactory.getDefaultFactory();\n313:         elements = new Hashtable(80);\n314:         elements.put(Uml.ABSTRACTION,\n315:             new ObjectCreateInfo(\n316:                 MAbstraction.class,\n317:                 factory,\n318:                 \"createAbstraction\"));\n319:         elements.put(Uml.ASSOCIATION,\n320:             new ObjectCreateInfo(\n321:                 MAssociation.class,\n322:                 factory,\n323:                 \"createAssociation\"));\n324:         elements.put(Uml.ASSOCIATION_ROLE,\n325:             new ObjectCreateInfo(\n326:                 MAssociationRole.class,\n327:                 factory,\n328:                 \"createAssociationRole\"));\n329:         elements.put(Uml.DEPENDENCY,\n330:             new ObjectCreateInfo(\n331:                 MDependency.class,\n332:                 factory,\n333:                 \"createDependency\"));\n334:         elements.put(Uml.EXTEND,\n335:             new ObjectCreateInfo(MExtend.class, factory, \"createExtend\"));\n336:         elements.put(Uml.GENERALIZATION,\n337:             new ObjectCreateInfo(\n338:                 MGeneralization.class,\n339:                 factory,\n340:                 \"createGeneralization\"));\n341:         elements.put(Uml.INCLUDE,\n342:             new ObjectCreateInfo(MInclude.class, factory, \"createInclude\"));\n343:         elements.put(Uml.LINK,\n344:             new ObjectCreateInfo(MLink.class, factory, \"createLink\"));\n345:         elements.put(Uml.LINK_END,\n346:             new ObjectCreateInfo(MLinkEnd.class, factory, \"createLinkEnd\"));\n347:         elements.put(Uml.PERMISSION,\n348:             new ObjectCreateInfo(\n349:                 MPermission.class,\n350:                 factory,\n351:                 \"createPermission\"));\n352:         elements.put(Uml.USAGE,\n353:             new ObjectCreateInfo(MUsage.class, factory, \"createUsage\"));\n354:         elements.put(Uml.TRANSITION,\n355:             new ObjectCreateInfo(\n356:                 MTransition.class,\n357:                 factory,\n358:                 \"createTransition\"));\n359:         elements.put(Uml.ACTOR,\n360:             new ObjectCreateInfo(MActor.class, factory, \"createActor\"));\n361:         elements.put(Uml.CLASS,\n362:             new ObjectCreateInfo(MClass.class, factory, \"createClass\"));\n363:         elements.put(Uml.EXCEPTION,\n364:             new ObjectCreateInfo(MException.class,\n365:                 factory,\n366:                 \"createException\"));\n367:         elements.put(Uml.CLASSIFIER,\n368:             new ObjectCreateInfo(\n369:                 MClassifier.class,\n370:                 factory,\n371:                 \"createClassifier\"));\n372:         elements.put(Uml.CLASSIFIER_ROLE,\n373:             new ObjectCreateInfo(\n374:                 MClassifierRole.class,\n375:                 factory,\n376:                 \"createClassifierRole\"));\n377:         elements.put(Uml.COMPONENT,\n378:             new ObjectCreateInfo(MComponent.class, factory, \"createComponent\"));\n379:         elements.put(Uml.COMPONENT_INSTANCE,\n380:             new ObjectCreateInfo(\n381:                 MComponentInstance.class,\n382:                 CommonBehaviorFactory.getFactory(),\n383:                 \"createComponentInstance\"));\n384:         elements.put(Uml.INSTANCE,\n385:             new ObjectCreateInfo(MInstance.class, factory, \"createInstance\"));\n386:         elements.put(Uml.INTERFACE,\n387:             new ObjectCreateInfo(MInterface.class, factory, \"createInterface\"));\n388:         elements.put(Uml.NODE,\n389:             new ObjectCreateInfo(MNode.class, factory, \"createNode\"));\n390:         elements.put(Uml.NODE_INSTANCE,\n391:             new ObjectCreateInfo(\n392:                 MNodeInstance.class,\n393:                 factory,\n394:                 \"createNodeInstance\"));\n395:         elements.put(Uml.OBJECT,\n396:             new ObjectCreateInfo(MObject.class, factory, \"createObject\"));\n397:         elements.put(Uml.PACKAGE,\n398:             new ObjectCreateInfo(MPackage.class, factory, \"createPackage\"));\n399: \telements.put(Uml.PARTITION,\n400: \t    new ObjectCreateInfo(MPartition.class, factory, \"createPartition\"));\n401:         elements.put(Uml.STATE,\n402:             new ObjectCreateInfo(MState.class, factory, \"createState\"));\n403:         elements.put(Uml.CALL_STATE,\n404:             new ObjectCreateInfo(\n405:                 MCallState.class, \n406:                 factory, \n407:                 \"createCallState\"));\n408:         elements.put(Uml.COMPOSITE_STATE,\n409:             new ObjectCreateInfo(\n410:                 MCompositeState.class,\n411:                 factory,\n412:                 \"createCompositeState\"));\n413:         elements.put(Uml.PSEUDOSTATE,\n414:             new ObjectCreateInfo(\n415:                 MPseudostate.class,\n416:                 factory,\n417:                 \"createPseudostate\"));\n418:         elements.put(Uml.OBJECT_FLOW_STATE,\n419:                 new ObjectCreateInfo(\n420:                     MObjectFlowState.class,\n421:                     factory,\n422:                     \"createObjectFlowState\"));\n423:         elements.put(Uml.SUBACTIVITY_STATE,\n424:                 new ObjectCreateInfo(\n425:                     MSubactivityState.class,\n426:                     factory,\n427:                     \"createSubactivityState\"));\n428:         elements.put(Uml.USE_CASE,\n429:             new ObjectCreateInfo(MUseCase.class, factory, \"createUseCase\"));\n430:         elements.put(Uml.ACTION,\n431:             new ObjectCreateInfo(MAction.class, factory, \"createAction\"));\n432:         elements.put(Uml.ASSOCIATION_END,\n433:             new ObjectCreateInfo(\n434:                 MAssociationEnd.class,\n435:                 factory,\n436:                 \"createAssociationEnd\"));\n437:         elements.put(Uml.CALL_ACTION,\n438:             new ObjectCreateInfo(\n439:                 MCallAction.class,\n440:                 factory,\n441:                 \"createCallAction\"));\n442:         elements.put(Uml.NAMESPACE,\n443:             new ObjectCreateInfo(MNamespace.class, factory, \"createNamespace\"));\n444:         elements.put(Uml.RECEPTION,\n445:             new ObjectCreateInfo(MReception.class, factory, \"createReception\"));\n446:         elements.put(Uml.STEREOTYPE,\n447:             new ObjectCreateInfo(\n448:                 MStereotype.class,\n449:                 factory,\n450:                 \"createStereotype\"));\n451:         elements.put(Uml.ATTRIBUTE,\n452:             new ObjectCreateInfo(MAttribute.class, factory, \"createAttribute\"));\n453:         elements.put(Uml.OPERATION,\n454:             new ObjectCreateInfo(MOperation.class, factory, \"createOperation\"));\n455:         elements.put(Uml.MODEL,\n456:             new ObjectCreateInfo(MModel.class, factory, \"createModel\"));\n457:         elements.put(Uml.DATATYPE,\n458:             new ObjectCreateInfo(MDataType.class, factory, \"createDataType\"));\n459: \n460:         // NSUML does not have a factory method for this\n461:         elements.put(Uml.ACTION_EXPRESSION,\n462:             new ObjectCreateInfo(\n463:                 MActionExpression.class,\n464:                 this,\n465:                 \"createActionExpression\"));\n466: \n467:         // NSUML cannot instantiate an Event object\n468:         // elements.put(Uml.EVENT,\n469:         //     new NsumlObjectInfo(factory,MEvent.class, \"createEvent\"));\n470: \n471:         // NSUML cannot instantiate a State Vertex object\n472:         // elements.put(Uml.STATE_VERTEX,\n473:         //     new NsumlObjectInfo(factory, MStateVertex.class,\n474:         //         \"createStateVertex\"));\n475:     }\n476: \n477:     /**\n478:      * @return boolean to indicate if the JMI Reflective Proxy\n479:      * over NSUML is created.\n480:      */\n481:     public boolean isJmiProxyCreated() {\n482:         return jmiProxyCreated;\n483:     }\n484: \n485:     /**\n486:      * @param arg true to cause the JMI Reflective proxy over NSUML to be used.\n487:      */\n488:     public void setJmiProxyCreated(boolean arg) {\n489:         jmiProxyCreated = arg;\n490:     }\n491:     \n492:     /**\n493:      * Create a new connection model element (a relationship or link)\n494:      * between any existing node model elements.\n495:      * \n496:      * @return the newly created connection element\n497:      * @param connectionType is the type of relationship\n498:      * @param fromElement is an existing model element\n499:      * @param toElement is another existing model element\n500:      * @throws IllegalModelElementConnectionException \n501:      */\n502:     public Object buildConnection(Object connectionType, \n503: \t\t\t\t  Object fromElement, Object toElement)\n504:         throws IllegalModelElementConnectionException {\n505: \n506:         return buildConnection(connectionType,\n507: \t\t\t       fromElement, null, toElement, null, null);\n508: \n509:     }\n510:     \n511:     /**\n512:      * @param connectionType\n513:      * @param fromElement\n514:      * @param fromStyle\n515:      * @param toElement\n516:      * @param toStyle\n517:      * @param unidirectional\n518:      * @return\n519:      * @throws IllegalModelElementConnectionException\n520:      */\n521:     public Object buildConnection(Object connectionType,\n522:                   Object fromElement, Object fromStyle,\n523:                   Object toElement, Object toStyle,\n524:                   Object unidirectional)\n525:         throws IllegalModelElementConnectionException\n526:     {\n527: \n528:         if (!isConnectionValid(connectionType, fromElement, toElement)) {\n529:             throw new IllegalModelElementConnectionException(\n530:                 \"Cannot make a \"\n531:             + connectionType.getClass().getName() \n532:             + \" between a \" + fromElement.getClass().getName() \n533:             + \" and a \" + toElement.getClass().getName());\n534:         }\n535:         \n536:         Object connection = null;\n537:         \n538:         if (connectionType == ModelFacade.ASSOCIATION) {\n539:             connection = getCore().buildAssociation((MClassifier) fromElement, \n540:                        (MAggregationKind) fromStyle, \n541:                        (MClassifier) toElement, \n542:                        (MAggregationKind) toStyle, \n543:                        (Boolean) unidirectional);\n544:         } else if (connectionType == ModelFacade.ASSOCIATION_ROLE) {\n545:             connection = getCollaborations()\n546:                 .buildAssociationRole((MClassifierRole) fromElement, \n547:                       (MAggregationKind) fromStyle, \n548:                       (MClassifierRole) toElement,\n549:                       (MAggregationKind) toStyle, \n550:                       (Boolean) unidirectional);\n551:         } else if (connectionType == ModelFacade.GENERALIZATION) {\n552:             connection = getCore()\n553:                 .buildGeneralization(fromElement, toElement);\n554:         } else if (connectionType == ModelFacade.PERMISSION) {\n555:             connection = getCore().buildPermission(fromElement, toElement);\n556:         } else if (connectionType == ModelFacade.USAGE) {\n557:             connection = getCore().buildUsage((MModelElement) fromElement,\n558:                      (MModelElement) toElement);\n559:         } else if (connectionType == ModelFacade.GENERALIZATION) {\n560:             connection = getCore()\n561:                 .buildGeneralization(fromElement, toElement);\n562:         } else if (connectionType == ModelFacade.DEPENDENCY) {\n563:             connection = getCore().buildDependency(fromElement, toElement);\n564:         } else if (connectionType == ModelFacade.ABSTRACTION) {\n565:             connection = getCore().buildRealization((MModelElement) fromElement,\n566:                 (MModelElement) toElement);\n567:         } else if (connectionType == ModelFacade.LINK) {\n568:             connection = getCommonBehavior().buildLink(fromElement, toElement);\n569:         } else if (connectionType == ModelFacade.EXTEND) {\n570:             // Extend, but only between two use cases. Remember we draw from the\n571:             // extension port to the base port.\n572:             connection = getUseCases().buildExtend(toElement, fromElement);\n573:         } else if (connectionType == ModelFacade.INCLUDE) {\n574:             connection = getUseCases().buildInclude(fromElement, toElement);\n575:         } else if (connectionType == CommentEdge.class) {\n576:             connection = \n577:                 getCore().buildCommentConnection(fromElement, toElement);\n578:         }\n579:     \n580:         if (connection == null) {\n581:             throw new IllegalModelElementConnectionException(\n582:             \"Cannot make a \" \n583:             + connectionType.getClass().getName() \n584:             + \" between a \" + fromElement.getClass().getName() \n585:             + \" and a \" + toElement.getClass().getName());\n586:         }\n587:         \n588:         return connection;\n589:     }\n590:     \n591:     /**\n592:      * Checks if some type of connection is valid between two elements\n593:      * @param connectionType\n594:      * @param fromElement\n595:      * @param toElement\n596:      * @return\n597:      */\n598:     public boolean isConnectionValid(Object connectionType,\n599:                      Object fromElement, Object toElement)\n600:     {\n601:         // Get the list of valid model item pairs for the given connection type\n602:         ArrayList validItems =\n603:             (ArrayList) validConnectionMap.get(connectionType);\n604:         if (validItems == null) {\n605:             return false;\n606:         }\n607:         // See if there's a pair in this list that match the given\n608:         // model elements\n609:         Iterator it = validItems.iterator();\n610:         while (it.hasNext()) {\n611:             Class[] modeElementPair = (Class[]) it.next();\n612:             if (modeElementPair[0].isInstance(fromElement)\n613:                 && modeElementPair[1].isInstance(toElement)) \n614:             {\n615:                 return true;\n616:             }\n617:         }\n618:         return false;\n619:     }\n620:     \n621:     /** Returns the package factory for the UML\n622:      *  package Foundation::ExtensionMechanisms.\n623:      *\n624:      *  @return the ExtensionMechanisms factory instance.\n625:      */\n626:     public ExtensionMechanismsFactory getExtensionMechanisms() {\n627:         return ExtensionMechanismsFactory.getFactory();\n628:     }\n629: \n630:     /** Returns the package factory for the UML\n631:      *  package Foundation::DataTypes.\n632:      *\n633:      *  @return the DataTypes factory instance.\n634:      */\n635:     public DataTypesFactory getDataTypes() {\n636:         return DataTypesFactory.getFactory();\n637:     }\n638: \n639:     /** Returns the package factory for the UML\n640:      *  package Foundation::Core.\n641:      *\n642:      *  @return the Core factory instance.\n643:      */\n644:     public CoreFactory getCore() {\n645:         return CoreFactory.getFactory();\n646:     }\n647: \n648:     /** Returns the package factory for the UML\n649:      *  package BehavioralElements::CommonBehavior.\n650:      *\n651:      *  @return the CommonBehavior factory instance.\n652:      */\n653:     public CommonBehaviorFactory getCommonBehavior() {\n654:         return CommonBehaviorFactory.getFactory();\n655:     }\n656: \n657:     /** Returns the package factory for the UML\n658:      *  package BehavioralElements::UseCases.\n659:      *\n660:      *  @return the UseCases factory instance.\n661:      */\n662:     public UseCasesFactory getUseCases() {\n663:         return UseCasesFactory.getFactory();\n664:     }\n665: \n666:     /** Returns the package factory for the UML\n667:      *  package BehavioralElements::StateMachines.\n668:      *\n669:      *  @return the StateMachines factory instance.\n670:      */\n671:     public StateMachinesFactory getStateMachines() {\n672:         return StateMachinesFactory.getFactory();\n673:     }\n674: \n675:     /** Returns the package factory for the UML\n676:      *  package BehavioralElements::Collaborations.\n677:      *\n678:      *  @return the Collaborations factory instance.\n679:      */\n680:     public CollaborationsFactory getCollaborations() {\n681:         return CollaborationsFactory.getFactory();\n682:     }\n683: \n684:     /** Returns the package factory for the UML\n685:      *  package BehavioralElements::ActivityGraphs.\n686:      *\n687:      *  @return the ActivityGraphs factory instance.\n688:      */\n689:     public ActivityGraphsFactory getActivityGraphs() {\n690:         return ActivityGraphsFactory.getFactory();\n691:     }\n692: \n693:     /** Returns the package factory for the UML\n694:      *  package ModelManagement.\n695:      *\n696:      *  @return the ModelManagement factory instance.\n697:      */\n698:     public ModelManagementFactory getModelManagement() {\n699:         return ModelManagementFactory.getFactory();\n700:     }\n701: \n702:     /**\n703:      * Deletes a modelelement. It calls the remove method of the\n704:      * modelelement but also does 'cascading deletes' that are not\n705:      * provided for in the remove method of the modelelement\n706:      * itself. For example: this delete method also removes the binary\n707:      * associations that a class has if the class is deleted. In this\n708:      * way, it is not longer possible that illegal states exist in the\n709:      * model.<p>\n710:      *\n711:      * The actual deletion is delegated to delete methods in the rest of the\n712:      * factories. For example: a method deleteClass exists on CoreHelper.\n713:      * Delete methods as deleteClass should only do those extra actions that are\n714:      * necessary for the deletion of the modelelement itself. I.e. deleteClass\n715:      * should only take care of things specific to MClass.<p>\n716:      *\n717:      * The delete methods in the UML Factories should not be called directly\n718:      * throughout the code! Calls should allways refer to this method and never\n719:      * call the deleteXXX method on XXXFactory directly. The reason that it is\n720:      * possible to call the deleteXXX methods directly is a pure implementation\n721:      * detail.<p>\n722:      *\n723:      * The implementation of this method uses a quite complicate if then else\n724:      * tree. This is done to provide optimal performance and full compliance to\n725:      * the UML 1.3 model. The last remark refers to the fact that the UML 1.3\n726:      * model knows multiple inheritance in several places. This has to be taken\n727:      * into account.<p>\n728:      * \n729:      * Extensions and its children are not taken into account\n730:      * here. They do not require extra cleanup actions. Not in the\n731:      * form of a call to the remove method as is normal for all\n732:      * children of MBase and not in the form of other behaviour we\n733:      * want to implement via this operation.\n734:      * @param elem The element to be deleted\n735:      */\n736:     public void delete(Object elem) {\n737:         if (elem == null)\n738:             throw new IllegalArgumentException(\"Element may not be null \"\n739:                 + \"in delete\");        \n740:         if (elem instanceof MElement) {\n741:             getCore().deleteElement((MElement) elem);\n742:             if (elem instanceof MModelElement) {\n743:                 getCore().deleteModelElement((MModelElement) elem);\n744:                 if (elem instanceof MFeature) {\n745:                     deleteFeature((MFeature) elem);\n746:                 } else if (elem instanceof MNamespace) {\n747:                     deleteNamespace((MNamespace) elem);\n748:                 } \n749:         // no else here to make sure MClassifier with\n750:         // its double inheritance goes ok\n751:                 // no else here too to make sure MAssociationClass goes ok\n752:         \n753:                 if (elem instanceof MGeneralizableElement) {\n754:                     MGeneralizableElement ge = (MGeneralizableElement) elem;\n755:                     getCore().deleteGeneralizableElement(ge);\n756:                     if (elem instanceof MStereotype) {\n757:                         MStereotype s = (MStereotype) elem;\n758:                         getExtensionMechanisms().deleteStereotype(s);\n759:                     }\n760:                 } // no else here to make sure MAssociationClass goes ok\n761:         \n762:                 if (elem instanceof MParameter) {\n763:                     getCore().deleteParameter((MParameter) elem);\n764:                 } else if (elem instanceof MConstraint) {\n765:                     getCore().deleteConstraint((MConstraint) elem);\n766:                 } else if (elem instanceof MRelationship) {\n767:                     deleteRelationship((MRelationship) elem);\n768:                 } else if (elem instanceof MAssociationEnd) {\n769:                     getCore().deleteAssociationEnd((MAssociationEnd) elem);\n770:                     if (elem instanceof MAssociationEndRole) {\n771:                         getCollaborations()\n772:                             .deleteAssociationEndRole(\n773:                                  (MAssociationEndRole) elem);\n774:                     }\n775:                 } else if (elem instanceof MComment) {\n776:                     getCore().deleteComment((MComment) elem);\n777:                 } else if (ModelFacade.isAAction(elem)) {\n778:                     deleteAction(elem);\n779:                 } else if (elem instanceof MAttributeLink) {\n780:                     getCommonBehavior()\n781:                         .deleteAttributeLink((MAttributeLink) elem);\n782:                 } else if (elem instanceof MInstance) {\n783:                     deleteInstance((MInstance) elem);\n784:                 } // no else to handle multiple inheritance of linkobject\n785: \n786:                 if (elem instanceof MLink) {\n787:                     getCommonBehavior().deleteLink((MLink) elem);\n788:                 } else if (elem instanceof MLinkEnd) {\n789:                     getCommonBehavior().deleteLinkEnd((MLinkEnd) elem);\n790:                 } else if (elem instanceof MInteraction) {\n791:                     getCollaborations().deleteInteraction((MInteraction) elem);\n792:                 } else if (elem instanceof MMessage) {\n793:                     getCollaborations().deleteMessage((MMessage) elem);\n794:                 } else if (elem instanceof MExtensionPoint) {\n795:                     getUseCases().deleteExtensionPoint((MExtensionPoint) elem);\n796:                 } else if (elem instanceof MStateVertex) {\n797:                     deleteStateVertex((MStateVertex) elem);\n798:                 }\n799: \n800:                 if (elem instanceof MStateMachine) {\n801:                     getStateMachines().deleteStateMachine((MStateMachine) elem);\n802:                     if (elem instanceof MActivityGraph) {\n803:                         getActivityGraphs()\n804:                             .deleteActivityGraph((MActivityGraph) elem);\n805:                     }\n806:                 } else if (elem instanceof MTransition) {\n807:                     getStateMachines().deleteTransition((MTransition) elem);\n808:                 } else if (elem instanceof MGuard) {\n809:                     getStateMachines().deleteGuard((MGuard) elem);\n810:                 }\n811:         // else if (elem instanceof MEvent) {\n812:         //\n813:         //}\n814:             } else if (elem instanceof MPresentationElement) {\n815:                 getCore().deletePresentationElement(\n816:                     (MPresentationElement) elem);\n817:             }\n818:         } else if (elem instanceof MTemplateParameter) {\n819:             getCore().deleteTemplateParameter((MTemplateParameter) elem);\n820:         } else if (elem instanceof MTaggedValue) {\n821:             getExtensionMechanisms().deleteTaggedValue((MTaggedValue) elem);\n822:         }\n823: \n824:         if (elem instanceof MPartition) {\n825:             getActivityGraphs().deletePartition((MPartition) elem);\n826:         } else if (elem instanceof MElementImport) {\n827:             getModelManagement().deleteElementImport((MElementImport) elem);\n828:         }\n829: \n830:         if (elem instanceof MBase) {\n831:             ((MBase) elem).remove();\n832:             UmlModelEventPump.getPump().cleanUp((MBase) elem);\n833:         }        \n834:     }\n835: \n836:     /**\n837:      * Factored this method out of delete to simplify the design of the delete\n838:      * operation\n839:      * @param elem\n840:      */\n841:     private void deleteFeature(MFeature elem) {\n842:         getCore().deleteFeature(elem);\n843:         if (elem instanceof MBehavioralFeature) {\n844:             getCore().deleteBehavioralFeature((MBehavioralFeature) elem);\n845:             if (elem instanceof MOperation) {\n846:                 getCore().deleteOperation((MOperation) elem);\n847:             } else if (elem instanceof MMethod) {\n848:                 getCore().deleteMethod((MMethod) elem);\n849:             } else if (elem instanceof MReception) {\n850:                 getCommonBehavior().deleteReception((MReception) elem);\n851:             }\n852:         } else if (elem instanceof MStructuralFeature) {\n853:             getCore().deleteStructuralFeature((MStructuralFeature) elem);\n854:             if (elem instanceof MAttribute) {\n855:                 getCore().deleteAttribute((MAttribute) elem);\n856:             }\n857:         }\n858:     }\n859: \n860:     /**\n861:      * Factored this method out of delete to simplify the design of the delete\n862:      * operation\n863:      * @param elem\n864:      */\n865:     private void deleteNamespace(MNamespace elem) {\n866:         getCore().deleteNamespace(elem);\n867:         if (elem instanceof MClassifier) {\n868:             getCore().deleteClassifier(elem);\n869:             if (elem instanceof MClass) {\n870:                 getCore().deleteClass((MClass) elem);\n871:                 if (elem instanceof MAssociationClass) {\n872:                     getCore().deleteAssociationClass((MAssociationClass) elem);\n873:                 }\n874:             } else if (elem instanceof MInterface) {\n875:                 getCore().deleteInterface((MInterface) elem);\n876:             } else if (elem instanceof MDataType) {\n877:                 getCore().deleteDataType((MDataType) elem);\n878:             } else if (elem instanceof MNode) {\n879:                 getCore().deleteNode((MNode) elem);\n880:             } else if (elem instanceof MComponent) {\n881:                 getCore().deleteComponent((MComponent) elem);\n882:             } else if (elem instanceof MSignal) {\n883:                 getCommonBehavior().deleteSignal((MSignal) elem);\n884:                 if (elem instanceof MException) {\n885:                     getCommonBehavior().deleteException((MException) elem);\n886:                 }\n887:             } else if (elem instanceof MClassifierRole) {\n888:                 getCollaborations().deleteClassifierRole(\n889:                     (MClassifierRole) elem);\n890:             } else if (elem instanceof MUseCase) {\n891:                 getUseCases().deleteUseCase((MUseCase) elem);\n892:             } else if (elem instanceof MActor) {\n893:                 getUseCases().deleteActor((MActor) elem);\n894:             } else if (elem instanceof MClassifierInState) {\n895:                 getActivityGraphs().deleteClassifierInState(\n896:                     (MClassifierInState) elem);\n897:             }\n898:         } else if (elem instanceof MCollaboration) {\n899:             getCollaborations().deleteCollaboration((MCollaboration) elem);\n900:         } else if (elem instanceof MPackage) {\n901:             getModelManagement().deletePackage((MPackage) elem);\n902:             if (elem instanceof MModel) {\n903:                 getModelManagement().deleteModel((MModel) elem);\n904:             } else if (elem instanceof MSubsystem) {\n905:                 getModelManagement().deleteSubsystem((MSubsystem) elem);\n906:             }\n907:         }\n908:     }\n909: \n910:     /**\n911:      * Factored this method out of delete to simplify the design of the delete\n912:      * operation\n913:      * @param elem\n914:      */\n915:     private void deleteRelationship(MRelationship elem) {\n916:         getCore().deleteRelationship(elem);\n917:         if (elem instanceof MFlow) {\n918:             getCore().deleteFlow((MFlow) elem);\n919:         } else if (elem instanceof MGeneralization) {\n920:             getCore().deleteGeneralization((MGeneralization) elem);\n921:         } else if (elem instanceof MAssociation) {\n922:             getCore().deleteAssociation((MAssociation) elem);\n923:             if (elem instanceof MAssociationRole) {\n924:                 getCollaborations().deleteAssociationRole(\n925:                     (MAssociationRole) elem);\n926:             }\n927:         } else if (elem instanceof MDependency) {\n928:             getCore().deleteDependency((MDependency) elem);\n929:             if (ModelFacade.isAAbstraction(elem)) {\n930:                 getCore().deleteAbstraction(elem);\n931:             } else if (elem instanceof MBinding) {\n932:                 getCore().deleteBinding((MBinding) elem);\n933:             } else if (elem instanceof MUsage) {\n934:                 getCore().deleteUsage((MUsage) elem);\n935:             } else if (elem instanceof MPermission) {\n936:                 getCore().deletePermission((MPermission) elem);\n937:             }\n938:         } else if (elem instanceof MInclude) {\n939:             getUseCases().deleteInclude((MInclude) elem);\n940:         } else if (elem instanceof MExtend) {\n941:             getUseCases().deleteExtend((MExtend) elem);\n942:         }\n943:     }\n944: \n945:     /**\n946:      * Factored this method out of delete to simplify the design of the delete\n947:      * operation\n948:      * @param elem\n949:      */\n950:     private void deleteAction(Object elem) {\n951:         getCommonBehavior().deleteAction(elem);\n952:         if (ModelFacade.isAActionSequence(elem)) {\n953:             getCommonBehavior().deleteActionSequence(elem);\n954:         } else if (elem instanceof MCreateAction) {\n955:             getCommonBehavior().deleteCreateAction((MCreateAction) elem);\n956:         } else if (elem instanceof MCallAction) {\n957:             getCommonBehavior().deleteCallAction((MCallAction) elem);\n958:         } else if (elem instanceof MReturnAction) {\n959:             getCommonBehavior().deleteReturnAction((MReturnAction) elem);\n960:         } else if (elem instanceof MSendAction) {\n961:             getCommonBehavior().deleteSendAction((MSendAction) elem);\n962:         } else if (elem instanceof MTerminateAction) {\n963:             getCommonBehavior().deleteTerminateAction((MTerminateAction) elem);\n964:         } else if (elem instanceof MUninterpretedAction) {\n965:             getCommonBehavior().deleteUninterpretedAction(\n966:                 (MUninterpretedAction) elem);\n967:         } else if (elem instanceof MDestroyAction) {\n968:             getCommonBehavior().deleteDestroyAction((MDestroyAction) elem);\n969:         }\n970:     }\n971: \n972:     /**\n973:      * Factored this method out of delete to simplify the design of the delete\n974:      * operation\n975:      * @param elem\n976:      */\n977:     private void deleteInstance(MInstance elem) {\n978:         getCommonBehavior().deleteInstance(elem);\n979:         if (elem instanceof MDataValue) {\n980:             getCommonBehavior().deleteDataValue((MDataValue) elem);\n981:         } else if (elem instanceof MComponentInstance) {\n982:             getCommonBehavior().deleteComponentInstance(\n983:                 (MComponentInstance) elem);\n984:         } else if (elem instanceof MNodeInstance) {\n985:             getCommonBehavior().deleteNodeInstance((MNodeInstance) elem);\n986:         } else if (elem instanceof MObject) {\n987:             getCommonBehavior().deleteObject((MObject) elem);\n988:             if (elem instanceof MLinkObject) {\n989:                 getCommonBehavior().deleteLinkObject((MLinkObject) elem);\n990:             }\n991:         }\n992:         if (elem instanceof MUseCaseInstance) {\n993:             getUseCases().deleteUseCaseInstance((MUseCaseInstance) elem);\n994:         }\n995:     }\n996: \n997:     /**\n998:      * Factored this method out of delete to simplify the design of the delete\n999:      * operation\n1000:      * @param elem\n1001:      */\n1002:     private void deleteStateVertex(MStateVertex elem) {\n1003:         getStateMachines().deleteStateVertex(elem);\n1004:         if (elem instanceof MPseudostate) {\n1005:             getStateMachines().deletePseudostate((MPseudostate) elem);\n1006:         } else if (elem instanceof MSynchState) {\n1007:             getStateMachines().deleteSynchState((MSynchState) elem);\n1008:         } else if (elem instanceof MStubState) {\n1009:             getStateMachines().deleteStubState((MStubState) elem);\n1010:         } else if (elem instanceof MState) {\n1011:             getStateMachines().deleteState((MState) elem);\n1012:             if (elem instanceof MCompositeState) {\n1013:                 getStateMachines().deleteCompositeState((MCompositeState) elem);\n1014:                 if (elem instanceof MSubmachineState) {\n1015:                     getStateMachines().deleteSubmachineState(\n1016:                         (MSubmachineState) elem);\n1017:                     if (elem instanceof MSubactivityState) {\n1018:                         getActivityGraphs().deleteSubactivityState(\n1019:                             (MSubactivityState) elem);\n1020:                     }\n1021:                 }\n1022:             } else if (elem instanceof MSimpleState) {\n1023:                 getStateMachines().deleteSimpleState((MSimpleState) elem);\n1024:                 if (ModelFacade.isAActionState(elem)) {\n1025:                     getActivityGraphs().deleteActionState(elem);\n1026:                     if (elem instanceof MCallState) {\n1027:                         getActivityGraphs().deleteCallState((MCallState) elem);\n1028:                     }\n1029:                 } else if (elem instanceof MObjectFlowState) {\n1030:                     getActivityGraphs().deleteObjectFlowState(\n1031:                         (MObjectFlowState) elem);\n1032:                 }\n1033:             } else if (elem instanceof MFinalState) {\n1034:                 getStateMachines().deleteFinalState((MFinalState) elem);\n1035:             }\n1036:         }\n1037:     }\n1038: \n1039:     class ObjectCreateInfo {\n1040:     \n1041:         private Object factory;\n1042: \n1043:         private String createMethod;\n1044: \n1045:         private Class javaClass;\n1046: \n1047: //        ObjectCreateInfo (Class javaClass, Object fact, String meth) {\n1048: //            this(javaClass, fact, meth, fact, meth);\n1049: //        }\n1050:         \n1051:         ObjectCreateInfo (Class cls, Object fact, String meth) {\n1052:             javaClass = cls;\n1053:             factory = fact;\n1054:             createMethod = meth;\n1055:         }\n1056:         /**\n1057:          * @return\n1058:          */\n1059:         public Class getJavaClass() {\n1060:             return javaClass;\n1061:         }\n1062: \n1063:         /**\n1064:          * @return\n1065:          */\n1066:         public String getCreateMethod() {\n1067:             return createMethod;\n1068:         }\n1069: \n1070:         /**\n1071:          * @return\n1072:          */\n1073:         public Object getFactory() {\n1074:             return factory;\n1075:         }\n1076: \n1077:     }\n1078: \n1079:     /** Create an empty but initialized instance of a UML ActionExpression.\n1080:      *  \n1081:      *  @return an initialized UML ActionExpression instance.\n1082:      */\n1083:     public MActionExpression createActionExpression() {\n1084:         MActionExpression expression = new MActionExpression(\"\", \"\");\n1085:         DataTypesFactory.getFactory().initialize(expression);\n1086:         return expression;\n1087:     }\n1088: \n1089:     /** Create a UML object from the implementation name.\n1090:      * \n1091:      * This will allow abstraction of the create mechanism at a single point.\n1092:      * \n1093:      * @param entity name to create - must be implemented in \n1094:      * {@link org.argouml.model.uml.Uml}.\n1095:      * \n1096:      * @return the