                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/persistence/UmlFilePersister.java: \n1: // $Id$\n2: // Copyright (c) 1996-2006 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: package org.argouml.persistence;\n25: \n26: import java.io.BufferedInputStream;\n27: import java.io.BufferedReader;\n28: import java.io.BufferedWriter;\n29: import java.io.File;\n30: import java.io.FileNotFoundException;\n31: import java.io.FileOutputStream;\n32: import java.io.IOException;\n33: import java.io.InputStreamReader;\n34: import java.io.OutputStream;\n35: import java.io.OutputStreamWriter;\n36: import java.io.PrintWriter;\n37: import java.io.UnsupportedEncodingException;\n38: import java.io.Writer;\n39: import java.net.URL;\n40: import java.util.Hashtable;\n41: import java.util.List;\n42: \n43: import javax.xml.transform.Result;\n44: import javax.xml.transform.Transformer;\n45: import javax.xml.transform.TransformerException;\n46: import javax.xml.transform.TransformerFactory;\n47: import javax.xml.transform.stream.StreamResult;\n48: import javax.xml.transform.stream.StreamSource;\n49: \n50: import org.apache.log4j.Logger;\n51: import org.argouml.application.ArgoVersion;\n52: import org.argouml.i18n.Translator;\n53: import org.argouml.kernel.Project;\n54: import org.argouml.kernel.ProjectMember;\n55: import org.argouml.uml.ProjectMemberModel;\n56: import org.argouml.uml.cognitive.ProjectMemberTodoList;\n57: import org.argouml.uml.diagram.ProjectMemberDiagram;\n58: import org.argouml.util.ThreadUtils;\n59: import org.tigris.gef.ocl.ExpansionException;\n60: import org.tigris.gef.ocl.OCLExpander;\n61: import org.tigris.gef.ocl.TemplateReader;\n62: \n63: /**\n64:  * To persist to and from argo (xml file) storage.\n65:  *\n66:  * @author Bob Tarling\n67:  */\n68: public class UmlFilePersister extends AbstractFilePersister {\n69: \n70:     /**\n71:      * The PERSISTENCE_VERSION is increased every time the persistence format\n72:      * changes.\n73:      * This controls conversion of old persistence version files to be\n74:      * converted to the current one, keeping ArgoUML backwards compatible.\n75:      */\n76:     protected static final int PERSISTENCE_VERSION = 5;\n77:     \n78:     /**\n79:      * The TOTAL_PHASES_LOAD constant is the number of phases used by the load\n80:      * process.\n81:      */\n82:     protected static final int UML_PHASES_LOAD = 2;\n83:     \n84:     /**\n85:      * Logger.\n86:      */\n87:     private static final Logger LOG =\n88:         Logger.getLogger(UmlFilePersister.class);\n89: \n90:     private static final String ARGO_TEE =\n91: \t\"/org/argouml/persistence/argo2.tee\";\n92: \n93:     /**\n94:      * The constructor.\n95:      */\n96:     public UmlFilePersister() {\n97:     }\n98: \n99:     /**\n100:      * @see org.argouml.persistence.AbstractFilePersister#getExtension()\n101:      */\n102:     public String getExtension() {\n103:         return \"uml\";\n104:     }\n105: \n106:     /**\n107:      * @see org.argouml.persistence.AbstractFilePersister#getDesc()\n108:      */\n109:     protected String getDesc() {\n110:         return Translator.localize(\"combobox.filefilter.uml\");\n111:     }\n112: \n113:     /**\n114:      * It is being considered to save out individual\n115:      * xmi's from individuals diagrams to make\n116:      * it easier to modularize the output of Argo.\n117:      *\n118:      * @param file The file to write.\n119:      * @param project the project to save\n120:      * @throws SaveException when anything goes wrong\n121:      * @throws InterruptedException     if the thread is interrupted\n122:      *\n123:      * @see org.argouml.persistence.ProjectFilePersister#save(\n124:      * org.argouml.kernel.Project, java.io.File)\n125:      */\n126:     public void doSave(Project project, File file)\n127:         throws SaveException, InterruptedException {\n128: \n129:         ProgressMgr progressMgr = new ProgressMgr();\n130:         progressMgr.setNumberOfPhases(4);\n131:         progressMgr.nextPhase();\n132:         \n133:         File lastArchiveFile = new File(file.getAbsolutePath() + \"~\");\n134:         File tempFile = null;\n135: \n136:         try {\n137:             tempFile = createTempFile(file);\n138:         } catch (FileNotFoundException e) {\n139:             throw new SaveException(\n140:                     \"Failed to archive the previous file version\", e);\n141:         } catch (IOException e) {\n142:             throw new SaveException(\n143:                     \"Failed to archive the previous file version\", e);\n144:         }\n145: \n146:         try {\n147:             project.setFile(file);\n148:             project.setVersion(ArgoVersion.getVersion());\n149:             project.setPersistenceVersion(PERSISTENCE_VERSION);\n150: \n151:             FileOutputStream stream =\n152:                 new FileOutputStream(file);\n153: \n154:             writeProject(project, stream, progressMgr);\n155: \n156:             stream.close();\n157: \n158:             progressMgr.nextPhase();\n159: \n160:             String path = file.getParent();\n161:             if (LOG.isInfoEnabled()) {\n162:                 LOG.info(\"Dir ==\" + path);\n163:             }\n164: \n165:             // if save did not raise an exception\n166:             // and name+\"#\" exists move name+\"#\" to name+\"~\"\n167:             // this is the correct backup file\n168:             if (lastArchiveFile.exists()) {\n169:                 lastArchiveFile.delete();\n170:             }\n171:             if (tempFile.exists() && !lastArchiveFile.exists()) {\n172:                 tempFile.renameTo(lastArchiveFile);\n173:             }\n174:             if (tempFile.exists()) {\n175:                 tempFile.delete();\n176:             }\n177:             \n178:             progressMgr.nextPhase();\n179:             \n180:         } catch (Exception e) {\n181:             LOG.error(\"Exception occured during save attempt\", e);\n182: \n183:             // frank: in case of exception\n184:             // delete name and mv name+\"#\" back to name if name+\"#\" exists\n185:             // this is the \"rollback\" to old file\n186:             file.delete();\n187:             tempFile.renameTo(file);\n188:             if (e instanceof InterruptedException) {\n189:                 throw (InterruptedException) e;\n190:             } else {\n191:                 // we have to give a message to user and set the system \n192:                 // to unsaved!\n193:                 throw new SaveException(e);\n194:             }\n195:         }\n196:     }\n197: \n198:     /**\n199:      * Write the output for a project on the given stream.\n200:      *\n201:      * @param project The project to output.\n202:      * @param stream The stream to write to.\n203:      * @throws SaveException If something goes wrong.\n204:      * @throws InterruptedException     if the thread is interrupted\n205:      */\n206:     void writeProject(Project project, \n207:             OutputStream stream, \n208:             ProgressMgr progressMgr) throws SaveException, \n209:             InterruptedException {\n210:         OutputStreamWriter outputStreamWriter;\n211:         try {\n212:             outputStreamWriter = new OutputStreamWriter(stream, \"UTF-8\");\n213:         } catch (UnsupportedEncodingException e) {\n214:             throw new SaveException(e);\n215:         }\n216:         PrintWriter writer =\n217:             new PrintWriter(new BufferedWriter(outputStreamWriter));\n218: \n219:         try {\n220:             Integer indent = new Integer(4);\n221: \n222:             writer.println(\"<?xml version = \\\"1.0\\\" \"\n223:                     + \"encoding = \\\"\" + getEncoding() + \"\\\" ?>\");\n224:             writer.println(\"<uml version=\\\"\" + PERSISTENCE_VERSION + \"\\\">\");\n225:             // Write out header section\n226:             try {\n227:                 Hashtable templates =\n228:                     TemplateReader.getInstance().read(ARGO_TEE);\n229:                 OCLExpander expander = new OCLExpander(templates);\n230:                 expander.expand(writer, project, \"  \");\n231:             } catch (ExpansionException e) {\n232:                 throw new SaveException(e);\n233:             }\n234: \n235:             // Write out XMI section first\n236:             int size = project.getMembers().size();\n237:             for (int i = 0; i < size; i++) {\n238:                 ProjectMember projectMember =\n239:                     (ProjectMember) project.getMembers().get(i);\n240:                 if (projectMember.getType().equalsIgnoreCase(\"xmi\")) {\n241:                     if (LOG.isInfoEnabled()) {\n242:                         LOG.info(\"Saving member of type: \"\n243:                               + ((ProjectMember) project.getMembers()\n244:                                     .get(i)).getType());\n245:                     }\n246:                     MemberFilePersister persister\n247:                         = getMemberFilePersister(projectMember);\n248:                     persister.save(projectMember, writer, indent);\n249:                 }\n250:             }\n251: \n252:             writer.println(\"</uml>\");\n253: \n254:             writer.flush();\n255:         } finally {\n256:             writer.close();\n257:         }\n258:     }\n259: \n260:     /**\n261:      * @see org.argouml.persistence.ProjectFilePersister#doLoad(java.io.File)\n262:      */\n263:     public Project doLoad(File file) throws OpenException, \n264:     InterruptedException {\n265:         // let's initialize the progressMgr\n266:         ProgressMgr progressMgr = new ProgressMgr();\n267:         progressMgr.setNumberOfPhases(UML_PHASES_LOAD);\n268:         \n269:         ThreadUtils.checkIfInterrupted();\n270:         return doLoad(file, file, progressMgr);\n271:     }\n272: \n273:     /**\n274:      * @see org.argouml.persistence.ProjectFilePersister#doLoad(java.io.File)\n275:      */\n276:     public Project doLoad(File originalFile, File file, ProgressMgr progressMgr)\n277:         throws OpenException, InterruptedException {\n278: \n279:         XmlInputStream inputStream = null;\n280:         try {\n281:             Project p = new Project(file.toURL());\n282:             \n283:             // Run through any stylesheet upgrades\n284:             int fileVersion = getPersistenceVersionFromFile(file);\n285: \n286:             // If we're trying to load a file from a future version\n287:             // complain and refuse.\n288:             if (fileVersion > PERSISTENCE_VERSION) {\n289:                 String release = getReleaseVersionFromFile(file);\n290:                 throw new VersionException(\n291:                     \"The file selected is from a more up to date version of \"\n292:                     + \"ArgoUML. It has been saved with ArgoUML version \"\n293:                     + release\n294:                     + \". Please load with that or a more up to date\"\n295:                     + \"release of ArgoUML\");\n296:             }\n297: \n298:             // If we're about to upgrade the file lets take an archive\n299:             // of it first.\n300:             if (fileVersion < PERSISTENCE_VERSION) {\n301:                 String release = getReleaseVersionFromFile(file);\n302:                 copyFile(\n303:                     originalFile,\n304:                     new File(originalFile.getAbsolutePath() + '~' + release));\n305:             }\n306:            \n307:             LOG.info(\"Loading uml file of version \" + fileVersion);\n308:             while (fileVersion < PERSISTENCE_VERSION) {\n309:                 ++fileVersion;\n310:                 LOG.info(\"Upgrading to version \" + fileVersion);\n311:                 long startTime = System.currentTimeMillis();\n312:                 file = transform(file, fileVersion);\n313:                 long endTime = System.currentTimeMillis();\n314:                 LOG.info(\"Upgrading took \"\n315:                         + ((endTime - startTime) / 1000)\n316:                         + \" seconds\");\n317:             }\n318:             progressMgr.nextPhase();\n319: \n320:             inputStream = new XmlInputStream(\n321:                         file.toURL().openStream(),\n322:                         \"argo\",\n323:                         file.length(),\n324:                         100000);\n325: \n326:             ArgoParser parser = new ArgoParser();\n327:             parser.readProject(p, inputStream);\n328:             \n329:             List memberList = parser.getMemberList();\n330: \n331:             LOG.info(memberList.size() + \" members\");\n332: \n333:             for (int i = 0; i < memberList.size(); ++i) {\n334:                 MemberFilePersister persister\n335:                     = getMemberFilePersister((String) memberList.get(i));\n336:                 LOG.info(\"Loading member with \"\n337:                         + persister.getClass().getName());\n338:                 inputStream.reopen(persister.getMainTag());\n339:                 persister.load(p, inputStream);\n340:             }\n341:             \n342:             // let's update the progress\n343:             progressMgr.nextPhase();\n344:             ThreadUtils.checkIfInterrupted();\n345:             inputStream.realClose();\n346:             p.postLoad();\n347:             return p;\n348:         } catch (InterruptedException e) {\n349:             throw e;\n350:         } catch (OpenException e) {\n351:             throw e;\n352:         } catch (Exception e) {\n353:             throw new OpenException(e);\n354:         }\n355:     }\n356: \n357: \n358:     \n359:     /**\n360:      * Transform a string of XML data according to the service required.\n361:      *\n362:      * @param file The XML file to be transformed\n363:      * @param version the version of the persistence format\n364:      *                the XML is to be transformed to.\n365:      * @return the transformed XML file\n366:      * @throws OpenException on XSLT transformation error or file read\n367:      */\n368:     public final File transform(File file, int version)\n369:         throws OpenException {\n370: \n371:         try {\n372:             String upgradeFilesPath = \"/org/argouml/persistence/upgrades/\";\n373:             String upgradeFile = \"upgrade\" + version + \".xsl\";\n374: \n375:             String xsltFileName = upgradeFilesPath + upgradeFile;\n376:             URL xsltUrl = UmlFilePersister.class.getResource(xsltFileName);\n377:             LOG.info(\"Resource is \" + xsltUrl);\n378: \n379:             // Read xsltStream into a temporary file\n380:             // Get url for temp file.\n381:             // openStream from url and wrap in StreamSource\n382:             StreamSource xsltStreamSource =\n383:                 new StreamSource(xsltUrl.openStream());\n384:             xsltStreamSource.setSystemId(xsltUrl.toExternalForm());\n385: \n386:             TransformerFactory factory = TransformerFactory.newInstance();\n387:             Transformer transformer = factory.newTransformer(xsltStreamSource);\n388: \n389:             File transformedFile =\n390:                 File.createTempFile(\"upgrade_\" + version + \"_\", \".uml\");\n391:             transformedFile.deleteOnExit();\n392: \n393:             String encoding = \"UTF-8\";\n394:             FileOutputStream stream =\n395:                 new FileOutputStream(transformedFile);\n396:             Writer writer =\n397:                 new BufferedWriter(new OutputStreamWriter(stream, encoding));\n398:             Result result = new StreamResult(writer);\n399: \n400:             StreamSource inputStreamSource = new StreamSource(file);\n401:             inputStreamSource.setSystemId(file);\n402:             transformer.transform(inputStreamSource, result);\n403: \n404:             writer.close();\n405:             return transformedFile;\n406:         } catch (IOException e) {\n407:             throw new OpenException(e);\n408:         } catch (TransformerException e) {\n409:             throw new OpenException(e);\n410:         }\n411:     }\n412: \n413:     /**\n414:      * Reads an XML file of uml format and extracts the\n415:      * persistence version number from the root tag.\n416:      *\n417:      * @param file the XML file\n418:      * @return The version number\n419:      * @throws OpenException on any error\n420:      */\n421:     private int getPersistenceVersionFromFile(File file) throws OpenException {\n422:         BufferedInputStream inputStream = null;\n423:         BufferedReader reader = null;\n424:         try {\n425:             inputStream = new BufferedInputStream(file.toURL().openStream());\n426:             reader = new BufferedReader(new InputStreamReader(inputStream));\n427:             String rootLine = reader.readLine();\n428:             while (!rootLine.startsWith(\"<uml \")) {\n429:                 rootLine = reader.readLine();\n430:                 if (rootLine == null) {\n431:                     throw new OpenException(\n432:                             \"Failed to find the root <uml> tag\");\n433:                 }\n434:             }\n435:             return Integer.parseInt(getVersion(rootLine));\n436:         } catch (IOException e) {\n437:             throw new OpenException(e);\n438:         } catch (NumberFormatException e) {\n439:             throw new OpenException(e);\n440:         } finally {\n441:             try {\n442:                 if (inputStream != null) {\n443:                     inputStream.close();\n444:                 }\n445:                 if (reader != null) {\n446:                     reader.close();\n447:                 }\n448:             } catch (IOException e) {\n449:                 // No more we can do here on failure\n450:             }\n451:         }\n452:     }\n453: \n454: \n455:     /**\n456:      * Reads an XML file of uml format and extracts the\n457:      * persistence version number from the root tag.\n458:      *\n459:      * @param file the XML file\n460:      * @return The ArgoUML release number\n461:      * @throws OpenException on any error\n462:      */\n463:     private String getReleaseVersionFromFile(File file) throws OpenException {\n464:         BufferedInputStream inputStream = null;\n465:         BufferedReader reader = null;\n466:         try {\n467:             inputStream = new BufferedInputStream(file.toURL().openStream());\n468:             reader = new BufferedReader(new InputStreamReader(inputStream));\n469:             String versionLine = reader.readLine();\n470:             while (!versionLine.trim().startsWith(\"<version>\")) {\n471:                 versionLine = reader.readLine();\n472:                 if (versionLine == null) {\n473:                     throw new OpenException(\n474:                             \"Failed to find the release <version> tag\");\n475:                 }\n476:             }\n477:             versionLine = versionLine.trim();\n478:             int end = versionLine.lastIndexOf(\"</version>\");\n479:             return versionLine.trim().substring(9, end);\n480:         } catch (IOException e) {\n481:             throw new OpenException(e);\n482:         } catch (NumberFormatException e) {\n483:             throw new OpenException(e);\n484:         } finally {\n485:             try {\n486:                 if (inputStream != null) {\n487:                     inputStream.close();\n488:                 }\n489:                 if (reader != null) {\n490:                     reader.close();\n491:                 }\n492:             } catch (IOException e) {\n493:                 // No more we can do here on failure\n494:             }\n495:         }\n496:     }\n497: \n498:     /**\n499:      * Get the version attribute value from a string of XML.\n500:      * @param rootLine the line\n501:      * @return the version\n502:      */\n503:     protected String getVersion(String rootLine) {\n504:         String version;\n505:         int versionPos = rootLine.indexOf(\"version=\\\"\");\n506:         if (versionPos > 0) {\n507:             int startPos = versionPos + 9;\n508:             int endPos = rootLine.indexOf(\"\\\"\", startPos);\n509:             version = rootLine.substring(startPos, endPos);\n510:         } else {\n511:             version = \"1\";\n512:         }\n513:         return version;\n514:     }\n515: \n516:     /**\n517:      * Get a MemberFilePersister based on a given ProjectMember.\n518:      *\n519:      * @param pm the project member\n520:      * @return the persister\n521:      */\n522:     protected MemberFilePersister getMemberFilePersister(ProjectMember pm) {\n523:         MemberFilePersister persister = null;\n524:         if (pm instanceof ProjectMemberDiagram) {\n525:             persister =\n526: \t\tPersistenceManager.getInstance()\n527: \t\t        .getDiagramMemberFilePersister();\n528:         } else if (pm instanceof ProjectMemberTodoList) {\n529:             persister = new TodoListMemberFilePersister();\n530:         } else if (pm instanceof ProjectMemberModel) {\n531:             persister = new ModelMemberFilePersister();\n532:         }\n533:         return persister;\n534:     }\n535: \n536:     /**\n537:      * Get a MemberFilePersister based on a given ProjectMember.\n538:      *\n539:      * @param tag The tag.\n540:      * @return the persister\n541:      */\n542:     private MemberFilePersister getMemberFilePersister(String tag) {\n543:         MemberFilePersister persister = null;\n544:         if (tag.equals(\"pgml\")) {\n545:             persister =\n546: \t\tPersistenceManager.getInstance()\n547:                         .getDiagramMemberFilePersister();\n548:         } else if (tag.equals(\"todo\")) {\n549:             persister = new TodoListMemberFilePersister();\n550:         } else if (tag.equals(\"xmi\")) {\n551:             persister = new ModelMemberFilePersister();\n552:         }\n553:         return persister;\n554:     }\n555: \n556:     /**\n557:      * Returns true. All Argo specific files have an icon.\n558:      * \n559:      * @see org.argouml.persistence.AbstractFilePersister#hasAnIcon()\n560:      */\n561:     public boolean hasAnIcon() {\n562:         return true;\n563:     }\n564: }\n565: ",
