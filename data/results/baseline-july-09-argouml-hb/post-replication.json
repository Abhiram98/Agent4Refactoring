                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/persistence/XmiFilePersister.java: \n1: // $Id$\n2: // Copyright (c) 1996-2004 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: package org.argouml.persistence;\n25: \n26: import java.io.BufferedWriter;\n27: import java.io.File;\n28: import java.io.FileWriter;\n29: import java.io.IOException;\n30: import java.net.URL;\n31: \n32: import org.apache.log4j.Logger;\n33: import org.argouml.kernel.Project;\n34: import org.argouml.kernel.ProjectMember;\n35: import org.argouml.model.uml.UmlHelper;\n36: import org.argouml.uml.cognitive.ProjectMemberTodoList;\n37: \n38: /**\n39:  * To persist to and from XMI file storage.\n40:  * \n41:  * @author Bob Tarling\n42:  */\n43: public class XmiFilePersister extends AbstractFilePersister {\n44:     \n45:     private static final Logger LOG = \n46:         Logger.getLogger(XmiFilePersister.class);\n47:     \n48:     /**\n49:      * The constructor.\n50:      */\n51:     public XmiFilePersister() {\n52:     }\n53: \n54:     /**\n55:      * @see org.argouml.persistence.AbstractFilePersister#getExtension()\n56:      */\n57:     public String getExtension() {\n58:         return \"xmi\";\n59:     }\n60:     \n61:     /**\n62:      * @see org.argouml.persistence.AbstractFilePersister#getDesc()\n63:      */\n64:     protected String getDesc() {\n65:         return \"XML Metadata Interchange\";\n66:     }\n67:     \n68:     /**\n69:      * Save a project to a file in XMI format.\n70:      * \n71:      * @param project the project to save.\n72:      * @param file The file to write.\n73:      * @throws SaveException if anything goes wrong.\n74:      */\n75:     public void doSave(Project project, File file)\n76:         throws SaveException {\n77: \n78:         // frank: first backup the existing file to name+\"#\"\n79:         File tempFile = new File( file.getAbsolutePath() + \"#\");\n80:         File backupFile = new File( file.getAbsolutePath() + \"~\");\n81:         if (tempFile.exists()) {\n82:             tempFile.delete();\n83:         }\n84:         \n85:         BufferedWriter writer = null;\n86:         try {\n87:             if (file.exists()) {\n88:                 copyFile(tempFile, file);\n89:             }\n90:             // frank end\n91:     \n92:             project.setFile(file);\n93:             \n94:             writer =\n95:                 new BufferedWriter(new FileWriter(file));\n96:     \n97:             int size = project.getMembers().size();\n98:             for (int i = 0; i < size; i++) {\n99:                 ProjectMember projectMember = \n100:                     (ProjectMember) project.getMembers().elementAt(i);\n101:                 if (projectMember.getType().equalsIgnoreCase(\"xmi\")) {\n102:                     if (LOG.isInfoEnabled()) {\n103:                         LOG.info(\"Saving member of type: \"\n104:                               + ((ProjectMember) project.getMembers()\n105:                                     .elementAt(i)).getType());\n106:                     }\n107:                     projectMember.save(writer, null);\n108:                 }\n109:             }\n110:             \n111:             // if save did not raise an exception \n112:             // and name+\"#\" exists move name+\"#\" to name+\"~\"\n113:             // this is the correct backup file\n114:             if (backupFile.exists()) {\n115:                 backupFile.delete();\n116:             }\n117:             if (tempFile.exists() && !backupFile.exists()) {\n118:                 tempFile.renameTo(backupFile);\n119:             }\n120:             if (tempFile.exists()) {\n121:                 tempFile.delete();\n122:             }\n123:         } catch (Exception e) {\n124:             LOG.error(\"Exception occured during save attempt\", e);\n125:             try {\n126:                 writer.close();\n127:             } catch (IOException ex) { }\n128:             \n129:             // frank: in case of exception \n130:             // delete name and mv name+\"#\" back to name if name+\"#\" exists\n131:             // this is the \"rollback\" to old file\n132:             file.delete();\n133:             tempFile.renameTo( file);\n134:             // we have to give a message to user and set the system to unsaved!\n135:             throw new SaveException(e);\n136:         }\n137: \n138:         try {\n139:             writer.close();\n140:         } catch (IOException ex) {\n141:             LOG.error(\"Failed to close save output writer\", ex);\n142:         }\n143:     }\n144:     \n145:     \n146:     /**   \n147:      * This method creates a project from the specified URL\n148:      *\n149:      * Unlike the constructor which forces an .argo extension This\n150:      * method will attempt to load a raw XMI file\n151:      * \n152:      * This method can fail in several different ways. Either by\n153:      * throwing an exception or by having the\n154:      * ArgoParser.SINGLETON.getLastLoadStatus() set to not true.\n155:      * \n156:      * @param url The URL to load the project from.\n157:      * @return The newly loaded project.\n158:      * @throws OpenException if the file can not be opened\n159:      *\n160:      * @see org.argouml.persistence.ProjectFilePersister#doLoad(java.net.URL)\n161:      */\n162:     public Project loadProject(URL url) throws OpenException {\n163:         try {\n164:             Project p = new Project();\n165:             XMIParser.getSingleton().readModels(p, url);\n166:             Object model = XMIParser.getSingleton().getCurModel();\n167:             UmlHelper.getHelper().addListenersToModel(model);\n168:             p.setUUIDRefs(XMIParser.getSingleton().getUUIDRefs());\n169:             p.addMember(new ProjectMemberTodoList(\"\", p));\n170:             p.addMember(model);\n171:             p.setNeedsSave(false);\n172:             return p;\n173:         } catch (IOException e) {\n174:             throw new OpenException(e);\n175:         }\n176:     }\n177: }\n178: ",
