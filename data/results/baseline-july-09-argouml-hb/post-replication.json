/\n68: public class UMLActivityDiagram extends UMLDiagram {\n69:     \n70:     /**\n71:      * this diagram needs to be deleted when its statemachine is deleted.\n72:      */\n73:     private Object theActivityGraph;\n74: \n75:     private Action actionState;\n76:     private Action actionStartPseudoState;\n77:     private Action actionFinalPseudoState;\n78:     private Action actionJunctionPseudoState;\n79:     private Action actionForkPseudoState;\n80:     private Action actionJoinPseudoState;\n81:     private Action actionTransition;\n82:     private Action actionObjectFlowState;\n83:     private Action actionNewSwimlane;\n84:     private Action actionCallState;\n85:     private Action actionSubactivityState;\n86:     private Action actionCallEvent;\n87:     private Action actionChangeEvent;\n88:     private Action actionSignalEvent;\n89:     private Action actionTimeEvent;\n90:     private Action actionGuard;\n91:     private Action actionCallAction;\n92:     private Action actionCreateAction;\n93:     private Action actionDestroyAction;\n94:     private Action actionReturnAction;\n95:     private Action actionSendAction;\n96:     private Action actionTerminateAction;\n97:     private Action actionUninterpretedAction;\n98:     private Action actionActionSequence;\n99: \n100:     /**\n101:      * Constructor.\n102:      */\n103:     public UMLActivityDiagram() {\n104:         try {\n105:             setName(getNewDiagramName());\n106:         } catch (PropertyVetoException pve) {\n107:             // no action required in case of veto on setName\n108:         }\n109:     }\n110: \n111:     /**\n112:      * Constructor.\n113:      *\n114:      * @param namespace the namespace for the diagram\n115:      * @param agraph the ActivityGraph for the diagram\n116:      */\n117:     public UMLActivityDiagram(Object namespace, Object agraph) {\n118: \n119:         this();\n120: \n121:         if (!Model.getFacade().isANamespace(namespace)\n122:             || !Model.getFacade().isAActivityGraph(agraph)) {\n123:             throw new IllegalArgumentException();\n124:         }\n125: \n126:         if (Model.getFacade().getName(namespace) != null) {\n127:             if (!Model.getFacade().getName(namespace).trim().equals(\"\")) {\n128:                 String name =\n129:                     Model.getFacade().getName(namespace)\n130:                     + \" activity \"\n131:                     + (Model.getFacade().getBehaviors(namespace).size());\n132:                 try {\n133:                     setName(name);\n134:                 } catch (PropertyVetoException pve) {\n135:                     // no action required\n136:                 }\n137:             }\n138:         }\n139:         setup(namespace, agraph);\n140:     }\n141: \n142:     /*\n143:      * @see org.tigris.gef.base.Diagram#initialize(java.lang.Object)\n144:      */\n145:     public void initialize(Object o) {\n146:         if (!(Model.getFacade().isAActivityGraph(o))) {\n147:             return;\n148:         }\n149:         Object context = Model.getFacade().getContext(o);\n150:         if (context != null) {\n151:             if (Model.getFacade().isABehavioralFeature(context)) {\n152:                 setup(Model.getFacade().getNamespace(\n153:                                 Model.getFacade().getOwner(context)), o);\n154:             } else {\n155:                 setup(context, o);\n156:             }\n157:         } else {\n158:             Object namespace = Model.getFacade().getNamespace(o);\n159:             if (namespace != null) {\n160:                 setup(namespace, o);\n161:             } else {\n162:                 throw new IllegalStateException(\"Cannot find context \"\n163:                         + \"nor namespace while initializing activity diagram\");\n164:             }\n165:         }\n166:     }\n167: \n168:     /**\n169:      * Method to perform a number of important initializations of an\n170:      * <em>Activity Diagram</em>.<p>\n171:      *\n172:      * Each diagram type has a similar <em>UMLxxxDiagram</em> class.<p>\n173:      *\n174:      * Changed <em>lay</em> from <em>LayerPerspective</em> to\n175:      * <em>LayerPerspectiveMutable</em>.  This class is a child of\n176:      * <em>LayerPerspective</em> and was implemented to correct some\n177:      * difficulties in changing the model. <em>lay</em> is used mainly\n178:      * in <em>LayerManager</em>(GEF) to control the adding, changing and\n179:      * deleting layers on the diagram...  psager@tigris.org Jan. 24,\n180:      * 2002\n181: \n182:      * @param namespace  Namespace from the model\n183:      * @param agraph ActivityGraph from the model\n184:      */\n185:     public void setup(Object namespace, Object agraph) {\n186:         if (!Model.getFacade().isANamespace(namespace)\n187:             || !Model.getFacade().isAActivityGraph(agraph)) {\n188:             throw new IllegalArgumentException();\n189:         }\n190: \n191:         setNamespace(namespace);\n192: \n193:         theActivityGraph = agraph;\n194:         \n195:         ActivityDiagramGraphModel gm = new ActivityDiagramGraphModel();\n196:         gm.setHomeModel(namespace);\n197:         if (theActivityGraph != null) {\n198:             gm.setMachine(theActivityGraph);\n199:         }\n200:         ActivityDiagramRenderer rend = new ActivityDiagramRenderer();\n201: \n202:         LayerPerspective lay = new LayerPerspectiveMutable(\n203:                 Model.getFacade().getName(namespace), gm);\n204:         lay.setGraphNodeRenderer(rend);\n205:         lay.setGraphEdgeRenderer(rend);\n206:         setLayer(lay);\n207: \n208:         /* Listen to activitygraph deletion, \n209:          * delete this diagram. */\n210:         Model.getPump().addModelEventListener(this, theActivityGraph, \n211:                 new String[] {\"remove\", \"namespace\"});\n212:     }\n213: \n214:     /*\n215:      * @see org.argouml.uml.diagram.ui.UMLDiagram#propertyChange(java.beans.PropertyChangeEvent)\n216:      */\n217:     public void propertyChange(PropertyChangeEvent evt) {\n218:         if ((evt.getSource() == theActivityGraph)\n219:                 && (evt instanceof DeleteInstanceEvent)\n220:                 && \"remove\".equals(evt.getPropertyName())) {\n221:             Model.getPump().removeModelEventListener(this, \n222:                     theActivityGraph, new String[] {\"remove\", \"namespace\"});\n223:             ProjectManager.getManager().getCurrentProject().moveToTrash(this);\n224:         }\n225:         if (evt.getSource() == getStateMachine()) {\n226:             Object newNamespace = \n227:                 Model.getFacade().getNamespace(getStateMachine());\n228:             if (getNamespace() != newNamespace) {\n229:                 /* The namespace of the activitygraph is changed! */\n230:                 setNamespace(newNamespace);\n231:                 ((UMLMutableGraphSupport) getGraphModel())\n232:                                 .setHomeModel(newNamespace);\n233:             }\n234:         }\n235:     }\n236: \n237:     /*\n238:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getOwner()\n239:      */\n240:     public Object getOwner() {\n241:         if (!(getGraphModel() instanceof ActivityDiagramGraphModel)) {\n242:             throw new IllegalStateException(\n243:                     \"Incorrect graph model of \"\n244:                     + getGraphModel().getClass().getName());\n245:         }\n246:         ActivityDiagramGraphModel gm =\n247:             (ActivityDiagramGraphModel) getGraphModel();\n248:         return gm.getMachine();\n249:     }\n250: \n251:     /**\n252:      * @return the statemachine\n253:      */\n254:     public Object getStateMachine() {\n255:         GraphModel gm = getGraphModel();\n256:         if (gm instanceof StateDiagramGraphModel) {\n257:             Object machine = ((StateDiagramGraphModel) gm).getMachine();\n258:             if (!Model.getUmlFactory().isRemoved(machine)) {\n259:                 return machine;\n260:             }\n261:         }\n262:         return null;\n263:     }\n264: \n265:     /**\n266:      * @param sm set the statemachine for this diagram\n267:      */\n268:     public void setStateMachine(Object sm) {\n269: \n270:         if (!Model.getFacade().isAStateMachine(sm)) {\n271:             throw new IllegalArgumentException();\n272:         }\n273: \n274:         ((ActivityDiagramGraphModel) getGraphModel()).setMachine(sm);\n275:     }\n276: \n277:     /**\n278:      * Get the actions from which to create a toolbar or equivalent\n279:      * graphic triggers.\n280:      *\n281:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getUmlActions()\n282:      * @return the array of actions\n283:      */\n284:     protected Object[] getUmlActions() {\n285:         Object[] actions =\n286:         {\n287:             getActionState(),\n288:             getActionTransition(),\n289: \t    null,\n290: \t    getActionStartPseudoState(),\n291: \t    getActionFinalPseudoState(),\n292: \t    getActionJunctionPseudoState(),\n293: \t    getActionForkPseudoState(),\n294: \t    getActionJoinPseudoState(),\n295: //\t    getActionNewSwimlane(), // uncomment this ...\n296: \t    null,\n297: \t    getActionCallState(),\n298:             getActionObjectFlowState(),\n299:             /*getActionSubactivityState()*/\n300:             null,\n301:             getTriggerActions(),\n302:             getActionGuard(),\n303:             getEffectActions(),\n304: \t};\n305:         return actions;\n306:     }\n307: \n308:     protected Object[] getTriggerActions() {\n309:         Object[] actions = {\n310:             getActionCallEvent(),\n311:             getActionChangeEvent(),\n312:             getActionSignalEvent(),\n313:             getActionTimeEvent(),\n314:         };\n315:         ToolBarUtility.manageDefault(actions, \"diagram.activity.trigger\");\n316:         return actions;\n317:     }\n318: \n319:     protected Object[] getEffectActions() {\n320:         Object[] actions = {\n321:             getActionCallAction(),\n322:             getActionCreateAction(),\n323:             getActionDestroyAction(),\n324:             getActionReturnAction(),\n325:             getActionSendAction(),\n326:             getActionTerminateAction(),\n327:             getActionUninterpretedAction(),\n328:             getActionActionSequence(),\n329:         };\n330:         ToolBarUtility.manageDefault(actions, \"diagram.activity.effect\");\n331:         return actions;\n332:     }\n333: \n334:     /**\n335:      * Creates a new diagram name.<p>\n336:      *\n337:      * @return String\n338:      */\n339:     protected String getNewDiagramName() {\n340:         String name = getLabelName() + \" \" + getNextDiagramSerial();\n341:         if (!ProjectManager.getManager().getCurrentProject()\n342:                  .isValidDiagramName(name)) {\n343:             name = getNewDiagramName();\n344:         }\n345:         return name;\n346:     }\n347: \n348:     /*\n349:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getLabelName()\n350:      */\n351:     public String getLabelName() {\n352:         return Translator.localize(\"label.activity-diagram\");\n353:     }\n354: \n355:     /**\n356:      * @return Returns the actionCallState.\n357:      */\n358:     protected Action getActionCallState() {\n359:         if (actionCallState == null) {\n360:             actionCallState =\n361:                 new RadioAction(\n362:                         new CmdCreateNode(\n363:                                 Model.getMetaTypes().getCallState(),\n364:                                 \"button.new-callstate\"));\n365:         }\n366:         return actionCallState;\n367:     }\n368:     /**\n369:      * @return Returns the actionFinalPseudoState.\n370:      */\n371:     protected Action getActionFinalPseudoState() {\n372:         if (actionFinalPseudoState == null) {\n373:             actionFinalPseudoState =\n374:                 new RadioAction(\n375:                         new CmdCreateNode(\n376:                                 Model.getMetaTypes().getFinalState(),\n377:                         \t\"button.new-finalstate\"));\n378:         }\n379:         return actionFinalPseudoState;\n380:     }\n381:     /**\n382:      * @return Returns the actionForkPseudoState.\n383:      */\n384:     protected Action getActionForkPseudoState() {\n385:         if (actionForkPseudoState == null) {\n386:             actionForkPseudoState =\n387:                 new RadioAction(\n388:                         new ActionCreatePseudostate(\n389:                                 Model.getPseudostateKind().getFork(),\n390:                         \t\"button.new-fork\"));\n391:         }\n392:         return actionForkPseudoState;\n393:     }\n394:     /**\n395:      * @return Returns the actionJoinPseudoState.\n396:      */\n397:     protected Action getActionJoinPseudoState() {\n398:         if (actionJoinPseudoState == null) {\n399:             actionJoinPseudoState =\n400:                 new RadioAction(\n401:                         new ActionCreatePseudostate(\n402:                                 Model.getPseudostateKind().getJoin(),\n403:                         \t\"button.new-join\"));\n404:         }\n405:         return actionJoinPseudoState;\n406:     }\n407:     /**\n408:      * @return Returns the actionJunctionPseudoState.\n409:      */\n410:     protected Action getActionJunctionPseudoState() {\n411:         if (actionJunctionPseudoState == null) {\n412:             actionJunctionPseudoState =\n413:                 new RadioAction(\n414:                         new ActionCreatePseudostate(\n415:                                 Model.getPseudostateKind().getJunction(),\n416:                                 \"button.new-junction\"));\n417:         }\n418:         return actionJunctionPseudoState;\n419:     }\n420:     /**\n421:      * @return Returns the actionNewSwimlane.\n422:      */\n423:     protected Action getActionNewSwimlane() {\n424:         if (actionNewSwimlane == null) {\n425:             actionNewSwimlane =\n426:                 new CmdCreateNode(Model.getMetaTypes().getPartition(),\n427:                         \t  \"button.new-partition\");\n428:         }\n429:         return actionNewSwimlane;\n430:     }\n431:     /**\n432:      * @return Returns the actionObjectFlowState.\n433:      */\n434:     protected Action getActionObjectFlowState() {\n435:         if (actionObjectFlowState == null) {\n436:             actionObjectFlowState =\n437:                 new RadioAction(\n438:                         new CmdCreateNode(\n439:                                 Model.getMetaTypes().getObjectFlowState(),\n440:                                 \"button.new-objectflowstate\"));\n441:         }\n442:         return actionObjectFlowState;\n443:     }\n444:     /**\n445:      * @return Returns the actionStartPseudoState.\n446:      */\n447:     protected Action getActionStartPseudoState() {\n448:         if (actionStartPseudoState == null) {\n449:             actionStartPseudoState =\n450:                 new RadioAction(\n451:                         new ActionCreatePseudostate(\n452:                                 Model.getPseudostateKind().getInitial(),\n453:                                 \"button.new-initial\"));\n454:         }\n455:         return actionStartPseudoState;\n456:     }\n457:     /**\n458:      * @return Returns the actionState.\n459:      */\n460:     protected Action getActionState() {\n461:         if (actionState == null) {\n462:             actionState =\n463:                 new RadioAction(\n464:                         new CmdCreateNode(\n465:                                 Model.getMetaTypes().getActionState(),\n466:                         \t\"button.new-actionstate\"));\n467:         }\n468:         return actionState;\n469:     }\n470:     /**\n471:      * @return Returns the actionSubactivityState.\n472:      */\n473:     protected Action getActionSubactivityState() {\n474:         if (actionSubactivityState == null) {\n475:             actionSubactivityState =\n476:                 new RadioAction(\n477:                         new CmdCreateNode(\n478:                                 Model.getMetaTypes().getSubactivityState(),\n479:                         \"button.new-subactivitystate\"));\n480:         }\n481:         return actionSubactivityState;\n482:     }\n483:     /**\n484:      * @return Returns the actionTransition.\n485:      */\n486:     protected Action getActionTransition() {\n487:         if (actionTransition == null) {\n488:             actionTransition =\n489:                 new RadioAction(\n490:                         new CmdSetMode(\n491:                                 ModeCreatePolyEdge.class,\n492:                                 \"edgeClass\",\n493:                                 Model.getMetaTypes().getTransition(),\n494:                         \"button.new-transition\"));\n495:         }\n496:         return actionTransition;\n497:     }\n498: \n499:     /**\n500:      * @return Returns the actionCallEvent.\n501:      */\n502:     protected Action getActionCallEvent() {\n503:         if (actionCallEvent == null) {\n504:             actionCallEvent = new ButtonActionNewCallEvent();\n505:         }\n506:         return actionCallEvent;\n507:     }\n508: \n509:     /**\n510:      * @return Returns the actionCallEvent.\n511:      */\n512:     protected Action getActionChangeEvent() {\n513:         if (actionChangeEvent == null) {\n514:             actionChangeEvent = new ButtonActionNewChangeEvent();\n515:         }\n516:         return actionChangeEvent;\n517:     }\n518: \n519:     /**\n520:      * @return Returns the actionCallEvent.\n521:      */\n522:     protected Action getActionSignalEvent() {\n523:         if (actionSignalEvent == null) {\n524:             actionSignalEvent = new ButtonActionNewSignalEvent();\n525:         }\n526:         return actionSignalEvent;\n527:     }\n528: \n529:     /**\n530:      * @return Returns the actionCallEvent.\n531:      */\n532:     protected Action getActionTimeEvent() {\n533:         if (actionTimeEvent == null) {\n534:             actionTimeEvent = new ButtonActionNewTimeEvent();\n535:         }\n536:         return actionTimeEvent;\n537:     }\n538: \n539:     protected Action getActionGuard() {\n540:         if (actionGuard == null) {\n541:             actionGuard = new ButtonActionNewGuard();\n542:         }\n543:         return actionGuard;\n544:     }\n545:     \n546:     protected Action getActionCallAction() {\n547:         if (actionCallAction == null) {\n548:             actionCallAction = ActionNewCallAction.getButtonInstance();\n549:         }\n550:         return actionCallAction;\n551:     }\n552:     \n553:     protected Action getActionCreateAction() {\n554:         if (actionCreateAction == null) {\n555:             actionCreateAction = ActionNewCreateAction.getButtonInstance();\n556:         }\n557:         return actionCreateAction;\n558:     }\n559: \n560:     protected Action getActionDestroyAction() {\n561:         if (actionDestroyAction == null) {\n562:             actionDestroyAction = ActionNewDestroyAction.getButtonInstance();\n563:         }\n564:         return actionDestroyAction;\n565:     }\n566: \n567:     protected Action getActionReturnAction() {\n568:         if (actionReturnAction == null) {\n569:             actionReturnAction = ActionNewReturnAction.getButtonInstance();\n570:         }\n571:         return actionReturnAction;\n572:     }\n573:     \n574:     protected Action getActionSendAction() {\n575:         if (actionSendAction == null) {\n576:             actionSendAction = ActionNewSendAction.getButtonInstance();\n577:         }\n578:         return actionSendAction;\n579:     }\n580:     \n581:     protected Action getActionTerminateAction() {\n582:         if (actionTerminateAction == null) {\n583:             actionTerminateAction = \n584:                 ActionNewTerminateAction.getButtonInstance();\n585:         }\n586:         return actionTerminateAction;\n587:     }\n588: \n589:     protected Action getActionUninterpretedAction() {\n590:         if (actionUninterpretedAction == null) {\n591:             actionUninterpretedAction = \n592:                 ActionNewUninterpretedAction.getButtonInstance();\n593:         }\n594:         return actionUninterpretedAction;\n595:     }\n596: \n597:     protected Action getActionActionSequence() {\n598:         if (actionActionSequence == null) {\n599:             actionActionSequence = \n600:                 ActionNewActionSequence.getButtonInstance();\n601:         }\n602:         return actionActionSequence;\n603:     }\n604: \n605:     /*\n606:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getDependentElement()\n607:      */\n608:     public Object getDependentElement() {\n609:         return getStateMachine(); /* The ActivityGraph. */\n610:     }\n611: \n612:     /*\n613:      * @see org.argouml.uml.diagram.ui.UMLDiagram#isRelocationAllowed(java.lang.Object)\n614:      */\n615:     public boolean isRelocationAllowed(Object base) {\n616:         return false;\n617:         /* TODO: We may return the following when the\n618:          * relocate() has been implemented.\n619:          */\n620: //      Model.getActivityGraphsHelper()\n621: //      .isAddingActivityGraphAllowed(base);\n622:     }\n623: \n624:     /*\n625:      * @see org.argouml.uml.diagram.ui.UMLDiagram#relocate(java.lang.Object)\n626:      */\n627:     public boolean relocate(Object base) {\n628:         return false;\n629:     }\n630: \n631:     /**\n632:      * The UID.\n633:      */\n634:     private static final long serialVersionUID = 6223128918989919230L;\n635: } /* end class UMLActivityDiagram */\n636: ",
