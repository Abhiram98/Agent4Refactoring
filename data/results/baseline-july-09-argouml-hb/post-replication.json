on node or edge */\n80:     public Vector getPorts(Object nodeOrEdge) {\n81: \tVector res = new Vector();  //wasteful!\n82: \tif (ModelFacade.isAClassifierRole(nodeOrEdge)) res.addElement(nodeOrEdge);\n83: \treturn res;\n84:     }\n85: \n86:     /** Return the node or edge that owns the given port */\n87:     public Object getOwner(Object port) {\n88: \treturn port;\n89:     }\n90: \n91:     /** Return all edges going to given port */\n92:     public Vector getInEdges(Object port) {\n93: \tVector res = new Vector(); //wasteful!\n94: \tif (ModelFacade.isAClassifierRole(port)) {\n95: \t    Object cr = /*(MClassifierRole)*/ port;\n96: \t    Collection ends = ModelFacade.getAssociationEnds(cr);\n97: \t    if (ends == null) return res; // empty Vector\n98: \t    Iterator iter = ends.iterator();\n99: \t    while (iter.hasNext()) {\n100: \t\tObject aer = /*(MAssociationEndRole)*/ iter.next();\n101: \t\tres.addElement(ModelFacade.getAssociation(aer));\n102: \t    }\n103: \t}\n104: \treturn res;\n105:     }\n106: \n107:     /** Return all edges going from given port */\n108:     public Vector getOutEdges(Object port) {\n109: \treturn new Vector(); // TODO?\n110:     }\n111: \n112:     /** Return one end of an edge */\n113:     public Object getSourcePort(Object edge) {\n114: \tif (ModelFacade.isARelationship(edge)) {\n115: \t    return CoreHelper.getHelper().getSource(/*(MRelationship)*/ edge);\n116: \t}\n117: \tcat.debug(\"TODO getSourcePort\");\n118: \treturn null;\n119:     }\n120: \n121:     /** Return  the other end of an edge */\n122:     public Object getDestPort(Object edge) {\n123: \tif (ModelFacade.isARelationship(edge)) {\n124: \t    return CoreHelper.getHelper().getDestination(/*(MRelationship)*/ edge);\n125: \t}\n126: \tcat.debug(\"TODO getDestPort\");\n127: \treturn null;\n128:     }\n129: \n130: \n131:     ////////////////////////////////////////////////////////////////\n132:     // MutableGraphModel implementation\n133: \n134:     /** Return true if the given object is a valid node in this graph */\n135:     public boolean canAddNode(Object node) {\n136: \tif (node == null) return false;\n137: \tif (_nodes.contains(node)) return false;\n138: \treturn (ModelFacade.isAClassifierRole(node) || ModelFacade.isAMessage(node));\n139:     }\n140: \n141:     /** Return true if the given object is a valid edge in this graph */\n142:     public boolean canAddEdge(Object edge)  {\n143: \tif (edge == null) return false;\n144: \tif (_edges.contains(edge)) return false;\n145: \tObject end0 = null;\n146:         Object end1 = null;\n147: \tif (ModelFacade.isAAssociationRole(edge)) {\n148: \t    Collection conns = ModelFacade.getConnections(edge);\n149:             Iterator iter = conns.iterator();\n150: \t    if (conns.size() < 2) return false;\n151: \t    Object associationEndRole0 = iter.next();\n152: \t    Object associationEndRole1 = iter.next();\n153: \t    if (associationEndRole0 == null || associationEndRole1 == null) return false;\n154: \t    end0 = ModelFacade.getType(associationEndRole0);\n155: \t    end1 = ModelFacade.getType(associationEndRole1);\n156: \t}\n157: \tif (ModelFacade.isAGeneralization(edge)) {\n158: \t    Object gen = /*(MGeneralization)*/ edge;\n159: \t    end0 = ModelFacade.getParent(gen);\n160: \t    end1 = ModelFacade.getChild(gen);\n161: \t}\n162: \tif (ModelFacade.isADependency(edge)) {\n163: \t    Collection clients = ModelFacade.getClients(edge);\n164: \t    Collection suppliers = ModelFacade.getSuppliers(edge);\n165: \t    if (clients == null || suppliers == null) return false;\n166: \t    end0 = (clients.toArray())[0];\n167: \t    end1 = (suppliers.toArray())[0];\n168: \t}\n169: \tif (edge instanceof CommentEdge) {\n170: \t    end0 = ((CommentEdge)edge).getSource();\n171: \t    end1 = ((CommentEdge)edge).getDestination();\n172: \t}\n173: \tif (end0 == null || end1 == null) return false;\n174: \tif (!_nodes.contains(end0)) return false;\n175: \tif (!_nodes.contains(end1)) return false;\n176: \treturn true;\n177:     }\n178: \n179: \n180:     /** Add the given node to the graph, if valid. */\n181:     public void addNode(Object node) {\n182: \tcat.debug(\"adding MClassifierRole node!!\");\n183: \tif (!canAddNode(node)) return;\n184: \t_nodes.addElement(node);\n185: \t// TODO: assumes public, user pref for default visibility?\n186: \tif (ModelFacade.isAClassifier(node)) {\n187: \t    ModelFacade.addOwnedElement(_collab, /*(MClassifier)*/ node);\n188: \t    // ((MClassifier)node).setNamespace(_collab.getNamespace());\n189: \t}\n190:     \n191: \tfireNodeAdded(node);\n192:     }\n193: \n194:     /** Add the given edge to the graph, if valid. */\n195:     public void addEdge(Object edge) {\n196:         cat.debug(\"adding class edge!!!!!!\");\n197:         if (!canAddEdge(edge)) return;\n198:         _edges.addElement(edge);\n199:         // TODO: assumes public\n200:         if (ModelFacade.isAModelElement(edge)\n201: \t    && ModelFacade.getNamespace(edge) == null) {\n202:             ModelFacade.addOwnedElement(_collab, /*(MModelElement)*/ edge);\n203:         }\n204:         fireEdgeAdded(edge);\n205:     }\n206: \n207:     public void addNodeRelatedEdges(Object node) {\n208: \tif ( ModelFacade.isAClassifier(node) ) {\n209: \t    Collection ends = ModelFacade.getAssociationEnds(node);\n210: \t    Iterator iter = ends.iterator();\n211: \t    while (iter.hasNext()) {\n212: \t\tObject ae = /*(MAssociationEndRole)*/ iter.next();\n213: \t\tif (canAddEdge(ModelFacade.getAssociation(ae)))\n214: \t\t    addEdge(ModelFacade.getAssociation(ae));\n215: \t    }\n216: \t}\n217: \tif ( ModelFacade.isAGeneralizableElement(node) ) {\n218: \t    Collection gn = ModelFacade.getGeneralizations(node);\n219: \t    Iterator iter = gn.iterator();\n220: \t    while (iter.hasNext()) {\n221: \t\tObject g = /*(MGeneralization)*/ iter.next();\n222: \t\tif (canAddEdge(g)) {\n223: \t\t    addEdge(g);\n224: \t\t    return;\n225: \t\t}\n226: \t    }\n227: \t    Collection sp = ModelFacade.getSpecializations(node);\n228: \t    iter = sp.iterator();\n229: \t    while (iter.hasNext()) {\n230: \t\tObject s = /*(MGeneralization)*/ iter.next();\n231: \t\tif (canAddEdge(s)) {\n232: \t\t    addEdge(s);\n233: \t\t    return;\n234: \t\t}\n235: \t    }\n236: \t}\n237: \tif ( ModelFacade.isAModelElement(node) ) {\n238: \t    Vector specs =\n239: \t\tnew Vector(ModelFacade.getClientDependencies(node));\n240: \t    specs.addAll(ModelFacade.getSupplierDependencies(node));\n241: \t    Iterator iter = specs.iterator();\n242: \t    while (iter.hasNext()) {\n243: \t\tObject dep = /*(MDependency)*/ iter.next();\n244: \t\tif (canAddEdge(dep)) {\n245: \t\t    addEdge(dep);\n246: \t\t    return;\n247: \t\t}\n248: \t    }\n249: \t}\n250:     }\n251: \n252: \n253:     /** Return true if the two given ports can be connected by a\n254:      * kind of edge to be determined by the ports. */\n255:     public boolean canConnect(Object fromP, Object toP) {\n256: \tif ((ModelFacade.isAClassifierRole(fromP))\n257: \t    && (ModelFacade.isAClassifierRole(toP)))\n258: \t    return true;\n259: \treturn false;\n260:     }\n261: \n262:     ////////////////////////////////////////////////////////////////\n263:     // VetoableChangeListener implementation\n264: \n265:     public void vetoableChange(PropertyChangeEvent pce) {\n266: \t//throws PropertyVetoException\n267: \n268: \tif (\"ownedElement\".equals(pce.getPropertyName())) {\n269: \t    Vector oldOwned = (Vector) pce.getOldValue();\n270: \t    Object eo = /*(MElementImport)*/ pce.getNewValue();\n271: \t    Object me = ModelFacade.getModelElement(eo);\n272: \t    if (oldOwned.contains(eo)) {\n273: \t\tcat.debug(\"model removed \" + me);\n274: \t\tif (ModelFacade.isAClassifier(me)) removeNode(me);\n275: \t\tif (ModelFacade.isAMessage(me)) removeNode(me);\n276: \t\tif (ModelFacade.isAAssociation(me)) removeEdge(me);\n277: \t    }\n278: \t    else {\n279: \t\tcat.debug(\"model added \" + me);\n280: \t    }\n281: \t}\n282:     }\n283: \n284: } /*