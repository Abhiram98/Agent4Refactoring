ication.helpers.ResourceLoaderWrapper;\n34: import org.argouml.application.modules.ModuleLoader;\n35: \n36: /**\n37:  * The <code>Argo</code> class provides static methods and definitions\n38:  * that can be used as helpers throughout the Argo code.<p>\n39:  *\n40:  * This class is a variation of the <em>Expert</em> design pattern\n41:  * [Grand].  By incorporating a number of unrelated but commonly\n42:  * used methods in a single class, it attempts to decrease the\n43:  * complexity of the overall code while increasing its own complexity.<p>\n44:  *\n45:  * These include\n46:  * <ul>\n47:  * <li>definitions of configuration keys\n48:  * <li>definitions of resource bundle identifier strings\n49:  * <li>methods for localization using <code>gef</code>\n50:  * <li>methods for environment manipulation\n51:  * </ul>\n52:  *\n53:  */\n54: public final class Argo {\n55: \n56:     /**\n57:      * Key for argo resource directory.\n58:      */\n59:     public static final String RESOURCEDIR = \"/org/argouml/resource/\";\n60: \n61:     /**\n62:      * argo.ini path.\n63:      */\n64:     public static final String ARGOINI = \"/org/argouml/argo.ini\";\n65: \n66:     /**\n67:      * Key for default startup directory.\n68:      */\n69:     public static final ConfigurationKey KEY_STARTUP_DIR =\n70: \tConfiguration.makeKey(\"default\", \"user\", \"dir\");\n71: \n72:     /**\n73:      * Key to show splash screen.\n74:      */\n75:     public static final ConfigurationKey KEY_SPLASH =\n76: \tConfiguration.makeKey(\"init\", \"splash\");\n77: \n78:     /**\n79:      * Key to preload classes.\n80:      */\n81:     public static final ConfigurationKey KEY_PRELOAD =\n82: \tConfiguration.makeKey(\"init\", \"preload\");\n83: \n84:     /**\n85:      * Key to report usage statistics.\n86:      */\n87:     public static final ConfigurationKey KEY_EDEM =\n88: \tConfiguration.makeKey(\"init\", \"edem\");\n89: \n90:     /**\n91:      * Key for last saved project URL.\n92:      */\n93:     public static final ConfigurationKey KEY_MOST_RECENT_PROJECT_FILE =\n94: \tConfiguration.makeKey(\"project\", \"mostrecent\", \"file\");\n95: \n96:     /**\n97:      * Key to reload last saved project on startup.\n98:      */\n99:     public static final ConfigurationKey KEY_RELOAD_RECENT_PROJECT =\n100: \tConfiguration.makeKey(\"init\", \"project\", \"loadmostrecent\");\n101: \n102:     /**\n103:      * Key for number of last recently used file entries in menu list.\n104:      */\n105:     public static final ConfigurationKey KEY_NUMBER_LAST_RECENT_USED =\n106: \tConfiguration.makeKey(\"project\", \"mostrecent\", \"maxNumber\");\n107: \n108:     /**\n109:      * Key for screen top.\n110:      */\n111:     public static final ConfigurationKey KEY_SCREEN_TOP_Y =\n112: \tConfiguration.makeKey(\"screen\", \"top\");\n113: \n114:     /**\n115:      * Key for screen left.\n116:      */\n117:     public static final ConfigurationKey KEY_SCREEN_LEFT_X =\n118: \tConfiguration.makeKey(\"screen\", \"left\");\n119: \n120:     /**\n121:      * Key for screen width.\n122:      */\n123:     public static final ConfigurationKey KEY_SCREEN_WIDTH =\n124: \tConfiguration.makeKey(\"screen\", \"width\");\n125: \n126:     /**\n127:      * Key for screen height.\n128:      */\n129:     public static final ConfigurationKey KEY_SCREEN_HEIGHT =\n130: \tConfiguration.makeKey(\"screen\", \"height\");\n131: \n132:     /**\n133:      * Key for southwest pane width.\n134:      */\n135:     public static final ConfigurationKey KEY_SCREEN_SOUTHWEST_WIDTH =\n136: \tConfiguration.makeKey(\"screen\", \"southwest\", \"width\");\n137: \n138:     /**\n139:      * Key for northwest pane width.\n140:      */\n141:     public static final ConfigurationKey KEY_SCREEN_NORTHWEST_WIDTH =\n142: \tConfiguration.makeKey(\"screen\", \"northwest\", \"width\");\n143: \n144:     /**\n145:      * Key for southeast pane width.\n146:      */\n147:     public static final ConfigurationKey KEY_SCREEN_SOUTHEAST_WIDTH =\n148: \tConfiguration.makeKey(\"screen\", \"southeast\", \"width\");\n149: \n150:     /**\n151:      * Key for northeast pane width.\n152:      */\n153:     public static final ConfigurationKey KEY_SCREEN_NORTHEAST_WIDTH =\n154: \tConfiguration.makeKey(\"screen\", \"northeast\", \"width\");\n155: \n156:     /**\n157:      * Key for west pane width.\n158:      */\n159:     public static final ConfigurationKey KEY_SCREEN_WEST_WIDTH =\n160: \tConfiguration.makeKey(\"screen\", \"west\", \"width\");\n161: \n162:     /**\n163:      * Key for east pane width.\n164:      */\n165:     public static final ConfigurationKey KEY_SCREEN_EAST_WIDTH =\n166: \tConfiguration.makeKey(\"screen\", \"east\", \"width\");\n167: \n168:     /**\n169:      * Key for south pane height.\n170:      */\n171:     public static final ConfigurationKey KEY_SCREEN_SOUTH_HEIGHT =\n172: \tConfiguration.makeKey(\"screen\", \"south\", \"height\");\n173: \n174:     /**\n175:      * Key for north pane height.\n176:      */\n177:     public static final ConfigurationKey KEY_SCREEN_NORTH_HEIGHT =\n178: \tConfiguration.makeKey(\"screen\", \"north\", \"height\");\n179: \n180:     /**\n181:      * Key for theme.\n182:      */\n183:     public static final ConfigurationKey KEY_SCREEN_THEME =\n184: \tConfiguration.makeKey(\"screen\", \"theme\");\n185: \n186:     /**\n187:      * Key for look and feel class name.\n188:      */\n189:     public static final ConfigurationKey KEY_LOOK_AND_FEEL_CLASS =\n190:         Configuration.makeKey(\"screen\", \"lookAndFeelClass\");\n191: \n192:     /**\n193:      * Key for theme class name.\n194:      */\n195:     public static final ConfigurationKey KEY_THEME_CLASS =\n196:         Configuration.makeKey(\"screen\", \"themeClass\");\n197: \n198:     /**\n199:      * Key to enable smooth edges of diagram text and lines (anti-aliasing).\n200:      */\n201:     public static final ConfigurationKey KEY_SMOOTH_EDGES =\n202:         Configuration.makeKey(\"screen\", \"diagram-antialiasing\");\n203: \n204:     /**\n205:      * Key for user email address.\n206:      */\n207:     public static final ConfigurationKey KEY_USER_EMAIL =\n208: \tConfiguration.makeKey(\"user\", \"email\");\n209: \n210:     /**\n211:      * Key for user full name.\n212:      */\n213:     public static final ConfigurationKey KEY_USER_FULLNAME =\n214: \tConfiguration.makeKey(\"user\", \"fullname\");\n215: \n216:     /**\n217:      * Key for user java reverse engineering classpath.\n218:      */\n219:     public static final ConfigurationKey KEY_USER_IMPORT_CLASSPATH =\n220: \tConfiguration.makeKey(\"import\", \"clazzpath\");\n221: \n222:     /**\n223:      * Key for input source file encoding used in RE.\n224:      *  Will be used for generated file also.\n225:      */\n226:     public static final ConfigurationKey KEY_INPUT_SOURCE_ENCODING =\n227: \tConfiguration.makeKey(\"import\", \"file\", \"encoding\");\n228:     \n229:     /**\n230:      * Key to store setting of stripping diagrams on XMI import.\n231:      */\n232:     public static final ConfigurationKey KEY_XMI_STRIP_DIAGRAMS =\n233:         Configuration.makeKey(\"import\", \"xmi\", \"stripDiagrams\");\n234: \n235:     /**\n236:      * Key to store profile/default model.\n237:      */\n238:     public static final ConfigurationKey KEY_DEFAULT_MODEL =\n239:         Configuration.makeKey(\"defaultModel\");\n240: \n241:     /**\n242:      * Key for user explorer perspectives.\n243:      *<pre>\n244:      * format:\n245:      * perspective name,rule,rule,rule;perspective name, etc\n246:      *</pre>\n247:      */\n248:     public static final ConfigurationKey KEY_USER_EXPLORER_PERSPECTIVES =\n249: \tConfiguration.makeKey(\"explorer\", \"perspectives\");\n250: \n251:     /**\n252:      * Key for selecting the locale.\n253:      */\n254:     public static final ConfigurationKey KEY_LOCALE =\n255:         Configuration.makeKey(\"locale\");\n256: \n257:     /**\n258:      * Standard definition of the logging category for the console.\n259:      */\n260:     public static final String CONSOLE_LOG = \"argo.console.log\";\n261: \n262:     /**\n263:      * Standard definition of the logging category for the console.\n264:      */\n265:     public static final String ARGO_CONSOLE_SUPPRESS = \"argo.console.suppress\";\n266: \n267:     /**\n268:      * Standard definition of system variable to add text prefix to\n269:      * console log.\n270:      */\n271:     public static final String ARGO_CONSOLE_PREFIX = \"argo.console.prefix\";\n272: \n273:     /**\n274:      * Don't let this class be instantiated.\n275:      */\n276:     private Argo() {\n277:     }\n278: \n279:     /**\n280:      * Change the default startup directory.\n281:      *\n282:      * @param dir the directory to save\n283:      */\n284:     public static void setDirectory(String dir) {\n285: \t// Store in the user configuration, and\n286: \t// let gef know also.\n287: \torg.tigris.gef.base.Globals.setLastDirectory(dir);\n288: \n289: \t// Configuration.setString(KEY_STARTUP_DIR, dir);\n290:     }\n291: \n292:     /**\n293:      * Get the default startup directory.\n294:      *\n295:      * @return the startup directory\n296:      */\n297:     public static String getDirectory() {\n298: \t// Use the configuration if it exists, otherwise\n299: \t// use what gef thinks.\n300: \treturn Configuration.getString(KEY_STARTUP_DIR,\n301: \t\t\t\t       org.tigris.gef.base.Globals\n302: \t\t\t\t           .getLastDirectory());\n303:     }\n304: \n305:     /**\n306:      * Returns a vector of plugins of the class type passed\n307:      * which satisfy both of the contexts required.\n308:      *\n309:      * If no plugins are available, returns null.\n310:      *\n311:      * @param pluginType class of the plugin to search for\n312:      * @param context plugin-specific query parameters\n313:      * @return a vector of plugins or null\n314:      * @deprecated by Linus Tolke for 0.21.3. This is replaced by the\n315:      *         new module loader.\n316:      */\n317:     public static ArrayList getPlugins(Class pluginType,\n318:                                        Object[] context) {\n319: \treturn ModuleLoader.getInstance().getPlugins(pluginType, context);\n320:     }\n321: \n322:     /**\n323:      * Returns a vector of all plugins of the class type passed.\n324:      *\n325:      * If no plugins are available, returns null.\n326:      *\n327:      * @param pluginType class of the plugin to search for\n328:      * @return a vector of plugins or null\n329:      * @deprecated by Linus Tolke for 0.21.3. This is replaced by the\n330:      *         new module loader.\n331:      */\n332:     public static ArrayList getPlugins(Class pluginType) {\n333: \treturn ModuleLoader.getInstance().getPlugins(pluginType, null);\n334:     }\n335: \n336:     /**\n337:      * Initializes the module loader.  Multiple calls are ignored.\n338:      * @deprecated by Linus Tolke for 0.21.3. There is no reason to\n339:      *         let this call go through the Argo class.\n340:      */\n341:     public static void initializeModules() {\n342: \tModuleLoader.getInstance().initialize();\n343:     }\n344: \n345:     /**\n346:      * Convenience helper to access the argo home directory.\n347:      *\n348:      * @return the argo home directory\n349:      * @deprecated by Linus Tolke for 0.21.3. I don't think there is\n350:      *         a reason to let this call go through the Argo class.\n351:      */\n352:     public static String getArgoHome() {\n353: \treturn ModuleLoader.getInstance().getArgoHome();\n354:     }\n355: \n356:     /**\n357:      * Convenience helper to access the argo root directory.\n358:      *\n359:      * @return the argo root directory\n360:      * @deprecated by Linus Tolke for 0.21.3. I don't think there is\n361:      *         a reason to let this call go through the Argo class.\n362:      */\n363:     public static String getArgoRoot() {\n364: \treturn ModuleLoader.getInstance().getArgoRoot();\n365:     }\n366: \n367:     /**\n368:      * Look up an icon resource.\n369:      *\n370:      * @param arg1 the name of the resource to find.\n371:      * @return an Icon\n372:      */\n373:     public static Icon lookupIconResource(String arg1) {\n374: \treturn ResourceLoaderWrapper.lookupIconResource(arg1);\n375:     }\n376: \n377:     /**\n378:      * Look up an icon resource.\n379:      *\n380:      * @param arg1 the name of the resource to find.\n381:      * @param arg2 the description of the resource\n382:      * @return an Icon\n383:      */\n384:     public static Icon lookupIconResource(String arg1, String arg2) {\n385: \treturn ResourceLoaderWrapper.lookupIconResource(arg1, arg2);\n386:     }\n387: \n388:     static {\n389: \tif (System.getProperty(ARGO_CONSOLE_SUPPRESS) != null) {\n390:             Category.getRoot().getLoggerRepository().setThreshold(Level.OFF);\n391: \t}\n392:     }\n393: }\n394: ",
