eam.putNextEntry(zipEntry);\n140: \n141:             Hashtable templates =\n142:                 TemplateReader.getInstance().read(ARGO_MINI_TEE);\n143:             OCLExpander expander = new OCLExpander(templates);\n144:             expander.expand(writer, project);\n145: \n146:             writer.flush();\n147: \n148:             stream.closeEntry();\n149:             \n150:             int counter = 0;\n151:             int size = project.getMembers().size();\n152:             Collection names = new ArrayList();\n153:             for (int i = 0; i < size; i++) {\n154:                 ProjectMember projectMember =\n155:                     (ProjectMember) project.getMembers().get(i);\n156:                 if (!(projectMember.getType().equalsIgnoreCase(\"xmi\"))) {\n157:                     if (LOG.isInfoEnabled()) {\n158:                         LOG.info(\"Saving member: \"\n159:                                 + ((ProjectMember) project.getMembers()\n160:                                         .get(i)).getZipName());\n161:                     }\n162:                     String name = projectMember.getZipName();\n163:                     String originalName = name;\n164:                     while (names.contains(name)) {\n165:                         name = ++counter + originalName;\n166:                     }\n167:                     names.add(name);\n168:                     stream.putNextEntry(new ZipEntry(name));\n169:                     MemberFilePersister persister =\n170:                         getMemberFilePersister(projectMember);\n171:                     persister.save(projectMember, writer, null);\n172:                     writer.flush();\n173:                     stream.closeEntry();\n174:                 }\n175:             }\n176:             \n177:             for (int i = 0; i < size; i++) {\n178:                 ProjectMember projectMember =\n179:                     (ProjectMember) project.getMembers().get(i);\n180:                 if (projectMember.getType().equalsIgnoreCase(\"xmi\")) {\n181:                     if (LOG.isInfoEnabled()) {\n182:                         LOG.info(\"Saving member of type: \"\n183:                                 + ((ProjectMember) project.getMembers()\n184:                                         .get(i)).getType());\n185:                     }\n186:                     stream.putNextEntry(\n187:                             new ZipEntry(projectMember.getZipName()));\n188:                     OldModelMemberFilePersister persister =\n189:                         new OldModelMemberFilePersister();\n190:                     persister.save(projectMember, writer, null);\n191:                 }\n192:             }\n193:             \n194:             \n195:             \n196:             // if save did not raise an exception\n197:             // and name+\"#\" exists move name+\"#\" to name+\"~\"\n198:             // this is the correct backup file\n199:             if (lastArchiveFile.exists()) {\n200:                 lastArchiveFile.delete();\n201:             }\n202:             if (tempFile.exists() && !lastArchiveFile.exists()) {\n203:                 tempFile.renameTo(lastArchiveFile);\n204:             }\n205:             if (tempFile.exists()) {\n206:                 tempFile.delete();\n207:             }\n208: \n209:             progressMgr.nextPhase();\n210: \n211:         } catch (Exception e) {\n212:             LOG.error(\"Exception occured during save attempt\", e);\n213:             try {\n214:                 writer.close();\n215:             } catch (Exception ex) {\n216:                 // Do nothing.\n217:             }\n218: \n219:             // frank: in case of exception\n220:             // delete name and mv name+\"#\" back to name if name+\"#\" exists\n221:             // this is the \"rollback\" to old file\n222:             file.delete();\n223:             tempFile.renameTo(file);\n224:             // we have to give a message to user and set the syst