.NotationProvider#getParsingHelp()\n85:          */\n86:         public String getParsingHelp() {\n87:             return null;\n88:         }\n89: \n90:         /*\n91:          * @see org.argouml.uml.notation.NotationProvider#toString(java.lang.Object, java.util.HashMap)\n92:          */\n93:         public String toString(Object element, HashMap args) {\n94:             return element.toString() + args.size();\n95:         }\n96: \n97:         /*\n98:          * @see org.argouml.uml.notation.NotationProvider#parse(java.lang.Object, java.lang.String)\n99:          */\n100:         public void parse(Object element, String text) {\n101: \n102:         }\n103:     }\n104:     \n105:     public void testListener() {\n106:         Object model =\n107:             Model.getModelManagementFactory().createModel();\n108:         Project p = ProjectManager.getManager().getCurrentProject();\n109:         p.setRoot(model);\n110:         aClass = Model.getCoreFactory().buildClass(model);\n111:         \n112:         NotationProvider np = new NPImpl();\n113:         np.addListener(this, aClass);\n114:         \n115:         propChanged = false;\n116:         Model.getCoreHelper().setName(aClass, \"ClassA1\");\n117:         Model.getPump().flushModelEvents();\n118:         assertTrue(\"No event received\", propChanged);\n119:         \n120:         np.removeListener(this, aClass);\n121:         propChanged = false;\n122:         Model.getCoreHelper().setName(aClass, \"ClassA2\");\n123:         Model.getPump().flushModelEvents();\n124:         assertTrue(\"Event received, despite not listening\", !propChanged);\n125: \n126:         np.updateListener(this, aClass, null);\n127:     }\n128: \n129:     public void propertyChange(PropertyChangeEvent evt) {\n130:         propChanged = true;\n131:     }\n132: }\n133: ",
