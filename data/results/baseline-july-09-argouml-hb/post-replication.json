                    "kwargs": {
                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/persistence/ZargoFilePersister.java: \n1: // $Id$\n2: // Copyright (c) 1996-2006 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.persistence;\n26: \n27: import java.io.BufferedReader;\n28: import java.io.BufferedWriter;\n29: import java.io.File;\n30: import java.io.FileNotFoundException;\n31: import java.io.FileOutputStream;\n32: import java.io.FilterInputStream;\n33: import java.io.IOException;\n34: import java.io.InputStreamReader;\n35: import java.io.OutputStreamWriter;\n36: import java.io.PrintWriter;\n37: import java.io.Reader;\n38: import java.io.Writer;\n39: import java.net.URL;\n40: import java.util.zip.ZipEntry;\n41: import java.util.zip.ZipInputStream;\n42: import java.util.zip.ZipOutputStream;\n43: \n44: import org.apache.log4j.Logger;\n45: import org.argouml.application.ArgoVersion;\n46: import org.argouml.i18n.Translator;\n47: import org.argouml.kernel.Project;\n48: import org.argouml.kernel.ProjectMember;\n49: import org.argouml.util.FileConstants;\n50: import org.argouml.util.ThreadUtils;\n51: \n52: /**\n53:  * To persist to and from zargo (zipped file) storage.\n54:  *\n55:  * @author Bob Tarling\n56:  */\n57: public class ZargoFilePersister extends UmlFilePersister {\n58:     /**\n59:      * Logger.\n60:      */\n61:     private static final Logger LOG =\n62: \tLogger.getLogger(ZargoFilePersister.class);\n63: \n64:     /**\n65:      * The constructor.\n66:      */\n67:     public ZargoFilePersister() {\n68:     }\n69: \n70:     /**\n71:      * @see org.argouml.persistence.AbstractFilePersister#getExtension()\n72:      */\n73:     public String getExtension() {\n74:         return \"zargo\";\n75:     }\n76: \n77:     /**\n78:      * @see org.argouml.persistence.AbstractFilePersister#getDesc()\n79:      */\n80:     protected String getDesc() {\n81:         return Translator.localize(\"combobox.filefilter.zargo\");\n82:     }\n83: \n84:     /**\n85:      * It is being considered to save out individual xmi's from individuals\n86:      * diagrams to make it easier to modularize the output of Argo.\n87:      *\n88:      * @param file\n89:      *            The file to write.\n90:      * @param project\n91:      *            the project to save\n92:      * @throws SaveException\n93:      *             when anything goes wrong\n94:      * @throws InterruptedException     if the thread is interrupted\n95:      *\n96:      * @see org.argouml.persistence.ProjectFilePersister#save(\n97:      *      org.argouml.kernel.Project, java.io.File)\n98:      */\n99:     public void doSave(Project project, File file) throws SaveException, \n100:     InterruptedException {\n101: \n102:         ProgressMgr progressMgr = new ProgressMgr();\n103:         progressMgr.setNumberOfPhases(4);\n104:         progressMgr.nextPhase();\n105:         \n106:         File lastArchiveFile = new File(file.getAbsolutePath() + \"~\");\n107:         File tempFile = null;\n108: \n109:         try {\n110:             tempFile = createTempFile(file);\n111:         } catch (FileNotFoundException e) {\n112:             throw new SaveException(\n113:                     \"Failed to archive the previous file version\", e);\n114:         } catch (IOException e) {\n115:             throw new SaveException(\n116:                     \"Failed to archive the previous file version\", e);\n117:         }\n118: \n119:         BufferedWriter writer = null;\n120:         try {\n121: \n122:             project.setFile(file);\n123:             project.setVersion(ArgoVersion.getVersion());\n124:             project.setPersistenceVersion(PERSISTENCE_VERSION);\n125: \n126:             ZipOutputStream stream =\n127:                 new ZipOutputStream(new FileOutputStream(file));\n128:             writer =\n129:                 new BufferedWriter(new OutputStreamWriter(stream, \"UTF-8\"));\n130: \n131:             int size = project.getMembers().size();\n132:             for (int i = 0; i < size; i++) {\n133:                 ProjectMember projectMember =\n134:                     (ProjectMember) project.getMembers().get(i);\n135:                 if (projectMember.getType().equalsIgnoreCase(\"xmi\")) {\n136:                     if (LOG.isInfoEnabled()) {\n137:                         LOG.info(\"Saving member of type: \"\n138:                                 + ((ProjectMember) project.getMembers()\n139:                                         .get(i)).getType());\n140:                     }\n141:                     stream.putNextEntry(\n142:                             new ZipEntry(projectMember.getZipName()));\n143:                     MemberFilePersister persister =\n144:                         getMemberFilePersister(projectMember);\n145:                     persister.save(projectMember, writer, null);\n146:                 }\n147:             }\n148:             // if save did not raise an exception\n149:             // and name+\"#\" exists move name+\"#\" to name+\"~\"\n150:             // this is the correct backup file\n151:             if (lastArchiveFile.exists()) {\n152:                 lastArchiveFile.delete();\n153:             }\n154:             if (tempFile.exists() && !lastArchiveFile.exists()) {\n155:                 tempFile.renameTo(lastArchiveFile);\n156:             }\n157:             if (tempFile.exists()) {\n158:                 tempFile.delete();\n159:             }\n160: \n161:             progressMgr.nextPhase();\n162: \n163:         } catch (Exception e) {\n164:             LOG.error(\"Exception occured during save attempt\", e);\n165:             try {\n166:                 writer.close();\n167:             } catch (Exception ex) {\n168:                 // Do nothing.\n169:             }\n170: \n171:             // frank: in case of exception\n172:             // delete name and mv name+\"#\" back to name if name+\"#\" exists\n173:             // this is the \"rollback\" to old file\n174:             file.delete();\n175:             tempFile.renameTo(file);\n176:             // we have to give a message to user and set the system to unsaved!\n177:             throw new SaveException(e);\n178:         }\n179: \n180:         try {\n181:             writer.close();\n182:         } catch (IOException ex) {\n183:             LOG.error(\"Failed to close save output writer\", ex);\n184:         }\n185:     }\n186: \n187:     /**\n188:      * @see org.argouml.persistence.ProjectFilePersister#doLoad(java.io.File)\n189:      */\n190:     public Project doLoad(File file)\n191:         throws OpenException, InterruptedException {\n192:         \n193:         ProgressMgr progressMgr = new ProgressMgr();\n194:         progressMgr.setNumberOfPhases(3 + UML_PHASES_LOAD);\n195:         ThreadUtils.checkIfInterrupted();\n196: \n197:         try {\n198:             File combinedFile = File.createTempFile(\"combinedzargo_\", \".uml\");\n199:             LOG.info(\n200:                 \"Combining old style zargo sub files into new style uml file \"\n201:                     + combinedFile.getAbsolutePath());\n202:             combinedFile.deleteOnExit();\n203: \n204:             String encoding = \"UTF-8\";\n205:             FileOutputStream stream = new FileOutputStream(combinedFile);\n206:             PrintWriter writer =\n207: \t\tnew PrintWriter(new BufferedWriter(\n208: \t\t\tnew OutputStreamWriter(stream, encoding)));\n209: \n210:             writer.println(\"<?xml version = \\\"1.0\\\" \" + \"encoding = \\\"\"\n211:                     + encoding + \"\\\" ?>\");\n212: \n213:             // first read the .argo file from Zip\n214:             ZipInputStream zis =\n215:                 openZipStreamAt(file.toURL(), FileConstants.PROJECT_FILE_EXT);\n216:             if (zis == null) {\n217:                 ZipFilePersister zfp = new ZipFilePersister();\n218:                 return zfp.doLoad(file);\n219:             }\n220:             \n221:             String line;\n222:             BufferedReader reader = new BufferedReader(new InputStreamReader(zis, encoding));\n223:             // Keep reading till we hit the <argo> tag\n224:             String rootLine;\n225:             do {\n226:                 rootLine = reader.readLine();\n227:                 if (rootLine == null) {\n228:                     throw new OpenException(\n229:                             \"Can't find an <argo> tag in the argo file\");\n230:                 }\n231:             } while(!rootLine.startsWith(\"<argo\"));\n232: \n233:             progressMgr.nextPhase();\n234:             \n235:             // Get the version from the tag.\n236:             String version = getVersion(rootLine);\n237:             writer.println(\"<uml version=\\\"\" + version + \"\\\">\");\n238:             writer.println(rootLine);\n239:             while ((line = reader.readLine()) != null) {\n240:                 writer.println(line);\n241:             }\n242:             zis.close();\n243:             reader.close();\n244: \n245:             // then the xmi\n246:             zis = openZipStreamAt(file.toURL(), \".xmi\");\n247:             reader = new BufferedReader(new InputStreamReader(zis, encoding));\n248:             // Skip 1 lines\n249:             reader.readLine();\n250: \n251:             readerToWriter(reader, writer);\n252: \n253:             zis.close();\n254:             reader.close();\n255: \n256:             // Loop round loading the diagrams\n257:             zis = new ZipInputStream(file.toURL().openStream());\n258:             SubInputStream sub = new SubInputStream(zis);\n259: \n260:             ZipEntry currentEntry = null;\n261:             while ((currentEntry = sub.getNextEntry()) != null) {\n262:                 if (currentEntry.getName().endsWith(\".pgml\")) {\n263: \n264:                     reader =\n265:                         new BufferedReader(\n266:                         \tnew InputStreamReader(sub, encoding));\n267:                     // Skip the 2 lines\n268:                     //<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\n269:                     //<!DOCTYPE pgml SYSTEM \"pgml.dtd\">\n270:                     // TODO: This could be made more robust, \n271:                     // these 2 lines should be\n272:                     // there but what if they don't exist?\n273:                     reader.readLine();\n274:                     reader.readLine();\n275:                     readerToWriter(reader, writer);\n276:                     sub.close();\n277:                     reader.close();\n278:                 }\n279:             }\n280:             zis.close();\n281: \n282:             // Alway load the todo items last so that any model\n283:             // elements or figs that the todo items refer to\n284:             // will exist before creating critics.\n285:             zis = openZipStreamAt(file.toURL(), \".todo\");\n286:             reader = new BufferedReader(new InputStreamReader(zis, encoding));\n287:             // Skip the 2 lines\n288:             //<?xml version = \"1.0\" encoding = \"UTF-8\" ?>\n289:             //<!DOCTYPE todo SYSTEM \"todo.dtd\" >\n290:             // TODO: This could be made more robust, these 2 lines should be\n291:             // there but what if they don't exist?\n292:             reader.readLine();\n293:             reader.readLine();\n294: \n295:             readerToWriter(reader, writer);\n296: \n297:             progressMgr.nextPhase();\n298:             \n299:             zis.close();\n300:             reader.close();\n301: \n302:             writer.println(\"</uml>\");\n303:             writer.close();\n304:             LOG.info(\"Complated combining files\");\n305:             Project p =  super.doLoad(file, combinedFile, progressMgr);\n306:             \n307:             progressMgr.nextPhase();\n308:             \n309:             p.setURL(file.toURL());\n310:             return p;\n311:         } catch (IOException e) {\n312:             throw new OpenException(e);\n313:         }\n314:     }\n315: \n316:     private void readerToWriter(\n317:             Reader reader,\n318:             Writer writer) throws IOException {\n319: \n320:         int ch;\n321:         while ((ch = reader.read()) != -1) {\n322:             if (ch != 0xFFFF) {\n323:                 writer.write(ch);\n324:             } else {\n325:                 LOG.info(\"Stripping out 0xFFFF from XMI\");\n326:             }\n327:         }\n328:     }\n329: \n330:     /**\n331:      * Open a ZipInputStream to the first file found with a given extension.\n332:      *\n333:      * @param url\n334:      *            The URL of the zip file.\n335:      * @param ext\n336:      *            The required extension.\n337:      * @return the zip stream positioned at the required location or null\n338:      * if the requested extension is not found.\n339:      * @throws IOException\n340:      *             if there is a problem opening the file.\n341:      */\n342:     private ZipInputStream openZipStreamAt(URL url, String ext)\n343:         throws IOException {\n344:         ZipInputStream zis = new ZipInputStream(url.openStream());\n345:         ZipEntry entry = zis.getNextEntry();\n346:         while (entry != null && !entry.getName().endsWith(ext)) {\n347:             entry = zis.getNextEntry();\n348:         }\n349:         if (entry == null) {\n350:             zis.close();\n351:             return null;\n352:         }\n353:         return zis;\n354:     }\n355: \n356:     /**\n357:      * A stream of input streams for reading the Zipped file.\n358:      */\n359:     private static class SubInputStream extends FilterInputStream {\n360:         private ZipInputStream in;\n361: \n362:         /**\n363:          * The constructor.\n364:          *\n365:          * @param z\n366:          *            the zip input stream\n367:          */\n368:         public SubInputStream(ZipInputStream z) {\n369:             super(z);\n370:             in = z;\n371:         }\n372: \n373:         /**\n374:          * @see java.io.InputStream#close()\n375:          */\n376:         public void close() throws IOException {\n377:             in.closeEntry();\n378:         }\n379: \n380:         /**\n381:          * Reads the next ZIP file entry and positions stream at the beginning\n382:          * of the entry data.\n383:          *\n384:          * @return the ZipEntry just read\n385:          * @throws IOException\n386:          *             if an I/O error has occurred\n387:          */\n388:         public ZipEntry getNextEntry() throws IOException {\n389:             return in.getNextEntry();\n390:         }\n391:     }\n392: }\n393: ",
