isplayed, then allow some space for that\n474:         // (width and height)\n475: \n476:         if (getStereotypeFig().isVisible()) {\n477:             Dimension stereoMin = getStereotypeFig().getMinimumSize();\n478:             aSize.width =\n479:                 Math.max(aSize.width,\n480:                          stereoMin.width);\n481:             aSize.height += stereoMin.height;\n482:         }\n483:         \n484:         // And add the gaps around the textfield to get the minimum\n485:         // size of the note.\n486:         return new Dimension(aSize.width + 4 + dogear,\n487: \t\t\t     aSize.height + 4);\n488:     }\n489: \n490:     /**\n491:      * @see org.tigris.gef.presentation.Fig#setBounds(int, int, int, int)\n492:      */\n493:     protected void setBoundsImpl(int px, int py, int w, int h) {\n494:         if (bodyTextFig == null) {\n495:             return;\n496:         }\n497:         \n498:         Dimension stereoMin = getStereotypeFig().getMinimumSize();\n499:         \n500:         int stereotypeHeight = 0;\n501:         if (getStereotypeFig().isVisible()) {\n502:             stereotypeHeight = stereoMin.height;\n503:         }\n504:         \n505:         Rectangle oldBounds = getBounds();\n506: \n507:         // Resize the text figure\n508:         bodyTextFig.setBounds(px + 2, py + 2 + stereotypeHeight, \n509:                 w - 4 - dogear, h - 4 - stereotypeHeight);\n510: \n511:         getStereotypeFig().setBounds(px + 2, py + 2,\n512:                 w - 4 - dogear, stereoMin.height);\n513:         \n514:         // Resize the big port around the figure\n515:         getBigPort().setBounds(px, py, w, h);\n516: \n517:         // Since this is a complex polygon, there's no easy way to resize it.\n518:         Polygon newPoly = new Polygon();\n519:         newPoly.addPoint(px, py);\n520:         newPoly.addPoint(px + w - 1 - dogear, py);\n521:         newPoly.addPoint(px + w - 1, py + dogear);\n522:         newPoly.addPoint(px + w - 1