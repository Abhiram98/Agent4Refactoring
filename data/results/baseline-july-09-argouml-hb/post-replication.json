)) {\n94: \t    name = ModelFacade.getName(obj);\n95:             Object tv = ModelFacade.getTaggedValue(obj, \"src_path\");\n96:             if (tv != null)\n97:                 path = ModelFacade.getValueOfTag(tv);\n98: \t    if (ModelFacade.isAPackage(obj))\n99: \t\ttype = \"Package\";\n100: \t    else if (ModelFacade.isAClass(obj))\n101: \t\ttype = \"Class\";\n102: \t    if (ModelFacade.isAInterface(obj))\n103: \t\ttype = \"Interface\";\n104: \t} else {\n105: \t    return null;\n106: \t}\n107: \n108: \tJFileChooser chooser = null;\n109: \tFile f = null;\n110: \tif (path != null) {\n111: \t    f = new File(path);\n112: \t}\n113: \tif ((f != null) && (f.getPath().length() > 0)) {\n114: \t    chooser  = OsUtil.getFileChooser(f.getPath());\n115: \t}\n116: \tif (chooser == null) {\n117: \t    chooser  = OsUtil.getFileChooser();\n118: \t}\n119: \tif (f != null) {\n120: \t    chooser.setSelectedFile(f);\n121: \t}\n122: \n123: \tString sChooserTitle =\n124: \t    Translator.localize(\"action.set-source-path\");\n125: \tif (type != null)\n126: \t    sChooserTitle += ' ' + type;\n127: \tif (name != null)\n128: \t    sChooserTitle += ' ' + name;\n129: \tchooser.setDialogTitle(sChooserTitle);\n130: \tchooser.setFileSelectionMode(JFileChooser.DIRECTORIES_ONLY);\n131: \n132: \tint retval = chooser.showDialog(ProjectBrowser.getInstance(), \"OK\");\n133: \tif (retval == JFileChooser.APPROVE_OPTION) {\n134: \t    return chooser.getSelectedFile();\n135: \t} else {\n136: \t    return null;\n137: \t}\n138:     }\n139: \n140:     /**\n141:      * @see org.argouml.uml.ui.UMLAction#shouldBeEnabled()\n142:      */\n143:     public boolean shouldBeEnabled() {\n144: \treturn true;\n145:     }\n146: } /* end class ActionSetSourcePath */\n147: ",
