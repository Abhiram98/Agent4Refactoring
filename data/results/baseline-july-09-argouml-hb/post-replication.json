1: \n32: import java.awt.*;\n33: import java.awt.event.*;\n34: import java.util.*;\n35: \n36: import com.sun.java.swing.event.*;\n37: import com.sun.java.swing.tree.*;\n38: // import com.sun.java.swing.text.*;\n39: // import com.sun.java.swing.border.*;\n40: \n41: import uci.ui.*;\n42: import uci.gef.*;\n43: import uci.uml.Foundation.Core.*;\n44: import uci.uml.Model_Management.*;\n45: import uci.uml.ui.nav.NavPerspective;\n46: \n47: \n48: /** The main window of the Argo/UML application. */\n49: \n50: public class ProjectBrowser extends JFrame\n51: implements IStatusBar {\n52:   ////////////////////////////////////////////////////////////////\n53:   // constants\n54: \n55: //   public static int WIDTH = 800;\n56: //   public static int HEIGHT = 600;\n57: //   public static int INITIAL_WIDTH = 400; // for showing progress bar\n58: //   public static int INITIAL_HEIGHT = 200;\n59: \n60:   ////////////////////////////////////////////////////////////////\n61:   // class variables\n62: \n63:   public static ProjectBrowser TheInstance;\n64:   \n65:   // Actions\n66:   // file menu\n67:   protected static Action _actionNew =  Actions.New;\n68:   protected static Action _actionOpen = Actions.Open;\n69:   protected static Action _actionOpenXMI = Actions.OpenXMI;\n70:   protected static Action _actionSave = Actions.SaveProjectAs;\n71:   protected static Action _actionSaveAs = Actions.SaveAs;\n72:   protected static Action _actionSaveAsXMI = Actions.SaveAsXMI;\n73:   // -----\n74:   protected static Action _actionAddToProj = Actions.AddToProj;\n75:   // -----\n76:   protected static Action _actionPrint = Actions.Print;\n77:   // -----\n78:   protected static Action _actionExit = Actions.Exit;\n79: \n80:   // edit menu\n81:   protected static Action _actionUndo = Actions.Undo;\n82:   protected static Action _actionRedo = Actions.Redo;\n83:   protected static Action _actionCut = Actions.Cut;\n84:   protected static Action _actionCopy = Actions.Copy;\n85:   protected static Action _actionPaste = Actions.Paste;\n86:   protected static Action _actionDelete = Actions.DeleteFromDiagram;\n87:   protected static Action _actionRemove = Actions.RemoveFromModel;\n88:   protected static Action _actionEmpty = Actions.EmptyTrash;\n89: \n90:   // view menu\n91:   protected static Action _actionNavUp = Actions.NavUp;\n92:   protected static Action _actionNavDown = Actions.NavDown;\n93:   protected static Action _actionNavBack = Actions.NavBack;\n94:   protected static Action _actionNavForw = Actions.NavForw;\n95:   protected static Action _actionFind = Actions.Find;\n96:   protected static Action _actionGotoDiagram = Actions.GotoDiagram;\n97:   protected static Action _actionNextEditTab = Actions.NextEditTab;\n98:   protected static Action _actionAddToFavs = Actions.AddToFavs;\n99:   protected static Action _actionNextDetailsTab = Actions.NextDetailsTab;\n100: \n101:   // create menu\n102:   protected static Action _actionCreateMultiple = Actions.CreateMultiple;\n103:   // ----- diagrams\n104:   protected static Action _actionClassDiagram = Actions.ClassDiagram;\n105:   protected static Action _actionUseCaseDiagram = Actions.UseCaseDiagram;\n106:   protected static Action _actionStateDiagram = Actions.StateDiagram;\n107:   protected static Action _actionActivityDiagram = Actions.ActivityDiagram;\n108:   protected static Action _actionCollabortationDiagram = Actions.CollaborationDiagram;\n109: \n110:   // ----- model elements\n111:   //protected static Action _actionModel = Actions.Model;\n112:   //protected static Action _actionClass = Actions.Class;\n113:   //protected static Action _actionInterface = Actions.Interface;\n114:   //protected static Action _actionActor = Actions.Actor;\n115:   //protected static Action _actionUseCase = Actions.UseCase;\n116:   //protected static Action _actionState = Actions.State;\n117:   //protected static Action _actionPseudostate = Actions.Pseudostate;\n118:   //protected static Action _actionAttr = Actions.Attr;\n119:   //protected static Action _actionOper = Actions.Oper;\n120:   // -----  shapes\n121:   protected static Action _actionRectangle = new uci.gef.CmdSetMode(uci.gef.ModeCreateFigRect.class, \"Rectangle\");\n122:   protected static Action _actionRRectangle = new uci.gef.CmdSetMode(uci.gef.ModeCreateFigRRect.class, \"RRect\");\n123:   protected static Action _actionCircle = new uci.gef.CmdSetMode(uci.gef.ModeCreateFigCircle.class, \"Circle\");\n124:   protected static Action _actionLine = new uci.gef.CmdSetMode(uci.gef.ModeCreateFigLine.class, \"Line\");\n125:   protected static Action _actionText = new uci.gef.CmdSetMode(uci.gef.ModeCreateFigText.class, \"Text\");\n126:   protected static Action _actionPoly = new uci.gef.CmdSetMode(uci.gef.ModeCreateFigPoly.class, \"Polygon\");\n127:   protected static Action _actionInk = new uci.gef.CmdSetMode(uci.gef.ModeCreateFigInk.class, \"Ink\");\n128: \n129:   // actions menu\n130:   protected static Action _actionGenerateOne = Actions.GenerateOne;\n131:   protected static Action _actionGenerateAll = Actions.GenerateAll;\n132:   protected static Action _actionGenerateWeb = Actions.GenerateWeb;\n133: \n134:   // critique menu\n135:   protected static Action _actionAutoCritique = Actions.AutoCritique;\n136:   protected static Action _actionOpenDecisions = Actions.OpenDecisions;\n137:   protected static Action _actionOpenGoals = Actions.OpenGoals;\n138:   protected static Action _actionOpenCritics = Actions.OpenCritics;\n139: \n140: \n141:   // Help menu\n142:   protected static Action _actionAboutArgoUML = Actions.AboutArgoUML;\n143: \n144:   ////////////////////////////////////////////////////////////////\n145:   // instance variables\n146: \n147:   protected String _appName = \"ProjectBrowser\";\n148:   protected Project _project = null;\n149: \n150:   protected NavigatorPane _navPane;\n151:   public ToDoPane _toDoPane;\n152:   protected MultiEditorPane _multiPane;\n153:   protected DetailsPane _detailsPane;\n154:   protected JMenuBar _menuBar = new JMenuBar();\n155:   protected StatusBar _statusBar = new StatusBar();\n156:   //protected JToolBar _toolBar = new JToolBar();\n157: \n158: \n159:   public Font defaultFont = new Font(\"Dialog\", Font.PLAIN, 10);\n160:   //  public static JFrame _Frame;\n161: \n162:   protected JSplitPane _mainSplit, _topSplit, _botSplit;\n163: \n164: \n165:   ////////////////////////////////////////////////////////////////\n166:   // constructors\n167: \n168:   public ProjectBrowser(String appName, StatusBar sb) {\n169:     super(appName);\n170:     sb.showStatus(\"Making Project Browser: Navigator Pane\");\n171:     sb.incProgress(5);\n172:     _navPane = new NavigatorPane();\n173:     sb.showStatus(\"Making Project Browser: To Do Pane\");\n174:     sb.incProgress(5);\n175:     _toDoPane = new ToDoPane();\n176:     _multiPane = new MultiEditorPane(sb);\n177:     _detailsPane = new DetailsPane(sb);\n178:     setAppName(appName);\n179:     if (TheInstance == null) TheInstance = this;\n180:     //setName(title);\n181:     //loadImages();\n182:     getContentPane().setFont(defaultFont);\n183:     getContentPane().setLayout(new BorderLayout());\n184:     initMenus();\n185:     //initToolBar();\n186:     getContentPane().add(_menuBar, BorderLayout.NORTH);\n187:     //JPanel p = new JPanel();\n188:     //p.setLayout(new BorderLayout());\n189:     //getContentPane().add(p, BorderLayout.CENTER);\n190:     //p.add(_toolBar, BorderLayout.NORTH);\n191:     getContentPane().add(createPanels(), BorderLayout.CENTER);\n192:     getContentPane().add(_statusBar, BorderLayout.SOUTH);\n193:     _toDoPane.setRoot(uci.argo.kernel.Designer.TheDesigner.getToDoList());\n194: \n195:     // allows me to ask \"Do you want to save first?\"\n196:     setDefaultCloseOperation(DO_NOTHING_ON_CLOSE);\n197:     addWindowListener(new WindowCloser());\n198:   }\n199: \n200: \n201: //   void loadImages() {\n202: //     String s = \"A blue bullet icon - to draw attention to a menu item\";\n203: //     blueDot = loadImageIcon(\"images/dot.gif\", s);\n204: //     s = \"A red bullet icon - to draw attention to a menu item\";\n205: //     redDot = loadImageIcon(\"images/redDot.gif\", s);\n206: //   }\n207: \n208: \n209:   protected void initMenus() {\n210:     KeyStroke ctrlN = KeyStroke.getKeyStroke(KeyEvent.VK_N, KeyEvent.CTRL_MASK);\n211:     KeyStroke ctrlO = KeyStroke.getKeyStroke(KeyEvent.VK_O, KeyEvent.CTRL_MASK);\n212:     KeyStroke ctrlS = KeyStroke.getKeyStroke(KeyEvent.VK_S, KeyEvent.CTRL_MASK);\n213:     KeyStroke ctrlP = KeyStroke.getKeyStroke(KeyEvent.VK_P, KeyEvent.CTRL_MASK);\n214:     KeyStroke ctrlA = KeyStroke.getKeyStroke(KeyEvent.VK_A, KeyEvent.CTRL_MASK);\n215:     KeyStroke ctrlC = KeyStroke.getKeyStroke(KeyEvent.VK_C, KeyEvent.CTRL_MASK);\n216:     KeyStroke ctrlV = KeyStroke.getKeyStroke(KeyEvent.VK_V, KeyEvent.CTRL_MASK);\n217:     KeyStroke ctrlX = KeyStroke.getKeyStroke(KeyEvent.VK_X, KeyEvent.CTRL_MASK);\n218:     KeyStroke ctrlR = KeyStroke.getKeyStroke(KeyEvent.VK_R, KeyEvent.CTRL_MASK);\n219: \n220:     KeyStroke F1 = KeyStroke.getKeyStroke(KeyEvent.VK_F1, 0);\n221:     KeyStroke F2 = KeyStroke.getKeyStroke(KeyEvent.VK_F2, 0);\n222:     KeyStroke F3 = KeyStroke.getKeyStroke(KeyEvent.VK_F3, 0);\n223:     KeyStroke F4 = KeyStroke.getKeyStroke(KeyEvent.VK_F4, 0);\n224:     KeyStroke F5 = KeyStroke.getKeyStroke(KeyEvent.VK_F5, 0);\n225:     KeyStroke F6 = KeyStroke.getKeyStroke(KeyEvent.VK_F6, 0);\n226:     KeyStroke F7 = KeyStroke.getKeyStroke(KeyEvent.VK_F7, 0);\n227:     KeyStroke F8 = KeyStroke.getKeyStroke(KeyEvent.VK_F8, 0);\n228:     KeyStroke F9 = KeyStroke.getKeyStroke(KeyEvent.VK_F9, 0);\n229:     KeyStroke F10 = KeyStroke.getKeyStroke(KeyEvent.VK_F10, 0);\n230:     KeyStroke altF4 = KeyStroke.getKeyStroke(KeyEvent.VK_F4, KeyEvent.ALT_MASK);\n231: \n232:     KeyStroke alt1 = KeyStroke.getKeyStroke(KeyEvent.VK_1, KeyEvent.ALT_MASK);\n233:     KeyStroke alt2 = KeyStroke.getKeyStroke(KeyEvent.VK_2, KeyEvent.ALT_MASK);\n234:     KeyStroke alt3 = KeyStroke.getKeyStroke(KeyEvent.VK_3, KeyEvent.ALT_MASK);\n235:     KeyStroke alt4 = KeyStroke.getKeyStroke(KeyEvent.VK_4, KeyEvent.ALT_MASK);\n236:     KeyStroke alt5 = KeyStroke.getKeyStroke(KeyEvent.VK_5, KeyEvent.ALT_MASK);\n237:     KeyStroke alt6 = KeyStroke.getKeyStroke(KeyEvent.VK_6, KeyEvent.ALT_MASK);\n238:     KeyStroke alt7 = KeyStroke.getKeyStroke(KeyEvent.VK_7, KeyEvent.ALT_MASK);\n239:     KeyStroke alt8 = KeyStroke.getKeyStroke(KeyEvent.VK_8, KeyEvent.ALT_MASK);\n240:     KeyStroke alt9 = KeyStroke.getKeyStroke(KeyEvent.VK_9, KeyEvent.ALT_MASK);\n241:     KeyStroke alt0 = KeyStroke.getKeyStroke(KeyEvent.VK_0, KeyEvent.ALT_MASK);\n242: \n243:     KeyStroke altshift1 =\n244:       KeyStroke.getKeyStroke(KeyEvent.VK_1,\n245: \t\t\t     KeyEvent.ALT_MASK | KeyEvent.SHIFT_MASK);\n246:     KeyStroke altshift2 =\n247:       KeyStroke.getKeyStroke(KeyEvent.VK_2,\n248: \t\t\t     KeyEvent.ALT_MASK | KeyEvent.SHIFT_MASK);\n249:     KeyStroke altshift3 =\n250:       KeyStroke.getKeyStroke(KeyEvent.VK_3,\n251: \t\t\t     KeyEvent.ALT_MASK | KeyEvent.SHIFT_MASK);\n252: \n253:     KeyStroke ctrlup =\n254:       KeyStroke.getKeyStroke(KeyEvent.VK_UP, KeyEvent.CTRL_MASK);\n255:     KeyStroke ctrldown =\n256:       KeyStroke.getKeyStroke(KeyEvent.VK_DOWN, KeyEvent.CTRL_MASK);\n257:     KeyStroke ctrlleft =\n258:       KeyStroke.getKeyStroke(KeyEvent.VK_LEFT, KeyEvent.CTRL_MASK);\n259:     KeyStroke ctrlright =\n260:       KeyStroke.getKeyStroke(KeyEvent.VK_RIGHT, KeyEvent.CTRL_MASK);\n261: \n262:     JMenuItem mi;\n263:     // File Menu\n264:     JMenu file = (JMenu) _menuBar.add(new JMenu(\"File\"));\n265:     file.setMnemonic('F');\n266:     JMenuItem newItem = file.add(_actionNew);\n267:     newItem.setMnemonic('N');\n268:     newItem.setAccelerator(ctrlN);\n269:     JMenuItem openItem = file.add(_actionOpen);\n270:     openItem.setMnemonic('O');\n271:     openItem.setAccelerator(ctrlO);\n272:     JMenuItem openXMIItem = file.add(_actionOpenXMI);\n273:     JMenuItem saveItem = file.add(_actionSave);\n274:     saveItem.setMnemonic('S');\n275:     saveItem.setAccelerator(ctrlS);\n276:     file.add(_actionSaveAs);\n277:     file.add(_actionSaveAsXMI);\n278:     file.addSeparator();\n279:     JMenuItem printItem = file.add(_actionPrint);\n280:     printItem.setMnemonic('P');\n281:     printItem.setAccelerator(ctrlP);\n282:     //file.addSeparator();\n283:     //file.add(_actionProjectInfo);\n284:     file.addSeparator();\n285:     JMenuItem exitItem = file.add(_actionExit);\n286:     exitItem.setMnemonic('x');\n287:     exitItem.setAccelerator(altF4);\n288: \n289:     JMenu edit = (JMenu) _menuBar.add(new JMenu(\"Edit\"));\n290:     edit.setMnemonic('E');\n291: \n292:     JMenu select = new JMenu(\"Select\");\n293:     edit.add(select);\n294:     JMenuItem selectAllItem = select.add(new CmdSelectAll());\n295:     selectAllItem.setAccelerator(ctrlA);\n296:     JMenuItem selectNextItem = select.add(new CmdSelectNext(false));\n297:     //tab\n298:     JMenuItem selectPrevItem = select.add(new CmdSelectNext(true));\n299:     // shift tab\n300:     select.add(new CmdSelectInvert());\n301: \n302:     edit.add(_actionUndo);\n303:     edit.add(_actionRedo);\n304:     edit.addSeparator();\n305:     JMenuItem cutItem = edit.add(_actionCut);\n306:     cutItem.setMnemonic('X');\n307:     cutItem.setAccelerator(ctrlX);\n308:     JMenuItem copyItem = edit.add(_actionCopy);\n309:     copyItem.setMnemonic('C');\n310:     copyItem.setAccelerator(ctrlC);\n311:     JMenuItem pasteItem = edit.add(_actionPaste);\n312:     pasteItem.setMnemonic('V');\n313:     pasteItem.setAccelerator(ctrlV);\n314:     edit.addSeparator();\n315:     edit.add(_actionDelete);\n316:     JMenuItem removeItem = edit.add(_actionRemove);\n317:     removeItem.setMnemonic('R');\n318:     removeItem.setAccelerator(ctrlR);\n319:     JMenuItem emptyItem = edit.add(_actionEmpty);\n320: \n321:     JMenu view = (JMenu) _menuBar.add(new JMenu(\"View\"));\n322:     // maybe should be Navigate instead of view\n323:     view.setMnemonic('V');\n324: \n325:     JMenu nav = (JMenu) view.add(new JMenu(\"Navigate\"));\n326:     JMenuItem downItem = nav.add(_actionNavDown);\n327:     downItem.setAccelerator(ctrldown);\n328:     JMenuItem upItem = nav.add(_actionNavUp);\n329:     upItem.setAccelerator(ctrlup);\n330:     JMenuItem backItem = nav.add(_actionNavBack);\n331:     backItem.setAccelerator(ctrlleft);\n332:     JMenuItem forwItem = nav.add(_actionNavForw);\n333:     forwItem.setAccelerator(ctrlright);\n334: \n335:     view.add(_actionGotoDiagram);\n336:     JMenuItem findItem =  view.add(_actionFind);\n337:     findItem.setAccelerator(F3);\n338:     view.addSeparator();\n339: \n340:     JMenu editTabs = (JMenu) view.add(new JMenu(\"Editor Tabs\"));\n341:     JMenuItem nextEditItem = editTabs.add(_actionNextEditTab);\n342:     nextEditItem.setAccelerator(F6);\n343:     editTabs.addSeparator();\n344: \n345:     JMenuItem tabe1Item = editTabs.add(new ActionGoToEdit(\"As Diagram\"));\n346:     tabe1Item.setAccelerator(altshift1);\n347:     JMenuItem tabe2Item = editTabs.add(new ActionGoToEdit(\"As Table\"));\n348:     tabe2Item.setAccelerator(altshift2);\n349:     JMenuItem tabe3Item = editTabs.add(new ActionGoToEdit(\"As Metrics\"));\n350:     tabe3Item.setAccelerator(altshift3);\n351: \n352:     //view.addSeparator();\n353:     //view.add(_actionAddToFavorites);\n354:     JMenu detailsTabs = (JMenu) view.add(new JMenu(\"Details Tabs\"));\n355:     JMenuItem nextDetailsItem = detailsTabs.add(_actionNextDetailsTab);\n356:     nextDetailsItem.setAccelerator(F5);\n357:     detailsTabs.addSeparator();\n358:     \n359:     JMenuItem tab1Item = detailsTabs.add(new ActionGoToDetails(\"ToDoItem\"));\n360:     tab1Item.setAccelerator(alt1);\n361:     JMenuItem tab2Item = detailsTabs.add(new ActionGoToDetails(\"Properties\"));\n362:     tab2Item.setAccelerator(alt2);\n363:     JMenuItem tab3Item = detailsTabs.add(new ActionGoToDetails(\"Javadocs\"));\n364:     tab3Item.setAccelerator(alt3);\n365:     JMenuItem tab4Item = detailsTabs.add(new ActionGoToDetails(\"Source\"));\n366:     tab4Item.setAccelerator(alt4);\n367:     JMenuItem tab5Item = detailsTabs.add(new ActionGoToDetails(\"Constraints\"));\n368:     tab5Item.setAccelerator(alt5);\n369:     JMenuItem tab6Item = detailsTabs.add(new ActionGoToDetails(\"TaggedValues\"));\n370:     tab6Item.setAccelerator(alt6);\n371:     JMenuItem tab7Item = detailsTabs.add(new ActionGoToDetails(\"Checklist\"));\n372:     tab7Item.setAccelerator(alt7);\n373:     JMenuItem tab8Item = detailsTabs.add(new ActionGoToDetails(\"History\"));\n374:     tab8Item.setAccelerator(alt8);\n375: //     JMenuItem tab9Item = detailsTabs.add(new ActionGoToDetails(\"\"));\n376: //     tab9Item.setAccelerator(alt9);\n377: //     JMenuItem tab0Item = detailsTabs.add(new ActionGoToDetails(\"\"));\n378: //     tab0Item.setAccelerator(alt0);\n379: \n380:     view.addSeparator();\n381:     view.add(new CmdAdjustGrid());\n382:     view.add(new CmdAdjustGuide());\n383:     view.add(new CmdAdjustPageBreaks());\n384: \n385: \n386:     JMenu create = (JMenu) _menuBar.add(new JMenu(\"Create\"));\n387:     create.setMnemonic('C');\n388:     create.add(_actionCreateMultiple);\n389:     create.addSeparator();\n390: \n391:     JMenu createDiagrams = (JMenu) create.add(new JMenu(\"Diagrams\"));\n392:     createDiagrams.add(_actionClassDiagram);\n393:     createDiagrams.add(_actionUseCaseDiagram);\n394:     createDiagrams.add(_actionStateDiagram);\n395:     createDiagrams.add(_actionActivityDiagram);\n396:     createDiagrams.add(_actionCollabortationDiagram);\n397: \n398:     JMenu createModelElements = (JMenu) create.add(new JMenu(\"Model Elements\"));\n399:     //createModelElements.add(_actionModel);\n400:     //createModelElements.add(_actionClass);\n401:     //createModelElements.add(_actionInterface);\n402:     //createModelElements.add(_actionActor);\n403:     //createModelElements.add(_actio