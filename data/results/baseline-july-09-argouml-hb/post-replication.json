ADOW_COLOR_VALUE;\n187:             data[3][i] = (byte) SHADOW_COLOR_ALPHA;\n188:         }\n189:         float[] blur = new float[9];\n190:         for (int i = 0; i < blur.length; ++i) {\n191:             blur[i] = 1 / 12f;\n192:         }\n193:         SHADOW_LOOKUP_OP = new LookupOp(new ByteLookupTable(0, data), null);\n194:         SHADOW_CONVOLVE_OP = new ConvolveOp(new Kernel(3, 3, blur));\n195:     }\n196: \n197:     /**\n198:      * Used for #buildModifierPopUp().\n199:      */\n200:     protected static final int ROOT = 1;\n201: \n202:     /**\n203:      * Used for #buildModifierPopUp().\n204:      */\n205:     protected static final int ABSTRACT = 2;\n206: \n207:     /**\n208:      * Used for #buildModifierPopUp().\n209:      */\n210:     protected static final int LEAF = 4;\n211: \n212:     /**\n213:      * Used for #buildModifierPopUp().\n214:      */\n215:     protected static final int ACTIVE = 8;\n216: \n217:     ////////////////////////////////////////////////////////////////\n218:     // instance variables\n219: \n220:     private Fig bigPort;\n221: \n222:     /**\n223:      * use getNameFig() and setNameFig() to access the Figs.\n224:      * Use getName() and setName() to just change the text.\n225:      */\n226:     private FigText nameFig;\n227: \n228:     /**\n229:      * use getter/setter\n230:      * getStereotypeFig() and setStereoTypeFig() to access the Figs.\n231:      * Use getStereotype() and setStereotype() to change stereotype\n232:      * text.\n233:      */\n234:     private Fig stereotypeFig;\n235: \n236:     /**\n237:      * EnclosedFigs are the Figs that are enclosed by this figure. Say that\n238:      * it is a Package then these are the Classes, Interfaces, Packages etc\n239:      * that are on this figure. This is not the same as the figures in the\n240:      * FigGroup that this FigNodeModelElement \"is\", since these are the\n241:      * figures that make up this high-level primitive figure.\n242:      */\n243:     private Vector enclosedFigs = new Vector();\n244: \n245:     /**\n246:      * The figure enclosing this figure.\n247:      */\n248:     private Fig encloser = null;\n249: \n250:     private boolean readyToEdit = true;\n251:     private boolean suppressCalcBounds = false;\n252: \n253:     private int shadowSize =\n254:         Configuration.getInteger(Notation.KEY_DEFAULT_SHADOW_WIDTH, 1);\n255: \n256:     private ItemUID itemUid;\n257: \n258:     /**\n259:      * Set the removeFromDiagram to false if this node may not\n260:      * be removed from the diagram.\n261:      */\n262:     private boolean removeFromDiagram = true;\n263: \n264:     /**\n265:      * Set this to force a repaint of the shadow.\n266:      * Normally repainting only happens\n267:      * when the outside boundaries change\n268:      * (for performance reasons (?)).\n269:      * In some cases this does not\n270:      * suffice, and you can set this attribute to force the update.\n271:      */\n272:     private boolean forceRepaint;\n273: \n274:     /**\n275:      * Flag that indicates if the full namespace path should be shown\n276:      * in front of the name.\n277:      */\n278:     private boolean pathVisible = false;\n279: \n280:     /**\n281:      * The main constructor.\n282:      *\n283:      */\n284:     public FigNodeModelElement() {\n285:         // this rectangle marks the whole modelelement figure; everything\n286:         // is inside it:\n287:         bigPort = new FigRect(10, 10, 0, 0, Color.cyan, Color.cyan);\n288: \n289:         nameFig = new FigSingleLineText(10, 10, 90, 21, true);\n290:         nameFig.setLineWidth(1);\n291:         nameFig.setFilled(true);\n292:         nameFig.setText(placeString());\n293:         nameFig.setBotMargin(7); // make space for the clarifier\n294:         nameFig.setRightMargin(4); // margin between text and border\n295:         nameFig.setLeftMargin(4); \n296: \n297:         stereotypeFig = new FigStereotypesCompartment(10, 10, 90, 15);\n298: \n299:         readyToEdit = false;\n300:         ArgoEventPump.addListener(ArgoEventTypes.ANY_NOTATION_EVENT, this);\n301:         currentNotationName = Notation.getConfigueredNotation();\n302:     }\n303: \n304:     /**\n305:      * Partially construct a new FigNode.  This method creates the\n306:      * name element that holds the name of the model element and adds\n307:      * itself as a listener.\n308:      *\n309:      * @param gm ignored\n310:      * @param node the owning UML element\n311:      */\n312:     public FigNodeModelElement(GraphModel gm, Object node) {\n313:         this();\n314:         setOwner(node);\n315:         nameFig.setText(placeString());\n316:         readyToEdit = false;\n317: \n318:         //ArgoEventPump.addListener(ArgoEvent.ANY_NOTATION_EVENT, this);\n319:     }\n320: \n321:     /**\n322:      * @see java.lang.Object#finalize()\n323:      */\n324:     protected void finalize() {\n325:         ArgoEventPump.removeListener(ArgoEventTypes.ANY_NOTATION_EVENT, this);\n326:     }\n327: \n328:     /**\n329:      * After the base clone method has been called determine which child\n330:      * figs of the clone represent the name, stereotype and port. <p>\n331:      *\n332:      * The clone function is used by Copy/Paste operations.\n333:      *\n334:      * @see java.lang.Object#clone()\n335:      */\n336:     public Object clone() {\n337:         FigNodeModelElement clone = (FigNodeModelElement) super.clone();\n338:         Iterator thisIter = this.getFigs().iterator();\n339:         Iterator cloneIter = clone.getFigs().iterator();\n340:         while (thisIter.hasNext()) {\n341:             Fig thisFig = (Fig) thisIter.next();\n342:             Fig cloneFig = (Fig) cloneIter.next();\n343:             if (thisFig == getBigPort()) {\n344:                 clone.setBigPort(cloneFig);\n345:             }\n346:             if (thisFig == nameFig) {\n347:                 clone.nameFig = (FigText) thisFig;\n348:             }\n349:             if (thisFig == stereotypeFig) {\n350:                 clone.stereotypeFig = (Fig) thisFig;\n351:             }\n352:         }\n353:         return clone;\n354:     }\n355: // TODO: _enclosedFigs, _encloser and _eventSenders may also need to be cloned\n356: \n357: \n358: \n359:     /**\n360:      * Default Reply text to be shown while placing node in diagram.\n361:      * Overrule this when the text is not \"new [UMLClassName]\".\n362:      *\n363:      * @return the text to be shown while placing node in diagram\n364:      */\n365:     public String placeString() {\n366:         if (Model.getFacade().isAModelElement(getOwner())) {\n367:             String placeString = Model.getFacade().getName(getOwner());\n368:             if (placeString == null) {\n369:                 placeString =\n370:                     \"new \" + Model.getFacade().getUMLClassName(getOwner());\n371:             }\n372:             return placeString;\n373:         }\n374:         return \"\";\n375:     }\n376: \n377:     ////////////////////////////////////////////////////////////////\n378:     // accessors\n379: \n380:     /**\n381:      * @param id UID\n382:      */\n383:     public void setItemUID(ItemUID id) {\n384:         itemUid = id;\n385:     }\n386: \n387:     /**\n388:      * @return UID\n389:      */\n390:     public ItemUID getItemUID() {\n391:         return itemUid;\n392:     }\n393: \n394:     /**\n395:      * Get the Fig that displays the model element name.\n396:      *\n397:      * @return the name Fig\n398:      */\n399:     public FigText getNameFig() {\n400:         return nameFig;\n401:     }\n402: \n403:     /**\n404:      * Set the Fig that displays the model element name.\n405:      *\n406:      * @param fig the name Fig\n407:      */\n408:     protected void setNameFig(FigText fig) {\n409:         nameFig = fig;\n410:     }\n411: \n412:     /**\n413:      * Get the name of the model element this Fig represents.\n414:      *\n415:      * @return the name of the model element\n416:      */\n417:     public String getName() {\n418:         return nameFig.getText();\n419:     }\n420: \n421:     /**\n422:      * Change the name of the model element this Fig represents.\n423:      *\n424:      * @param n the name of the model element\n425:      */\n426:     public void setName(String n) {\n427:         nameFig.setText(n);\n428:     }\n429: \n430:     /**\n431:      * @see org.tigris.gef.ui.PopupGenerator#getPopUpActions(java.awt.event.MouseEvent)\n432:      */\n433:     public Vector getPopUpActions(MouseEvent me) {\n434:         Vector popUpActions = super.getPopUpActions(me);\n435: \n436:         // popupAddOffset should be equal to the number of items added here:\n437:         popUpActions.addElement(new JSeparator());\n438:         popupAddOffset = 1;\n439:         if (removeFromDiagram) {\n440:             popUpActions.addElement(\n441:                     ProjectBrowser.getInstance().getRemoveFromDiagramAction());\n442:             popupAddOffset++;\n443:         }\n444:         popUpActions.addElement(new ActionDeleteModelElements());\n445:         popupAddOffset++;\n446: \n447:         /* Check if multiple items are selected: */\n448:         if (TargetManager.getInstance().getTargets().size() == 1) {\n449:             ToDoList list = Designer.theDesigner().getToDoList();\n450:             Vector items =\n451:                     (Vector) list.elementsForOffender(getOwner()).clone();\n452:             if (items != null && items.size() > 0) {\n453:                 ArgoJMenu critiques = new ArgoJMenu(\"menu.popup.critiques\");\n454:                 ToDoItem itemUnderMouse = hitClarifier(me.getX(), me.getY());\n455:                 if (itemUnderMouse != null) {\n456:                     critiques.add(new ActionGoToCritique(itemUnderMouse));\n457:                     critiques.addSeparator();\n458:                 }\n459:                 int size = items.size();\n460:                 for (int i = 0; i < size; i++) {\n461:                     ToDoItem item = (ToDoItem) items.elementAt(i);\n462:                     if (item != itemUnderMouse) {\n463:                         critiques.add(new ActionGoToCritique(item));\n464:                     }\n465:                 }\n466:                 popUpActions.insertElementAt(new JSeparator(), 0);\n467:                 popUpActions.insertElementAt(critiques, 0);\n468:             }\n469: \n470:             // Add stereotypes submenu\n471:             Action[] stereoActions =\n472:                 StereotypeUtility.getApplyStereotypeActions(getOwner());\n473:             if (stereoActions != null) {\n474:                 popUpActions.insertElementAt(new JSeparator(), 0);\n475:                 ArgoJMenu stereotypes = new ArgoJMenu(\n476:                         \"menu.popup.apply-stereotypes\");\n477:                 for (int i = 0; i < stereoActions.length; ++i) {\n478:                     stereotypes.addCheckItem(stereoActions[i]);\n479:                 }\n480:                 popUpActions.insertElementAt(stereotypes, 0);\n481:             }\n482:         }\n483: \n484:         return popUpActions;\n485:     }\n486: \n487:     /**\n488:      * Helper method for buildModelList.\n489:      * <p>\n490:      * Adds those elements from source that do not have the same path as any\n491:      * path in paths to elements, and its path to paths. Thus elements will\n492:      * never contain two objects with the same path, unless they are added by\n493:      * other means.\n494:      */\n495:     private static void addAllUniqueModelElementsFrom(Set elements, Set paths,\n496:             Collection source) {\n497:         Iterator it2 = source.iterator();\n498: \n499:         while (it2.hasNext()) {\n500:             Object obj = it2.next();\n501:             Object path = Model.getModelManagementHelper().getPath(obj);\n502:             if (!paths.contains(path)) {\n503:                 paths.add(path);\n504:                 elements.add(obj);\n505:             }\n506:         }\n507:     }\n508: \n509:     /**\n510:      * @return the pop-up menu item for Visibility\n511:      */\n512:     protected Object buildVisibilityPopUp() {\n513:         ArgoJMenu visibilityMenu = new ArgoJMenu(\"menu.popup.visibility\");\n514: \n515:         visibilityMenu.addRadioItem(new ActionVisibilityPublic(getOwner()));\n516:         visibilityMenu.addRadioItem(new ActionVisibilityPrivate(getOwner()));\n517:         visibilityMenu.addRadioItem(new ActionVisibilityProtected(getOwner()));\n518:         visibilityMenu.addRadioItem(new ActionVisibilityPackage(getOwner()));\n519:         \n520:         return visibilityMenu;\n521:     }\n522: \n523:     /**\n524:      * Build a pop-up menu item for the various modifiers.<p>\n525:      *\n526:      * This function is designed to be easily extendable with new items.\n527:      *\n528:      * @param items bitwise OR of the items: ROOT, ABSTRACT, LEAF, ACTIVE.\n529:      * @return the menu item\n530:      */\n531:     protected Object buildModifierPopUp(int items) {\n532:         ArgoJMenu modifierMenu = new ArgoJMenu(\"menu.popup.modifiers\");\n533: \n534:         if ((items & ABSTRACT) > 0) {\n535:             modifierMenu.addCheckItem(new ActionModifierAbstract(getOwner()));\n536: \t}\n537:         if ((items & LEAF) > 0) {\n538:             modifierMenu.addCheckItem(new ActionModifierLeaf(getOwner()));\n539: \t}\n540:         if ((items & ROOT) > 0) {\n541:             modifierMenu.addCheckItem(new ActionModifierRoot(getOwner()));\n542: \t}\n543:         if ((items & ACTIVE) > 0) {\n544:             modifierMenu.addCheckItem(new ActionModifierActive(getOwner()));\n545: \t}\n546: \n547:         return modifierMenu;\n548:     }\n549: \n550:     /**\n551:      * @see org.tigris.gef.presentation.Fig#getEnclosingFig()\n552:      */\n553:     public Fig getEnclosingFig() {\n554:         return encloser;\n555:     }\n556: \n557:     /**\n558:      * Updates the modelelement container if the fig is moved in or\n559:      * out another fig. If this fig doesn't have an enclosing fig\n560:      * anymore, the namespace of the diagram will be the owning\n561:      * modelelement. If this fig is moved inside another\n562:      * FigNodeModelElement the owner of that fignodemodelelement will\n563:      * be the owning modelelement.\n564:      * @see Fig#setEnclosingFig(Fig)\n565:      */\n566:     public void setEnclosingFig(Fig newEncloser) {\n567: \tFig oldEncloser = encloser;\n568: \tsuper.setEnclosingFig(newEncloser);\n569: \tif (newEncloser != oldEncloser) {\n570: \t    Object owningModelelement = null;\n571: \t    if (newEncloser == null && isVisible()) {\n572: \t        // If we are not visible most likely we're being deleted.\n573: \n574: \t\t// moved outside another fig onto the diagram canvas\n575: \t\tProject currentProject =\n576: \t\t    ProjectManager.getManager().getCurrentProject();\n577:                 ArgoDiagram diagram = currentProject.getActiveDiagram();\n578:                 // TODO: Who said this was about the active diagram?\n579:                 if (diagram instanceof UMLDiagram\n580: \t\t\t&& ((UMLDiagram) diagram).getNamespace() != null) {\n581:                     owningModelelement = ((UMLDiagram) diagram).getNamespace();\n582:                 } else {\n583:                     owningModelelement = currentProject.getRoot();\n584:                 }\n585: \t    } else if (newEncloser != null\n586:                     && Model.getFacade().isABase(newEncloser.getOwner())) {\n587:                 owningModelelement = newEncloser.getOwner();\n588:             }\n589:             if (owningModelelement != null\n590: \t\t&& getOwner() != null\n591: \t\t&& (!Model.getModelManagementHelper()\n592: \t\t    .isCyclicOwnership(owningModelelement, getOwner()))\n593: \t\t&& ((Model.getCoreHelper()\n594: \t\t\t.isValidNamespace(getOwner(),\n595: \t\t\t\t\t  owningModelelement)))) {\n596:                 Model.getCoreHelper().setModelElementContainer(getOwner(),\n597: \t\t\t\t\t\t     owningModelelement);\n598:                 /* TODO: move the associations to the correct owner (namespace)\n599:                  * i.e. issue 2151*/\n600:             }\n601:         }\n602: \tif (newEncloser != encloser) {\n603: \t    if (encloser instanceof FigNodeModelElement) {\n604: \t\t((FigNodeModelElement) encloser).removeEnclosedFig(this);\n605:             }\n606: \t    if (newEncloser instanceof FigNodeModelElement) {\n607: \t\t((FigNodeModelElement) newEncloser).addEnclosedFig(this);\n608:             }\n609: \t}\n610:         encloser = newEncloser;\n611:     }\n612: \n613:     /**\n614:      * @param fig The fig to be added\n615:      */\n616:     public void addEnclosedFig(Fig fig) {\n617:         enclosedFigs.add(fig);\n618:     }\n619: \n620:     /**\n621:      * @param fig The Fig to be removed\n622:      */\n623:     public void removeEnclosedFig(Fig fig) {\n624:         enclosedFigs.remove(fig);\n625:     }\n626: \n627:     /**\n628:      * @see org.tigris.gef.presentation.Fig#getEnclosedFigs()\n629:      */\n630:     public Vector getEnclosedFigs() {\n631:         return enclosedFigs;\n632:     }\n633: \n634:     /**\n635:      * Update the order of this fig and the order of the\n636:      * figs that are inside of this fig.\n637:      *\n638:      * @param figures in the new order\n639:      */\n640:     public void elementOrdering(Vector figures) {\n641:         int size = figures.size();\n642:         getLayer().bringToFront(this);\n643:         if (size > 0) {\n644:             for (int i = 0; i < size; i++) {\n645:                 Object o = figures.elementAt(i);\n646:                 if (o instanceof FigNodeModelElement\n647:                     && o != getEnclosingFig()) {\n648:                     FigNodeModelElement fignode = (FigNodeModelElement) o;\n649:                     Vector enclosed = fignode.getEnclosedFigs();\n650:                     fignode.elementOrdering(enclosed);\n651:                 }\n652:             }\n653:         }\n654:     }\n655: \n656:     /**\n657:      * @see org.tigris.gef.presentation.Fig#makeSelection()\n658:      */\n659:     public Selection makeSelection() {\n660:         return new SelectionNodeClarifiers(this);\n661:     }\n662: \n663:     /**\n664:      * Overridden to paint shadows. This method supports painting shadows\n665:      * for any FigNodeModelElement. Any Figs that are nested within the\n666:      * FigNodeModelElement will be shadowed.<p>\n667:      *\n668:      * TODO: If g is not a Graphics2D shadows cannot be painted. This is\n669:      * a problem when saving the diagram as SVG.\n670:      *\n671:      * @param g is a Graphics that we paint this object on.\n672:      */\n673:     public void paint(Graphics g) {\n674:         if (shadowSize > 0\n675: \t        && g instanceof Graphics2D) {\n676:             int width = getWidth();\n677:             int height = getHeight();\n678:             int x = getX();\n679:             int y = getY();\n680: \n681:             /* Only create a new shadow image if figure size has changed.\n682:              * Which does not catch all cases:\n683:              * consider show/hide toggle of a stereotype on a package:\n684:              * in this case the total size remains, but the notch\n685:              * at the corner increases/decreases.\n686:              * Hence also check the \"forceRepaint\" attribute.\n687:              */\n688:             if (width != cachedWidth\n689:                     || height != cachedHeight\n690:                     || forceRepaint) {\n691:                 forceRepaint = false;\n692: \n693:                 cachedWidth = width;\n694:                 cachedHeight = height;\n695: \n696:                 BufferedImage img =\n697: \t\t    new BufferedImage(width + 100,\n698: \t\t\t\t      height + 100,\n699: \t\t\t\t      BufferedImage.TYPE_INT_ARGB);\n700: \n701:                 // Paint figure onto offscreen image\n702:                 Graphics ig = img.getGraphics();\n703:                 ig.translate(50 - x, 50 - y);\n704:                 super.paint(ig);\n705: \n706:                 // Apply two filters to the image:\n707:                 // 1. Apply LookupOp which converts all pixel data in the\n708:                 //    figure to the same shadow color.\n709:                 // 2. Apply ConvolveOp which creates blurred effect around\n710:                 //    the edges of the shadow.\n711:                 shadowImage =\n712: \t\t    SHADOW_CONVOLVE_OP.filter(\n713: \t\t\t    SHADOW_LOOKUP_OP.filter(img, null), null);\n714:             }\n715: \n716:             // Paint shadow image onto canvas\n717:             Graphics2D g2d = (Graphics2D) g;\n718:             g2d.drawImage(\n719:                 shadowImage,\n720:                 null,\n721:                 x + shadowSize - 50,\n722:                 y + shadowSize - 50);\n723:         }\n724: \n725:         // Paint figure on top of shadow\n726:         super.paint(g);\n727:     }\n728: \n729:     /**\n730:      * Displays visual indications of pending ToDoItems.\n731:      * Please note that the list of advices (ToDoList) is not the same\n732:      * as the list of element known by the FigNode (_figs). Therefore,\n733:      * it is necessary to check if the graphic item exists before drawing\n734:      * on it. See ClAttributeCompartment for an example.\n735:      * @param g the graphics device\n736:      * @see org.argouml.uml.cognitive.critics.ClAttributeCompartment\n737:      */\n738:     public void paintClarifiers(Graphics g) {\n739:         int iconX = getX();\n740:         int iconY = getY() - 10;\n741:         ToDoList list = Designer.theDesigner().getToDoList();\n742:         Vector items = list.elementsForOffender(getOwner());\n743:         int size = items.size();\n744:         for (int i = 0; i < size; i++) {\n745:             ToDoItem item = (ToDoItem) items.elementAt(i);\n746:             Icon icon = item.getClarifier();\n747:             if (icon instanceof Clarifier) {\n748:                 ((Clarifier) icon).setFig(this);\n749:                 ((Clarifier) icon).setToDoItem(item);\n750:             }\n751:             if (icon != null) {\n752:                 icon.paintIcon(null, g, iconX, iconY);\n753:                 iconX += icon.getIconWidth();\n754:             }\n755:         }\n756:         items = list.elementsForOffender(this);\n757:         size = items.size();\n758:         for (int i = 0; i < size; i++) {\n759:             ToDoItem item = (ToDoItem) items.elementAt(i);\n760:             Icon icon = item.getClarifier();\n761:             if (icon instanceof Clarifier) {\n762:                 ((Clarifier) icon).setFig(this);\n763:                 ((Clarifier) icon).setToDoItem(item);\n764:             }\n765:             if (icon != null) {\n766:                 icon.paintIcon(null, g, iconX, iconY);\n767:                 iconX += icon.getIconWidth();\n768:             }\n769:         }\n770:     }\n771: \n772:     /**\n773:      * @param x the x of the hit\n774:      * @param y the y of the hit\n775:      * @return the todo item of which the clarifier has been hit\n776:      */\n777:     public ToDoItem hitClarifier(int x, int y) {\n778:         int iconX = getX();\n779:         ToDoList list = Designer.theDesigner().getToDoList();\n780:         Vector items = list.elementsForOffender(getOwner());\n781:         int size = items.size();\n782:         for (int i = 0; i < size; i++) {\n783:             ToDoItem item = (ToDoItem) items.elementAt(i);\n784:             Icon icon = item.getClarifier();\n785:             int width = icon.getIconWidth();\n786:             if (y >= getY() - 15\n787:                     && y <= getY() + 10\n788:                     && x >= iconX\n789:                     && x <= iconX + width) {\n790:                 return item;\n791:             }\n792:             iconX += width;\n793:         }\n794:         for (int i = 0; i < size; i++) {\n795:             ToDoItem item = (ToDoItem) items.elementAt(i);\n796:             Icon icon = item.getClarifier();\n797:             if (icon instanceof Clarifier) {\n798:                 ((Clarifier) icon).setFig(this);\n799:                 ((Clarifier) icon).setToDoItem(item);\n800:                 if (((Clarifier) icon).hit(x, y)) {\n801:                     return item;\n802:                 }\n803:             }\n804:         }\n805:         items = list.elementsForOffender(this);\n806:         size = items.size();\n807:         for (int i = 0; i < size; i++) {\n808:             ToDoItem item = (ToDoItem) items.elementAt(i);\n809:             Icon icon = item.getClarifier();\n810:             int width = icon.getIconWidth();\n811:             if (y >= getY() - 15\n812:                     && y <= getY() + 10\n813:                     && x >= iconX\n814:                     && x <= iconX + width) {\n815:                 return item;\n816:             }\n817:             iconX += width;\n818:         }\n819:         for (int i = 0; i < size; i++) {\n820:             ToDoItem item = (ToDoItem) items.elementAt(i);\n821:             Icon icon = item.getClarifier();\n822:             if (icon instanceof Clarifier) {\n823:                 ((Clarifier) icon).setFig(this);\n824:                 ((Clarifier) icon).setToDoItem(item);\n825:                 if (((Clarifier) icon).hit(x, y)) {\n826:                     return item;\n827:                 }\n828:             }\n829:         }\n830:         return null;\n831:     }\n832: \n833:     /**\n834:      * @see org.tigris.gef.presentation.Fig#getTipString(java.awt.event.MouseEvent)\n835:      */\n836:     public String getTipString(MouseEvent me) {\n837:         ToDoItem item = hitClarifier(me.getX(), me.getY());\n838:         String tip = \"\";\n839:         if (item != null\n840:             && Globals.curEditor().getSelectionManager().containsFig(this)) {\n841:             tip = item.getHeadline() + \" \";\n842:         } else if (getOwner() != null) {\n843:             tip = Model.getFacade().getTipString(getOwner());\n844:         } else {\n845:             tip = toString();\n846:         }\n847:         if (tip != null && tip.length() > 0 && !tip.endsWith(\" \")) {\n848:             tip += \" \";\n849:         }\n850:         return tip;\n851:     }\n852: \n853:     ////////////////////////////////////////////////////////////////\n854:     // event handlers\n855: \n856:     /**\n857:      * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n858:      */\n859:     public void vetoableChange(PropertyChangeEvent pce) {\n860:         LOG.debug(\"in vetoableChange\");\n861:         Object src = pce.getSource();\n862:         if (src == getOwner()) {\n863:             DelayedChangeNotify delayedNotify =\n864:                 new DelayedChangeNotify(this, pce);\n865:             SwingUtilities.invokeLater(delayedNotify);\n866:         } else {\n867:             LOG.debug(\"FigNodeModelElement got vetoableChange\"\n868: \t\t      + \" from non-owner:\"\n869: \t\t      + src);\n870:         }\n871:     }\n872: \n873:     /**\n874:      * @see org.argouml.kernel.DelayedVChangeListener#delayedVetoableChange(java.beans.PropertyChangeEvent)\n875:      */\n876:     public void delayedVetoableChange(PropertyChangeEvent pce) {\n877:         LOG.debug(\"in delayedVetoableChange\");\n878:         // update any text, colors, fonts, etc.\n879:         renderingChanged();\n880:         endTrans();\n881:     }\n882: \n883:     /**\n884:      * set some new bounds.\n885:      */\n886:     protected void updateBounds() {\n887:         if (!checkSize) {\n888:             return;\n889:         }\n890:         Rectangle bbox = getBounds();\n891:         Dimension minSize = getMinimumSize();\n892:         bbox.width = Math.max(bbox.width, minSize.width);\n893:         bbox.height = Math.max(bbox.height, minSize.height);\n894:         setBounds(bbox.x, bbox.y, bbox.width, bbox.height);\n895:     }\n896: \n897:     /**\n898:      * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n899:      */\n900:     public void propertyChange(PropertyChangeEvent pve) {\n901:         Object src = pve.getSource();\n902:         String pName = pve.getPropertyName();\n903:         if (pve instanceof DeleteInstanceEvent\n904:                 && pve.getSource() == getOwner()) {\n905:             ProjectManager.getManager().getCurrentProject()\n906:                 .moveToTrash(getOwner());\n907:         } else if (pName.equals(\"editing\")\n908:                 && Boolean.FALSE.equals(pve.getNewValue())) {\n909: \t    LOG.debug(\"finished editing\");\n910:             try {\n911:                 //parse the text that was edited\n912:                 textEdited((FigText) src);\n913:                 // resize the FigNode to accomodate the new text\n914:                 Rectangle bbox = getBounds();\n915:                 Dimension minSize = getMinimumSize();\n916:                 bbox.width = Math.max(bbox.width, minSize.width);\n917:                 bbox.height = Math.max(bbox.height, minSize.height);\n918:                 setBounds(bbox.x, bbox.y, bbox.width, bbox.height);\n919:                 endTrans();\n920:             } catch (PropertyVetoException ex) {\n921:                 LOG.error(\"could not parse the text entered. \"\n922: \t\t\t  + \"PropertyVetoException\",\n923: \t\t\t  ex);\n924:             }\n925:         } else if (pName.equals(\"editing\")\n926:                         && Boolean.TRUE.equals(pve.getNewValue())) {\n927:             textEditStarted((FigText) src);\n928:         } else {\n929:             super.propertyChange(pve);\n930:         }\n931:         if (Model.getFacade().isABase(src)) {\n932:             /* If the source of the event is an UML object,\n933:              * e.g. the owner of this Fig (but not always only the owner\n934:              * is shown, e.g. for a class, also its attributes are shown),\n935:              * then the UML model has been changed.\n936:              */\n937:             modelChanged(pve);\n938:         }\n939:     }\n940: \n941:     /**\n942:      * This method is called when the user doubleclicked on the text field,\n943:      * and starts editing. Subclasses should overrule this field to e.g.\n944:      * supply help to the user about the used format. <p>\n945:      *\n946:      * It is also possible to alter the text to be edited\n947:      * already here, e.g. by adding the stereotype in front of the name,\n948:      * by calling \n949:      * <code>notationProviderName.putValue(\"fullyHandleStereotypes\", \n950:      * true);</code>, but that seems not user-friendly. See issue 3838.\n951:      *\n952:      * @param ft the FigText that will be edited and contains the start-text\n953:      */\n954:     protected void textEditStarted(FigText ft) {\n955:         if (ft == getNameFig()) {\n956:             showHelp(notationProviderName.getParsingHelp());\n957:             ft.setText(notationProviderName.toString());\n958:         }\n959:     }\n960: \n961:     /**\n962:      * Utility function to localize the given string with help text,\n963:      * and show it in the status bar of the ArgoUML window.\n964:      * This function is used in favour of the inline call\n965:      * to enable later improvements; e.g. it would be possible to\n966:      * show a help-balloon. TODO: Work this out.\n967:      * One matter to possibly improve: show multiple lines.\n968:      *\n969:      * @param s the given string to be localized and shown\n970:      */\n971:     protected void showHelp(String s) {\n972:         ProjectBrowser.getInstance().getStatusBar().showStatus(\n973:                 Translator.localize(s));\n974:     }\n975: \n976:     /**\n977:      * This method is called after the user finishes editing a text\n978:      * field that is in the FigNodeModelElement.  Determine which\n979:      * field and update the model.  This class handles the name,\n980:      * and the stereotype,\n981:      * subclasses should override to handle other text elements.\n982:      *\n983:      * @param ft the FigText that has been edited and contains the new text\n984:      * @throws PropertyVetoException thrown when new text represents\n985:      * an unacceptable value\n986:      */\n987:     protected void textEdited(FigText ft) throws PropertyVetoException {\n988:         if (ft == nameFig) {\n989:             if (getOwner() == null) {\n990:                 return;\n991:             }\n992:             ft.setText(notationProviderName.parse(ft.getText()));\n993:         }\n994:     }\n995: \n996:     ////////////////////////////////////////////////////////////////\n997:     // event handlers - MouseListener implementation\n998: \n999:     /**\n1000:      * If the user double clicks on any part of this FigNode, pass it\n1001:      * down to one of the internal Figs. This allows the user to\n1002:      * initiate direct text editing.\n1003:      *\n1004:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n1005:      */\n1006:     public void mouseClicked(MouseEvent me) {\n1007:         if (!readyToEdit) {\n1008:             if (Model.getFacade().isAModelElement(getOwner())) {\n1009:                 Model.getCoreHelper().setName(getOwner(), \"\");\n1010:                 readyToEdit = true;\n1011:             } else {\n1012:                 LOG.debug(\"not ready to edit name\");\n1013:                 return;\n1014:             }\n1015:         }\n1016:         if (me.isConsumed()) {\n1017:             return;\n1018:         }\n1019:         if (me.getClickCount() >= 2 &&\n1020:                 !(me.isPopupTrigger() || me.getModifiers() == InputEvent.BUTTON3_MASK)) {\n1021:             if (getOwner() == null) {\n1022:                 return;\n1023:             }\n1024:             Rectangle r = new Rectangle(me.getX() - 2, me.getY() - 2, 4, 4);\n1025:             Fig f = hitFig(r);\n1026:             if (f instanceof MouseListener && f.isVisible()) {\n1027:                 ((MouseListener) f).mouseClicked(me);\n1028:             } else if (f instanceof FigGroup && f.isVisible()) {\n1029:                 //this enables direct text editing for sub figs of a\n1030:                 //FigGroup object:\n1031:                 Fig f2 = ((FigGroup) f).hitFig(r);\n1032:                 if (f2 instanceof MouseListener) {\n1033:                     ((MouseListener) f2).mouseClicked(me);\n1034:                 } else {\n1035:                     createFeatureIn((FigGroup) f, me);\n1036:                 }\n1037:             }\n1038:         }\n1039:     }\n1040: \n1041:     /**\n1042:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n1043:      */\n1044:     public void keyPressed(KeyEvent ke) {\n1045:         if (!readyToEdit) {\n1046:             if (Model.getFacade().isAModelElement(getOwner())) {\n1047:                 Model.getCoreHelper().setName(getOwner(), \"\");\n1048:                 readyToEdit = true;\n1049:             } else {\n1050:                 LOG.debug(\"not ready to edit name\");\n1051:                 return;\n1052:             }\n1053:         }\n1054:         if (ke.isConsumed() || getOwner() == null) {\n1055:             return;\n1056:         }\n1057:         nameFig.keyPressed(ke);\n1058:     }\n1059: \n1060:     /**\n1061:      * @see java.awt.event.KeyListener#keyReleased(java.awt.event.KeyEvent)\n1062:      */\n1063:     public void keyReleased(KeyEvent ke) {\n1064:         if (!readyToEdit) {\n1065:             if (Model.getFacade().isAModelElement(getOwner())) {\n1066:                 Model.getCoreHelper().setName(getOwner(), \"\");\n1067:                 readyToEdit = true;\n1068:             } else {\n1069:                 LOG.debug(\"not ready to edit name\");\n1070:                 return;\n1071:             }\n1072:         }\n1073:         if (ke.isConsumed() || getOwner() == null) {\n1074:             return;\n1075:         }\n1076:         nameFig.keyReleased(ke);\n1077:     }\n1078: \n1079:     /**\n1080:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n1081:      */\n1082:     public void keyTyped(KeyEvent ke) {\n1083:         if (!readyToEdit) {\n1084:             if (Model.getFacade().isAModelElement(getOwner())) {\n1085:                 Model.getCoreHelper().setName(getOwner(), \"\");\n1086:                 readyToEdit = true;\n1087:             } else {\n1088:                 LOG.debug(\"not ready to edit name\");\n1089:                 return;\n1090:             }\n1091:         }\n1092:         if (ke.isConsumed() || getOwner() == null) {\n1093:             return;\n1094:         }\n1095:         nameFig.keyTyped(ke);\n1096:     }\n1097: \n1098:     ////////////////////////////////////////////////////////////////\n1099:     // internal methods\n1100: \n1101:     /**\n1102:      * This is called after any part of the UML MModelElement has\n1103:      * changed. This method automatically updates the name FigText.\n1104:      * Subclasses should override and update other parts.\n1105:      *\n1106:      * @param mee the ModelElementEvent that caused the change\n1107:      */\n1108:     protected void modelChanged(PropertyChangeEvent mee) {\n1109:         if (mee == null) {\n1110:             throw new IllegalArgumentException(\"event may never be null \"\n1111:                            + \"with modelchanged\");\n1112:         }\n1113:         if (getOwner() == null\n1114:                 || Model.getUmlFactory().isRemoved(getOwner())) {\n1115:             return;\n1116:         }\n1117:         if (\"name\".equals(mee.getPropertyName())\n1118:                 && mee.getSource() == getOwner()) {\n1119:             updateNameText();\n1120:             damage();\n1121:         }\n1122:         if ((mee.getSource() == getOwner()\n1123:                 && mee.getPropertyName().equals(\"stereotype\"))) {\n1124:             if (mee.getOldValue() != null) {\n1125:                 Model.getPump().removeModelEventListener(this,\n1126:                         mee.getOldValue(), \"name\");\n1127:             }\n1128:             if (mee.getNewValue() != null) {\n1129:                 Model.getPump().addModelEventListener(this,\n1130:                         mee.getNewValue(), \"name\");\n1131:             }\n1132:             updateStereotypeText();\n1133:             damage();\n1134:         }\n1135:     }\n1136: \n1137: \n1138:     /**\n1139:      * Create a new \"feature\" in the owner fig.\n1140:      *\n1141:      * must be overridden to make sense\n1142:      * (I didn't want to make it abstract because it might not be required)\n1143:      *\n1144:      * @param fg The fig group to which this applies\n1145:      * @param me The input event that triggered us. In the current\n1146:      *            implementation a mouse double click.\n1147:      */\n1148:     protected void createFeatureIn(FigGroup fg, InputEvent me) {\n1149: \n1150:     }\n1151: \n1152:     /**\n1153:      * @param o the given object\n1154:      * @return true if one of my figs has the given object as owner\n1155:      */\n1156:     protected boolean isPartlyOwner(Object o) {\n1157:         if (o == null || o == getOwner()) {\n1158:             return true;\n1159:         }\n1160:         Iterator it = getFigs().iterator();\n1161:         while (it.hasNext()) {\n1162:             Fig fig = (Fig) it.next();\n1163:             if (isPartlyOwner(fig, o)) {\n1164:                 return true;\n1165:             }\n1166:         }\n1167:         return false;\n1168:     }\n1169: \n1170:     /**\n1171:      * @param fig the given fig (may be a group)\n1172:      * @param o the given object\n1173:      * @return true if one of the given figs has the given object as owner\n1174:      */\n1175:     protected boolean isPartlyOwner(Fig fig, Object o) {\n1176:         if (o == null) {\n1177:             return false;\n1178:         }\n1179:         if (o == fig.getOwner()) {\n1180:             return true;\n1181:         }\n1182:         if (fig instanceof FigGroup) {\n1183:             Iterator it = ((FigGroup) fig).getFigs().iterator();\n1184:             while (it.hasNext()) {\n1185:                 Fig fig2 = (Fig) it.next();\n1186:                 if (isPartlyOwner(fig2, o)) {\n1187:                     return true;\n1188:                 }\n1189:             }\n1190:         }\n1191:         return false;\n1192:     }\n1193: \n1194:     /**\n1195:      * @see org.tigris.gef.presentation.Fig#deleteFromModel()\n1196:      */\n1197:     public void deleteFromModel() {\n1198:         Object own = getOwner();\n1199:         if (own != null) {\n1200:             ProjectManager.getManager().getCurrentProject().moveToTrash(own);\n1201:         }\n1202:         Iterator it = getFigs().iterator();\n1203:         while (it.hasNext()) {\n1204:             ((Fig) it.next()).deleteFromModel();\n1205:         }\n1206:         super.deleteFromModel();\n1207:     }\n1208: \n1209:     /**\n1210:      * @see org.tigris.gef.presentation.Fig#setOwner(java.lang.Object)\n1211:      */\n1212:     public void setOwner(Object own) {\n1213:         updateListeners(own);\n1214:         super.setOwner(own);\n1215:         initNotationProviders(own);\n1216:         if (Model.getFacade().isAModelElement(own)\n1217:                 && UUIDHelper.getUUID(own) == null) {\n1218:             Model.getCoreHelper().setUUID(own, UUIDHelper.getNewUUID());\n1219:         }\n1220:         readyToEdit = true;\n1221:         if (own != null) {\n1222:             renderingChanged();\n1223:         }\n1224:         updateBounds();\n1225:         bindPort(own, bigPort);\n1226:     }\n1227: \n1228:     /**\n1229:      * @param own the current owner\n1230:      */\n1231:     protected void initNotationProviders(Object own) {\n1232:         if (Model.getFacade().isAModelElement(own)) {\n1233:             notationProviderName =\n1234:                 NotationProviderFactory2.getInstance().getNotationProvider(\n1235:                         NotationProviderFactory2.TYPE_NAME, this, own);\n1236:             notationProviderName.putValue(\"pathVisible\", new Boolean(isPathVisible()));\n1237:         }\n1238:     }\n1239: \n1240:     /**\n1241:      * Updates the text of the sterotype FigText. Override in subclasses to get\n1242:      * wanted behaviour.\n1243:      */\n1244:     protected void updateStereotypeText() {\n1245:         if (getOwner() == null) {\n1246:             LOG.warn(\"Owner of [\" + this.toString() + \"/\" + this.getClass()\n1247:                     + \"] is null.\");\n1248:             LOG.warn(\"I return...\");\n1249:             return;\n1250:         }\n1251: \n1252:         Object modelElement = getOwner();\n1253:         stereotypeFig.setOwner(modelElement);\n1254:         if (modelElement != null) {\n1255:             ((FigStereotypesCompartment) stereotypeFig).populate();\n1256:         }\n1257:     }\n1258: \n1259:     /**\n1260:      * Updates the text of the name FigText.\n1261:      */\n1262:     protected void updateNameText() {\n1263:         if (readyToEdit) {\n1264:             if (getOwner() == null) {\n1265:                 return;\n1266:             }\n1267:             if(notationProviderName != null) {\n1268:                 nameFig.setText(notationProviderName.toString());\n1269:             }\n1270:             updateBounds();\n1271:         }\n1272:     }\n1273: \n1274:     /**\n1275:      * @see org.argouml.uml.diagram.ui.PathContainer#isPathVisible()\n1276:      */\n1277:     public boolean isPathVisible() {\n1278:         return pathVisible;\n1279:     }\n1280: \n1281:     /**\n1282:      * @see org.argouml.uml.diagram.ui.PathContainer#setPathVisible(boolean)\n1283:      */\n1284:     public void setPathVisible(boolean visible) {\n1285:         pathVisible = visible;\n1286:         if (notationProviderName != null)\n1287:             notationProviderName.putValue(\"pathVisible\", new Boolean(visible));\n1288:         if (readyToEdit) {\n1289:             renderingChanged();\n1290:             damage();\n1291:         }\n1292:     }\n1293: \n1294:     /**\n1295:      * USED BY PGML.tee.\n1296:      * @return the class name and bounds together with compartment\n1297:      * visibility.\n1298:      */\n1299:     public String classNameAndBounds() {\n1300:         return super.classNameAndBounds()\n1301:                 + \"pathVisible=\" + isPathVisible()\n1302:                 + \";\";\n1303:     }\n1304: \n1305:     /**\n1306:      * Implementations of this method should register/unregister the fig for all\n1307:      * (model)events. For FigNodeModelElement only the fig itself is registred\n1308:      * as listening to events fired by the owner itself. But for, for example,\n1309:      * FigClass the fig must also register for events fired by the operations\n1310:      * and attributes of the owner.\n1311:      * @param newOwner the new owner for the listeners\n1312:      */\n1313:     protected void updateListeners(Object newOwner) {\n1314:         Object oldOwner = getOwner();\n1315:         if (oldOwner != null) {\n1316:             Model.getPump().removeModelEventListener(this, oldOwner);\n1317:         }\n1318:         if (newOwner != null) {\n1319:             Model.getPump().addModelEventListener(this, newOwner);\n1320:         }\n1321: \n1322:     }\n1323: \n1324:     /**\n1325:      * Returns the notation name for this fig. First start to\n1326:      * implement notations on a per fig basis.\n1327:      * @see org.argouml.notation.NotationContext#getContextNotation()\n1328:      */\n1329:     public NotationName getContextNotation() {\n1330:         return currentNotationName;\n1331:     }\n1332: \n1333:     /**\n1334:      * @see org.argouml.notation.NotationContext#setContextNotation(org.argouml.notation.NotationName)\n1335:      */\n1336:     public void setContextNotation(NotationName nn) {\n13