.Object, java.util.HashMap)\n89:      */\n90:     public String toString(Object element, HashMap args) {\n91:         String name = Model.getFacade().getName(element);\n92:         StringBuffer sb = new StringBuffer(\"\");\n93:         if (isValue(\"fullyHandleStereotypes\", args)) {\n94:             sb.append(generateStereotypes(element, args));\n95:         }\n96:         sb.append(generateVisibility(element, args));\n97:         sb.append(generatePath(element, args));\n98:         if (name != null) {\n99:             sb.append(name);\n100:         }\n101:         return sb.toString();\n102:     }\n103: \n104:     /**\n105:      * @param modelElement the UML element to generate for\n106:      * @param args arguments that influence the generation\n107:      * @return a string which represents the stereotypes\n108:      */\n109:     protected String generateStereotypes(Object modelElement, HashMap args) {\n110:         Collection c = Model.getFacade().getStereotypes(modelElement);\n111:         StringBuffer sb = new StringBuffer(50);\n112:         Iterator i = c.iterator();\n113:         boolean first = true;\n114:         while (i.hasNext()) {\n115:             Object o = i.next();\n116:             if (!first) {\n117:                 sb.append(',');\n118:             }\n119:             if (o != null) {\n120:                 sb.append(Model.getFacade().getName(o));\n121:                 first = false;\n122:             }\n123:         }\n124:         Project project = \n125:             ProjectManager.getManager().getCurrentProject();\n126:         ProjectSettings ps = project.getProjectSettings();\n127:         return first ? \"\" : ps.getLeftGuillemot()\n128:             + sb.toString()\n129:             + ps.getRightGuillemot();\n130:     }\n131: \n132:     /**\n133:      * @param modelElement the UML element to generate for\n134:      * @param args arguments that influence the generation\n135:      * @return a string which represents the path\n136:      */\n137:     protected String generatePath(Object modelElement, HashMap args) {\n138:         String s = \"\";\n139:         if (isValue(\"pathVisible\", args)) {\n140:             Object p = modelElement;\n141:             Stack stack = new Stack();\n142:             Object ns = Model.getFacade().getNamespace(p);\n143:             while (ns != null && !Model.getFacade().isAModel(ns)) {\n144:                 stack.push(Model.getFacade().getName(ns));\n145:                 ns = Model.getFacade().getNamespace(ns);\n146:             }\n147:             while (!stack.isEmpty()) {\n148:                 s += (String) stack.pop() + \"::\";\n149:             }\n150: \n151:             if (s.length() > 0 && !s.endsWith(\":\")) {\n152:                 s += \"::\";\n153:             }\n154:         }\n155:         return s;\n156:     }\n157: \n158:     /**\n159:      * @param modelElement the UML element to generate for\n160:      * @param args arguments that influence the generation\n161:      * @return a string representing the visibility\n162:      */\n163:     protected String generateVisibility(Object modelElement, HashMap args) {\n164:         String s = \"\";\n165:         if (isValue(\"visibilityVisible\", args)) {\n166:             Object v = Model.getFacade().getVisibility(modelElement);\n167:             if (v == null) {\n168:                 /* Initially, the visibility is not set in the model.\n169:                  * Still, we want to show the default, i.e. public.\n170:                  */\n171:                 v = Model.getVisibilityKind().getPublic();\n172:             }\n173:             s = NotationUtilityUml.generateVisibility(v);\n174:             if (s.length() > 0) {\n175:                 s = s + \" \";\n176:             }\n177:             /* This for when nothing is generated: omit the space. */\n178:         }\n179:         return s;\n180:     }\n181: \n182: \n183:     /**\n184:      * @param me   The ModelElement <em>text</em> describes.\n185:      * @para