   public void setCurPerspective(TreeModel per) {\n249:         if (_perspectives == null || !_perspectives.contains(per)) {\n250: \t    return;\n251: \t}\n252:         _combo.setSelectedItem(per);\n253:         _toDoPerspectivesChanged++;\n254:     }\n255:     \n256:     public Object getSelectedObject() {\n257:         return _tree.getLastSelectedPathComponent();\n258:     }\n259:     \n260:     public void selectItem(ToDoItem item) {\n261:         Object path[] = new Object[3];\n262:         Object category = null;\n263:         int size = _curPerspective.getChildCount(_root);\n264:         for (int i = 0; i < size; i++) {\n265:             category = _curPerspective.getChild(_root, i);\n266:             if (_curPerspective.getIndexOfChild(category, item) != -1) {\n267:                 break;\n268: \t    }\n269:         }\n270:         if (category == null) {\n271: \t    return;\n272: \t}\n273:         path[0] = _root;\n274:         path[1] = category;\n275:         path[2] = item;\n276:         TreePath trPath = new TreePath(path);\n277:         _tree.expandPath(trPath);\n278:         _tree.scrollPathToVisible(trPath);\n279:         _tree.setSelectionPath(trPath);\n280:     }\n281:     \n282:     /**\n283:      * Return whether the todo pane is currently in flat hierachy mode.\n284:      *\n285:      * @return true if flat.\n286:      */\n287:     public boolean isFlat() { return _flat; }\n288: \n289:     /**\n290:      * Set the todo pane in a specific hierachy mode.\n291:      *\n292:      * @param b is true for flat mode.\n293:      */\n294:     public void setFlat(boolean b) {\n295:         _flat = b;\n296:         _flatButton.getModel().setPressed(_flat);\n297:         if (_flat) {\n298: \t    _tree.setShowsRootHandles(false);\n299: \t} else {\n300: \t    _tree.setShowsRootHandles(true);\n301: \t}\n302:         updateTree();\n303:     }\n304:     /** toggle the hierachy mode. */\n305:     public void toggleFlat() {\n306:         setFlat(!isFlat());\n307:   