wing.JToolBar;\n34: import javax.swing.JOptionPane;\n35: import javax.swing.event.EventListenerList;\n36: \n37: import org.apache.log4j.Logger;\n38: \n39: import org.argouml.model.ModelFacade;\n40: import org.argouml.model.uml.UmlFactory;\n41: import org.argouml.ocl.ArgoFacade;\n42: import org.argouml.ocl.OCLUtil;\n43: import org.argouml.ui.TabSpawnable;\n44: import org.argouml.ui.targetmanager.TargetEvent;\n45: \n46: import org.tigris.gef.presentation.Fig;\n47: \n48: import tudresden.ocl.OclTree;\n49: import tudresden.ocl.check.OclTypeException;\n50: import tudresden.ocl.gui.ConstraintRepresentation;\n51: import tudresden.ocl.gui.EditingUtilities;\n52: import tudresden.ocl.gui.OCLEditor;\n53: import tudresden.ocl.gui.OCLEditorModel;\n54: import tudresden.ocl.gui.events.ConstraintChangeEvent;\n55: import tudresden.ocl.gui.events.ConstraintChangeListener;\n56: import tudresden.ocl.parser.OclParserException;\n57: import tudresden.ocl.OclException;\n58: import tudresden.ocl.parser.analysis.DepthFirstAdapter;\n59: import tudresden.ocl.parser.node.AConstraintBody;\n60: import tudresden.ocl.parser.node.TName;\n61: \n62: /**\n63:   * Tab for OCL constraint editing.\n64:   *\n65:   * @author v1.0: Falk Finger\n66:   * @author v2.0: Steffen Zschaler\n67:   */\n68: public class TabConstraints extends TabSpawnable implements TabModelTarget {\n69: \n70:     private static Logger _cat = Logger.getLogger(TabConstraints.class);\n71: \n72:     /**\n73:      * The actual editor pane.\n74:      */\n75:     private OCLEditor m_ocleEditor;\n76: \n77:     /**\n78:      * The current target element.\n79:      */\n80:     private Object/*MModelElement*/ m_mmeiTarget;\n81: \n82:     public TabConstraints() {\n83:         super(\"tab.constraints\");\n84: \n85:         setLayout(new BorderLayout(0, 0));\n86: \n87:         m_ocleEditor = new OCLEditor();\n88:         m_ocleEditor.setOptionMask(OCLEditor.OPTIONMASK_TYPECHECK\n89:                    /*|  //removed to workaround problems with autosplit\n90:                      OCLEditor.OPTIONMASK_AUTOSPLIT*/ );\n91:         m_ocleEditor.setDoAutoSplit(false);\n92:         setToolbarRollover(true);\n93:         setToolbarFloatable(false);\n94: \n95:         add(m_ocleEditor);\n96:     }\n97: \n98:     /**\n99:      * Set the toolbar rollover style.\n100:      *\n101:      * @param enable If true then button borders do not become visible\n102:      * until mouse rolls over button.\n103:      */\n104:     private void setToolbarRollover(boolean enable) {\n105:         getOclToolbar().putClientProperty(\"JToolBar.isRollover\", Boolean.TRUE);\n106:     }\n107: \n108:     /** Set the toolbar floating style\n109:      * @param enable If true then the toolbar can be floated and docked\n110:      */\n111:     private void setToolbarFloatable(boolean enable) {\n112:         getOclToolbar().setFloatable(false);\n113:     }\n114: \n115:     /**\n116:      * Get a reference to the toolbar object contained in the\n117:      * OCLEditor component.  This is currently a nasty hack. We really\n118:      * require an interface method on OCLEditor (Bob Tarling 8 Feb\n119:      * 2003).\n120:      *\n121:      * @return The toolbar\n122:      */\n123:     private JToolBar getOclToolbar() {\n124:         return (JToolBar) m_ocleEditor.getComponent(0);\n125:     }\n126: \n127:     //TabModelTarget interface methods\n128:     \n129:     /**\n130:      * Should this tab be activated for the current target element?\n131:      *\n132:      * <p>Argo only supports constraints for Classes and Features\n133:      * (eg. Attributes and Operations) currently.\n134:      */\n135:     public boolean shouldBeEnabled(Object target) {\n136:         target = (target instanceof Fig) ? ((Fig) target).getOwner() : target;\n137:         return (ModelFacade.isAClass(target) || ModelFacade.isAFeature(target));\n138:     }\n139: \n140:     /**\n141:      * Get the target element whose properties this tab presents.\n142:      */\n143:     public Object getTarget() {\n144:         return m_mmeiTarget;\n145:     }\n146: \n147:     /**\n148:      * Refresh the tab because the target has changed.\n149:      */\n150:     public void refresh() {\n151:         setTarget(m_mmeiTarget);\n152:     }\n153: \n154:     /**\n155:      * Set the target element to be displayed in this tab. Only model elements\n156:      * will be accepted by the constraint tab.\n157:      */\n158:     public void setTarget(Object oTarget) {\n159:         oTarget =\n160: \t    (oTarget instanceof Fig) ? ((Fig) oTarget).getOwner() : oTarget;\n161:         if (!(ModelFacade.isAModelElement(oTarget))) {\n162:             m_mmeiTarget = null;\n163:             return;\n164:         }\n165: \n166:         m_mmeiTarget = /*(MModelElement)*/oTarget;\n167: \n168:         // Set editor's model\n169:         m_ocleEditor.setModel(new ConstraintModel(m_mmeiTarget));\n170:     }\n171: \n172:     /**\n173:      * Adapter to provide information and a manipulation interface for a\n174:      * target element's set of constraints to the constraint editor.\n175:      */\n176:     private static class ConstraintModel implements OCLEditorModel {\n177: \n178:         /**\n179:          * The target element being edited.\n180:          */\n181:         private Object/*MModelElement*/ m_mmeiTarget;\n182: \n183:         /**\n184:          * A list of all the constraints in m_nmeiTarget. This is necessary to\n185:          * induce a consistent order on the constraints.\n186:          */\n187:         private ArrayList m_alConstraints;\n188: \n189:         /**\n190:          * List of listeners.\n191:          */\n192:         private EventListenerList m_ellListeners = new EventListenerList();\n193: \n194:         /**\n195:          * Construct a new ConstraintModel.\n196:          */\n197:         public ConstraintModel(Object/*MModelElement*/ mmeiTarget) {\n198:             super();\n199: \n200:             m_mmeiTarget = mmeiTarget;\n201: \n202:             m_alConstraints =\n203: \t\tnew ArrayList(ModelFacade.getConstraints(m_mmeiTarget));\n204:         }\n205: \n206:         /**\n207:          * Return the number of constraints in this model.\n208:          */\n209:         public int getConstraintCount() {\n210:             return m_alConstraints.size();\n211:         }\n212: \n213:         /**\n214:          * Return the constraint with the specified index.\n215:          *\n216:          * @param nIdx the index of the constraint to be returned.\n217:          *             0 <= nIdx < {@link #getConstraintCount}\n218:          */\n219:         public ConstraintRepresentation getConstraintAt(int nIdx) {\n220:             return representationFor(nIdx);\n221:         }\n222: \n223:         /** \n224:          * Remove the specified constraint from the model.\n225:          *\n226:          * @param nIdx the index of the constraint to be removed.\n227:          *             0 <= nIdx < {@link #getConstraintCount}\n228:          */\n229:         public void removeConstraintAt(int nIdx) {\n230:             if ((nIdx < 0) || (nIdx > m_alConstraints.size())) {\n231:                 return;\n232:             }\n233: \n234:             Object/*MConstraint*/ mc =\n235: \t\t/*(MConstraint)*/m_alConstraints.remove(nIdx);\n236: \n237:             if (mc != null) {\n238:                 ModelFacade.removeConstraint(m_mmeiTarget, mc);\n239:             }\n240: \n241:             fireConstraintRemoved(mc, nIdx);\n242:         }\n243: \n244:         /**\n245:          * Add a fresh constraint to the model.\n246:          * \n247:          * <p>There are 2 restrictions on what can be parsed, given\n248:          * the current OCL grammar:\n249:          * <ol>\n250:          *   <li>Class names must have a capital first letter.</li>\n251:          *   <li>Feature name must have a lower case first letter.\n252:          *   </li>\n253:          * </ol>\n254:          */\n255:         public void addConstraint() {\n256: \n257:             // check ocl parsing constraints\n258:             /*\n259:              * TODO: sz9: I think this should read \n260:              * mmeContext = OclUtil.getInnerMostEnclosingNamespace(m_mmeiTarget);\n261:              */\n262:             Object/*MModelElement*/ mmeContext = m_mmeiTarget;\n263: \n264:             while (!(ModelFacade.isAClassifier(mmeContext))\n265: \t\t   && mmeContext != null) {\n266:                 mmeContext = ModelFacade.getModelElementContainer(mmeContext);\n267:             }\n268: \n269:             String contextName = ModelFacade.getName(mmeContext);\n270:             String targetName = ModelFacade.getName(m_mmeiTarget);\n271:             if ((contextName == null\n272: \t\t || contextName.equals (\"\"))\n273: \t\t||  // this is to fix issue #2056\n274:                 (targetName == null\n275: \t\t || targetName.equals (\"\"))\n276: \t\t||   // this is to fix issue #2056\n277:                 !Character.isUpperCase(contextName.charAt(0))\n278: \t\t|| (ModelFacade.isAClass (m_mmeiTarget)\n279: \t\t    && !Character.isUpperCase(targetName.charAt(0)))\n280: \t\t|| (ModelFacade.isAFeature(m_mmeiTarget)\n281: \t\t    && !Character.isLowerCase(targetName.charAt(0)))) {\n282:                 // TODO: I18n\n283:                 JOptionPane.showMessageDialog(\n284: \t\t    null,\n285:                     \"The OCL Toolkit requires that:\\n\\n\"\n286: \t\t    + \"Class names have a capital first letter and\\n\"\n287: \t\t    + \"Attribute or Operation names have \"\n288: \t\t    + \"a lower case first letter.\",\n289:                     \"Require Correct name convention:\",\n290:                     JOptionPane.ERROR_MESSAGE);\n291:                 // do not create a constraint:\n292:                 return;\n293:             }\n294: \n295:             // null elements represent new constraints, which will be\n296:             // added to the target the first time any actual editing\n297:             // takes place.  This is done to ensure syntactical\n298:             // correctness of constraints stored with the target.\n299:             m_alConstraints.add(null);\n300: \n301:             fireConstraintAdded();\n302:         }\n303: \n304:         // TODO: - please add some javadoc - ugly classname also\n305:         private class CR implements ConstraintRepresentation {\n306:             /**\n307:              * The constraint being represented.\n308:              */\n309:             private Object/*MConstraint*/ m_mcConstraint;\n310: \n311:             /**\n312:              * The constraint's index in the list of\n313:              * constraints. Necessary only for new constraints, where\n314:              * m_mcConstraint is still <tt>null</tt>.\n315:              */\n316:             private int m_nIdx = -1;\n317: \n318:             public CR(Object/*MConstraint*/ mcConstraint, int nIdx) {\n319:                 super();\n320: \n321:                 m_mcConstraint = mcConstraint;\n322:                 m_nIdx = nIdx;\n323:             }\n324: \n325:             public CR(int nIdx) {\n326:                 this(null, nIdx);\n327:             }\n328: \n329:             /**\n330:              * Get the name of the constraint.\n331:              */\n332:             public String getName() {\n333:                 if (m_mcConstraint == null) {\n334:                     return \"newConstraint\";\n335:                 } else {\n336:                     return ModelFacade.getName(m_mcConstraint);\n337:                 }\n338:             }\n339: \n340:             /**\n341:              * Get the constraint's body.\n342:              */\n343:             public String getData() {\n344:                 if (m_mcConstraint == null) {\n345:                     return OCLUtil.getContextString(m_mmeiTarget);\n346:                 } else {\n347:                     return (String) ModelFacade.getBody(\n348: \t\t\t\t\tModelFacade.getBody(m_mcConstraint));\n349:                 }\n350:             }\n351: \n352:             /**\n353:              * Set the constraint's body text. For the exceptions the\n354:              * detailed message must be human readable.\n355:              *\n356:              * @param sData the new body of the constraint\n357:              *\n358:              * @exception IllegalStateException if the constraint is\n359:              *            not in a state to accept body changes.\n360:              * @exception OclParserException if the specified constraint is not\n361:              *     syntactically correct.\n362:              * @exception OclTypeException if the specified constraint\n363:              *            does not adhere by OCL type rules.\n364:              */\n365:             public void setData(String sData, EditingUtilities euHelper)\n366: \t\tthrows OclParserException, OclTypeException {\n367:                 // Parse and check specified constraint.\n368:                 OclTree tree = null;\n369: \n370:                 Object/*MModelElement*/ mmeContext = m_mmeiTarget;\n371: \n372:                 try {\n373:                     while (!(ModelFacade.isAClassifier(mmeContext))) {\n374:                         mmeContext =\n375: \t\t\t    ModelFacade.getModelElementContainer(mmeContext);\n376:                     }\n377: \n378:                     try {\n379:                         tree =\n380: \t\t\t    euHelper.parseAndCheckConstraint(\n381: \t\t\t\tsData,\n382: \t\t\t\tnew ArgoFacade(mmeContext));\n383:                     } catch (IOException ioe) {\n384:                         // Ignored: Highly unlikely, and what would we\n385:                         // do anyway?  log it\n386:                         _cat.error(\"problem parsing And Checking Constraints\",\n387: \t\t\t\t   ioe);\n388:                         return;\n389:                     }\n390: \n391:                     // Split constraint body, if user wants us to\n392:                     if (euHelper.getDoAutoSplit()) {\n393:                         List lConstraints = euHelper.splitConstraint(tree);\n394: \n395:                         if (lConstraints.size() > 0) {\n396:                             removeConstraintAt(m_nIdx);\n397: \n398:                             for (Iterator i = lConstraints.iterator();\n399: \t\t\t\t i.hasNext(); ) {\n400:                                 OclTree ocltCurrent = (OclTree) i.next();\n401: \n402:                                 Object/*MConstraint*/ mc =\n403:                                     UmlFactory.getFactory().getCore()\n404: \t\t\t\t        .createConstraint();\n405:                                 ModelFacade.setName(mc, ocltCurrent.getConstraintName());\n406:                                 ModelFacade.setBody(mc, UmlFactory.getFactory().getDataTypes().createBooleanExpression(\"OCL\", ocltCurrent.getExpression()));\n407:                                 ModelFacade.addConstraint(m_mmeiTarget, mc);\n408: \n409:                                 // the constraint _must_ be owned by a namespace\n410:                                 if (ModelFacade.getNamespace(m_mmeiTarget) != null) {\n411:                                     ModelFacade.addOwnedElement(ModelFacade.getNamespace(m_mmeiTarget), mc);\n412:                                 } else if (ModelFacade.getNamespace(mmeContext) != null) {\n413:                                     ModelFacade.addOwnedElement(ModelFacade.getNamespace(mmeContext), m_mcConstraint);\n414:                                 }\n415: \n416:                                 m_alConstraints.add(mc);\n417:                                 fireConstraintAdded();\n418:                             }\n419: \n420:                             return;\n421:                         }\n422:                     }\n423: \n424:                     // Store constraint body\n425:                     Object/*MConstraint*/ mcOld = null;\n426: \n427:                     if (m_mcConstraint == null) {\n428:                         // New constraint, first time setData is called\n429:                         m_mcConstraint = UmlFactory.getFactory().getCore().createConstraint();\n430: \n431:                         ModelFacade.setName(m_mcConstraint, \"newConstraint\");\n432:                         ModelFacade.setBody(m_mcConstraint, UmlFactory.getFactory().getDataTypes().createBooleanExpression(\"OCL\", sData));\n433: \n434:                         ModelFacade.addConstraint(m_mmeiTarget, m_mcConstraint);\n435: \n436:                         // the constraint _must_ be owned by a namespace\n437:                         Object targetNamespace = ModelFacade.getNamespace(m_mmeiTarget);\n438:                         Object contextNamespace = ModelFacade.getNamespace(mmeContext);\n439:                         if (targetNamespace != null) {\n440:                             ModelFacade.addOwnedElement(targetNamespace, m_mcConstraint);\n441:                         } else if (contextNamespace != null) {\n442:                             ModelFacade.addOwnedElement(contextNamespace, m_mcConstraint);\n443:                         }\n444: \n445:                         m_alConstraints.set(m_nIdx, m_mcConstraint);\n446:                     } else {\n447:                         mcOld = UmlFactory.getFactory().getCore().createConstraint();\n448:                         ModelFacade.setName(mcOld, ModelFacade.getName(m_mcConstraint));\n449:                         ModelFacade.setBody(mcOld, UmlFactory.getFactory().getDataTypes().createBooleanExpression(\"OCL\", (String) ModelFacade.getBody(ModelFacade.getBody(m_mcConstraint))));\n450:                         ModelFacade.setBody(m_mcConstraint, UmlFactory.getFactory().getDataTypes().createBooleanExpression(\"OCL\", sData));\n451:                     }\n452: \n453:                     fireConstraintDataChanged(m_nIdx, mcOld, m_mcConstraint);\n454: \n455:                 } catch (OclTypeException pe) {\n456:                     _cat.warn(\"There was some sort of OCL Type problem\", pe);\n457:                     throw pe;\n458:                 } catch (OclParserException pe1) {\n459:                     _cat.warn(\"Could not parse the constraint\", pe1);\n460:                     throw pe1;\n461:                 } catch (OclException oclExc) {\n462:                     // a runtime exception that occurs when some\n463:                     // internal test fails\n464:                     _cat.warn(\"There was some unidentified problem\");\n465:                     throw oclExc;\n466:                 }\n467:             }\n468: \n469:             /**\n470:              * Set the constraint's name.\n471:              */\n472:             public void setName(\n473:                 final String sName,\n474:                 final EditingUtilities euHelper) {\n475:                 if (m_mcConstraint != null) {\n476:                     // Check name for consistency with spec\n477:                     if (!euHelper.isValidConstraintName(sName)) {\n478:                         throw new IllegalArgumentException(\"Please specify a valid name.\");\n479:                     }\n480: \n481:                     // Set name\n482:                     Object/*MConstraint*/ mcOld =\n483:                         UmlFactory.getFactory().getCore().createConstraint();\n484:                     ModelFacade.setName(mcOld, ModelFacade.getName(m_mcConstraint));\n485:                     Object constraintBody = ModelFacade.getBody(m_mcConstraint);\n486:                     ModelFacade.setBody(mcOld,\n487:                                           UmlFactory\n488:                                           .getFactory()\n489:                                           .getDataTypes()\n490:                                           .createBooleanExpression(\n491:                                                        \"OCL\",\n492:                                                        (String) ModelFacade.getBody(constraintBody)));\n493: \n494:                     ModelFacade.setName(m_mcConstraint, sName);\n495: \n496:                     fireConstraintNameChanged(m_nIdx, mcOld, m_mcConstraint);\n497: \n498:                     // Also set name in constraint body -- Added 03/14/2001\n499:                     try {\n500:                         OclTree tree = null;\n501: \n502:                         Object/*MModelElement*/ mmeContext = m_mmeiTarget;\n503:                         while (!(ModelFacade.isAClassifier(mmeContext))) {\n504:                             mmeContext = ModelFacade.getModelElementContainer(mmeContext);\n505:                         }\n506: \n507:                         constraintBody = ModelFacade.getBody(m_mcConstraint);\n508:                         tree =\n509:                             euHelper.parseAndCheckConstraint(\n510:                                 (String) ModelFacade.getBody(constraintBody),\n511:                                 new ArgoFacade(mmeContext));\n512: \n513:                         if (tree != null) {\n514:                             tree.apply(new DepthFirstAdapter() {\n515:                                 int name_ID = 0;\n516:                                 public void caseAConstraintBody(AConstraintBody node) {\n517:                                     // replace name\n518:                                     if (name_ID == 0) {\n519:                                         node.setName(new TName(sName));\n520:                                     } else {\n521:                                         node.setName(new TName(sName + \"_\" + name_ID));\n522:                                     }\n523:                                     name_ID++;\n524: \t\t\t\t}\n525:                             });\n526: \n527:                             setData(tree.getExpression(), euHelper);\n528:                         }\n529:                     } catch (Throwable t) {\n530:                         // OK, so that didn't work out... Just ignore\n531:                         // any problems and don't set the nam