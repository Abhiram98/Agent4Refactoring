 BorderLayout.NORTH);\n139: \t    relatedW.add(relatedSP, BorderLayout.CENTER);\n140: \t    relatedTable.setModel(relatedModel);\n141: \t    relatedTable.addMouseListener(this);\n142: \t    relatedTable.addKeyListener(this);\n143: \t    relatedW.setMinimumSize(new Dimension(100, 100));\n144: \t}\n145: \n146: \tif (relatedShown) {\n147: \t    mainPane =\n148: \t\tnew JSplitPane(JSplitPane.VERTICAL_SPLIT,\n149: \t\t\t       resultsW,\n150: \t\t\t       relatedW);\n151: \t    add(mainPane, BorderLayout.CENTER);\n152: \t} else {\n153: \t    add(resultsW, BorderLayout.CENTER);\n154: \t}\n155: \n156:     }\n157: \n158:     ////////////////////////////////////////////////////////////////\n159:     // accessors\n160: \n161:     /**\n162:      * @param p the predicate for the search\n163:      */\n164:     public void setPredicate(PredicateFind p) {\n165: \tpred = p;\n166:     }\n167: \n168:     /**\n169:      * @param r the root object for the search\n170:      */\n171:     public void setRoot(Object r) {\n172: \troot = r;\n173:     }\n174: \n175:     /**\n176:      * @param gen the generator\n177:      */\n178:     public void setGenerator(ChildGenerator gen) {\n179: \tcg = gen;\n180:     }\n181: \n182:     /**\n183:      * @param res the results\n184:      * @param dia the diagrams\n185:      */\n186:     public void setResults(Vector res, Vector dia) {\n187: \tresults = res;\n188: \tdiagrams = dia;\n189: \tObject[] msgArgs = {new Integer(results.size()) };\n190: \tresultsLabel.setText(Translator.messageFormat(\n191:             \"dialog.tabresults.results-items\", msgArgs));\n192: \tresultsModel.setTarget(results, diagrams);\n193: \trelatedModel.setTarget(null, null);\n194: \trelatedLabel.setText(\n195:             Translator.localize(\"dialog.tabresults.related-items\"));\n196:     }\n197: \n198:     /**\n199:      * @see org.argouml.ui.AbstractArgoJPanel#spawn()\n200:      */\n201:     public AbstractArgoJPanel spawn() {\n202: \tTabResults newPanel = (TabResults) super.spawn();\n203: \tif (newPanel != null) {\n204: \t    newPanel.setResults(results, diagrams);\n205: \t}\n206: \treturn newPanel;\n207:     }\n208: \n209:     /**\n210:      * Handle a doubleclick on the results tab.\n211:      */\n212:     public void doDoubleClick() {\n213: \tmyDoubleClick(resultsTable);\n214:     }\n215: \n216:     /**\n217:      * Select the result at the given index.\n218:      *\n219:      * @param index the given index\n220:      */\n221:     public void selectResult(int index) {\n222: \tif (index < resultsTable.getRowCount()) {\n223: \t    resultsTable.getSelectionModel().setSelectionInterval(index,\n224: \t\t\t\t\t\t\t\t   index);\n225: \t}\n226:     }\n227: \n228:     ////////////////////////////////////////////////////////////////\n229:     // ActionListener implementation\n230: \n231:     /**\n232:      * @see java.awt.event.ActionListener#actionPerformed(java.awt.event.ActionEvent)\n233:      */\n234:     public void actionPerformed(ActionEvent ae) {\n235:     }\n236: \n237:     ////////////////////////////////////////////////////////////////\n238:     // MouseListener implementation\n239: \n240:     /**\n241:      * @see java.awt.event.MouseListener#mousePressed(java.awt.event.MouseEvent)\n242:      */\n243:     public void mousePressed(MouseEvent me) {\n244:     }\n245: \n246:     /**\n247:      * @see java.awt.event.MouseListener#mouseReleased(java.awt.event.MouseEvent)\n248:      */\n249:     public void mouseReleased(MouseEvent me) {\n250:     }\n251: \n252:     /**\n253:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n254:      */\n255:     public void mouseClicked(MouseEvent me) {\n256: \tif (me.getClickCount() >= 2)\n257: \t    myDoubleClick(me.getSource());\n258:     }\n259: \n260:     /**\n261:      * @see java.awt.event.MouseListener#mouseEntered(java.awt.event.MouseEvent)\n262:      */\n263:     public void mouseEntered(MouseEvent me) {\n264:     }\n265: \n266:     /**\n267:      * @see java.awt.event.MouseListener#mouseExited(java.awt.event.MouseEvent)\n268:      */\n269:     public void mouseExited(MouseEvent me) {\n270:     }\n271: \n272:     private void myDoubleClick(Object src) {\n273: \tObject sel = null;\n274: \tDiagram d = null;\n275: \tif (src == resultsTable) {\n276: \t    int row = resultsTable.getSelectionModel().getMinSelectionIndex();\n277: \t    if (row < 0)\n278: \t\treturn;\n279: \t    sel = results.elementAt(row);\n280: \t    d = (Diagram) diagrams.elementAt(row);\n281: \t} else if (src == relatedTable) {\n282: \t    int row = relatedTable.getSelectionModel().getMinSelectionIndex();\n283: \t    if (row < 0)\n284: \t\treturn;\n285: \t    numJumpToRelated++;\n286: \t    sel = related.elementAt(row);\n287: \t}\n288: \n289: \tif (d != null)\n290: \t    LOG.debug(\"go \" + sel + \" in \" + d.getName());\n291: \tif (d != null)\n292: \t    TargetManager.getInstance().setTarget(d);\n293: \tTargetManager.getInstance().setTarget(sel);\n294:     }\n295: \n296:     ////////////////////////////////////////////////////////////////\n297:     // KeyListener implementation\n298: \n299:     /**\n300:      * @see java.awt.event.KeyListener#keyTyped(java.awt.event.KeyEvent)\n301:      */\n302:     public void keyTyped(KeyEvent e) {\n303:         // TODO: Review - should be keyTyped()??? - Bob\n304:         if (e.getKeyCode() == KeyEvent.VK_ENTER) {\n305:             e.consume();\n306:             myDoubleClick(e.getSource());\n307:         }\n308:     }\n309: \n310:     /**\n311:      * @see java.awt.event.KeyListener#keyReleased(java.awt.event.KeyEvent)\n312:      */\n313:     public void keyReleased(KeyEvent e) {\n314:     }\n315: \n316:     /**\n317:      * @see java.awt.event.KeyListener#keyTyped(java.awt.event.KeyEvent)\n318:      */\n319:     public void keyTyped(KeyEvent e) {\n320:     }\n321: \n322:     ////////////////////////////////////////////////////////////////\n323:     // ListSelectionListener implementation\n324: \n325:     /**\n326:    