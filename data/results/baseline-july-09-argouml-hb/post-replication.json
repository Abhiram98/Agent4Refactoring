n;\n33: import java.awt.Rectangle;\n34: import java.awt.event.MouseEvent;\n35: import java.awt.event.MouseListener;\n36: import java.util.Iterator;\n37: import java.util.Vector;\n38: \n39: import javax.swing.Icon;\n40: import javax.swing.JPanel;\n41: import javax.swing.JTabbedPane;\n42: import javax.swing.event.ChangeEvent;\n43: import javax.swing.event.ChangeListener;\n44: import javax.swing.event.EventListenerList;\n45: \n46: import org.apache.log4j.Category;\n47: import org.argouml.application.api.Argo;\n48: import org.argouml.application.api.QuadrantPanel;\n49: import org.argouml.cognitive.ui.TabToDo;\n50: import org.argouml.cognitive.ui.TabToDoTarget;\n51: import org.argouml.model.ModelFacade;\n52: import org.argouml.swingext.Orientable;\n53: import org.argouml.swingext.ignoreSplitters;\n54: import org.argouml.ui.targetmanager.TargetEvent;\n55: import org.argouml.ui.targetmanager.TargetListener;\n56: import org.argouml.ui.targetmanager.TargetManager;\n57: import org.argouml.uml.ui.PropPanel;\n58: import org.argouml.uml.ui.TabModelTarget;\n59: import org.argouml.uml.ui.TabProps;\n60: import org.argouml.util.ConfigLoader;\n61: \n62: /**\n63:  * The lower-right pane of the main Argo/UML window, which shows\n64:  * the details of a selected model element. \n65:  * \n66:  * This panel has several tabs that show details of the selected ToDoItem, or the\n67:  * selected model element in the NavigationPane, or the\n68:  * MultiEditorPane.\n69:  *\n70:  * There are requests to have the cursor automatically\n71:  * be set to the primary field.\n72:  *\n73:  * $Id$\n74:  */\n75: public class DetailsPane\n76:     extends JPanel\n77:     implements ChangeListener, MouseListener, QuadrantPanel, Orientable, TargetListener {\n78: \n79:     protected static Category cat = Category.getInstance(DetailsPane.class);\n80:     ////////////////////////////////////////////////////////////////\n81:     // constants\n82: \n83:     public static int WIDTH = 690;\n84:     public static int HEIGHT = 520;\n85:     public static int INITIAL_WIDTH = 400;\n86:     public static int INITIAL_HEIGHT = 200;\n87: \n88:     ////////////////////////////////////////////////////////////////\n89:     // instance variables\n90: \n91:     /**\n92:      * The currently selected todo item.\n93:      */\n94:     protected Object _item = null;\n95: \n96:     /**\n97:      * The top level pane, which is a tabbed pane.\n98:      */\n99:     protected JTabbedPane _tabs = new JTabbedPane();\n100: \n101:     /** \n102:      * The current target\n103:      */\n104:     private Object _target;\n105: \n106:     /**\n107:      * a list of all the tabs, which are JPanels, in the JTabbedPane _tabs.\n108:      */\n109:     protected Vector _tabPanels = new Vector();\n110: \n111:     /**\n112:      * index of the selected tab in the JTabbedPane.\n113:      */\n114:     protected int _lastNonNullTab = -1;\n115: \n116:     /**\n117:      *\n118:      */\n119:     private ignoreSplitters orientation;\n120: \n121:     /**\n122:        * The list with targetlisteners, this are the property panels managed by TabProps\n123:        * It should only contain one listener at a time.\n124:        */\n125:     private EventListenerList _listenerList = new EventListenerList();\n126: \n127:     /**\n128:         * Adds a listener.\n129:         * @param listener the listener to add\n130:         */\n131:     private void addTargetListener(TargetListener listener) {\n132:         _listenerList.add(TargetListener.class, listener);\n133:     }\n134: \n135:     /**\n136:      * Removes a target listener.\n137:      * @param listener the listener to remove\n138:      */\n139:     private void removeTargetListener(TargetListener listener) {\n140:         _listenerList.remove(TargetListener.class, listener);\n141:     }\n142:     ////////////////////////////////////////////////////////////////\n143:     // constructors\n144: \n145:     /**\n146:      * Gets all of the _tabPanels from the ConfigLoader, then \n147:      * adds them to the JTabbedPane.\n148:      *\n149:      * sets the target to null.\n150:      *\n151:      * registers listeners.\n152:      */\n153:     public DetailsPane(String pane, ignoreSplitters orientation) {\n154:         Argo.log.info(\"making DetailsPane(\" + pane + \")\");\n155: \n156:         this.orientation = orientation;\n157:         ConfigLoader.loadTabs(_tabPanels, pane, orientation);\n158:         setLayout(new BorderLayout());\n159:         setFont(new Font(\"Dialog\", Font.PLAIN, 10));\n160:         add(_tabs, BorderLayout.CENTER);\n161: \n162:         for (int i = 0; i < _tabPanels.size(); i++) {\n163:             String title = \"tab\";\n164:             JPanel t = (JPanel) _tabPanels.elementAt(i);\n165:             if (t instanceof TabSpawnable)\n166:                 title = ((TabSpawnable) t).getTitle();\n167:             title = Argo.localize(\"UMLMenu\", title);\n168:             if (t instanceof TabToDoTarget) {\n169:                 _tabs.addTab(title, _leftArrowIcon, t);\n170:             } else if (t instanceof TabModelTarget) {\n171:                 _tabs.addTab(title, _upArrowIcon, t);\n172:             } else if (t instanceof TabFigTarget) {\n173:                 _tabs.addTab(title, _upArrowIcon, t);\n174:             } else {\n175:                 _tabs.addTab(title, t);\n176:             } /*\n177:                         if (t instanceof TargetListener) {\n178:                             TargetManager.getInstance().addTargetListener((TargetListener)t);\n179:                         }\n180:                         */\n181:         }\n182: \n183:         // set the tab that should be shown on first entrance\n184:         _lastNonNullTab = -1;\n185:         Component[] tabs = _tabs.getComponents();\n186:         for (int i = 0; i < tabs.length; i++) {\n187:             // tabprops should be shown if loaded\n188:             if (tabs[i] instanceof TabProps) {\n189:                 _lastNonNullTab = i;\n190:                 break;\n191:             }\n192:             // default if there is no tabprops\n193:             // if there is no tabtodo either, this will result in _lastNonNullTab = -1\n194:             if (tabs[i] instanceof TabToDo) {\n195:                 _lastNonNullTab = i;\n196:             }\n197:         }\n198:         setTarget(null);\n199:         _item = null;\n200:         _tabs.addMouseListener(this);\n201:         _tabs.addChangeListener(this);\n202:     }\n203: \n204:     ////////////////////////////////////////////////////////////////\n205:     // accessors\n206: \n207:     /**\n208:      * returns the JTabbedPane that contains all details panels.\n209:      */\n210:     public JTabbedPane getTabs() {\n211:         return _tabs;\n212:     }\n213: \n214:     /**\n215:      * selects the to do tab, and sets the target of that tab.\n216:      */\n217:     public boolean setToDoItem(Object item) {\n218:         _item = item;\n219:         enableTabs(item);\n220:         for (int i = 0; i < _tabPanels.size(); i++) {\n221:             JPanel t = (JPanel) _tabPanels.elementAt(i);\n222:             if (t instanceof TabToDoTarget) {\n223:                 ((TabToDoTarget) t).setTarget(_item);\n224:                 _tabs.setSelectedComponent(t);\n225:                 return true;\n226:             }\n227:         }\n228:         return false;\n229:     }\n230: \n231:     /**\n232:      * Sets the target of the Details pane to either be a\n233:      * selected model element or\n234:      * the owner(model element) of a selected fig.\n235:      *\n236:      * <p>Decides which panels to enable.\n237:      * @deprecated As of ArgoUml version 0.13.5,\n238:      *             replaced by\n239:      *             {@link org.argouml.ui.targetmanager.TargetListener},\n240:      *             will become non-public in \n241:      * the future\n242:      */\n243:     public void setTarget(Object target) {\n244:         enableTabs(target);\n245:         if (target != null) {\n246:             boolean tabSelected = false;\n247:             for (int i = _lastNonNullTab; i >= 1; i--) {\n248:                 Component tab = _tabs.getComponentAt(i);\n249:                 if (tab instanceof TabTarget) {\n250:                     if (((TabTarget) tab).shouldBeEnabled(target)) {\n251:                         if (!(tab instanceof TargetListener))\n252:                              ((TabTarget) tab).setTarget(target);\n253:                         _tabs.setSelectedIndex(i);\n254:                         tabSelected = true;\n255:                         _lastNonNullTab = i;\n256:                         break;\n257:                     }\n258:                 }\n259:             }\n260:             if (!tabSelected) {\n261:                 for (int i = _lastNonNullTab + 1;\n262:                     i < _tabs.getTabCount();\n263:                     i++) {\n264:                     Component tab = _tabs.getComponentAt(i);\n265:                     if (tab instanceof TabTarget) {\n266:                         if (((TabTarget) tab).shouldBeEnabled(target)) {\n267:                             _tabs.setSelectedIndex(i);\n268:                             ((TabTarget) tab).setTarget(target);\n269:                             _lastNonNullTab = i;\n270:                             tabSelected = true;\n271:                             break;\n272:                         }\n273:                     }\n274:                 }\n275:             }\n276:             // default tab todo\n277:             if (!tabSelected) {\n278:                 JPanel tab = (JPanel) _tabPanels.get(0);\n279:                 if (!(tab instanceof TabToDo)) {\n280:                     Iterator it = _tabPanels.iterator();\n281:                     while (it.hasNext()) {\n282:                         Object o = it.next();\n283:                         if (o instanceof TabToDo) {\n284:                             tab = (TabToDo) o;\n285:                             break;\n286:                         }\n287:                     }\n288:                 }\n289:                 if (tab instanceof TabToDo) {\n290:                     _tabs.setSelectedComponent(tab);\n291:                     ((TabToDo) tab).setTarget(target);\n292:                     _lastNonNullTab = _tabs.getSelectedIndex();\n293:                 }\n294:             }\n295: \n296:         } else {\n297:             // default tab todo\n298:             JPanel tab =\n299:                 _tabPanels.isEmpty() ? null : (JPanel) _tabPanels.get(0);\n300:             if (!(tab instanceof TabToDo)) {\n301:                 Iterator it = _tabPanels.iterator();\n302:                 while (it.hasNext()) {\n303:                     Object o = it.next();\n304:                     if (o instanceof TabToDo) {\n305:                         tab = (TabToDo) o;\n306:                         break;\n307:                     }\n308:                 }\n309:             }\n310:             if (tab instanceof TabToDo) {\n311:                 _tabs.setSelectedComponent(tab);\n312:                 ((TabToDo) tab).setTarget(target);\n313: \n314:             } else {\n315:                 _tabs.setSelectedIndex(-1);\n316:             }\n317:         }\n318:         _target = target;\n319: \n320:     }\n321: \n322:     /**\n323:      * Returns the current model target.\n324:      */\n325:     public Object getTarget() {\n326:         return _target;\n327:     }\n328: \n329:     public Dimension getMinimumSize() {\n330:         return new Dimension(100, 100);\n331:     }\n332: \n333:     ////////////////////////////////////////////////////////////////\n334:     // actions\n335: \n336:     /**\n337:      * Get the index of the tab with the given name\n338:      *\n339:      * @param tabName the name of the required tab\n340:      * @return index of the tab of the given name\n341:      */\n342:     public int getIndexOfNamedTab(String tabName) {\n343:         for (int i = 0; i < _tabPanels.size(); i++) {\n344:             String title = _tabs.getTitleAt(i);\n345:             if (title != null && title.equals(tabName))\n346:                 return i;\n347:         }\n348:         return -1;\n349:     }\n350: \n351:     /**\n352:      * Get the JPanel of the tab with the given name\n353:      *\n354:      * @param tabName the name of the required tab\n355:      * @return the tab of the given name\n356:      */\n357:     public JPanel getNamedTab(String tabName) {\n358:         for (int i = 0; i < _tabPanels.size(); i++) {\n359:             String title = _tabs.getTitleAt(i);\n360:             if (title != null && title.equals(tabName))\n361:                 return (JPanel) _tabs.getComponentAt(i);\n362:         }\n363:         return null;\n364:     }\n365: \n366:     /**\n367:      * Get the number of tabs\n368:      *\n369:      * @return the number of tab pages\n370:      */\n371:     public int getTabCount() {\n372:         return _tabPanels.size();\n373:     }\n374: \n375:     public boolean selectTabNamed(String tabName) {\n376:         int index = getIndexOfNamedTab(tabName);\n377:         if (index != -1) {\n378:             _tabs.setSelectedIndex(index);\n379:             return true;\n380:         }\n381:         return false;\n382:     }\n383: \n384:     /**\n385:      * Heper method to add a Property panel for a given class.\n386:      */\n387:     public void addToPropTab(Class c, PropPanel p) {\n388:         for (int i = 0; i < _tabPanels.size(); i++) {\n389:             if (_tabPanels.elementAt(i) instanceof TabProps) {\n390:                 ((TabProps) _tabPanels.elementAt(i)).addPanel(c, p);\n391:             }\n392:         }\n393:     }\n394: \n395:     /**\n396:      * returns the Property panel in the Details Pane.\n397:      */\n398:     public TabProps getTabProps() {\n399:         Iterator iter = _tabPanels.iterator();\n400:         Object o;\n401:         while (iter.hasNext()) {\n402:             o = iter.next();\n403:             if (o instanceof TabProps) {\n404:                 return (TabProps) o;\n405:             }\n406:         }\n407:         return null;\n408:     }\n409: \n410:     \n411: \n412:     \n413: \n414:     ////////////////////////////////////////////////////////////////\n415:     // event handlers\n416: \n417:     /**\n418:      * Reacts to a change in the selected tab by calling\n419:      * \n420:      * refresh() for TabToDoTarget's\n421:      * &\n422:      * setTarget on a  TabModelTarget or TabFigTarget instance\n423:      * \n424:      * old notes: called when the user selects a new tab, by clicking or\n425:      *  otherwise.\n426:      */\n427:     public void stateChanged(ChangeEvent e) {\n428:         cat.debug(\"DetailsPane state changed\");\n429:         Component sel = _tabs.getSelectedComponent();\n430: \n431:         // update the tab\n432:         if (_lastNonNullTab >= 0) {\n433:                     Object tab = _tabPanels.get(_lastNonNullTab);\n434:                     if (tab instanceof TargetListener)\n435:                         removeTargetListener((TargetListener) tab);\n436:                 }\n437:         Object target = TargetManager.getInstance().getTarget();\n438:         \n439:         if (!(sel instanceof TargetListener)) {\n440:             if (sel instanceof TabToDoTarget)\n441:                  ((TabToDoTarget) sel).refresh();\n442: \n443:             else if (sel instanceof TabTarget)\n444:                  ((TabTarget) sel).setTarget(target);\n445:         } else {\n446:             removeTargetListener((TargetListener) sel);\n447:             addTargetListener((TargetListener) sel);\n448:         }\n449:         \n450:         if (target != null\n451:             && ModelFacade.isABase(target)\n452:             && _tabs.getSelectedIndex() > 0)\n453:             _lastNonNullTab = _tabs.getSelectedIndex();\n454: \n455:     }\n456: \n457:     /**\n458:      * no action currently executed here.\n459:      * called when the user clicks once on a tab.\n460:      */\n461:     public void mySingleClick(int tab) {\n462:         //TODO: should fire its own event and ProjectBrowser\n463:         //should register a listener\n464:         cat.debug(\"single: \" + _tabs.getComponentAt(tab).toString());\n465:     }\n466: \n467:     /**\n468:      * Spawns a new tab.\n469:      * called when the user clicks twice on a tab.\n470:      */\n471:     public void myDoubleClick(int tab) {\n472:         //TODO: should fire its own event and ProjectBrowser\n473:         //should register a listener\n474:         cat.debug(\"double: \" + _tabs.getComponentAt(tab).toString());\n475:         JPanel t = (JPanel) _tabPanels.elementAt(tab);\n476:         if (t instanceof TabSpawnable)\n477:              ((TabSpawnable) t).spawn();\n478:     }\n479: \n480:     /**\n481:      * empty, no action taken.\n482:      */\n483:     public void mousePressed(MouseEvent me) {\n484:     }\n485:     /**\n486:      * empty, no action taken.\n487:      */\n488:     public void mouseReleased(MouseEvent me) {\n489:     }\n490:     /**\n491:      * empty, no action taken.\n492:      */\n493:     public void mouseEntered(MouseEvent me) {\n494:     }\n495:     /**\n496:      * empty, no action taken.\n497:      */\n498:     public void mouseExited(MouseEvent me) {\n499:     }\n500: \n501:     /**\n502:      * if(the mouse click is not in the bounds of the tabbed panel)\n503:      *      then call mySingleClick() or myDoubleClick()\n504:      */\n505:     public void mouseClicked(MouseEvent me) {\n506:         int tab = _tabs.getSelectedIndex();\n507:         if (tab != -1) {\n508:             Rectangle tabBounds = _tabs.getBoundsAt(tab);\n509:             if (!tabBounds.contains(me.getX(), me.getY()))\n510:                 return;\n511:             if (me.getClickCount() == 1)\n512:                 mySingleClick(tab);\n513:             else if (me.getClickCount() >= 2)\n514:                 myDoubleClick(tab);\n515:         }\n516:     }\n517: \n518:     /**\n519:      * graphic that goes on the tab label\n520:      */\n521:     protected Icon _upArrowIcon = new UpArrowIcon();\n522: \n523:     /**\n524:      * graphic that goes on the tab label\n525:      */\n526:     protected Icon _leftArrowIcon = new LeftArrowIcon();\n527: \n528:     public int getQuadrant() {\n529:         return Q_BOTTOM_RIGHT;\n530:     }\n531: \n532:     /**\n533:      * Set the orientation of this details pane;\n534:      * @param the required orientation\n535:      */\n536:     public void setOrientation(ignoreSplitters orientation) {\n537:         this.orientation = orientation;\n538:         for (int i = 0; i < _tabPanels.size(); i++) {\n539:             JPanel t = (JPanel) _tabPanels.elementAt(i);\n540:             if (t instanceof Orientable) {\n541:                 Orientable o = (Orientable) t;\n542:                 o.setOrientation(orientation);\n543:             }\n544:         } /* end for */\n545:     }\n546: \n547:     /**\n548:      * @see org.argouml.ui.targetmanager.TargetListener#targetAdded(org.argouml.ui.targetmanager.TargetEvent)\n549:      */\n550:     public void targetAdded(TargetEvent e) {\n551:         // we can neglect this, the detailspane allways selects the first target\n552:         // in a set of targets. The first target can only be \n553:         // changed in a targetRemoved or a TargetSet event\n554:         fireTargetAdded(e);\n555:     }\n556: \n557:     /**\n558:      * @see org.argouml.ui.targetmanager.TargetListener#targetRemoved(org.argouml.ui.targetmanager.TargetEvent)\n559:      */\n560:     public void targetRemoved(TargetEvent e) {\n561:         // how to handle empty target lists?\n562:         // probably the detailspane should only show an empty pane in that case\n563:         setTarget(e.getNewTargets()[0]);\n564:         fireTargetRemoved(e);\n565:     }\n566: \n567:     /**\n568:      * @see org.argouml.ui.targetmanager.TargetListener#targetSet(org.argouml.ui.targetmanager.TargetEvent)\n569:      */\n570:     public void targetSet(TargetEvent e) {\n571:         setTarget(e.getNewTargets()[0]);\n572:         fireTargetSet(e);\n573:     }\n574: \n575:     /**\n576:      * Enables/disables the tabs on the tabbed card. Also selects the tab to \n577:      * show.\n578:      */\n579:     private void enableTabs(Object target) {\n580: \n581:         // iterate through the tabbed panels to determine wether they\n582:         // should be enabled. \n583:         for (int i = 0; i < _tabPanels.size(); i++) {\n584:             JPanel tab = (JPanel) _tabPanels.elementAt(i);\n585:             boolean shouldEnable = false;\n586:             if (tab instanceof TargetListener) {\n587:                 if (tab instanceof TabTarget) {\n588:                     shouldEnable = ((TabTarget) tab).shouldBeEnabled(target);\n589:                 } else {\n590:                     if (tab instanceof TabToDo) {\n591:                         shouldEnable = true;\n592:                     }\n593:                 }\n594:                 if (shouldEnable) {\n595:                     removeTargetListener((TargetListener) tab);\n596:                     addTargetListener((TargetListener) tab);\n597:                 }\n598:             }\n599: \n600:             _tabs.setEnabledAt(i, shouldEnable);\n601: \n602:         }\n603: \n604:     }\n605:     private void fireTargetSet(TargetEvent targetEvent) {\n606:         //          Guaranteed to return a non-null array\n607:         Object[] listeners = _listenerList.getListenerList();\n608:         for (int i = listeners.length - 2; i >= 0; i -= 2) {\n609:             if (listeners[i] == TargetListener.class) {\n610:                 // Lazily create the event:                     \n611:                  ((TargetListener) listeners[i + 1]).targetSet(targetEvent);\n612:             }\n613:         }\n614:     }\n615: \n616:     private void fireTargetAdded(TargetEvent targetEvent) {\n617:         // Guaranteed to return a non-null array\n618:         Object[] listeners = _listenerList.getListenerList();\n619: \n620:         for (int i = listeners.length - 2; i >= 0; i -= 2) {\n621:             if (listeners[i] == TargetListener.class) {\n622:                 // Lazily create the event:                     \n623:                  ((TargetListener) listeners[i + 1]).targetAdded(targetEvent);\n624:             }\n625:         }\n626:     }\n627: \n628:     private void fireTargetRemoved(TargetEvent targetEvent) {\n629:         // Guaranteed to return a non-null array\n630:         Object[] listeners = _listenerList.getListenerList();\n631:         for (int i = listeners.length - 2; i >= 0; i -= 2) {\n632:             if (listeners[i] == TargetListener.class) {\n633:                 // Lazily create the event:                     \n634:                 ((TargetListener) listeners[i + 1]).targetRemoved(targetEvent);\n635:             }\n636:         }\n637:     }\n638: \n639: } /* end class DetailsPane */\n640: \n641: ////////////////////////////////////////////////////////////////\n642: // related classes\n643: \n644: /**\n645:  * class defining a graphic that goes on the tab label\n646:  */\n647: class UpArrowIcon implements Icon {\n648:     public void paintIcon(Component c, Graphics g, int x, int y) {\n649:         int w = getIconWidth(), h = getIconHeight();\n650:         g.setColor(Color.black);\n651:         Polygon p = new Polygon();\n652:         p.addPoint(x, y + h);\n653:         p.addPoint(x + w / 2 + 1, y);\n654:         p.addPoint(x + w, y + h);\n655:         g.fillPolygon(p);\n656:     }\n657:     public int getIconWidth() {\n658:         return 9;\n659:     }\n660:     public int getIconHeight() {\n661:         return 9;\n662:     }\n663: }\n664: \n665: /**\n666:  * class defining a graphic that goes on the tab label\n667:  */\n668: class LeftArrowIcon implements Icon {\n669:     public void paintIcon(Component c, Graphics g, int x, int y) {\n670:         int w = getIconWidth(), h = getIconHeight();\n671:         g.setColor(Color.black);\n672:         Polygon p = new Polygon();\n673:         p.addPoint(x + 1, y + h / 2 + 1);\n674:         p.addPoint(x + w, y);\n675:         p.addPoint(x + w, y + h);\n676:         g.fillPolygon(p);\n677:     }\n678:     public int getIconWidth() {\n679:         return 9;\n680:     }\n681:     public int getIconHeight() {\n682:         return 9;\n683:     }\n684: \n685: }\n686: ",
