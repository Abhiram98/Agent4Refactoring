                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/diagram/static_structure/ui/FigComment.java: \n1: // Copyright (c) 1996-2002 The Regents of the University of California. All\n2: // Rights Reserved. Permission to use, copy, modify, and distribute this\n3: // software and its documentation without fee, and without a written\n4: // agreement is hereby granted, provided that the above copyright notice\n5: // and this paragraph appear in all copies.  This software program and\n6: // documentation are copyrighted by The Regents of the University of\n7: // California. The software program and documentation are supplied \"AS\n8: // IS\", without any accompanying services from The Regents. The Regents\n9: // does not warrant that the operation of the program will be\n10: // uninterrupted or error-free. The end-user understands that the program\n11: // was developed for research purposes and is advised not to rely\n12: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n13: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n14: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n15: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n16: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n17: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n18: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n19: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n20: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n21: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n22: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n23: \n24: // File: FigComment.java\n25: // Classes: FigComment\n26: // Original Author: a_rueckert@gmx.net\n27: // $Id$\n28: \n29: package org.argouml.uml.diagram.static_structure.ui;\n30: \n31: import java.awt.*;\n32: import java.awt.event.*;\n33: import java.util.*;\n34: import java.beans.*;\n35: import javax.swing.*;\n36: import javax.swing.plaf.metal.MetalLookAndFeel;\n37: import ru.novosoft.uml.foundation.core.*;\n38: \n39: import ru.novosoft.uml.*;\n40: import ru.novosoft.uml.behavior.state_machines.*;\n41: \n42: import org.tigris.gef.base.*;\n43: import org.tigris.gef.presentation.*;\n44: import org.tigris.gef.graph.*;\n45: \n46: import org.apache.log4j.Category;\n47: import org.argouml.kernel.*;  \n48: import org.argouml.ui.*;\n49: import org.argouml.uml.diagram.ui.*;\n50: import org.argouml.uml.diagram.state.*;\n51: import org.argouml.uml.diagram.state.ui.*;\n52: import org.argouml.model.uml.UmlFactory;\n53: \n54: \n55: /** \n56:  * Class to display a UML note in a diagram \n57:  * Since we don't need stereotypes for the note and an\n58:  * empty stereotype textfield causes problems with the\n59:  * note layout, I subclass FigNode instead of FigNodeModelElement.\n60:  */\n61: public class FigComment extends FigNodeModelElement implements VetoableChangeListener, DelayedVChangeListener, MouseListener, KeyListener, PropertyChangeListener {\n62:     protected static Category cat = Category.getInstance(FigComment.class);\n63: \n64: \n65:     ////////////////////////////////////////////////////////////////\n66:     // constants\n67: \n68:     // public final int MARGIN = 2;\n69:     public int x = 0;\n70:     public int y = 0;\n71:     public int width = 80;\n72:     public int height = 60;\n73:     public int gapY = 10;\n74: \n75:     protected boolean _readyToEdit = true;     \n76: \n77:     public static Font LABEL_FONT;\n78:     public static Font ITALIC_LABEL_FONT;\n79:     public final int MARGIN = 2;\n80: \n81:     static {\n82: \tLABEL_FONT = MetalLookAndFeel.getSubTextFont();\n83: \tITALIC_LABEL_FONT = new Font(LABEL_FONT.getFamily(),\n84: \t\t\t\t     Font.ITALIC, LABEL_FONT.getSize());\n85:     }                                                                     \n86: \n87:     ////////////////////////////////////////////////////////////////\n88:     // instance variables\n89: \n90:     // The model element the note is attached to.\n91:     private MModelElement _noteOwner = null;\n92: \n93:     // The figure that holds the text of the note.\n94:     FigText _text;\n95: \n96:     /** UML does not really use ports, so just define one big one so\n97:      *  that users can drag edges to or from any point in the icon. */\n98:     FigRect _bigPort;\n99: \n100:     FigPoly _body;\n101:     FigPoly _urCorner;\n102: \n103:     ////////////////////////////////////////////////////////////////\n104:     // constructors\n105: \n106:     public FigComment() {\n107: \t_body = new FigPoly( Color.black, Color.white);\n108: \t_body.addPoint(x, y);\n109: \t_body.addPoint(x + width - 1 - gapY, y);\n110: \t_body.addPoint(x + width - 1, y + gapY);\n111: \t_body.addPoint(x + width - 1, y + height - 1);\n112: \t_body.addPoint(x, y + height - 1);\n113: \t_body.addPoint(x, y);\n114: \t_body.setFilled(true);\n115: \t_body.setLineWidth(1);\n116: \t\n117: \t_urCorner = new FigPoly(Color.black, Color.white);\n118: \t_urCorner.addPoint(x + width - 1 - gapY, y);\n119: \t_urCorner.addPoint(x + width - 1, y + gapY);\n120: \t_urCorner.addPoint(x + width - 1 - gapY, y + gapY);\n121: \t_urCorner.addPoint(x + width - 1 - gapY, y);\n122: \t_urCorner.setFilled(true);\n123: \t_urCorner.setLineWidth(1);\n124: \n125: \t_bigPort = new FigRect(x, y, width, height, null, null);     \n126: \t_bigPort.setFilled(false);\n127: \t_bigPort.setLineWidth(0);\n128: \n129: \t_text = new FigText(2, 2, width - 2 - gapY, height - 4, true);\n130: \t_text.setFont(LABEL_FONT);\n131: \t_text.setTextColor(Color.black);\n132: \t_text.setMultiLine(true);\n133: \t_text.setAllowsTab(false);\n134: \t// _text.setText(placeString());        \n135: \t_text.setJustification(FigText.JUSTIFY_LEFT);\n136: \t_text.setFilled(false);\n137: \t_text.setLineWidth(0);\n138: \t//_text.setLineColor(Color.white);\n139: \n140: \t// add Figs to the FigNode in back-to-front order\n141: \taddFig(_bigPort); \n142: \taddFig(_body);\n143: \taddFig(_urCorner);\n144: \taddFig(_text);\n145: \n146: \tsetBlinkPorts(false); //make port invisble unless mouse enters\n147: \tRectangle r = getBounds();\n148: \tsetBounds(r.x, r.y, r.width, r.height);\n149: \tupdateEdges();\n150: \n151: \t_readyToEdit = false;\n152:     }\n153: \n154:     /**\n155:      * Construct a new note\n156:      *\n157:      * @param gm The graphmodel\n158:      * @param node The underlying MComment node\n159:      */\n160:     public FigComment(GraphModel gm, Object node) {\n161: \tthis();\n162: \tsetOwner(node);\n163: \tupdateNameText();\n164:     }\n165: \n166:     /**\n167:      * Create a note for a given model element.\n168:      *\n169:      * @param element The annotated model element.\n170:      */\n171:     public FigComment(MModelElement element) {\n172: \tthis();                                     // Construct the figure.\n173: \tMComment node = UmlFactory.getFactory().getCore().createComment();         // Create a new Comment node.\n174: \tsetOwner(node);                             // Set it as the owner of the figure.\n175: \telement.addComment(node);                   // Tell the annotated element, that it has a comment now.\n176: \n177: \t// Notes in state diagrams need a special treatment, cause\n178: \t// the nodes in them don't necessary have a namespace, where\n179: \t// we could add the note. So I added this hack... :-(\n180: \t// Andreas Rueckert <a_rueckert@gmx.net>\n181: \tif(element instanceof MStateVertex) { \n182: \n183: \t    ProjectBrowser pb = ProjectBrowser.TheInstance;    // If the current target is a state diagram, we have to\n184: \t    if (pb.getTarget() instanceof UMLStateDiagram) {   // check, if we are editing the diagram.\n185: \t\tStateDiagramGraphModel gm = (StateDiagramGraphModel)(((UMLStateDiagram)pb.getTarget()).getGraphModel());\n186: \t\tnode.setNamespace(gm.getNamespac