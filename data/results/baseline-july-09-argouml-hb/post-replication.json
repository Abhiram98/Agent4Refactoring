ing sClsSpec = \"\";\n1570: \n1571:         if (ModelFacade.isAClass(modelElement)) {\n1572:             Collection colSpecifications =\n1573:                     ModelFacade.getSpecifications(modelElement);\n1574:             if (colSpecifications != null) {\n1575:                 Iterator itSpecifications = colSpecifications.iterator();\n1576:                 if (itSpecifications.hasNext()) {\n1577:                     if (iLanguageMajorVersion < 5) {\n1578:                         sClsSpec += INDENT + INDENT + \"/* specifications are \"\n1579:                                 + \"not supported by PHP versions before 5.0 \"\n1580:                                 + \"*/\\n\";\n1581:                     }\n1582:                     sClsSpec += INDENT + INDENT;\n1583:                     if (iLanguageMajorVersion < 5) {\n1584:                         sClsSpec += \"/* \";\n1585:                     }\n1586:                     sClsSpec += \"implements \";\n1587: \n1588:                     while (itSpecifications.hasNext()) {\n1589:                         Object ifSpecification = itSpecifications.next();\n1590:                         sClsSpec += NameGenerator.generate(ifSpecification,\n1591:                                 iLanguageMajorVersion);\n1592: \n1593:                         if (itSpecifications.hasNext()) {\n1594:                             sClsSpec += \",\\n\" + INDENT + INDENT + \"           \";\n1595:                         }\n1596:                     }\n1597: \n1598:                     if (iLanguageMajorVersion < 5) {\n1599:                         sClsSpec += \" */\";\n1600:                     }\n1601: \n1602:                     sClsSpec += \"\\n\";\n1603:                 }\n1604:             }\n1605:         }\n1606: \n1607:         return sClsSpec;\n1608:     }\n1609: \n1610:     /**\n1611:      * Generates single require_once statement for class or interface\n1612:      *\n1613:      * @param modelElement The required class or interface.\n161