ow;\n33: import java.awt.event.WindowAdapter;\n34: import java.awt.event.WindowEvent;\n35: import java.beans.PropertyChangeEvent;\n36: import java.beans.PropertyChangeListener;\n37: import java.io.File;\n38: import java.io.IOException;\n39: import java.io.PrintWriter;\n40: import java.io.StringWriter;\n41: import java.net.URL;\n42: import java.text.MessageFormat;\n43: import java.util.Collection;\n44: import java.util.HashMap;\n45: import java.util.Iterator;\n46: import java.util.Locale;\n47: import java.util.Map;\n48: import java.util.Vector;\n49: \n50: import javax.swing.Action;\n51: import javax.swing.ImageIcon;\n52: import javax.swing.JDialog;\n53: import javax.swing.JFileChooser;\n54: import javax.swing.JFrame;\n55: import javax.swing.JMenuBar;\n56: import javax.swing.JOptionPane;\n57: import javax.swing.JPanel;\n58: \n59: import org.apache.log4j.Logger;\n60: import org.argouml.application.api.Argo;\n61: import org.argouml.application.api.Configuration;\n62: import org.argouml.application.helpers.ResourceLoaderWrapper;\n63: import org.argouml.cognitive.Designer;\n64: import org.argouml.cognitive.ui.TabToDo;\n65: import org.argouml.cognitive.ui.ToDoPane;\n66: import org.argouml.i18n.Translator;\n67: import org.argouml.kernel.Project;\n68: import org.argouml.kernel.ProjectManager;\n69: import org.argouml.model.Model;\n70: import org.argouml.persistence.AbstractFilePersister;\n71: import org.argouml.persistence.LastLoadInfo;\n72: import org.argouml.persistence.OpenException;\n73: import org.argouml.persistence.PersistenceManager;\n74: import org.argouml.persistence.ProjectFilePersister;\n75: import org.argouml.persistence.UmlVersionException;\n76: import org.argouml.persistence.VersionException;\n77: import org.argouml.persistence.XmiFormatException;\n78: import org.argouml.swingext.ProgressMonitorWindow;\n79: import org.argouml.swingext.LoadSwingWorker;\n80: import org.argouml.swingext.SaveSwingWorker;\n81: import org.argouml.ui.cmd.GenericArgoMenuBar;\n82: import org.argouml.ui.targetmanager.TargetEvent;\n83: import org.argouml.ui.targetmanager.TargetListener;\n84: import org.argouml.ui.targetmanager.TargetManager;\n85: import org.argouml.uml.diagram.DiagramFactory;\n86: import org.argouml.uml.diagram.UMLMutableGraphSupport;\n87: import org.argouml.uml.diagram.ui.ActionRemoveFromDiagram;\n88: import org.argouml.uml.ui.ActionSaveProject;\n89: import org.argouml.uml.ui.ProjectFileView;\n90: import org.argouml.uml.ui.TabProps;\n91: import org.argouml.util.ThreadUtils;\n92: import org.tigris.gef.base.Diagram;\n93: import org.tigris.gef.base.Editor;\n94: import org.tigris.gef.base.Globals;\n95: import org.tigris.gef.graph.GraphModel;\n96: import org.tigris.gef.presentation.Fig;\n97: import org.tigris.gef.ui.IStatusBar;\n98: import org.tigris.gef.undo.RedoAction;\n99: import org.tigris.gef.undo.UndoAction;\n100: import org.tigris.gef.undo.UndoManager;\n101: import org.tigris.swidgets.BorderSplitPane;\n102: import org.tigris.swidgets.Horizontal;\n103: import org.tigris.swidgets.Orientation;\n104: import org.tigris.swidgets.Vertical;\n105: import org.tigris.toolbar.layouts.DockBorderLayout;\n106: \n107: /**\n108:  * The main window of the ArgoUML application.\n109:  *\n110:  * @stereotype singleton\n111:  */\n112: public final class ProjectBrowser\n113:     extends JFrame\n114:     implements IStatusBar, PropertyChangeListener, TargetListener {\n115: \n116:     /**\n117:      * Default width.\n118:      */\n119:     public static final int DEFAULT_COMPONENTWIDTH = 220;\n120: \n121:     /**\n122:      * Default height.\n123:      */\n124:     public static final int DEFAULT_COMPONENTHEIGHT = 200;\n125: \n126:     /**\n127:      * Logger.\n128:      */\n129:     private static final Logger LOG =\n130:         Logger.getLogger(ProjectBrowser.class);\n131: \n132:     ////////////////////////////////////////////////////////////////\n133:     // class variables\n134: \n135:     /**\n136:      * Member attribute to contain the singleton.\n137:      */\n138:     private static ProjectBrowser theInstance;\n139: \n140:     ////////////////////////////////////////////////////////////////\n141:     // instance variables\n142: \n143:     private String appName = \"ProjectBrowser\";\n144: \n145:     private MultiEditorPane editorPane;\n146: \n147:     /*\n148:      * TODO: Work in progress here to allow multiple details panes with\n149:      * different contents - Bob Tarling\n150:      */\n151:     private DetailsPane northEastPane;\n152:     private DetailsPane northPane;\n153:     private DetailsPane northWestPane;\n154:     private DetailsPane eastPane;\n155:     private DetailsPane southEastPane;\n156:     private DetailsPane southPane;\n157: \n158:     private Map detailsPanesByCompassPoint = new HashMap();\n159: \n160:     private GenericArgoMenuBar menuBar;\n161: \n162:     /**\n163:      * Partially implemented. Needs work to display\n164:      * import of source and saving of zargo.\n165:      */\n166:     private StatusBar statusBar = new StatusBar();\n167: \n168:     /**\n169:      * TODO: this needs work so that users can set the font\n170:      * size through a gui preference window.\n171:      */\n172:     private Font defaultFont = new Font(\"Dialog\", Font.PLAIN, 10);\n173: \n174:     private BorderSplitPane workAreaPane;\n175: \n176:     /**\n177:      * The explorer (formerly called navigator) pane\n178:      * containing the modelstructure.\n179:      */\n180:     private NavigatorPane explorerPane;\n181: \n182:     /**\n183:      * The todopane (lower left corner of screen).\n184:      */\n185:     private ToDoPane todoPane;\n186: \n187:     /**\n188:      * A class that handles the title of this frame, \n189:      * e.g. to indicate save status.\n190:      */\n191:     private TitleHandler titleHandler = new TitleHandler();\n192: \n193:     /**\n194:      * The action to save the current project.\n195:      */\n196:     private Action saveAction;\n197: \n198:     /**\n199:      * The action to redo the last undone action.\n200:      */\n201:     private final Action redoAction =\n202:         new RedoAction(Translator.localize(\"action.redo\"));\n203: \n204:     /**\n205:      * The action to undo the last user interaction.\n206:      */\n207:     private final UndoAction undoAction =\n208:         new UndoAction(Translator.localize(\"action.undo\"));\n209: \n210:     /**\n211:      * The action to remove the current selected Figs from the diagram.\n212:      */\n213:     private final ActionRemoveFromDiagram removeFromDiagram =\n214:         new ActionRemoveFromDiagram(\n215:                 Translator.localize(\"action.remove-from-diagram\"));\n216: \n217:     /**\n218:      * For testing purposes. In tests this constructor can be called so\n219:      * TheInstance is filled.\n220:      */\n221:     private ProjectBrowser() {\n222:         this(\"ArgoUML\", null);\n223:     }\n224: \n225:     /**\n226:      * The constructor.\n227:      *\n228:      * @param applicationName  the title of the frame\n229:      * @param splash the splash screen to show at startup\n230:      */\n231:     private ProjectBrowser(String applicationName, SplashScreen splash) {\n232:         super(applicationName);\n233:         theInstance = this;\n234: \n235:         saveAction = new ActionSaveProject();\n236:         ProjectManager.getManager().setSaveAction(saveAction);\n237: \n238:         if (splash != null) {\n239: \t    splash.getStatusBar().showStatus(\n240: \t        Translator.localize(\"statusmsg.bar.making-project-browser\"));\n241:             splash.getStatusBar().showProgress(10);\n242:             splash.setVisible(true);\n243:         }\n244: \n245:         menuBar = new GenericArgoMenuBar();\n246: \n247:         editorPane = new MultiEditorPane();\n248:         getContentPane().setFont(defaultFont);\n249:         getContentPane().setLayout(new BorderLayout());\n250:         this.setJMenuBar(menuBar);\n251:         //getContentPane().add(_menuBar, BorderLayout.NORTH);\n252:         getContentPane().add(createPanels(splash), BorderLayout.CENTER);\n253:         getContentPane().add(statusBar, BorderLayout.SOUTH);\n254: \n255:         setAppName(applicationName);\n256: \n257:         // allows me to ask \"Do you want to save first?\"\n258:         setDefaultCloseOperation(ProjectBrowser.DO_NOTHING_ON_CLOSE);\n259:         addWindowListener(new WindowCloser());\n260:         ImageIcon argoImage =\n261:             ResourceLoaderWrapper.lookupIconResource(\"ArgoIcon\");\n262:         this.setIconImage(argoImage.getImage());\n263:         //\n264: \n265:         // adds this as listener to projectmanager so it gets updated when the\n266:         // project changes\n267:         ProjectManager.getManager().addPropertyChangeListener(this);\n268: \n269:         // adds this as listener to TargetManager so gets notified\n270:         // when the active diagram changes\n271:         TargetManager.getInstance().addTargetListener(this);\n272: \n273:         // Add a listener to focus changes.\n274:         // Rationale: reset the undo manager to start a new chain.\n275:         KeyboardFocusManager kfm =\n276:             KeyboardFocusManager.getCurrentKeyboardFocusManager();\n277:         kfm.addPropertyChangeListener(new PropertyChangeListener() {\n278:             private Object obj;\n279: \n280:             /**\n281:              * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n282:              */\n283:             public void propertyChange(PropertyChangeEvent evt) {\n284:                 if (\"focusOwner\".equals(evt.getPropertyName())\n285:                         && (evt.getNewValue() != null)\n286:                         /* We get many many events (why?), so let's filter: */\n287:                         && (obj != evt.getNewValue())) {\n288:                     obj = evt.getNewValue();\n289:                     UndoManager.getInstance().startChain();\n290:                     /* This next line is ideal for debugging the taborder\n291:                      * (focus traversal), see e.g. issue 1849.\n292:                      */\n293: //                  System.out.println(\"Focus changed \" + obj);\n294:                 }\n295:             }\n296:         });\n297:     }\n298: \n299:     /**\n300:      * Singleton retrieval method for the projectbrowser. Lazely instantiates\n301:      * the projectbrowser.\n302:      * @return the singleton instance of the projectbrowser\n303:      */\n304:     public static synchronized ProjectBrowser getInstance() {\n305:         if (theInstance == null) {\n306:             theInstance = new ProjectBrowser();\n307:         }\n308:         return theInstance;\n309:     }\n310: \n311:     /**\n312:      * Creator method for the projectbrowser.\n313:      *\n314:      * @return the singleton instance of the projectbrowser\n315:      *\n316:      * @param splash true if we are allowed to show a splash screen\n317:      */\n318:     public static ProjectBrowser makeInstance(SplashScreen splash) {\n319:         return new ProjectBrowser(\"ArgoUML\", splash);\n320:     }\n321: \n322:     /**\n323:      * @see java.awt.Component#getLocale()\n324:      */\n325:     public Locale getLocale() {\n326:         return Locale.getDefault();\n327:     }\n328: \n329: \n330:     /**\n331:      * Creates the panels in the working area.\n332:      *\n333:      * @param splash true if we show  the splashscreen during startup\n334:      * @return Component the area between the menu and the statusbar.\n335:      *                   It contains the workarea at centre and the toolbar\n336:      *                   position north, south, east or west.\n337:      *\n338:      */\n339:     protected Component createPanels(SplashScreen splash) {\n340:         if (splash != null) {\n341: \t    splash.getStatusBar().showStatus(\n342: \t            Translator.localize(\n343: \t                    \"statusmsg.bar.making-project-browser-explorer\"));\n344:             splash.getStatusBar().incProgress(5);\n345:         }\n346:         explorerPane = new NavigatorPane(splash);\n347: \n348:         /* Work in progress here to allow multiple details panes with\n349:         ** different contents - Bob Tarling\n350:         */\n351:         eastPane  =\n352: \t    makeDetailsPane(BorderSplitPane.EAST,  Vertical.getInstance());\n353:         southPane =\n354: \t    makeDetailsPane(BorderSplitPane.SOUTH, Horizontal.getInstance());\n355:         southEastPane =\n356: \t    makeDetailsPane(BorderSplitPane.SOUTHEAST,\n357: \t\t\t    Horizontal.getInstance());\n358:         northWestPane =\n359: \t    makeDetailsPane(BorderSplitPane.NORTHWEST,\n360: \t\t\t    Horizontal.getInstance());\n361:         northPane =\n362: \t    makeDetailsPane(BorderSplitPane.NORTH, Horizontal.getInstance());\n363:         northEastPane =\n364: \t    makeDetailsPane(BorderSplitPane.NORTHEAST,\n365: \t\t\t    Horizontal.getInstance());\n366: \n367:         if (southPane != null) {\n368:             detailsPanesByCompassPoint.put(BorderSplitPane.SOUTH, southPane);\n369:         }\n370:         if (southEastPane != null) {\n371:             detailsPanesByCompassPoint.put(BorderSplitPane.SOUTHEAST,\n372: \t\t\t\t\t   southEastPane);\n373:         }\n374:         if (eastPane != null) {\n375:             detailsPanesByCompassPoint.put(BorderSplitPane.EAST, eastPane);\n376:         }\n377:         if (northWestPane != null) {\n378:             detailsPanesByCompassPoint.put(BorderSplitPane.NORTHWEST,\n379: \t\t\t\t\t   northWestPane);\n380:         }\n381:         if (northPane != null) {\n382:             detailsPanesByCompassPoint.put(BorderSplitPane.NORTH, northPane);\n383:         }\n384:         if (northEastPane != null) {\n385:             detailsPanesByCompassPoint.put(BorderSplitPane.NORTHEAST,\n386: \t\t\t\t\t   northEastPane);\n387:         }\n388: \n389:         // The workarea is all the visible space except the menu,\n390:         // toolbar and status bar.  Workarea is layed out as a\n391:         // BorderSplitPane where the various components that make up\n392:         // the argo application can be positioned.\n393:         workAreaPane = new BorderSplitPane();\n394:         // create the todopane\n395:         if (splash != null) {\n396: \t    splash.getStatusBar().showStatus(Translator.localize(\n397: \t\t    \"statusmsg.bar.making-project-browser-to-do-pane\"));\n398:             splash.getStatusBar().incProgress(5);\n399:         }\n400:         todoPane = new ToDoPane(splash);\n401:         restorePanelSizes();\n402: \n403:         // There are various details panes all of which could hold\n404:         // different tabs pages according to users settings.\n405:         // Place each pane in the required border area.\n406:         Iterator it = detailsPanesByCompassPoint.entrySet().iterator();\n407:         while (it.hasNext()) {\n408:             Map.Entry entry = (Map.Entry) it.next();\n409:             String position = (String) entry.getKey();\n410:             if (entry.getValue() instanceof DetailsPane) {\n411:                 DetailsPane detailsPane = (DetailsPane) entry.getValue();\n412:                 TargetManager.getInstance().addTargetListener(detailsPane);\n413:             }\n414:             addPanel((Component) entry.getValue(), position);\n415:         }\n416:         addPanel(explorerPane, BorderSplitPane.WEST);\n417: \n418:         getTab(TabToDo.class); // TODO: If this doesn't have side effects,\n419:                                //       it can be removed alltogether.\n420:         //todo.setTree(_todoPane);\n421:         addPanel(todoPane, BorderSplitPane.SOUTHWEST);\n422:         addPanel(editorPane, BorderSplitPane.CENTER);\n423:         // Toolbar boundry is the area between the menu and the status\n424:         // bar. It contains the workarea at centre and the toolbar\n425:         // position north, south, east or west.\n426:         JPanel toolbarBoundry = new JPanel();\n427:         toolbarBoundry.setLayout(new DockBorderLayout());\n428:         // TODO: - should save and restore the last positions of the toolbars\n429:         toolbarBoundry.add(menuBar.getFileToolbar(), BorderLayout.NORTH);\n430:         toolbarBoundry.add(menuBar.getEditToolbar(), BorderLayout.NORTH);\n431:         toolbarBoundry.add(menuBar.getViewToolbar(), BorderLayout.NORTH);\n432:         toolbarBoundry.add(menuBar.getCreateDiagramToolbar(),\n433: \t\t\t   BorderLayout.NORTH);\n434:         toolbarBoundry.add(workAreaPane, BorderLayout.CENTER);\n435: \n436:         return toolbarBoundry;\n437:     }\n438: \n439:     /**\n440:      * Add a panel to a split pane area.\n441:      *\n442:      * @param comp the panel to add\n443:      * @param obj the position (BorderSplitPane.EAST etc)\n444:      */\n445:     void addPanel(Component comp, Object obj) {\n446:         workAreaPane.add(comp, obj);\n447:     }\n448: \n449:     /**\n450:      * Remove a panel from a split pane area.\n451:      *\n452:      * @param comp the panel to remove\n453:      */\n454:     void removePanel(Component comp) {\n455:         workAreaPane.remove(comp);\n456:         workAreaPane.validate();\n457:         workAreaPane.repaint();\n458:     }\n459: \n460:     /**\n461:      * Set the size of each panel to that last saved in the configuration file.\n462:      */\n463:     private void restorePanelSizes() {\n464:         if (northPane != null) {\n465:             northPane.setPreferredSize(\n466: \t\t    new Dimension(0,\n467: \t\t\t\t  Configuration.getInteger(\n468: \t\t\t\t\t  Argo.KEY_SCREEN_NORTH_HEIGHT,\n469: \t\t\t\t\t  DEFAULT_COMPONENTHEIGHT)));\n470:         }\n471:         if (southPane != null) {\n472:             southPane.setPreferredSize(\n473: \t\t    new Dimension(0,\n474: \t\t\t\t  Configuration.getInteger(\n475: \t\t\t\t\t  Argo.KEY_SCREEN_SOUTH_HEIGHT,\n476: \t\t\t\t\t  DEFAULT_COMPONENTHEIGHT)));\n477:         }\n478:         if (eastPane != null) {\n479:             eastPane.setPreferredSize(\n480: \t\t    new Dimension(Configuration.getInteger(\n481: \t\t\t\t\t  Argo.KEY_SCREEN_EAST_WIDTH,\n482: \t\t\t\t\t  DEFAULT_COMPONENTHEIGHT),\n483: \t\t\t\t  0));\n484:         }\n485:         if (explorerPane != null) {\n486:             explorerPane.setPreferredSize(\n487: \t\t    new Dimension(Configuration.getInteger(\n488: \t\t\t\t\t  Argo.KEY_SCREEN_WEST_WIDTH,\n489: \t\t\t\t\t  DEFAULT_COMPONENTHEIGHT),\n490: \t\t\t\t  0));\n491:         }\n492: \t//        if (_northWestPane != null) {\n493: \t//            _northWestPane.setPreferredSize(new Dimension(\n494: \t//                Configuration.getInteger(\n495: \t// Argo.KEY_SCREEN_NORTHWEST_WIDTH, DEFAULT_COMPONENTWIDTH),\n496: \t//                Configuration.getInteger(\n497: \t// Argo.KEY_SCREEN_NORTH_HEIGHT, DEFAULT_COMPONENTHEIGHT)\n498: \t//            ));\n499: \t//        }\n500: \t//        if (_todoPane != null) {\n501: \t//            _todoPane.setPreferredSize(new Dimension(\n502: \t//                Configuration.getInteger(\n503: \t// Argo.KEY_SCREEN_SOUTHWEST_WIDTH, DEFAULT_COMPONENTWIDTH),\n504: \t//                Configuration.getInteger(\n505: \t// Argo.KEY_SCREEN_SOUTH_HEIGHT, DEFAULT_COMPONENTHEIGHT)\n506: \t//            ));\n507: \t//        }\n508: \t//        if (_northEastPane != null) {\n509: \t//            _northEastPane.setPreferredSize(new Dimension(\n510: \t//                Configuration.getInteger(\n511: \t// Argo.KEY_SCREEN_NORTHEAST_WIDTH, DEFAULT_COMPONENTWIDTH),\n512: \t//                Configuration.getInteger(\n513: \t// Argo.KEY_SCREEN_NORTH_HEIGHT, DEFAULT_COMPONENTHEIGHT)\n514: \t//            ));\n515: \t//        }\n516: \t//        if (_southEastPane != null) {\n517: \t//            _southEastPane.setPreferredSize(new Dimension(\n518: \t//                Configuration.getInteger(\n519: \t// Argo.KEY_SCREEN_SOUTHEAST_WIDTH, DEFAULT_COMPONENTWIDTH),\n520: \t//                Configuration.getInteger(\n521: \t// Argo.KEY_SCREEN_SOUTH_HEIGHT, DEFAULT_COMPONENTHEIGHT)\n522: \t//            ));\n523: \t//        }\n524:     }\n525: \n526:     /**\n527:      * Handle the title-bar of the window.\n528:      * \n529:      * @author michiel\n530:      */\n531:     private class TitleHandler implements PropertyChangeListener {\n532:         \n533:         private ArgoDiagram monitoredDiagram = null;\n534: \n535:         /**\n536:          * Create a title for the main window's title.\n537:          *\n538:          * @param projectFileName the project-file name\n539:          * @param activeDiagram the (new) current diagram\n540:          */\n541:         protected void buildTitle(String projectFileName, \n542:                 ArgoDiagram activeDiagram) {\n543:             if (projectFileName == null || \"\".equals(projectFileName)) {\n544:                 if (ProjectManager.getManager().getCurrentProject() != null) {\n545:                     projectFileName = ProjectManager.getManager()\n546:                         .getCurrentProject().getName();\n547:                 }\n548:             }\n549:             if (activeDiagram == null) {\n550:                 activeDiagram = ProjectManager.getManager()\n551:                     .getCurrentProject().getActiveDiagram();\n552:             }\n553:             String changeIndicator = \"\";\n554:             if (saveAction != null && saveAction.isEnabled()) {\n555:                 changeIndicator = \" *\";\n556:             }\n557:             if (activeDiagram != null) {\n558:                 if (monitoredDiagram != null) {\n559:                     monitoredDiagram.removePropertyChangeListener(\"name\", this);\n560:                 }\n561:                 activeDiagram.addPropertyChangeListener(\"name\", this);\n562:                 monitoredDiagram = activeDiagram;\n563:                 setTitle(projectFileName + \" - \" + activeDiagram.getName()\n564:                         + \" - \" + getAppName() + changeIndicator);\n565:             } else {\n566:                 setTitle(projectFileName + \" - \" + getAppName() \n567:                         + changeIndicator);\n568:             }\n569:         }\n570:         /**\n571:          * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n572:          */\n573:         public void propertyChange(PropertyChangeEvent evt) {\n574:             if (evt.getPropertyName().equals(\"name\")\n575:                     && evt.getSource() instanceof ArgoDiagram) {\n576:                 buildTitle(\n577:                     ProjectManager.getManager().getCurrentProject().getName(), \n578:                     (ArgoDiagram) evt.getSource());\n579:             }            \n580:         }\n581:     }\n582:     /**\n583:      * Set the save indicator (the * after the title) to appear depending on\n584:      * the curreny save action enabled status.\n585:      */\n586:     public void showSaveIndicator() {\n587:         titleHandler.buildTitle(null, null);\n588:     }\n589: \n590:     /**\n591:      * @return the application name (\"ArgoUML\") as shown in the titlebar\n592:      */\n593:     public String getAppName() {\n594:         return appName;\n595:     }\n596: \n597:     /**\n598:      * @param n the application name (\"ArgoUML\") as shown in the titlebar\n599:      */\n600:     public void setAppName(String n) {\n601:         appName = n;\n602:     }\n603: \n604:     /**\n605:      * The method used by the NavigatorPane, MultiEditor and DetailsPane\n606:      * to set the target of the application.<p>\n607:      *\n608:      * the target is either a Model Element (usually selected in\n609:      * the Navigation pane or Properties panel) or a Fig (selected in\n610:      * a diagram).<p>\n611:      *\n612:      * The concept of a selection transaction is used to prevent a change\n613:      * of target in one view creating a call back to this method, which\n614:      * would then change the target in all views again...<p>\n615:      *\n616:      * @param o the target\n617:      */\n618:     private void setTarget(Object o) {\n619:         TargetManager.getInstance().setTarget(o);\n620:     }\n621: \n622:     /**\n623:      * Select the tab page containing the todo item.\n624:      *\n625:      * TODO: should introduce an instance variable to go straight to\n626:      * the correct tab instead of trying all\n627:      *\n628:      * @param o the todo item to select\n629:      */\n630:     public void setToDoItem(Object o) {\n631:         Iterator it = detailsPanesByCompassPoint.values().iterator();\n632:         while (it.hasNext()) {\n633:             DetailsPane detailsPane = (DetailsPane) it.next();\n634:             if (detailsPane.setToDoItem(o)) {\n635:                 return;\n636:             }\n637:         }\n638:     }\n639: \n640:     /**\n641:      * Get the tab page containing the properties.\n642:      *\n643:      * @return the TabProps tabpage\n644:      */\n645:     public TabProps getTabProps() {\n646:         // In theory there can be multiple details pane (work in\n647:         // progress). It must first be determined which details\n648:         // page contains the properties tab. Bob Tarling 7 Dec 2002\n649:         Iterator it = detailsPanesByCompassPoint.values().iterator();\n650:         while (it.hasNext()) {\n651:             DetailsPane detailsPane = (DetailsPane) it.next();\n652:             TabProps tabProps = detailsPane.getTabProps();\n653:             if (tabProps != null) {\n654:                 return tabProps;\n655:             }\n656:         }\n657:         throw new IllegalStateException(\"No properties tab found\");\n658:     }\n659: \n660:     /**\n661:      * Get the tab page instance of the given class.\n662:      *\n663:      * @param tabClass the given class\n664:      * @return the tabpage\n665:      */\n666:     public AbstractArgoJPanel getTab(Class tabClass) {\n667:         // In theory there can be multiple details pane (work in\n668:         // progress). It must first be determined which details\n669:         // page contains the properties tab. Bob Tarling 7 Dec 2002\n670:         Iterator it = detailsPanesByCompassPoint.values().iterator();\n671:         while (it.hasNext()) {\n672:             DetailsPane detailsPane = (DetailsPane) it.next();\n673:             AbstractArgoJPanel tab = detailsPane.getTab(tabClass);\n674:             if (tab != null) {\n675:                 return tab;\n676:             }\n677:         }\n678:         throw new IllegalStateException(\"No \" + tabClass.getName()\n679: \t\t\t\t\t+ \" tab found\");\n680:     }\n681: \n682:     /**\n683:      * @return the status bar\n684:      */\n685:     public StatusBar getStatusBar() {\n686:         return statusBar;\n687:     }\n688: \n689:     /**\n690:      * @see javax.swing.JFrame#getJMenuBar()\n691:      */\n692:     public JMenuBar getJMenuBar() {\n693:         return menuBar;\n694:     }\n695: \n696:     /**\n697:      * @return the editor pane\n698:      */\n699:     public MultiEditorPane getEditorPane() {\n700:         return editorPane;\n701:     }\n702: \n703:     /**\n704:      * Find the tabpage with the given label and make it the front tab.\n705:      *\n706:      * @param tabName The tabpage label\n707:      */\n708:     public void selectTabNamed(String tabName) {\n709:         Iterator it = detailsPanesByCompassPoint.values().iterator();\n710:         while (it.hasNext()) {\n711:             DetailsPane detailsPane = (DetailsPane) it.next();\n712:             if (detailsPane.selectTabNamed(Translator.localize(tabName))) {\n713:                 return;\n714:             }\n715:         }\n716:         throw new IllegalArgumentException(\"No such tab named \" + tabName);\n717:     }\n718: \n719:     /**\n720:      * Find the tabpage with the given label.\n721:      *\n722:      * @param tabName The tabpage label\n723:      * @return the tabpage\n724:      */\n725:     public JPanel getNamedTab(String tabName) {\n726:         JPanel panel;\n727:         Iterator it = detailsPanesByCompassPoint.values().iterator();\n728:         while (it.hasNext()) {\n729:             DetailsPane detailsPane = (DetailsPane) it.next();\n730:             panel = detailsPane.getNamedTab(tabName);\n731:             if (panel != null) {\n732:                 return panel;\n733:             }\n734:         }\n735:         //TODO: I'd prefer to throw this exception here but doing Argo currently\n736:         //falls over - needs more investigation Bob Tarling 8 Dec 2002\n737:         //throw new IllegalArgumentException(\"No such tab named \" + tabName);\n738:         return null;\n739:     }\n740: \n741:     /**\n742:      * Given a list of targets, displays the according diagram.\n743:      * This method jumps to the diagram showing the targets,\n744:      * and scrolls to make it visible.\n745:      *\n746:      * @param targets Collection of targets to show\n747:      */\n748:     public void jumpToDiagramShowing(Collection targets) {\n749: \n750:         if (targets == null || targets.size() == 0) {\n751:             return;\n752:         }\n753:         Vector dms = new Vector(targets);\n754:         Object first = dms.elementAt(0);\n755:         if (first instanceof Diagram && dms.size() > 1) {\n756:             setTarget(first);\n757:             setTarget(dms.elementAt(1));\n758:             return;\n759:         }\n760:         if (first instanceof Diagram && dms.size() == 1) {\n761:             setTarget(first);\n762:             return;\n763:         }\n764:         Vector diagrams =\n765:             ProjectManager.getManager().getCurrentProject().getDiagrams();\n766:         Object target = TargetManager.getInstance().getTarget();\n767:         if ((target instanceof Diagram)\n768:             && ((Diagram) target).countContained(dms) == dms.size()) {\n769:             setTarget(first);\n770:             return;\n771:         }\n772: \n773:         Diagram bestDiagram = null;\n774:         int bestNumContained = 0;\n775:         for (int i = 0; i < diagrams.size(); i++) {\n776:             Diagram d = (Diagram) diagrams.elementAt(i);\n777:             int nc = d.countContained(dms);\n778:             if (nc > bestNumContained) {\n779:                 bestNumContained = nc;\n780:                 bestDiagram = d;\n781:             }\n782:             if (nc == dms.size()) {\n783:                 break;\n784:             }\n785:         }\n786:         if (bestDiagram != null) {\n787:             if (!ProjectManager.getManager().getCurrentProject()\n788:                     .getActiveDiagram().equals(bestDiagram)) {\n789:                 setTarget(bestDiagram);\n790:             }\n791:             setTarget(first);\n792:         }\n793:         // making it possible to jump to the modelroot\n794:         if (first.equals(ProjectManager.getManager().getCurrentProject()\n795: \t\t\t .getRoot())) {\n796:             setTarget(first);\n797:         }\n798: \n799:         // and finally, adjust the scrollbars to show the Fig\n800:         Project p = ProjectManager.getManager().getCurrentProject();\n801:         if (p != null) {\n802:             Object f = TargetManager.getInstance().getFigTarget();\n803:             if (f instanceof Fig) {\n804:                 Globals.curEditor().scrollToShow((Fig) f);\n805:             }\n806:         }\n807:     }\n808: \n809:     ////////////////////////////////////////////////////////////////\n810:     // window operations\n811: \n812:     /**\n813:      * @see java.awt.Component#setVisible(boolean)\n814:      */\n815:     public void setVisible(boolean b) {\n816:         super.setVisible(b);\n817:         if (b) {\n818:             Globals.setStatusBar(this);\n819:         }\n820:     }\n821: \n822:     ////////////////////////////////////////////////////////////////\n823:     // IStatusBar\n824:     /**\n825:      * @see org.tigris.gef.ui.IStatusBar#showStatus(java.lang.String)\n826:      */\n827:     public void showStatus(String s) {\n828:         statusBar.showStatus(s);\n829:     }\n830: \n831:     /**\n832:      * Save the positions of the screen splitters, sizes and postion\n833:      * of main window in the properties file.\n834:      */\n835:     private void saveScreenConfiguration() {\n836:         if (explorerPane != null) {\n837: \t    Configuration.setInteger(Argo.KEY_SCREEN_WEST_WIDTH,\n838: \t\t\t\t     explorerPane.getWidth());\n839:         }\n840: \n841:         if (eastPane != null) {\n842: \t    Configuration.setInteger(Argo.KEY_SCREEN_EAST_WIDTH,\n843: \t\t\t\t     eastPane.getWidth());\n844:         }\n845: \n846:         if (northPane != null) {\n847: \t    Configuration.setInteger(Argo.KEY_SCREEN_NORTH_HEIGHT,\n848: \t\t\t\t     northPane.getHeight());\n849:         }\n850: \n851:         if (southPane != null) {\n852: \t    Configuration.setInteger(Argo.KEY_SCREEN_SOUTH_HEIGHT,\n853: \t\t\t\t     southPane.getHeight());\n854:         }\n855: \n856: \t//        if (_todoPane != null)\n857: \t// Configuration.setInteger(Argo.KEY_SCREEN_SOUTHWEST_WIDTH,\n858: \t// _todoPane.getWidth());\n859: \t//        if (_southEastPane != null)\n860: \t// Configuration.setInteger(Argo.KEY_SCREEN_SOUTHEAST_WIDTH,\n861: \t// _southEastPane.getWidth());\n862: \t//        if (_northWestPane != null)\n863: \t// Configuration.setInteger(Argo.KEY_SCREEN_NORTHWEST_WIDTH,\n864: \t// _northWestPane.getWidth());\n865: \t//        if (_northEastPane != null)\n866: \t// Configuration.setInteger(Argo.KEY_SCREEN_NORTHEAST_WIDTH,\n867: \t// _northEastPane.getWidth());\n868:         Configuration.setInteger(Argo.KEY_SCREEN_WIDTH, getWidth());\n869:         Configuration.setInteger(Argo.KEY_SCREEN_HEIGHT, getHeight());\n870:         Configuration.setInteger(Argo.KEY_SCREEN_LEFT_X, getX());\n871:         Configuration.setInteger(Argo.KEY_SCREEN_TOP_Y, getY());\n872:     }\n873: \n874:     /**\n875:      * Build a new details pane for the given compass point.\n876:      *\n877:      * @param compassPoint the position for which to build the pane\n878:      * @param orientation the required orientation of the pane.\n879:      * @return the details pane or null if none is required for the given\n880:      *         compass point.\n881:      */\n882:     private DetailsPane makeDetailsPane(String compassPoint,\n883: \t\t\t\t\tOrientation orientation) {\n884:         DetailsPane detailsPane =\n885: \t    new DetailsPane(compassPoint.toLowerCase(), orientation);\n886:         if (detailsPane.getTabCount() == 0) {\n887:             return null;\n888:         }\n889:         return detailsPane;\n890:     }\n891: \n892:     /**\n893:      * Exit the application if no save is required.\n894:      * If a save is required then prompt the user if they wish to,\n895:      * save and exit, exit without saving or cancel the exit operation.\n896:      */\n897:     public void tryExit() {\n898:         if (saveAction != null && saveAction.isEnabled()) {\n899:             Project p = ProjectManager.getManager().getCurrentProject();\n900: \n901:             String t =\n902:                 MessageFormat.format(Translator.localize(\n903:                         \"optionpane.exit-save-changes-to\"),\n904:                     new Object[] {p.getName()});\n905:             int response =\n906:                 JOptionPane.showConfirmDialog(\n907:                     this, t, t, JOptionPane.YES_NO_CANCEL_OPTION);\n908: \n909:             if (response == JOptionPane.CANCEL_OPTION\n910:                     || response == JOptionPane.CLOSED_OPTION) {\n911:                 return;\n912:             }\n913:             if (response == JOptionPane.YES_OPTION) {\n914:                 trySave(ProjectManager.getManager().getCurrentProject() != null\n915:                         && ProjectManager.getManager().getCurrentProject()\n916:                                 .getURL() != null);\n917:                 if (saveAction.isEnabled()) {\n918:                     return;\n919:                 }\n920:             }\n921:         }\n922:         saveScreenConfiguration();\n923:         Configuration.save();\n924:         System.exit(0);\n925:     }\n926: \n927:     /**\n928:      * @see java.awt.Window#dispose()\n929:      */\n930:     public void dispose() {\n931: \n932:     }\n933: \n934:     /**\n935:      * Receives window events.\n936:      */\n937:     class WindowCloser extends WindowAdapter {\n938:         /**\n939:          * Constructor.\n940:          */\n941:         public WindowCloser() {\n942:         }\n943: \n944:         /**\n945:          * @see java.awt.event.WindowListener#windowClosing(java.awt.event.WindowEvent)\n946:          */\n947:         public void windowClosing(WindowEvent e) {\n948:             tryExit();\n949:         }\n950:     } /* end class WindowCloser */\n951: \n952:     /**\n953:      * @see java.beans.PropertyChangeListener#propertyChange(\n954:      *         java.beans.PropertyChangeEvent)\n955:      */\n956:     public void propertyChange(PropertyChangeEvent evt) {\n957:         // the project changed\n958:         if (evt.getPropertyName()\n959:             .equals(ProjectManager.CURRENT_PROJECT_PROPERTY_NAME)) {\n960:             Project p = (Project) evt.getNewValue();\n961:             if (p != null) {\n962:                 titleHandler.buildTitle(p.getName(), null);\n963:                 //Designer.TheDesigner.getToDoList().removeAllElements();\n964:                 Designer.setCritiquingRoot(p);\n965:                 // update all panes\n966:                 TargetManager.getInstance().setTarget(p.getInitialTarget());\n967:             }\n968:         }\n969:     }\n970: \n971:     /////////////////////////////////////////////////////////////////////////\n972:     // TargetListener methods implemented so notified when selected\n973:     // diagram changes. Used to update the window title.\n974: \n975:     /**\n976:      * @see org.argouml.ui.targetmanager.TargetListener#targetAdded(org.argouml.ui.targetmanager.TargetEvent)\n977:      */\n978:     public void targetAdded(TargetEvent e) {\n979:         Object target = e.getNewTarget();\n980:         if (target instanceof ArgoDiagram) {\n981:             titleHandler.buildTitle(null, (ArgoDiagram) target);\n982:         }\n983:         determineRemoveEnabled();\n984:     }\n985: \n986:     /**\n987:      * @see org.argouml.ui.targetmanager.TargetListener#targetRemoved(org.argouml.ui.targetmanager.TargetEvent)\n988:      */\n989:     public void targetRemoved(TargetEvent e) {\n990:         Object target = e.getNewTarget();\n991:         if (target instanceof ArgoDiagram) {\n992:             titleHandler.buildTitle(null, (ArgoDiagram) target);\n993:         }\n994:         determineRemoveEnabled();\n995:     }\n996: \n997:     /**\n998:      * @see org.argouml.ui.targetmanager.TargetListener#targetSet(org.argouml.ui.targetmanager.TargetEvent)\n999:      */\n1000:     public void targetSet(TargetEvent e) {\n1001:         Object target = e.getNewTarget();\n1002:         if (target instanceof ArgoDiagram) {\n1003:             titleHandler.buildTitle(null, (ArgoDiagram) target);\n1004:         }\n1005:         determineRemoveEnabled();\n1006:     }\n1007: \n1008:     /**\n1009:      * Enabled the remove action if an item is selected in anything other then\n1010:      * the activity or state diagrams.\n1011:      */\n1012:     private void determineRemoveEnabled() {\n1013:         Editor editor = Globals.curEditor();\n1014:         Collection figs = editor.getSelectionManager().getFigs();\n1015:         boolean removeEnabled = !figs.isEmpty();\n1016:         GraphModel gm = editor.getGraphModel();\n1017:         if (gm instanceof UMLMutableGraphSupport) {\n1018:             removeEnabled =\n1019:                 ((UMLMutableGraphSupport) gm).isRemoveFromDiagramAllowed(figs);\n1020:         }\n1021:         removeFromDiagram.setEnabled(removeEnabled);\n1022:     }\n1023: \n1024:     /**\n1025:      * Returns the todopane.\n1026:      * @return ToDoPane\n1027:      */\n1028:     public ToDoPane getTodoPane() {\n1029:         return todoPane;\n1030:     }\n1031: \n1032:     /**\n1033:      * @return Returns the defaultFont.\n1034:      */\n1035:     public Font getDefaultFont() {\n1036:         return defaultFont;\n1037:     }\n1038: \n1039:     /**\n1040:      * Try to save the project, possibly not creating a new file\n1041:      * @param overwrite if true, then we overwrite without asking\n1042:      */\n1043:     public void trySave(boolean overwrite) {\n1044:         this.trySave(overwrite, false);\n1045:     }\n1046:     \n1047:     \n1048:     /**\n1049:      * Try to save the project.\n1050:      * @param overwrite if true, then we overwrite without asking\n1051:      * @param saveNewFile if true, we'll ask for a new file even if\n1052:      *                    the current project already had one  \n1053:      */\n1054:     public void trySave(boolean overwrite, boolean saveNewFile) {\n1055:         URL url = ProjectManager.getManager().getCurrentProject().getURL();\n1056: \n1057:         File file = null;\n1058: \n1059:         // this method is invoked from several places, so we have to check\n1060:         // whether if the project url is set or not\n1061:         if (url != null && !saveNewFile) {\n1062:             file = new File(url.getFile());\n1063: \n1064:             // does the file really exists?\n1065:             if (!file.exists()) {\n1066:                 // project file doesn't exist. let's pop up a message dialog..\n1067:                 int response = JOptionPane.showConfirmDialog(\n1068:                         this,\n1069:                         Translator.localize(\n1070:                                 \"optionpane.save-project-file-not-found\"),\n1071:                         Translator.localize(\n1072:                                 \"optionpane.save-project-file-not-found-title\"),\n1073:                         JOptionPane.YES_NO_OPTION);\n1074: \n1075:                 // ..and let's ask the user whether he wants to save the actual\n1076:                 // project into a new file or not\n1077:                 if (response == JOptionPane.YES_OPTION) {\n1078:                     saveNewFile = true;\n1079:                 } else {\n1080:                     // save action has been cancelled\n1081:                     return;\n1082:                 }\n1083:             }\n1084:         } else {\n1085:             // Attempt to save this project under a new name.\n1086:             saveNewFile = true;\n1087:         }\n1088: \n1089:         // Prompt the user for the new name.\n1090:         if (saveNewFile) {\n1091:             file = getNewFile();\n1092: \n1093:             // if the user cancelled the operation,\n1094:             // we don't have to save anything\n1095:             if (file == null) {\n1096:                 return;\n1097:             }\n1098:         }\n1099: \n1100:         // let's call the real save method\n1101:         trySaveWithProgressMonitor(overwrite, file);\n1102:     }\n1103:     \n1104:     /**\n1105:      * Checks if the given file is writable or read-only\n1106:      * @param file the file to be checked\n1107:      * @return true if the given file is read-only\n1108:      */\n1109:     private boolean isFileReadonly(File file) {\n1110:         try {\n1111:             return (file == null) \n1112:                 || (file.exists() && !file.canWrite()) \n1113:                 || (!file.exists() && !file.createNewFile());\n1114:         \n1115:         } catch (IOException ioExc) {\n1116:             return true;\n1117:         }\n1118:     }\n1119: \n1120:     /**\n1121:      * Loads a project displaying a nice ProgressMonitor\n1122:      * \n1123:      * @param overwrite if true, the file is going to be overwritten\n1124:      * @param file      the target file\n1125:      */\n1126:     public void trySaveWithProgressMonitor(boolean overwrite, File file) {\n1127:         SaveSwingWorker worker = new SaveSwingWorker(overwrite, file);\n1128:         Thread.currentThread().setPriority(Thread.MAX_PRIORITY);\n1129:         worker.start();\n1130:     }\n1131:     \n1132:     /**\n1133:      * Rebuild the title using the name of the current project.\n1134:      *\n1135:      */\n1136:     public void buildTitleWithCurrentProjectName() {\n1137:         titleHandler.buildTitle(\n1138:                 ProjectManager.getManager().getCurrentProject().getName(), \n1139:                 null);\n1140:     }\n1141:     \n1142:     /**\n1143:      * Try to save the project.\n1144:      * @param overwrite if true, then we overwrite without asking\n1145:      * @param file the File to save to\n1146:      * @param pmw       the ProgressMonitorWindow to be updated;  \n1147:      * @return true if successful\n1148:      */\n1149:     public boolean trySave(boolean overwrite, \n1150:             File file, \n1151:             ProgressMonitorWindow pmw) {\n1152:         LOG.info(\"Saving the project\");\n1153:         Project project = ProjectManager.getManager().getCurrentProject();\n1154:         PersistenceManager pm = PersistenceManager.getInstance();\n1155:         ProjectFilePersister persister = null;\n1156:         \n1157:         try {\n1158:             if (!PersistenceManager.getInstance()\n1159:                     .confirmOverwrite(overwrite, file)) {\n1160:                 return false;\n1161:             }\n1162: \n1163:             if (this.isFileReadonly(file)) {\n1164:                 JOptionPane.showMessageDialog(this, \n1165:                         Translator.localize(\n1166:                                 \"optionpane.save-project-cant-write\"),\n1167:                         Translator.localize(\n1168:                                 \"optionpane.save-project-cant-write-title\"),\n1169:                               JOptionPane.INFORMATION_MESSAGE);\n1170:                 \n1171:                 return false;\n1172:             }\n1173: \n1174:             String sStatus =\n1175:                 MessageFormat.format(Translator.localize(\n1176:                     \"label.save-project-status-writing\"),\n1177:                          new Object[] {file});\n1178:             this.showStatus (sStatus);\n1179: \n1180:             persister = pm.getPersisterFromFileName(file.getName());\n1181:             if (persister == null) {\n1182:                 throw new IllegalStateException(\"Filename \" + project.getName()\n1183:                             + \" is not of a known file type\");\n1184:             }\n1185: \n1186:             // Simulate some errors to repair.\n1187:             // TODO: Replace with junits - Bob\n1188: //            Layer lay =\n1189: //                Globals.curEditor().getLayerManager().getActiveLayer();\n1190: //            List figs = lay.getContentsNoEdges();\n1191: //            // A Fig with a null owner\n1192: //            if (figs.size() > 0) {\n1193: //                Fig fig = (Fig)figs.get(0);\n1194: //                LOG.error(\"Setting owner of \" \n1195: //                    + fig.getClass().getName() + \" to null\");\n1196: //                fig.setOwner(null);\n1197: //            }\n1198: //            // A Fig with a null layer\n1199: //            if (figs.size() > 1) {\n1200: //                Fig fig = (Fig)figs.get(1);\n1201: //                fig.setLayer(null);\n1202: //            }\n1203: //            // A Fig with a removed model element\n1204: //            if (figs.size() > 2) {\n1205: //                Fig fig = (Fig)figs.get(2);\n1206: //                Object owner = fig.getOwner();\n1207: //                Model.getUmlFactory().delete(owner);\n1208: //            }\n1209: \n1210:             // Repair any errors in the project\n1211:             String report = project.repair();\n1212:             if (report.length() > 0) {\n1213:                 reportError(\n1214:                         Translator.localize(\"dialog.repair\"), true, report);\n1215:             }\n1216:             \n1217:             if (pmw != null) {\n1218:                 pmw.progress(25);\n1219:                 persister.addProgressListener(pmw);\n1220:             }\n1221:             \n1222:             project.preSave();\n1223:             persister.save(project, file);\n1224:             project.postSave();\n1225: \n1226:             sStatus =\n1227:                 MessageFormat.format(Translator.localize(\n1228:                     \"label.save-project-status-wrote\"),\n1229:                          new Object[] {project.getURL()});\n1230:             showStatus(sStatus);\n1231:             LOG.debug (\"setting most recent project file to \"\n1232:                    + file.getCanonicalPath());\n1233: \n1234:             /*\n1235:              * notification of menu bar\n1236:              */\n1237:             saveAction.setEnabled(false);\n1238:             addFileSaved(file);\n1239: \n1240:             Configuration.setString(Argo.KEY_MOST_RECENT_PROJECT_FILE,\n1241:                         file.getCanonicalPath());\n1242: \n1243:             return true;\n1244:         } catch (Exception ex) {\n1245:             String sMessage =\n1246:                 MessageFormat.format(Translator.localize(\n1247:                     \"optionpane.save-project-general-exception\"),\n1248:                          new Object[] {ex.getMessage()});\n1249: \n1250:             JOptionPane.showMessageDialog(this, sMessage,\n1251:                     Translator.localize(\n1252:                     \"optionpane.save-project-general-exception-title\"),\n1253:                           JOptionPane.ERROR_MESSAGE);\n1254: \n1255:             reportError(\n1256:                     Translator.localize(\n1257:                             \"dialog.error.save.error\",\n1258:                             new Object[] {file.getName()}),\n1259:                     true, ex);\n1260: \n1261:             LOG.error(sMessage, ex);\n1262:         }\n1263: \n1264:         return false;\n1265:     }\n1266: \n1267:     /**\n1268:      * Register a new file saved.\n1269:      *\n1270:      * @param file The file.\n1271:      * @throws IOException if we cannot get the file name from the file.\n1272:      */\n1273:     public void addFileSaved(File file) throws IOException {\n1274:         GenericArgoMenuBar menu = (GenericArgoMenuBar) getJMenuBar();\n1275:         menu.addFileSaved(file.getCanonicalPath());\n1276:     }\n1277: \n1278:     /**\n1279:      * If the current project is dirty (needs saving) then this function will\n1280:      * ask confirmation from the user.\n1281:      * If the user indicates that saving is needed, then saving is attempted.\n1282:      * See ActionExit.actionPerformed() for a very similar procedure!\n1283:      *\n1284:      * @return true if we can continue with opening\n1285:      */\n1286:     public boolean askConfirmationAndSave() {\n1287:         ProjectBrowser pb = ProjectBrowser.getInstance();\n1288:         Project p = ProjectManager.getManager().getCurrentProject();\n1289: \n1290: \n1291:         if (p != null && saveAction.isEnabled()) {\n1292:             String t =\n1293:                 MessageFormat.format(Translator.localize(\n1294:                         \"optionpane.open-project-save-changes-to\"),\n1295:                         new Object[] {p.getName()});\n1296: \n1297:             int response =\n1298:                 JOptionPane.showConfirmDialog(pb, t, t,\n1299:                     JOptionPane.YES_NO_CANCEL_OPTION);\n1300: \n1301:             if (response == JOptionPane.CANCEL_OPTION\n1302:                     || response == JOptionPane.CLOSED_OPTION) {\n1303:                 return false;\n1304:             }\n1305:             if (response == JOptionPane.YES_OPTION) {\n1306: \n1307:                 trySave(ProjectManager.getManager().getCurrentProject() != null\n1308:                         && ProjectManager.getManager().getCurrentProject()\n1309:                                 .getURL() != null);\n1310:                 if (saveAction.isEnabled()) {\n1311:                     return false;\n1312:                 }\n1313:             }\n1314:         }\n1315:         return true;\n1316:     }\n1317: \n1318:     /**\n1319:      * Loads a project displaying a nice ProgressMonitor\n1320:      * \n1321:      * @param file      the project to be opened\n1322:      * @param showUI    whether to show the GUI or not\n1323:      */\n1324:     public void loadProjectWithProgressMonitor(File file, boolean showUI) {\n1325:         LoadSwingWorker worker = new LoadSwingWorker(file, showUI);\n1326:         Thread.currentThread().setPriority(Thread.MAX_PRIORITY);\n1327:         worker.start();\n1328:     }\n1329:     \t\n1330:     /**\n1331:      * Loads the project file and opens all kinds of error message windows\n1332:      * if it doesn't work for some reason. In those cases it preserves\n1333:      * the old project.\n1334:      *\n1335:      * @param file the file to open.\n1336:      * @param showUI true if an error message may be shown to the user,\n1337:      *               false if run in commandline mode\n1338:      * @param pmw \tthe ProgressMonitorWindow to be updated;  \n1339:      * \t\t\t\tif not needed, use null \n1340:      * @return true if the file was successfully opened\n1341:      */\n1342:     public boolean loadProject(File file, boolean showUI, \n1343:     \t\tProgressMonitorWindow pmw) {\n1344:         LOG.info(\"Loading project.\");\n1345: \n1346:         PersistenceManager pm = PersistenceManager.getInstance();\n1347:         Project oldProject = ProjectManager.getManager().getCurrentProject();\n1348:         boolean success = true;\n1349: \n1350:         // TODO:\n1351:         // This is actually a hack! Some diagram types\n1352:         // (like the statechart diagrams) access the current\n1353:         // diagram to get some info. This might cause\n1354:         // problems if