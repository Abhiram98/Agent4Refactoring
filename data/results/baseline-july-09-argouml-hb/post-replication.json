on.data_types.MCallConcurrencyKind;\n134: import ru.novosoft.uml.foundation.data_types.MChangeableKind;\n135: import ru.novosoft.uml.foundation.data_types.MExpression;\n136: import ru.novosoft.uml.foundation.data_types.MExpressionEditor;\n137: import ru.novosoft.uml.foundation.data_types.MIterationExpression;\n138: import ru.novosoft.uml.foundation.data_types.MMessageDirectionKind;\n139: import ru.novosoft.uml.foundation.data_types.MMultiplicity;\n140: import ru.novosoft.uml.foundation.data_types.MMultiplicityRange;\n141: import ru.novosoft.uml.foundation.data_types.MObjectSetExpression;\n142: import ru.novosoft.uml.foundation.data_types.MOperationDirectionKind;\n143: import ru.novosoft.uml.foundation.data_types.MOrderingKind;\n144: import ru.novosoft.uml.foundation.data_types.MParameterDirectionKind;\n145: import ru.novosoft.uml.foundation.data_types.MProcedureExpression;\n146: import ru.novosoft.uml.foundation.data_types.MPseudostateKind;\n147: import ru.novosoft.uml.foundation.data_types.MScopeKind;\n148: import ru.novosoft.uml.foundation.data_types.MTimeExpression;\n149: import ru.novosoft.uml.foundation.data_types.MVisibilityKind;\n150: import ru.novosoft.uml.foundation.extension_mechanisms.MStereotype;\n151: import ru.novosoft.uml.foundation.extension_mechanisms.MTaggedValue;\n152: import ru.novosoft.uml.model_management.MElementImport;\n153: import ru.novosoft.uml.model_management.MModel;\n154: import ru.novosoft.uml.model_management.MPackage;\n155: import ru.novosoft.uml.model_management.MSubsystem;\n156: \n157: /**\n158:  * Facade object for the Model component in ArgoUML.<p>\n159:  *\n160:  * The purpose of this Facade object is to allow for decoupling other modules\n161:  * from the insides of the model. For this purpose all of the methods in this\n162:  * class give away and accept handles (of type java.lang.Object) to the\n163:  * objects within the model.<p>\n164:  *\n165:  * This is just getters and recognizers. This is because the Model\n166:  * component has an extremely complicated internal data structure\n167:  * with lots of internal dependencies. To manipulate these there is\n168:  * a whole set of factories and helpers within the Model that is to\n169:  * be used but to use them you need knowledge of the internals of\n170:  * the Model, specifically the NS-UML objects.<p>\n171:  *\n172:  * All methods in this facade are static.<p>\n173:  *\n174:  * Signature for all recognizers in this Facade:\n175:  * <ul>\n176:  * <li>public static boolean isATYPE(Object handle)\n177:  * <li>public static boolean isPROPERTY(Object handle)\n178:  * </ul>\n179:  *\n180:  * Signature for all getters in this Facade:\n181:  * <ul>\n182:  * <li>public static Object getTYPE(Object handle) - 1..1\n183:  * <li>public static Iterator/Collection getTYPES(Object handle) - 0..*\n184:  * <li>public static String getName(Object handle) - Name\n185:  * </ul>\n186:  *\n187:  * @stereotype utility\n188:  * @author Linus Tolke\n189:  */\n190: public class ModelFacade {\n191:     ////////////////////////////////////////////////////////////////\n192:     // constants\n193: \n194:     /**\n195:      * Logger.\n196:      */\n197:     private static final Logger LOG = Logger.getLogger(ModelFacade.class);\n198: \n199:     // TODO: deprecate all of these constants in favor of a separate declaration\n200: \n201:     /**\n202:      * The constant ACC_PUBLIC determines visibility.\n203:      */\n204:     public static final short ACC_PUBLIC = 1;\n205: \n206:     /**\n207:      * The constant ACC_PRIVATE determines visibility.\n208:      */\n209:     public static final short ACC_PRIVATE = 2;\n210: \n211:     /**\n212:      * The constant ACC_PROTECTED determines visibility.\n213:      */\n214:     public static final short ACC_PROTECTED = 3;\n215: \n216:     /**\n217:      * The constant CLASSIFIER_SCOPE determines scope.\n218:      */\n219:     public static final short CLASSIFIER_SCOPE = 1;\n220:     /**\n221:      * The constant INSTANCE_SCOPE determines scope.\n222:      */\n223:     public static final short INSTANCE_SCOPE = 2;\n224: \n225:     /**\n226:      * The constant GUARDED determines concurrency.\n227:      */\n228:     public static final short GUARDED = 1;\n229: \n230:     /**\n231:      * The constant SEQUENTIAL determines concurrency.\n232:      */\n233:     public static final short SEQUENTIAL = 2;\n234: \n235:     // Types of line\n236:     /**\n237:      * Type of line: ABSTRACTION.\n238:      */\n239:     public static final Object ABSTRACTION = MAbstraction.class;\n240: \n241:     /**\n242:      * Type of line: ASSOCIATION.\n243:      */\n244:     public static final Object ASSOCIATION = MAssociation.class;\n245: \n246:     /**\n247:      * Type of line: ASSOCIATION_CLASS.\n248:      */\n249:     public static final Object ASSOCIATION_CLASS = MAssociationClass.class;\n250: \n251:     /**\n252:      * Type of line: ASSOCIATION_ROLE.\n253:      */\n254:     public static final Object ASSOCIATION_ROLE = MAssociationRole.class;\n255: \n256:     /**\n257:      * Type of line: COLLABORATION.\n258:      */\n259:     public static final Object COLLABORATION = MCollaboration.class;\n260: \n261:     /**\n262:      * Type of line: DEPENDENCY.\n263:      */\n264:     public static final Object DEPENDENCY = MDependency.class;\n265: \n266:     /**\n267:      * Type of line: EXTEND.\n268:      */\n269:     public static final Object EXTEND = MExtend.class;\n270: \n271:     /**\n272:      * Type of line: GENERALIZATION.\n273:      */\n274:     public static final Object GENERALIZATION = MGeneralization.class;\n275: \n276:     /**\n277:      * Type of line: INCLUDE.\n278:      */\n279:     public static final Object INCLUDE = MInclude.class;\n280: \n281:     /**\n282:      * Type of line: LINK.\n283:      */\n284:     public static final Object LINK = MLink.class;\n285: \n286:     /**\n287:      * Type of line: MESSAGE.\n288:      */\n289:     public static final Object MESSAGE = MMessage.class;\n290: \