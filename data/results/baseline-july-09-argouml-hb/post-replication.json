lements to the model\n208:      * @param col the given collection\n209:      */\n210:     protected void addAll(Collection col) {\n211:         if (col.size() == 0) return;\n212:         Iterator it = col.iterator();\n213:         fireListEvents = false;\n214:         int intervalStart = getSize() == 0 ? 0 : getSize() - 1;\n215:         while (it.hasNext()) {\n216:             Object o = it.next();\n217:             addElement(o);\n218:         }\n219:         fireListEvents = true;\n220:         fireIntervalAdded(this, intervalStart, getSize() - 1);\n221:     }\n222: \n223:     /**\n224:      * Utility method to get the target. Sets the target if the target is null\n225:      * via the method setTarget().\n226:      * @return MModelElement\n227:      */\n228:     protected Object getTarget() {\n229:         return listTarget;\n230:     }\n231: \n232:     /**\n233:      * Utility method to get the changed element from some event e\n234:      * @param e the event\n235:      * @return Object the changed element\n236:      */\n237:     protected Object getChangedElement(MElementEvent e) {\n238:         if (e.getAddedValue() != null)\n239:             return e.getAddedValue();\n240:         if (e.getRemovedValue() != null)\n241:             return e.getRemovedValue();\n242:         if (e.getNewValue() != null)\n243:             return e.getNewValue();\n244:         return null;\n245:     }\n246: \n247:     /**\n248:      * @see javax.swing.DefaultListModel#contains(java.lang.Object)\n249:      */\n250:     public boolean contains(Object elem) {\n251:         if (super.contains(elem))\n252:             return true;\n253:         if (elem instanceof Collection) {\n254:             Iterator it = ((Collection) elem).iterator();\n255:             while (it.hasNext()) {\n256:                 if (!super.contains(it.next())) {\n257:                     return false;\n258:                 }\n259:             }\n260:             return true;\n261:         }\n262:         return f