.ButtonModel;\n33: import javax.swing.JToolBar;\n34: \n35: import org.apache.log4j.Logger;\n36: import org.argouml.i18n.Translator;\n37: import org.argouml.kernel.ProjectManager;\n38: import org.argouml.model.ModelFacade;\n39: import org.argouml.model.uml.UmlModelEventPump;\n40: import org.argouml.ui.ArgoDiagram;\n41: import org.argouml.ui.CmdCreateNode;\n42: import org.argouml.ui.CmdSetMode;\n43: import org.argouml.ui.targetmanager.TargetManager;\n44: import org.argouml.uml.diagram.static_structure.ui.CommentEdge;\n45: import org.tigris.gef.base.ModeBroom;\n46: import org.tigris.gef.base.ModeCreateFigCircle;\n47: import org.tigris.gef.base.ModeCreateFigInk;\n48: import org.tigris.gef.base.ModeCreateFigLine;\n49: import org.tigris.gef.base.ModeCreateFigPoly;\n50: import org.tigris.gef.base.ModeCreateFigRRect;\n51: import org.tigris.gef.base.ModeCreateFigRect;\n52: import org.tigris.gef.base.ModeCreateFigSpline;\n53: import org.tigris.gef.base.ModeCreateFigText;\n54: import org.tigris.gef.base.ModeCreatePolyEdge;\n55: import org.tigris.gef.base.ModeSelect;\n56: import org.tigris.gef.presentation.Fig;\n57: import org.tigris.toolbar.ToolBarFactory;\n58: import org.tigris.toolbar.toolbutton.ToolButton;\n59: \n60: import ru.novosoft.uml.MElementEvent;\n61: import ru.novosoft.uml.MElementListener;\n62: \n63: /**\n64:  * This class provides support for writing a UML diagram for argo using\n65:  * the GEF framework.\n66:  * <p>It adds common buttons, a namespace, capability\n67:  * to delete itself when its namespace is deleted, some help\n68:  * with creating a valid diagram name.\n69:  *\n70:  */\n71: public abstract class UMLDiagram\n72:     extends ArgoDiagram\n73:     implements MElementListener {\n74: \n75:     private static final Logger LOG = Logger.getLogger(UMLDiagram.class);\n76: \n77:     ////////////////////////////////////////////////////////////////\n78:     // actions for toolbar\n79:     \n80:     /**\n81:      * Tool to add a comment node.\n82:      */\n83:     protected static Action actionComment =\n84: \tnew RadioAction(new CmdCreateNode(ModelFacade.COMMENT, \"Note\"));\n85: \n86:     /**\n87:      * Tool to create an relationship between a comment node and some other node\n88:      * using a polyedge.<p>\n89:      */\n90:     protected static Action _actionCommentLink = new RadioAction(\n91:         new CmdSetMode(\n92:             ModeCreatePolyEdge.class,  \n93:             \"edgeClass\",\n94:             CommentEdge.class,\n95:             \"CommentLink\"));\n96: \n97: \n98:     protected static Action actionSelect =\n99:         new CmdSetMode(ModeSelect.class, \"Select\");\n100: \n101:     protected static Action actionBroom =\n102:         new CmdSetMode(ModeBroom.class, \"Broom\");\n103: \n104:     protected static Action _actionRectangle =\n105:         new RadioAction(new CmdSetMode(ModeCreateFigRect.class, \"Rectangle\",\n106:         Translator.localize(\"misc.primitive.rectangle\")));\n107: \n108:     protected static Action _actionRRectangle =\n109:         new RadioAction(new CmdSetMode(ModeCreateFigRRect.class, \"RRect\",\n110:         Translator.localize(\"misc.primitive.rounded-rectangle\")));\n111: \n112:     protected static Action _actionCircle =\n113:         new RadioAction(new CmdSetMode(ModeCreateFigCircle.class, \"Circle\",\n114:         Translator.localize(\"misc.primitive.circle\")));\n115: \n116:     protected static Action _actionLine =\n117:         new RadioAction(new CmdSetMode(ModeCreateFigLine.class, \"Line\",\n118:         Translator.localize(\"misc.primitive.line\")));\n119: \n120:     protected static Action _actionText =\n121:         new RadioAction(new CmdSetMode(ModeCreateFigText.class, \"Text\",\n122:         Translator.localize(\"misc.primitive.text\")));\n123: \n124:     protected static Action _actionPoly =\n125:         new RadioAction(new CmdSetMode(ModeCreateFigPoly.class, \"Polygon\",\n126:         Translator.localize(\"misc.primitive.polygon\")));\n127: \n128:     protected static Action _actionSpline =\n129:         new RadioAction(new CmdSetMode(ModeCreateFigSpline.class, \"Spline\",\n130:         Translator.localize(\"misc.primitive.spline\")));\n131: \n132:     protected static Action _actionInk =\n133:         new RadioAction(new CmdSetMode(ModeCreateFigInk.class, \"Ink\",\n134:         Translator.localize(\"misc.primitive.ink\")));\n135: \n136:     ////////////////////////////////////////////////////////////////\n137:     // instance variables\n138:     private Object namespace;\n139:     private DiagramInfo diagramName = new DiagramInfo(this);\n140: \n141:     private JToolBar toolBar;\n142: \n143:     ////////////////////////////////////////////////////////////////\n144:     // constructors\n145: \n146:     /**\n147:      * constructor\n148:      */\n149:     public UMLDiagram() {\n150:         super();\n151:     }\n152: \n153:     /**\n154:      * @param ns the UML namespace\n155:      */\n156:     public UMLDiagram(Object ns) {\n157:         this();\n158: \n159:         if (!ModelFacade.isANamespace(ns))\n160:             throw new IllegalArgumentException();\n161: \n162:         setNamespace(ns);\n163:     }\n164: \n165:     /**\n166:      * @param name the name of the diagram\n167:      * @param ns the UML namespace\n168:      */\n169:     public UMLDiagram(String name, Object ns) {\n170:         this(ns);\n171:         try {\n172:             setName(name);\n173:         } catch (PropertyVetoException pve) {\n174:             LOG.fatal(\"Name not allowed in construction of diagram\");\n175:         }\n176:     }\n177: \n178:     /**\n179:      * @see org.tigris.gef.base.Diagram#initialize(java.lang.Object)\n180:      */\n181:     public void initialize(Object owner) {\n182:         super.initialize(owner);\n183:         if (org.argouml.model.ModelFacade.isANamespace(owner))\n184:             setNamespace(owner);\n185:         else\n186:             LOG.debug(\"unknown object in UMLDiagram initialize:\" + owner);\n187:     }\n188: \n189:     ////////////////////////////////////////////////////////////////\n190:     // accessors\n191: \n192:     /**\n193:      * @return the namespace for the diagram\n194:      */\n195:     public Object getNamespace() {\n196:         return namespace;\n197:     }\n198: \n199:     /**\n200:      * sets the namespace of the Diagram, and\n201:      * adds the diagram as a listener of its namspace in the UML model.\n202:      * (so that it can delete itself when the model element is deleted).\n203:      *\n204:      * @param ns the namespace\n205:      */\n206:     public void setNamespace(Object ns) {\n207:         if (!ModelFacade.isANamespace(ns)) {\n208:             LOG.error(\"Not a namespace\");\n209:             LOG.error(ns);\n210:             throw new IllegalArgumentException(\"Given object not a namespace\");\n211:         }\n212:         namespace = ns;\n213:         // add the diagram as a listener to the namspace so\n214:         // that when the namespace is remove()d the diagram is deleted also.\n215:         UmlModelEventPump.getPump().addModelEventListener(\n216:             this,\n217:             namespace,\n218:             UmlModelEventPump.REMOVE);\n219:     }\n220: \n221:     /**\n222:      * @see org.tigris.gef.base.Diagram#getClassAndModelID()\n223:      */\n224:     public String getClassAndModelID() {\n225:         String s = super.getClassAndModelID();\n226:         if (getOwner() == null)\n227:             return s;\n228:         String id = ModelFacade.getUUID(getOwner());\n229:         return s + \"|\" + id;\n230:     }\n231: \n232:     // TODO: should be overwritten by each subclass of UMLDiagram\n233: \n234:     /**\n235:      * @return the namespace\n236:      */\n237:     public Object getOwner() {\n238:         return getNamespace();\n239:     }\n240: \n241:     /**\n242:      * @see org.tigris.gef.base.Diagram#setName(java.lang.String)\n243:      */\n244:     public void setName(String n) throws PropertyVetoException {\n245:         super.setName(n);\n246:         diagramName.updateName();\n247:     }\n248: \n249:     static final long serialVersionUID = -401219134410459387L;\n250: \n251:     /**\n252:      * Get the toolbar for the diagram\n253:      * @return the diagram toolbar\n254:      */\n255:     public JToolBar getJToolBar() {\n256:         if (toolBar == null) {\n257:             initToolBar();\n258:         }\n259:         return toolBar;\n260:     }\n261: \n262:     /**\n263:      * Create the toolbar based on actions for the spcific diagram\n264:      * subclass.\n265:      * @see org.tigris.gef.base.Diagram#initToolBar()\n266:      */\n267:     public void initToolBar() {\n268:         toolBar =\n269: \t    ToolBarFactory.createToolBar(true /*rollover*/,\n270: \t\t\t\t\t getActions(),\n271: \t\t\t\t\t false /*floating*/);\n272:     }\n273: \n274:     /**\n275:      * Return actions available for building toolbar or similar.\n276:      * @return an array of available actions.\n277:      */\n278:     public Object[] getActions() {\n279:         Object manipulateActions[] = getManipulateActions();\n280:         Object umlActions[] = getUmlActions();\n281:         Object shapeActions[] = getShapeActions();\n282: \n283:         Object actions[] =\n284:             new Object[manipulateActions.length\n285:                 + umlActions.length\n286:                 + shapeActions.length];\n287: \n288:         int posn = 0;\n289:         System.arraycopy(\n290:             manipulateActions,\n291:             0,\n292:             actions,\n293:             posn,\n294:             manipulateActions.length);\n295:         posn += manipulateActions.length;\n296:         System.arraycopy(umlActions, 0, actions, posn, umlActions.length);\n297:         posn += umlActions.length;\n298:         System.arraycopy(shapeActions, 0, actions, posn, shapeActions.length);\n299: \n300:         return actions;\n301:     }\n302: \n303:     /**\n304:      * Implement on the ancestor to get actions to populate toolbar.\n305:      *\n306:      * @return the actions for the toolbar\n307:      */\n308:     protected abstract Object[] getUmlActions();\n309: \n310:     private Object[] getManipulateActions() {\n311:         Object actions[] =\n312:         {\n313: \t    new RadioAction(actionSelect),\n314: \t    new RadioAction(actionBroom),\n315: \t    null\n316: \t};\n317:         return actions;\n318:     }\n319: \n320:     private Object[] getShapeActions() {\n321:         Object actions[] = {\n322: \t    null, getShapePopupActions(),\n323: \t};\n324:         return actions;\n325:     }\n326: \n327:     private Object[] getShapePopupActions() {\n328:         Object actions[][] = {\n329: \t    {\n330: \t\t_actionRectangle, _actionRRectangle\n331: \t    },\n332: \t    {\n333:                 _actionCircle, _actionLine }, {\n334:                 _actionText, _actionPoly }, {\n335:                 _actionSpline, _actionInk }\n336:         };\n337: \n338:         return actions;\n339:     }\n340: \n341:     /**\n342:      * This diagram listens to events from is namespace ModelElement;\n343:      * When the modelelement is removed, we also want to delete this\n344:      * diagram too.  <p>\n345:      *\n346:      * There is also a risk that if this diagram was the one shown in\n347:      * the diagram panel, then it will remain after it has been\n348:      * deleted. so we need to deselect this diagram.\n349:      *\n350:      * @see ru.novosoft.uml.MElementListener#removed(ru.novosoft.uml.MElementEvent)\n351:      */\n352:     public void removed(MElementEvent e) {\n353:         Object newTarget =\n354:             ProjectManager.getManager().getCurrentProject().getDiagrams().get(\n355:                 0);\n356:         TargetManager.getInstance().setTarget(newTarget);\n357:         UmlModelEventPump.getPump().removeModelEventListener(\n358:             this,\n359:             namespace,\n360:             UmlModelEventPump.REMOVE);\n361:         ProjectManager.getManager().getCurrentProject().moveToTrash(this);\n362: \n363:     }\n364: \n365:     /**\n366:      * not used the UMLDiagram is only interested in the removed() event.\n367:      *\n368:      * @see ru.novosoft.uml.MElementListener#propertySet(ru.novosoft.uml.MElementEvent)\n369:      */\n370:     public void propertySet(MElementEvent e) {\n371:     }\n372: \n373:     /**\n374:      * not used the UMLDiagram is only interested in the removed() event.\n375:      *\n376:      * @see ru.novosoft.uml.MElementListener#roleAdded(ru.novosoft.uml.MElementEvent)\n377:      */\n378:     public void roleAdded(MElementEvent e) {\n379:     }\n380: \n381:     /**\n382:      * not used the UMLDiagram is only interested in the removed() event.\n383:      *\n384:      * @see ru.novosoft.uml.MElementListener#roleRemoved(ru.novosoft.uml.MElementEvent)\n385:      */\n386:     public void roleRemoved(MElementEvent e) {\n387:     }\n388: \n389:     /**\n390:      * not used the UMLDiagram is only interested in the removed() event.\n391:      *\n392:      * @see ru.novosoft.uml.MElementListener#listRoleItemSet(ru.novosoft.uml.MElementEvent)\n393:      */\n394:     public void listRoleItemSet(MElementEvent e) {\n395:     }\n396: \n397:     /**\n398:      * not used the UMLDiagram is only interested in the removed() event.\n399:      *\n400:      * @see ru.novosoft.uml.MElementListener#recovered(ru.novosoft.uml.MElementEvent)\n401:      */\n402:     public void recovered(MElementEvent e) {\n403:     }\n404: \n405:     /**\n406:      * Removes the UMLDiagram and all the figs on it as listener to \n407:      * UmlModelEventPump. Is called by setTarget in TabDiagram to improve \n408:      * performance. \n409:      *\n410:      */\n411:     public void removeAsTarget() {\n412:         Enumeration elems = elements();\n413:         UmlModelEventPump pump = UmlModelEventPump.getPump();\n414:         while (elems.hasMoreElements()) {\n415:             Object o = elems.nextElement();