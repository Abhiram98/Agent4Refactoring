mport java.awt.Dimension;\n33: import java.awt.Rectangle;\n34: import java.beans.PropertyVetoException;\n35: import java.util.Iterator;\n36: \n37: import org.argouml.uml.generator.ParserDisplay;\n38: import org.tigris.gef.graph.GraphModel;\n39: import org.tigris.gef.presentation.FigLine;\n40: import org.tigris.gef.presentation.FigRRect;\n41: import org.tigris.gef.presentation.FigRect;\n42: import org.tigris.gef.presentation.FigText;\n43: \n44: /** Class to display graphics for a UML MState in a diagram. */\n45: \n46: public class FigSimpleState extends FigState {\n47: \n48:     ////////////////////////////////////////////////////////////////\n49:     // constants\n50: \n51:     private static final int MARGIN = 2;\n52: \n53:     ////////////////////////////////////////////////////////////////\n54:     // instance variables\n55: \n56:     private FigRect cover;\n57:     private FigLine divider;\n58: \n59: \n60:     ////////////////////////////////////////////////////////////////\n61:     // constructors\n62: \n63:     /**\n64:      * The main constructor\n65:      */\n66:     public FigSimpleState() {\n67: \tsetBigPort(new FigRRect(getInitialX() + 1, getInitialY() + 1,\n68: \t\t\t getInitialWidth() - 2, getInitialHeight() - 2,\n69: \t\t\t Color.cyan, Color.cyan));\n70: \tcover =\n71: \t    new FigRRect(getInitialX(), getInitialY(),\n72: \t\t\t getInitialWidth(), getInitialHeight(),\n73: \t\t\t Color.black, Color.white);\n74: \n75: \tgetBigPort().setLineWidth(0);\n76: \tgetNameFig().setLineWidth(0);\n77: \tgetNameFig().setBounds(getInitialX() + 2, getInitialY() + 2,\n78: \t\t\t       getInitialWidth() - 4,\n79: \t\t\t       getNameFig().getBounds().height);\n80: \tgetNameFig().setFilled(false);\n81: \n82: \tdivider =\n83: \t    new FigLine(getInitialX(),\n84: \t\t\tgetInitialY() + 2 + getNameFig().getBounds().height + 1,\n85: \t\t\tgetInitialWidth() - 1,\n86: \t\t\tgetInitialY() + 2 + getNameFig().getBounds().height + 1,\n87: \t\t\tColor.black);   \n88: \n89: \t// add Figs to the FigNode in back-to-front order\n90: \taddFig(getBigPort());\n91: \taddFig(cover);\n92: \taddFig(getNameFig());\n93: \taddFig(divider);\n94: \taddFig(getInternal());\n95: \n96: \t//setBlinkPorts(false); //make port invisble unless mouse enters\n97: \tRectangle r = getBounds();\n98: \tsetBounds(r.x, r.y, r.width, r.height);\n99:     }\n100: \n101:     /**\n102:      * The constructor that hooks into an existing UML element\n103:      * @param gm ignored\n104:      * @param node the UML element\n105:      */\n106:     public FigSimpleState(GraphModel gm, Object node) {\n107: \tthis();\n108: \tsetOwner(node);\n109:     }\n110: \n111:     /**\n112:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#getH()\n113:      */\n114:     public String placeString() { return \"new State\"; }\n115: \n116:     /**\n117:      * @see java.lang.Object#clone()\n118:      */\n119:     public Object clone() {\n120: \tFigSimpleState figClone = (FigSimpleState) super.clone();\n121: \tIterator it = figClone.getFigs(null).iterator();\n122: \tfigClone.setBigPort((FigRRect) it.next());\n123: \tfigClone.cover = (FigRect) it.next();\n124: \tfigClone.setNameFig((FigText) it.next());\n125: \tfigClone.divider = (FigLine) it.next();\n126: \tfigClone.setInternal((FigText) it.next());\n127: \treturn figClone;\n128:     }\n129: \n130:     ////////////////////////////////////////////////////////////////\n131:     // accessors\n132: \n133:     /**\n134:      * @see org.tigris.gef.presentation.Fig#getMinimumSize()\n135:      */\n136:     public Dimension getMinimumSize() {\n137: \tDimension nameDim = getNameFig().getMinimumSize();\n138: \tDimension internalDim = getInternal().getMinimumSize();\n139: \n140: \tint h = nameDim.height + 4 + internalDim.height;\n141: \tint w = Math.max(nameDim.width + 4, internalDim.width + 4);\n142: \treturn new Dimension(w, h);\n143:     }\n144: \n145:     /** Override setBounds to keep shapes looking right \n146:      * @see org.tigris.gef.presentation.Fig#setBounds(int, int, int, int)\n147:      */\n148:     public void setBounds(int x, int y, int w, int h) {\n149: \tif (getNameFig() == null) {\n150: \t    return;\n151: \t}\n152: \tRectangle oldBounds = getBounds();\n153: \tDimension nameDim = getNameFig().getMinimumSize();\n154: \n155: \tgetNameFig().setBounds(x + 2, y + 2, w - 4,  nameDim.height);\n156: \tdivider.setShape(x, y + nameDim.height + 1,\n157: \t\t\t  x + w - 1,\n158: \t\t\t  y + nameDim.height + 1);\n159: \n160: \tgetInternal().setBounds(x + 2, y + nameDim.height + 4,\n161: \t\t\t    w - 4, h - nameDim.height - 6);\n162: \n163: \tgetBigPort().setBounds(x, y, w, h);\n164: \tcover.setBounds(x, y, w, h);\n165: \n166: \tcalcBounds(); //_x = x; _y = y; _w = w; _h = h;\n167: \tupdateEdges();\n168: \tfirePropChange(\"bounds\", oldBounds, getBounds());\n169:     }\n170: \n171:     ////////////////////////////////////////////////////////////////\n172:     // Fig accessors\n173: \n174:     /**\n175:      * @see org.tigris.gef.presentation.Fig#setLineColor(java.awt.Color)\n176:      */\n177:     public void setLineColor(Color col) {\n178: \tcover.setLineColor(col);\n179: \tdivider.setLineColor(col);\n180:     }\n181:     \n182:     /**\n183:      * @see org.tigris.gef.presentation.Fig#getLineColor()\n184:      */\n185:     public Color getLineColor() { return cover.getLineColor(); }\n186: \n187:     /**\n188:      * @see org.tigris.gef.presentation.Fig#setFillColor(java.awt.Color)\n189:      */\n190:     public void setFillColor(Color col) { cover.setFillColor(col); }\n191:         \n192:     /**\n193:      * @see org.tigris.gef.presentation.Fig#getFillColor()\n194:      */\n195:     public Color getFillColor() { return cover.getFillColor(); }\n196: \n197:     /**\n198:      * @see org.tigris.gef.presentation.Fig#setFilled(boolean)\n199:      */\n200:     public void setFilled(boolean f) { cover.setFilled(f); }\n201:     \n202:     /**\n203:      * @see org.tigris.gef.presentation.Fig#getFilled()\n204:      */\n205:     public boolean getFilled() { return cover.getFilled(); }\n206: \n207:     /**\n208:      * @see org.tigris.gef.presentation.Fig#setLineWidth(int)\n209:      */\n210:     public void setLineWidth(int w) {\n211: \tcover.setLineWidth(w);\n212: \tdivider.setLineWidth(w);\n213:     }\n214:     \n215:     /**\n216:      * @see org.tigris.gef.presentation.Fig#getLineWidth()\n217:      */\n218:     public int getLineWidth() { return cover.getLineWidth(); }\n219: \n220: \n221:     ////////////////////////////////////////////////////////////////\n222:     // event processing  \n223: \n224:     /**\n225:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEdited(org.tigris.gef.presentation.FigText)\n226:      */\n227:     public void textEdited(FigText ft) throws PropertyVetoException {\n228: \tsuper.textEdited(ft);\n229: \tif (ft == getInternal()) {\n230: \t    Object state = getOwner();\n231: \t    if (state == null) return;\n232: \t    String s = ft.getText();\n233: \t    ParserDisplay.SINGLETON.parseStateBody(/*(MState)*/state, s);\n234: \t}\n235:     }\n236:    \n237: \n238:     /**\n239:      * @see org.argouml.uml.diagram.state.ui.FigState#getInitialHeight()\n240:      */\n241:     protected int getInitialHeight() {\n242:         return 40;\n243:     }\n244: \n245:     /**\n246:      * @see org.argouml.uml.diagram.state.ui.FigState#getInitialWidth()\n247:      */\n248:     protected int getInitialWidth() {\n249:         return 70;\n250:     }\n251: \n252:     /**\n253:      * @see org.argouml.uml.diagram.state.ui.FigState#getInitialX()\n254:      */\n255:     protected int getInitialX() {\n256:         return 0;\n257:     }\n258: \n259:     /**\n260:      * @see org.argouml.uml.diagram.state.ui.FigState#getInitialY()\n261:      */\n262:     protected int getInitialY() {\n263:         return 0;\n264:     }\n265: \n266: } /* end class FigSimpleState */\n267: ",
