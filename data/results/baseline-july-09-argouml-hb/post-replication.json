                    "kwargs": {
                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/persistence/AbstractFilePersister.java: \n1: // $Id$\n2: // Copyright (c) 1996-2005 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.persistence;\n26: \n27: import java.io.File;\n28: import java.io.FileInputStream;\n29: import java.io.FileNotFoundException;\n30: import java.io.FileOutputStream;\n31: import java.io.IOException;\n32: import java.net.MalformedURLException;\n33: \n34: import javax.swing.JProgressBar;\n35: import javax.swing.filechooser.FileFilter;\n36: import javax.swing.text.JTextComponent;\n37: \n38: import org.apache.log4j.Logger;\n39: import org.argouml.kernel.Project;\n40: \n41: /**\n42:  * To persist to and from zargo (zipped file) storage.\n43:  *\n44:  * @author Bob Tarling\n45:  */\n46: public abstract class AbstractFilePersister extends FileFilter\n47:         implements ProjectFilePersister {\n48: \n49:     private static final Logger LOG =\n50:         Logger.getLogger(AbstractFilePersister.class);\n51: \n52:     /**\n53:      * The PERSISTENCE_VERSION is increased every time the persistence format\n54:      * changes.\n55:      * This controls conversion of old persistence version files to be\n56:      * converted to the current one, keeping ArgoUML backwards compatible.\n57:      */\n58:     protected static final int PERSISTENCE_VERSION = 3;\n59:     \n60:     /**\n61:      * Supply the encoding to be used throughout the persistence\n62:      * mechanism.\n63:      * @return the encoding.\n64:      */\n65:     protected String getEncoding() {\n66:         return \"UTF-8\";\n67:     }\n68: \n69:     /**\n70:      * Create a temporary copy of the existing file.\n71:      * @param file the file to copy.\n72:      * @return the temp file or null if none copied.\n73:      * @throws FileNotFoundException if file not found\n74:      * @throws IOException if error reading or writing\n75:      */\n76:     protected File createTempFile(File file)\n77:         throws FileNotFoundException, IOException {\n78:         File tempFile = new File(file.getAbsolutePath() + \"#\");\n79:         \n80:         if (tempFile.exists()) {\n81:             tempFile.delete();\n82:         }\n83:         \n84:         if (file.exists()) {\n85:             copyFile(file, tempFile);\n86:         }\n87:         \n88:         return tempFile;\n89:     }\n90:     \n91:     /**\n92:      * Copies one file src to another, raising file exceptions\n93:      * if there are some problems.\n94:      *\n95:      * @param dest The destination file.\n96:      * @param src The source file.\n97:      * @return The destination file after successful copying.\n98:      * @throws IOException if there is some problems with the files.\n99:      * @throws FileNotFoundException if any of the files cannot be found.\n100:      */\n101:     private File copyFile(File src, File dest)\n102:         throws FileNotFoundException, IOException {\n103: \n104:         FileInputStream fis  = new FileInputStream(src);\n105:         FileOutputStream fos = new FileOutputStream(dest);\n106:         byte[] buf = new byte[1024];\n107:         int i = 0;\n108:         while ((i = fis.read(buf)) != -1) {\n109:             fos.write(buf, 0, i);\n110:         }\n111:         fis.close();\n112:         fos.close();\n113: \n114:         dest.setLastModified(src.lastModified());\n115: \n116:         return dest;\n117:     }\n118: \n119: \n120: \n121:     ////////////////////////////////////////////////////////////////\n122:     // FileFilter API\n123: \n124:     /**\n125:      * @see javax.swing.filechooser.FileFilter#accept(java.io.File)\n126:      */\n127:     public boolean accept(File f) {\n128:         if (f == null) return false;\n129:         if (f.isDirectory()) return true;\n130:         String s = getExtension(f);\n131:         if (s != null) // this check for files without extension...\n132:             if (s.equalsIgnoreCase(getExtension())) return true;\n133:         return false;\n134:     }\n135: \n136:     /**\n137:      * The extension valid for this type of file.\n138:      * (Just the chars, not the dot: e.g. \"zargo\".)\n139:      *\n140:      * @return the extension valid for this type of file\n141:      */\n142:     public abstract String getExtension();\n143: \n144:     /**\n145:      * (Just the description, not the extension between \"()\".)\n146:      *\n147:      *