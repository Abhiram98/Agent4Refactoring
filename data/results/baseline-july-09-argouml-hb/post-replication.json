el)getGraphModel()).setCollaboration( collaboration);\n83:     }\n84: \n85:     /**\n86:      * Returns the owner of this diagram. In the case of sequencediagrams it's\n87:      * allways the root model.\n88:      *\n89:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getOwner()\n90:      */\n91:     public Object getOwner() {\n92:         // TODO: in the future (when there are multiple models) this\n93:         // should be changeable\n94:         //return ProjectManager.getManager().getCurrentProject().getRoot();\n95:         return getNamespace();\n96:     }\n97: \n98:     /**\n99:      * Creates a new diagramname.\n100:      *\n101:      * @return a new unique name.\n102:      */\n103:     protected String getNewDiagramName() {\n104:         String name = getLabelName()+\" \" + getNextDiagramSerial();\n105:         if (!(ProjectManager.getManager().getCurrentProject()\n106: \t      .isValidDiagramName(name))) {\n107:             name = getNewDiagramName();\n108:         }\n109:         return name;\n110:     }\n111: \n112:     /**\n113:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getLabelName()\n114:      */\n115:     public String getLabelName() {\n116:         return Translator.localize(\"label.sequence-diagram\");\n117:     }\n118: \n119:     /**\n120:      * Must return an array of actions via which the model can be\n121:      * manipulated. To use the 'nested actions' feature (like the\n122:      * different association types on UMLClassDiagram) these nested\n123:      * actions must be in an array of their own.<p>\n124:      *\n125:      * In case of the sequence diagram this method must return the\n126:      * following actions:<ul>\n127:      * <li>Action to create an object\n128:      * <li>Action to add a procedural link\n129:      * <li>Action to add a create link\n130:      * <li>Action to add a asynchronous link\n131:      * <li>Action to add a synchronous link\n132:      * <li>Action to add a return link\n133:      * </ul>\n134:      *\n135:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getUmlActions()\n136:      */\n137:     protected Object[] getUmlActions() {\n138:         if (actions == null) {\n139:             actions = new Object[7];\n140:             actions[0] =\n141:                 new ActionAddClassifierRole();\n142:             int offset = 1;\n143: \n144:             Object[][] actionList = {\n145:                 {Model.getMetaTypes().getCallAction(),\n146:                     \"button.new-callaction\", },\n147:                 {Model.getMetaTypes().getReturnAction(),\n148:                     \"button.new-returnaction\", },\n149:                 {Model.getMetaTypes().getCreateAction(),\n150:                     \"button.new-createaction\", },\n151:                 {Model.getMetaTypes().getDestroyAction(),\n152:                     \"button.new-destroyaction\", },\n153:             };\n154: \n155: \t    for (int i = 0; i < actionList.length; i++) {\n156: \t\tHashtable args = new Hashtable();\n157:                 args.put(\"edgeClass\", Model.getMetaTypes().getMessage());\n158: \t\targs.put(\"action\", actionList[i][0]);\n159:                 args.put(\"actionName\", ResourceLoaderWrapper.getImageBinding( (String)actionList[i][1]));\n160: \t\tactions[i + offset] =\n161:                     new RadioAction(new CmdSetMode(ModeCreateMessage.class,\n162:                     args,\n163: \t\t\t\t\t\t   (String) actionList[i][1]));\n164: \t    }\n165:             Hashtable args=new Hashtable();\n166:             args.put( \"name\", SEQUENCE_EXPAND_BUTTON);\n167:             actions[5]=new RadioAction( new CmdSetMode(\n168:                 ModeChangeHeight.class,\n169:                 args,\n170:                 SEQUENCE_EXPAND_BUTTON\n171:                 ));\n172:             args=new Hashtable();\n173:             args.put( \"name\", SEQUENCE_CONTRACT_BUTTON);\n174:             actions[6]=new RadioAction( new CmdSetMode(\n175:                 ModeChangeHeight.class,\n176:                 args,\n177:                 SEQUENCE_CONTRACT_BUTTON\n178:                 ));\n179:         }\n180:         return actions;\n181:     }\n182: \n183:     /**\n184:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getNamespace()\n185:      */\n186:     public Object getNamespace() {\n187:         return ((SequenceDiagramGraphModel) getGraphModel()).getCollaboration();\n188:     }\n189: \n190:     /**\n191:      */\n192:     public void setNamespace(Object ns) {\n193:         ((SequenceDiagramGraphModel)getGraphModel()).setCollaboration( ns);\n194:         super.setNamespace(ns);\n195:     }\n196: \n197:     /**\n198:      * Method called by Project.removeDiagram to clean up the mess in\n199:      * this diagram when the diagram is removed.\n200:      */\n201:     public void cleanUp() {\n202: /*\n203:         ProjectManager.getManager().getCurrentProject().moveToTrash(collab);\n204: */\n205:     }\n206: \n207: } /* end class UMLSequenceDiagram */\n208: ",
