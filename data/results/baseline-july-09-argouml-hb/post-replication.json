                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/diagram/state/ui/UMLStateDiagram.java: \n1: // $Id$\n2: // Copyright (c) 1996-2006 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.uml.diagram.state.ui;\n26: \n27: import java.beans.PropertyChangeEvent;\n28: import java.beans.PropertyVetoException;\n29: \n30: import javax.swing.Action;\n31: \n32: import org.apache.log4j.Logger;\n33: import org.argouml.i18n.Translator;\n34: import org.argouml.kernel.ProjectManager;\n35: import org.argouml.model.DeleteInstanceEvent;\n36: import org.argouml.model.Model;\n37: import org.argouml.swingext.ToolBarUtility;\n38: import org.argouml.ui.CmdCreateNode;\n39: import org.argouml.ui.CmdSetMode;\n40: import org.argouml.uml.diagram.UMLMutableGraphSupport;\n41: import org.argouml.uml.diagram.state.StateDiagramGraphModel;\n42: import org.argouml.uml.diagram.ui.RadioAction;\n43: import org.argouml.uml.diagram.ui.UMLDiagram;\n44: import org.argouml.uml.ui.behavior.common_behavior.ActionNewActionSequence;\n45: import org.argouml.uml.ui.behavior.common_behavior.ActionNewCallAction;\n46: import org.argouml.uml.ui.behavior.common_behavior.ActionNewCreateAction;\n47: import org.argouml.uml.ui.behavior.common_behavior.ActionNewDestroyAction;\n48: import org.argouml.uml.ui.behavior.common_behavior.ActionNewReturnAction;\n49: import org.argouml.uml.ui.behavior.common_behavior.ActionNewSendAction;\n50: import org.argouml.uml.ui.behavior.common_behavior.ActionNewTerminateAction;\n51: import org.argouml.uml.ui.behavior.common_behavior.ActionNewUninterpretedAction;\n52: import org.argouml.uml.ui.behavior.state_machines.ButtonActionNewGuard;\n53: import org.tigris.gef.base.LayerPerspective;\n54: import org.tigris.gef.base.LayerPerspectiveMutable;\n55: import org.tigris.gef.base.ModeCreatePolyEdge;\n56: \n57: \n58: /**\n59:  * The UML Statechart diagram. <p>\n60:  * \n61:  * The correct name for this class would be \n62:  * \"UMLStatechartDiagram\". See issue 2306.\n63:  */\n64: public class UMLStateDiagram extends UMLDiagram {\n65:     /**\n66:      * \n67:      */\n68:     private static final long serialVersionUID = -1541136327444703151L;\n69: \n70:     /**\n71:      * Logger.\n72:      */\n73:     private static final Logger LOG = Logger.getLogger(UMLStateDiagram.class);\n74: \n75:     /**\n76:      * this diagram needs to be deleted when its statemachine is deleted.\n77:      */\n78:     private Object theStateMachine;\n79: \n80:     ////////////////\n81:     // actions for toolbar\n82: \n83:     private Action actionStubState;\n84:     private Action actionState;\n85:     private Action actionSynchState;\n86:     private Action actionSubmachineState;\n87:     private Action actionCompositeState;\n88:     private Action actionStartPseudoState;\n89:     private Action actionFinalPseudoState;\n90:     private Action actionBranchPseudoState;\n91:     private Action actionForkPseudoState;\n92:     private Action actionJoinPseudoState;\n93:     private Action actionShallowHistoryPseudoState;\n94:     private Action actionDeepHistoryPseudoState;\n95:     private Action actionCallEvent;\n96:     private Action actionChangeEvent;\n97:     private Action actionSignalEvent;\n98:     private Action actionTimeEvent;\n99:     private Action actionGuard;\n100:     private Action actionCallAction;\n101:     private Action actionCreateAction;\n102:     private Action actionDestroyAction;\n103:     private Action actionReturnAction;\n104:     private Action actionSendAction;\n105:     private Action actionTerminateAction;\n106:     private Action actionUninterpretedAction;\n107:     private Action actionActionSequence;\n108:     private Action actionTransition;\n109:     private Action actionJunctionPseudoState;\n110: \n111:     ////////////////////////////////////////////////////////////////\n112:     // contructors\n113: \n114:     /**\n115:      * This constructor is used to build a dummy statechart diagram so\n116:      * that a project will load properly.\n117:      */\n118:     public UMLStateDiagram() {\n119: \n120:         try {\n121:             setName(getNewDiagramName());\n122:         } catch (PropertyVetoException pve) {\n123:             // nothing we can do about veto, so just ignore it\n124:         }\n125:     }\n126: \n127:     /**\n128:      * Constructor.\n129:      *\n130:      * @param namespace the NameSpace for the new diagram\n131:      * @param machine the StateMachine for the new diagram\n132:      */\n133:     public UMLStateDiagram(Object namespace, Object machine) {\n134:         this();\n135: \n136:         if (!Model.getFacade().isAStateMachine(machine)) {\n137:             throw new IllegalStateException(\n138:                 \"No StateMachine given to create a Statechart diagram\");\n139:         }\n140:         if (namespace == null) {\n141:             namespace = getNamespaceFromMachine(machine);\n142:         }\n143:         if (!Model.getFacade().isANamespace(namespace)) {\n144:             throw new IllegalArgumentException();\n145:         }\n146: \n147:         if (Model.getFacade().getName(namespace) != null) {\n148:             if (!Model.getFacade().getName(namespace).trim().equals(\"\")) {\n149:                 String name = null;\n150:                 String diagramName = Model.getFacade().getName(namespace);\n151:                 int number =\n152:                     (Model.getFacade().getBehaviors(namespace)) == null\n153:                     ? 0\n154:                             : Model.getFacade().getBehaviors(namespace).size();\n155:                 name = diagramName + \" \" + (number++);\n156:                 LOG.info(\"UMLStateDiagram constructor: String name = \" + name);\n157:                 try {\n158:                     setName(name);\n159:                 } catch (PropertyVetoException pve) {\n160:                     // nothing we can do about veto, so just ignore it\n161:                 }\n162:             }\n163:         }\n164:         setup(namespace, machine);\n165:     }\n166: \n167:     /**\n168:      * From a given StateMachine, find the Namespace. \n169:      * Guaranteed to give a non-null result.\n170:      * \n171:      * @param machine the given StateMachine. \n172:      *          If not a StateMachine: throws exception\n173:      * @return the best possible namespace to be deducted\n174:      */\n175:     private Object getNamespaceFromMachine(Object machine) {\n176:         if (!Model.getFacade().isAStateMachine(machine)) {\n177:             throw new IllegalStateException(\n178:                 \"No StateMachine given to create a Statechart diagram\");\n179:         }\n180:         \n181:         Object namespace = Model.getFacade().getNamespace(machine);\n182:         if (namespace != null) return namespace;\n183:         \n184:         Object context = Model.getFacade().getContext(machine);\n185:         if (Model.getFacade().isAClassifier(context)) {\n186:             namespace = context;\n187:         } else if (Model.getFacade().isABehavioralFeature(context)) {\n188:             namespace = Model.getFacade().getNamespace( // or just the owner?\n189:                     Model.getFacade().getOwner(context));\n190:         }\n191:         if (namespace == null) {\n192:             namespace = \n193:                 ProjectManager.getManager().getCurrentProject().getRoot();\n194:         }\n195:         if (namespace == null || !Model.getFacade().isANamespace(namespace)) {\n196:             throw new IllegalStateException(\n197:                     \"Can not deduce a Namespace from a StateMachine\");\n198:         }\n199:         return namespace;\n200:     }\n201: \n202:     /**\n203:      * The owner of a statechart diagram is the statemachine\n204:      * it's showing.\n205:      * @return the statemachine which owns the diagram\n206:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getOwner()\n207:      */\n208:     public Object getOwner() {\n209:         if (!(getGraphModel() instanceof StateDiagramGraphModel)) {\n210:             throw new IllegalStateException(\n211:                     \"Incorrect graph model of \"\n212:                     + getGraphModel().getClass().getName());\n213:         }\n214:         StateDiagramGraphModel gm = (StateDiagramGraphModel) getGraphModel();\n215:         return gm.getMachine();\n216:     }\n217: \n218:     /**\n219:      * Called by the PGML parser to initialize the statechart\n220:      * diagram. First the parser creates a statechart diagram via the\n221:      * default constructor. Then this method is called.\n222:      *\n223:      * @param o the statemachine\n224:      * @see org.tigris.gef.base.Diagram#initialize(Object)\n225:      */\n226:     public void initialize(Object o) {\n227:         if (Model.getFacade().isAStateMachine(o)) {\n228:             Object machine = o;\n229:             Object contextNamespace = getNamespaceFromMachine(machine);\n230: \n231:             setup(contextNamespace, machine);\n232:         } else {\n233:             throw new IllegalStateException(\n234:                 \"Cannot find namespace \"\n235:                     + \"while initializing \"\n236:                     + \"statechart diagram\");\n237:         }\n238:     }\n239: \n240:     /**\n241:      * Method to perform a number of important initializations of a\n242:      * StateDiagram.<p>\n243:      *\n244:      * Each diagram type has a similar <I>UMLxxxDiagram</I> class.<p>\n245:      *\n246:      * Changed <I>lay</I> from <I>LayerPerspective</I> to\n247:      * <I>LayerPerspectiveMutable</I>.  This class is a child of\n248:      * <I>LayerPerspective</I> and was implemented to correct some\n249:      * difficulties in changing the model. <I>lay</I> is used mainly\n250:      * in <I>LayerManager</I>(GEF) to control the adding, changing and\n251:      * deleting layers on the diagram...\n252:      *\n253:      * @param namespace Class from the UML model...connects the class to\n254:      * the Statechart diagram.\n255:      * @param machine StateMachine from the UML model\n256:      * @author psager@tigris.org Jan. 24, 2oo2\n257:      */\n258:     public void setup(Object namespace, Object machine) {\n259:         setNamespace(namespace);\n260: \n261:         theStateMachine = machine;\n262: \n263:         StateDiagramGraphModel gm = new StateDiagramGraphModel();\n264:         gm.setHomeModel(namespace);\n265:         if (theStateMachine != null) {\n266:             gm.setMachine(theStateMachine);\n267:         }\n268:         StateDiagramRenderer rend = new StateDiagramRenderer(); // singleton\n269: \n270:         LayerPerspective lay = new LayerPerspectiveMutable(\n271:                 Model.getFacade().getName(namespace), gm);\n272:         lay.setGraphNodeRenderer(rend);\n273:         lay.setGraphEdgeRenderer(rend);\n274:         setLayer(lay);\n275: \n276:         /* Listen to machine deletion, \n277:          * to delete the diagram. */\n278:         Model.getPump().addModelEventListener(this, theStateMachine, \n279:                 new String[] {\"remove\", \"namespace\"});\n280:     }\n281: \n282:     /*\n283:      * @see org.argouml.uml.diagram.ui.UMLDiagram#propertyChange(java.beans.PropertyChangeEvent)\n284:      */\n285:     public void propertyChange(PropertyChangeEvent evt) {\n286:         if ((evt.getSource() == theStateMachine)\n287:                 && (evt instanceof DeleteInstanceEvent)\n288:                 && \"remove\".equals(evt.getPropertyName())) {\n289:             Model.getPump().removeModelEventListener(this, \n290:                     theStateMachine, new String[] {\"remove\", \"namespace\"});\n291:             ProjectManager.getManager().getCurrentProject().moveToTrash(this);\n292:         }\n293:         if (evt.getSource() == theStateMachine \n294:                 && \"namespace\".equals(evt.getPropertyName())) {\n295:             Object newNamespace = evt.getNewValue();\n296:             if (newNamespace != null // this in case we are being deleted \n297:                     && getNamespace() != newNamespace) {\n298:                 /* The namespace of the statemachine is changed! */\n299:                 setNamespace(newNamespace);\n300:                 ((UMLMutableGraphSupport) getGraphModel())\n301:                                 .setHomeModel(newNamespace);\n302:             }\n303:         }\n304:     }\n305: \n306:     /**\n307:      * @return the StateMachine belonging to this diagram\n308:      */\n309:     public Object getStateMachine() {\n310:         return ((StateDiagramGraphModel) getGraphModel()).getMachine();\n311:     }\n312: \n313:     /**\n314:      * @param sm Set the StateMachine for this diagram.\n315:      */\n316:     public void setStateMachine(Object sm) {\n317: \n318:         if (!Model.getFacade().isAStateMachine(sm)) {\n319:             throw new IllegalArgumentException(\"This is not a StateMachine\");\n320:         }\n321: \n322:         ((StateDiagramGraphModel) getGraphModel()).setMachine(sm);\n323:     }\n324: \n325:     /**\n326:      * Get the actions from which to create a toolbar or equivalent\n327:      * graphic triggers.\n328:      * @return the array of actions\n329:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getUmlActions()\n330:      */\n331:     protected Object[] getUmlActions() {\n332:         Object[] actions =\n333:         {\n334:             getActionState(),\n335: \t    getActionCompositeState(),\n336: \t    getActionTransition(),\n337: \t    getActionSynchState(),\n338: \t    getActionSubmachineState(),\n339: \t    getActionStubState(),\n340: \t    null,\n341: \t    getActionStartPseudoState(),\n342: \t    getActionFinalPseudoState(),\n343: \t    getActionJunctionPseudoState(),\n344:             getActionChoicePseudoState(),\n345: \t    getActionForkPseudoState(),\n346: \t    getActionJoinPseudoState(),\n347: \t    getActionShallowHistoryPseudoState(),\n348: \t    getActionDeepHistoryPseudoState(),\n349:             null,\n350:             getTriggerActions(),\n351:             getActionGuard(),\n352:             getEffectActions(),\n353:         };\n354:         return actions;\n355:     }\n356: \n357:     protected Object[] getTriggerActions() {\n358:         Object[] actions = {\n359:             getActionCallEvent(),\n360:             getActionChangeEvent(),\n361:             getActionSignalEvent(),\n362:             getActionTimeEvent(),\n363:         };\n364:         ToolBarUtility.manageDefault(actions, \"diagram.state.trigger\");\n365:         return actions;\n366:     }\n367: \n368:     protected Object[] getEffectActions() {\n369:         Object[] actions = {\n370:             getActionCallAction(),\n371:             getActionCreateAction(),\n372:             getActionDestroyAction(),\n373:             getActionReturnAction(),\n374:             getActionSendAction(),\n375:             getActionTerminateAction(),\n376:             getActionUninterpretedAction(),\n377:             getActionActionSequence(),\n378:         };\n379:         ToolBarUtility.manageDefault(actions, \"diagram.state.effect\");\n380:         return actions;\n381:     }\n382: \n383:     /**\n384:      * Creates a name for the diagram.\n385:      *\n386:      * @return the new diagram name\n387:      */\n388:     protected String getNewDiagramName() {\n389:         String name = getLabelName() + \" \" + getNextDiagramSerial();\n390:         if (!ProjectManager.getManager().getCurrentProject()\n391:                  .isValidDiagramName(name)) {\n392:             name = getNewDiagramName();\n393:         }\n394:         return name;\n395:     }\n396: \n397:     /*\n398:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getLabelName()\n399:      */\n400:     public String getLabelName() {\n401:         return Translator.localize(\"label.state-chart-diagram\");\n402:     }\n403: \n404:     /**\n405:      * @return Returns the actionChoicePseudoState.\n406:      */\n407:     protected Action getActionChoicePseudoState() {\n408:         if (actionBranchPseudoState == null) {\n409:             actionBranchPseudoState = new RadioAction(\n410:                     new ActionCreatePseudostate(Model.getPseudostateKind()\n411:                             .getChoice(), \"button.new-choice\"));\n412:         }\n413:         return actionBranchPseudoState;\n414:     }\n415: \n416:     /**\n417:      * @return Returns the actionCompositeState.\n418:      */\n419:     protected Action getActionCompositeState() {\n420:         if (actionCompositeState == null) {\n421:             actionCompositeState =\n422:                 new RadioAction(new CmdCreateNode(\n423:                         Model.getMetaTypes().getCompositeState(),\n424:                         \"button.new-compositestate\"));\n425:         }\n426:         return actionCompositeState;\n427:     }\n428:     /**\n429:      * @return Returns the actionDeepHistoryPseudoState.\n430:      */\n431:     protected Action getActionDeepHistoryPseudoState() {\n432:         if (actionDeepHistoryPseudoState == null) {\n433:             actionDeepHistoryPseudoState = new RadioAction(\n434:                     new ActionCreatePseudostate(\n435:                         Model.getPseudostateKind().getDeepHistory(),\n436:                         \"button.new-deephistory\"));\n437:         }\n438:         return actionDeepHistoryPseudoState;\n439:     }\n440:     /**\n441:      * @return Returns the actionFinalPseudoState.\n442:      */\n443:     protected Action getActionFinalPseudoState() {\n444:         if (actionFinalPseudoState == null) {\n445:             actionFinalPseudoState =\n446:                 new RadioAction(\n447:                         new CmdCreateNode(\n448:                                 Model.getMetaTypes().getFinalState(),\n449:                                 \"button.new-finalstate\"));\n450:         }\n451:         return actionFinalPseudoState;\n452:     }\n453:     /**\n454:      * @return Returns the actionForkPseudoState.\n455:      */\n456:     protected Action getActionForkPseudoState() {\n457:         if (actionForkPseudoState == null) {\n458:             actionForkPseudoState = new RadioAction(\n459:                     new ActionCreatePseudostate(\n460:                             Model.getPseudostateKind()\n461:                             .getFork(), \"button.new-fork\"));\n462:         }\n463:         return actionForkPseudoState;\n464:     }\n465:     /**\n466:      * @return Returns the actionJoinPseudoState.\n467:      */\n468:     protected Action getActionJoinPseudoState() {\n469:         if (actionJoinPseudoState == null) {\n470:             actionJoinPseudoState = new RadioAction(new ActionCreatePseudostate(\n471:                     Model.getPseudostateKind().getJoin(), \"button.new-join\"));\n472:         }\n473:         return actionJoinPseudoState;\n474:     }\n475:     /**\n476:      * @return Returns the actionJunctionPseudoState.\n477:      */\n478:     protected Action getActionJunctionPseudoState() {\n479:         if (actionJunctionPseudoState == null) {\n480:             actionJunctionPseudoState = new RadioAction(\n481:                     new ActionCreatePseudostate(\n482:                         Model.getPseudostateKind().getJunction(),\n483:                         \"button.new-junction\"));\n484:         }\n485:         return actionJunctionPseudoState;\n486:     }\n487:     /**\n488:      * @return Returns the actionShallowHistoryPseudoState.\n489:      */\n490:     protected Action getActionShallowHistoryPseudoState() {\n491:         if (actionShallowHistoryPseudoState == null) {\n492:             actionShallowHistoryPseudoState = new RadioAction(\n493:                     new ActionCreatePseudostate(\n494:                         Model.getPseudostateKind().getShallowHistory(),\n495:                         \"button.new-shallowhistory\"));\n496:         }\n497:         return actionShallowHistoryPseudoState;\n498:     }\n499:     /**\n500:      * @return Returns the actionStartPseudoState.\n501:      */\n502:     protected Action getActionStartPseudoState() {\n503:         if (actionStartPseudoState == null) {\n504:             actionStartPseudoState = new RadioAction(\n505:                     new ActionCreatePseudostate(\n506:                         Model.getPseudostateKind().getInitial(),\n507:                         \"button.new-initial\"));\n508:         }\n509:         return actionStartPseudoState;\n510:     }\n511:     /**\n512:      * @return Returns the actionState.\n513:      */\n514:     protected Action getActionState() {\n515:         if (actionState == null) {\n516:             actionState =\n517:                 new RadioAction(\n518:                         new CmdCreateNode(Model.getMetaTypes().getSimpleState(),\n519:                                 \t  \"button.new-simplestate\"));\n520:         }\n521:         return actionState;\n522:     }\n523: \n524:     /**\n525:      * @return Returns the actionSynchState.\n526:      */\n527:     protected Action getActionSynchState() {\n528:         if (actionSynchState == null) {\n529:             actionSynchState =\n530:                 new RadioAction(\n531:                         new CmdCreateNode(\n532:                                 Model.getMetaTypes().getSynchState(),\n533:                                 \"button.new-synchstate\"));\n534:         }\n535:         return actionSynchState;\n536:     }\n537: \n538:     /**\n539:      * @return Returns the actionSubmachineState.\n540:      */\n541:     protected Action getActionSubmachineState() {\n542:         if (actionSubmachineState == null) {\n543:             actionSubmachineState =\n544:                     new RadioAction(\n545:                             new CmdCreateNode(\n546:                                     Model.getMetaTypes().getSubmachineState(),\n547:                                     \"button.new-submachinestate\"));\n548:         }\n549:         return actionSubmachineState;\n550:     }\n551: \n552:     /**\n553:      * @return Returns the actionSubmachineState.\n554:      */\n555:     protected Action getActionStubState() {\n556:         if (actionStubState == null) {\n557:             actionStubState =\n558:                     new RadioAction(\n559:                             new CmdCreateNode(\n560:                                     Model.getMetaTypes().getStubState(),\n561:                                     \"button.new-stubstate\"));\n562:         }\n563:         return actionStubState;\n564:     }\n565: \n566:     /**\n567:      * @return Returns the actionTransition.\n568:      */\n569:     protected Action getActionTransition() {\n570:         if (actionTransition == null) {\n571:             actionTransition = new RadioAction(\n572:                     new CmdSetMode(\n573:                         ModeCreatePolyEdge.class,\n574:                         \"edgeClass\",\n575:                         Model.getMetaTypes().getTransition(),\n576:                         \"button.new-transition\"));\n577:         }\n578:         return actionTransition;\n579:     }\n580: \n581:     /**\n582:      * @return Returns the actionCallEvent.\n583:      */\n584:     protected Action getActionCallEvent() {\n585:         if (actionCallEvent == null) {\n586:             actionCallEvent = new ButtonActionNewCallEvent();\n587:         }\n588:         return actionCallEvent;\n589:     }\n590: \n591:     /**\n592:      * @return Returns the actionCallEvent.\n593:      */\n594:     protected Action getActionChangeEvent() {\n595:         if (actionChangeEvent == null) {\n596:             actionChangeEvent = new ButtonActionNewChangeEvent();\n597:         }\n598:         return actionChangeEvent;\n599:     }\n600: \n601:     /**\n602:      * @return Returns the actionCallEvent.\n603:      */\n604:     protected Action getActionSignalEvent() {\n605:         if (actionSignalEvent == null) {\n606:             actionSignalEvent = new ButtonActionNewSignalEvent();\n607:         }\n608:         return actionSignalEvent;\n609:     }\n610: \n611:     /**\n612:      * @return Returns the actionCallEvent.\n613:      */\n614:     protected Action getActionTimeEvent() {\n615:         if (actionTimeEvent == null) {\n616:             actionTimeEvent = new ButtonActionNewTimeEvent();\n617:         }\n618:         return actionTimeEvent;\n619:     }\n620: \n621:     protected Action getActionGuard() {\n622:         if (actionGuard == null) {\n623:             actionGuard = new ButtonActionNewGuard();\n624:         }\n625:         return actionGuard;\n626:     }\n627:     \n628:     protected Action getActionCallAction() {\n629:         if (actionCallAction == null) {\n630:             actionCallAction = ActionNewCallAction.getButtonInstance();\n631:         }\n632:         return actionCallAction;\n633:     }\n634:     \n635:     protected Action getActionCreateAction() {\n636:         if (actionCreateAction == null) {\n637:             actionCreateAction = ActionNewCreateAction.getButtonInstance();\n638:         }\n639:         return actionCreateAction;\n640:     }\n641: \n642:     protected Action getActionDestroyAction() {\n643:         if (actionDestroyAction == null) {\n644:             actionDestroyAction = ActionNewDestroyAction.getButtonInstance();\n645:         }\n646:         return actionDestroyAction;\n647:     }\n648: \n649:     protected Action getActionReturnAction() {\n650:         if (actionReturnAction == null) {\n651:             actionReturnAction = ActionNewReturnAction.getButtonInstance();\n652:         }\n653:         return actionReturnAction;\n654:     }\n655:     \n656:     protected Action getActionSendAction() {\n657:         if (actionSendAction == null) {\n658:             actionSendAction = ActionNewSendAction.getButtonInstance();\n659:         }\n660:         return actionSendAction;\n661:     }\n662:     \n663:     protected Action getActionTerminateAction() {\n664:         if (actionTerminateAction == null) {\n665:             actionTerminateAction = \n666:                 ActionNewTerminateAction.getButtonInstance();\n667:         }\n668:         return actionTerminateAction;\n669:     }\n670: \n671:     protected Action getActionUninterpretedAction() {\n672:         if (actionUninterpretedAction == null) {\n673:             actionUninterpretedAction = \n674:                 ActionNewUninterpretedAction.getButtonInstance();\n675:         }\n676:         return actionUninterpretedAction;\n677:     }\n678: \n679: \n680:     protected Action getActionActionSequence() {\n681:         if (actionActionSequence == null) {\n682:             actionActionSequence = \n683:                 ActionNewActionSequence.getButtonInstance();\n684:         }\n685:         return actionActionSequence;\n686:     }\n687: \n688:     /*\n689:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getDependentElement()\n690:      */\n691:     public Object getDependentElement() {\n692:         return getStateMachine(); /* The StateMachine. */\n693:     }\n694: \n695:     /*\n696:      * @see org.argouml.uml.diagram.ui.UMLDiagram#isRelocationAllowed(java.lang.Object)\n697:      */\n698:     public boolean isRelocationAllowed(Object base)  {\n699:     \treturn false;\n700:     \t/* TODO: We may return the following when the\n701:     \t * relocate() has been implemented. */\n702: //    \tModel.getStateMachinesHelper()\n703: //        \t.isAddingStatemachineAllowed(base);\n704:     }\n705: \n706:     /*\n707:      * @see org.argouml.uml.diagram.ui.UMLDiagram#relocate(java.lang.Object)\n708:      */\n709:     public boolean relocate(Object base) {\n710:         return false;\n711:     }\n712: \n713: } /* end class UMLStateDiagram */\n714: ",
