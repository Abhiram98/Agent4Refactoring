    }\n1235:             }\n1236:         }\n1237:         Rectangle rect = getBounds();\n1238:         updateFigGroupSize(getOperationsFig(), xpos, ypos, 0, 0);\n1239:         // ouch ugly but that's for a next refactoring\n1240:         // TODO: make setBounds, calcBounds and updateBounds consistent\n1241:         setBounds(rect.x, rect.y, rect.width, rect.height);\n1242:         damage();\n1243:     }\n1244: \n1245:     /**\n1246:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#renderingChanged()\n1247:      */\n1248:     public void renderingChanged() {\n1249:         if (getOwner() != null) {\n1250:             updateAttributes();\n1251:             updateOperations();\n1252:             updateAbstract();\n1253:         }\n1254:         super.renderingChanged();\n1255:     }\n1256: \n1257:     /**\n1258:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateNameText()\n1259:      */\n1260:     protected void updateNameText() {\n1261: \n1262:         super.updateNameText();\n1263:         calcBounds();\n1264:         setBounds(getBounds());\n1265: \n1266:         // setBounds(rect.x, rect.y, rect.width, rect.height);\n1267:     }\n1268: \n1269:     /**\n1270:      * Updates the name if modelchanged receives an \"isAbstract\" event\n1271:      */\n1272:     protected void updateAbstract() {\n1273:         Rectangle rect = getBounds();\n1274:         if (getOwner() == null) {\n1275:             return;\n1276:         }\n1277:         Object cls = /*(MClass)*/ getOwner();\n1278:         if (ModelFacade.isAbstract(cls)) {\n1279:             getNameFig().setFont(getItalicLabelFont());\n1280: \t} else {\n1281:             getNameFig().setFont(getLabelFont());\n1282: \t}\n1283:         super.updateNameText();\n1284:         setBounds(rect.x, rect.y, rect.width, rect.height);\n1285:     }\n1286: \n1287:     /**\n1288:      * @see FigNodeModelElement#updateListeners(Object)\n1289:      */\n1290:     protected void updateListeners(Object newOwner) {\