 = 1; \n91:     _baseField.setMinimumSize(new Dimension(120, 20)); \n92:     gb.setConstraints(_baseField, c); \n93:     add(_baseField); \n94:     _baseField.getDocument().addDocumentListener(this); \n95:     _baseField.setFont(_stereoField.getFont()); \n96: \n97:   }\n98: \n99:   ////////////////////////////////////////////////////////////////\n100:   // accessors\n101: \n102: \n103:   /** Set the values to be shown in all widgets based on model */ \n104:   protected void setTargetInternal(Object t) { \n105:     super.setTargetInternal(t); \n106:     MNodeInstance noi = (MNodeInstance) t; \n107:     if (noi.getClassifiers() != null) { \n108:       String base = \"\"; \n109:       Collection classifiers = noi.getClassifiers(); \n110:       Iterator it = classifiers.iterator(); \n111:       while (it.hasNext()) { \n112:         Object o = it.next(); \n113:         if (o != null && (o instanceof MClassifier)) { \n114:           MClassifier cls = (MClassifier) o; \n115:           if (cls != null) { \n116:             base = cls.getName(); \n117:           } \n118:         } \n119:       } \n120:       _baseField.setText(base);         \n121:     }  \n122:     else { \n123:       _baseField.setText(null); \n124:     } \n125:     \n126:     // set the values to be shown in all widgets based on model \n127:       validate(); \n128:   } \n129: \n130:   public void setTargetBase() {  \n131:     if (_target == null) return;  \n132:     if (_inChange) return; \n133:   \n134:     MNodeInstance noi = (MNodeInstance) _target; \n135:     MNode classifier = new MNodeImpl();  \n136:     String base = _baseField.getText(); \n137:     Collection col = noi.getClassifiers(); \n138:     if ((col != null) && (col.size()>0)) {  \n139:       Iterator itcol = col.iterator();  \n140:       while (itcol.hasNext()) {  \n141:         MClassifier cls = (MClassifier) itcol.next();  \n142:         noi.removeClassifier(cls);  \n143:       }  \n144:     }  \n145:  \n146:     Vector diagrams = Proje