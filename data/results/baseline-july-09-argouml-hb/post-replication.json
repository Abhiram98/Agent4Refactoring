33: import javax.swing.JMenuBar;\n34: import javax.swing.JMenuItem;\n35: import javax.swing.JToolBar;\n36: import javax.swing.KeyStroke;\n37: \n38: import org.argouml.application.api.Argo;\n39: import org.argouml.application.api.PluggableMenu;\n40: import org.argouml.application.events.ArgoEventPump;\n41: import org.argouml.application.events.ArgoEventTypes;\n42: import org.argouml.application.events.ArgoModuleEvent;\n43: import org.argouml.application.events.ArgoModuleEventListener;\n44: import org.argouml.i18n.Translator;\n45: import org.argouml.ui.ActionAutoResize;\n46: import org.argouml.ui.ActionSaveConfiguration;\n47: import org.argouml.ui.ActionSettings;\n48: import org.argouml.ui.Actions;\n49: import org.argouml.ui.ArgoJMenu;\n50: import org.argouml.ui.ZoomSliderButton;\n51: import org.argouml.ui.cmd.CmdSetPreferredSize;\n52: import org.argouml.ui.targetmanager.NavigateTargetBackAction;\n53: import org.argouml.ui.targetmanager.NavigateTargetForwardAction;\n54: import org.argouml.uml.ui.ActionActivityDiagram;\n55: import org.argouml.uml.ui.ActionClassDiagram;\n56: import org.argouml.uml.ui.ActionCollaborationDiagram;\n57: import org.argouml.uml.ui.ActionCopy;\n58: import org.argouml.uml.ui.ActionCut;\n59: import org.argouml.uml.diagram.ui.ActionDeleteFromDiagram;\n60: import org.argouml.uml.ui.ActionDeploymentDiagram;\n61: import org.argouml.uml.ui.ActionExit;\n62: import org.argouml.uml.ui.ActionGenerateAll;\n63: import org.argouml.uml.ui.ActionGenerateOne;\n64: import org.argouml.uml.ui.ActionGenerateProjectCode;\n65: import org.argouml.uml.ui.ActionGenerationSettings;\n66: import org.argouml.uml.ui.ActionImportFromSources;\n67: import org.argouml.uml.ui.ActionNew;\n68: import org.argouml.uml.ui.ActionOpenProject;\n69: import org.argouml.uml.ui.ActionPaste;\n70: import org.argouml.uml.ui.ActionRemoveFromModel;\n71: import org.argouml.uml.ui.ActionRevertToSaved;\n72: import org.argouml.uml.ui.ActionSaveGraphics;\n73: import org.argouml.uml.ui.ActionSaveProject;\n74: import org.argouml.uml.ui.ActionSaveProjectAs;\n75: import org.argouml.uml.ui.ActionSequenceDiagram;\n76: import org.argouml.uml.ui.ActionStateDiagram;\n77: import org.argouml.uml.ui.ActionUseCaseDiagram;\n78: import org.tigris.gef.base.CmdAdjustGrid;\n79: import org.tigris.gef.base.CmdAdjustGuide;\n80: import org.tigris.gef.base.CmdAdjustPageBreaks;\n81: import org.tigris.gef.base.CmdSelectAll;\n82: import org.tigris.gef.base.CmdSelectInvert;\n83: import org.tigris.gef.base.CmdZoom;\n84: import org.tigris.toolbar.ToolBar;\n85: \n86: /**\n87:  * GenericArgoMenuBar defines the menubar for all\n88:  * operating systems which do not explicitely ask\n89:  * for a different kind of menu bar, such as\n90:  * Mac OS X.<p>\n91:  *\n92:  * Menu's and the mnemonics of menu's and the menuitems are separated \n93:  * in the PropertyResourceBundle <b>menu.properties<b/>.<p>\n94:  *\n95:  * menuitems are separated in the PropertyResourceBundle \n96:  * <b>action.properties<b/>.<p>\n97:  *\n98:  * The key's in menu.properties have the following structure:<p>\n99:  * <pre>\n100:  * menu:                    [file].[name of menu]\n101:  *  e.g:                    menu.file\n102:  *\n103:  * mnemonics of menu's:     [file].[name of menu].mnemonic\n104:  *  e.g:                    menu.file.mnemonic\n105:  *\n106:  * mnemonics of menuitems:  [file].[flag for item].[name of menuitem].mnemonic\n107:  *  e.g:                    menu.item.new.mnemonic\n108:  * </pre>\n109:  */\n110: public class GenericArgoMenuBar extends JMenuBar\n111:     implements ArgoModuleEventListener {\n112: \n113:     /** Name and prepareKey-Strings of/for the PropertyResourceBundle \n114:      * menu.properties.\n115:      * MENU     = Prefix for menu-keys\n116:      * MENUITEM = Prefix for menuitem-keys\n117:      */\n118:     private static final String MENU = \"menu.\";\n119:     private static final String MENUITEM = \"menu.item.\";\n120: \n121:     private JToolBar fileToolbar;\n122:     private JToolBar editToolbar;\n123:     private JToolBar viewToolbar;\n124:     private JToolBar createDiagramToolbar;\n125:     \n126:     /** lru project list */\n127:     private LastRecentlyUsedMenuList lruList = null;\n128: \n129:     /** Edit menu\n130:      */\n131:     private JMenu edit = null;\n132:     /** unknown where this appears in the UI\n133:      */\n134:     private JMenu select = null;\n135:     /** toolbar: view under which is the goto diagram/ find\n136:      * zoom!!! this should be activated as a right click command.\n137:      * editor tabs/details tabs/ adjust grid etc.\n138:      */\n139:     private ArgoJMenu view = null;\n140:     /** Toolbar:create diagram\n141:      */\n142:     private JMenu createDiagrams = null;\n143:     /** currently disactivated\n144:      */\n145:     private JMenu tools = null;\n146:     /** currently supports rudimentary java generation,\n147:      * new modules for php and html/javadocs are planned\n148:      * feel free to contribute here!\n149:      */\n150:     private JMenu generate = null;\n151:     /** this should be invoked automatically when\n152:      * importing sources.\n153:      */\n154:     private ArgoJMenu arrange = null;\n155:     /** currently undergoing significant testing\n156:      */\n157:     private ArgoJMenu critique = null;\n158:     /** It needs it. Currently there is only an\n159:      * about text. hyperlinking to online docs at\n160:      * argouml.org considered basic improvement.\n161:      */\n162:     private JMenu help = null;\n163: \n164: \n165:     /**\n166:      * The constructor.\n167:      * \n168:      */\n169:     public GenericArgoMenuBar() {\n170:         initMenus();\n171:     }\n172: \n173:     /** This should be a user specified option. New laws\n174:      * for handicapped people who cannot use the\n175:      * mouse require software developers in US to\n176:      * make all components of User interface accessible\n177:      * through keyboard\n178:      * \n179:      * @param item is the JMenuItem to do this for.\n180:      * @param key is the key that we do this for.\n181:      */\n182:     protected static final void setMnemonic(JMenuItem item, String key)\n183:     {\n184: \tString propertykey = new String();\n185: \tif (item instanceof JMenu) {\n186: \t    propertykey = MENU + prepareKey(key) + \".mnemonic\";\n187: \t}\n188: \telse {\n189: \t    propertykey = MENUITEM + prepareKey(key) + \".mnemonic\";\n190: \t}\n191: \t\t\n192: \tString localMnemonic = Translator.localize(propertykey);\n193: \tchar mnemonic = ' ';\n194: \tif (localMnemonic != null && localMnemonic.length() == 1) {\n195: \t    mnemonic = localMnemonic.charAt(0);\n196: \t}\n197: \titem.setMnemonic(mnemonic);\n198:     }\n199: \n200:     /**\n201:      * @param key the key to localize\n202:      * @return the localized string\n203:      */\n204:     protected static final String menuLocalize(String key) {\n205: \treturn Translator.localize(MENU + prepareKey(key));\n206:     }\n207: \n208:     static final void setAccelerator(JMenuItem item, KeyStroke keystroke) {\n209:         if (keystroke != null) {\n210:             item.setAccelerator(keystroke);\n211:         }\n212:     }\n213: \n214: \n215:     /** Scans through all loaded modules to see if it has an item to add\n216:      * in this diagram.\n217:      *\n218:      * @param menuitem The menuitem which this menuitem would attach to.\n219:      * @param key Non-localized string that tells the module where we are.\n220:      */\n221:     private void appendPluggableMenus(JMenuItem menuitem, String key) {\n222:         Object[] context = {\n223: \t    menuitem, key \n224: \t};\n225:         ArrayList arraylist = Argo.getPlugins(PluggableMenu.class, context);\n226:         ListIterator iterator = arraylist.listIterator();\n227:         while (iterator.hasNext()) {\n228:             PluggableMenu module = (PluggableMenu) iterator.next();\n229:             menuitem.add(module.getMenuItem(context));\n230:             menuitem.setEnabled(true);\n231:         }\n232:     }\n233: \n234:     /**\n235:      * @see ArgoModuleEventListener#moduleLoaded(ArgoModuleEvent)\n236:      */\n237:     public void moduleLoaded(ArgoModuleEvent event) {\n238:         if (event.getSource() instanceof PluggableMenu) {\n239:             PluggableMenu module = (PluggableMenu) event.getSource();\n240:             Object[] context = new Object[] {\n241: \t\ttools, \"Tools\" \n242: \t    };\n243:             if (module.inContext(context)) {\n244:                 tools.add(module.getMenuItem(context));\n245:                 tools.setEnabled(true);\n246:             }\n247:             //context = new Object[] { _import, \"File:Import\" };\n248:             //if (module.inContext(context)) {\n249: \t    //  _import.add(module.getMenuItem(context));\n250:             //}\n251:             context = new Object[] {\n252: \t\tgenerate, \"Generate\" \n253: \t    };\n254:             if (module.inContext(context)) {\n255:                 generate.add(module.getMenuItem(context));\n256:             }\n257:             context = new Object[] {\n258: \t\tedit, \"Edit\" \n259: \t    };\n260:             if (module.inContext(context)) {\n261:                 edit.add(module.getMenuItem(context));\n262:             }\n263:             context = new Object[] {\n264: \t\tview, \"View\" \n265: \t    };\n266:             if (module.inContext(context)) {\n267:       \t        view.add(module.getMenuItem(context));\n268:             }\n269:             context = new Object[] {\n270: \t\tcreateDiagrams, \"Create Diagrams\" \n271: \t    };\n272:             if (module.inContext(context)) {\n273:        \t        createDiagrams.add(module.getMenuItem(context));\n274:             }\n275:             context = new Object[] {\n276: \t\tarrange, \"Arrange\" \n277: \t    };\n278:             if (module.inContext(context)) {\n279:        \t        arrange.add(module.getMenuItem(context));\n280:             }\n281:             context = new Object[] {\n282: \t\thelp, \"Help\" \n283: \t    };\n284:             if (module.inContext(context)) {\n285:                 if (help.getItemCount() == 1) {\n286:                     help.insertSeparator(0);\n287:                 }\n288:                 help.insert(module.getMenuItem(context), 0);\n289:             }\n290:         }\n291:     }\n292: \n293:     /**\n294:      * @see ArgoModuleEventListener#moduleUnloaded(ArgoModuleEvent)\n295:      */\n296:     public void moduleUnloaded(ArgoModuleEvent event) {\n297:         // TODO:  Disable menu\n298:     }\n299: \n300:     /**\n301:      * @see ArgoModuleEventListener#moduleEnabled(ArgoModuleEvent)\n302:      */\n303:     public void moduleEnabled(ArgoModuleEvent event) {\n304:         // TODO:  Enable menu\n305:     }\n306: \n307:     /**\n308:      * @see ArgoModuleEventListener#moduleDisabled(ArgoModuleEvent)\n309:      */\n310:     public void moduleDisabled(ArgoModuleEvent event) {\n311:         // TODO:  Disable menu\n312:     }\n313: \n314:     /**\n315:      * Construct the ordinary all purpose Argo Menu Bar.\n316:      */\n317:     protected void initMenus() {\n318:         int menuShortcut = Toolkit.getDefaultToolkit().getMenuShortcutKeyMask();\n319: \n320:         // These are currently not used.\n321: /*        KeyStroke ctrlMinus =\n322: \t    KeyStroke.getKeyStroke(KeyEvent.VK_MINUS, menuShortcut);\n323:         KeyStroke ctrlEquals =\n324: \t    KeyStroke.getKeyStroke(KeyEvent.VK_EQUALS, menuShortcut);\n325:         KeyStroke f3 = KeyStroke.getKeyStroke(KeyEvent.VK_F3, 0);\n326:         KeyStroke altLeft =\n327: \t    KeyStroke.getKeyStroke(KeyEvent.VK_LEFT, KeyEvent.ALT_MASK);\n328:         KeyStroke altRight =\n329: \t    KeyStroke.getKeyStroke(KeyEvent.VK_RIGHT, KeyEvent.ALT_MASK);\n330: */\n331: \n332: \n333:         // ------------------------------------- File Menu\n334:         initMenuFile(menuShortcut);\n335: \n336: \t// ------------------------------------- Edit Menu\n337:         initMenuEdit(menuShortcut);\n338: \t\t\n339: \t// ------------------------------------- View Menu\n340:         initMenuView(menuShortcut);\n341: \n342: \t// ------------------------------------- Create Menu\n343:         initMenuCreate();\n344: \n345: \t// ------------------------------------- Arrange Menu\n346:         initMenuArrange();\n347: \n348: \t// ------------------------------------- Generation Menu\n349:         initMenuGeneration();\n350: \n351: \t// ------------------------------------- Critique Menu\n352:         initMenuCritique();\n353: \n354: \t// ------------------------------------- Tools Menu\n355:         initMenuTools();\n356: \n357: \t// ------------------------------------- Help Menu\n358:         initMenuHelp();\n359: \n360:         ArgoEventPump.addListener(ArgoEventTypes.ANY_MODULE_EVENT, this);\n361:     }\n362: \n363:     /**\n364:      * Build the menu \"File\".\n365:      * \n366:      * @param mask menu shortcut key mask\n367:      */\n368:     private void initMenuFile(int mask) {\n369:         \n370:         KeyStroke ctrlN = KeyStroke.getKeyStroke(KeyEvent.VK_N, mask);\n371:         KeyStroke ctrlO = KeyStroke.getKeyStroke(KeyEvent.VK_O, mask);\n372:         KeyStroke ctrlS = KeyStroke.getKeyStroke(KeyEvent.VK_S, mask);\n373:         KeyStroke ctrlP = KeyStroke.getKeyStroke(KeyEvent.VK_P, mask);\n374:         KeyStroke altF4 =\n375:             KeyStroke.getKeyStroke(KeyEvent.VK_F4, KeyEvent.ALT_MASK);\n376:         \n377:         JMenu file = new JMenu(menuLocalize(\"File\"));\n378:         add(file);\n379:         setMnemonic(file, \"File\");\n380:         fileToolbar = new ToolBar(\"File Toolbar\");\n381:         fileToolbar.putClientProperty(\"JToolBar.isRollover\",  Boolean.TRUE);\n382:         JMenuItem newItem = file.add(ActionNew.SINGLETON);\n383:         setMnemonic(newItem, \"New\");\n384:         setAccelerator(newItem, ctrlN);\n385:         fileToolbar.add((ActionNew.SINGLETON));\n386:         JMenuItem openProjectItem = file.add(new ActionOpenProject());\n387:         setMnemonic(openProjectItem, \"Open\");\n388:         setAccelerator(openProjectItem, ctrlO);\n389:         fileToolbar.add(new ActionOpenProject());\n390:         file.addSeparator();\n391: \n392:         JMenuItem saveProjectItem = file.add(ActionSaveProject.SINGLETON);\n393:         setMnemonic(saveProjectItem, \"Save\");\n394:         setAccelerator(saveProjectItem, ctrlS);\n395:         fileToolbar.add((ActionSaveProject.SINGLETON));\n396:         JMenuItem saveProjectAsItem = file.add(ActionSaveProjectAs.SINGLETON);\n397:         setMnemonic(saveProjectAsItem, \"SaveAs\");\n398:         JMenuItem revertToSavedItem = file.add(new ActionRevertToSaved());\n399:         setMnemonic(revertToSavedItem, \"Revert To Saved\");\n400:         file.addSeparator();\n401: \n402:         //_import = new JMenu(menuLocalize(\"action.import\"));\n403:         //JMenuItem importProjectAsItem =\n404:         //_import.add(ActionImportFromSources.SINGLETON);\n405:         //appendPluggableMenus(_import,\n406:         //PluggableMenu.KEY_FILE_IMPORT);\n407:         JMenuItem importFromSources =\n408: \t    file.add(ActionImportFromSources.getInstance());\n409:         setMnemonic(importFromSources, \"Import\");\n410:         file.addSeparator();\n411:     \n412:         JMenuItem pageSetupItem = file.add(Actions.pageSetup);\n413: \tsetMnemonic(pageSetupItem, \"PageSetup\");\n414:         JMenuItem printItem = file.add(Actions.print);\n415:         setMnemonic(printItem, \"Print\");\n416:         setAccelerator(printItem, ctrlP);\n417:         fileToolbar.add((Actions.print));\n418:         JMenuItem saveGraphicsItem = file.add(new ActionSaveGraphics());\n419:         setMnemonic(saveGraphicsItem, \"SaveGraphics\");\n420:         file.addSeparator();\n421:         JMenuItem saveConfiguration = \n422:             file.add(new ActionSaveConfiguration());\n423:         setMnemonic(saveConfiguration, \"Save Configuration\");\n424: