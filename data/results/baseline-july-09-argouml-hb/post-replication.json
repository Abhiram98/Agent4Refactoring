  /**\n296:      * @return Returns the actionJunctionPseudoState.\n297:      */\n298:     protected Action getActionJunctionPseudoState() {\n299:         if (actionJunctionPseudoState == null) {\n300:             actionJunctionPseudoState =\n301:                 new RadioAction(\n302:                         new ActionCreatePseudostate(\n303:                                 Model.getPseudostateKind().getJunction(),\n304:                                 \"button.new-junction\"));\n305:         }\n306:         return actionJunctionPseudoState;\n307:     }\n308:     /**\n309:      * @return Returns the actionNewSwimlane.\n310:      */\n311:     protected Action getActionNewSwimlane() {\n312:         if (actionNewSwimlane == null) {\n313:             actionNewSwimlane =\n314:                 new CmdCreateNode(Model.getMetaTypes().getPartition(),\n315:                         \t  \"Create a new swimlane\");\n316:         }\n317:         return actionNewSwimlane;\n318:     }\n319:     /**\n320:      * @return Returns the actionObjectFlowState.\n321:      */\n322:     protected Action getActionObjectFlowState() {\n323:         if (actionObjectFlowState == null) {\n324:             actionObjectFlowState =\n325:                 new RadioAction(\n326:                         new CmdCreateNode(\n327:                                 Model.getMetaTypes().getObjectFlowState(),\n328:                                 \"button.new-objectflowstate\"));\n329:         }\n330:         return actionObjectFlowState;\n331:     }\n332:     /**\n333:      * @return Returns the actionStartPseudoState.\n334:      */\n335:     protected Action getActionStartPseudoState() {\n336:         if (actionStartPseudoState == null) {\n337:             actionStartPseudoState =\n338:                 new RadioAction(\n339:                         new ActionCreatePseudostate(\n340:                                 Model.getPseudostateKind().getInitial(),\n341:                                 \"button.new-initial\"));\n342:         }\n343:         return actionStartPseudoState;\n344:     }\n345:     /**\n346:      * @return Returns the actionState.\n347:      */\n348:     protected Action getActionState() {\n349:         if (actionState == null) {\n350:             actionState =\n351:                 new RadioAction(\n352:                         new CmdCreateNode(\n353:                                 Model.getMetaTypes().getActionState(),\n354:                         \t\"button.new-actionstate\"));\n355:         }\n356:         return actionState;\n357:     }\n358:     /**\n359:      * @return Returns the actionSubactivityState.\n360:      */\n361:     protected Action getActionSubactivityState() {\n362:         if (actionSubactivityState == null) {\n363:             actionSubactivityState =\n364:                 new RadioAction(\n365:                         new CmdCreateNode(\n366:                                 Model.getMetaTypes().getSubactivityState(),\n367:                         \"button.new-subactivitystate\"));\n368:         }\n369:         return actionSubactivityState;\n370:     }\n371:     /**\n372:      * @return Returns the actionTransition.\n373:      */\n374:     protected Action getActionTransition() {\n375:         if (actionTransition == null) {\n376:             actionTransition =\n377:                 new RadioAction(\n378:                         new CmdSetMode(\n379:                                 ModeCreatePolyEdge.class,\n380:                                 \"edgeClass\",\n381:                                 Model.getMetaTypes().getTransition(),\n382:                         \"button.new-transition\"));\n383:         }\n384:         return actionTransition;\n385:     }\n386: \n387:     /**\n388:      * @see org.argouml.uml.diagram.ui.UMLDiagram#needsToBeRemoved()\n389:      */\n390:     public boolean needsToBeRemoved() {\n391:         Object context = Model.getFacade().getContext(getStateMachine());\n392:         if (context == null) {\n3