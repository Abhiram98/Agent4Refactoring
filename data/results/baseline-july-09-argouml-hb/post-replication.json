eAdapter;\n32: import org.argouml.uml.diagram.UmlDiagramRenderer;\n33: import org.argouml.uml.diagram.static_structure.ui.CommentEdge;\n34: import org.argouml.uml.diagram.static_structure.ui.FigComment;\n35: import org.argouml.uml.diagram.static_structure.ui.FigEdgeNote;\n36: import org.argouml.uml.diagram.static_structure.ui.FigPackage;\n37: import org.argouml.uml.diagram.ui.FigAssociation;\n38: import org.argouml.uml.diagram.ui.FigDependency;\n39: import org.argouml.uml.diagram.ui.FigEdgeModelElement;\n40: import org.argouml.uml.diagram.ui.FigGeneralization;\n41: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n42: import org.tigris.gef.base.Layer;\n43: import org.tigris.gef.graph.GraphModel;\n44: import org.tigris.gef.presentation.FigEdge;\n45: import org.tigris.gef.presentation.FigNode;\n46: \n47: // could be singleton\n48: \n49: /**\n50:  * This class defines a renderer object for UML Use Case Diagrams. In a\n51:  * Class Diagram the following UML objects are displayed with the\n52:  * following Figs:<p>\n53:  *\n54:  * <pre>\n55:  *   UML Object       ---  Fig\n56:  *   ---------------------------------------\n57:  *   MActor           ---  FigActor\n58:  *   MUseCase         ---  FigUseCase\n59:  * </pre>\n60:  *\n61:  * Provides {@link #getFigNodeFor} to implement the\n62:  * {@link org.tigris.gef.graph.GraphNodeRenderer} interface and\n63:  * {@link #getFigEdgeFor} to implement the\n64:  * {@link org.tigris.gef.graph.GraphEdgeRenderer} interface.<p>\n65:  *\n66:  * <em>Note</em>. Should be implemented as a singleton - we don't really\n67:  * need a separate instance for each use case diagram.<p>\n68:  *\n69:  * @author abonner\n70:  */\n71: public class UseCaseDiagramRenderer extends UmlDiagramRenderer {\n72:     /**\n73:      * Logger.\n74:      */\n75:     private static final Logger LOG =\n76:         Logger.getLogger(UseCaseDiagramRenderer.class);\n77: \n78: \n79:     /**\n80:      * Return a Fig that can be used to represent the given node.<p>\n81:      *\n82:      * @param gm    The graph model for which we are rendering.\n83:      *\n84:      * @param lay   The layer in the graph on which we want this figure.\n85:      *\n86:      * @param node  The node to be rendered (an NSUML object)\n87:      *\n88:      * @param styleAttributes an optional map of attributes to style the fig\n89:      *\n90:      * @return      The fig to be used, or <code>null</code> if we can't create\n91:      *              one.\n92:      */\n93:     public FigNode getFigNodeFor(GraphModel gm, Layer lay, Object node,\n94:             Map styleAttributes) {\n95: \n96:         FigNodeModelElement figNode = null;\n97:         \n98:         // Create a new version of the relevant fig\n99: \n100:         if (Model.getFacade().isAActor(node)) {\n101:             figNode = new FigActor(gm, node);\n102:         } else if (Model.getFacade().isAUseCase(node)) {\n103:             figNode = new FigUseCase(gm, node);\n104:         } else if (Model.getFacade().isAComment(node)) {\n105:             figNode = new FigComment(gm, node);\n106:         } else if (Model.getFacade().isAPackage(node)) {\n107:             figNode = new FigPackage(gm, node);\n108:         } else {\n109:             LOG.debug(this.getClass().toString()\n110:                   + \": getFigNodeFor(\" + gm.toString() + \", \"\n111:                   + lay.toString() + \", \" + node.toString()\n112:                   + \") - cannot create this sort of node.\");\n113:             return null;\n114:             // TODO: Shouldn't we throw an excdeption here?!?!\n115:         }\n116: \n117:         figNode.setDiElement(\n118:                 GraphChangeAdapter.getInstance().createElement(gm, node));\n119:         \n120:         return figNode;\n121:     }\n122: \n123: \n124:     /**\n125:      * Return a Fig that can be used to represent the given edge.<p>\n126:      *\n127:      * Generally the same code as for the ClassDiagram, since it's very\n128:      * related to it. Deal with each of the edge types in turn.<p>\n129:      *\n130:      * @param gm    The graph model for which we are rendering.\n131:      *\n132:      * @param lay   The layer in the graph on which we want this figure.\n133:      *\n134:      * @param edge  The edge to be rendered (an NSUML object)\n135:      *\n136:      * @param styleAttributes an optional map of attributes to style the fig\n137:      *\n138:      * @return      The fig to be used, or <code>null</code> if we can't create\n139:      *              one.\n140:      *\n141:      * @see org.tigris.gef.graph.GraphEdgeRenderer#getFigEdgeFor(\n142:      *         org.tigris.gef.graph.GraphModel, org.tigris.gef.base.Layer,\n143:      *         java.lang.Object, java.util.Map)\n144:      */\n145:     public FigEdge getFigEdgeFor(GraphModel gm, Layer lay, Object edge,\n146:             Map styleAttributes) {\n147: \n148:         if (LOG.isDebugEnabled()) {\n149:             LOG.debug(\"making figedge for \" + edge);\n150:         }\n151: \n152:         if (edge == null) {\n153:             throw new IllegalArgumentException(\"A model edge must be supplied\");\n154:         }\n155: \n156:         FigEdgeModelElement newEdge = null;\n157: \n158:         if (Model.getFacade().isAAssociation(edge)) {\n159:             // If the edge is an association, we'll need a FigAssociation\n160:             Object   asc         = /*(MAssociation)*/ edge;\n161:             FigAssociation ascFig      = new FigAssociation(asc, lay);\n162: \n163:             newEdge = ascFig;\n164:         } else if (Model.getFacade().isAGeneralization(edge)) {\n165:             // Generalization needs a FigGeneralization\n166:             Object   gen    = /*(MGeneralization)*/ edge;\n167:             FigGeneralization genFig = new FigGeneralization(gen, lay);\n168:             newEdge = genFig;\n169:         } else if (Model.getFacade().isAExtend(edge)) {\n170:             // Extend relationship\n171:             Object   ext    = /*(MExtend)*/ edge;\n172:             FigExtend extFig = new FigExtend(ext);\n173: \n174:             // The nodes at the two ends\n175: \n176:             Object base      = Model.getFacade().getBase(ext);\n177:             Object extension = Model.getFacade().getExtension(ext);\n178: \n179:             // The figs for the two end nodes\n180: \n181:             FigNode baseFN      = (FigNode) lay.presentationFor(base);\n182:             FigNode extensionFN = (FigNode) lay.presentationFor(extension);\n183: \n184:             // Link the new extend relationship in to the ends. Remember we\n185:             // draw from the extension use case to the base use case.\n186: \n187:             extFig.setSourcePortFig(extensionFN);\n188:             extFig.setSourceFigNode(extensionFN);\n189: \n190:             extFig.setDestPortFig(baseFN);\n191:             extFig.setDestFigNode(baseFN);\n192: \n193:             newEdge = extFig;\n194:         } else if (Model.getFacade().isAInclude(edge)) {\n195:             // Include relationship is very like extend. Watch out for the NSUML\n196:             // bug here.\n197:             Object   inc    = /*(MInclude)*/ edge;\n198:             FigInclude incFig = new FigInclude(inc);\n199: \n200:             Object base     = Model.getFacade().getBase(inc);\n201:             Object addition = Model.getFacade().getAddition(inc);\n202: \n203:             // The figs for the two end nodes\n204: \n205:             FigNode baseFN     = (FigNode) lay.presentationFor(base);\n206:             FigNode additionFN = (FigNode) lay.presentationFor(addition);\n207: \n208:             // Link the new include relationship in to the ends\n209: \n210:             incFig.setSourcePortFig(baseFN);\n211:             incFig.setSourceFigNode(baseFN);\n212: \n213:             incFig.setDestPortFig(additionFN);\n214:             incFig.setDestFigNode(additionFN);\n215: \n216:             newEdge = incFig;\n217:         } else if (Model.getFacade().isADependency(edge)) {\n218:             // Dependency needs a FigDependency\n219:             Object   dep    = /*(MDependency)*/ edge;\n220:             FigDependency depFig = new FigDependency(dep);\n221: \n222:             // Where there is more than one supplier or client, take the first\n223:             // element in each case. There really ought to be a check that\n224:             // there are some here for safety.\n225: \n226:             Object supplier =\n227:                  ((Model.getFacade().getSuppliers(dep).toArray())[0]);\n228:             Object client =\n229:                  ((Model.getFacade().getClients(dep).toArray())[0]);\n230: \n231:             // The figs for the two end nodes\n232: \n233:             FigNode supplierFN = (FigNode) lay.presentationFor(supplier);\n234:             FigNode clientFN   = (FigNode) lay.presentationFor(client);\n235: \n236:             // Link the new dependency in to the ends\n237: \n238:             depFig.setSourcePortFig(clientFN);\n239:             depFig.setSourceFigNode(clientFN);\n240: \n241:             depFig.setDestPortFig(supplierFN);\n242:             depFig.setDestFigNode(supplierFN);\n243: \n244:             newEdge = depFig;\n245:         } else if (edge instanceof CommentEdge) {\n246:             newEdge = new FigEdgeNote(edge, lay);\n247:         }\n248: \n249:         if (newEdge == null) {\n250:             throw new IllegalArgumentException(\n251:                     \"Don't know how to create FigEdge for model type \"\n252:                     + edge.getClass().getName());\n253:         } else {\n254:             if (newEdge.getSourcePortFig() == null) {\n255:                 Object source;\n256:                 if (edge instanceof CommentEdge) {\n257:                     source = ((CommentEdge) edge).getSource();\n258:                 } else {\n259:                     source = Model.getUmlHelper().getSource(edge);\n260:                 }\n261:                 setSourcePort(newEdge, (FigNode) lay.presentationFor(source));\n262:             }\n263:             if (newEdge.getDestPortFig() == null) {\n264:                 Object dest;\n265:                 if (edge instanceof CommentEdge) {\n266:                     dest = ((CommentEdge) edge).getDestination();\n267:                 } else {\n268:                     dest = Model.getUmlHelper().getDestination(edge);\n269:                 }\n270:                 setDestPort(newEdge, (FigNode) lay.presentationFor(dest));\n271:             }\n272:             if (newEdge.getSourcePortFig() == null\n273:                     || newEdge.getDestPortFig() == null) {\n274:                 throw new IllegalStateException(\"Edge of type \"\n275:                     + newEdge.getClass().getName()\n276:                     + \" created with no source or destination port\");\n277:             }\n278:         }\n279:         \n280:         newEdge.setDiElement(\n281:                 GraphChangeAdapter.getInstance().createElement(gm, edge));\n282:         \n283:         return newEdge;\n284:     }\n285: \n286:     private void setSourcePort(FigEdge edge, FigNode source) {\n287:         edge.setSourcePortFig(source);\n288:         edge.setSourceFigNode(source);\n289:     }\n290: \n291:     private void setDestPort(FigEdge edge, FigNode dest) {\n292:         edge.setDestPortFig(dest);\n293:         edge.setDestFigNode(dest);\n294:     }\n295: \n296:     static final long serialVersionUID = 2217410137377934879L;\n297: \n298: } /* end class UseCaseDiagramRenderer */\n299: ",
