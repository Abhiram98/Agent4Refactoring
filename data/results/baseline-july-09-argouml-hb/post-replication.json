///////////////////\n82:     // constructors\n83: \n84:     /**\n85:      * Constructor for a {@link FigClass} during file load.<p>\n86:      *\n87:      * Parent {@link org.argouml.uml.diagram.ui.FigNodeModelElement}\n88:      * will have created the main box {@link #getBigPort()} and its\n89:      * name {@link #getNameFig()} and stereotype\n90:      * (@link #getStereotypeFig()}. This constructor\n91:      * creates a box for the attributes and operations.<p>\n92:      *\n93:      * The properties of all these graphic elements are adjusted\n94:      * appropriately. The main boxes are all filled and have\n95:      * outlines.<p>\n96:      *\n97:      * <em>Warning</em>. Much of the graphics positioning is hard\n98:      * coded. The overall figure is placed at location (10,10). The\n99:      * name compartment (in the parent\n100:      * {@link org.argouml.uml.diagram.ui.FigNodeModelElement} is\n101:      * 21 pixels high. The stereotype compartment is created 15 pixels\n102:      * high in the parent, but we change it to 19 pixels, 1 more than\n103:      * ({@link #STEREOHEIGHT} here. The attribute and operations boxes\n104:      * are created at 19 pixels, 2 more than {@link #ROWHEIGHT}.<p>\n105:      */\n106:     public FigClass(Object modelElement, int x, int y, int w, int h) {\n107:         this(null, modelElement);\n108:         setBounds(x, y, w, h);\n109:     }\n110: \n111:     /**\n112:      * Constructor for a {@link FigClass} by diagram interaction.<p>\n113:      *\n114:      * Parent {@link org.argouml.uml.diagram.ui.FigNodeModelElement}\n115:      * will have created the main box {@link #getBigPort()} and its\n116:      * name {@link #getNameFig()} and stereotype\n117:      * (@link #getStereotypeFig()}. This constructor\n118:      * creates a box for the attributes and operations.<p>\n119:      *\n120:      * The properties of all these graphic elements are adjusted\n121:      * appropriately. The main boxes are all filled and have\n122:      * outlines.<p>\n123:      *\n124:      * <em>Warning</em>. Much of the graphics positioning is hard\n125:      * coded. The overall figure is placed at location (10,10). The\n126:      * name compartment (in the parent\n127:      * {@link org.argouml.uml.diagram.ui.FigNodeModelElement} is\n128:      * 21 pixels high. The stereotype compartment is created 15 pixels\n129:      * high in the parent, but we change it to 19 pixels, 1 more than\n130:      * ({@link #STEREOHEIGHT} here. The attribute and operations boxes\n131:      * are created at 19 pixels, 2 more than {@link #ROWHEIGHT}.<p>\n132:      *\n133:      * @param gm   Not actually used in the current implementation\n134:      *\n135:      * @param node The UML object being placed.\n136:      */\n137:     public FigClass(GraphModel gm, Object node) {\n138:         super();\n139:         attributesFigCompartment =\n140:             new FigAttributesCompartment(10, 30, 60, ROWHEIGHT + 2);\n141:         addFig(getBigPort());\n142:         addFig(getStereotypeFig());\n143:         addFig(getNameFig());\n144:         addFig(operationsFig);\n145:         addFig(attributesFigCompartment);\n146:         addFig(borderFig);\n147:         setOwner(node);\n148:     }\n149: \n150:     /*\n151:      * @see java.lang.Object#clone()\n152:      */\n153:     public Object clone() {\n154:         FigClass figClone = (FigClass) super.clone();\n155:         Iterator thisIter = this.getFigs().iterator();\n156:         Iterator cloneIter = figClone.getFigs().iterator();\n157:         while (thisIter.hasNext()) {\n158:             Fig thisFig = (Fig) thisIter.next();\n159:             Fig cloneFig = (Fig) cloneIter.next();\n160:             if (thisFig == borderFig) {\n161:                 figClone.borderFig = thisFig;\n162:             }\n163:         }\n164:         return figClone;\n165:     }\n166: \n167: \n168:     ////////////////////////////////////////////////////////////////\n169:     // accessors\n170: \n171:     /*\n172:      * @see org.tigris.gef.presentation.Fig#makeSelection()\n173:      */\n174:     public Selection makeSelection() {\n175:         return new SelectionClass(this);\n176:     }\n177: \n178:     /**\n179:      * Build a collection of menu items relevant for a right-click\n180:      * popup menu on a Class.\n181:      *\n182:      * @param     me     a mouse event\n183:      * @return           a collection of menu items\n184:      *\n185:      * @see org.tigris.gef.ui.PopupGenerator#getPopUpActions(java.awt.event.MouseEvent)\n186:      */\n187:     public Vector getPopUpActions(MouseEvent me) {\n188:         Vector popUpActions = super.getPopUpActions(me);\n189: \n190:         // Add...\n191:         ArgoJMenu addMenu = new ArgoJMenu(\"menu.popup.add\");\n192:         addMenu.add(TargetManager.getInstance().getAddAttributeAction());\n193:         addMenu.add(TargetManager.getInstance().getAddOperationAction());\n194:         addMenu.add(new ActionAddNote());\n195:         addMenu.add(ActionEdgesDisplay.getShowEdges());\n196:         addMenu.add(ActionEdgesDisplay.getHideEdges());\n197:         popUpActions.insertElementAt(addMenu,\n198:             popUpActions.size() - getPopupAddOffset());\n199: \n200:         // Show ...\n201:         ArgoJMenu showMenu = new ArgoJMenu(\"menu.popup.show\");\n202:         Iterator i = ActionCompartmentDisplay.getActions().iterator();\n203:         while (i.hasNext()) {\n204:             showMenu.add((Action) i.next());\n205:         }\n206:         popUpActions.insertElementAt(showMenu,\n207:             popUpActions.size() - getPopupAddOffset());\n208: \n209:         // Modifiers ...\n210:         popUpActions.insertElementAt(\n211:                 buildModifierPopUp(ABSTRACT | LEAF | ROOT | ACTIVE),\n212:                 popUpActions.size() - getPopupAddOffset());\n213: \n214:         // Visibility ...\n215:         popUpActions.insertElementAt(buildVisibilityPopUp(),\n216:                 popUpActions.size() - getPopupAddOffset());\n217: \n218:         return popUpActions;\n219:     }\n220: \n221:     /**\n222:      * @return The bounds of the attributes compartment.\n223:      */\n224:     public Rectangle getAttributesBounds() {\n225:         return attributesFigCompartment.getBounds();\n226:     }\n227: \n228:     /**\n229:      * @return The vector of graphics for operations (if any).\n230:      * First one is the rectangle for the entire operations box.\n231:      */\n232:     private FigAttributesCompartment getAttributesFig() {\n233:         return attributesFigCompartment;\n234:     }\n235: \n236:     /**\n237:      * Returns the status of the attribute field.\n238:      * @return true if the attributes are visible, false otherwise\n239:      *\n240:      * @see org.argouml.uml.diagram.ui.AttributesCompartmentContainer#isAttributesVisible()\n241:      */\n242:     public boolean isAttributesVisible() {\n243:         return getAttributesFig().isVisible();\n244:     }\n245: \n246:     /**\n247:      * @param isVisible true if the attribute compartment is visible\n248:      *\n249:      * @see org.argouml.uml.diagram.ui.AttributesCompartmentContainer#setAttributesVisible(boolean)\n250:      */\n251:     public void setAttributesVisible(boolean isVisible) {\n252:         Rectangle rect = getBounds();\n253:         if (getAttributesFig().isVisible()) {\n254:             if (!isVisible) {  // hide compartment\n255:                 damage();\n256:                 Iterator it = getAttributesFig().getFigs().iterator();\n257:                 while (it.hasNext()) {\n258:                     ((Fig) (it.next())).setVisible(false);\n259:                 }\n260:                 getAttributesFig().setVisible(false);\n261:                 Dimension aSize = this.getMinimumSize();\n262:                 setBounds(rect.x, rect.y,\n263: \t\t\t  (int) aSize.getWidth(), (int) aSize.getHeight());\n264:             }\n265:         } else {\n266:             if (isVisible) { // show compartement\n267:                 Iterator it = getAttributesFig().getFigs().iterator();\n268:                 while (it.hasNext()) {\n269:                     ((Fig) (it.next())).setVisible(true);\n270:                 }\n271:                 getAttributesFig().setVisible(true);\n272:                 Dimension aSize = this.getMinimumSize();\n273:                 setBounds(rect.x, rect.y,\n274: \t\t\t  (int) aSize.getWidth(), (int) aSize.getHeight());\n275:                 damage();\n276:             }\n277:         }\n278:     }\n279: \n280:     /**\n281:      * @param isVisible true if the operation compartment is visible\n282:      *\n283:      * @see org.argouml.uml.diagram.ui.OperationsCompartmentContainer#setOperationsVisible(boolean)\n284:      */\n285:     public void setOperationsVisible(boolean isVisible) {\n286:         Rectangle rect = getBounds();\n287:         if (isOperationsVisible()) { // if displayed\n288:             if (!isVisible) {\n289:                 damage();\n290:                 Iterator it = getOperationsFig().getFigs().iterator();\n291:                 while (it.hasNext()) {\n292:                     ((Fig) (it.next())).setVisible(false);\n293:                 }\n294:                 getOperationsFig().setVisible(false);\n295:                 Dimension aSize = this.getMinimumSize();\n296:                 setBounds(rect.x, rect.y,\n297: \t\t\t  (int) aSize.getWidth(), (int) aSize.getHeight());\n298:             }\n299:         } else {\n300:             if (isVisible) {\n301:                 Iterator it = getOperationsFig().getFigs().iterator();\n302:                 while (it.hasNext()) {\n303:                     ((Fig) (it.next())).setVisible(true);\n304:                 }\n305:                 getOperationsFig().setVisible(true);\n306:                 Dimension aSize = this.getMinimumSize();\n307:                 setBounds(rect.x, rect.y,\n308:                     (int) aSize.getWidth(), (int) aSize.getHeight());\n309:                 damage();\n310:             }\n311:         }\n312:     }\n313: \n314:     /*\n315:      * @see org.tigris.gef.presentation.Fig#setLineWidth(int)\n316:      */\n317:     public void setLineWidth(int w) {\n318:         borderFig.setLineWidth(w);\n319:     }\n320: \n321:     /*\n322:      * @see org.tigris.gef.presentation.Fig#getLineWidth()\n323:      */\n324:     public int getLineWidth() {\n325:         return borderFig.getLineWidth();\n326:     }\n327: \n328:     /**\n329:      * USED BY PGML.tee.\n330:      * @return the class name and bounds together with compartment\n331:      * visibility.\n332:      */\n333:     public String classNameAndBounds() {\n334:         return super.classNameAndBounds()\n335:             + \"operationsVisible=\" + isOperationsVisible() + \";\"\n336:             + \"attributesVisible=\" + isAttributesVisible();\n337:     }\n338: \n339:     /**\n340:      * Gets the minimum size permitted for a class on the diagram.<p>\n341:      *\n342:      * Parts of this are hardcoded, notably the fact that the name\n343:      * compartment has a minimum height of 21 pixels.<p>\n344:      *\n345:      * @return  the size of the minimum bounding box.\n346:      */\n347:     public Dimension getMinimumSize() {\n348:         // Use \"aSize\" to build up the minimum size. Start with the size of the\n349:         // name compartment and build up.\n350: \n351:         Dimension aSize = getNameFig().getMinimumSize();\n352: \n353:         // If we have a stereotype displayed, then allow some space for that\n354:         // (width and height)\n355: \n356:         if (getStereotypeFig().isVisible()) {\n357:             Dimension stereoMin = getStereotypeFig().getMinimumSize();\n358:             aSize.width = Math.max(aSize.width, stereoMin.width);\n359:             aSize.height += stereoMin.height;\n360:         }\n361: \n362:         // Allow space for each of the attributes we have\n363: \n364:         if (getAttributesFig().isVisible()) {\n365:             Dimension attrMin = getAttributesFig().getMinimumSize();\n366:             aSize.width = Math.max(aSize.width, attrMin.width);\n367:             aSize.height += attrMin.height;\n368:         }\n369: \n370:         // Allow space for each of the operations we have\n371: \n372:         if (isOperationsVisible()) {\n373:             Dimension operMin = getOperationsFig().getMinimumSize();\n374:             aSize.width = Math.max(aSize.width, operMin.width);\n375:             aSize.height += operMin.height;\n376:         }\n377: \n378:         // we want to maintain a minimum width for the class\n379:         aSize.width = Math.max(60, aSize.width);\n380: \n381:         // And now aSize has the answer\n382: \n383:         return aSize;\n384:     }\n385: \n386:     /*\n387:      * @see org.tigris.gef.presentation.Fig#translate(int, int)\n388:      */\n389:     public void translate(int dx, int dy) {\n390:         super.translate(dx, dy);\n391:         Editor ce = Globals.curEditor();\n392:         Selection sel = ce.getSelectionManager().findSelectionFor(this);\n393:         if (sel instanceof SelectionClass) {\n394:             ((SelectionClass) sel).hideButtons();\n395:         }\n396:     }\n397: \n398:     ////////////////////////////////////////////////////////////////\n399:     // internal methods\n400: \n401:     /*\n402:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEdited(org.tigris.gef.presentation.FigText)\n403:      */\n404:     protected void textEdited(FigText ft) throws PropertyVetoException {\n405:         super.textEdited(ft);\n406:         Object classifier = getOwner();\n407:         if (classifier == null) {\n408:             return;\n409:         }\n410:         int i = new Vector(getAttributesFig().getFigs()).indexOf(ft);\n411:         if (i != -1) {\n412:             highlightedFigText = (CompartmentFigText) ft;\n413:             highlightedFigText.setHighlighted(true);\n414: \n415:             highlightedFigText.getNotationProvider()\n416:                 .parse(highlightedFigText.getOwner(), ft.getText());\n417:             ft.setText(highlightedFigText.getNotationProvider().toString(\n418:                     highlightedFigText.getOwner(), null));\n419:             return;\n420:         }\n421:         i = new Vector(getOperationsFig().getFigs()).indexOf(ft);\n422:         if (i != -1) {\n423:             highlightedFigText = (CompartmentFigText) ft;\n424:             highlightedFigText.setHighlighted(true);\n425: \n426:             highlightedFigText.getNotationProvider()\n427:                 .parse(highlightedFigText.getOwner(), ft.getText());\n428:             ft.setText(highlightedFigText.getNotationProvider().toString(\n429:                 highlightedFigText.getOwner(), null));\n430:             return;\n431:         }\n432:     }\n433: \n434:     /*\n435:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEditStarted(org.tigris.gef.presentation.FigText)\n436:      */\n437:     protected void textEditStarted(FigText ft) {\n438:         super.textEditStarted(ft);\n439:         if (getAttributesFig().getFigs().contains(ft)) {\n440:             showHelp(((CompartmentFigText) ft)\n441:                     .getNotationProvider().getParsingHelp());\n442:         }\n443:         if (getOperationsFig().getFigs().contains(ft)) {\n444:             showHelp(((CompartmentFigText) ft)\n445:                     .getNotationProvider().getParsingHelp());\n446:         }\n447:     }\n448: \n449:     /**\n450:      * @param fgVec the FigGroup\n451:      * @param ft    the Figtext\n452:      * @param i     get the fig before fig i\n453:      * @return the FigText\n454:      */\n455:     protected FigText getPreviousVisibleFeature(FigGroup fgVec,\n456: \t\t\t\t\t\tFigText ft, int i) {\n457:         if (fgVec == null || i < 1) {\n458:             return null;\n459:         }\n460:         FigText ft2 = null;\n461:         // TODO: come GEF V 0.12 use getFigs returning an array\n462:         Vector v = new Vector(fgVec.getFigs());\n463:         if (i >= v.size() || !((FigText) v.elementAt(i)).isVisible()) {\n464:             return null;\n465:         }\n466:         do {\n467:             i--;\n468:             while (i < 1) {\n469:                 if (fgVec == getAttributesFig()) {\n470:                     fgVec = getOperationsFig();\n471:                 } else {\n472:                     fgVec = getAttributesFig();\n473:                 }\n474:                 v = new Vector(fgVec.getFigs());\n475:                 i = v.size() - 1;\n476:             }\n477:             ft2 = (FigText) v.elementAt(i);\n478:             if (!ft2.isVisible()) {\n479:                 ft2 = null;\n480:             }\n481:         } while (ft2 == null);\n482:         return ft2;\n483:     }\n484: \n485:     /**\n486:      * @param fgVec the FigGroup\n487:      * @param ft    the Figtext\n488:      * @param i     get the fig after fig i\n489:      * @return the FigText\n490:      */\n491:     protected FigText getNextVisibleFeature(FigGroup fgVec, FigText ft, int i) {\n492:         if (fgVec == null || i < 1) {\n493:             return null;\n494:         }\n495:         FigText ft2 = null;\n496:         // TODO: come GEF V 0.12 use getFigs returning an array\n497:         Vector v = new Vector(fgVec.getFigs());\n498:         if (i >= v.size() || !((FigText) v.elementAt(i)).isVisible()) {\n499:             return null;\n500:         }\n501:         do {\n502:             i++;\n503:             while (i >= v.size()) {\n504:                 if (fgVec == getAttributesFig()) {\n505:                     fgVec = getOperationsFig();\n506:                 } else {\n507:                     fgVec = getAttributesFig();\n508:                 }\n509:                 v = new Vector(fgVec.getFigs());\n510:                 i = 1;\n511:             }\n512:             ft2 = (FigText) v.elementAt(i);\n513:             if (!ft2.isVisible()) {\n514:                 ft2 = null;\n515:             }\n516:         } while (ft2 == null);\n517:         return ft2;\n518:     }\n519: \n520:     /*\n521:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#renderingChanged()\n522:      */\n523:     public void renderingChanged() {\n524:         if (getOwner() != null) {\n525:             updateAttributes();\n526:             updateOperations();\n527:             updateAbstract();\n528:         }\n529:         super.renderingChanged();\n530:     }\n531:     \n532:     /**\n533:      * Handles changes to the model. Takes into account the event that\n534:      * occurred. If you need to update the whole fig, consider using\n535:      * renderingChanged.\n536:      *\n537:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#modelChanged(java.beans.PropertyChangeEvent)\n538:      */\n539:     protected void modelChanged(PropertyChangeEvent mee) {\n540:         // Let our superclass sort itself out first\n541:         super.modelChanged(mee);\n542:         if (mee instanceof AssociationChangeEvent \n543:                 || mee instanceof AttributeChangeEvent) {\n544:             renderingChanged();\n545:             updateListeners(getOwner(), getOwner());\n546:         }\n547:     }\n548: \n549:     /*\n550:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateStereotypeText()\n551:      * TODO: Refactor into FigClassifierBox\n552:      */\n553:     protected void updateStereotypeText() {\n554: \n555:         Rectangle rect = getBounds();\n556: \n557:         int stereotypeHeight = 0;\n558:         if (getStereotypeFig().isVisible()) {\n559:             stereotypeHeight = getStereotypeFig().getHeight();\n560:         }\n561:         int heightWithoutStereo = getHeight() - stereotypeHeight;\n562: \n563:         getStereotypeFig().setOwner(getOwner());\n564:         ((FigStereotypesCompartment) getStereotypeFig()).populate();\n565: \n566:         stereotypeHeight = 0;\n567:         if (getStereotypeFig().isVisible()) {\n568:             stereotypeHeight = getStereotypeFig().getHeight();\n569:         }\n570: \n571:         int minWidth = this.getMinimumSize().width;\n572:         if (minWidth > rect.width) {\n573:             rect.width = minWidth;\n574:         }\n575: \n576:         setBounds(\n577:                 rect.x,\n578:                 rect.y,\n579:                 rect.width,\n580:                 heightWithoutStereo + stereotypeHeight);\n581:         calcBounds();\n582:     }\n583: \n584:     /*\n585:      * @see org.tigris.gef.presentation.Fig#setEnclosingFig(org.tigris.gef.presentation.Fig)\n586:      */\n587:     public void setEnclosingFig(Fig encloser) {\n588:         if (encloser == getEncloser()) {\n589:             return;\n590:         }\n591:         if (encloser == null\n592:                 || (encloser != null\n593:                 && !Model.getFacade().isAInstance(encloser.getOwner()))) {\n594:             super.setEnclosingFig(encloser);\n595:         }\n596:         if (!(Model.getFacade().isAModelElement(getOwner()))) {\n597:             return;\n598:         }\n599:         if (encloser != null\n600:                 && (Model.getFacade().isAComponent(encloser.getOwner()))) {\n601:             Object component = encloser.getOwner();\n602:             Object anInterface = getOwner();\n603:             Model.getCoreHelper().setContainer(resident, component);\n604:             Model.getCoreHelper().setResident(resident, anInterface);\n605:         } else {\n606:             Model.getCoreHelper().setContainer(resident, null);\n607:             Model.getCoreHelper().setResident(resident, null);\n608:         }\n609: \n610:     }\n611: \n612:     /**\n613:      * Sets the bounds, but the size will be at least the one returned by\n614:      * {@link #getMinimumSize()}, unless checking of size is disabled.<p>\n615:      *\n616:      * If the required height is bigger, then the additional height is\n617:      * equally distributed among all figs (i.e. compartments), such that the\n618:      * cumulated height of all visible figs equals the demanded height<p>.\n619:      *\n620:      * Some of this has \"magic numbers\" hardcoded in. In particular there is\n621:      * a knowledge that the minimum height of a name compartment is 21\n622:      * pixels.<p>\n623:      *\n624:      * @param x  Desired X coordinate of upper left corner\n625:      *\n626:      * @param y  Desired Y coordinate of upper left corner\n627:      *\n628:      * @param w  Desired width of the FigClass\n629:      *\n630:      * @param h  Desired height of the FigClass\n631:      * \n632:      * @see org.tigris.gef.presentation.Fig#setBoundsImpl(int, int, int, int)\n633:      */\n634:     protected void setBoundsImpl(final int x, final int y,\n635:             final int w, final int h) {\n636:         Rectangle oldBounds = getBounds();\n637: \n638:         // set bounds of big box\n639:         getBigPort().setBounds(x, y, w, h);\n640:         borderFig.setBounds(x, y, w, h);\n641: \n642:         // Save our old boundaries (needed later), and get minimum size\n643:         // info. \"whitespace\" will be used to maintain a running calculation\n644:         // of our size at various points.\n645: \n646:         final int whitespace = h - getMinimumSize().height;\n647: \n648:         getNameFig().setLineWidth(0);\n649:         getNameFig().setLineColor(Color.red);\n650:         int currentHeight = 0;\n651: \n652:         if (getStereotypeFig().isVisible()) {\n653:             int stereotypeHeight = getStereotypeFig().getMinimumSize().height;\n654:             getStereotypeFig().setBounds(\n655:                     x,\n656:                     y,\n657:                     w,\n658:                     stereotypeHeight);\n659:             currentHeight = stereotypeHeight;\n660:         }\n661: \n662:         int nameHeight = getNameFig().getMinimumSize().height;\n663:         getNameFig().setBounds(x, y + currentHeight, w, nameHeight);\n664:         currentHeight += nameHeight;\n665: \n666:         if (isAttributesVisible()) {\n667:             int attributesHeight = getAttributesFig().getMinimumSize().height;\n668:             if (isOperationsVisible()) {\n669:                 attributesHeight += whitespace / 2;\n670:             }\n671:             getAttributesFig().setBounds(\n672:                     x,\n673:                     y + currentHeight,\n674:                     w,\n675:                     attributesHeight);\n676:             currentHeight += attributesHeight;\n677:         }\n678: \n679:         if (isOperationsVisible()) {\n680:             int operationsY = y + currentHeight;\n681:             int operationsHeight = (h + y) - operationsY - 1;\n682:             if (operationsHeight < getOperationsFig().getMinimumSize().height) {\n683:                 operationsHeight = getOperationsFig().getMinimumSize().height;\n684:             }\n685:             getOperationsFig().setBounds(\n686:                     x,\n687:                     operationsY,\n688:                     w,\n689:                     operationsHeight);\n690:         }\n691: \n692:         // Now force calculation of the bounds of the figure, update the edges\n693:         // and trigger anyone who's listening to see if the \"bounds\" property\n694:         // has changed.\n695: \n696:         calcBounds();\n697:         updateEdges();\n698:         firePropChange(\"bounds\", oldBounds, getBounds());\n699:     }\n700: \n701:     /**\n702:      * Updates the attributes in the fig. Called from modelchanged if there is\n703:      * a modelevent effecting the attributes and from renderingChanged in all\n704:      * cases.\n705:      */\n706:     protected void updateAttributes() {\n707:         if (!isAttributesVisible()) {\n708:             return;\n709:         }\n710:         attributesFigCompartment.populate();\n711: \n712:         Rectangle rect = getBounds();\n713:         // ouch ugly but that's for a next refactoring\n714:         // TODO: make setBounds, calcBounds and updateBounds consistent\n715:         setBounds(rect.x, rect.y, rect.width, rect.height);\n716:     }\n717: \n718:     /**\n719:      * Updates the operations box. Called from modelchanged if there is\n720:      * a modelevent effecting the attributes and from renderingChanged in all\n721:      * cases.\n722:      */\n723:     protected void updateOperations() {\n724:         if (!isOperationsVisible()) {\n725:             return;\n726:         }\n727:         operationsFig.populate();\n728: \n729:         Rectangle rect = getBounds();\n730:         // ouch ugly but that's for a next refactoring\n731:         // TODO: make setBounds, calcBounds and updateBounds consistent\n732:         setBounds(rect.x, rect.y, rect.width, rect.height);\n733:     }\n734: \n735: \n736: \n737:     /*\n738:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateNameText()\n739:      */\n740:     protected void updateNameText() {\n741:         super.updateNameText();\n742:         calcBounds();\n743:         setBounds(getBounds());\n744:     }\n745: \n746:     /**\n747:      * Updates the name if modelchanged receives an \"isAbstract\" event.\n748:      * TODO: Move up to ClassifierBox (should be GeneralizableElement)\n749:      */\n750:     protected void updateAbstract() {\n751:         Rectangle rect = getBounds();\n752:         if (getOwner() == null) {\n753:             return;\n754:         }\n755:         Object cls = getOwner();\n756:         if (Model.getFacade().isAbstract(cls)) {\n757:             getNameFig().setFont(getItalicLabelFont());\n758: \t} else {\n759:             getNameFig().setFont(getLabelFont());\n760: \t}\n761:         super.updateNameText();\n762:         setBounds(rect.x, rect.y, rect.width, rect.height);\n763:     }\n764: \n765:     /*\n766:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateListeners(java.lang.Object, java.lang.Object)\n767:      */\n768:     protected void updateListeners(Object oldOwner, Object newOwner) {\n769:         if (oldOwner != null) {\n770:             removeAllElementListeners();\n771:         }\n772:         if (newOwner != null) {\n773:             // add the listeners to the newOwner\n774:             addElementListener(newOwner);\n775:             // and its stereotypes\n776:             Collection c = new ArrayList(\n777:                     Model.getFacade().getStereotypes(newOwner));\n778:             // and its features\n779:             Iterator it = Model.getFacade().getFeatures(newOwner).iterator();\n780:             while (it.hasNext()) {\n781:                 Object feat = it.next();\n782:                 c.add(feat);\n783:                 // and the stereotypes of its features\n784:                 c.addAll(new ArrayList(Model.getFacade().getStereotypes(feat)));\n785:                 // and the parameter of its operations\n786:                 if (Model.getFacade().isAOperation(feat)) {\n787:                     c.addAll(Model.getFacade().getParameters(feat));\n788:                 }\n789:             }\n790:             Iterator it2 = c.iterator();\n791:             while (it2.hasNext()) {\n792:                 addElementListener(it2.next());\n793:             }\n794:             if (isPathVisible()) {\n795:                 c = Model.getModelManagementHelper()\n796:                     .getAllSurroundingNamespaces(newOwner);\n797:                 Iterator itpv = c.iterator();\n798:                 while (itpv.hasNext()) {\n799:                     addElementListener(itpv.next(), \n800:                             new String[] {\"name\", \"namespace\", \"ownedElement\"});\n801:                 }\n802:             }\n803:         }\n804:     }\n805: \n806:     /**\n807:      * The UID.\n808:      */\n809:     private static final long serialVersionUID = 3415118710864626882L;\n810: \n811: } /* end class FigClass */\n812: ",
