 Font.ITALIC, LABEL_FONT.getSize());\n188: \n189:         // Setup image ops used in rendering shadows\n190:         byte[][] data = new byte[4][256];\n191:         for (int i = 1; i < 256; ++i) {\n192:             data[0][i] = (byte) SHADOW_COLOR_VALUE;\n193:             data[1][i] = (byte) SHADOW_COLOR_VALUE;\n194:             data[2][i] = (byte) SHADOW_COLOR_VALUE;\n195:             data[3][i] = (byte) SHADOW_COLOR_ALPHA;\n196:         }\n197:         float[] blur = new float[9];\n198:         for (int i = 0; i < blur.length; ++i) {\n199:             blur[i] = 1 / 12f;\n200:         }\n201:         SHADOW_LOOKUP_OP = new LookupOp(new ByteLookupTable(0, data), null);\n202:         SHADOW_CONVOLVE_OP = new ConvolveOp(new Kernel(3, 3, blur));\n203:     }\n204: \n205:     /**\n206:      * Used for #buildModifierPopUp().\n207:      */\n208:     protected static final int ROOT = 1;\n209: \n210:     /**\n211:      * Used for #buildModifierPopUp().\n212:      */\n213:     protected static final int ABSTRACT = 2;\n214: \n215:     /**\n216:      * Used for #buildModifierPopUp().\n217:      */\n218:     protected static final int LEAF = 4;\n219: \n220:     /**\n221:      * Used for #buildModifierPopUp().\n222:      */\n223:     protected static final int ACTIVE = 8;\n224: \n225:     ////////////////////////////////////////////////////////////////\n226:     // instance variables\n227: \n228:     private Fig bigPort;\n229: \n230:     /**\n231:      * use getNameFig() and setNameFig() to access the Figs.\n232:      * Use getName() and setName() to just change the text.\n233:      */\n234:     private FigText nameFig;\n235: \n236:     /**\n237:      * use getter/setter\n238:      * getStereotypeFig() and setStereoTypeFig() to access the Figs.\n239:      * Use getStereotype() and setStereotype() to change stereotype\n240:      * text.\n241:      */\n242:     private Fig stereotypeFig;\n243: \n244:     /**\n245:      * EnclosedFigs are the Figs that are enclosed by this figure. Say that\n246:      * it is a Package then these are the Classes, Interfaces, Packages etc\n247:      * that are on this figure. This is not the same as the figures in the\n248:      * FigGroup that this FigNodeModelElement \"is\", since these are the\n249:      * figures that make up this high-level primitive figure.\n250:      */\n251:     private Vector enclosedFigs = new Vector();\n252: \n253:     /**\n254:      * The figure enclosing this figure.\n255:      */\n256:     private Fig encloser;\n257: \n258:     private boolean readyToEdit = true;\n259:     private boolean suppressCalcBounds;\n260: \n261:     private int shadowSize;\n262: \n263:     private ItemUID itemUid;\n264: \n265:     /**\n266:      * Set the removeFromDiagram to false if this node may not\n267:      * be removed from the diagram.\n268:      */\n269:     private boolean removeFromDiagram = true;\n270: \n271:     /**\n272:      * Set this to force a repaint of the shadow.\n273:      * Normally repainting only happens\n274:      * when the outside boundaries change\n275:      * (for performance reasons (?)).\n276:      * In some cases this does not\n277:      * suffice, and you can set this attribute to force the update.\n278:      */\n279:     private boolean forceRepaint;\n280: \n281:     /**\n282:      * Flag that indicates if the full namespace path should be shown\n283:      * in front of the name.\n284:      */\n285:     private boolean pathVisible;\n286: \n287:     /**\n288:      * If the contains text to be edited by the user.\n289:      */\n290:     private boolean editable = true;\n291: \n292:     private Collection listeners = new ArrayList();\n293:     /**\n294:      * The main constructor.\n295:      *\n296:      */\n297:     public FigNodeModelElement() {\n298:         // this rectangle marks the whole modelelement figure; everything\n299:         // is inside it:\n300:         bigPort = new FigRect(10, 10, 0, 0, Color.cyan, Color.cyan);\n301: \n302:         nameFig = new FigSingleLineText(10, 10, 90, 21, true);\n303:         nameFig.setLineWidth(1);\n304:         nameFig.setFilled(true);\n305:         nameFig.setText(placeString());\n306:         nameFig.setBotMargin(7); // make space for the clarifier\n307:         nameFig.setRightMargin(4); // margin between text and border\n308:         nameFig.setLeftMargin(4); \n309: \n310:         stereotypeFig = new FigStereotypesCompartment(10, 10, 90, 15);\n311: \n312:         readyToEdit = false;\n313:         ArgoEventPump.addListener(ArgoEventTypes.ANY_NOTATION_EVENT, this);\n314:         \n315:         Project p = ProjectManager.getManager().getCurrentProject();\n316:         ProjectSettings ps = p.getProjectSettings();\n317: \n318:         shadowSize = ps.getDefaultShadowWidthValue();\n319:         /* TODO: how to handle changes in shadowsize \n320:          * from the project properties? */\n321:     }\n322: \n323:     /**\n324:      * Partially construct a new FigNode.  This method creates the\n325:      * name element that holds the name of the model element and adds\n326:      * itself as a listener.\n327:      *\n328:      * @param gm ignored\n329:      * @param node the owning UML element\n330:      */\n331:     public FigNodeModelElement(GraphModel gm, Object node) {\n332:         this();\n333:         setOwner(node);\n334:         nameFig.setText(placeString());\n335:         readyToEdit = false;\n336: \n337:         //ArgoEventPump.addListener(ArgoEvent.ANY_NOTATION_EVENT, this);\n338:     }\n339: \n340:     /**\n341:      * Construct a figure at a specific position for a given model element.\n342:      * \n343:      * @param element ModelElement associated with figure\n344:      * @param x\n345:      * @param y\n346:      */\n347:     public FigNodeModelElement(Object element, int x, int y) {\n348:         this();\n349:         setOwner(element);\n350:         nameFig.setText(placeString());\n351:         readyToEdit = false;\n352:         setLocation(x, y);\n353:         //ArgoEventPump.addListener(ArgoEvent.ANY_NOTATION_EVENT, this);\n354:     }\n355: \n356:     /**\n357:      * @see java.lang.Object#finalize()\n358:      */\n359:     protected void finalize() throws Throwable {\n360:         ArgoEventPump.removeListener(ArgoEventTypes.ANY_NOTATION_EVENT, this);\n361:         super.finalize();\n362:     }\n363: \n364:     /**\n365:      * After the base clone method has been called determine which child\n366:      * figs of the clone represent the name, stereotype and port. <p>\n367:      *\n368:      * The clone function is used by Copy/Paste operations.\n369:      *\n370:      * @see java.lang.Object#clone()\n371:      */\n372:     public Object clone() {\n373:         FigNodeModelElement clone = (FigNodeModelElement) super.clone();\n374:         Iterator thisIter = this.getFigs().iterator();\n375:         Iterator cloneIter = clone.getFigs().iterator();\n376:         while (thisIter.hasNext()) {\n377:             Fig thisFig = (Fig) thisIter.next();\n378:             Fig cloneFig = (Fig) cloneIter.next();\n379:             if (thisFig == getBigPort()) {\n380:                 clone.setBigPort(cloneFig);\n381:             }\n382:             if (thisFig == nameFig) {\n383:                 clone.nameFig = (FigSingleLineText) thisFig;\n384:             }\n385:             if (thisFig == stereotypeFig) {\n386:                 clone.stereotypeFig = thisFig;\n387:             }\n388:         }\n389:         return clone;\n390:     }\n391: // TODO: _enclosedFigs, _encloser and _eventSenders may also need to be cloned\n392: \n393: \n394: \n395:     /**\n396:      * Default Reply text to be shown while placing node in diagram.\n397:      * Overrule this when the text is not \"new [UMLClassName]\".\n398:      *\n399:      * @return the text to be shown while placing node in diagram\n400:      */\n401:     public String placeString() {\n402:         if (Model.getFacade().isAModelElement(getOwner())) {\n403:             String placeString = Model.getFacade().getName(getOwner());\n404:             if (placeString == null) {\n405:                 placeString =\n406:                     \"new \" + Model.getFacade().getUMLClassName(getOwner());\n407:             }\n408:             return placeString;\n409:         }\n410:         return \"\";\n411:     }\n412: \n413:     ////////////////////////////////////////////////////////////////\n414:     // accessors\n415: \n416:     /**\n417:      * @param id UID\n418:      */\n419:     public void setItemUID(ItemUID id) {\n420:         itemUid = id;\n421:     }\n422: \n423:     /**\n424:      * @return UID\n425:      */\n426:     public ItemUID getItemUID() {\n427:         return itemUid;\n428:     }\n429: \n430:     /**\n431:      * Get the Fig that displays the model element name.\n432:      *\n433:      * @return the name Fig\n434:      */\n435:     protected FigText getNameFig() {\n436:         return nameFig;\n437:     }\n438:     \n439:     /**\n440:      * Get the Rectangle in which the model elements name is displayed\n441:      * @return bounding box for name\n442:      */\n443:     public Rectangle getNameBounds() {\n444:         return nameFig.getBounds();\n445:     }\n446:     \n447:     /**\n448:      * Set the Fig that displays the model element name.\n449:      *\n450:      * @param fig the name Fig\n451:      */\n452:     protected void setNameFig(FigText fig) {\n453:         nameFig = fig;\n454:     }\n455: \n456:     /**\n457:      * Get the name of the model element this Fig represents.\n458:      *\n459:      * @return the name of the model element\n460:      */\n461:     public String getName() {\n462:         return nameFig.getText();\n463:     }\n464: \n465:     /**\n466:      * Change the name of the model element this Fig represents.\n467:      *\n468:      * @param n the name of the model element\n469:      */\n470:     public void setName(String n) {\n471:         nameFig.setText(n);\n472:     }\n473: \n474:     /**\n475:      * @see org.tigris.gef.ui.PopupGenerator#getPopUpActions(java.awt.event.MouseEvent)\n476:      */\n477:     public Vector getPopUpActions(MouseEvent me) {\n478:         Vector popUpActions = super.getPopUpActions(me);\n479: \n480:         // popupAddOffset should be equal to the number of items added here:\n481:         popUpActions.addElement(new JSeparator());\n482:         popupAddOffset = 1;\n483:         if (removeFromDiagram) {\n484:             popUpActions.addElement(\n485:                     ProjectBrowser.getInstance().getRemoveFromDiagramAction());\n486:             popupAddOffset++;\n487:         }\n488:         popUpActions.addElement(new ActionDeleteModelElements());\n489:         popupAddOffset++;\n490: \n491:         /* Check if multiple items are selected: */\n492:         if (TargetManager.getInstance().getTargets().size() == 1) {\n493:             ToDoList list = Designer.theDesigner().getToDoList();\n494:             Vector items =\n495:                     (Vector) list.elementsForOffender(getOwner()).clone();\n496:             if (items != null && items.size() > 0) {\n497:                 ArgoJMenu critiques = new ArgoJMenu(\"menu.popup.critiques\");\n498:                 ToDoItem itemUnderMouse = hitClarifier(me.getX(), me.getY());\n499:                 if (itemUnderMouse != null) {\n500:                     critiques.add(new ActionGoToCritique(itemUnderMouse));\n501:                     critiques.addSeparator();\n502:                 }\n503:                 int size = items.size();\n504:                 for (int i = 0; i < size; i++) {\n505:                     ToDoItem item = (ToDoItem) items.elementAt(i);\n506:                     if (item != itemUnderMouse) {\n507:                         critiques.add(new ActionGoToCritique(item));\n508:                     }\n509:                 }\n510:                 popUpActions.insertElementAt(new JSeparator(), 0);\n511:                 popUpActions.insertElementAt(critiques, 0);\n512:             }\n513: \n514:             // Add stereotypes submenu\n515:             Action[] stereoActions =\n516:                 StereotypeUtility.getApplyStereotypeActions(getOwner());\n517:             if (stereoActions != null) {\n518:                 popUpActions.insertElementAt(new JSeparator(), 0);\n519:                 ArgoJMenu stereotypes =\n520:                     new ArgoJMenu(\"menu.popup.apply-stereotypes\");\n521:                 for (int i = 0; i < stereoActions.length; ++i) {\n522:                     stereotypes.addCheckItem(stereoActions[i]);\n523:                 }\n524:                 popUpActions.insertElementAt(stereotypes, 0);\n525:             }\n526:         }\n527: \n528:         return popUpActions;\n529:     }\n530: \n531:     /**\n532:      * @return the pop-up menu item for Visibility\n533:      */\n534:     protected Object buildVisibilityPopUp() {\n535:         ArgoJMenu visibilityMenu = new ArgoJMenu(\"menu.popup.visibility\");\n536: \n537:         visibilityMenu.addRadioItem(new ActionVisibilityPublic(getOwner()));\n538:         visibilityMenu.addRadioItem(new ActionVisibilityPrivate(getOwner()));\n539:         visibilityMenu.addRadioItem(new ActionVisibilityProtected(getOwner()));\n540:         visibilityMenu.addRadioItem(new ActionVisibilityPackage(getOwner()));\n541:         \n542:         return visibilityMenu;\n543:     }\n544: \n545:     /**\n546:      * Build a pop-up menu item for the various modifiers.<p>\n547:      *\n548:      * This function is designed to be easily extendable with new items.\n549:      *\n550:      * @param items bitwise OR of the items: ROOT, ABSTRACT, LEAF, ACTIVE.\n551:      * @return the menu item\n552:      */\n553:     protected Object buildModifierPopUp(int items) {\n554:         ArgoJMenu modifierMenu = new ArgoJMenu(\"menu.popup.modifiers\");\n555: \n556:         if ((items & ABSTRACT) > 0) {\n557:             modifierMenu.addCheckItem(new ActionModifierAbstract(getOwner()));\n558: \t}\n559:         if ((items & LEAF) > 0) {\n560:             modifierMenu.addCheckItem(new ActionModifierLeaf(getOwner()));\n561: \t}\n562:         if ((items & ROOT) > 0) {\n563:             modifierMenu.addCheckItem(new ActionModifierRoot(getOwner()));\n564: \t}\n565:         if ((items & ACTIVE) > 0) {\n566:             modifierMenu.addCheckItem(new ActionModifierActive(getOwner()));\n567: \t}\n568: \n569:         return modifierMenu;\n570:     }\n571: \n572:     /**\n573:      * @see org.tigris.gef.presentation.Fig#getEnclosingFig()\n574:      */\n575:     public Fig getEnclosingFig() {\n576:         return encloser;\n577:     }\n578: \n579:     /**\n580:      * Updates the modelelement container if the fig is moved in or\n581:      * out another fig. If this fig doesn't have an enclosing fig\n582:      * anymore, the namespace of the diagram will be the owning\n583:      * modelelement. If this fig is moved inside another\n584:      * FigNodeModelElement the owner of that fignodemodelelement will\n585:      * be the owning modelelement.\n586:      * @see Fig#setEnclosingFig(Fig)\n587:      */\n588:     public void setEnclosingFig(Fig newEncloser) {\n589: \tFig oldEncloser = encloser;\n590: \tsuper.setEnclosingFig(newEncloser);\n591: \tif (newEncloser != oldEncloser) {\n592: \t    Object owningModelelement = null;\n593: \t    if (newEncloser == null && isVisible()) {\n594: \t        // If we are not visible most likely we're being deleted.\n595: \n596: \t\t// moved outside another fig onto the diagram canvas\n597: \t\tProject currentProject =\n598: \t\t    ProjectManager.getManager().getCurrentProject();\n599:                 ArgoDiagram diagram = currentProject.getActiveDiagram();\n600:                 // TODO: Who said this was about the active diagram?\n601:                 if (diagram instanceof UMLDiagram\n602: \t\t\t&& ((UMLDiagram) diagram).getNamespace() != null) {\n603:                     owningModelelement = ((UMLDiagram) diagram).getNamespace();\n604:                 } else {\n605:                     owningModelelement = currentProject.getRoot();\n606:                 }\n607: \t    } else if (newEncloser != null\n608:                     && Model.getFacade()\n609:                             .isAModelElement(newEncloser.getOwner())) {\n610:                 owningModelelement = newEncloser.getOwner();\n611:             }\n612:             if (owningModelelement != null\n613: \t\t&& getOwner() != null\n614: \t\t&& (!Model.getModelManagementHelper()\n615: \t\t    .isCyclicOwnership(owningModelelement, getOwner()))\n616: \t\t&& ((Model.getCoreHelper()\n617: \t\t\t.isValidNamespace(getOwner(),\n618: \t\t\t\t\t  owningModelelement)))) {\n619:                 Model.getCoreHelper().setModelElementContainer(getOwner(),\n620: \t\t\t\t\t\t     owningModelelement);\n621:                 /* TODO: move the associations to the correct owner (namespace)\n622:                  * i.e. issue 2151\n623:                  */\n624:             }\n625:         }\n626: \tif (newEncloser != encloser) {\n627: \t    if (encloser instanceof FigNodeModelElement) {\n628: \t\t((FigNodeModelElement) encloser).removeEnclosedFig(this);\n629:             }\n630: \t    if (newEncloser instanceof FigNodeModelElement) {\n631: \t\t((FigNodeModelElement) newEncloser).addEnclosedFig(this);\n632:             }\n633: \t}\n634:         encloser = newEncloser;\n635:     }\n636: \n637:     /**\n638:      * @param fig The fig to be added\n639:      */\n640:     public void addEnclosedFig(Fig fig) {\n641:         enclosedFigs.add(fig);\n642:     }\n643: \n644:     /**\n645:      * @param fig The Fig to be removed\n646:      */\n647:     public void removeEnclosedFig(Fig fig) {\n648:         enclosedFigs.remove(fig);\n649:     }\n650: \n651:     /**\n652:      * @see org.tigris.gef.presentation.Fig#getEnclosedFigs()\n653:      */\n654:     public Vector getEnclosedFigs() {\n655:         return enclosedFigs;\n656:     }\n657: \n658:     /**\n659:      * Update the order of this fig and the order of the\n660:      * figs that are inside of this fig.\n661:      *\n662:      * @param figures in the new order\n663:      */\n664:     public void elementOrdering(Vector figures) {\n665:         int size = figures.size();\n666:         getLayer().bringToFront(this);\n667:         if (size > 0) {\n668:             for (int i = 0; i < size; i++) {\n669:                 Object o = figures.elementAt(i);\n670:                 if (o instanceof FigNodeModelElement\n671:                     && o != getEnclosingFig()) {\n672:                     FigNodeModelElement fignode = (FigNodeModelElement) o;\n673:                     Vector enclosed = fignode.getEnclosedFigs();\n674:                     fignode.elementOrdering(enclosed);\n675:                 }\n676:             }\n677:         }\n678:     }\n679: \n680:     /**\n681:      * @see org.tigris.gef.presentation.Fig#makeSelection()\n682:      */\n683:     public Selection makeSelection() {\n684:         return new SelectionNodeClarifiers(this);\n685:     }\n686: \n687:     /**\n688:      * Overridden to paint shadows. This method supports painting shadows\n689:      * for any FigNodeModelElement. Any Figs that are nested within the\n690:      * FigNodeModelElement will be shadowed.<p>\n691:      *\n692:      * TODO: If g is not a Graphics2D shadows cannot be painted. This is\n693:      * a problem when saving the diagram as SVG.\n694:      *\n695:      * @param g is a Graphics that we paint this object on.\n696:      */\n697:     public void paint(Graphics g) {\n698:         if (shadowSize > 0\n699: \t        && g instanceof Graphics2D) {\n700:             int width = getWidth();\n701:             int height = getHeight();\n702:             int x = getX();\n703:             int y = getY();\n704: \n705:             /* Only create a new shadow image if figure size has changed.\n706:              * Which does not catch all cases:\n707:              * consider show/hide toggle of a stereotype on a package:\n708:              * in this case the total size remains, but the notch\n709:              * at the corner increases/decreases.\n710:              * Hence also check the \"forceRepaint\" attribute.\n711:              */\n712:             if (width != cachedWidth\n713:                     || height != cachedHeight\n714:                     || forceRepaint) {\n715:                 forceRepaint = false;\n716: \n717:                 cachedWidth = width;\n718:                 cachedHeight = height;\n719: \n720:                 BufferedImage img =\n721: \t\t    new BufferedImage(width + 100,\n722: \t\t\t\t      height + 100,\n723: \t\t\t\t      BufferedImage.TYPE_INT_ARGB);\n724: \n725:                 // Paint figure onto offscreen image\n726:                 Graphics ig = img.getGraphics();\n727:                 ig.translate(50 - x, 50 - y);\n728:                 super.paint(ig);\n729: \n730:                 // Apply two filters to the image:\n731:                 // 1. Apply LookupOp which converts all pixel data in the\n732:                 //    figure to the same shadow color.\n733:                 // 2. Apply ConvolveOp which creates blurred effect around\n734:                 //    the edges of the shadow.\n735:                 shadowImage =\n736: \t\t    SHADOW_CONVOLVE_OP.filter(\n737: \t\t\t    SHADOW_LOOKUP_OP.filter(img, null), null);\n738:             }\n739: \n740:             // Paint shadow image onto canvas\n741:             Graphics2D g2d = (Graphics2D) g;\n742:             g2d.drawImage(\n743:                 shadowImage,\n744:                 null,\n745:                 x + shadowSize - 50,\n746:                 y + shadowSize - 50);\n747:         }\n748: \n749:         // Paint figure on top of shadow\n750:         super.paint(g);\n751:     }\n752: \n753:     /**\n754:      * Displays visual indications of pending ToDoItems.\n755:      * Please note that the list of advices (ToDoList) is not the same\n756:      * as the list of element known by the FigNode (_figs). Therefore,\n757:      * it is necessary to check if the graphic item exists before drawing\n758:      * on it. See ClAttributeCompartment for an example.\n759:      * @param g the graphics device\n760:      * @see org.argouml.uml.cognitive.critics.ClAttributeCompartment\n761:      */\n762:     public void paintClarifiers(Graphics g) {\n763:         int iconX = getX();\n764:         int iconY = getY() - 10;\n765:         ToDoList list = Designer.theDesigner().getToDoList();\n766:         Vector items = list.elementsForOffender(getOwner());\n767:         int size = items.size();\n768:         for (int i = 0; i < size; i++) {\n769:             ToDoItem item = (ToDoItem) items.elementAt(i);\n770:             Icon icon = item.getClarifier();\n771:             if (icon instanceof Clarifier) {\n772:                 ((Clarifier) icon).setFig(this);\n773:                 ((Clarifier) icon).setToDoItem(item);\n774:             }\n775:             if (icon != null) {\n776:                 icon.paintIcon(null, g, iconX, iconY);\n777:                 iconX += icon.getIconWidth();\n778:             }\n779:         }\n780:         items = list.elementsForOffender(this);\n781:         size = items.size();\n782:         for (int i = 0; i < size; i++) {\n783:             ToDoItem item = (ToDoItem) items.elementAt(i);\n784:             Icon icon = item.getClarifier();\n785:             if (icon instanceof Clarifier) {\n786:                 ((Clarifier) icon).setFig(this);\n787:                 ((Clarifier) icon).setToDoItem(item);\n788:             }\n789:             if (icon != null) {\n790:                 icon.paintIcon(null, g, iconX, iconY);\n791:                 iconX += icon.getIconWidth();\n792:             }\n793:         }\n794:     }\n795: \n796:     /**\n797:      * @param x the x of the hit\n798:      * @param y the y of the hit\n799:      * @return the todo item of which the clarifier has been hit\n800:      */\n801:     public ToDoItem hitClarifier(int x, int y) {\n802:         int iconX = getX();\n803:         ToDoList list = Designer.theDesigner().getToDoList();\n804:         Vector items = list.elementsForOffender(getOwner());\n805:         int size = items.size();\n806:         for (int i = 0; i < size; i++) {\n807:             ToDoItem item = (ToDoItem) items.elementAt(i);\n808:             Icon icon = item.getClarifier();\n809:             int width = icon.getIconWidth();\n810:             if (y >= getY() - 15\n811:                     && y <= getY() + 10\n812:                     && x >= iconX\n813:                     && x <= iconX + width) {\n814:                 return item;\n815:             }\n816:             iconX += width;\n817:         }\n818:         for (int i = 0; i < size; i++) {\n819:             ToDoItem item = (ToDoItem) items.elementAt(i);\n820:             Icon icon = item.getClarifier();\n821:             if (icon instanceof Clarifier) {\n822:                 ((Clarifier) icon).setFig(this);\n823:                 ((Clarifier) icon).setToDoItem(item);\n824:                 if (((Clarifier) icon).hit(x, y)) {\n825:                     return item;\n826:                 }\n827:             }\n828:         }\n829:         items = list.elementsForOffender(this);\n830:         size = items.size();\n831:         for (int i = 0; i < size; i++) {\n832:             ToDoItem item = (ToDoItem) items.elementAt(i);\n833:             Icon icon = item.getClarifier();\n834:             int width = icon.getIconWidth();\n835:             if (y >= getY() - 15\n836:                     && y <= getY() + 10\n837:                     && x >= iconX\n838:                     && x <= iconX + width) {\n839:                 return item;\n840:             }\n841:             iconX += width;\n842:         }\n843:         for (int i = 0; i < size; i++) {\n844:             ToDoItem item = (ToDoItem) items.elementAt(i);\n845:             Icon icon = item.getClarifier();\n846:             if (icon instanceof Clarifier) {\n847:                 ((Clarifier) icon).setFig(this);\n848:                 ((Clarifier) icon).setToDoItem(item);\n849:                 if (((Clarifier) icon).hit(x, y)) {\n850:                     return item;\n851:                 }\n852:             }\n853:         }\n854:         return null;\n855:     }\n856: \n857:     /**\n858:      * @see org.tigris.gef.presentation.Fig#getTipString(java.awt.event.MouseEvent)\n859:      */\n860:     public String getTipString(MouseEvent me) {\n861:         ToDoItem item = hitClarifier(me.getX(), me.getY());\n862:         String tip = \"\";\n863:         if (item != null\n864:             && Globals.curEditor().getSelectionManager().containsFig(this)) {\n865:             tip = item.getHeadline() + \" \";\n866:         } else if (getOwner() != null) {\n867:             tip = Model.getFacade().getTipString(getOwner());\n868:         } else {\n869:             tip = toString();\n870:         }\n871:         if (tip != null && tip.length() > 0 && !tip.endsWith(\" \")) {\n872:             tip += \" \";\n873:         }\n874:         return tip;\n875:     }\n876: \n877:     ////////////////////////////////////////////////////////////////\n878:     // event handlers\n879: \n880:     /**\n881:      * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n882:      */\n883:     public void vetoableChange(PropertyChangeEvent pce) {\n884:         LOG.debug(\"in vetoableChange\");\n885:         Object src = pce.getSource();\n886:         if (src == getOwner()) {\n887:             DelayedChangeNotify delayedNotify =\n888:                 new DelayedChangeNotify(this, pce);\n889:             SwingUtilities.invokeLater(delayedNotify);\n890:         } else {\n891:             LOG.debug(\"FigNodeModelElement got vetoableChange\"\n892: \t\t      + \" from non-owner:\"\n893: \t\t      + src);\n894:         }\n895:     }\n896: \n897:     /**\n898:      * @see org.argouml.kernel.DelayedVChangeListener#delayedVetoableChange(java.beans.PropertyChangeEvent)\n899:      */\n900:     public void delayedVetoableChange(PropertyChangeEvent pce) {\n901:         LOG.debug(\"in delayedVetoableChange\");\n902:         // update any text, colors, fonts, etc.\n903:         renderingChanged();\n904:         endTrans();\n905:     }\n906: \n907:     /**\n908:      * set some new bounds.\n909:      */\n910:     protected void updateBounds() {\n911:         if (!checkSize) {\n912:             return;\n913:         }\n914:         Rectangle bbox = getBounds();\n915:         Dimension minSize = getMinimumSize();\n916:         bbox.width = Math.max(bbox.width, minSize.width);\n917:         bbox.height = Math.max(bbox.height, minSize.height);\n918:         setBounds(bbox.x, bbox.y, bbox.width, bbox.height);\n919:     }\n920: \n921:     /**\n922:      * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n923:      */\n924:     public void propertyChange(PropertyChangeEvent pve) {\n925:         Object src = pve.getSource();\n926:         String pName = pve.getPropertyName();\n927:         if (pve instanceof DeleteInstanceEvent && src == getOwner()) {\n928:             removeFromDiagram();\n929:             return;\n930:         }\n931:         // We handle and consume editing events\n932:         if (pName.equals(\"editing\")\n933:                 && Boolean.FALSE.equals(pve.getNewValue())) {\n934:             try {\n935:                 //parse the text that was edited\n936:                 textEdited((FigText) src);\n937:                 // resize the FigNode to accomodate the new text\n938:                 Rectangle bbox = getBounds();\n939:                 Dimension minSize = getMinimumSize();\n940:                 bbox.width = Math.max(bbox.width, minSize.width);\n941:                 bbox.height = Math.max(bbox.height, minSize.height);\n942:                 setBounds(bbox.x, bbox.y, bbox.width, bbox.height);\n943:                 endTrans();\n944:             } catch (PropertyVetoException ex) {\n945:                 LOG.error(\"could not parse the text entered. \"\n946: \t\t\t  + \"PropertyVetoException\",\n947: \t\t\t  ex);\n948:             }\n949:         } else if (pName.equals(\"editing\")\n950:                         && Boolean.TRUE.equals(pve.getNewValue())) {\n951:             textEditStarted((FigText) src);\n952:         } else {\n953:             super.propertyChange(pve);\n954:         }\n955:         if (Model.getFacade().isAModelElement(src)) {\n956:             /* If the source of the event is an UML object,\n957:              * e.g. the owner of this Fig (but not always only the owner\n958:              * is shown, e.g. for a class, also its attributes are shown),\n959:              * then the UML model has been changed.\n960:              */\n961:             // We catch the exception here so it is handled for all subclasses\n962:             try {\n963:                 modelChanged(pve);\n964:             } catch (Exception e) {\n965:                 /* need to catch javax.jmi.reflect.InvalidObjectException */\n966:                 LOG.debug(\"modelChanged method accessed deleted element \", e);\n967:             }\n968:         }\n969:     }\n970: \n971:     /**\n972:      * This method is called when the user doubleclicked on the text field,\n973:      * and starts editing. Subclasses should overrule this field to e.g.\n974:      * supply help to the user about the used format. <p>\n975:      *\n976:      * It is also possible to alter the text to be edited\n977:      * already here, e.g. by adding the stereotype in front of the name,\n978:      * by calling \n979:      * <code>notationProviderName.putValue(\"fullyHandleStereotypes\", \n980:      * true);</code>, but that seems not user-friendly. See issue 3838.\n981:      *\n982:      * @param ft the FigText that will be edited and contains the start-text\n983:      */\n984:     protected void textEditStarted(FigText ft) {\n985:         if (ft == getNameFig()) {\n986:             showHelp(notationProviderName.getParsingHelp());\n987:             ft.setText(notationProviderName.toString());\n988:         }\n989:     }\n990: \n991:     /**\n992:      * Utility function to localize the given string with help text,\n993:      * and show it in the status bar of the ArgoUML window.\n994:      * This function is used in favour of the inline call\n995:      * to enable later improvements; e.g. it would be possible to\n996:      * show a help-balloon. TODO: Work this out.\n997:      * One matter to possibly improve: show multiple lines.\n998:      *\n999:      * @param s the given string to be localized and shown\n1000:      */\n1001:     protected void showHelp(String s) {\n1002:         ProjectBrowser.getInstance().getStatusBar().showStatus(\n1003:                 Translator.localize(s));\n1004:     }\n1005: \n1006:     /**\n1007:      * This method is called after the user finishes editing a text\n1008:      * field that is in the FigNodeModelElement.  Determine which\n1009:      * field and update the model.  This class handles the name,\n1010:      * and the stereotype,\n1011:      * subclasses should override to handle other text elements.\n1012:      *\n1013:      * @param ft the FigText that has been edited and contains the new text\n1014:      * @throws PropertyVetoException thrown when new text represents\n1015:      * an unacceptable value\n1016:      */\n1017:     protected void textEdited(FigText ft) throws PropertyVetoException {\n1018:         if (ft == nameFig) {\n1019:             if (getOwner() == null) {\n1020:                 return;\n1021:             }\n1022:             ft.setText(notationProviderName.parse(ft.getText()));\n1023:         }\n1024:     }\n1025: \n1026:     ////////////////////////////////////////////////////////////////\n1027:     // event handlers - MouseListener implementation\n1028: \n1029:     /**\n1030:      * If the user double clicks on any part of this FigNode, pass it\n1031:      * down to one of the internal Figs. This allows the user to\n1032:      * initiate direct text editing.\n1033:      *\n1034:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n1035:      */\n1036:     public void mouseClicked(MouseEvent me) {\n1037:         if (!readyToEdit) {\n1038:             if (Model.getFacade().isAModelElement(getOwner())) {\n1039:                 Model.getCoreHelper().setName(getOwner(), \"\");\n1040:                 readyToEdit = true;\n1041:             } else {\n1042:                 LOG.debug(\"not ready to edit name\");\n1043:                 return;\n1044:             }\n1045:         }\n1046:         if (me.isConsumed()) {\n1047:             return;\n1048:         }\n1049:         if (me.getClickCount() >= 2\n1050:                 && !(me.isPopupTrigger()\n1051:                         || me.getModifiers() == InputEvent.BUTTON3_MASK)) {\n1052:             if (getOwner() == null) {\n1053:                 return;\n1054:             }\n1055:             Rectangle r = new Rectangle(me.getX() - 2, me.getY() - 2, 4, 4);\n1056:             Fig f = hitFig(r);\n1057:             if (f instanceof MouseListener && f.isVisible()) {\n1058:                 ((MouseListener) f).mouseClicked(me);\n1059:             } else if (f instanceof FigGroup && f.isVisible()) {\n1060:                 //this enables direct text editing for sub figs of a\n1061:                 //FigGroup object:\n1062:                 Fig f2 = ((FigGroup) f).hitFig(r);\n1063:                 if (f2 instanceof MouseListener) {\n1064:                     ((MouseListener) f2).mouseClicked(me);\n1065:                 } else {\n1066:                     createFeatureIn((FigGroup) f, me);\n1067:                 }\n1068:             }\n1069:         }\n1070:     }\n1071: \n1072:     /**\n1073:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n1074:      */\n1075:     public void keyPressed(KeyEvent ke) {\n1076:         if (ke.isConsumed() || getOwner() == null) {\n1077:             return;\n1078:         }\n1079:         nameFig.keyPressed(ke);\n1080:     }\n1081: \n1082:     /**\n1083:      * @see java.awt.event.KeyListener#keyReleased(java.awt.event.KeyEvent)\n1084:      */\n1085:     public void keyReleased(KeyEvent ke) {\n1086:         if (ke.isConsumed() || getOwner() == null) {\n1087:             return;\n1088:         }\n1089:         nameFig.keyReleased(ke);\n1090:     }\n1091: \n1092:     /**\n1093:      * @see java.awt.event.KeyListener#keyTyped(java.awt.event.KeyEvent)\n1094:      */\n1095:     public void keyTyped(KeyEvent ke) {\n1096:         if (!editable) {\n1097:             return;\n1098:         }\n1099:         if (!readyToEdit) {\n1100:             if (Model.getFacade().isAModelElement(getOwner())) {\n1101:                 Model.getCoreHelper().setName(getOwner(), \"\");\n1102:                 readyToEdit = true;\n1103:             } else {\n1104:                 LOG.debug(\"not ready to edit name\");\n1105:                 return;\n1106:             }\n1107:         }\n1108:         if (ke.isConsumed() || getOwner() == null) {\n1109:             return;\n1110:         }\n1111:         nameFig.keyTyped(ke);\n1112:     }\n1113: \n1114:     ////////////////////////////////////////////////////////////////\n1115:     // internal methods\n1116: \n1117:     /**\n1118:      * This is called after any part of the UML MModelElement has\n1119:      * changed. This method automatically updates the name FigText.\n1120:      * Subclasses should override and update other parts.\n1121:      *\n1122:      * @param mee the ModelElementEvent that caused the change\n1123:      */\n1124:     protected void modelChanged(PropertyChangeEvent mee) {\n1125:         if (mee == null) {\n1126:             throw new IllegalArgumentException(\"event may never be null \"\n1127:                            + \"with modelchanged\");\n1128:         }\n1129:         Object owner = getOwner();\n1130:         // If the element has been deleted, the caller will\n1131:         // receive an InvalidElementException that it must handle.\n1132:         if (owner == null) {\n1133:             return;\n1134:         }\n1135:         if (\"name\".equals(mee.getPropertyName())\n1136:                 && mee.getSource() == owner) {\n1137:             updateNameText();\n1138:             damage();\n1139:         }\n1140:         if ((mee.getSource() == owner\n1141:                 && mee.getPropertyName().equals(\"stereotype\"))) {\n1142:             if (mee.getOldValue() != null) {\n1143:                 removeElementListener(mee.getOldValue());\n1144:             }\n1145:             if (mee.getNewValue() != null) {\n1146:                 addElementListener(mee.getNewValue(), \"name\");\n1147:             }\n1148:             updateStereotypeText();\n1149:             damage();\n1150:         }\n1151:     }\n1152: \n1153: \n1154:     /**\n1155:      * Create a new feature in the owner fig.\n1156:      *\n1157:      * must be overridden to make sense\n1158:      * (I didn't want to make it abstract because it might not be required)\n1159:      *\n1160:      * @param fg The fig group to which this applies\n1161:      * @param me The input event that triggered us. In the current\n1162:      *            implementation a mouse double click.\n1163:      */\n1164:     protected void createFeatureIn(FigGroup fg, InputEvent me) {\n1165: \n1166:     }\n1167: \n1168:     /**\n1169:      * @param o the given object\n1170:      * @return true if one of my figs has the given object as owner\n1171:      */\n1172:     protected boolean isPartlyOwner(Object o) {\n1173:         if (o == null || o == getOwner()) {\n1174:             return true;\n1175:         }\n1176:         Iterator it = getFigs().iterator();\n1177:         while (it.hasNext()) {\n1178:             Fig fig = (Fig) it.next();\n1179:             if (isPartlyOwner(fig, o)) {\n1180:                 return true;\n1181:             }\n1182:         }\n1183:         return false;\n1184:     }\n1185: \n1186:     /**\n1187:      * @param fig the given fig (may be a group)\n1188:      * @param o the given object\n1189:      * @return true if one of the given figs has the given object as owner\n1190:      */\n1191:     protected boolean isPartlyOwner(Fig fig, Object o) {\n1192:         if (o == null) {\n1193:             return false;\n1194:         }\n1195:         if (o == fig.getOwner()) {\n1196:             return true;\n1197:         }\n1198:         if (fig instanceof FigGroup) {\n1199:             Iterator it = ((FigGroup) fig).getFigs().iterator();\n1200:             while (it.hasNext()) {\n1201:                 Fig fig2 = (Fig) it.next();\n1202:                 if (isPartlyOwner(fig2, o)) {\n1203:                     return true;\n1204:                 }\n1205:             }\n1206:         }\n1207:         return false;\n1208:     }\n1209: \n1210:     /**\n1211:      * @see org.tigris.gef.presentation.Fig#deleteFromModel()\n1212:      */\n1213:     public void deleteFromModel() {\n1214:         Object own = getOwner();\n1215:         if (own != null) {\n1216:             ProjectManager.getManager().getCurrentProject().moveToTrash(own);\n1217:         }\n1218:         Iterator it = getFigs().iterator();\n1219:         while (it.hasNext()) {\n1220:             ((Fig) it.next()).deleteFromModel();\n1221:         }\n1222:         super.deleteFromModel();\n1223:     }\n1224: \n1225:     /**\n1226:      * In ArgoUML, for every Fig, this setOwner() function\n1227:      * may only be called twice: Once after the fig is created, \n1228:      * with a non-null argument, and once at end-of-life of the Fig,\n1229:      * with a null argument. It is not allowed in ArgoUML to change \n1230:      * the owner of a fig in any other way. <p>\n1231:      * \n1232:      * Hence, during the lifetime of this Fig object, \n1233:      * the owner shall go from null to some UML object, and to null again. \n1234:      * \n1235:      * @see org.tigris.gef.presentation.Fig#setOwner(java.lang.Object)\n1236:      */\n1237:     public void setOwner(Object own) {\n1238:         // call this before the owner is set:\n1239:         updateListeners(own);\n1240:         super.setOwner(own);\n1241:         initNotationProviders(own);\n1242:         readyToEdit = true;\n1243:         if (own != null) {\n1244:             renderingChanged();\n1245:         }\n1246:         updateBounds();\n1247:         bindPort(own, bigPort);\n1248:     }\n1249: \n1250:     /**\n1251:      * Create the NotationProviders.\n1252:      * \n1253:      * @param own the current owner\n1254:      */\n1255:     protected void initNotationProviders(Object own) {\n1256:         if (Model.getFacade().isAModelElement(own)) {\n1257:             notationProviderName =\n1258:                 NotationProviderFactory2.getInstance().getNotationProvider(\n1259:                         NotationProviderFactory2.TYPE_NAME, own);\n1260:             notationProviderName.putValue(\n1261:                     \"pathVisible\", Boolean.valueOf(isPathVisible()));\n1262:         }\n1263:     }\n1264: \n1265:     /**\n1266:      * Updates the text of the sterotype FigText. Override in subclasses to get\n1267:      * wanted behaviour.\n1268:      */\n1269:     protected void updateStereotypeText() {\n1270:         if (getOwner() == null) {\n1271:             LOG.warn(\"Owner of [\" + this.toString() + \"/\" + this.getClass()\n1272:                     + \"] is null.\");\n1273:             LOG.warn(\"I return...\");\n1274:             return;\n1275:         }\n1276: \n1277:         Object modelElement = getOwner();\n1278:         stereotypeFig.setOwner(modelElement);\n1279:         if (modelElement != null) {\n1280:             ((FigStereotypesCompartment) stereotypeFig).populate();\n1281:         }\n1282:     }\n1283: \n1284:     /**\n1285:      * Updates the text of the name FigText.\n1286:      */\n1287:     protected void updateNameText() {\n1288:         if (readyToEdit) {\n1289:             if (getOwner() == null) {\n1290:                 return;\n1291:             }\n1292:             if (notationProviderName != null) {\n1293:                 nameFig.setText(notationProviderName.toString());\n1294:                 updateBounds();\n1295:             }\n1296:         }\n1297:     }\n1298: \n1299:     /**\n1300:      * @see org.argouml.uml.diagram.ui.PathContainer#isPathVisible()\n1301:      */\n1302:     public boolean isPathVisible() {\n1303:         return pathVisible;\n1304:     }\n1305: \n1306:     /**\n1307:      * @see org.argouml.uml.diagram.ui.PathContainer#setPathVisible(boolean)\n1308:      */\n1309:     public void setPathVisible(boolean visible) {\n1310:         if (pathVisible == visible) {\n1311:             return;\n1312:         }\n1313:         MutableGraphSupport.enableSaveAction();\n1314:         pathVisible = visible;\n1315:         if (notationProviderName != null) {\n1316:             notationProviderName.putValue(\"pathVisible\", Boolean.valueOf(visible));\n1317:         }\n1318:         if (readyToEdit) {\n1319:             renderingChanged();\n1320:             damage();\n1321:         }\n1322:     }\n1323: \n1324:     /**\n1325:      * USED BY PGML.tee.\n1326:      * @return the class name and bounds together with compartment\n1327:      * visibility.\n1328:      */\n1329:     public String classNameAndBounds() {\n1330:         return getClass().getName() +\n1331:             \"[\" + getX() + \", \" + getY() + \", \" +\n1332:             getWidth() + \", \" + getHeight() + \"]\" +\n1333:             \"pathVisible=\" + isPathVisible() + \";\";\n1334:     }\n1335: \n1336:     /**\n1337:      * Implementations of this method should register/unregister the fig for all\n1338:      * (model)events. For FigNodeModelElement only the fig itself is registered\n1339:      * as listening to events fired by the owner itself. But for, for example,\n1340:      * FigClass the fig must also register for