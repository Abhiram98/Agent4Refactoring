ssociation\n460:      * @throws IllegalArgumentException if either Classifier is null\n461:      */\n462:     private MAssociation buildAssociation(MClassifier c1,\n463: \t\t\t\t\t boolean nav1,\n464: \t\t\t\t\t MAggregationKind agg1,\n465: \t\t\t\t\t MClassifier c2,\n466: \t\t\t\t\t boolean nav2,\n467: \t\t\t\t\t MAggregationKind agg2) {\n468:         if (c1 == null || c2 == null) {\n469:             throw new IllegalArgumentException(\"one of \"\n470: \t\t\t\t\t       + \"the classifiers to be \"\n471: \t\t\t\t\t       + \"connected is null\");\n472:         }\n473:         MNamespace ns1 = c1.getNamespace();\n474:         MNamespace ns2 = c2.getNamespace();\n475:         if (ns1 == null || ns2 == null) {\n476:             throw new IllegalArgumentException(\"one of \"\n477: \t\t\t\t\t       + \"the classifiers does not \"\n478: \t\t\t\t\t       + \"belong to a namespace\");\n479:         }\n480:         MAssociation assoc = (MAssociation) createAssociation();\n481:         assoc.setName(\"\");\n482:         assoc.setNamespace(\n483:                 (MNamespace) nsmodel.getCoreHelper()\n484:                 \t.getFirstSharedNamespace(ns1, ns2));\n485:         buildAssociationEnd(\n486: \t\t\t    assoc,\n487: \t\t\t    null,\n488: \t\t\t    c1,\n489: \t\t\t    null,\n490: \t\t\t    null,\n491: \t\t\t    nav1,\n492: \t\t\t    null,\n493: \t\t\t    agg1,\n494: \t\t\t    null,\n495: \t\t\t    null,\n496: \t\t\t    null);\n497:         buildAssociationEnd(\n498: \t\t\t    assoc,\n499: \t\t\t    null,\n500: \t\t\t    c2,\n501: \t\t\t    null,\n502: \t\t\t    null,\n503: \t\t\t    nav2,\n504: \t\t\t    null,\n505: \t\t\t    agg2,\n506: \t\t\t    null,\n507: \t\t\t    null,\n508: \t\t\t    null);\n509:         return assoc;\n510:     }\n511: \n512:     /**\n513:      * Builds a binary associationrole on basis of two classifierroles,\n514:      * navigation and aggregation.\n515:      *\n516:      * @param fromClassifier   the first given classifier\n517:      * @param aggregationKind1 the first aggregationkind\n518:      * @param toClassifier     the second given classifier\n519:      * @param aggregationKind2 the second aggregationkind\n520:      * @param unidirectional true if unidirectional\n521:      * @return the newly build binary associationrole\n522:      */\n523:     public Object buildAssociation(\n524: \t\t\t\t\t Object fromClassifier,\n525: \t\t\t\t\t Object aggregationKind1,\n526: \t\t\t\t\t Object toClassifier,\n527: \t\t\t\t\t Object aggregationKind2,\n528: \t\t\t\t\t Boolean unidirectional) {\n529:         if (fromClassifier == null || toClassifier == null) {\n530:                 throw new IllegalArgumentException(\"one of \"\n531:         \t\t\t\t       + \"the classifiers to be \"\n532:         \t\t\t\t       + \"connected is null\");\n533:         }\n534:         MClassifier from = (MClassifier) fromClassifier;\n535:         MClassifier to = (MClassifier) toClassifier;\n536:         MAggregationKind agg1 = (MAggregationKind) aggregationKind1;\n537:         MAggregationKind agg2 = (MAggregationKind) aggregationKind2;\n538: \n539:         MNamespace ns1 = from.getNamespace();\n540:         MNamespace ns2 = to.getNamespace();\n541:         if (ns1 == null || ns2 == null) {\n542:                 throw new IllegalArgumentException(\"one of \"\n543:         \t\t\t\t       + \"the classifiers does not \"\n544:         \t\t\t\t       + \"belong to a namespace\");\n545:         }\n546:         MAssociation assoc = (MAssociation) createAssociation();\n547:         assoc.setName(\"\");\n548:         assoc.setNamespace((MNamespace)\n549:         \t\t   nsmodel.getCoreHelper().getFirstSharedNamespace(ns1,\n550:         \t\t\t\t\t\t\t\t  ns2));\n551: \n552:         boolean nav1 = true;\n553:         boolean nav2 = true;\n554: \n555:         if (from instanceof MInterface) {\n556:             nav2 = false;\n557:             agg2 = agg1;\n558:             agg1 = null;\n559:         } else if (to instanceof MInterface) {\n560:             nav1 = false;\n561:         } else {\n562:             nav1 = !Boolean.TRUE.equals(unidirectional);\n563:             nav2 = true;\n564:         }\n565: \n566:         buildAssociationEnd(\n567: \t\t\t    assoc,\n568: \t\t\t    null,\n569: \t\t\t    from,\n570: \t\t\t    null,\n571: \t\t\t    null,\n572: \t\t\t    nav1,\n573: \t\t\t    null,\n574: \t\t\t    agg1,\n575: \t\t\t    null,\n576: \t\t\t    null,\n577: \t\t\t    null);\n578:         buildAssociationEnd(\n579: \t\t\t    assoc,\n580: \t\t\t    null,\n581: \t\t\t    to,\n582: \t\t\t    null,\n583: \t\t\t    null,\n584: \t\t\t    nav2,\n585: \t\t\t    null,\n586: \t\t\t    agg2,\n587: \t\t\t    null,\n588: \t\t\t    null,\n589: \t\t\t    null);\n590: \n591:         return assoc;\n592:     }\n593: \n594: \n595:     /**\n596:      * Builds a binary associations between two classifiers with\n597:      * default values for the association ends and the association\n598:      * itself.<p>\n599:      *\n600:      * @param classifier1 The first classifier to connect\n601:      * @param classifier2 The second classifier to connect\n602:      * @return MAssociation\n603:      */\n604:     public Object buildAssociation(\n605:             Object classifier1,\n606: \t\t\tObject classifier2) {\n607:         MClassifier c1 = (MClassifier) classifier1;\n608:         MClassifier c2 = (MClassifier) classifier2;\n609:         return buildAssociation(c1, true, MAggregationKind.NONE,\n610:                                 c2, true, MAggregationKind.NONE);\n611:     }\n612: \n613:     /**\n614:      * Builds a binary association with a direction, aggregation\n615:      * and a given name.\n616:      *\n617:      * @param c1 The first classifier to connect to\n618:      * @param nav1 The navigability of the Associaton end\n619:      * @param c2 The second classifier to connect to\n620:      * @param nav2 The navigability of the second Associaton end\n621:      * @param name the given name\n622:      * @return association\n623:      */\n624:     public Object buildAssociation(Object c1, boolean nav1,\n625: \t\t\t\t   Object c2, boolean nav2, String name) {\n626:         MAssociation assoc =\n627: \t    buildAssociation((MClassifier) c1, nav1, MAggregationKind.NONE,\n628: \t\t\t     (MClassifier) c2, nav2, MAggregationKind.NONE);\n629:         if (assoc != null) {\n630:             assoc.setName(name);\n631:         }\n632:         return assoc;\n633:     }\n634: \n635:     /**\n636:      * Builds an associationClass between classifier end1 and end2 with a\n637:      * default class.<p>\n638:      *\n639:      * @param end1 the first given classifier\n640:      * @param end2 the second given classifier\n641:      * @return MAssociationClass\n642:      */\n643:     public Object buildAssociationClass(Object end1, Object end2) {\n644:         if (end1 == null\n645:                 || end2 == null\n646:                 || !(end1 instanceof MClassifier)\n647:                 || !(end2 instanceof MClassifier)) {\n648:             throw new IllegalArgumentException(\n649:                     \"either one of the arguments was null\");\n650:         }\n651:         return buildAssociationClass(\n652:                 (MClass) buildClass(),\n653:                 (MClassifier) end1, (MClassifier) end2);\n654:     }\n655: \n656:     /**\n657:      * Builds a fully configurable association end. All variables for\n658:      * an associationend can be given as parameter.\n659:      *\n660:      * @param assoc The associaton this end will be part of\n661:      * @param name The name of the association end\n662:      * @param type The type (classifier) the end will connect. The end\n663:      * is a connection piece between an association and a classifier\n664:      * @param multi The multiplicity\n665:      * @param stereo The stereotype\n666:      * @param navigable The navigability. True if this association end\n667:      *                  can be 'passed' from the other classifier.\n668:      * @param order Ordering of the association\n669:      * @param aggregation the aggregationkind\n670:      * @param scope the scope kind\n671:      * @param changeable the changeablekind\n672:      * @param visibility the visibilitykind\n673:      * @return MAssociationEnd\n674:      */\n675:     public Object buildAssociationEnd(\n676: \t\t\t\t\t       Object assoc,\n677: \t\t\t\t\t       String name,\n678: \t\t\t\t\t       Object type,\n679: \t\t\t\t\t       Object multi,\n680: \t\t\t\t\t       Object stereo,\n681: \t\t\t\t\t       boolean navigable,\n682: \t\t\t\t\t       Object order,\n683: \t\t\t\t\t       Object aggregation,\n684: \t\t\t\t\t       Object scope,\n685: \t\t\t\t\t       Object changeable,\n686: \t\t\t\t\t       Object visibility) {\n687:         // wellformednessrules and preconditions\n688:         if (assoc == null\n689:                 || !(assoc instanceof MAssociation)\n690:                 || type == null\n691:                 || !(type instanceof MClassifier)) {\n692:             throw new IllegalArgumentException(\"either type or association \"\n693: \t\t\t\t\t       + \"are null\");\n694:         }\n695:         if (multi != null\n696:                 && !(multi instanceof MMultiplicity)) {\n697:             throw new IllegalArgumentException(\"Multiplicity\");\n698:         }\n699:         if (stereo != null\n700:                 && !(stereo instanceof MStereotype)) {\n701:             throw new IllegalArgumentException(\"Stereotype\");\n702:         }\n703:         if (order != null\n704:                 && !(order instanceof MOrderingKind)) {\n705:             throw new IllegalArgumentException(\"OrderingKind\");\n706:         }\n707:         if (aggregation != null\n708:                 && !(aggregation instanceof MAggregationKind)) {\n709:             throw new IllegalArgumentException(\"AggregationKind\");\n710:         }\n711:         if (scope != null\n712:                 && !(scope instanceof MScopeKind)) {\n713:             throw new IllegalArgumentException(\"ScopeKind\");\n714:         }\n715:         if (changeable != null\n716:                 && !(changeable instanceof MChangeableKind)) {\n717:             throw new IllegalArgumentException(\"ChangeableKind\");\n718:         }\n719:         if (visibility != null\n720:                 && !(visibility instanceof MVisibilityKind)) {\n721:             throw new IllegalArgumentException(\"VisibilityKind\");\n722:         }\n723: \n724:         if (type instanceof MDataType || type instanceof MInterface) {\n725:             if (!navigable) {\n726:                 throw new IllegalArgumentException(\n727:                         \"Wellformedness rule 2.5.3.3 [1] is broken. \"\n728:                         + \"The Classifier of an AssociationEnd cannot be an \"\n729:                         + \"Interface or a DataType if the association is \"\n730:                         + \"navigable away from that end.\");\n731:             }\n732:             List ends = new ArrayList();\n733:             ends.addAll(((MAssociation) assoc).getConnections());\n734:             Iterator it = ends.iterator();\n735:             while (it.hasNext()) {\n736:                 MAssociationEnd end = (MAssociationEnd) it.next();\n737:                 if (end.isNavigable()) {\n738:                     throw new IllegalArgumentException(\"type is either \"\n739: \t\t\t\t\t\t       + \"datatype or \"\n740: \t\t\t\t\t\t       + \"interface and is \"\n741: \t\t\t\t\t\t       + \"navigable to\");\n742:                 }\n743:             }\n744:         }\n745:         if (aggregation != null\n746:                 && aggregation.equals(MAggregationKind.COMPOSITE)\n747:                 && multi != null\n748:                 && ((MMultiplicity) multi).getUpper() > 1) {\n749:             throw new IllegalArgumentException(\"aggregation is composite \"\n750: \t\t\t\t\t   + \"and multiplicity > 1\");\n751:         }\n752: \n753:         MAssociationEnd end =\n754:             (MAssociationEnd)\n755:             \tnsmodel.getCoreFactory().createAssociationEnd();\n756:         end.setAssociation((MAssociation) assoc);\n757:         end.setType((MClassifier) type);\n758:         end.setName(name);\n759:         if (multi != null) {\n760:             end.setMultiplicity((MMultiplicity) multi);\n761:         } else {\n762:             end.setMultiplicity(MMultiplicity.M1_1);\n763:         }\n764:         if (stereo != null) {\n765:             end.setStereotype((MStereotype) stereo);\n766:         }\n767:         end.setNavigable(navigable);\n768:         if (order != null) {\n769:             end.setOrdering((MOrderingKind) order);\n770:         } else {\n771:             end.setOrdering(MOrderingKind.UNORDERED);\n772:         }\n773:         if (aggregation != null) {\n774:             end.setAggregation((MAggregationKind) aggregation);\n775:         } else {\n776:             end.setAggregation(MAggregationKind.NONE);\n777:         }\n778:         if (scope != null) {\n779:             end.setTargetScope((MScopeKind) scope);\n780:         } else {\n781:             end.setTargetScope(MScopeKind.INSTANCE);\n782:         }\n783:         if (changeable != null) {\n784:             end.setChangeability((MChangeableKind) changeable);\n785:         } else {\n786:             end.setChangeability(MChangeableKind.CHANGEABLE);\n787:         }\n788:         if (visibility != null) {\n789:             end.setVisibility((MVisibilityKind) visibility);\n790:         } else {\n791:             end.setVisibility(MVisibilityKind.PUBLIC);\n792:         }\n793:         return end;\n794:     }\n795: \n796:     /**\n797:      * Builds a simply configured association end.\n798:      *\n799:      * @param type the given classifier\n800:      * @param assoc the given association\n801:      * @return the newly build associationend\n802:      */\n803:     public Object buildAssociationEnd(\n804:             Object type,\n805:             Object assoc) {\n806:         if (type == null\n807:                 || !(type instanceof MClassifier)\n808:                 || assoc == null\n809:                 || !(assoc instanceof MAssociation)) {\n810:             throw new IllegalArgumentException(\"one of the arguments is null\");\n811:         }\n812:         return buildAssociationEnd(\n813:                 assoc,\n814:                 \"\",\n815:                 type,\n816:                 null,\n817:                 null,\n818:                 true,\n819:                 null,\n820:                 null,\n821:                 null,\n822:                 null,\n823:                 MVisibilityKind.PUBLIC);\n824:     }\n825: \n826:     /**\n827:      * Builds an association class from a class and two classifiers\n828:      * that should be associated. Both ends of the associationclass\n829:      * are navigable.<p>\n830:      *\n831:      * @param cl the class\n832:      * @param end1 the first classifier\n833:      * @param end2 the second classifier\n834:      * @return MAssociationClass\n835:      */\n836:     private MAssociationClass buildAssociationClass(MClass cl,\n837:             MClassifier end1, MClassifier end2) {\n838:         if (end1 == null\n839:                 || end2 == null\n840:                 || cl == null) {\n841:             throw new IllegalArgumentException(\n842:                     \"either one of the arguments was null\");\n843:         }\n844:         MAssociationClass assoc = (MAssociationClass) createAssociationClass();\n845:         assoc.setName(cl.getName());\n846:         assoc.setAbstract(cl.isAbstract());\n847:         assoc.setActive(cl.isActive());\n848:         assoc.setAssociationEnds(cl.getAssociationEnds());\n849:         assoc.setClassifierRoles(cl.getClassifierRoles());\n850:         assoc.setClassifierRoles1(cl.getClassifierRoles1());\n851:         assoc.setClassifiersInState(cl.getClassifiersInState());\n852:         assoc.setClientDependencies(cl.getClientDependencies());\n853:        