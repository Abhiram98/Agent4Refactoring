ceLoaderWrapper.getResourceLoaderWrapper().lookupIconResource(\"CompositeAggregation\");\n77: \n78:     public static Icon selfassoc =\n79:         ResourceLoaderWrapper.getResourceLoaderWrapper().lookupIconResource(\"SelfAssociation\");\n80:         \n81: \n82: \n83:     ////////////////////////////////////////////////////////////////\n84:     // instance variables\n85:     protected boolean _useComposite = false;\n86:     \n87: \n88: \n89:     ////////////////////////////////////////////////////////////////\n90:     // constructors\n91: \n92:     /** Construct a new SelectionClass for the given Fig */\n93:     public SelectionClass(Fig f) { super(f); }\n94: \n95:     /** Return a handle ID for the handle under the mouse, or -1 if\n96:      *  none. Needs-More-Work: in the future, return a Handle instance or\n97:      *  null. <p>\n98:      *  <pre>\n99:      *   0-------1-------2\n100:      *   |               |\n101:      *   3               4\n102:      *   |               |\n103:      *   5-------6-------7\n104:      * </pre>\n105:      */\n106:     public void hitHandle(Rectangle r, Handle h) {\n107:         super.hitHandle(r, h);\n108:         if (h.index != -1) return;\n109:         if (!_paintButtons) return;\n110:         Editor ce = Globals.curEditor();\n111:         SelectionManager sm = ce.getSelectionManager();\n112:         if (sm.size() != 1) return;\n113:         ModeManager mm = ce.getModeManager();\n114:         if (mm.includes(ModeModify.class) && _pressedButton == -1) return;\n115:         int cx = _content.getX();\n116:         int cy = _content.getY();\n117:         int cw = _content.getWidth();\n118:         int ch = _content.getHeight();\n119:         int iw = inherit.getIconWidth();\n120:         int ih = inherit.getIconHeight();\n121:         int aw = assoc.getIconWidth();\n122:         int ah = assoc.getIconHeight();\n123:         int saw = selfassoc.getIconWidth();\n124:         int sah = selfassoc.getIconHeight();\n125: \n126:         i