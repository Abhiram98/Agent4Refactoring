 addFig(_bigPort);\n89:     addFig(_cover);\n90:     addFig(_stereo);\n91:     addFig(_name);  \n92:     addFig(_upperRect);\n93:     addFig(_lowerRect);\n94: \n95:     Rectangle r = getBounds();\n96:     setBounds(r.x, r.y, r.width, r.height);\n97:   }\n98: \n99:   public FigComponentInstance(GraphModel gm, Object node) {\n100:     this();\n101:     setOwner(node);\n102:   }\n103: \n104:   public String placeString() { \n105:     return \"new ComponentInstance\";\n106:   }\n107: \n108:   public Object clone() {\n109:     FigComponentInstance figClone = (FigComponentInstance) super.clone();\n110:     Vector v = figClone.getFigs();\n111:     figClone._bigPort = (FigRect) v.elementAt(0);\n112:     figClone._cover = (FigRect) v.elementAt(1);\n113:     figClone._stereo = (FigText) v.elementAt(2);\n114:     figClone._name = (FigText) v.elementAt(3);\n115:     figClone._upperRect = (FigRect) v.elementAt(4);\n116:     figClone._lowerRect = (FigRect) v.elementAt(5);\n117: \n118:     return figClone;\n119:   }\n120:  \n121:   ////////////////////////////////////////////////////////////////\n122:   // acessors\n123: \n124:   public void setLineColor(Color c) {\n125: //     super.setLineColor(c);\n126:      _cover.setLineColor(c);\n127:      _stereo.setFilled(false);\n128:      _stereo.setLineWidth(0);\n129:      _name.setFilled(false);\n130:      _name.setLineWidth(0);\n131:      _upperRect.setLineColor(c);\n132:      _lowerRect.setLineColor(c);\n133:   }\n134: \n135:  \n136:   public Selection makeSelection() {\n137:       return new SelectionComponentInstance(this);\n138:   }\n139: \n140:   public void setOwner(Object node) {\n141:     super.setOwner(node);\n142:     bindPort(node, _bigPort);\n143:   }\n144: \n145:   public Dimension getMinimumSize() {\n146:     Dimension stereoDim = _stereo.getMinimumSize();\n147:     Dimension nameDim = _name.getMinimumSize();\n148:     int h = stereoDim.height + nameDim.height - OVERLAP;\n149:     int w = Math.max(stereoDim.width, nameDim.width);\n150:     return new Dimension(w, h);\n151:   }\n152: \n153:   public void setBounds(int x, int y, int w, int h) {\n154:     if (_name == null) return;\n155: \n156:     Rectangle oldBounds = getBounds();\n157:     _bigPort.setBounds(x, y, w, h);\n158:     _cover.setBounds(x, y, w, h);\n159: \n160:     Dimension stereoDim = _stereo.getMinimumSize();\n161:     Dimension nameDim = _name.getMinimumSize();\n162: \n163:     if (h<50) {\n164:       _upperRect.setBounds(x-10, y+h/6, 20, 10);\n165:       _lowerRect.setBounds(x-10, y+3*h/6, 20, 10); \n166:     }\n167:     else {\n168:       _upperRect.setBounds(x-10, y+13, 20, 10);\n169:       _lowerRect.setBounds(x-10, y+39, 20, 10); \n170:     }\n171: \n172:     _stereo.setBounds(x+1, y+1, w-2, stereoDim.height);\n173:     _name.setBounds(x+1, y + stereoDim.height - OVERLAP + 1, w-2, nameDim.height);\n174:     _x = x; _y = y; _w = w; _h = h;\n175:     firePropChange(\"bounds\", oldBounds, getBounds());\n176:     updateEdges();\n177:   }\n178: \n179:   ////////////////////////////////////////////////////////////////\n180:   // user interaction methods\n181: \n182:   public void mouseClicked(MouseEvent me) {\n183:     super.mouseClicked(me);\n184:     setLineColor(Color.black);\n185:   }\n186: \n187:   public void mousePressed(MouseEvent me) {\n188:     super.mousePressed(me);\n189:     Editor ce = Globals.curEditor();\n190:     Selection sel = ce.getSelectionManager().findSelectionFor(this);\n191:     if (sel instanceof SelectionComponentInstance)\n192:       ((SelectionComponentInstance)sel).hideButtons();\n193:   }\n194: \n195: \n196:   public void setEnclosingFig(Fig encloser) {\n197:     super.setEnclosingFig(encloser);\n198: \n199:     Vector figures = getEnclosedFigs();\n200:     elementOrdering(figures);\n201:     Vector contents = getLayer().getContents();\n202:     int contentsSize = contents.size();\n203:     for (int j=0; j<contentsSize; j++) {\n204:       Object o = contents.elementAt(j);\n205:       if