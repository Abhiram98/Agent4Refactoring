.WindowEvent;\n33: import java.beans.PropertyChangeEvent;\n34: import java.beans.PropertyChangeListener;\n35: import java.util.HashMap;\n36: import java.util.Iterator;\n37: import java.util.Locale;\n38: import java.util.Map;\n39: import java.util.Vector;\n40: \n41: import javax.swing.ImageIcon;\n42: import javax.swing.JFrame;\n43: import javax.swing.JMenuBar;\n44: import javax.swing.JPanel;\n45: \n46: import org.argouml.application.api.Argo;\n47: import org.argouml.application.api.Configuration;\n48: import org.argouml.application.events.ArgoModuleEvent;\n49: import org.argouml.application.helpers.ResourceLoaderWrapper;\n50: import org.argouml.cognitive.Designer;\n51: import org.argouml.cognitive.ui.TabToDo;\n52: import org.argouml.cognitive.ui.ToDoPane;\n53: import org.argouml.i18n.Translator;\n54: import org.argouml.kernel.Project;\n55: import org.argouml.kernel.ProjectManager;\n56: import org.argouml.swingext.BorderSplitPane;\n57: import org.argouml.swingext.Horizontal;\n58: import org.argouml.swingext.Orientation;\n59: import org.argouml.swingext.Vertical;\n60: import org.argouml.ui.menubar.GenericArgoMenuBar;\n61: import org.argouml.ui.targetmanager.TargetEvent;\n62: import org.argouml.ui.targetmanager.TargetListener;\n63: import org.argouml.ui.targetmanager.TargetManager;\n64: import org.argouml.uml.ui.ActionExit;\n65: import org.argouml.uml.ui.TabProps;\n66: import org.tigris.gef.base.Diagram;\n67: import org.tigris.gef.ui.IStatusBar;\n68: import org.tigris.gef.util.VectorSet;\n69: import org.tigris.toolbar.layouts.DockBorderLayout;\n70: \n71: /** The main window of the ArgoUML application.\n72:  *\n73:  * @stereotype singleton\n74:  */\n75: public class ProjectBrowser\n76:     extends JFrame\n77:     implements IStatusBar, PropertyChangeListener, TargetListener {\n78: \n79:     private static final String BUNDLE = \"statusmsg\";\n80: \t\n81:     public static final int DEFAULT_COMPONENTWIDTH = 220;\n82:     public static final int DEFAULT_COMPONENTHEIGHT = 200;\n83: \n84:     ////////////////////////////////////////////////////////////////\n85:     // class variables\n86: \n87:     /**\n88:      * Member attribute to contain the singleton.\n89:      */\n90:     private static ProjectBrowser theInstance;\n91: \n92:     private static boolean _Splash = false;\n93: \n94:     // ----- diagrams\n95: \n96:     ////////////////////////////////////////////////////////////////\n97:     // instance variables\n98: \n99:     protected String pAppName = \"ProjectBrowser\";\n100: \n101:     protected MultiEditorPane _editorPane;\n102: \n103:     /* Work in progress here to allow multiple details panes with \n104:     ** different contents - Bob Tarling\n105:     */\n106:     protected DetailsPane _northEastPane;\n107:     protected DetailsPane _northPane;\n108:     protected DetailsPane _northWestPane;\n109:     protected JPanel _westPane;\n110:     protected DetailsPane _eastPane;\n111:     protected DetailsPane _southEastPane;\n112:     protected JPanel _southWestPane;\n113:     protected DetailsPane _southPane;\n114: \n115:     private Map detailsPanesByCompassPoint = new HashMap();\n116: \n117:     private GenericArgoMenuBar menuBar;\n118: \n119:     /** partially implemented. needs work to display\n120:      * import of source and saving of zargo\n121:      */\n122:     protected StatusBar _statusBar = new StatusBar();\n123: \n124:     /** this needs work so that users can set the font\n125:      * size through a gui preference window\n126:      */\n127:     public Font defaultFont = new Font(\"Dialog\", Font.PLAIN, 10);\n128: \n129:     protected BorderSplitPane _workarea;\n130: \n131:     /**\n132:      * The splash screen shown at startup\n133:      */\n134:     private SplashScreen _splash;\n135: \n136:     /**\n137:      * The navigator pane containing the modelstructure\n138:      */\n139:     private NavigatorPane _navPane;\n140: \n141:     /**\n142:      * The todopane (lower left corner of screen)\n143:      */\n144:     private ToDoPane _todoPane;\n145: \n146:     /**\n147:      * For testing purposes. In tests this constructor can be called so\n148:      * TheInstance is filled.\n149:      */\n150:     private ProjectBrowser() {\n151:         this(\"ArgoUML\", false);\n152:     }\n153: \n154:     private ProjectBrowser(String appName, boolean doSplash) {\n155:         super(appName);\n156:         theInstance = this;\n157:         SplashScreen.setDoSplash(doSplash);\n158:         if (doSplash) {\n159:             _splash = SplashScreen.getInstance();\n160: \t    _splash.getStatusBar().showStatus(\n161: \t            Translator.localize(BUNDLE,\n162: \t\t\t\t   \"statusmsg.bar.making-project-browser\"));\n163:             _splash.getStatusBar().showProgress(10);\n164:             _splash.setVisible(true);\n165:         }\n166: \n167:         menuBar = new GenericArgoMenuBar();\n168: \n169:         _editorPane = new MultiEditorPane();\n170:         getContentPane().setFont(defaultFont);\n171:         getContentPane().setLayout(new BorderLayout());\n172:         this.setJMenuBar(menuBar);\n173:         //getContentPane().add(_menuBar, BorderLayout.NORTH);\n174:         getContentPane().add(createPanels(doSplash), BorderLayout.CENTER);\n175:         getContentPane().add(_statusBar, BorderLayout.SOUTH);\n176: \n177:         setAppName(appName);\n178: \n179:         // allows me to ask \"Do you want to save first?\"\n180:         setDefaultCloseOperation(DO_NOTHING_ON_CLOSE);\n181:         addWindowListener(new WindowCloser());\n182:         ImageIcon argoImage =\n183:             ResourceLoaderWrapper.lookupIconResource(\"ArgoIcon\");\n184:         this.setIconImage(argoImage.getImage());\n185:         // \n186: \n187:         // adds this as listener to projectmanager so it gets updated when the \n188:         // project changes\n189:         ProjectManager.getManager().addPropertyChangeListener(this);\n190:         \n191:         // adds this as listener to TargetManager so gets notified\n192:         // when the active diagram changes\n193:         TargetManager.getInstance().addTargetListener(this);\n194:     }\n195: \n196:     /**\n197:      * @see java.awt.Component#getLocale()\n198:      */\n199:     public Locale getLocale() {\n200:         return Locale.getDefault();\n201:     }\n202: \n203: \n204:     /**\n205:      * Creates the panels in the working area\n206:      * @return Component\n207:      */\n208:     protected Component createPanels(boolean doSplash) {\n209:         if (doSplash) {\n210: \t    _splash.getStatusBar().showStatus(\n211: \t            Translator.localize(BUNDLE, \n212: \t\t\t     \"statusmsg.bar.making-project-browser-explorer\"));\n213:             _splash.getStatusBar().incProgress(5);\n214:         }\n215:         //_navPane = new NavigatorPane(doSplash);\n216:         _navPane = NavigatorPane.getInstance();\n217:         /* Work in progress here to allow multiple details panes with \n218:         ** different contents - Bob Tarling\n219:         */\n220:         _eastPane  =\n221: \t    makeDetailsPane(BorderSplitPane.EAST,  Vertical.getInstance());\n222:         _southPane =\n223: \t    makeDetailsPane(BorderSplitPane.SOUTH, Horizontal.getInstance());\n224:         _southEastPane =\n225: \t    makeDetailsPane(BorderSplitPane.SOUTHEAST,\n226: \t\t\t    Horizontal.getInstance());\n227:         _northWestPane =\n228: \t    makeDetailsPane(BorderSplitPane.NORTHWEST,\n229: \t\t\t    Horizontal.getInstance());\n230:         _northPane =\n231: \t    makeDetailsPane(BorderSplitPane.NORTH, Horizontal.getInstance());\n232:         _northEastPane =\n233: \t    makeDetailsPane(BorderSplitPane.NORTHEAST,\n234: \t\t\t    Horizontal.getInstance());\n235:         \n236:         if (_southPane != null) {\n237:             detailsPanesByCompassPoint.put(BorderSplitPane.SOUTH, _southPane);\n238:         }\n239:         if (_southEastPane != null) {\n240:             detailsPanesByCompassPoint.put(BorderSplitPane.SOUTHEAST,\n241: \t\t\t\t\t   _southEastPane);\n242:         }\n243:         if (_southWestPane != null) {\n244:             detailsPanesByCompassPoint.put(BorderSplitPane.SOUTHWEST,\n245: \t\t\t\t\t   _southWestPane);\n246:         }\n247:         if (_eastPane != null) {\n248:             detailsPanesByCompassPoint.put(BorderSplitPane.EAST, _eastPane);\n249:         }\n250:         if (_westPane != null) {\n251:             detailsPanesByCompassPoint.put(BorderSplitPane.WEST, _westPane);\n252:         }\n253:         if (_northWestPane != null) {\n254:             detailsPanesByCompassPoint.put(BorderSplitPane.NORTHWEST,\n255: \t\t\t\t\t   _northWestPane);\n256:         }\n257:         if (_northPane != null) {\n258:             detailsPanesByCompassPoint.put(BorderSplitPane.NORTH, _northPane);\n259:         }\n260:         if (_northEastPane != null) {\n261:             detailsPanesByCompassPoint.put(BorderSplitPane.NORTHEAST,\n262: \t\t\t\t\t   _northEastPane);\n263:         }\n264:         if (_westPane != null) {\n265:             detailsPanesByCompassPoint.put(BorderSplitPane.WEST, _westPane);\n266:         }\n267:         if (_southWestPane != null) {\n268:             detailsPanesByCompassPoint.put(BorderSplitPane.SOUTHWEST,\n269: \t\t\t\t\t   _southWestPane);\n270:         }\n271: \n272:         // The workarea is all the visible space except the menu,\n273:         // toolbar and status bar.  Workarea is layed out as a\n274:         // BorderSplitPane where the various components that make up\n275:         // the argo application can be positioned.\n276:         _workarea = new BorderSplitPane();\n277:         // create the todopane\n278:         if (doSplash) {\n279: \t    _splash.getStatusBar().showStatus(Translator.localize(\n280: \t\t    \"statusmsg.bar.making-project-browser-to-do-pane\"));\n281:             _splash.getStatusBar().incProgress(5);\n282:         }\n283:         _todoPane = new ToDoPane(doSplash);\n284:         restorePanelSizes();\n285: \n286:         // There are various details panes all of which could hold\n287:         // different tabs pages according to users settings.\n288:         // Place each pane in the required border area.\n289:         Iterator it = detailsPanesByCompassPoint.entrySet().iterator();\n290:         while (it.hasNext()) {\n291:             Map.Entry entry = (Map.Entry) it.next();\n292:             String position = (String) entry.getKey();\n293:             if (entry.getValue() instanceof DetailsPane) {\n294:                 DetailsPane detailsPane = (DetailsPane) entry.getValue();\n295:                 TargetManager.getInstance().addTargetListener(detailsPane);\n296:             }\n297:             _workarea.add((Component) entry.getValue(), position);\n298:         }\n299:         _workarea.add(_navPane, BorderSplitPane.WEST);\n300:         \n301:         getTab(TabToDo.class); // TODO: If this doesn't have side effects, \n302:                                //       it can be removed alltogether.\n303:         //todo.setTree(_todoPane);\n304:         _workarea.add(_todoPane, BorderSplitPane.SOUTHWEST);\n305:         _workarea.add(_editorPane);\n306:         // Toolbar boundry is the area between the menu and the status\n307:         // bar. It contains the workarea at centre and the toolbar\n308:         // position north, south, east or west.\n309:         JPanel toolbarBoundry = new JPanel();\n310:         toolbarBoundry.setLayout(new DockBorderLayout());\n311:         // TODO: - should save and restore the last positions of the toolbars\n312:         toolbarBoundry.add(menuBar.getFileToolbar(), BorderLayout.NORTH);\n313:         toolbarBoundry.add(menuBar.getEditToolbar(), BorderLayout.NORTH);\n314:         toolbarBoundry.add(menuBar.getViewToolbar(), BorderLayout.NORTH);\n315:         toolbarBoundry.add(menuBar.getCreateDiagramToolbar(),\n316: \t\t\t   BorderLayout.NORTH);\n317:         toolbarBoundry.add(_workarea, BorderLayout.CENTER);\n318: \n319:         return toolbarBoundry;\n320:     }\n321: \n322:     /** Set the size of each panel to that last saved in the configuration file\n323:      */\n324:     private void restorePanelSizes() {\n325:         if (_northPane != null) {\n326:             _northPane.setPreferredSize(\n327: \t\t    new Dimension(0,\n328: \t\t\t\t  Configuration.getInteger(\n329: \t\t\t\t\t  Argo.KEY_SCREEN_NORTH_HEIGHT,\n330: \t\t\t\t\t  DEFAULT_COMPONENTHEIGHT)));\n331:         }\n332:         if (_southPane != null) {\n333:             _southPane.setPreferredSize(\n334: \t\t    new Dimension(0,\n335: \t\t\t\t  Configuration.getInteger(\n336: \t\t\t\t\t  Argo.KEY_SCREEN_SOUTH_HEIGHT,\n337: \t\t\t\t\t  DEFAULT_COMPONENTHEIGHT)));\n338:         }\n339:         if (_eastPane != null) {\n340:             _eastPane.setPreferredSize(\n341: \t\t    new Dimension(Configuration.getInteger(\n342: \t\t\t\t\t  Argo.KEY_SCREEN_EAST_WIDTH,\n343: \t\t\t\t\t  DEFAULT_COMPONENTHEIGHT),\n344: \t\t\t\t  0));\n345:         }\n346:         if (_navPane != null) {\n347:             _navPane.setPreferredSize(\n348: \t\t    new Dimension(Configuration.getInteger(\n349: \t\t\t\t\t  Argo.KEY_SCREEN_WEST_WIDTH,\n350: \t\t\t\t\t  DEFAULT_COMPONENTHEIGHT),\n351: \t\t\t\t  0));\n352:         }\n353: \t//        if (_northWestPane != null) {\n354: \t//            _northWestPane.setPreferredSize(new Dimension(\n355: \t//                Configuration.getInteger(\n356: \t// Argo.KEY_SCREEN_NORTHWEST_WIDTH, DEFAULT_COMPONENTWIDTH),\n357: \t//                Configuration.getInteger(\n358: \t// Argo.KEY_SCREEN_NORTH_HEIGHT, DEFAULT_COMPONENTHEIGHT)\n359: \t//            ));\n360: \t//        }\n361: \t//        if (_todoPane != null) {\n362: \t//            _todoPane.setPreferredSize(new Dimension(\n363: \t//                Configuration.getInteger(\n364: \t// Argo.KEY_SCREEN_SOUTHWEST_WIDTH, DEFAULT_COMPONENTWIDTH),\n365: \t//                Configuration.getInteger(\n366: \t// Argo.KEY_SCREEN_SOUTH_HEIGHT, DEFAULT_COMPONENTHEIGHT)\n367: \t//            ));\n368: \t//        }\n369: \t//        if (_northEastPane != null) {\n370: \t//            _northEastPane.setPreferredSize(new Dimension(\n371: \t//                Configuration.getInteger(\n372: \t// Argo.KEY_SCREEN_NORTHEAST_WIDTH, DEFAULT_COMPONENTWIDTH),\n373: \t//                Configuration.getInteger(\n374: \t// Argo.KEY_SCREEN_NORTH_HEIGHT, DEFAULT_COMPONENTHEIGHT)\n375: \t//            ));\n376: \t//        }\n377: \t//        if (_southEastPane != null) {\n378: \t//            _southEastPane.setPreferredSize(new Dimension(\n379: \t//                Configuration.getInteger(\n380: \t// Argo.KEY_SCREEN_SOUTHEAST_WIDTH, DEFAULT_COMPONENTWIDTH),\n381: \t//                Configuration.getInteger(\n382: \t// Argo.KEY_SCREEN_SOUTH_HEIGHT, DEFAULT_COMPONENTHEIGHT)\n383: \t//            ));\n384: \t//        }\n385:     }\n386: \n387:     ////////////////////////////////////////////////////////////////\n388:     // accessors\n389: \n390:     /**\n391:      * @see java.awt.Frame#setTitle(java.lang.String)\n392:      */\n393:     public void setTitle(String title) {\n394:         if (title == null || \"\".equals(title)) {\n395:             setTitle(getAppName());\n396:         } else {\n397:             String changeIndicator = ProjectManager.getManager()\n398:                 .getCurrentProject().getSaveRegistry().hasChanged()\n399:                 ? \" *\" : \"\";\n400:             ArgoDiagram activeDiagram = ProjectManager.getManager()\n401:                 .getCurrentProject().getActiveDiagram();\n402:             if (activeDiagram != null) {\n403:                 super.setTitle(title + \" - \" + activeDiagram.getName()\n404:                     + \" - \" + getAppName() + changeIndicator);\n405:             }\n406:             else {\n407:                 super.setTitle(title + \" - \" + getAppName() + changeIndicator);\n408:             }\n409:         }\n410:     }\n411: \n412:     /**\n413:      * Updates the window title to contain the latest values for \n414:      * project name, active diagram, and save status.\n415:      */\n416:     protected void updateTitle() {\n417:         setTitle(ProjectManager.getManager().getCurrentProject().getName());\n418:     }\n419:     \n420:     public String getAppName() {\n421:         return pAppName;\n422:     }\n423:     public void setAppName(String n) {\n424:         pAppName = n;\n425:     }\n426: \n427:     /**\n428:      * The method used by the NavigatorPane, MultiEditor and DetailsPane\n429:      * to set the target of the application.\n430:      *\n431:      * <p>the target is either a Model Element (usually selected in\n432:      * the Navigation pane or Properties panel) or a Fig (selected in\n433:      * a diagram).\n434:      *\n435:      * <p>The concept of a selection transaction is used to prevent a change\n436:      * of target in one view creating a call back to this method, which \n437:      * would then change the target in all views again...\n438:      * </p>\n439:      * @deprecated As of ArgoUml version 0.13.5,replaced by {@link\n440:      * org.argouml.ui.targetmanager.TargetManager#setTarget(Object)\n441:      * TargetManager.getInstance().setTarget(Object)}\n442:      */\n443:     public void setTarget(Object o) {\n444:         TargetManager.getInstance().setTarget(o);\n445:     }\n446: \n447:     /** \n448:      * return the current target in the editor pane\n449:      * @deprecated As of ArgoUml version 0.13.5,replaced by {@link\n450:      * org.argouml.ui.targetmanager.TargetManager#getTarget()\n451:      * TargetManager.getInstance().getTarget()}\n452:      */\n453:     \n454:     public Object getTarget() {\n455:         return TargetManager.getInstance().getTarget();\n456:     }\n457: \n458:     /**\n459:      * Select the tab page containing the todo item\n460:      *\n461:      * TODO: should introduce an instance variable to go straight to\n462:      * the correct tab instead of trying all\n463:      */\n464:     public void setToDoItem(Object o) {\n465:         Iterator it = detailsPanesByCompassPoint.values().iterator();\n466:         while (it.hasNext()) {\n467:             DetailsPane detailsPane = (DetailsPane) it.next();\n468:             if (detailsPane.setToDoItem(o))\n469:                 return;\n470:         }\n471:     }\n472: \n473:     /**\n474:      * Get the tab page containing the properties\n475:      * @return the TabProps tabpage\n476:      */\n477:     public TabProps getTabProps() {\n478:         // In theory there can be multiple details pane (work in\n479:         // progress). It must first be determined which details\n480:         // page contains the properties tab. Bob Tarling 7 Dec 2002\n481:         Iterator it = detailsPanesByCompassPoint.values().iterator();\n482:         while (it.hasNext()) {\n483:             DetailsPane detailsPane = (DetailsPane) it.next();\n484:             TabProps tabProps = detailsPane.getTabProps();\n485:             if (tabProps != null) {\n486:                 return tabProps;\n487:             }\n488:         }\n489:         throw new IllegalStateException(\"No properties tab found\");\n490:     }\n491: \n492:     /**\n493:      * Get the tab page instance of the given class\n494:      * @return the tabpage\n495:      */\n496:     public TabSpawnable getTab(Class tabClass) {\n497:         // In theory there can be multiple details pane (work in\n498:         // progress). It must first be determined which details\n499:         // page contains the properties tab. Bob Tarling 7 Dec 2002\n500:         Iterator it = detailsPanesByCompassPoint.values().iterator();\n501:         while (it.hasNext()) {\n502:             DetailsPane detailsPane = (DetailsPane) it.next();\n503:             TabSpawnable tab = detailsPane.getTab(tabClass);\n504:             if (tab != null) {\n505:                 return tab;\n506:             }\n507:         }\n508:         throw new IllegalStateException(\"No \" + tabClass.getName()\n509: \t\t\t\t\t+ \" tab found\");\n510:     }\n511: \n512:     public StatusBar getStatusBar() {\n513:         return _statusBar;\n514:     }\n515: \n516:     /**\n517:      * @see javax.swing.JFrame#getJMenuBar()\n518:      */\n519:     public JMenuBar getJMenuBar() {\n520:         return menuBar;\n521:     }\n522: \n523:     public MultiEditorPane getEditorPane() {\n524:         return _editorPane;\n525:     }\n526: \n527:     /**\n528:      * Find the tabpage with the given label and make it the front tab\n529:      *\n530:      * @param tabName The tabpage label\n531:      */\n532:     public void selectTabNamed(String tabName) {\n533:         Iterator it = detailsPanesByCompassPoint.values().iterator();\n534:         while (it.hasNext()) {\n535:             DetailsPane detailsPane = (DetailsPane) it.next();\n536:             if (detailsPane.selectTabNamed(Translator.localize(\"UMLMenu\",\n537: \t\t\t\t\t\t\t       tabName))) {\n538:                 return;\n539:             }\n540:         }\n541:         throw new IllegalArgumentException(\"No such tab named \" + tabName);\n542:     }\n543: \n544:     /**\n545:      * Find the tabpage with the given label\n546:      *\n547:      * @param tabName The tabpage label\n548:      * @return the tabpage\n549:      */\n550:     public JPanel getNamedTab(String tabName) {\n551:         JPanel panel;\n552:         Iterator it = detailsPanesByCompassPoint.values().iterator();\n553:         while (it.hasNext()) {\n554:             DetailsPane detailsPane = (DetailsPane) it.next();\n555:             panel = detailsPane.getNamedTab(tabName);\n556:             if (panel != null) {\n557:                 return panel;\n558:             }\n559:         }\n560:         //TODO: I'd prefer to throw this exception here but doing Argo currently\n561:         //falls over - needs more investigation Bob Tarling 8 Dec 2002\n562:         //throw new IllegalArgumentException(\"No such tab named \" + tabName);\n563:         return null;\n564:     }\n565: \n566:     /** get a list of offenders and display the according diagram, aka\n567:      *  implement a method which jumps to the offender.\n568:      *  TODO: this probably needs a lot of work, as the code looks\n569:      *  as if it can only jump to diagram offenders\n570:      *\n571:      *  @param dms vector of offenders\n572:      *  @see org.argouml.cognitive.ui.ToDoPane\n573:      */\n574:     public void jumpToDiagramShowing(VectorSet dms) {\n575:         if (dms.size() == 0) {\n576:             return;\n577:         }\n578:         Object first = dms.elementAt(0);\n579:         if (first instanceof Diagram && dms.size() > 1) {\n580:             setTarget(first);\n581:             setTarget(dms.elementAt(1));\n582:             return;\n583:         }\n584:         if (first instanceof Diagram && dms.size() == 1) {\n585:             setTarget(first);\n586:             return;\n587:         }\n588:         Vector diagrams =\n589:             ProjectManager.getManager().getCurrentProject().getDiagrams();\n590:         Object target = _editorPane.getTarget();\n591:         if ((target instanceof Diagram)\n592:             && ((Diagram) target).countContained(dms) == dms.size()) {\n593:             setTarget(first);\n594:             return;\n595:         }\n596: \n597:         Diagram bestDiagram = null;\n598:         int bestNumContained = 0;\n599:         for (int i = 0; i < diagrams.size(); i++) {\n600:             Diagram d = (Diagram) diagrams.elementAt(i);\n601:             int nc = d.countContained(dms);\n602:             if (nc > bestNumContained) {\n603:                 bestNumContained = nc;\n604:                 bestDiagram = d;\n605:             }\n606:             if (nc == dms.size())\n607:                 break;\n608:         }\n609:         if (bestDiagram != null) {\n610:             setTarget(bestDiagram);\n611:             setTarget(first);\n612:         }\n613:         // making it possible to jump to the modelroot\n614:         if (first.equals