                    "kwargs": {
                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/diagram/static_structure/ui/FigPackage.java: \n1: // $Id$\n2: // Copyright (c) 1996-2004 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.uml.diagram.static_structure.ui;\n26: \n27: import java.awt.Color;\n28: import java.awt.Dimension;\n29: import java.awt.Rectangle;\n30: import java.awt.event.ActionEvent;\n31: import java.awt.event.MouseEvent;\n32: import java.util.Enumeration;\n33: import java.util.Iterator;\n34: import java.util.Vector;\n35: \n36: import javax.swing.JOptionPane;\n37: \n38: import org.apache.log4j.Logger;\n39: import org.argouml.application.api.Notation;\n40: import org.argouml.kernel.Project;\n41: import org.argouml.kernel.ProjectManager;\n42: import org.argouml.model.ModelFacade;\n43: import org.argouml.ui.ArgoDiagram;\n44: import org.argouml.ui.ArgoJMenu;\n45: import org.argouml.ui.targetmanager.TargetManager;\n46: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n47: import org.argouml.uml.diagram.ui.UMLDiagram;\n48: import org.argouml.uml.diagram.ui.ActionModifier;\n49: import org.argouml.uml.ui.UMLAction;\n50: import org.tigris.gef.graph.GraphModel;\n51: import org.tigris.gef.presentation.FigRect;\n52: import org.tigris.gef.presentation.FigText;\n53: \n54: /** Class to display graphics for a UML package in a class diagram. */\n55: \n56: public class FigPackage extends FigNodeModelElement {\n57:     private static final Logger LOG = Logger.getLogger(FigPackage.class);\n58: \n59:     ////////////////////////////////////////////////////////////////\n60:     // constants\n61: \n62:     private int x = 0;\n63:     private int y = 0;\n64:     private int width = 140;\n65:     private int height = 100;\n66:     private int indentX = 50;\n67:     //private int indentY = 20;\n68:     private int textH = 20;\n69:     \n70:     ////////////////////////////////////////////////////////////////\n71:     // instance variables\n72: \n73:     private FigText body;\n74: \n75:     /**\n76:      * Flags that indicates if the stereotype should be shown even if\n77:      * it is specified or not.\n78:      */\n79:     private boolean showStereotype = true;\n80: \n81:     /**\n82:      * <p>A rectangle to blank out the line that would otherwise appear at the\n83:      *   bottom of the stereotype text box.</p>\n84:      */\n85:     private FigRect stereoLineBlinder;\n86: \n87:     /**\n88:      * The main constructor\n89:      */\n90:     public FigPackage() {\n91:         setBigPort(new FigRect(x, y, width, height, null, null));\n92: \n93:         //\n94:         // Create a Body that reacts to double-clicks and jumps to a diagram.\n95:         //\n96:         body = new FigPackageFigText(x, y + textH, width, height - textH);\n97: \n98:         body.setEditable(false);\n99: \n100:         getNameFig().setBounds(x, y, width - indentX, textH + 2);\n101:         getNameFig().setJustification(FigText.JUSTIFY_LEFT);\n102: \n103:         getBigPort().setFilled(false);\n104:         getBigPort().setLineWidth(0);\n105: \n106:         // Set properties of the stereotype box. Make it 1 pixel higher than\n107:         // before, so it overlaps the name box, and the blanking takes out both\n108:         // lines. Initially not set to be displayed, but this will be changed\n109:         // when we try to render it, if we find we have a stereotype.\n110: \n111:         getStereotypeFigText().setExpandOnly(true);\n112:         getStereotypeFig().setFilled(true);\n113:         getStereotypeFig().setLineWidth(1);\n114:         getStereotypeFigText().setEditable(false);\n115:         getStereotypeFig().setHeight(STEREOHEIGHT + 1);\n116:         getStereotypeFig().setVisible(false);\n117: \n118:         // A thin rectangle to overlap the boundary line between stereotype\n119:         // and name. This is just 2 pixels high, and we rely on the line\n120:         // thickness, so the rectangle does not need to be filled. Whether to\n121:         // display is linked to whether to display the stereotype.\n122: \n123:         stereoLineBlinder =\n124:             new FigRect(11, 10 + STEREOHEIGHT, 58, 2, Color.white, Color.white);\n125:         stereoLineBlinder.setLineWidth(1);\n126:         stereoLineBlinder.setVisible(false);\n127: \n128:         // Mark this as newly created. This is to get round the problem with\n129:         // creating figs for loaded classes that had stereotypes. They are\n130:         // saved with their dimensions INCLUDING the stereotype, but since we\n131:         // pretend the stereotype is not visible, we add height the first time\n132:         // we render such a class. This is a complete fudge, and really we\n133:         // ought to address how class objects with stereotypes are saved. But\n134:         // that will be hard work.\n135: \n136:         // add Figs to the FigNode in back-to-front order\n137:         addFig(getBigPort());\n138:         addFig(getStereotypeFig());\n139:         addFig(getNameFig());\n140:         addFig(stereoLineBlinder);\n141:         addFig(body);\n142: \n143:         setBlinkPorts(false); //make port invisble unless mouse enters\n144:         Rectangle r = getBounds();\n145:         setBounds(r.x, r.y, r.width, r.height);\n146:         updateEdges();\n147:     }\n148: \n149:     /**\n150:      * Contructor that hooks the fig into the UML element\n151:      * @param gm ignored\n152:      * @param node the UML element\n153:      */\n154:     public FigPackage(GraphModel gm, Object node) {\n155:         this();\n156:         setOwner(node);\n157: \n158:         // If this figure is created for an existing package node in the\n159:         // metamodel, set the figure's name according to this node. This is\n160:         // used when the user click's on 'add to diagram' in the navpane.\n161:         // Don't know if this should rather be done in one of the super\n162:         // classes, since similar code is used in FigClass.java etc.\n163:         // Andreas Rueckert <a_rueckert@gmx.net>\n164:         if (ModelFacade.isAPackage(node)\n165: \t        && ModelFacade.getName(node) != null) {\n166:             getNameFig().setText(ModelFacade.getName(node));\n167: \t}\n168:     }\n169: \n170:     /**\n171:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#getH()\n172:      */\n173:     public String placeString() {\n174:         return \"new Package\";\n175:     }\n176: \n177:     /**\n178:      * @see java.lang.Object#clone()\n179:      */\n180:     public Object clone() {\n181:         FigPackage figClone = (FigPackage) super.clone();\n182:         Iterator it = figClone.getFigs(null).iterator();\n183:         figClone.setBigPort((FigRect) it.next());\n184:         figClone.setStereotypeFig((FigText) it.next());\n185:         figClone.setNameFig((FigText) it.next());\n186:         figClone.stereoLineBlinder = (FigRect) it.next();\n187:         figClone.body = (FigText) it.next();\n188:         return figClone;\n189:     }\n190: \n191:     ////////////////////////////////////////////////////////////////\n192:     // Fig accessors\n193: \n194:     /**\n195:      * @see org.tigris.gef.presentation.Fig#setLineColor(java.awt.Color)\n196:      */\n197:     public void setLineColor(Color col) {\n198:         super.setLineColor(col);\n199:         getStereotypeFig().setLineColor(col);\n200:         getNameFig().setLineColor(col);\n201:         body.setLineColor(col);\n202:         stereoLineBlinder.setLineColor(stereoLineBlinder.getFillColor());\n203:     }\n204: \n205:     /**\n206:      * @see org.tigris.gef.presentation.Fig#getLineColor()\n207:      */\n208:     public Color getLineColor() {\n209:         return body.getLineColor();\n210:     }\n211: \n212:     /**\n213:      * @see org.tigris.gef.presentation.Fig#setFillColor(java.awt.Color)\n214:      */\n215:     public void setFillColor(Color col) {\n216:         super.setFillColor(col);\n217:         getStereotypeFig().setFillColor(col);\n218:         getNameFig().setFillColor(col);\n219:         body.setFillColor(col);\n220:         stereoLineBlinder.setLineColor(col);\n221:     }\n222: \n223:     /**\n224:      * @see org.tigris.gef.presentation.Fig#getFillColor()\n225:      */\n226:     public Color getFillColor() {\n227:         return body.getFillColor();\n228:     }\n229: \n230:     /**\n231:      * @see org.tigris.gef.presentation.Fig#setFilled