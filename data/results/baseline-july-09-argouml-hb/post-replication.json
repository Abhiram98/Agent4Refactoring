                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/model/NSUMLModelEventPump.java: \n1: // $Id$\n2: // Copyright (c) 2004 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.model;\n26: \n27: import java.beans.PropertyChangeEvent;\n28: import java.beans.PropertyChangeListener;\n29: import java.lang.ref.Reference;\n30: import java.lang.ref.WeakReference;\n31: import java.util.ArrayList;\n32: import java.util.Iterator;\n33: import java.util.List;\n34: import java.util.Map;\n35: import java.util.WeakHashMap;\n36: \n37: import org.apache.log4j.Logger;\n38: import org.argouml.model.uml.UmlModelEventPump;\n39: \n40: import ru.novosoft.uml.MElementEvent;\n41: import ru.novosoft.uml.MElementListener;\n42: \n43: \n44: /**\n45:  * This is the ModelEventPump implementation for NSUML. It relies heavily \n46:  * on the {@link UmlModelEventPump}.<p>\n47:  *\n48:  * The default visibility is to guarantee that it is not seen outside the \n49:  * model component.\n50:  * \n51:  * @author Linus Tolke\n52:  */\n53: class NSUMLModelEventPump \n54: \textends AbstractModelEventPump \n55: \timplements ModelEventPump {\n56: \n57: \n58:     private static final Logger LOG = \n59:         Logger.getLogger(NSUMLModelEventPump.class);\n60:     \n61:     private Map modelEventListeners;\n62:     private Map classEventListeners;\n63:     \n64:     /**\n65:      * Constructor for the NSUMLModelEventPump.<p>\n66:      *\n67:      * The default visibility is to guarantee that it is not seen outside the \n68:      * model component.\n69:      */\n70:     NSUMLModelEventPump() {\n71:         super();\n72:         modelEventListeners = new WeakHashMap();\n73:         classEventListeners = new WeakHashMap();        \n74:     }\n75:     \n76: \n77:     /**\n78:      * @see org.argouml.model.ModelEventPump#addModelEventListener(\n79:      * \t\tjava.beans.PropertyChangeListener, java.lang.Object,\n80:      * \t\tjava.lang.String[])\n81:      */\n82:     public void addModelEventListener(PropertyChangeListener listener, \n83:             \t\t\t      Object modelelement, \n84:             \t\t\t      String[] eventNames) {\n85:         LOG.debug(\"addModelEventListener(\" \n86:                   + listener + \", \" \n87:                   + modelelement + \", \" \n88:                   + eventNames + \")\");\n89: \n90:         register(modelEventListeners,\n91:                  new NSUMLModelEventListener(listener,\n92: \t\t\t\t\t     modelelement, eventNames));\n93:     }\n94: \n95:     /**\n96:      * @param listeners\n97:      * @param relay\n98:      */\n99:     private void register(Map listeners, NSUMLEventListener relay) {\n100:         PropertyChangeListener listener = relay.getListener();\n101:         List list = (List) listeners.get(listener);\n102:         if (list == null) {\n103:             list = new ArrayList();\n104:         }\n105:         list.add(relay);\n106:         listeners.put(listener, list);\n107:     }\n108: \n109: \n110:     /**\n111:      * @see org.argouml.model.ModelEventPump#addModelEventListener(\n112:      * \t\tjava.beans.PropertyChangeListener, java.lang.Object)\n113:      */\n114:     public void addModelEventListener(PropertyChangeListener listener, \n115:             \t\t\t      Object modelelement) {\n116:         LOG.debug(\"addModelEventListener(\" \n117:                   + listener + \", \" \n118:                   + modelelement + \")\");\n119:         register(modelEventListeners, \n120:                  new NSUMLModelEventListener(listener, modelelement));\n121:     }\n122: \n123:     /**\n124:      * @see org.argouml.model.ModelEventPump#removeModelEventListener(\n125:      * \t\tjava.beans.PropertyChangeListener, java.lang.Object, \n126:      * \t\tjava.lang.String[])\n127:      */\n128:     public void removeModelEventListener(PropertyChangeListener listener, \n129:             \t\t\t\t Object modelelement, \n130:             \t\t\t\t String[] eventNames) {\n131:         LOG.debug(\"removeModelEventListener(\" \n132:                   + listener + \", \" \n133:                   + modelelement + \", \" \n134:                   + eventNames + \")\");\n135:         NSUMLEventListener relay = find(modelEventListeners,\n136:                                         listener, modelelement, eventNames);\n137:         if (relay != null) {\n138:             unregister(modelEventListeners, rel