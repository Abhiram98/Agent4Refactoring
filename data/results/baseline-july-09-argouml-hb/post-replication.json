e\n110:         // divider UI and determining the splitter size.\n111:         JSplitPane splitpane;\n112:         if (orientation == HORIZONTAL_SPLIT) {\n113:             splitpane = new JSplitPane(JSplitPane.HORIZONTAL_SPLIT, true);\n114:             splitterSize = Math.max(splitpane.getPreferredSize().width - DIVIDER_PADDING, MIN_SPLITTER_SIZE);\n115:         } else {\n116:             splitpane = new JSplitPane(JSplitPane.VERTICAL_SPLIT, true);\n117:             splitterSize = Math.max(splitpane.getPreferredSize().height - DIVIDER_PADDING, MIN_SPLITTER_SIZE);\n118:         }\n119: \n120:         setLayout(new SerialLayout(orientation.getPerpendicular()));\n121:         setSize(splitterSize, splitterSize);\n122:         setPreferredSize(this.getSize());\n123: \n124:         // Get the BasicSplitPaneDivider if the current look and feel\n125:         // is based on the Basic look and feel. If not, the splitter\n126:         // will still work, but the divider area will appear empty. \n127:         SplitPaneUI ui = splitpane.getUI();\n128:         if (ui instanceof BasicSplitPaneUI)\t{\n129:             _divider = ((BasicSplitPaneUI) ui).createDefaultDivider();\n130:             _divider.setSize(getSize());\n131:         }\n132: \n133:         setCursor(orientation.getCursor());\n134:         \n135:         MyMouseListener myMouseListener = new MyMouseListener();\n136:         addMouseListener(myMouseListener);\n137:         addMouseMotionListener(myMouseListener);       \n138:     }\n139: \n140:     /**\n141:      * Register a component to be resized by this splitter.\n142:      *\n143:      * @parameter side the side of the splitter to place the component being one of the\n144:      *                 constants NORTH, SOUTH, EAST or WEST\n145:      */\n146:     public void registerComponent(int side, Component comp)\n147:     {\n148:         this.sideComponent[side] = comp;\n149:         setVisible(this.sideComponent[WEST] != null && this.sideComponent[EAST] != nul