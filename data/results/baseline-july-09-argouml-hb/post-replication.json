                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/diagram/ui/UMLDiagram.java: \n1: // $Id$\n2: // Copyright (c) 1996-2005 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.uml.diagram.ui;\n26: \n27: import java.awt.Component;\n28: import java.beans.PropertyChangeEvent;\n29: import java.beans.PropertyChangeListener;\n30: import java.beans.PropertyVetoException;\n31: import java.util.Enumeration;\n32: \n33: import javax.swing.Action;\n34: import javax.swing.ButtonModel;\n35: import javax.swing.JToolBar;\n36: \n37: import org.apache.log4j.Logger;\n38: import org.argouml.i18n.Translator;\n39: import org.argouml.kernel.ProjectManager;\n40: import org.argouml.model.Model;\n41: import org.argouml.ui.ArgoDiagram;\n42: import org.argouml.ui.CmdCreateNode;\n43: import org.argouml.ui.CmdSetMode;\n44: import org.argouml.ui.targetmanager.TargetManager;\n45: import org.argouml.uml.UUIDHelper;\n46: import org.argouml.uml.diagram.static_structure.ui.CommentEdge;\n47: import org.tigris.gef.base.ModeBroom;\n48: import org.tigris.gef.base.ModeCreateFigCircle;\n49: import org.tigris.gef.base.ModeCreateFigInk;\n50: import org.tigris.gef.base.ModeCreateFigLine;\n51: import org.tigris.gef.base.ModeCreateFigPoly;\n52: import org.tigris.gef.base.ModeCreateFigRRect;\n53: import org.tigris.gef.base.ModeCreateFigRect;\n54: import org.tigris.gef.base.ModeCreateFigSpline;\n55: import org.tigris.gef.base.ModeCreateFigText;\n56: import org.tigris.gef.base.ModeCreatePolyEdge;\n57: import org.tigris.gef.base.ModeSelect;\n58: import org.tigris.gef.presentation.Fig;\n59: import org.tigris.toolbar.ToolBarFactory;\n60: import org.tigris.toolbar.toolbutton.ToolButton;\n61: \n62: /**\n63:  * This class provides support for writing a UML diagram for argo using\n64:  * the GEF framework. <p>\n65:  * \n66:  * It adds common buttons, a namespace, capability\n67:  * to delete itself when its namespace is deleted, some help\n68:  * with creating a valid diagram name. <p>\n69:  * \n70:  * There are various methods for returning 'structures' of Actions\n71:  * which are used to build toolbars and dropdown buttons within toolbars.\n72:  * These structures are arrays of Objects.\n73:  * An array element is actually either an Action, null or another array.\n74:  * When building a toolbar an Action is used to create a button and null\n75:  * is used to create a spacer in the toolbar.\n76:  * An element containing an array results in a dropdown toolbar button\n77:  * being created which contains all the items in that array. <p>\n78:  * \n79:  * The \"owner\" of the UMLDiagram needs to be set to the one and only \n80:  * UML modelelement of which the diagram depends. \n81:  * E.g. for a class diagram is that its namespace, \n82:  * and for a collaboration diagram is that the Collaboration UML object. \n83:  * Override the getOwner method to return the owner. <p>\n84:  * \n85:  * TODO: MVW: I am not sure of the following: <br>\n86:  * The \"namespace\" of the diagram is e.g. used when creating new elements\n87:  * that are shown on the diagram; they will have their namespace set\n88:  * according this. It is NOT necessarily equal to the \"owner\". <p>\n89:  * \n90:  * MVW: I am sure about the following: <br>\n91:  * The \"namespace\" of the diagram is e.g. used to register a listener \n92:  * to the UML model, to be notified if this element is removed; \n93:  * which will imply that this diagram has to be deleted, too.\n94:  * Hence the namespace of e.g. a collaboration diagram should be the \n95:  * represented classifier or, in case of a represented operation, its owner.\n96:  */\n97: public abstract class UMLDiagram\n98:     extends ArgoDiagram\n99:     implements PropertyChangeListener {\n100: \n101:     private static final Logger LOG = Logger.getLogger(UMLDiagram.class);\n102: \n103:     /**\n104:      * The serial number for new diagrams.\n105:      * Used to create an unique number for the name of the diagram.\n106:      */\n107:     private int diagramSerial = 1;\n108: \n109:     ////////////////////////////////////////////////////////////////\n110:     // actions for toolbar\n111: \n112:     /**\n113:      * Tool to add a comment node.\n114:      */\n115:     private static Action actionComment =\n116: //\tnew RadioAction(new CmdCreateNode(Model.getFacade().COMMENT, \"Note\"));\n117:         new RadioAction(new ActionAddNote());\n118:         \n119:     /**\n120:      * Tool to create an relationship between a comment node and some other node\n121:      * using a polyedge.<p>\n122:      */\n123:     private static Action actionCommentLink = new RadioAction(\n124:         new CmdSetMode(\n125:             ModeCreatePolyEdge.class,\n126:             \"edgeClass\",\n127:             CommentEdge.class,\n128:             \"button.new-commentlink\"));\n129: \n130: \n131:     private static Action actionSelect =\n132:         new CmdSetMode(ModeSelect.class, \"button.select\");\n133: \n134:     private static Action actionBroom =\n135:         new CmdSetMode(ModeBroom.class, \"button.broom\");\n136: \n137:     private static Action actionRectangle =\n138:         new RadioAction(new CmdSetMode(ModeCreateFigRect.class, \"Rectangle\",\n139:         Translator.localize(\"misc.primitive.rectangle\")));\n140: \n141:     private static Action actionRRectangle =\n142:         new RadioAction(new CmdSetMode(ModeCreateFigRRect.class, \"RRect\",\n143:         Translator.localize(\"misc.primitive.rounded-rectangle\")));\n144: \n145:     private static Action actionCircle =\n146:         new RadioAction(new CmdSetMode(ModeCreateFigCircle.class, \"Circle\",\n147:         Translator.localize(\"misc.primitive.circle\")));\n148: \n149:     private static Action actionLine =\n150:         new RadioAction(new CmdSetMode(ModeCreateFigLine.class, \"Line\",\n151:         Translator.localize(\"misc.primitive.line\")));\n152: \n153:     private static Action actionText =\n154:         new RadioAction(new CmdSetMode(ModeCreateFigText.class, \"Text\",\n155:         Translator.localize(\"misc.primitive.text\")));\n156: \n157:     private static Action actionPoly =\n158:         new RadioAction(new CmdSetMode(ModeCreateFigPoly.class, \"Polygon\",\n159:         Translator.localize(\"misc.primitive.polygon\")));\n160: \n161:     private static Action actionSpline =\n162:         new RadioAction(new CmdSetMode(ModeCreateFigSpline.class, \"Spline\",\n163:         Translator.localize(\"misc.primitive.spline\")));\n164: \n165:     private static Action actionInk =\n166:         new RadioAction(new CmdSetMode(ModeCreateFigInk.class, \"Ink\",\n167:         Translator.localize(\"misc.primitive.ink\")));\n168: \n169:     ////////////////////////////////////////////////////////////////\n170:     // instance variables\n171:     private Object namespace;\n172: \n173:     private JToolBar toolBar;\n174: \n175:     ////////////////////////////////////////////////////////////////\n176:     // constructors\n177: \n178:     /**\n179:      * The constructor.\n180:      */\n181:     public UMLDiagram() {\n182:         super();\n183:     }\n184: \n185:     /**\n186:      * @param ns the UML namespace of this diagram\n187:      */\n188:     public UMLDiagram(Object ns) {\n189:         this();\n190: \n191:         if (!Model.getFacade().isANamespace(ns))\n192:             throw new IllegalArgumentException();\n193: \n194:         setNamespace(ns);\n195:     }\n196: \n197:     /**\n198:      * @param name the name of the diagram\n199:      * @param ns the UML namespace of this diagram\n200:      */\n201:     public UMLDiagram(String name, Object ns) {\n202:         this(ns);\n203:         try {\n204:             setName(name);\n205:         } catch (PropertyVetoException pve) {\n206:             LOG.fatal(\"Name not allowed in construction of diagram\");\n207:         }\n208:     }\n209: \n210:     /**\n211:      * @see org.tigris.gef.base.Diagram#initialize(java.lang.Object)\n212:      */\n213:     public void initialize(Object owner) {\n214:         super.initialize(owner);\n215:         /* The following is the default implementation \n216:          * for diagrams of which the owner is a namespace.\n217:          * */\n218:         if (Model.getFacade().isANamespace(owner)) {\n219:             setNamespace(owner);\n220:         }\n221:     }\n222: \n223:     ////////////////////////////////////////////////////////////////\n224:     // accessors\n225: \n226:     /**\n227:      * @return the namespace for the diagram\n228:      */\n229:     public Object getNamespace() {\n230:         return namespace;\n231:     }\n232: \n233:     /**\n234:      * Sets the namespace of the Diagram, and\n235:      * adds the diagram as a listener of its namespace in the UML model\n236:      * (so that it can delete itself when the model element is deleted).\n237:      *\n238:      * @param ns the namespace for the diagram\n239:      */\n240:     public void setNamespace(Object ns) {\n241:         if (!Model.getFacade().isANamespace(ns)) {\n242:             LOG.error(\"Not a namespace\");\n243:             LOG.error(ns);\n244:             throw new IllegalArgumentException(\"Given object not a namespace\");\n245:         }\n246:         namespace = ns;\n247:         // add the diagram as a listener to the namspace so\n248:         // that when the namespace is removed the diagram is deleted also.\n249:         /* Listening only to \"remove\" events does not work... */\n250:         Model.getPump().addModelEventListener(this, namespace);\n251:     }\n252: \n253:     /**\n254:      * @see org.tigris.gef.base.Diagram#getClassAndModelID()\n255:      */\n256:     public String getClassAndModelID() {\n257:         String s = super.getClassAndModelID();\n258:         if (getOwner() == null)\n259:             return s;\n260:         String id = UUIDHelper.getInstance().getUUID(getOwner());\n261:         return s + \"|\" + id;\n262:     }\n263: \n264:     /**\n265:      * The default implementation for diagrams that \n266:      * have the namespace as their owner.\n267:      * \n268:      * @return the namespace\n269:      */\n270:     public Object getOwner() {\n271:         return getNamespace();\n272:     }\n273: \n274:     static final long serialVersionUID = -401219134410459387L;\n275: \n276:     /**\n277:      * Get the toolbar for the diagram.\n278:      * @return the diagram toolbar\n279:      */\n280:     public JToolBar getJToolBar() {\n281:         if (toolBar == null) {\n282:             initToolBar();\n283:         }\n284:         return toolBar;\n285:     }\n286: \n287:     /**\n288:      * Create the toolbar based on actions for the specific diagram\n289:      * subclass.\n290:      * @see org.tigris.gef.base.Diagram#initToolBar()\n291:      */\n292:     public void initToolBar() {\n293:         toolBar =\n294: \t    ToolBarFactory.createToolBar(true /*rollover*/,\n295: \t\t\t\t\t getActions(),\n296: \t\t\t\t\t false /*floating*/);\n297:     }\n298: \n299:     /**\n300:      * Return actions available for building toolbar or similar.\n301:      * @return an array of available actions.\n302:      */\n303:     public Object[] getActions() {\n304:         Object[] manipulateActions = getManipulateActions();\n305:         Object[] umlActions = getUmlActions();\n306:         Object[] commentActions = getCommentActions();\n307:         Object[] shapeActions = getShapeActions();\n308: \n309:         Object[] actions =\n310:             new Object[manipulateActions.length\n311:                 + umlActions.length\n312:                 + commentActions.length\n313:                 + shapeActions.length];\n314: \n315:         int posn = 0;\n316:         System.arraycopy(\n317:             manipulateActions,           // source\n318:             0,                           // source position\n319:             actions,                     // destination\n320:             posn,                        // destination position\n321:             manipulateActions.length);   // number of objects to be copied\n322:         posn += manipulateActions.length;\n323: \n324:         System.arraycopy(umlActions, 0, actions, posn, umlActions.length);\n325:         posn += umlActions.length;\n326: \n327:         System.arraycopy(commentActions, 0, actions, posn,\n328:                 commentActions.length);\n329:         posn += commentActions.length;\n330: \n331:         System.arraycopy(shapeActions, 0, actions, posn, shapeActions.length);\n332: \n333:         return actions;\n334:     }\n335: \n336:     /**\n337:      * Implement in the ancestor to get a 'structure' of actions for\n338:      * appending the UML creation tools to the toolbar.\n339:      * @return the actions structure\n340:      */\n341:     protected abstract Object[] getUmlActions();\n342: \n343:     /**\n344:      * Get a 'structure' of actions for appending the manipulation\n345:      * mode tools to the toolbar.\n346:      * @return the actions structure\n347:      */\n348:     private Object[] getManipulateActions() {\n349:         Object[] actions =\n350:         {\n351: \t    new RadioAction(actionSelect),\n352: \t    new RadioAction(actionBroom),\n353: \t    null,\n354: \t};\n355:         return actions;\n356:     }\n357: \n358:     /**\n359:      * Get a 'structure' of actions for appending the comment\n360:      * tools to the toolbar.\n361:      * @return the actions structure\n362:      */\n363:     private Object[] getCommentActions() {\n364:         Object[] actions =\n365:         {\n366:             null,\n367:             actionComment,\n368:             actionCommentLink,\n369:         };\n370:         return actions;\n371:     }\n372: \n373:     /**\n374:      * Get a 'structure' of actions for appending primitive drawing\n375:      * tools to the toolbar.\n376:      * @return the actions structure\n377:      */\n378:     private Object[] getShapeActions() {\n379:         Object[] actions = {\n380: \t    null,\n381:             getShapePopupActions(),\n382: \t};\n383:         return actions;\n384:     }\n385: \n386:     /**\n387:      * Get a 'structure' of actions for showing in the shape\n388:      * primitives popup tool button.\n389:      * @return the actions structure\n390:      */\n391:     private Object[] getShapePopupActions() {\n392:         Object[][] actions = {\n393: \t    {actionRectangle, actionRRectangle },\n394: \t    {actionCircle,    actionLine },\n395:             {actionText,      actionPoly },\n396:             {actionSpline,    actionInk },\n397:         };\n398: \n399:         return actions;\n400:     }\n401: \n402:     /**\n403:      * This diagram listens to events from its namespace ModelElement;\n404:      * when the modelelement is removed, we also want to delete this\n405:      * diagram.  <p>\n406:      *\n407:      * There is also a risk that if this diagram was the one shown in\n408:      * the diagram panel, then it will remain after it has been\n409:      * deleted. So we need to deselect this diagram.\n410:      *\n411:      * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n412:      */\n413:     public void propertyChange(PropertyChangeEvent evt) {\n414:         if ((evt.getSource() == namespace) && ProjectManager.getManager()\n415:                 .getCurrentProject().isInTrash(namespace)) {\n416: \n417:             Model.getPump().removeModelEventListener(this, namespace, \"remove\");\n418:             ProjectManager.getManager().getCurrentProject().moveToTrash(this);\n419: \n420:             Object newTarget = ProjectManager.getManager().getCurrentProject()\n421:                 .getDiagrams().get(0);\n422:             TargetManager.getInstance().setTarget(newTarget);\n423:         }\n424:     }\n425: \n426:     /**\n427:      * Removes the UMLDiagram and all the figs on it as listener to\n428:      * UML Events. Is called by setTarget in TabDiagram to improve\n429:      * performance.\n430:      */\n431:     public void removeAsTarget() {\n432:         Enumeration elems = elements();\n433:         while (elems.hasMoreElements()) {\n434:             Object o = elems.nextElement();\n435:             if (o instanceof PropertyChangeListener) {\n436:                 PropertyChangeListener listener = (PropertyChangeListener) o;\n437:                 Object figowner = ((Fig) o).getOwner();\n438:                 Model.getPump().removeModelEventListener(listener, figowner);\n439:             }\n440:         }\n441:         Model.getPump().removeModelEventListener(this, getNamespace());\n442:     }\n443: \n444:     /**\n445:      * Adds the UMLDiagram and all the figs on it as listener to\n446:      * UML Events.  Together with removeAsModelListener this is\n447:      * a performance improvement.\n448:      *\n449:      */\n450:     public void setAsTarget() {\n451:         Enumeration elems = elements();\n452:         while (elems.hasMoreElements()) {\n453:             Fig fig = (Fig) elems.nextElement();\n454:             if (fig instanceof PropertyChangeListener) {\n455:                 Object owner = fig.getOwner();\n456:                 /* pump.addModelEventListener(\n457:                  *      (PropertyChangeListener)fig, owner);\n458:                  * Instead, this will make sure all the correct\n459:                  * event listeners are set:\n460:                  * */\n461:                 fig.setOwner(null);\n462:                 fig.setOwner(owner);\n463:             }\n464:         }\n465:     }\n466: \n467:     /**\n468:      * Set all toolbar buttons to unselected other then the toolbar button\n469:      * with the supplied action.\n470:      *\n471:      * @param otherThanAction the action of the button\n472:      *                        that is NOT to be deselected\n473:      */\n474:     public void deselectOtherTools(Action otherThanAction) {\n475:         //cat.debug(\"Looking for action \" + otherThanAction);\n476:         int toolCount = toolBar.getComponentCount();\n477:         for (int i = 0; i < toolCount; ++i) {\n478:             Component c = toolBar.getComponent(i);\n479:             if (c instanceof ToolButton) {\n480:                 ToolButton tb = (ToolButton) c;\n481:                 Action action = tb.getRealAction();\n482:                 if (action instanceof RadioAction) {\n483:                     action = ((RadioAction) action).getAction();\n484:                 }\n485:                 Action otherAction = otherThanAction;\n486:                 if (otherThanAction instanceof RadioAction) {\n487:                     otherAction = ((RadioAction) otherThanAction).getAction();\n488:                 }\n489:                 if (!action.equals(otherAction)) {\n490:                     //cat.debug(\"Unselecting \" + tb);\n491:                     tb.setSelected(false);\n492:                     ButtonModel bm = tb.getModel();\n493:                     bm.setRollover(false);\n494:                     bm.setSelected(false);\n495:                     bm.setArmed(false);\n496:                     bm.setPressed(false);\n497:                     tb.setBorderPainted(false);\n498:                 } else {\n499:                     //cat.debug(\"Selecting \" + tb);\n500:                     tb.setSelected(true);\n501:                     ButtonModel bm = tb.getModel();\n502:                     bm.setRollover(true);\n503:                     tb.setBorderPainted(true);\n504:                 }\n505:             }\n506:         }\n507:     }\n508: \n509:     /**\n510:      * Set all toolbar buttons to unselected other then the toolbar button\n511:      * with the supplied action.\n512:      */\n513:     public void deselectAllTools() {\n514:         int toolCount = toolBar.getComponentCount();\n515:         for (int i = 0; i < toolCount; ++i) {\n516:             Component c = toolBar.getComponent(i);\n517:             if (c instanceof ToolButton) {\n518:                 ToolButton tb = (ToolButton) c;\n519:                 Action action = tb.getRealAction();\n520:                 if (action instanceof RadioAction) {\n521:                     action = ((RadioAction) action).getAction();\n522:                 }\n523:                 tb.setSelected(false);\n524:                 ButtonModel bm = tb.getModel();\n525:                 bm.setRollover(false);\n526:                 bm.setSelected(false);\n527:                 bm.setArmed(false);\n528:                 bm.setPressed(false);\n529:                 tb.setBorderPainted(false);\n530:             }\n531:         }\n532:     }\n533: \n534:     /**\n535:      * Factory method to build an Action for creating a node in the\n536:      * diagram.\n537:      *\n538:      * @param modelElement identifies the model element type to make\n539:      * @param descr the description to give this action.\n540:      * @return The action to create a new node.\n541:      */\n542:     protected Action makeCreateNodeAction(Object modelElement, String descr) {\n543:         return new RadioAction(new CmdCreateNode(modelElement, descr));\n544:     }\n545: \n546:     /**\n547:      * Factory method to build an Action for creating an edge in the\n548:      * diagram.\n549:      *\n550:      * @param modelElement identifies the model element type to make\n551:      * @param descr the description to give this action.\n552:      * @return The action to create a new node.\n553:      */\n554:     protected Action makeCreateEdgeAction(Object modelElement, String descr) {\n555:         return new RadioAction(\n556:             new CmdSetMode(ModeCreatePolyEdge.class, \"edgeClass\",\n557:             modelElement, descr));\n558:     }\n559: \n560:     /**\n561:      * Factory method to build an Action for creating an association edge in\n562:      * the diagram.\n563:      *\n564:      * @param aggregationKind the type of aggregation for this association\n565:      * @param unidirectional true if this is a one way association.\n566:      * @param descr the description to give this action.\n567:      * @return The action to create a new association.\n568:      */\n569:     protected Action makeCreateAssociationAction(\n570:             Object aggregationKind,\n571:             boolean unidirectional,\n572:             String descr) {\n573: \n574:         return new RadioAction(\n575:             new ActionAddAssociation(aggregationKind, unidirectional, descr));\n576:     }\n