                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/diagram/ui/FigEdgeModelElement.java: \n1: // $Id$\n2: // Copyright (c) 1996-2005 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.uml.diagram.ui;\n26: \n27: import java.awt.Color;\n28: import java.awt.Font;\n29: import java.awt.Graphics;\n30: import java.awt.Point;\n31: import java.awt.Rectangle;\n32: import java.awt.event.KeyEvent;\n33: import java.awt.event.KeyListener;\n34: import java.awt.event.MouseEvent;\n35: import java.awt.event.MouseListener;\n36: import java.beans.PropertyChangeEvent;\n37: import java.beans.PropertyChangeListener;\n38: import java.beans.VetoableChangeListener;\n39: import java.util.Iterator;\n40: import java.util.Vector;\n41: \n42: import javax.swing.Action;\n43: import javax.swing.Icon;\n44: import javax.swing.JSeparator;\n45: import javax.swing.SwingUtilities;\n46: \n47: import org.apache.log4j.Logger;\n48: import org.argouml.application.api.ArgoEventListener;\n49: import org.argouml.application.events.ArgoEventPump;\n50: import org.argouml.application.events.ArgoEventTypes;\n51: import org.argouml.application.events.ArgoNotationEvent;\n52: import org.argouml.application.events.ArgoNotationEventListener;\n53: import org.argouml.cognitive.Designer;\n54: import org.argouml.cognitive.ItemUID;\n55: import org.argouml.cognitive.ToDoItem;\n56: import org.argouml.cognitive.ToDoList;\n57: import org.argouml.i18n.Translator;\n58: import org.argouml.kernel.DelayedChangeNotify;\n59: import org.argouml.kernel.DelayedVChangeListener;\n60: import org.argouml.kernel.ProjectManager;\n61: import org.argouml.model.DeleteInstanceEvent;\n62: import org.argouml.model.DiElement;\n63: import org.argouml.model.Model;\n64: import org.argouml.notation.Notation;\n65: import org.argouml.notation.NotationContext;\n66: import org.argouml.notation.NotationName;\n67: import org.argouml.ui.ActionAutoResize;\n68: import org.argouml.ui.ActionGoToCritique;\n69: import org.argouml.ui.ArgoDiagram;\n70: import org.argouml.ui.ArgoJMenu;\n71: import org.argouml.ui.Clarifier;\n72: import org.argouml.ui.ProjectBrowser;\n73: import org.argouml.ui.cmd.CmdSetPreferredSize;\n74: import org.argouml.ui.targetmanager.TargetManager;\n75: import org.argouml.uml.UUIDHelper;\n76: import org.argouml.uml.diagram.static_structure.ui.CommentEdge;\n77: import org.argouml.uml.ui.ActionDeleteModelElements;\n78: import org.tigris.gef.base.Globals;\n79: import org.tigris.gef.base.Layer;\n80: import org.tigris.gef.base.PathConvPercent;\n81: import org.tigris.gef.base.Selection;\n82: import org.tigris.gef.presentation.Fig;\n83: import org.tigris.gef.presentation.FigEdgePoly;\n84: import org.tigris.gef.presentation.FigNode;\n85: import org.tigris.gef.presentation.FigPoly;\n86: import org.tigris.gef.presentation.FigText;\n87: \n88: /**\n89:  * Abstract class to display diagram lines (edges) for UML ModelElements that\n90:  * look like lines and that have editable names.\n91:  */\n92: public abstract class FigEdgeModelElement\n93:     extends FigEdgePoly\n94:     implements\n95:         VetoableChangeListener,\n96:         DelayedVChangeListener,\n97:         MouseListener,\n98:         KeyListener,\n99:         PropertyChangeListener,\n100:         NotationContext,\n101:         ArgoNotationEventListener {\n102: \n103:     private static final Logger LOG =\n104:         Logger.getLogger(FigEdgeModelElement.class);\n105: \n106:     private DiElement diElement = null;\n107: \n108:     /**\n109:      * Set the removeFromDiagram to false if this edge may not\n110:      * be removed from the diagram.\n111:      */\n112:     private boolean removeFromDiagram = true;\n113: \n114:     ////////////////////////////////////////////////////////////////\n115:     // constants\n116: \n117:     private static final Font LABEL_FONT;\n118:     private static final Font ITALIC_LABEL_FONT;\n119: \n120:     static {\n121:         LABEL_FONT = new Font(\"Dialog\", Font.PLAIN, 10);\n122:         ITALIC_LABEL_FONT =\n123:             new Font(LABEL_FONT.getFamily(), Font.ITALIC, LABEL_FONT.getSize());\n124:     }\n125: \n126:     /**\n127:      * Offset from the end of the set of popup actions at which new items\n128:      * should be inserted by concrete figures.\n129:     **/\n130:     private static int popupAddOffset;\n131: \n132:     ////////////////////////////////////////////////////////////////\n133:     // instance variables\n134: \n135:     /**\n136:      * The Fig that displays the name of this model element.\n137:      * Use getNameFig(), no setter should be required.\n138:      */\n139:     private FigText name;\n140: \n141:     /**\n142:      * The Fig that displays the stereotype of this model element.\n143:      * Use getStereotypeFig(), no setter should be required.\n144:      */\n145:     private Fig stereotypeFig;\n146: \n147:     private FigCommentPort commentPort;\n148: \n149:     private ItemUID itemUid;\n150: \n151:     /**\n152:      * The current notation for this fig. The notation is for example\n153:      * UML 1.3 or Java\n154:      */\n155:     private NotationName currentNotationName;\n156: \n157:     ////////////////////////////////////////////////////////////////\n158:     // constructors\n159: \n160:     /** Partially construct a new FigNode.  This method creates the\n161:      *  _name element that holds the name of the model element and adds\n162:      *  itself as a listener. */\n163:     public FigEdgeModelElement() {\n164: \n165:         name = new FigText(10, 30, 90, 20);\n166:         name.setFont(LABEL_FONT);\n167:         name.setTextColor(Color.black);\n168:         name.setTextFilled(false);\n169:         name.setFilled(false);\n170:         name.setLineWidth(0);\n171:         name.setExpandOnly(false);\n172:         name.setReturnAction(FigText.END_EDITING);\n173:         name.setTabAction(FigText.END_EDITING);\n174: \n175:         stereotypeFig = new FigStereotypesCompartment(10, 10, 90, 15);\n176: \n177:         setBetweenNearestPoints(true);\n178:         ArgoEventPump.addListener(ArgoEventTypes.ANY_NOTATION_EVENT, this);\n179:         currentNotationName = Notation.getConfigueredNotation();\n180:     }\n181: \n182:     /**\n183:      * The constructor that hooks the Fig into the UML model element.\n184:      *\n185:      * @param edge the UML element\n186:      */\n187:     public FigEdgeModelElement(Object edge) {\n188:         this();\n189:         setOwner(edge);\n190:         ArgoEventPump.addListener(ArgoEventTypes.ANY_NOTATION_EVENT, this);\n191:     }\n192: \n193:     /**\n194:      * @see java.lang.Object#finalize()\n195:      */\n196:     protected void finalize() {\n197:         ArgoEventPump.removeListener(ArgoEventTypes.ANY_NOTATION_EVENT, this);\n198:     }\n199: \n200:     public void makeCommentPort() {\n201:         if (commentPort == null) {\n202:             commentPort = new FigCommentPort();\n203:             commentPort.setOwner(getOwner());\n204:             commentPort.setVisible(false);\n205:             addPathItem(commentPort,\n206:                     new PathConvPercent(this, 50, 0));\n207:         }\n208:     }\n209: \n210:     public FigCommentPort getCommentPort() {\n211:         return commentPort;\n212:     }\n213: \n214:     ////////////////////////////////////////////////////////////////\n215:     // accessors\n216: \n217:     /**\n218:      * Setter for the UID\n219:      * @param newId the new UID\n220:      */\n221:     public void setItemUID(ItemUID newId) {\n222:         itemUid = newId;\n223:     }\n224: \n225:     /**\n226:      * Getter for the UID\n227:      * @return the UID\n228:      */\n229:     public ItemUID getItemUID() {\n230:         return itemUid;\n231:     }\n232: \n233:     /**\n234:      * @see org.tigris.gef.presentation.Fig#getTipString(java.awt.event.MouseEvent)\n235:      */\n236:     public String getTipString(MouseEvent me) {\n237:         ToDoItem item = hitClarifier(me.getX(), me.getY());\n238:         String tip = \"\";\n239:         if (item != null\n240:             && Globals.curEditor().getSelectionManager().containsFig(this)) {\n241:             tip = item.getHeadline();\n242:         } else if (getOwner() != null && Model.getFacade().isABase(getOwner())) {\n243:             tip = Model.getFacade().getTipString(getOwner());\n244:         } else {\n245:             tip = toString();\n246:         }\n247: \n248:         if (tip != null && tip.length() > 0 && !tip.endsWith(\" \")) {\n249:             tip += \" \";\n250:         }\n251:         return tip;\n252:     }\n253: \n254:     /**\n255:      * @see org.tigris.gef.ui.PopupGenerator#getPopUpActions(java.awt.event.MouseEvent)\n256:      */\n257:     public Vector getPopUpActions(MouseEvent me) {\n258:         Vector popUpActions = super.getPopUpActions(me);\n259:         \n260:         // TODO: Remove this line after 0.20.\n261:         // This is a hack that removes the ordering menu according to issue 3645\n262:         popUpActions.remove(0);\n263: \n264:         // popupAddOffset should be equal to the number of items added here:\n265:         popUpActions.addElement(new JSeparator());\n266:         popupAddOffset = 1;\n267:         if (removeFromDiagram) {\n268:             popUpActions.addElement(\n269:                     ProjectBrowser.getInstance().getRemoveFromDiagramAction());\n270:             popupAddOffset++;\n271:         }\n272:         popUpActions.addElement(new ActionDeleteModelElements());\n273:         popupAddOffset++;\n274: \n275:         /* Check if multiple items are selected: */\n276:         boolean ms = TargetManager.getInstance().getTargets().size() > 1;\n277:         if (!ms) {\n278:             ToDoList list = Designer.theDesigner().getToDoList();\n279:             Vector items =\n280:                 (Vector) list.elementsForOffender(getOwner()).clone();\n281:             if (items != null && items.size() > 0) {\n282:                 ArgoJMenu critiques = new ArgoJMenu(\"menu.popup.critiques\");\n283:                 ToDoItem itemUnderMouse = hitClarifier(me.getX(), me.getY());\n284:                 if (itemUnderMouse != null) {\n285:                     critiques.add(new ActionGoToCritique(itemUnderMouse));\n286:                     critiques.addSeparator();\n287:                 }\n288:                 int size = items.size();\n289:                 for (int i = 0; i < size; i++) {\n290:                     ToDoItem item = (ToDoItem) items.elementAt(i);\n291:                     if (item == itemUnderMouse)\n292:                         continue;\n293:                     critiques.add(new ActionGoToCritique(item));\n294:                 }\n295:                 popUpActions.insertElementAt(new JSeparator(), 0);\n296:                 popUpActions.insertElementAt(critiques, 0);\n297:             }\n298:         }\n299:         // Add stereotypes submenu\n300:         Action[] stereoActions = getApplyStereotypeActions();\n301:         if (stereoActions != null) {\n302:             popUpActions.insertElementAt(new JSeparator(), 0);\n303:             ArgoJMenu stereotypes = new ArgoJMenu(\n304:                     \"menu.popup.apply-stereotypes\");\n305:             for (int i = 0; i < stereoActions.length; ++i) {\n306:                 stereotypes.addCheckItem(stereoActions[i]);\n307:             }\n308:             popUpActions.insertElementAt(stereotypes, 0);\n309:         }\n310:         return popUpActions;\n311:     }\n312:     \n313:     protected Action[] getApplyStereotypeActions() {\n314:         return StereotypeUtility.getApplyStereotypeActions(getOwner());\n315:     }\n316: \n317:     /**\n318:      * distance formula: (x-h)^2 + (y-k)^2 = distance^2\n319:      *\n320:      * @param p1 point\n321:      * @param p2 point\n322:      * @return the square of the distance\n323:      */\n324:     public int getSquaredDistance(Point p1, Point p2) {\n325:         int xSquared = p2.x - p1.x;\n326:         xSquared *= xSquared;\n327:         int ySquared = p2.y - p1.y;\n328:         ySquared *= ySquared;\n329:         return xSquared + ySquared;\n330:     }\n331: \n332:     /**\n333:      * @param g the <code>Graphics</code> object\n334:      */\n335:     public void paintClarifiers(Graphics g) {\n336:         int iconPos = 25, gap = 1, xOff = -4, yOff = -4;\n337:         Point p = new Point();\n338:         ToDoList list = Designer.theDesigner().getToDoList();\n339:         Vector items = list.elementsForOffender(getOwner());\n340:         int size = items.size();\n341:         for (int i = 0; i < size; i++) {\n342:             ToDoItem item = (ToDoItem) items.elementAt(i);\n343:             Icon icon = item.getClarifier();\n344:             if (icon instanceof Clarifier) {\n345:                 ((Clarifier) icon).setFig(this);\n346:                 ((Clarifier) icon).setToDoItem(item);\n347:             }\n348:             if (icon != null) {\n349:                 stuffPointAlongPerimeter(iconPos, p);\n350:                 icon.paintIcon(null, g, p.x + xOff, p.y + yOff);\n351:                 iconPos += icon.getIconWidth() + gap;\n352:             }\n353:         }\n354:         items = list.elementsForOffender(this);\n355:         size = items.size();\n356:         for (int i = 0; i < size; i++) {\n357:             ToDoItem item = (ToDoItem) items.elementAt(i);\n358:             Icon icon = item.getClarifier();\n359:             if (icon instanceof Clarifier) {\n360:                 ((Clarifier) icon).setFig(this);\n361:                 ((Clarifier) icon).setToDoItem(item);\n362:             }\n363:             if (icon != null) {\n364:                 stuffPointAlongPerimeter(iconPos, p);\n365:                 icon.paintIcon(null, g, p.x + xOff, p.y + yOff);\n366:                 iconPos += icon.getIconWidth() + gap;\n367:             }\n368:         }\n369:     }\n370: \n371:     /**\n372:      * The user clicked on the clarifier.\n373:      *\n374:      * @param x the x of the point clicked\n375:      * @param y the y of the point clicked\n376:      * @return the todo item clicked\n377:      */\n378:     public ToDoItem hitClarifier(int x, int y) {\n379:         int iconPos = 25, xOff = -4, yOff = -4;\n380:         Point p = new Point();\n381:         ToDoList list = Designer.theDesigner().getToDoList();\n382:         Vector items = list.elementsForOffender(getOwner());\n383:         int size = items.size();\n384:         for (int i = 0; i < size; i++) {\n385:             ToDoItem item = (ToDoItem) items.elementAt(i);\n386:             Icon icon = item.getClarifier();\n387:             stuffPointAlongPerimeter(iconPos, p);\n388:             int width = icon.getIconWidth();\n389:             int height = icon.getIconHeight();\n390:             if (y >= p.y + yOff\n391:                 && y <= p.y + height + yOff\n392:                 && x >= p.x + xOff\n393:                 && x <= p.x + width + xOff)\n394:                 return item;\n395:             iconPos += width;\n396:         }\n397:         for (int i = 0; i < size; i++) {\n398:             ToDoItem item = (ToDoItem) items.elementAt(i);\n399:             Icon icon = item.getClarifier();\n400:             if (icon instanceof Clarifier) {\n401:                 ((Clarifier) icon).setFig(this);\n402:                 ((Clarifier) icon).setToDoItem(item);\n403:                 if (((Clarifier) icon).hit(x, y))\n404:                     return item;\n405:             }\n406:         }\n407:         items = list.elementsForOffender(this);\n408:         size = items.size();\n409:         for (int i = 0; i < size; i++) {\n410:             ToDoItem item = (ToDoItem) items.elementAt(i);\n411:             Icon icon = item.getClarifier();\n412:             stuffPointAlongPerimeter(iconPos, p);\n413:             int width = icon.getIconWidth();\n414:             int height = icon.getIconHeight();\n415:             if (y >= p.y + yOff\n416:                 && y <= p.y + height + yOff\n417:                 && x >= p.x + xOff\n418:                 && x <= p.x + width + xOff)\n419:                 return item;\n420:             iconPos += width;\n421:         }\n422:         for (int i = 0; i < size; i++) {\n423:             ToDoItem item = (ToDoItem) items.elementAt(i);\n424:             Icon icon = item.getClarifier();\n425:             if (icon instanceof Clarifier) {\n426:                 ((Clarifier) icon).setFig(this);\n427:                 ((Clarifier) icon).setToDoItem(item);\n428:                 if (((Clarifier) icon).hit(x, y))\n429:                     return item;\n430:             }\n431:         }\n432:         return null;\n433:     }\n434: \n435:     /**\n436:      * Returns a {@link SelectionRerouteEdge} object that manages selection\n437:      * and rerouting of the edge.\n438:      *\n439:      * @return the SelectionRerouteEdge.\n440:      */\n441:     public Selection makeSelection() {\n442:         return new SelectionRerouteEdge(this);\n443:     }\n444: \n445:     /**\n446:      * Getter for name, the name Fig\n447:      * @return the nameFig\n448:      */\n449:     public FigText getNameFig() {\n450:         return name;\n451:     }\n452: \n453:     /**\n454:      * Getter for stereo, the stereotype Fig\n455:      * @return the stereo Fig\n456:      */\n457:     public Fig getStereotypeFig() {\n458:         return stereotypeFig;\n459:     }\n460: \n461:     /**\n462:      * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n463:      */\n464:     public void vetoableChange(PropertyChangeEvent pce) {\n465:         Object src = pce.getSource();\n466:         if (src == getOwner()) {\n467:             DelayedChangeNotify delayedNotify =\n468:                 new DelayedChangeNotify(this, pce);\n469:             SwingUtilities.invokeLater(delayedNotify);\n470:         }\n471:     }\n472: \n473:     /**\n474:      * @see org.argouml.kernel.DelayedVChangeListener#delayedVetoableChange(java.beans.PropertyChangeEvent)\n475:      */\n476:     public void delayedVetoableChange(PropertyChangeEvent pce) {\n477:         // update any text, colors, fonts, etc.\n478:         modelChanged(null);\n479:         // update the relative sizes and positions of internel Figs\n480:         Rectangle bbox = getBounds();\n481:         setBounds(bbox.x, bbox.y, bbox.width, bbox.height);\n482:         endTrans();\n483:     }\n484: \n485:     /**\n486:      * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n487:      */\n488:     public void propertyChange(PropertyChangeEvent pve) {\n489:         Object src = pve.getSource();\n490:         String pName = pve.getPropertyName();\n491:         if (pve instanceof DeleteInstanceEvent\n492:                 && pve.getSource() == getOwner()) {\n493:             ProjectManager.getManager().getCurrentProject()\n494:                     .moveToTrash(getOwner());\n495:         } else if (pName.equals(\"editing\")\n496:             && Boolean.FALSE.equals(pve.getNewValue())) {\n497:             LOG.debug(\"finished editing\");\n498:             textEdited((FigText) src);\n499:             calcBounds();\n500:             endTrans();\n501:         } else if (pName.equals(\"editing\")\n502:                 && Boolean.TRUE.equals(pve.getNewValue())) {\n503:             textEditStarted((FigText) src);\n504:         } else {\n505:             super.propertyChange(pve);\n506:         }\n507: \n508:         if (Model.getFacade().isABase(src)) {\n509:             /* If the source of the event is an UML object,\n510:              * then the UML model has been changed.*/\n511:             modelChanged(pve);\n512:         }\n513:         damage();  // TODO: (MVW) Is this required?\n514:         // After all these events? I doubt it...\n515:     }\n516: \n517:     /**\n518:      * This method is called when the user doubleclicked on the text field,\n519:      * and starts editing. Subclasses should overrule this field to e.g.\n520:      * supply help to the user about the used format. <p>\n521:      *\n522:      * It is also possible to alter the text to be edited\n523:      * already here, e.g. by adding the stereotype in front of the name,\n524:      * but that seems not user-friendly.\n525:      *\n526:      * @param ft the FigText that will be edited and contains the start-text\n527:      */\n528:     protected void textEditStarted(FigText ft) {\n529:         if (ft == getNameFig()) {\n530:             showHelp(\"parsing.help.fig-edgemodelelement\");\n531:         }\n532:     }\n533: \n534:     /**\n535:      * Utility function to localize the given string with help text,\n536:      * and show it in the status bar of the ArgoUML window.\n537:      * This function is used in favour of the inline call\n538:      * to enable later improvements; e.g. it would be possible to\n539:      * show a help-balloon. TODO: Work this out.\n540:      * One matter to possibly improve: show multiple lines.\n541:      *\n542:      * @param s the given string to be localized and shown\n543:      */\n544:     protected void showHelp(String s) {\n545:         ProjectBrowser.getInstance().getStatusBar().showStatus(\n546:                 Translator.localize(s));\n547:     }\n548: \n549:     /**\n550:      * This method is called after the user finishes editing a text\n551:      * field that is in the FigEdgeModelElement.  Determine which field\n552:      * and update the model.  This class handles the name, subclasses\n553:      * should override to handle other text elements.\n554:      *\n555:      * @param ft the text Fig that has been edited\n556:      */\n557:     protected void textEdited(FigText ft) {\n558:         if (ft == name) {\n559:             if (getOwner() == null)\n560:                 return;\n561:             Model.getCoreHelper().setName(getOwner(), ft.getText());\n562:         }\n563:     }\n564: \n565:     /**\n566:      * @param f the Fig\n567:      * @return true if editable\n568:      */\n569:     protected boolean canEdit(Fig f) {\n570:         return true;\n571:     }\n572: \n573:     ////////////////////////////////////////////////////////////////\n574:     // event handlers - MouseListener implementation\n575: \n576:     /**\n577:      * @see java.awt.event.MouseListener#mousePressed(java.awt.event.MouseEvent)\n578:      */\n579:     public void mousePressed(MouseEvent me) {\n580:     }\n581: \n582:     /**\n583:      * @see java.awt.event.MouseListener#mouseReleased(java.awt.event.MouseEvent)\n584:      */\n585:     public void mouseReleased(MouseEvent me) {\n586:     }\n587: \n588:     /**\n589:      * @see java.awt.event.MouseListener#mouseEntered(java.awt.event.MouseEvent)\n590:      */\n591:     public void mouseEntered(MouseEvent me) {\n592:     }\n593: \n594:     /**\n595:      * @see java.awt.event.MouseListener#mouseExited(java.awt.event.MouseEvent)\n596:      */\n597:     public void mouseExited(MouseEvent me) {\n598:     }\n599: \n600:     /**\n601:      * If the user double clicks on anu part of this FigNode, pass it\n602:      * down to one of the internal Figs.  This allows the user to\n603:      * initiate direct text editing.\n604:      *\n605:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n606:      */\n607:     public void mouseClicked(MouseEvent me) {\n608:         if (me.isConsumed())\n609:             return;\n610:         if (me.getClickCount() >= 2) {\n611:             Fig f = hitFig(new Rectangle(me.getX() - 2, me.getY() - 2, 4, 4));\n612:             if (f instanceof MouseListener && canEdit(f))\n613: \t\t((MouseListener) f).mouseClicked(me);\n614:         }\n615:         me.consume();\n616:     }\n617: \n618:     /**\n619:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n620:      */\n621:     // TODO: Review - should be keyTyped()??? - Bob\n622:     public void keyPressed(KeyEvent ke) {\n623:         if (ke.isConsumed())\n624:             return;\n625:         if (name != null && canEdit(name))\n626:             name.keyPressed(ke);\n627:     }\n628: \n629:     /**\n630:      * @see java.awt.event.KeyListener#keyReleased(java.awt.event.KeyEvent)\n631:      *\n632:      * Not used, do nothing.\n633:      */\n634:     public void keyReleased(KeyEvent ke) {\n635:     }\n636: \n637:     /**\n638:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n639:      */\n640:     public void keyTyped(KeyEvent ke) {\n641:     }\n642: \n643:     ////////////////////////////////////////////////////////////////\n644:     // internal methods\n645: \n646:     /**\n647:      * This is called after any part of the UML ModelElement has\n648:      * changed. This method automatically updates the name FigText.\n649:      * Subclasses should override and update other parts.<p>\n650:      *\n651:      * @param e the event\n652:      */\n653:     protected void modelChanged(PropertyChangeEvent e) {\n654:         if (e == null\n655:             || (e.getSource() == getOwner()\n656:                     && \"name\".equals(e.getPropertyName()))) {\n657:             updateNameText();\n658:         }\n659:         updateStereotypeText();\n660: \n661:         if (ActionAutoResize.isAutoResizable()) {\n662:             CmdSetPreferredSize cmdSPS =\n663:                 new CmdSetPreferredSize(CmdSetPreferredSize.MINIMUM_SIZE);\n664:             cmdSPS.setFigToResize(this);\n665:             cmdSPS.doIt();\n666:         }\n667:         if (!updateClassifiers()) {\n668:             return;\n669:         }\n670:     }\n671: \n672:     /**\n673:      * generate the notation for the modelelement and stuff it into the text Fig\n674:      */\n675:     protected void updateNameText() {\n676: \n677:         if ((getOwner() == null) || (getOwner() instanceof CommentEdge))\n678:             return;\n679:         String nameStr =\n680: \t    Notation.generate(this, Model.getFacade().getName(getOwner()));\n681:         name.setText(nameStr);\n682:         calcBounds();\n683:         setBounds(getBounds());\n684:     }\n685: \n686:     /**\n687:      * generate the notation for the stereotype and stuff it into the text Fig\n688:      */\n689:     protected void updateStereotypeText() {\n690:         if ((getOwner() == null) || (getOwner() instanceof CommentEdge)) {\n691:             return;\n692:         }\n693:         Object modelElement = getOwner();\n694: