import java.util.HashMap;\n33: import java.util.Iterator;\n34: import java.util.Map;\n35: \n36: import javax.xml.parsers.DocumentBuilder;\n37: import javax.xml.parsers.DocumentBuilderFactory;\n38: import javax.xml.parsers.ParserConfigurationException;\n39: \n40: import org.apache.log4j.Logger;\n41: import org.apache.xml.utils.synthetic.Class;\n42: import org.apache.xpath.operations.String;\n43: import org.argouml.model.Model;\n44: import org.w3c.dom.Document;\n45: import org.w3c.dom.Element;\n46: import org.w3c.dom.NodeList;\n47: import org.xml.sax.SAXException;\n48: \n49: import ru.novosoft.uml.MBase;\n50: import ru.novosoft.uml.MElementEvent;\n51: import ru.novosoft.uml.MElementListener;\n52: import ru.novosoft.uml.MFactoryImpl;\n53: \n54: \n55: /**\n56:  * This class implements an event pump for all modelevents (MEvents\n57:  * with the current NSUML model). Two kinds of listeners can be\n58:  * registred to the pump: listeners to class events and listeners to\n59:  * object events. The pump dispatches all events fired by objects of a\n60:  * certain class to the class listeners (listeners that are registred\n61:  * via addClassModelEventListener). Furthermore, it dispatches all\n62:  * events to listeners that are registered for a certain object if\n63:  * this object fired the original event.<p>\n64:  *\n65:  * This class is part of the NSUML-dependant API of the model component.\n66:  * Use the NSUML-free {@link org.argouml.model.Model#getPump()} and the\n67:  * {@link org.argouml.model.ModelEventPump} interface everywhere except\n68:  * within the NSUML-implementation.\n69:  *\n70:  * Maybe this class should dispatch a thread to handle the incoming\n71:  * event in the future.\n72:  * @since Oct 14, 2002\n73:  * @author jaap.branderhorst@xs4all.nl\n74:  *\n75:  * TODO: Change visibility to package after reflection problem solved.\n76:  */\n77: public final class UmlModelEventPump implements MElementListener {\n78: \n79:     /**\n80:      * The Logger.\n81:      */\n82:     private static final Logger LOG =\n83: \t    Logger.getLogger(UmlModelEventPump.class);\n84: \n85:     /**\n86:      * Indicate wether we pump events to listeners yes or no.\n87:      * There is some fault in the NSUML implementation\n88:      * but where...\n89:      */\n90:     private boolean pumping = true;\n91: \n92:     /**\n93:      * \"remove\".\n94:      */\n95:     public static final String REMOVE = \"remove\";\n96: \n97:     private static UmlModelEventPump theInstance = new UmlModelEventPump();\n98: \n99:     /**\n100:      * The 'map' with the eventlistenerlists per modelelement.\n101:      */\n102:     private EventListenerHashMap listenerMap = new EventListenerHashMap();\n103: \n104:     private ClassListenerHashMap classListenerMap = new ClassListenerHashMap();\n105: \n106:     private EventTreeDefinition definition = new EventTreeDefinition();\n107: \n108:     /**\n109:      * Singleton access method.\n110:      *\n111:      * @return UmlModelEventPump\n112:      */\n113:     public static synchronized UmlModelEventPump getPump() {\n114:         return theInstance;\n115:     }\n116: \n117:     /**\n118:      * Constructor for UmlModelEventPump, initialises the NSUML event policy.\n119:      */\n120:     private UmlModelEventPump() {\n121:         super();\n122:         // Initialize NSUML\n123: \tMFactoryImpl.setEventPolicy(MFactoryImpl.EVENT_POLICY_IMMEDIATE);\n124:     }\n125: \n126:     /**\n127:      * Adds a listener that listens to all modelevents that are named\n128:      * eventNames and that occur to instances of a given\n129:      * modelClass.<p>\n130:      *\n131:      * If you want the listener to be registered for remove events\n132:      * (that is: an instance of the class the listener is listening\n133:      * too is removed), then you have to register for the eventname\n134:      * \"remove\".<p>\n135:      *\n136:      * @param listener is the listener to add.\n137:      * @param metaType is the given model class\n138:      * @param eventNames is a array of strings with event names.\n139:      * @throws IllegalArgumentException if one of the arguments is null or if\n140:      * the modelClass is not a subclass of MBase.\n141:      * @throws IllegalStateException if the listener is allready registred\n142:      */\n143:     public void addClassModelEventListener(MElementListener listener,\n144: \t\t\t\t\t   Object metaType,\n145: \t\t\t\t\t   String[] eventNames) {\n146:         Class modelClass = (Class) metaType;\n147: //      We don't support non-NSUML modeleventlisteners yet,\n148: //      so we return without addition.\n149:         if (!MBase.class.isAssignableFrom(modelClass)) {\n150:             return;\n151:         }\n152:         if (listener == null\n153:             || modelClass == null\n154:             || eventNames == null\n155:             || eventNames.length == 0) {\n156:             throw new IllegalArgumentException(\"Tried to add illegal class\"\n157: \t\t\t\t\t       + \" modeleventlistener to \"\n158: \t\t\t\t\t       + \"possible null class\");\n159:         }\n160:         for (int i = 0; i < eventNames.length; i++) {\n161:             executeAddClassModelEventListener(\n162: \t\t\t\t\t      listener,\n163: \t\t\t\t\t      modelClass,\n164: \t\t\t\t\t      eventNames[i]);\n165:         }\n166:     }\n167: \n168:     /**\n169:      * Convinience method to add a listener that only listens to one specific\n170:      * event.\n171:      *\n172:      * @param listener The listener to add\n173:      * @param metaType The listener should listen to instances of this class\n174:      * @param eventName The name of the event the listener wants to listen\n175:      * too.\n176:      */\n177:     public void addClassModelEventListener(MElementListener listener,\n178: \t\t\t\t\t   Object metaType,\n179: \t\t\t\t\t   String eventName) {\n180:         Class modelClass = (Class) metaType;\n181:         // We don't support non-NSUML modeleventlisteners yet,\n182:         // so we return without addition.\n183: \n184:         if (!MBase.class.isAssignableFrom(modelClass)) {\n185:             return;\n186:         }\n187:         if (listener == null\n188:             || modelClass == null\n189:             || eventName == null\n190:             || eventName.equals(\"\")) {\n191:             throw new IllegalArgumentException();\n192:         }\n193:         executeAddClassModelEventListener(listener, modelClass, eventName);\n194:     }\n195: \n196:     /**\n197:      * Does the actual adding.\n198:      *\n199:      * @param listener The listener to add\n200:      * @param modelClass The listener should listen to instances of this class\n201:      * @param eventName The name of the event the listener wants to listen\n202:      */\n203:     private synchronized void executeAddClassModelEventListener(\n204: \t    MElementListener listener,\n205: \t    Class modelClass,\n206: \t    String eventName) {\n207:         // first register the listener for all elements allready in\n208:         // the model modelClass = formatClass(modelClass);\n209:         Object model = Model.getModelManagementFactory().getRootModel();\n210:         Collection col =\n211:             Model.getModelManagementHelper()\n212: \t        .getAllModelElementsOfKindWithModel(model, modelClass);\n213: \n214:         if (col == Collections.EMPTY_LIST) {\n215:             col = new ArrayList();\n216:         }\n217: \n218:         /*\n219:         if (modelClass.isAssignableFrom(MModel.class)) {\n220:             Object root =\n221:                 ProjectManager.getManager().getCurrentProject().getRoot();\n222:             if (root != null)\n223:                 col.add(root);\n224:         }\n225:         */\n226:         modelClass = formatClass(modelClass);\n227:         EventKey[] keys = definition.getEventTypes(modelClass, eventName);\n228:         Iterator it = col.iterator();\n229:         while (it.hasNext()) {\n230:             MBase base = (MBase) it.next();\n231:             for (int i = 0; i < keys.length; i++) {\n232:                 listenerMap.put(base, keys[i], listener);\n233:             }\n234:         }\n235:         // add the class to the 'interested classes list' so the listener is\n236:         // added on creation of a modelelement\n237:         for (int i = 0; i < keys.length; i++) {\n238:             classListenerMap.put(modelClass, keys[i], listener);\n239:         }\n240:     }\n241:     /**\n242:      * Retrieves the  implementation class belonging to some given class. For\n243:      * example, retrieves ClassImpl.class if the input was Class.class or\n244:      * ClassImpl.class.\n245:      * @param inputClass An interface or implementation class from NSUML\n246:      * @return The implementation class from NSUML\n247:      */\n248:     private Class formatClass(Class inputClass) {\n249:         String name = inputClass.getName();\n250:         if (name.endsWith(\"Impl\")) {\n251:             return inputClass;\n252:         }\n253:         try {\n254:             Class returnClass = Class.forName(name + \"Impl\");\n255:             return returnClass;\n256:         } catch (ClassNotFoundException ignorable) {\n257:             // cannot happen\n258:         }\n259:         return null;\n260: \n261:     }\n262: \n263:     /**\n264:      * Removes a listener that listens to all modelevents fired by instances of\n265:      * modelClass and that have the original name eventNames.\n266:      * @param listener The listener to remove\n267:      * @param metaType The class the listener does not want to listen to\n268:      * instances anymore\n269:      * @param eventNames The eventnames the listener does not want to listen to\n270:      * anymore\n271:      */\n272:     public void removeClassModelEventListener(\n273: \t\t\t\t\t      MElementListener listener,\n274: \t\t\t\t\t      Object metaType,\n275: \t\t\t\t\t      String[] eventNames) {\n276:         Class modelClass = (Class) metaType;\n277:         // we don't support eventlisteners other then NSUML ModelEventListener.\n278:         // to be forward compatible with other ModelEventListeners,\n279:         // we do not throw an exception but\n280:         // simply return.\n281:         if (!MBase.class.isAssignableFrom(modelClass)) {\n282:             // throw new IllegalArgumentException();\n283:             return;\n284:         }\n285:         if (listener == null\n286:             || modelClass == null\n287:             || eventNames == null\n288:             || eventNames.length == 0) {\n289:             throw new IllegalArgumentException(\n290:                     \"Tried to remove invalid listener\");\n291:         }\n292:         for (int i = 0; i < eventNames.length; i++) {\n293:             executeRemoveClassModelEventListener(\n294: \t\t\t\t\t\t listener,\n295: \t\t\t\t\t\t modelClass,\n296: \t\t\t\t\t\t eventNames[i]);\n297:         }\n298:     }\n299: \n300:     /**\n301:      * Convinience method to remove a listener that listens to events named\n302:      * eventName that are fired by instances of modelClass.\n303:      *\n304:      * @param listener The listener to remove\n305:      * @param metaType The class the listener does not want to listen to\n306:      * instances anymore\n307:      * @param eventName The eventname the listener does not want to listen to\n308:      * anymore\n309:      */\n310:     public void removeClassModelEventListener(\n311: \t\t\t\t\t      MElementListener listener,\n312: \t\t\t\t\t      Object metaType,\n313: \t\t\t\t\t      String eventName) {\n314:         Class modelClass = (Class) metaType;\n315:         // we don't support eventlisteners other then NSUML ModelEventListener.\n316:         // to be forward compatible with other ModelEventListeners,\n317:         // we do not throw an exception but\n318:         // simply return.\n319:         if (!MBase.class.isAssignableFrom(modelClass)) {\n320:             // throw new IllegalArgumentException();\n321:             return;\n322:         }\n323:         if (listener == null\n324:             || modelClass == null\n325:             || eventName == null) {\n326:             throw new IllegalArgumentException(\n327:                     \"Tried to remove invalid listener\");\n328:         }\n329:         executeRemoveClassModelEventListener(listener, modelClass, eventName);\n330:     }\n331: \n332:     /**\n333:      * Executes the removal of a listener to a class.\n334:      *\n335:      * @param listener The listener to remove\n336:      * @param modelClass The class the listener does not want to listen to\n337:      * instances anymore\n338:      * @param eventName The eventname the listener does not want to listen to\n339:      * anymore\n340:      */\n341:     private synchronized void executeRemoveClassModelEventListener(\n342: \t    MElementListener listener,\n343: \t    Class modelClass,\n344: \t    String eventName) {\n345:         // remove all registrations of this listener with all instances of\n346:         // modelClass\n347:         //modelClass = formatClass(modelClass);\n348:         Object model = Model.getModelManagementFactory().getRootModel();\n349:         Iterator it =\n350:             Model.getModelManagementHelper()\n351: \t        .getAllModelElementsOfKindWithModel(model, modelClass)\n352: \t            .iterator();\n353:         while (it.hasNext()) {\n354:             MBase base = (MBase) it.next();\n355:             removeModelEventListener(listener, base, eventName);\n356:         }\n357:         // remove the listener from the registry\n358:         EventKey[] keys = definition.getEventTypes(modelClass, eventName);\n359:         for (int i = 0; i < keys.length; i++) {\n360:             classListenerMap.remove(modelClass, keys[i], listener);\n361:         }\n362:     }\n363: \n364:     /**\n365:      * Adds a listener to modelevents that are fired by some given modelelement\n366:      * and that have the name eventNames.<p>\n367:      *\n368:      * If you want the listener to be registred for remove events (that is: the\n369:      * instance the listener is listening too is removed), then you have to\n370:      * register for the eventname \"remove\".\n371:      *\n372:      * @param listener The listener to add\n373:      * @param modelelement The modelelement the listener should be added too\n374:      * @param eventNames The array of eventnames the listener should listen\n375:      *                   to.\n376:      */\n377:     public void addModelEventListener(\n378: \t\t\t\t      Object listener,\n379: \t\t\t\t      Object modelelement,\n380: \t\t\t\t      String[] eventNames) {\n381:         // we just return if the modelelement is not a base.\n382:         // we don't support non-nsuml elements yet.\n383:         if (modelelement == null || !(modelelement instanceof MBase)) {\n384:             return;\n385:         }\n386:         if (listener == null\n387:             || eventNames == null\n388:             || eventNames.length == 0\n389:             || !(listener instanceof MElementListener)\n390:             || !(modelelement instanceof MBase)) {\n391:             throw new IllegalArgumentException(\"Wrong argument types while \"\n392: \t\t\t\t\t       + \"adding a modelelement \"\n393: \t\t\t\t\t       + \"listener\");\n394:         }\n395:         for (int i = 0; i < eventNames.length; i++) {\n396:             EventKey[] keys =\n397:                 definition.getEventTypes(\n398: \t\t\t\t\t  modelelement.getClass(),\n399: \t\t\t\t\t  eventNames[i]);\n400:             for (int j = 0; j < keys.length; j++) {\n401:                 listenerMap.remove(\n402: \t\t\t\t    (MBase) modelelement,\n403: \t\t\t\t    keys[j],\n404: \t\t\t\t    (MElementListener) listener);\n405:                 listenerMap.put(\n406: \t\t\t\t (MBase) modelelement,\n407: \t\t\t\t keys[j],\n408: \t\t\t\t (MElementListener) listener);\n409:             }\n410:         }\n411:     }\n412: \n413:     /**\n414:      * Convenience method to add a listener that only listens to one specific\n415:      * event.<p>\n416:      *\n417:      * @param listener The listener to add.\n418:      * @param modelelement The modelelement the listener should be added to.\n419:      * @param eventName The eventname the listener should listen to.\n420:      */\n421:     public void addModelEventListener(Object listener,\n422: \t\t\t\t      Object modelelement,\n423: \t\t\t\t      String eventName) {\n424: \n425:         // we just return if the modelelement to add is not a NSUML class.\n426:         // we don't support other event listeners yet.\n427:         if (modelelement == null || !(modelelement instanceof MBase)) {\n428:             return;\n429:         }\n430:         if (listener == null\n431:             || !(listener instanceof MElementListener)\n432:             || eventName == null) {\n433:             throw new IllegalArgumentException();\n434:         }\n435:         EventKey[] keys =\n436:             definition.getEventTypes(modelelement.getClass(), eventName);\n437:         for (int i = 0; i < keys.length; i++) {\n438:             listenerMap.remove((MBase) modelelement,\n439: \t\t\t\tkeys[i],\n440: \t\t\t\t(MElementListener) listener);\n441:             listenerMap.put((MBase) modelelement,\n442: \t\t\t     keys[i],\n443: \t\t\t     (MElementListener) listener);\n444:         }\n445:     }\n446: \n447:     /**\n448:      * Adds a listener to all events fired by some modelelement.\n449:      *\n450:      * <em>Note:</em> Due to the fact that ALL events are pumped for\n451:      * some modelelement, this is a rather powerfull method but also\n452:      * one that can hog performance. Use this with care!<p>\n453:      *\n454:      * @param listener is the listener to add\n455:      * @param modelelement is the model element\n456:      */\n457:     public void addModelEventListener(Object listener, Object modelelement) {\n458:         // we just return if the modelelement to add is not a NSUML class.\n459:         // we don't support other event listeners yet.\n460:         if (modelelement == null || !(modelelement instanceof MBase)) {\n461:             return;\n462:         }\n463:         if (listener == null) {\n464:             throw new IllegalArgumentException(\"A listener must be supplied\");\n465:         }\n466:         if (modelelement == null) {\n467:             throw new IllegalArgumentException(\n468:                     \"A model element must be supplied\");\n469:         }\n470:         if (!(listener instanceof MElementListener)) {\n471:             throw new IllegalArgumentException(\n472:                     \"The listener must be an MElementListener - got a \"\n473:                     + listener.getClass().getName());\n474:         }\n475:         EventKey[] keys = definition.getEventTypes(modelelement.getClass());\n476:         for (int i = 0; i < keys.length; i++) {\n477:             listenerMap.remove(\n478: \t\t\t\t(MBase) modelelement,\n479: \t\t\t\tkeys[i],\n480: \t\t\t\t(MElementListener) listener);\n481:             listenerMap.put(\n482: \t\t\t     (MBase) modelelement,\n483: \t\t\t     keys[i],\n484: \t\t\t     (MElementListener) listener);\n485:         }\n486: \n487:     }\n488: \n489:     /**\n490:      * Removes a listener that listens to modelevents with name\n491:      * eventNames that are fired by the given modelelement.<p>\n492:      *\n493:      * @param listener The listener to remove\n494:      * @param handle The modelelement that fires the events the\n495:      * listener is listening to\n496:      * @param eventNames The list of event names the listener is\n497:      * interested in\n498:      */\n499:     public void removeModelEventListener(Object/*MElementListener*/ listener,\n500: \t\t\t\t\t Object handle,\n501: \t\t\t\t\t String[] eventNames) {\n502:         if (handle == null) {\n503:             return;\n504:         }\n505:         // we don't support eventlisteners other then NSUML ModelEventListener.\n506:         // to be forward compatible with other ModelEventListeners,\n507:         // we do not throw an exception but\n508:         // simply return.\n509:         if (!(handle instanceof MBase)) {\n510:             // throw new IllegalArgumentException();\n511:             return;\n512:         }\n513:         MBase modelElement = (MBase) handle;\n514:         if (listener == null\n515:             || !(listener instanceof MElementListener)\n516:             || modelElement == null\n517:             || eventNames == null\n518:             || eventNames.length == 0) {\n519:             throw new IllegalArgumentException();\n520:         }\n521:         for (int i = 0; i < eventNames.length; i++) {\n522:             EventKey[] keys =\n523:                 definition.getEventTypes(\n524: \t\t\t\t\t  modelElement.getClass(),\n525: \t\t\t\t\t  eventNames[i]);\n526:             for (int j = 0; j < keys.length; j++) {\n527:                 listenerMap.remove(modelElement,\n528: \t\t\t\t    keys[j],\n529: \t\t\t\t    (MElementListener) listener);\n530:             }\n531:         }\n532:     }\n533: \n534:     /**\n535:      * Removes a listener that listens to all events fired by the\n536:      * given modelelement.<p>\n537:      *\n538:      * @param listener is the listener\n539:      * @param handle is the model element\n540:      */\n541:     public void removeModelEventListener(Object/*MElementListener*/ listener,\n542: \t\t\t\t\t Object handle) {\n543:         if (handle == null) {\n544:             return;\n545:         }\n546:         // we don't support eventlisteners other then NSUML ModelEventListener.\n547:         // to be forward compatible with other ModelEventListeners,\n548:         // we do not throw an exception but\n549:         // simply return.\n550:         if (!(handle instanceof MBase)) {\n551:             // throw new IllegalArgumentException();\n552:             return;\n553:         }\n554: \n555: \tMBase modelElement = (MBase) handle;\n556:         if (listener == null\n557: \t    || modelElement == null\n558: \t    || !(listener instanceof MElementListener)) {\n559: \n560:             throw new IllegalArgumentException(\"listener is null or \"\n561: \t\t\t\t\t       + \"an illegal type\");\n562: \n563: \t}\n564:         EventKey[] keys = definition.getEventTypes(modelElement.getClass());\n565:         for (int i = 0; i < keys.length; i++) {\n566:             listenerMap.remove(modelElement,\n567: \t\t\t       keys[i],\n568: \t\t\t       (MElementListener) listener);\n569:         }\n570:     }\n571: \n572:     /**\n573:      * Convenience method to remove a listener to some event.<p>\n574:      *\n575:      * @param listener is the listener to remove\n576:      * @param handle is the object\n577:      * @param eventName is the name of the event\n578:      */\n579:     public void removeModelEventListener(Object/*MElementListener*/ listener,\n580: \t\t\t\t\t Object handle,\n581: \t\t\t\t\t String eventName) {\n582:         if (handle == null) {\n583:             return;\n584:         }\n585:         // we don't support eventlisteners other then NSUML ModelEventListener.\n586:         // to be forward compatible with other ModelEventListeners,\n587:         // we do not throw an exception but\n588:         // simply return.\n589:         if (!(handle instanceof MBase)) {\n590:             // throw new IllegalArgumentException();\n591:             return;\n592:         }\n593:         MBase modelElement = (MBase) handle;\n594:         if (listener == null\n595: \t    || modelElement == null\n596: \t    || eventName == null\n597: \t    || !(listener instanceof MElementListener)) {\n598: \n599:             throw new IllegalArgumentException(\"null listener or illegal type\");\n600: \t}\n601:         EventKey[] keys =\n602:             definition.getEventTypes(modelElement.getClass(), eventName);\n603:         for (int j = 0; j < keys.length; j++) {\n604:             listenerMap.remove(modelElement,\n605: \t\t\t\tkeys[j],\n606: \t\t\t\t(MElementListener) listener);\n607:         }\n608: \n609:     }\n610: \n611:     /**\n612:      * Method to remove some element from the listenerObjectMap. Used by\n613:      * delete on UmlFactory to make sure all listeners are removed.\n614:      * @param element\n615:      */\n616:     synchronized void cleanUp(MBase element) {\n617:         listenerMap.remove(element);\n618:     }\n619: \n620:     /**\n621:      * Make all event sources described by the given document\n622:      * available to the UMLModelEventPump. The document must match the\n623:      * pattern given by the following example:\n624:      *\n625:      * <pre>\n626:      * &lt;eventtree&gt;\n627:      *   &lt;source classname=\"classname of a model element\"&gt;\n628:      *     &lt;eventtype name=\"event fired by this model element\"&gt;\n629:      *       &lt;type&gt;1&lt;/type&gt;\n630:      *     &lt;/eventtype&gt;\n631:      *   &lt;/source&gt;\n632:      * &lt;/eventtree&gt;\n633:      * </pre>\n634:      *\n635:      * The classname is fully qualified.<p>\n636:      *\n637:      * The type is one of the numbers defined in {@link\n638:      * MElementEvent}. Each of the elements can be used multiple\n639:      * times.\n640:      *\n641:      * This operation is particularly provided for use by modules\n642:      * which add custom model elements.\n643:      *\n644:      * @param doc the document, the contents of which should be made available.\n645:      *            This must be preparsed.\n646:      */\n647:     public void addEventSourcesFromDocument (Document doc) {\n648:         definition.addSourcesFromDocument(doc);\n649:     }\n650: \n651:     /**\n652:      * Make event types for a single event source available to this\n653:      * UMLModelEventPump.<p>\n654:      *\n655:      * This operation is particularly provided for use by modules which add\n656:      * custom model elements.\n657:      *\n658:      * @param cSource the source class for which to make event types available.\n659:      *\n660:      * @param mpNameMap a map of the event types to add for the source class.\n661:      *                  The keys are Strings indicating the names of events,\n662:      *                  while the values are int[] which contain all the event\n663:      *                  types the indicated event represents. The specific int\n664:      *                  values used can be found in {@link MElementEvent}.\n665:      */\n666:     public void addEventSource (Class cSource, Map mpNameMap) {\n667:         definition.addSource(cSource, mpNameMap);\n668:     }\n669: \n670:     /**\n671:      * @see MElementListener#listRoleItemSet(MElementEvent)\n672:      */\n673:     public void listRoleItemSet(MElementEvent e) {\n674:         MElementListener[] listeners = getListenerList(e);\n675:         for (int i = 0; i < listeners.length; i++) {\n676: \t    try {\n677: \t\tlisteners[i].listRoleItemSet(e);\n678: \t    } catch (Exception re) {\n679: \t\tLOG.error(\"Listener \" + listeners[i]\n680: \t\t\t  + \" threw an unhandled Exception\", re);\n681: \t    }\n682:         }\n683:     }\n684: \n685:     private MElementListener[] getListenerList(MElementEvent e) {\n686:         return listenerMap.getListeners((MBase) e.getSource(),\n687: \t\t\t\t\tnew EventKey(e.getType(),\n688: \t\t\t\t\t\t     e.getName()));\n689:     }\n690: \n691:     /**\n692:      * @see MElementListener#propertySet(MElementEvent)\n693:      */\n694:     public void propertySet(MElementEvent e) {\n695:         if (!pumping) {\n696:             return;\n697:         }\n698:         if (e.getNewValue() == null\n699:             || !(e.getNewValue().equals(e.getOldValue()))) {\n700:             MElementListener[] listeners = getListenerList(e);\n701:             for (int i = 0; i < listeners.length; i++) {\n702: \t\ttry {\n703: \t\t    listeners[i].propertySet(e);\n704: \t\t} catch (Exception re) {\n705: \t\t    LOG.error(\"Listener \" + listeners[i]\n706: \t\t\t      + \" threw an unhandled Exception\", re);\n707: \t\t}\n708:             }\n709:         }\n710:     }\n711: \n712:     /**\n713:      * @see MElementListener#recovered(MElementEvent)\n714:      */\n715:     public void recovered(MElementEvent e) {\n716:         if (!pumping) {\n717:             return;\n718:         }\n719:         MElementListener[] listeners = getListenerList(e);\n720:         for (int i = 0; i < listeners.length; i++) {\n721: \t    try {\n722: \t\tlisteners[i].recovered(e);\n723: \t    } catch (Exception re) {\n724: \t\tLOG.error(\"Listener \" + listeners[i]\n725: \t\t\t  + \" threw an unhandled Exception\", re);\n726: \t    }\n727:         }\n728:     }\n729: \n730:     /**\n731:      * @see MElementListener#removed(MElementEvent)\n732:      */\n733:     public void removed(MElementEvent e) {\n734:         if (!pumping) {\n735:             return;\n736:         }\n737:         MElementListener[] listeners = getListenerList(e);\n738:         for (int i = 0; i < listeners.length; i++) {\n739: \t    try {\n740: \t\tlisteners[i].removed(e);\n741: \t    } catch (Exception re) {\n742: \t\tLOG.error(\"Listener \" + listeners[i]\n743: \t\t\t  + \" threw an unhandled Exception\", re);\n744: \t    }\n745:         }\n746:     }\n747: \n748:     /**\n749:      * @see MElementListener#propertyChange(MElementEvent)\n750:      */\n751:     public void propertyChange(MElementEvent e) {\n752:         if (!pumping) {\n753:             return;\n754:         }\n755:         MElementListener[] listeners = getListenerList(e);\n756:         for (int i = 0; i < listeners.length; i++) {\n757: \t    try {\n758: \t\tlisteners[i].propertyChange(e);\n759: \t    } catch (Exception re) {\n760: \t\tLOG.error(\"Listener \" + listeners[i]\n761: \t\t\t  + \" threw an unhandled Exception\", re);\n762: \t    }\n763:         }\n764:     }\n765: \n766:     /**\n767:      * @see MElementListener#roleRemoved(MElementEvent)\n768:      */\n769:     public void roleRemoved(MElementEvent e) {\n770:         if (!pumping) {\n771:             return;\n772:         }\n773:         MElementListener[] listeners = getListenerList(e);\n774:         for (int i = 0; i < listeners.length; i++) {\n775: \t    try {\n776: \t\tlisteners[i].roleRemoved(e);\n777: \t    } catch (Exception re) {\n778: \t\tLOG.error(\"Listener \" + listeners[i]\n779: \t\t\t  + \" threw an unhandled Exception\", re);\n780: \t    }\n781:         }\n782:     }\n783: \n784:     /**\n785:      * Clears the hashmaps with listeners. This is only needed by the JUnit\n786:      * tests. It's an implementation detail that the visibility is public.\n787:      * THIS METHOD SHOULD NOT BE USED OUTSIDE JUNIT TESTS.\n788:      */\n789:     public void cleanUp() {\n790:         listenerMap = null;\n791:         listenerMap = new EventListenerHashMap();\n792:         classListenerMap = null;\n793:         classListenerMap = new ClassListenerHashMap();\n794:     }\n795: \n796:     ClassListenerHashMap getClassListenerMap() {\n797:         return classListenerMap;\n798:     }\n799: \n800:     EventListenerHashMap getEventListenerMap() {\n801:         return listenerMap;\n802:     }\n803: \n804:     /**\n805:      * changes the NSUML event policy in order to stop udating the ui.\n806:      */\n807:     public void stopPumpingEvents() {\n808:         pumping = false;\n809: \n810:         MFactoryImpl.setEventPolicy(MFactoryImpl.EVENT_POLICY_DISABLED);\n811:     }\n812: \n813:     /**\n814:      * changes the NSUML event policy in order to start udating the ui.\n815:      */\n816:     public void startPumpingEvents() {\n817:         pumping = true;\n818: \n819:         MFactoryImpl.flushEvents();\n820:         MFactoryImpl.setEventPolicy(MFactoryImpl.EVENT_POLICY_IMMEDIATE);\n821:     }\n822: \n823:     /**\n824:      * changes the NSUML event policy to flush model events.\n825:      */\n826:     public void flushModelEvents() {\n827:         MFactoryImpl.flushEvents();\n828:     }\n829: }\n830: \n831: /**\n832:  * Value object class to find the correct eventlistenerlist in the\n833:  * eventhashmap.<p>\n834:  *\n835:  * @author jaap.branderhorst@xs4all.nl\n836:  */\n837: class EventKey {\n838:     private Integer type;\n839:     private String name;\n840: \n841:     static final EventKey EMPTY_KEY = new EventKey(null, null);\n842: \n843:     public EventKey(int t, String n) {\n844:         setType(t);\n845:         setName(n);\n846:     }\n847: \n848:     /**\n849:      * Constructor for the event key.\n850:      *\n851:      * @param t The type.\n852:      * @param n The name.\n853:      */\n854:     public EventKey(Integer t, String n) {\n855:         type = t;\n856:         setName(n);\n857:     }\n858: \n859:     /**\n860:      * @param t The new type to set.\n861:      */\n862:     private void setType(int t) {\n863:         if (t < 0 || t > 10) {\n864:             throw new IllegalArgumentException(\n865:                 \"This is not a legal eventtype: \" + t);\n866:         }\n867:         type = new Integer(t);\n868:     }\n869: \n870:     /**\n871:      * @return The type.\n872:      */\n873:     public Integer getType() {\n874:         return type;\n875:     }\n876: \n877:     /**\n878:      * @param n The new name.\n879:      */\n880:     private void setName(String n) {\n881:         name = n;\n882:     }\n883: \n884:     /**\n885:      * @return The name.\n886:      */\n887:     public String getName() {\n888:         return name;\n889:     }\n890: \n891:     /**\n892:      * @see java.lang.Object#hashCode()\n893:      */\n894:     public int hashCode() {\n895:         int code = 0;\n896:         if (getType() != null) {\n897:             code += getType().hashCode();\n898:         }\n899:         if (getName() != null) {\n900:             code += getName().hashCode();\n901:         }\n902:         return code;\n903:     }\n904: \n905:     /**\n906:      * @see java.lang.Object#equals(java.lang.Object)\n907:      */\n908:     public boolean equals(Object o) {\n909:         if (o instanceof EventKey) {\n910:             EventKey key = (EventKey) o;\n911:             if ((key.getType() == null && getType() == null)\n912:                 || (key.getType() != null\n913: \t\t    && key.getType().equals(getType())\n914: \t\t    && key.getName() != null\n915: \t\t    && key.getName().equals(getName()))) {\n916:                 return true;\n917:             }\n918:         }\n919:         return false;\n920:     }\n921: \n922: }\n923: \n924: /**\n925:  * A wrapped object array that contains triples of eventtype,\n926:  * eventname, interested listener. I used an Object array for this\n927:  * purpose since it performs fast. Copied a lot of the code from\n928:  * javax.swing.EventListenerList.\n929:  * @author jaap.branderhorst@xs4all.nl\n930:  */\n931: class EventListenerList {\n932:     private static final Logger LOG = Logger.getLogger(EventListenerList.class);\n933:     /**\n934:      * A null array to be shared by all empty listener lists.\n935:      */\n936:     private static final Object[] NULL_ARRAY = new Object[0];\n937:     /**\n938:      *  The list of EventKey - Listener pairs. It's visibility is default since\n939:      * it's used in AbstractUmlModelFactory in a performant but quite awkward\n940:      * way from an encapsulation point of view.\n941:      */\n942:     private Object[] listenerList = NULL_ARRAY;\n943: \n944:     /**\n945:      * Returns an array of listeners that are interested in an event\n946:      * that is typed by the given EventKey. If the name is null of the\n947:      * EventKey, all listeners are returned that have the\n948:      * corresponding name filled or null. Same is true for the type.\n949:      *\n950:      * @param key\n951:      * @return An array of listeners that are interested in the event typed by\n952:      * the given EventKey\n953:      */\n954:     public synchronized MElementListener[] getListeners(EventKey key) {\n955:         Object[] lList = listenerList;\n956:         int n = getListenerCount(lList, key);\n957:         MElementListener[] result =\n958:             (MElementListener[]) Array.newInstance(MElementListener.class, n);\n959:         int j = 0;\n960:         // if the event name is not set we should return all listeners\n961:         // interested\n962:         if (key.getType().intValue() == 0) {\n963:             Integer type = key.getType();\n964:             for (int i = lList.length - 3; i >= 0; i -= 3) {\n965:                 if (type.equals(lList[i])) {\n966:                     result[j++] = (MElementListener) lList[i + 2];\n967:                 }\n968:             }\n969:         } else if (key.getName() != null && key.getType() != null) {\n970:             Integer type = key.getType();\n971:             String name = key.getName();\n972:             for (int i = lList.length - 3; i >= 0; i -= 3) {\n973:                 if (name.equals(lList[i + 1]) && type.equals(lList[i])) {\n974:                     result[j++] = (MElementListener) lList[i + 2];\n975:                 }\n976:             }\n977:         } else {\n978:             throw new IllegalArgumentException(\"Illegal eventkey!\");\n979:         }\n980:         return result;\n981:     }\n982: \n983:     /**\n984:      * Registers the given listeners for the event typed by\n985:      * EventKey. If the name is null (of the EventKey), the listener\n986:      * is registred for all events that have a type corresponding to\n987:      * the type in the given key, no matter what the name of the event\n988:      * is. Vice versa for the type.<p>\n989:      *\n990:      * <strong>A listener that has been added twice will get the\n991:      * events for which it registred twice. Be careful with\n992:      * registring listeners!</strong>\n993:      *\n994:      * @param key\n995:      * @param listener\n996:      */\n997:     public synchronized void add(EventKey key, MElementListener listener) {\n998:         if (listener == null || key == null) {\n999:             throw new IllegalArgumentException(\"Null key or null listener\");\n1000:         }\n1001:         // check if there allready is a listener\n1002:         // if (!Arrays.asList(getListeners(key)).contains(listener)) {\n1003: \n1004:         if (listenerList == NULL_ARRAY) {\n1005:             // if this is the first listener added,\n1006:             // initialize the lists\n1007:             listenerList =\n1008:                 new Object[] {\n1009: \t\t    key.getType(), key.getName(), listener,\n1010: \t\t};\n1011:         } else {\n1012:             if (!contains(key, listener)) {\n1013:                 // Otherwise copy the array and add the new listener\n1014:                 int i = listenerList.length;\n1015:                 Object[] tmp = new Object[i + 3];\n1016:                 System.arraycopy(listenerList, 0, tmp, 0, i);\n1017: \n1018:                 tmp[i] = key.getType();\n1019:                 tmp[i + 1] = key.getName();\n1020:                 tmp[i + 2] = listener;\n1021: \n1022:                 listenerList = tmp;\n1023:             }\n1024:         }\n1025:     }\n1026: \n1027:     public boolean contains(EventKey key, MElementListener listener) {\n1028:         if (key == null) {\n1029:             LOG.info(\" KEy null\");\n1030:         }\n1031:         for (int i = listenerList.length - 1; i > 0; i -= 3) {\n1032:             if (listenerList[i] == listener\n1033:                 && ((listenerList[i - 1] == null && key.getName() == null)\n1034:                     || (listenerList[i - 1] != null\n1035:                         && listenerList[i - 1].equals(key.getName()))\n1036:                     && ((listenerList[i - 2] == null && key.getType() == null)\n1037:                         || (listenerList[i - 2] != null\n1038:                             && listenerList[i - 2].equals(key.getType()))))) {\n1039:                 return true;\n1040:             }\n1041:         }\n1042:         return false;\n1043:     }\n1044: \n1045:     /**\n1046:      * Removes a listener from the list.\n1047:      *\n1048:      * @param key\n1049:      * @param listener\n1050:      */\n1051:     public void remove(EventKey key, MElementListener listener) {\n1052:         if (key.getName() != null && key.getType() != null) {\n1053:             for (int i = listenerList.length - 3; i >= 0; i -= 3) {\n1054:                 if (listenerList[i + 2] == listener\n1055:                     && key.getName().equals(listenerList[i + 1])\n1056: \t\t    && key.getType().equals(listenerList[i])) {\n1057:                     removeElement(i);\n1058:                     break;\n1059:                 }\n1060:             }\n1061:         } else if (key.equals(EventKey.EMPTY_KEY)) {\n1062:             for (int i = listenerList.length - 1; i >= 0; i -= 3) {\n1063:                 if (listenerList[i] == listener) {\n1064:                     removeElement(i - 2);\n1065:                 }\n1066:             }\n1067:         } else if (key.getName() != null) {\n1068:             String name = key.getName();\n1069:             for (int i = listenerList.length - 1; i >= 0; i -= 3) {\n1070:                 if (listenerList[i] == listener\n1071:                     && name.equals(listenerList[i - 1])) {\n1072:                     removeElement(i - 2);\n1073:                 }\n1074:             }\n1075:         } else {\n1076:             Integer type = key.getType();\n1077:             for (int i = listenerList.length - 1; i >= 0; i -= 3) {\n1078:                 if (listenerList[i] == listener\n1079:                     && type.equals(listenerList[i - 2])) {\n1080:                     removeElement(i - 2);\n1081:                 }\n1082:             }\n1083:         }\n1084: \n1085:     }\n1086: \n1087:     /**\n1088:      * Does the actual removal of an element at the given index in the list.\n1089:      *\n1090:      * @param index\n1091:      */\n1092:     private synchronized void removeElement(int index) {\n1093:         Object[] tmp = new Object[listenerList.length - 3];\n1094:         // Copy the list up to index\n1095:         System.arraycopy(listenerList, 0, tmp, 0, index);\n1096:         // Copy from two past the index, up to\n1097:         // the end of tmp (which is three elements\n1098:         // shorter than the old list)\n1099:         if (index < tmp.length) {\n1100:             System.arraycopy(listenerList,\n1101: \t\t\t     index + 3,\n1102: \t\t\t     tmp,\n1103: \t\t\t     index,\n1104: \t\t\t     tmp.length - index);\n1105:         }\n1106:         // set the listener array to the new array or null\n1107:         if (tmp.length == 0) {\n1108:             listenerList = NULL_ARRAY;\n1109:         } else {\n1110:             listenerList = tmp;\n1111:         }\n1112:     }\n1113: \n1114:     /**\n1115:      * Returns the number of listeners that are interested in the given key and\n1116:      * exist in the given object array.\n1117:      *\n1118:      * @param list\n1119:      * @param key\n1120:      * @return the count of listeners.\n1121:      */\n1122:     private int getListenerCount(Object[] list, EventKey key) {\n1123:         int count = 0;\n1124:         String name = key.getName();\n1125:         Integer type = key.getType();\n1126:         if (type.intValue() == 0) {\n1127:             for (int i = 0; i < list.length; i += 3) {\n1128:                 if (type.equals(list[i])) {\n1129:                     count++;\n1130:                 }\n1131:             }\n1132:         } else if (name != null && type != null) {\n1133:             for (int i = 0; i < list.length; i += 3) {\n1134:                 if (type.equals(list[i]) && name.equals(list[i + 1])) {\n1135:                     count++;\n1136:                 }\n1137:             }\n1138:         } else {\n1139:             throw new IllegalArgumentException(\"Illegal eventkey!\");\n1140:         }\n1141:         return count;\n1142:     }\n1143: \n1144:     /**\n1145:      * Returns the total number of listeners of the supplied type\n1146:      * for this listener list.\n1147:      *\n1148:      * @param key The type.\n1149:      * @return The number of listeners.\n1150:      */\n1151:     public synchronized int getListenerCount(EventKey key) {\n1152:         return getListenerCount(listenerList, key);\n1153:     }\n1154: \n1155:     /**\n1156:      * Returns the total number of listeners for this listener list.\n1157:      *\n1158:      * @return The number of listeners.\n1159:      */\n1160:     public synchronized int getListenerCount() {\n1161:         return listenerList.length / 3;\n1162:     }\n1163: \n1164:     /**\n1165:      * @param ll The listenerList to set.\n1166:      */\n1167:     void setListenerList(Object[] ll) {\n1168:         this.listenerList = ll;\n1169:     }\n1170: \n1171:     /**\n1172:      * @return Returns the listenerList.\n1173:      */\n1174:     Object[] getListenerList() {\n1175:         return listenerList;\n1176:     }\n1177: \n1178: }\n1179: \n1180: /**\n1181:  * A map containing instances of meta-classes (modelelements) as keys and\n1182:  * EventListenerLists as values. The class is a wrapper around an underlying\n1183:  * java.util.HashMap and provides some custom methods for easy access to the\n1184:  * underlying data structure.\n1185:  *\n1186:  * @author jaap.branderhorst@xs4all.nl\n1187:  */\n1188: class EventListenerHashMap {\n1189: \n1190:     /**\n1191:      * A null array to be shared by all empty listener lists.\n1192:      */\n1193:     private static final MElementListener[] NULL_ARRAY =\n1194:         new MElementListener[0];\n1195: \n1196:     /**\n1197:      * The list of ListenerType - Listener pairs.\n1198:      */\n1199:     private transient Map listenerMap = new HashMap();\n1200: \n1201:     /**\n1202:      * Puts the given listener as listener to the given modelelement\n1203:      * and given eventKey in the map.\n1204:      *\n1205:      * @param element\n1206:      * @param 