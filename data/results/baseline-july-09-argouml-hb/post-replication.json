;\n32: \n33: import javax.swing.Icon;\n34: \n35: import org.apache.log4j.Logger;\n36: import org.argouml.application.api.Configuration;\n37: import org.argouml.application.api.ConfigurationKey;\n38: import org.argouml.application.events.ArgoEventPump;\n39: import org.argouml.application.events.ArgoEventTypes;\n40: import org.argouml.application.events.ArgoNotationEvent;\n41: import org.argouml.language.java.generator.GeneratorJava;\n42: import org.argouml.model.Model;\n43: import org.argouml.uml.generator.GeneratorDisplay;\n44: \n45: /**\n46:  * Provides centralized methods dealing with notation.\n47:  *\n48:  * @stereotype singleton\n49:  * @author Thierry Lach\n50:  * @since 0.9.4\n51:  */\n52: public final class Notation implements PropertyChangeListener {\n53: \n54:     /**\n55:      * Define a static log4j category variable for ArgoUML notation.\n56:      */\n57:     private static final Logger LOG =\n58:         Logger.getLogger(Notation.class);\n59: \n60:     /**\n61:      * The name of the default ArgoUML notation.  This notation is\n62:      * part of ArgoUML core distribution.\n63:      */\n64:     private static NotationName notationArgo =\n65:         GeneratorDisplay.getInstance().getNotation();\n66:     /*\n67:      * Remark:\n68:      * There is also a java-like notation, which is also\n69:      * part of ArgoUML core distribution.\n70:      */\n71: \n72:     /**\n73:      * The configuration key for the preferred notation.\n74:      */\n75:     public static final ConfigurationKey KEY_DEFAULT_NOTATION =\n76:         Configuration.makeKey(\"notation\", \"default\");\n77: \n78:     /**\n79:      * The configuration key that indicates whether to show stereotypes\n80:      * in the navigation panel.\n81:      */\n82:     public static final ConfigurationKey KEY_SHOW_STEREOTYPES =\n83:         Configuration.makeKey(\"notation\", \"navigation\", \"show\", \"stereotypes\");\n84: \n85:     /**\n86:      * The configuration key that indicates whether to use guillemots\n87:      * or greater/lessthan characters in stereotypes.\n88:      */\n89:     public static final ConfigurationKey KEY_USE_GUILLEMOTS =\n90:         Configuration.makeKey(\"notation\", \"guillemots\");\n91: \n92:     /**\n93:      * Indicates if the user only wants to see UML notation.\n94:      */\n95:     public static final ConfigurationKey KEY_UML_NOTATION_ONLY =\n96:         Configuration.makeKey(\"notation\", \"only\", \"uml\");\n97: \n98:     /**\n99:      * Indicates if the user wants to see visibility signs (public,\n100:      * private, protected or # + -).\n101:      */\n102:     public static final ConfigurationKey KEY_SHOW_VISIBILITY =\n103:         Configuration.makeKey(\"notation\", \"show\", \"visibility\");\n104: \n105:     /**\n106:      * Indicates if the user wants to see multiplicity in attributes\n107:      * and classes.\n108:      */\n109:     public static final ConfigurationKey KEY_SHOW_MULTIPLICITY =\n110:         Configuration.makeKey(\"notation\", \"show\", \"multiplicity\");\n111: \n112:     /**\n113:      * Indicates if the user wants to see the initial value.\n114:      */\n115:     public static final ConfigurationKey KEY_SHOW_INITIAL_VALUE =\n116:         Configuration.makeKey(\"notation\", \"show\", \"initialvalue\");\n117: \n118:     /**\n119:      * Indicates if the user wants to see the properties (everything\n120:      * between braces), that is for example the concurrency.\n121:      */\n122:     public static final ConfigurationKey KEY_SHOW_PROPERTIES =\n123:         Configuration.makeKey(\"notation\", \"show\", \"properties\");\n124: \n125:     /**\n126:      * Indicates if the user wants to see the types and parameters\n127:      * of attributes and operations.\n128:      */\n129:     public static final ConfigurationKey KEY_SHOW_TYPES =\n130:         Configuration.makeKey(\"notation\", \"show\", \"types\");\n131: \n132:     /**\n133:      * Default value for the shadow size of classes, interfaces etc.\n134:      */\n135:     public static final ConfigurationKey KEY_DEFAULT_SHADOW_WIDTH =\n136:         Configuration.makeKey(\"notation\", \"default\", \"shadow-width\");\n137: \n138:     /**\n139:      * The instance.\n140:      */\n141:     private static final Notation SINGLETON = new Notation();\n142: \n143: \n144:     /**\n145:      * The constructor.\n146:      */\n147:     private Notation() {\n148:         Configuration.addListener(KEY_USE_GUILLEMOTS, this);\n149:         Configuration.addListener(KEY_DEFAULT_NOTATION, this);\n150:         Configuration.addListener(KEY_UML_NOTATION_ONLY, this);\n151:         Configuration.addListener(KEY_SHOW_TYPES, this);\n152:         Configuration.addListener(KEY_SHOW_MULTIPLICITY, this);\n153:         Configuration.addListener(KEY_SHOW_PROPERTIES, this);\n154:         Configuration.addListener(KEY_SHOW_VISIBILITY, this);\n155:         Configuration.addListener(KEY_SHOW_INITIAL_VALUE, this);\n156:     }\n157: \n158:     /**\n159:      * Remove the notation change listener.\n160:      * <code>finalize</code> should never happen, but play it safe.\n161:      *\n162:      * TODO: Explain why we don't call super.finalize()!\n163:      */\n164:     protected void finalize() {\n165:         Configuration.removeListener(KEY_DEFAULT_NOTATION, this);\n166:         Configuration.removeListener(KEY_USE_GUILLEMOTS, this);\n167:         Configuration.removeListener(KEY_UML_NOTATION_ONLY, this);\n168:         Configuration.removeListener(KEY_SHOW_TYPES, this);\n169:         Configuration.removeListener(KEY_SHOW_MULTIPLICITY, this);\n170:         Configuration.removeListener(KEY_SHOW_PROPERTIES, this);\n171:         Configuration.removeListener(KEY_SHOW_VISIBILITY, this);\n172:         Configuration.removeListener(KEY_SHOW_INITIAL_VALUE, this);\n173:     }\n174: \n175:     private static NotationProvider2 getProvider(NotationName notation) {\n176:         NotationProvider2 np;\n177:         np = NotationProviderFactory.getInstance().getProvider(notation);\n178:         LOG.debug(\"getProvider(\" + notation + \") returns \" + np);\n179:         return np;\n180:     }\n181: \n182:     /**\n183:      * @param n the NotationName that will become default\n184:      */\n185:     public static void setDefaultNotation(NotationName n) {\n186:         LOG.info(\"default notation set to \" + n.getConfigurationValue());\n187:         Configuration.setString(\n188:             KEY_DEFAULT_NOTATION,\n189:             n.getConfigurationValue());\n190:     }\n191: \n192:     /**\n193:      * Convert a String into a NotationName.\n194:      * @param s the String\n195:      * @return the matching Notationname\n196:      */\n197:     public static NotationName findNotation(String s) {\n198:         return NotationNameImpl.findNotation(s);\n199:     }\n200: \n201:     /**\n202:      * Returns the Notation as set in the menu.\n203:      *\n204:      * @return the default NotationName\n205:      */\n206:     public static NotationName getConfigueredNotation() {\n207:         NotationName n =\n208:             NotationNameImpl.findNotation(\n209:                 Configuration.getString(\n210:                     KEY_DEFAULT_NOTATION,\n211:                     notationArgo.getConfigurationValue()));\n212:         // This is needed for the case when the default notation is\n213:         // not loaded at this point.\n214:         if (n == null) {\n215:             n = NotationNameImpl.findNotation(\"UML 1.4\");\n216: \t}\n217:         LOG.debug(\"default notation is \" + n.getConfigurationValue());\n218:         return n;\n219:     }\n220: \n221:     ////////////////////////////////////////////////////////////////\n222:     // class accessors\n223: \n224:     /**\n225:      * General accessor for an extension point.<p>\n226:      *\n227:      * @param notation    Name of the notation to be used.\n228:      *\n229:      * @param ep          The extension point to generate for.\n230:      *\n231:      * @return            The generated text.\n232:      */\n233:     protected static String generateExtensionPoint(\n234:         NotationName notation,\n235:         Object/*MExtensionPoint*/ ep) {\n236:         return getProvider(notation)\n237: \t    .generateExtensionPoint(ep);\n238:     }\n239: \n240:     private static String generateOperation(\n241:         NotationName notation,\n242:         Object/*MOperation*/ op,\n243:         boolean documented) {\n244:         return getProvider(notation).generateOperation(op, documented);\n245:     }\n246: \n247:     private static String generateAttribute(\n248:         NotationName notation,\n249:         Object/*MAttribute*/ attr,\n250:         boolean documented) {\n251:         return getProvider(notation).generateAttribute(attr, documented);\n252:     }\n253: \n254:     private static String generateParameter(\n255:         NotationName notation,\n256:         Object/*MParameter*/ param) {\n257:         return getProvider(notation).generateParameter(param);\n258:     }\n259: \n260:     private static String generateName(NotationName notation, String name) {\n261:         return getProvider(notation).generateName(name);\n262:     }\n263: \n264:     private static String generatePackage(NotationName notation,\n265: \t\t\t\t     Object/*MPackage*/ pkg) {\n266:         return getProvider(notation).generatePackage(pkg);\n267:     }\n268: \n269:     private static String generateExpression(\n270:         NotationName notation,\n271:         Object/*MExpression*/ expr) {\n272:         return getProvider(notation).generateExpression(expr);\n273:     }\n274: \n275:     private static String generateClassifier(\n276:         NotationName notation,\n277:         Object/*MClassifier*/ o) {\n278:         return getProvider(notation).generateClassifier(o);\n279:     }\n280: \n281:     private static String generateStereotype(NotationName notation,\n282: \t\t\t\t\tObject/*MStereotype*/ s) {\n283:         return getProvider(notation).generateStereotype(s);\n284:     }\n285: \n286:     private static String generateTaggedValue(\n287:         NotationName notation,\n288:         Object/*MTaggedValue*/ s) {\n289:         return getProvider(notation).generateTaggedValue(s);\n290:     }\n291: \n292:     private static String generateAssociation(\n293:         NotationName notation,\n294:         Object/*MAssociation*/ a) {\n295:         return getProvider(notation).generateAssociation(a);\n296:     }\n297: \n298:     private static String generateAssociationEnd(\n299:         NotationName notation,\n300:         Object/*MAssociationEnd*/ ae) {\n301:         return getProvider(notation)\n302: \t    .generateAssociationEnd(ae);\n303:     }\n304: \n305:     private static String generateMultiplicity(\n306:         NotationName notation,\n307:         Object/*MMultiplicity*/ m) {\n308:         return getProvider(notation).generateMultiplicity(m);\n309:     }\n310: \n311:     private static String generateState(NotationName notation,\n312: \t\t\t\t\t  Object/*MState*/ m) {\n313:         return getProvider(notation).generateState(m);\n314:     }\n315: \n316:     private static String generateSubmachine(NotationName notation,\n317:                       Object/*MSubmachineState*/ m) {\n318:         return getProvider(notation).generateSubmachine(m);\n319:     }\n320: \n321:     private static String generateObjectFlowState(NotationName notation,\n322:           Object/*MObjectFlowState*/ m) {\n323:         return getProvider(notation).generateObjectFlowState(m);\n324:     }\n325: \n326:     private static String generateClassifierInState(NotationName notation,\n327:             Object/*MObjectFlowState*/ m) {\n328:         Collection c = Model.getFacade().getInStates(m);\n329:         // MVW: I have no idea how to handle multiple states,\n330:         // so we go for the 1st one..\n331:         Iterator i = c.iterator();\n332:         if (i.hasNext()) {\n333:             return getProvider(notation).generateState(i.next());\n334:         }\n335:         return \"\";\n336:     }\n337: \n338:     private static String generateStateBody(NotationName notation,\n339:                                         Object/*MState*/ stt) {\n340:         return getProvider(notation).generateStateBody(stt);\n341:     }\n342: \n343:     private static String generateTransition(NotationName notation,\n344: \t\t\t\t\tObject/*MTransition*/ m) {\n345:         return getProvider(notation).generateTransition(m);\n346:     }\n347: \n348:     private static String generateVisibility(NotationName notation,\n349: \t\t\t\t\tObject /*MVisibilityKind*/ m) {\n350:         return getProvider(notation).generateVisibility(m);\n351:     }\n352: \n353:     private static String generateAction(NotationName notation, Object m) {\n354:         return getProvider(notation).generateAction(m);\n355:     }\n356: \n357:     private static String generateActionState(NotationName notation, Object m) {\n358:         return getProvider(notation).generateActionState(m);\n359:     }\n360: \n361:     private static String generateGuard(NotationName notation,\n362: \t\t\t\t\t  Object/*MGuard*/ m) {\n363:         return getProvider(notation).generateGuard(m);\n364:     }\n365: \n366:     private static String generateMessage(NotationName notation,\n367: \t\t\t\t     Object/*MMessage*/ m) {\n368:         return getProvider(notation).generateMessage(m);\n369:     }\n370: \n371:     private static String generateClassifierRef(\n372:         NotationName notation,\n373:         Object/*MClassifier*/ m) {\n374:         return getProvider(notation).generateClassifierRef(m);\n375:     }\n376: \n377:     private static String generateAssociationRole(\n378:         NotationName notation,\n379:         Object/*MAssociationRole*/ m) {\n380:         return getProvider(notation)\n381: \t    .generateAssociationRole(m);\n382:     }\n383: \n384:     ////////////////////////////////////////////////////////////////\n385:     // static accessors\n386: \n387:     /**\n388:      * @return the singleton\n389:      */\n390:     public static Notation getInstance() {\n391:         return SINGLETON;\n392:     }\n393: \n394:     /**\n395:      * Static accessor for extension point generation. Invokes our protected\n396:      * accessor from the singleton instance with the \"documented\" flag set\n397:      * false.<p>\n398:      *\n399:      * @param ctx  Context used to identify the notation\n400:      *\n401:      * @param ep   The extension point to generate for.\n402:      *\n403:      * @return     The generated text.\n404:      */\n405:     public static String generateExtensionPoint(\n406:         NotationContext ctx,\n407:         Object/*MExtensionPoint*/ ep) {\n408:         return generateExtensionPoint(Notation.getNotation(ctx), ep);\n409:     }\n410: \n411:     /**\n412:      * Static accessor for operation generation.  Invokes our protected\n413:      * accessor from the singleton instance with the \"documented\" flag set\n414:      * false.<p>\n415:      *\n416:      * @param ctx  Context used to identify the notation\n417:      * @param op   The operation to generate for.\n418:      * @return     The generated text.\n419:      */\n420:     public static String generateOperation(\n421:         NotationContext ctx,\n422:         Object/*MOperation*/ op) {\n423:         return generateOperation(Notation.getNotation(ctx), op, false);\n424:     }\n425: \n426:     /**\n427:      * @param ctx  Context used to identify the notation\n428:      * @param op   The operation to generate for.\n429:      * @param documented <code>true</code> if documentation shall be generated.\n430:      * @return     The generated text.\n431:      */\n432:     public static String generateOperation(\n433:         NotationContext ctx,\n434:         Object/*MOperation*/ op,\n435:         boolean documented) {\n436:         return generateOperation(Notation.getNotation(ctx), op, documented);\n437:     }\n438: \n439:     /**\n440:      * @param ctx  Context used to identify the notation\n441:      * @param attr   The attribute to generate for.\n442:      * @return     The generated text.\n443:      */\n444:     public static String generateAttribute(\n445:         NotationContext ctx,\n446:         Object/*MAttribute*/ attr) {\n447:         return generateAttribute(Notation.getNotation(ctx), attr, false);\n448:     }\n449: \n450:     /**\n451:      * @param ctx  Context used to identify the notation\n452:      * @param attr   The attribute to generate for.\n453:      * @param documented <code>true</code> if documentation shall be generated.\n454:      * @return     The generated text.\n455:      */\n456:     public static String generateAttribute(\n457:         NotationContext ctx,\n458:         Object/*MAttribute*/ attr,\n459:         boolean documented) {\n460:         return generateAttribute(Notation.getNotation(ctx), attr, documented);\n461:     }\n462: \n463:     /**\n464:      * @param ctx  Context used to identify the notation\n465:      * @param param   The parameter to generate for.\n466:      * @return     The generated text.\n467:      */\n468:     public static String generateParameter(\n469:         NotationContext ctx,\n470:         Object/*MParameter*/ param) {\n471:         return generateParameter(Notation.getNotation(ctx), param);\n472:     }\n473: \n474:     /**\n475:      * @param ctx  Context used to identify the notation\n476:      * @param p   The UML element to generate for.\n477:      * @return     The generated text.\n478:      */\n479:     public static String generatePackage(NotationContext ctx,\n480: \t\t\t\t\t Object/*MPackage*/ p) {\n481:         return generatePackage(Notation.getNotation(ctx), p);\n482:     }\n483: \n484:     /**\n485:      * @param ctx  Context used to identify the notation\n486:      * @param cls   The UML element to generate for.\n487:      * @return     The generated text.\n488:      */\n489:     public static String generateClassifier(\n490:         NotationContext ctx,\n491:         Object/*MClassifier*/ cls) {\n492:         return generateClassifier(Notation.getNotation(ctx), cls);\n493:     }\n494: \n495:     /**\n496:      * There is no need for a version that handles a Collection of\n497:      * Stereotypes, since that is only needed for display, \n498:      * and hence already handled in ParserDisplay, e.g. for attributes.\n499:      * \n500:      * @param ctx  Context used to identify the notation\n501:      * @param s   The UML element to generate for.\n502:      * @return     The generated text.\n503:      */\n504:     public static String generateStereotype(\n505:             NotationContext ctx,\n506:             Object/*MStereotype*/ s) {\n507:         return generateStereotype(Notation.getNotation(ctx), s);\n508:     }\n509: \n510:     /**\n511:      * @param ctx  Context used to identify the notation\n512:      * @param s   The UML element to generate for.\n513:      * @return     The generated text.\n514:      */\n515:     public static String generateTaggedValue(\n516:         NotationContext ctx,\n517:         Object/*MTaggedValue*/ s) {\n518:         return generateTaggedValue(Notation.getNotation(ctx), s);\n519:     }\n520: \n521:     /**\n522:      * @param ctx  Context used to identify the notation\n523:      * @param a   The UML element to generate for.\n524:      * @return     The generated text.\n525:      */\n526:     public static String generateAssociation(\n527:         NotationContext ctx,\n528:         Object/*MAssociation*/ a) {\n529:         return generateAssociation(Notation.getNotation(ctx), a);\n530:     }\n531: \n532:     /**\n533:      * @param ctx  Context used to identify the notation\n534:      * @param ae   The UML element to generate for.\n535:      * @return     The generated text.\n536:      */\n537:     public static String generateAssociationEnd(\n538:         NotationContext ctx,\n539:         Object/*MAssociationEnd*/ ae) {\n540:         return generateAssociationEnd(Notation.getNotation(ctx), ae);\n541:     }\n542: \n543:     /**\n544:      * @param ctx  Context used to identify the notation\n545:      * @param m   The UML element to generate for.\n546:      * @return     The generated text.\n547:      */\n548:     public static String generateMultiplicity(\n549:         NotationContext ctx,\n550:         Object/*MMultiplicity*/ m) {\n551:         return generateMultiplicity(Notation.getNotation(ctx), m);\n552:     }\n553: \n554:     /**\n555:      * @param ctx  Context used to identify the notation\n556:      * @param m   The UML element to generate for.\n557:      * @return     The generated text.\n558:      */\n559:     public static String generateState(NotationContext ctx,\n560: \t\t\t\t       Object/*MState*/ m) {\n561:         return generateState(Notation.getNotation(ctx), m);\n562:     }\n563: \n564:     /**\n565:      * @param ctx  Context used to identify the notation\n566:      * @param m   The UML element to generate for.\n567:      * @return     The generated text.\n568:      */\n569:     public static String generateStateBody(NotationContext ctx,\n570: \t\t\t\t\t   Object/*MState*/ m) {\n571:         return generateStateBody(Notation.getNotation(ctx), m);\n572:     }\n573: \n574:     /**\n575:      * @param ctx  Context used to identify the notation\n576:      * @param m   The UML element to generate for.\n577:      * @return     The generated text.\n578:      */\n579:     public static String generateTransition(\n580:         NotationContext ctx,\n581:         Object/*MTransition*/ m) {\n582:         return generateTransition(Notation.getNotation(ctx), m);\n583:     }\n584: \n585:     /**\n586:      * @param ctx  Context used to identify the notation\n587:      * @param m   The UML element to generate for.\n588:      * @return     The generated text.\n589:      */\n590:     public static String generateVisibility(\n591:         NotationContext ctx,\n592:         Object m) {\n593:         return generateVisibility(Notation.getNotation(ctx), m);\n594:     }\n595: \n596:     /**\n597:      * @param ctx  Context used to identify the notation\n598:      * @param m   The UML element to generate for.\n599:      * @return     The generated text.\n600:      */\n601:     public static String generateAction(NotationContext ctx, Object m) {\n602:         return generateAction(Notation.getNotation(ctx), m);\n603:     }\n604: \n605:     /**\n606:      * @param ctx  Context used to identify the notation\n607:      * @param m   The UML element to generate for.\n608:      * @return     The generated text.\n609:      */\n610:     public static String generateGuard(NotationContext ctx,\n611: \t\t\t\t       Object/*MGuard*/ m) {\n612:         return generateGuard(Notation.getNotation(ctx), m);\n613:     }\n614: \n615:     /**\n616:      * @param ctx  Context used to identify the notation\n617:      * @param m   The UML element to generate for.\n618:      * @return     The generated text.\n619:      */\n620:     public static String generateMessage(NotationContext ctx,\n621: \t\t\t\t\t Object/*MMessage*/ m) {\n622:         return generateMessage(Notation.getNotation(ctx), m);\n623:     }\n624: \n625:     /**\n626:      * @param ctx  Context used to identify the notation\n627:      * @param cls   The UML element to generate for.\n628:      * @return     The generated text.\n629:      */\n630:     public static String generateClassifierRef(\n631:         NotationContext ctx,\n632:         Object/*MClassifier*/ cls) {\n633:         return generateClassifierRef(Notation.getNotation(ctx), cls);\n634:     }\n635: \n636:     /**\n637:      * @param ctx  Context used to identify the notation\n638:      * @param m   The UML element to generate for.\n639:      * @return     The generated text.\n640:      */\n641:     public static String generateAssociationRole(\n642:         NotationContext ctx,\n643:         Object/*MAssociationRole*/ m) {\n644:         return generateAssociationRole(Notation.getNotation(ctx), m);\n645:     }\n646: \n647:     /**\n648:      * General purpose static generator for any object that wishes to set\n649:      * the documented flag.<p>\n650:      *\n651:      * Uses the class of the object to determine which method to\n652:      * invoke. Only actually looks for MOperation and MAttribute. All others\n653:      * invoke the simpler version with no documented flag, so taking the\n654:      * default version.\n655:      *\n656:      * @param ctx        The context to look up the notation generator.\n657:      *\n658:      * @param o          The object to generate.\n659:      *\n660:      * @param documented  This flag only has any effect for\n661:      * Operations and Attributes.\n662:      * See {@link GeneratorJava#generateConstraintEnrichedDocComment()}.\n663:      *\n664:      * @return            The generated string.\n665:      */\n666:     public static String generate(\n667:         NotationContext ctx,\n668:         Object o,\n669:         boolean documented) {\n670:         if (o == null) {\n671:             return \"\";\n672: \t}\n673:         return generate(getNotation(ctx), o, documented);\n674:     }\n675: \n676:     /**\n677:      * General purpose static generator for any object that wishes to set\n678:      * the documented flag.<p>\n679:      *\n680:      * Uses the class of the object to determine which method to\n681:      * invoke. Only actually looks for MOperation and MAttribute. All others\n682:      * invoke the simpler version with no documented flag, so taking the\n683:      * default version.\n684:      *\n685:      * @param nn         The notation name.\n686:      *\n687:      * @param o          The object to generate.\n688:      *\n689:      * @param documented  This flag only has any effect for Operations and\n690:      * Attributes.\n691:      * See {@link GeneratorJava#generateConstraintEnrichedDocComment()}.\n692:      *\n693:      * @return            The generated string.\n694:      */\n695:     public static String generate(\n696:         NotationName nn,\n697:         Object o,\n698:         boolean documented) {\n699:         if (o == null) {\n700:             return \"\";\n701: \t}\n702:         if (Model.getFacade().isAOperation(o)) {\n703:             return generateOperation(nn, /*(MOperation)*/ o,\n704:                     \t\t     documented);\n705: \t}\n706:         if (Model.getFacade().isAAttribute(o)) {\n707:             return generateAttribute(nn, /*(MAttribute)*/ o,\n708: \t\t\t\t     documented);\n709: \t}\n710:         return generate(nn, o);\n711:     }\n712: \n713:     /**\n714:      * @param ctx  Context used to identify the notation\n715:      * @param o    The UML element to generate for.\n716:      * @return     The generated string.\n717:      */\n718:     public static String generate(NotationContext ctx, Object o) {\n719:         if (o == null) {\n720:             return \"\";\n721: \t}\n722:         return generate(getNotation(ctx), o);\n723:     }\n724: \n725:     /**\n726:      * @param nn   The NotationName to be used for the generation\n727:      * @param o    The UML element to generate for.\n728:      * @return     The generated string.\n729:      */\n730:     public static String generate(NotationName nn, Object o) {\n731:         if (o == null) {\n732:             return \"\";\n733: \t}\n734:         //added to support association roles\n735:         if (Model.getFacade().isAAssociationRole(o)) {\n736:             return generateAssociationRole(nn, o);\n737:         }\n738: \n739:         // Added to support extension points\n740:         if (Model.getFacade().isAExtensionPoint(o)) {\n741:             return generateExtensionPoint(nn, o);\n742:         }\n743: \n744:         if (Model.getFacade().isAOperation(o)) {\n745:             return generateOperation(nn, o, false);\n746: \t}\n747:         if (Model.getFacade().isASubmachineState(o)) {\n748:             return generateSubmachine(nn, o);\n749: \t}\n750:         if (Model.ge