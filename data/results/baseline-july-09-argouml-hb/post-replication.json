k\n297: \t};\n298:         return actions;\n299:     }\n300: \n301:     private Object[] getExtendedActions() {\n302:         Object actions[] =\n303:         {\n304:             actionCallState, \n305:             actionObjectFlowState,\n306:             actionSubactivityState };\n307:         return actions;\n308: \n309:     }\n310: \n311:     \n312:     /**\n313:      * Creates a new diagram name.<p>\n314:      *\n315:      * @return String\n316:      */\n317:     protected static String getNewDiagramName() {\n318:         String name = null;\n319:         name = \"Activity Diagram \" + activityDiagramSerial;\n320:         activityDiagramSerial++;\n321:         if (!ProjectManager.getManager().getCurrentProject()\n322:                  .isValidDiagramName(name)) {\n323:             name = getNewDiagramName();\n324:         }\n325:         return name;\n326:     }\n327: } /* end class UMLActivityDiagram */\n328: ",
