    /**\n202:      * Returns the numeric value of a configuration property.\n203:      *\n204:      * @param key the key to retrieve the value of\n205:      *\n206:      * @return the string value of the parameter if it exists, otherwise zero\n207:      */\n208:     public static int getInteger(ConfigurationKey key) {\n209: \treturn getInteger(key, 0);\n210:     }\n211: \n212:     /**\n213:      * Returns the numeric value of a configuration property.\n214:      *\n215:      * @param key the key to retrieve the value of\n216:      * @param defaultValue if the key is not found\n217:      *\n218:      * @return the string value of the parameter if it exists,\n219:      *         otherwise the default value\n220:      */\n221:     public static double getDouble(ConfigurationKey key,\n222:                                    double defaultValue) {\n223: \treturn config.getDouble(key, defaultValue);\n224:     }\n225: \n226:     /**\n227:      * Returns the numeric value of a configuration property.\n228:      *\n229:      * @param key the key to retrieve the value of\n230:      *\n231:      * @return the string value of the parameter if it exists, otherwise zero\n232:      */\n233:     public static double getDouble(ConfigurationKey key) {\n234: \treturn getDouble(key, 0);\n235:     }\n236: \n237:     /**\n238:      * Returns the numeric value of a configuration property.\n239:      *\n240:      * @param key the key to retrieve the value of\n241:      * @param defaultValue the value to return if the key does not exist\n242:      *\n243:      * @return the numeric value of the parameter if it exists, otherwise\n244:      *  the default value\n245:      */\n246:     public static int getInteger(ConfigurationKey key, int defaultValue) {\n247: \treturn config.getInteger(key, defaultValue);\n248:     }\n249: \n250:     /**\n251:      * Returns the boolean value of a configuration property.\n252:      *\n253:      * @param key the key to retrieve the value of\n254:      *\n255: