ove(currentseq.size() - 1);\n2519:                     }\n2520: \n2521:                     if (currentseq.get(currentseq.size() - 2) != null\n2522:                             || currentseq.get(currentseq.size() - 1) != null) {\n2523: \n2524:                         predecessors.add(currentseq);\n2525: \n2526:                         currentseq = new Vector();\n2527:                         currentseq.add(null);\n2528:                         currentseq.add(null);\n2529:                     }\n2530:                     hasPredecessors = true;\n2531:                 } else if (\"//\".equals(token)) {\n2532:                     if (mustBePre)\n2533:                         throw new ParseException(\"Predecessors cannot be \"\n2534:                                 + \"parallellized\", st.getTokenIndex());\n2535:                     mustBeSeq = true;\n2536: \n2537:                     if (currentseq != null)\n2538:                         parallell = true;\n2539:                 } else if (\",\".equals(token)) {\n2540:                     if (currentseq != null) {\n2541:                         if (mustBeSeq)\n2542:                             throw new ParseException(\"Messages cannot have \"\n2543:                                     + \"many sequence numbers\", st\n2544:                                     .getTokenIndex());\n2545:                         mustBePre = true;\n2546: \n2547:                         if (currentseq.size() > 2\n2548:                              && currentseq.get(currentseq.size() - 2) == null\n2549:                              && currentseq.get(currentseq.size() - 1) == null) {\n2550: \n2551:                             currentseq.remove(currentseq.size() - 1);\n2552:                             currentseq.remove(currentseq.size() - 1);\n2553:                         }\n2554: \n2555:                         if (currentseq.get(currentseq.size() - 2) != null\n2556:                             || currentseq.get(currentseq.size() - 1) != nul