.getSelectionModel().addListSelectionListener(this);\n84:         JScrollPane sp = new JScrollPane(_table);\n85:         Font labelFont = LookAndFeelMgr.getInstance().getSmallFont();\n86:         _table.setFont(labelFont);\n87:         _titleLabel = new JLabel(\"none\");\n88:         resizeColumns();\n89:         setLayout(new BorderLayout());\n90:         add(_titleLabel, BorderLayout.NORTH);\n91:         add(sp, BorderLayout.CENTER);\n92:     }\n93: \n94:     public void resizeColumns() {\n95:         TableColumn keyCol = _table.getColumnModel().getColumn(0);\n96:         TableColumn valCol = _table.getColumnModel().getColumn(1);\n97:         keyCol.setMinWidth(50);\n98:         keyCol.setWidth(150);\n99:         keyCol.setPreferredWidth(150);\n100:         valCol.setMinWidth(250);\n101:         valCol.setWidth(550);\n102:         valCol.setPreferredWidth(550);\n103:         //_table.setAutoResizeMode(JTable.AUTO_RESIZE_ALL_COLUMNS);\n104:         _table.sizeColumnsToFit(-1);\n105:     }\n106: \n107:     ////////////////////////////////////////////////////////////////\n108:     // accessors\n109: \n110:     public void setTarget(Object target) {\n111:         if (_table.isEditing()) {\n112:             TableCellEditor ce = _table.getCellEditor();\n113:             if (ce != null && !ce.stopCellEditing())\n114:                 ce.cancelCellEditing();\n115:         }\n116: \n117:         Object t = (target instanceof Fig) ? ((Fig) target).getOwner() : target;\n118:         if (!(org.argouml.model.ModelFacade.isAModelElement(t))) {\n119:             _target = null;\n120:             _shouldBeEnabled = false;\n121:             return;\n122:         }\n123:         _target = t;\n124:         _shouldBeEnabled = true;\n125: \n126:         //TableColumn keyCol = _table.getColumnModel().getColumn(0);\n127:         //TableColumn valCol = _table.getColumnModel().getColumn(1);\n128:         //keyCol.setMinWidth(50);\n129:         //keyCol.setWidth(150);\n130:         //keyCol.setPreferredWidth(150);\n131:         //valCol.setMinWidth(250);\n132:         //valCol.setWidth(550);\n133:         //valCol.setPreferredWidth(550);\n134:         _table.setAutoResizeMode(JTable.AUTO_RESIZE_ALL_COLUMNS);\n135:         _table.sizeColumnsToFit(0);\n136: \n137:         Vector tvs = new Vector(ModelFacade.getTaggedValuesCollection(_target));\n138:         _tableModel.setTarget(_target);\n139:         if (_target != null) {\n140:             _titleLabel.setText(\"Target: \"\n141: \t\t\t\t+ ModelFacade.getUMLClassName(_target)\n142: \t\t\t\t+ \" (\" + ModelFacade.getName(_target) + \")\");\n143:         }\n144:         else {\n145:             _titleLabel.setText(\"none\");\n146:         }\n147:         validate();\n148:     }\n149: \n150:     public Object getTarget() { return _target; }\n151: \n152:     public void refresh() { setTarget(_target); }\n153: \n154:     public boolean shouldBeEnabled(Object target) {\n155:         Object t = (target instanceof Fig) ? ((Fig) target).getOwner() : target;\n156:         if (!(org.argouml.model.ModelFacade.isAModelElement(t))) {\n157:             _shouldBeEnabled = false;\n158:             return _shouldBeEnabled;\n159:         }\n160:         else {\n161:             _shouldBeEnabled = true;\n162:             return true;\n163:         }\n164:     }\n165: \n166:     /**\n167:      * @see org.argouml.ui.targetmanager.TargetListener#targetAdded(\n168:      *         org.argouml.ui.targetmanager.TargetEvent)\n169:      */\n170:     public void targetAdded(TargetEvent e) {\n171:     }\n172: \n173:     /**\n174:      * @see org.argouml.ui.targetmanager.TargetListener#targetRemoved(\n175:      *         org.argouml.ui.targetmanager.TargetEvent)\n176:      */\n177:     public void targetRemoved(TargetEvent e) {\n178:         setTarget(e.getNewTarget());\n179: \n180:     }\n181: \n182:     /**\n183:      * @see org.argouml.ui.targetmanager.TargetListener#targetSet(\n184:      *         org.argouml.ui.targetmanager.TargetEvent)\n185:      */\n186:     public void targetSet(TargetEvent e) {\n187:         setTarget(e.getNewTarget());\n188: \n189:     }\n190: \n191: } /* end class TabTaggedValues */\n192: \n193: \n194: \n195: \n196: class TableModelTaggedValues extends AbstractTableModel\n197:     implements VetoableChangeListener,\n198: \t       DelayedVChangeListener,\n199: \t       MElementListener\n200: {\n201: \n202:     ////////////////\n203:     // instance varables\n204:     Object _target;\t\t// ModelElement\n205:     TabTaggedValues _tab = null;\n206: \n207:     ////////////////\n208:     // constructor\n209:     public TableModelTaggedValues(TabTaggedValues t) { _tab = t; }\n210: \n211:     ////////////////\n212:     // accessors\n213:     public void setTarget(Object t) {\n214:         \n215:         if (!ModelFacade.isAModelElement(t))\n216:             throw new IllegalArgumentException();\n217:         \n218: \tif (_target != null)\n219: \t    UmlModelEventPump.getPump().removeModelEventListener(this, _target);\n220: \t_target = t;\n221: \tUmlModelEventPump.getPump().addModelEventListener(this, t);\n222: \tfireTableDataChanged();\n223: \t_tab.resizeColumns();\n224:     }\n225: \n226:     ////////////////\n227:     // TableModel implemetation\n228:     public int getColumnCount() { return 2; }\n229: \n230:     public String  getColumnName(int c) {\n231: \tif (c == 0) return Translator.localize(\"label.taggedvaluespane.tag\");\n232: \tif (c == 1) return Translator.localize(\"label.taggedvaluespane.value\");\n233: \treturn \"XXX\";\n234:     }\n235: \n236:     public Class getColumnClass(int c) {\n237: \treturn String.class;\n238:     }\n239: \n240:     public boolean isCellEditable(int row, int col) {\n241: \treturn true;\n242:     }\n243: \n244:     public int getRowCount() {\n245: \tif (_target == null) return 0;\n246: \tCollection tvs = ModelFacade.getTaggedValuesCollection(_target);\n247: \t//if (tvs == null) return 1;\n248: \treturn tvs.size() + 1;\n249:     }\n250: \n251:     public Object getValueAt(int row, int col) {\n252: \tVector tvs = new Vector(ModelFacade.getTaggedValuesCollection(_target));\n253: \t//if (tvs == null) return \"\";\n254: \tif (row == tvs.size()) return \"\"; //blank line allows addition\n255: \tObject tv = tvs.elementAt(row);\n256: \tif (col == 0) {\n257: \t    String n = ModelFacade.getTagOfTag(tv);\n258: \t    if (n == null) return \"\";\n259: \t    return n;\n260: \t}\n261: \tif (col == 1) {\n262: \t    String be = ModelFacade.getValueOfTag(tv);\n263: \t    if (be == null) return \"\";\n264: \t    return be;\n265: \t}\n266: \treturn \"TV-\" + row * 2 + col; // for debugging\n267:     }\n268: \n269:     public void setValueAt(Object aValue, int rowIndex, int columnIndex) {\n270: \tTableModelEvent mEvent = null;\n271: \n272: \tif (columnIndex != 0 && columnIndex != 1) return;\n273: \tif (!(aValue instanceof String)) return;\n274:         if (aValue == null) aValue = \"\";\n275:         \n276: \tVector tvs = new Vector(ModelFacade.getTaggedValuesCollection(_target));\n277: \tif (tvs.size() <= rowIndex) {\n278: \t    Object tv =\n279: \t\tUmlFactory.getFactory()\n280: \t\t    .getExtensionMechanisms().createTaggedValue();\n281: \t    if (columnIndex == 0) ModelFacade.setTag(tv, aValue);\n282: \t    if (columnIndex == 1) {\n283: \t\tModelFacade.setTag(tv, \"\");\n284: \t\tModelFacade.setValue(tv, aValue);\n285: \t    }\n286: \t    tvs.addElement(tv);\n287: \n288: \t    mEvent =\n289: \t\tnew TableModelEvent(this, tvs.size(), tvs.size(),\n290: \t\t\t\t    TableModelEvent.ALL_COLUMNS,\n291: \t\t\t\t    TableModelEvent.INSERT);\n292: \t}\n293: \telse if (\"\".equals(aValue) && columnIndex == 0) {\n294: \t    tvs.removeElementAt(rowIndex);\n295: \t    mEvent =\n296: \t\tnew TableModelEvent(this, rowIndex, rowIndex,\n297: \t\t\t\t    TableModelEvent.ALL_COLUMNS,\n298: \t\t\t\t    TableModelEvent.DELETE);\n299: \t}\n300: \telse {\n301: \t    Object tv = tvs.elementAt(rowIndex);\n302: \t    if (columnIndex == 0) ModelFacade.setTag(tv, aValue);\n303: \t    if (columnIndex == 1)  {\n304:                 ModelFacade.setValue(tv, aValue);\n305:             }\n306: \t    mEvent = new TableModelEvent(this, rowIndex);\n307: \t}\n308: \tModelFacade.setTaggedValues(_target, tvs);\n309: \tif (mEvent != null)\n310: \t    fireTableChanged(mEvent);\n311: \t_tab.resizeColumns();\n312:     }\n313: \n314:     ////////////////\n315:     // event handlers\n316:     public void propertySet(MElementEvent mee) {\n317:     }\n318:     public void listRoleItemSet(MElementEvent mee) {\n319:     }\n320:     public void recovered(MElementEvent mee) {\n321:     }\n322:     public void removed(MElementEvent mee) {\n323:     }\n324:     public void roleAdded(MElementEvent mee) {\n325: \tif (\"taggedValue\".equals(mee.getName()))\n326: \t    fireTableChanged(new TableModelEvent(this));\n327:     }\n328:     public void roleRemoved(MElementEvent mee) {\n329:     }\n330: \n331: \n332:     public void vetoableChange(PropertyChangeEvent pce) {\n333: \tDelayedChangeNotify delayedNotify = new DelayedChangeNotify(this, pce);\n334: \tSwingUtilities.invokeLater(delayedNotify);\n335:     }\n336: \n337:     public void delayedVetoableChange(PropertyChangeEvent pce) {\n338: \tfireTableDataChanged();\n339: \t_tab.resizeColumns();\n340:     }\n341: \n342: } /* end class TableModelTaggedValues */\n343: ",
