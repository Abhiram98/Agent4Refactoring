actionUniComposition },\n292:         };\n293: \n294:         return actions;\n295:     }\n296: \n297:     /**\n298:      * @return a new unique name for the diagram\n299:      */\n300:     protected static String getNewDiagramName() {\n301:         String name = null;\n302:         name = \"Use Case Diagram \" + useCaseDiagramSerial;\n303:         useCaseDiagramSerial++;\n304:         if (!(ProjectManager.getManager().getCurrentProject()\n305: \t          .isValidDiagramName(name))) {\n306:             name = getNewDiagramName();\n307:         }\n308:         return name;\n309:     }\n310: } /* end class UMLUseCaseDiagram */\n311: ",
