bility(me,\n276:                             Model.getVisibilityKind().getPrivate());\n277:         }\n278:         if (name != null && name.startsWith(\"#\")) {\n279:             name = name.substring(1).trim();\n280:             Model.getCoreHelper().setVisibility(me,\n281:                             Model.getVisibilityKind().getProtected());\n282:         }\n283:         if (name != null && name.startsWith(\"~\")) {\n284:             name = name.substring(1).trim();\n285:             Model.getCoreHelper().setVisibility(me,\n286:                             Model.getVisibilityKind().getPackage());\n287:         }\n288:         if (name != null) {\n289:             Model.getCoreHelper().setName(me, name);\n290:         }\n291: \n292:         NotationUtilityUml.dealWithStereotypes(me, stereotype, false);\n293: \n294:         if (path != null) {\n295:             Object nspe =\n296:                 Model.getModelManagementHelper().getElement(\n297:                         path,\n298:                         Model.getFacade().getModel(me));\n299: \n300:             if (nspe == null || !(Model.getFacade().isANamespace(nspe))) {\n301:             \tString msg = \n302:             \t\t\"parsing.error.model-element-name.namespace-unresolved\";\n303:                 throw new ParseException(Translator.localize(msg), \n304:                         0);\n305:             }\n306:             Object model =\n307:                 ProjectManager.getManager().getCurrentProject().getRoot();\n308:             if (!Model.getCoreHelper().getAllPossibleNamespaces(me, model)\n309:                         .contains(nspe)) {\n310:                 String msg = \n311:                 \t\"parsing.error.model-element-name.namespace-invalid\";\n312:                 throw new ParseException(Translator.localize(msg), \n313:                         0);\n314:             }\n315: \n316:             Model.getCoreHelper().addOwnedElement(nspe, me);\n317:         }\n318:     }\n319: \n320: }\n321: ",
