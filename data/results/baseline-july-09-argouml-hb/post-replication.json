omponentWidth) {\n358:                      componentWidth = (int)childComp.getMaximumSize().getWidth();\n359:                 }\n360:                 childComp.setBounds(componentX, y, componentWidth, rowHeight);\n361:                 y += rowHeight + _vgap;\n362:                 ++row;\n363:             }\n364:         }\n365:     }\n366: \n367:     private int calculateHeight(int parentHeight, int totalHeight, int unknownHeightsLeft, Component childComp) {\n368:         int rowHeight = (parentHeight - totalHeight) / unknownHeightsLeft;\n369:         if (rowHeight < childComp.getMinimumSize().getHeight()) {\n370:             rowHeight = (int) childComp.getMinimumSize().getHeight();\n371:         }\n372:         return rowHeight;\n373:     }\n374:     \n375:     static public Seperator getSeperator() {\n376:         return new Seperator();\n377:     }\n378: \n379:     public int getHgap() {\n380:         return _hgap;\n381:     }\n382: \n383:     public void setHgap(int hgap) {\n384:         _hgap = hgap;\n385:     }\n386: \n387:     public int getVgap() {\n388:         return _vgap;\n389:     }\n390: \n391:     public void setVgap(int vgap) {\n392:         _vgap = vgap;\n393:     }\n394: }\n395: \n396: class Seperator extends JPanel {\n397:     Seperator() {\n398:         super.setVisible(false);\n399:     }\n400: }\n401: ",
