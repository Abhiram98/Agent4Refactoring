er(node);\n92: \tif (ModelFacade.isAClassifier(node)\n93: \t        && (ModelFacade.getName(node) != null)) {\n94: \t    getNameFig().setText(ModelFacade.getName(node));\n95: \t}\n96:     }\n97: \n98:     /**\n99:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#getH()\n100:      */\n101:     public String placeString() { return \"new Node\"; }\n102: \n103:     /**\n104:      * @see java.lang.Object#clone()\n105:      */\n106:     public Object clone() {\n107: \tFigMNode figClone = (FigMNode) super.clone();\n108: \tIterator it = figClone.getFigs(null).iterator();\n109: \tfigClone.setBigPort((FigRect) it.next());\n110: \tfigClone.cover = (FigCube) it.next();\n111: \tfigClone.setStereotypeFig((FigText) it.next());\n112: \tfigClone.setNameFig((FigText) it.next());\n113: \tfigClone.test = (FigRect) it.next();\n114: \treturn figClone;\n115:     }\n116: \n117:     ////////////////////////////////////////////////////////////////\n118:     // acessors\n119: \n120:     /**\n121:      * @see org.tigris.gef.presentation.Fig#setLineColor(java.awt.Color)\n122:      */\n123:     public void setLineColor(Color c) {\n124: \t//     super.setLineColor(c);\n125: \tcover.setLineColor(c);\n126: \tgetStereotypeFig().setFilled(false);\n127: \tgetStereotypeFig().setLineWidth(0);\n128: \tgetNameFig().setFilled(false);\n129: \tgetNameFig().setLineWidth(0);\n130: \ttest.setLineColor(c);\n131:     }\n132: \n133:     /**\n134:      * @see org.tigris.gef.presentation.Fig#makeSelection()\n135:      */\n136:     public Selection makeSelection() {\n137: \treturn new SelectionNode(this);\n138:     }\n139: \n140:     /**\n141:      * @see org.tigris.gef.presentation.Fig#getMinimumSize()\n142:      */\n143:     public Dimension getMinimumSize() {\n144: \tDimension stereoDim = getStereotypeFig().getMinimumSize();\n145: \tDimension nameDim = getNameFig().getMinimumSize();\n146: \n147: \tint w = Math.max(stereoDim.width, nameDim.width + 1);\n148: \tint h = stereoDim.height + nameDim.height - 4;\n149: \treturn new Dimension(w, h);\n150:     }\n151: \n152:     /**\n153:      * @see org.tigris.gef.presentation.Fig#setBounds(int, int, int, int)\n154:      */\n155:     public void setBounds(int x, int y, int w, int h) {\n156: \tif (getNameFig() == null) {\n157: \t    return;\n158: \t}\n159: \n160: \tRectangle oldBounds = getBounds();\n161: \tgetBigPort().setBounds(x , y, w , h);\n162: \tcover.setBounds(x , y, w, h);\n163: \n164: \tDimension stereoDim = getStereotypeFig().getMinimumSize();\n165: \tDimension nameDim = getNameFig().getMinimumSize();\n166: \tgetNameFig().setBounds(x + 1, y + stereoDim.height + 1,\n167: \t\t\t       w - 1, nameDim.height);\n168: \tgetStereotypeFig().setBounds(x + 1, y + 1, w - 2, stereoDim.height);\n169: \t_x = x; _y = y; _w = w; _h = h;\n170: \tfirePropChange(\"bounds\", oldBounds, getBounds());\n171: \tupdateEdges();\n172:     }\n173: \n174:     ////////////////////////////////////////////////////////////////\n175:     // user interaction methods\n176: \n177:     /**\n178:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n179:      */\n180:     public void mouseClicked(MouseEvent me) {\n181: \tsuper.mouseClicked(me);\n182: \tsetLineColor(Color.black);\n183:     }\n184: \n185: \n186:     /**\n187:      * @see org.tigris.gef.presentation.Fig#setEnclosingFig(org.tigris.gef.presentation.Fig)\n188:      */\n189:     public void setEnclosingFig(Fig encloser) {\n190: \tsuper.setEnclosingFig(encloser);\n191: \n192: \tVector figures = getEnclosedFigs();\n193: \n194: \tif (getLayer() != null) {\n195:             // elementOrdering(figures);\n196:             Collection contents = getLayer().getContents(null);\n197:             Collection bringToFrontList = new ArrayList();\n198:             Iterator it = contents.iterator();\n199:             while (it.hasNext()) {\n200:                 Object o = it.next();\n201:                 if (o instanceof FigEdgeModelElement) {\n202:                     bringToFrontList.add(o);\n203:                     \n204:                 }\n205:             }\n206:             Iterator bringToFrontIter = bringToFrontList.iterator();\n207:             while (bringToFrontIter.hasNext()) {\n208:                 FigEdgeModelElement figEdge = \n209:                     (FigEdgeModelElement) bringToFrontIter.next();\n210:                 figEdge.getLayer().bringToFront(figEdge);\n211:             }\n212:         }\n213:     }\n214: \n215:     /**\n216:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateStereotypeText()\n217:      */\n218:     protected void updateStereotypeText() {\n219: \tObject me = /*(MModelElement)*/ getOwner();\n220: \tif (me == null) return;\n221: \tObject stereo = null;\n222: \tif (ModelFacade.getStereotypes(me).size() > 0) {\n223:             stereo = ModelFacade.getStereotypes(me).iterator().next();\n224:         }\n225: \tif (stereo == null\n226: \t    || ModelFacade.getName(stereo) == null\n227: \t    || ModelFacade.getName(stereo).length() == 0) {\n228: \n229: \t    setStereotype(\"\");\n230: \n231: \t} else {\n232: \n233: \t    setStereotype(Notation.generateStereotype(this, stereo));\n234: \n235: \t}\n236:     }\n237: \n238:     /**\n239:      * @see org.tigris.gef.presentation.Fig#getUseTrapRect()\n240:      */\n241:     public boolean getUseTrapRect() { return true; }\n242: \n243:     static final long serialVersionUID = 8822005566372687713L;\n244: \n245: } /* end class FigMNode */\n246: ",
