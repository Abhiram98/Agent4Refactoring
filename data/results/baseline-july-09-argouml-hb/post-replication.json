e key to.\n310:      */\n311:     public static void setBoolean(ConfigurationKey key,\n312:                                   boolean newValue) {\n313: \tconfig.setBoolean(key, newValue);\n314:     }\n315: \n316:     /**\n317:      * Adds a property change listener.\n318:      *\n319:      * @param pcl The property change listener to add\n320:      */\n321:     public static void addListener(PropertyChangeListener pcl) {\n322: \tconfig.addListener(pcl);\n323:     }\n324: \n325:     /**\n326:      * Removes a property change listener.\n327:      *\n328:      * @param pcl The property change listener to remove\n329:      */\n330:     public static void removeListener(PropertyChangeListener pcl) {\n331: \tconfig.removeListener(pcl);\n332:     }\n333: \n334:     /**\n335:      * Adds a property change listener.Static for simplicity of use.\n336:      *\n337:      * @param key The key to listen for changes of\n338:      * @param pcl The property change listener to add\n339:      */\n340:     public static void addListener(ConfigurationKey key,\n341:                                    PropertyChangeListener pcl) {\n342: \tconfig.addListener(key, pcl);\n343:     }\n344: \n345:     /**\n346:      * Removes a property change listener.\n347:      *\n348:      * @param key The key to listen for changes of\n349:      * @param pcl The property change listener to remove\n350:      */\n351:     public static void removeListener(ConfigurationKey key,\n352:                                       PropertyChangeListener pcl) {\n353: \tconfig.removeListener(key, pcl);\n354:     }\n355: \n356:     /**\n357:      * @param key The key to remove.\n358:      */\n359:     public static void removeKey(ConfigurationKey key) {\n360:         config.remove(key.getKey());\n361:     }\n362: \n363:     /**\n364:      * Create a single component configuration key.\n365:      *\n366:      * @param k1 key component 1.\n367:      * @return the new {@link ConfigurationKey}.\n368:      */\n369:     public 