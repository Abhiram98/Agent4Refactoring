ion.events.ArgoNotationEvent)\n793:      */\n794:     public void notationRemoved(ArgoNotationEvent event) {\n795:     }\n796: \n797:     /**\n798:      * @see org.argouml.application.events.ArgoNotationEventListener#notationProviderAdded(org.argouml.application.events.ArgoNotationEvent)\n799:      */\n800:     public void notationProviderAdded(ArgoNotationEvent event) {\n801:     }\n802: \n803:     /**\n804:      * @see org.argouml.application.events.ArgoNotationEventListener#notationProviderRemoved(org.argouml.application.events.ArgoNotationEvent)\n805:      */\n806:     public void notationProviderRemoved(ArgoNotationEvent event) {\n807:     }\n808: \n809:     /**\n810:      * Rerenders the fig if needed. This functionality was originally\n811:      * the functionality of modelChanged but modelChanged takes the\n812:      * event now into account.\n813:      */\n814:     public void renderingChanged() {\n815:         // updateAnnotationPositions();\n816:         updateClassifiers();\n817:         updateNameText();\n818:         updateStereotypeText();\n819:         damage();\n820:     }\n821: \n822:     /**\n823:      * @see org.tigris.gef.presentation.Fig#hit(java.awt.Rectangle)\n824:      */\n825:     public boolean hit(Rectangle r) {\n826: \t// Check if labels etc have been hit\n827: \t// Apparently GEF does require PathItems to be \"annotations\"\n828: \t// which ours aren't, so until that is resolved...\n829: \tIterator it = getPathItemFigs().iterator();\n830: \twhile (it.hasNext()) {\n831: \t    Fig f = (Fig) it.next();\n832: \t    if (f.hit(r))\n833: \t\treturn true;\n834: \t}\n835: \n836: \treturn super.hit(r);\n837:     }\n838: \n839: \n840:     /**\n841:      * @see org.tigris.gef.presentation.Fig#removeFromDiagram()\n842:      */\n843:     public void removeFromDiagram() {\n844:         Object o = getOwner();\n845:         if (Model.getFacade().isABase(o)) {\n846:             Model.getPump().removeModelEventListener(this, o);\n847:         }\n848:         if (this instanceof ArgoEventListener) {\n849:             ArgoEventPump.removeListener(this);\n850:         }\n851: \n852:         Iterator it = getPathItemFigs().iterator();\n853:         while (it.hasNext()) {\n854:             Fig fig = (Fig) it.next();\n855:             fig.removeFromDiagram();\n856:         }\n857: \n858:         /* TODO: MVW: Why the next action?\n859:          * Deleting a fig from 1 diagram should not influence others!\n860:          * */\n861:         // GEF does not take into account the multiple diagrams we have\n862:         // therefore we loop through our diagrams and delete each and every\n863:         // occurence on our own\n864:         it =\n865: \t    ProjectManager.getManager().getCurrentProject()\n866: \t        .getDiagrams().iterator();\n867:         while (it.hasNext()) {\n868:             ArgoDiagram diagram = (ArgoDiagram) it.next();\n869:             diagram.damage();\n870:         }\n871: \n872:         super.removeFromDiagram();\n873: \n874:         //This partly solves issue 3042.\n875: //        Layer l = this.getLayer();\n876: //        if (l != null) l.remove(this);\n877:     }\n878: \n879:     /**\n880:      * @see org.tigris.gef.presentation.Fig#damage()\n881:      */\n882:     public void damage() {\n883:         super.damage();\n884:         getFig().damage();\n885:     }\n886: \n887:     /**\n888:      * <p>Updates the classifiers the edge is attached to.  <p>Calls a\n889:      * helper method (layoutThisToSelf) to avoid this edge\n890:      * disappearing if the new source and dest are the same node.\n891:      *\n892:      * @return boolean whether or not the update was sucessful\n893:      */\n894:     protected boolean updateClassifiers() {\n895:         Object owner = getOwner();\n896:         if (owner == null || getLayer() == null)\n897:             return false;\n898: \n899:         Object newSource = getSource();\n900:         Object newDest = getDestination();\n901: \n902:         Fig currentSourceFig = getSourceFigNode();\n903:         Fig currentDestFig = getDestFigNode();\n904:         Object currentSource = null;\n905:         Object currentDestination = null;\n906:         if (currentSourceFig != null && currentDestFig != null) {\n907:             currentSource = currentSourceFig.getOwner();\n908:             currentDestination = currentDestFig.getOwner();\n909:         }\n910:         if (newSource != currentSource || newDest != currentDestination) {\n911:             Fig newSourceFig = null;\n912:             if (newSource != null)\n913:                 newSourceFig = getLayer().presentationFor(newSource);\n914:             Fig newDestFig = null;\n915:             if (newDest != null)\n916:                 newDestFig = getLayer().presentationFor(newDest);\n917:             if (newSourceFig == null || newDestFig == null) {\n918:                 removeFromDiagram();\n919:                 return false;\n920:             }\n921:             if (newSourceFig != null && newSourceFig != currentSourceFig) {\n922:                 setSourceFigNode((FigNode) newSourceFig);\n923:                 setSourcePortFig(newSourceFig);\n924: \n925:             }\n926:             if (newDestFig != null && newDestFig != currentDestFig) {\n927:                 setDestFigNode((FigNode) newDestFig);\n928:                 setDestPortFig(newDestFig);\n929:             }\n930:             if (newDestFig != null && newSourceFig != null) {\n931:                 ((FigNode) newSourceFig).updateEdges();\n932:             }\n933:             if (newSourceFig != null && newDestFig != null) {\n934:                 ((FigNode) newDestFig).updateEdges();\n935:             }\n936:             calcBounds();\n937: \n938:             // adapted from SelectionWButtons from line 280\n939:             // calls a helper method to avoid this edge disappearing\n940:             // if the new source and dest are the same node.\n941:             if (newSourceFig == newDestFig) {\n942: \n943:                 layoutThisToSelf();\n944:             }\n945: \n946:         }\n947: \n948:         return true;\n949:     }\n950: \n951:     /**\n952:      * helper method for updateClassifiers() in order to automatically\n953:      * layout an edge that is now from and to the same node type.\n954:      * <p>adapted from SelectionWButtons from line 280\n955:      */\n956:     private void layoutThisToSelf() {\n957: \n958:         FigPoly edgeShape = new FigPoly();\n959:         //newFC = _content;\n960:         Point fcCenter =\n961:             new Point(getSourceFigNode().getX() / 2,\n962:                     getSourceFigNode().getY() / 2);\n963:         Point centerRight =\n964:             new Point(\n965: \t\t      (int) (fcCenter.x\n966: \t\t\t     + getSourceFigNode().getSize().getWidth() / 2),\n967: \t\t      fcCenter.y);\n968: \n969:         int yoffset = (int) ((getSourceFigNode().getSize().getHeight() / 2));\n970:         edgeShape.addPoint(fcCenter.x, fcCenter.y);\n971:         edgeShape.addPoint(centerRight.x, centerRight.y);\n972:         edgeShape.addPoint(centerRight.x + 30, centerRight.y);\n973:         edgeShape.addPoint(centerRight.x + 30, centerRight.y + yoffset);\n974:         edgeShape.addPoint(centerRight.x, centerRight.y + yoffset);\n975: \n976:         // place the edge on the layer and update the diagram\n977:         this.setBetweenNearestPoints(true);\n978:         edgeShape.setLineColor(Color.black);\n979:         edgeShape.setFilled(false);\n980:         edgeShape.setComplete(true);\n981:         this.setFig(edgeShape);\n982:     }\n983: \n984:     /**\n985:      * Returns the source of the edge. The source is the owner of the\n986:      * node the edge travels from in a binary relationship. For\n987:      * instance: for a classifierrole, this is the sender.\n988:      * @return MModelElement\n989:      */\n990:     protected Object getSource() {\n991:         Object owner = getOwner();\n992:         if (owner != null) {\n993:             if (owner instanceof CommentEdge) {\n994:                 return ((CommentEdge) owner).getSource();\n995:             }\n996:             return Model.getCoreHelper().getSource(owner);\n997:         }\n998:         return null;\n999:     }\n1000:     /**\n1001:      * Returns the destination of the edge. The destination is the\n1002:      * owner of the node the edge travels to in a binary\n1003:      * relationship. For instance: for a classifierrole, this is the\n1004:      * receiver.\n1005:      * @return Object\n1006:      */\n1007:     protected Object getDestination() {\n1008:         Object owner = getOwner();\n1009:         if (owner != null) {\n1010:             if (owner instanceof CommentEdge) {\n1011:                 return ((CommentEdge) owner).getDestination();\n1012:             }\n1013:             return Model.getCoreHelper().getDestination(owner);\n1014:         }\n1015:         return null;\n1016:     }\n1017: \n1018:     /**\n1019:      * @see org.tigris.gef.presentation.Fig#postLoad()\n1020:      */\n1021:     public void postLoad() {\n1022:         super.postLoad();\n1023:         ArgoEventPump.removeListener(this);\n1024:         ArgoEventPump.addListener(this);\n1025:     }\n1026: \n1027:     /**\n1028:      * @return Returns the lABEL_FONT.\n1029:      */\n1030:     public static Font getLabelFont() {\n1031:         return LABEL_FONT;\n1032:     }\n1033: \n1034:     /**\n1035:      * @return Returns the iTALIC_LABEL_FONT.\n1036:      */\n1037:     public static Font getItalicLabelFont() {\n1038:         return ITALIC_LABEL_FONT;\n1039:     }\n1040: \n1041:     /**\n1042:      * @param allowed true if the function RemoveFromDiagram is allowed\n1043:      */\n1044:     protected void allowRemoveFromDiagram(boolean allowed) {\n1045:         this.removeFromDiagram = allowed;\n1046:     }\n1047: \n1048:     public void setDiElement(DiElement diElement) {\n1049:         this.diElement = diElement;\n1050:     }\n1051: \n1052:     public DiElement get