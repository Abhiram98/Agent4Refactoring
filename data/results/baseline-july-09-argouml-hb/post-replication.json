source(\"Association\");\n76: \n77:     public static Icon compos = \n78:         ResourceLoaderWrapper.getResourceLoaderWrapper().lookupIconResource(\"CompositeAggregation\");\n79: \n80:     public static Icon selfassoc =\n81:         ResourceLoaderWrapper.getResourceLoaderWrapper().lookupIconResource(\"SelfAssociation\");\n82:         \n83: \n84: \n85:     ////////////////////////////////////////////////////////////////\n86:     // instance variables\n87:     protected boolean _useComposite = false;\n88:     \n89: \n90: \n91:     ////////////////////////////////////////////////////////////////\n92:     // constructors\n93: \n94:     /** Construct a new SelectionClass for the given Fig */\n95:     public SelectionClass(Fig f) { super(f); }\n96: \n97:     /** Return a handle ID for the handle under the mouse, or -1 if\n98:      *  none. Needs-More-Work: in the future, return a Handle instance or\n99:      *  null. <p>\n100:      *  <pre>\n101:      *   0-------1-------2\n102:      *   |               |\n103:      *   3               4\n104:      *   |               |\n105:      *   5-------6-------7\n106:      * </pre>\n107:      */\n108:     public void hitHandle(Rectangle r, Handle h) {\n109:         super.hitHandle(r, h);\n110:         if (h.index != -1) return;\n111:         if (!_paintButtons) return;\n112:         Editor ce = Globals.curEditor();\n113:         SelectionManager sm = ce.getSelectionManager();\n114:         if (sm.size() != 1) return;\n115:         ModeManager mm = ce.getModeManager();\n116:         if (mm.includes(ModeModify.class) && _pressedButton == -1) return;\n117:         int cx = _content.getX();\n118:         int cy = _content.getY();\n119:         int cw = _content.getWidth();\n120:         int ch = _content.getHeight();\n121:         int iw = inherit.getIconWidth();\n122:         int ih = inherit.getIconHeight();\n123:         int aw = assoc.getIconWidth();\n124:         int ah = assoc.getIconHeight();\n125:         int saw = selfassoc.getIconWidth();\n126:         int sah = selfassoc.getIconHeight();\n127: \n128:         if (hitAbove(cx + cw/2, cy, iw, ih, r)) {\n129:             h.index = 10;\n130:             h.instructions = \"Add a superclass\";\n131:         }\n132:         else if (hitBelow(cx + cw/2, cy + ch, iw, ih, r)) {\n133:             h.index = 11;\n134:             h.instructions = \"Add a subclass\";\n135:         }\n136:         else if (hitLeft(cx + cw, cy + ch/2, aw, ah, r)) {\n137:             h.index = 12;\n138:             h.instructions = \"Add an associated class\";\n139:         }\n140:         else if (hitRight(cx, cy + ch/2, aw, ah, r)) {\n141:             h.index = 13;\n142:             h.instructions = \"Add an associated class\";\n143:         }\n144:         else if (hitRight(cx, cy + ch - 10, saw, sah, r)) {\n145:             h.index = 14;\n146:             h.instructions = \"Add a self association\";\n147:         }\n148:         else {\n149:             h.index = -1;\n150:             h.instructions = \"Move object(s)\";\n151:         }\n152:     }\n153: \n154: \n155:     /** Paint the handles at the four corners and midway along each edge\n156:      * of the bounding box.  */\n157:     public void paintButtons(Graphics g) {\n158:         int cx = _content.getX();\n159:         int cy = _content.getY();\n160:         int cw = _content.getWidth();\n161:         int ch = _content.getHeight();\n162: \n163:         // The next two lines are necessary to get the GraphModel,\n164:         // in the DeploymentDiagram there are no Generalizations\n165:         Editor ce = Globals.curEditor();\n166:         GraphModel gm = ce.getGraphModel();\n167: \n168:         if (!(gm instanceof DeploymentDiagramGraphModel)) {\n169:             paintButtonAbove(inherit, g, cx + cw/2, cy, 10);\n170:             paintButtonBelow(inherit, g, cx + cw/2, cy + ch, 11);\n171:         }\n172:         if (_useComposite) {\n173:             paintButtonLeft(compos, g, cx + cw, cy + ch/2, 12);\n174:             paintButtonRight(compos, g, cx, cy + ch/2, 13);\n175:             paintButtonRight(selfassoc, g, cx, cy + ch - 10, 14);\n176:         }\n177:         else {\n178:             paintButtonLeft(assoc, g, cx + cw, cy + ch/2, 12);\n179:             paintButtonRight(assoc, g, cx, cy + ch/2, 13);\n180:             paintButtonRight(selfassoc, g, cx, cy + ch - 10, 14);\n181:         }\n182:     }\n183: \n184: \n185:     public void dragHandle(int mX, int mY, int anX, int anY, Handle hand) {\n186:         if (hand.index < 10) {\n187:             _paintButtons = false;\n188:             super.dragHandle(mX, mY, anX, anY, hand);\n189:             return;\n190:         }\n191:         int cx = _content.getX(), cy = _content.getY();\n192:         int cw = _content.getWidth(), ch = _content.getHeight();\n193:         int newX = cx, newY = cy, newW = cw, newH = ch;\n194:         Dimension minSize = _content.getMinimumSize();\n195:         int minWidth = minSize.width, minHeight = minSize.height;\n196:         Class edgeClass = null;\n197:         Class nodeClass = ru.novosoft.uml.foundation.core.MClassImpl.class;\n198:         int bx = mX, by = mY;\n199:         boolean reverse = false;\n200:         switch (hand.index) {\n201:         case 10: //add superclass\n202:             edgeClass = ru.novosoft.uml.foundation.core.MGeneralization.class;\n203:             by = cy;\n204:             bx = cx + cw/2;\n205:             break;\n206:         case 11: //add subclass\n207:             edgeClass = ru.novosoft.uml.foundation.core.MGeneralization.class;\n208:             reverse = true;\n209:             by = cy + ch;\n210:             bx = cx + cw/2;\n211:             break;\n212:         case 12: //add assoc\n213:             edgeClass = ru.novosoft.uml.foundation.core.MAssociation.class;\n214:             by = cy + ch/2;\n215:             bx = cx + cw;\n216:             break;\n217:         case 13: // add assoc\n218:             edgeClass = ru.novosoft.uml.foundation.core.MAssociation.class;\n219:             reverse = true;\n220:             by = cy + ch/2;\n221:             bx = cx;\n222:             break;\n223:         case 14: // selfassociation\n224:             // do not want to drag this\n225:             break;\n226:         default:\n227:             cat.warn(\"invalid handle number\");\n228:             break;\n229:         }\n230:         if (edgeClass != null && nodeClass != null) {\n231:             Editor ce = Globals.curEditor();\n232:             ModeCreateEdgeAndNode m = new\n233:                 ModeCreateEdgeAndNode(ce, edgeClass, nodeClass, _useComposite);\n234:             m.setup((FigNode)_content, _content.getOwner(), bx, by, reverse);\n235:             ce.mode(m);\n236:         }\n237: \n238:     }\n239: \n240: \n241:     public void buttonClicked(int buttonCode) {\n242:         super.buttonClicked(buttonCode);\n243:         MClass newNode = UmlFactory.getFactory().getCore().createClass();\n244:         FigClass fc = (FigClass) _content;\n245:         MClass cls = (MClass) fc.getOwner();\n246: \n247:         Editor ce = Globals.curEditor();\n248:         GraphModel gm = ce.getGraphModel();\n249:         if (!(gm instanceof MutableGraphModel)) return;\n250:         MutableGraphModel mgm = (MutableGraphModel) gm;\n251: \n252:         if (!mgm.canAddNode(newNode)) return;\n253:         GraphNodeRenderer renderer = ce.getGraphNodeRenderer();\n254:         LayerPerspective lay = (LayerPerspective)\n255:             ce.getLayerManager().getActiveLayer();\n256:         Fig newFC = renderer.getFigNodeFor(gm, lay, newNode);\n257: \n258:         Rectangle outputRect = new Rectangle(Math.max(0, fc.getX() - 200),\n259:                                              Math.max(0, fc.getY() - 200),\n260:                                              fc.getWidth() + 400,                              \n261:                                              fc.getHeight() + 400);\n262:                                              \n263:         \n264:         // handle the case that it is not a self association\n265:         if (buttonCode >=10 && buttonCode <= 13) {\n266:             int x = 0;\n267:             int y = 0; \n268:             if (buttonCode == 10) {\n269:                 // superclass\n270:                 x = fc.getX();\n271:                 y = Math.max(0, fc.getY() - 200);\n272:             }\n273:             else if (buttonCode == 11) {\n274:                 x = fc.getX();\n275:                 y = fc.getY() + fc.getHeight() + 100;\n276:             }\n277:             else if (buttonCode == 12) {\n278:                 x = fc.getX() + fc.getWidth() + 100;\n279:                 y = fc.getY();\n280:             }\n281:             else if (buttonCode == 13) {\n282:                 x = Math.max(0, fc.getX() - 200);\n283:                 y = fc.getY();\n284:                 \n285:             }        \n286:             // place the fig if it is not a selfassociation       \n287:             if (!placeFig(newFC, lay, x, y, outputRect)) return;\n288:         }\n289:         \n290:         // add the new node only if required, e.g. not when we add a \n291:         // self association\n292:         if (buttonCode != 14) {\n293:             ce.add(newFC);\n294:             mgm.addNode(newNode);\n295:         }\n296:         FigPoly edgeShape = new FigPoly();\n297:         if (buttonCode!=14) {\n298:             Point fcCenter = fc.center();\n299:             edgeShape.addPoint(fcCenter.x, fcCenter.y);\n300:             Point newFCCenter = newFC.center();\n301:             edgeShape.addPoint(newFCCenter.x, newFCCenter.y);\n302:         }\n303:         else {\n304:             Point fcCenter = fc.center();\n305:             Point centerRight = \n306:                 new Point((int)(fcCenter.x + fc.getSize().getWidth()/2), \n307:                           fcCenter.y);\n308: \n309:             int yoffset = (int)((fc.getSize().getHeight()/2));\n310:             edgeShape.addPoint(fcCenter.x, fcCenter.y);\n311:             edgeShape.addPoint(centerRight.x, centerRight.y);\n312:             edgeShape.addPoint(centerRight.x + 30,\n313:                                centerRight.y);\n314:             edgeShape.addPoint(centerRight.x + 30,\n315:                                centerRight.y + yoffset);\n316:             edgeShape.addPoint(centerRight.x,\n317:                                centerRight.y + yoffset);\n318:         }\n319:         Object newEdge = null;\n320:         if (buttonCode == 10) newEdge = createEdgeAbove(mgm, cls, newNode);\n321:         else if (buttonCode == 11) newEdge = createEdgeRight(mgm, cls, newNode);\n322:         else if (buttonCode == 12) newEdge = addAssocClassRight(mgm, cls, newNode);\n323:         else if (buttonCode == 13) newEdge = addAssocClassLeft(mgm, cls, newNode);\n324:         else if (buttonCode == 14) newEdge = addAssocClassRight(mgm, cls, cls);\n325: \n326:         FigEdge fe = (FigEdge) lay.presentationFor(newEdge);\n327:         edgeShape.setLineColor(Color.black);\n328:         edgeShape.setFilled(false);\n329:         edgeShape._isComplete = true;\n330:         fe.setFig(edgeShape);\n331:         ce.getSelectionManager().select(fc);\n332:     }\n333: \n334:     public Object createEdgeAbove(MutableGraphModel mgm, MClass cls,\n335:                                   MClass newCls) {\n336:         return mgm.connect(cls, newCls, MGeneralization.class);\n337:     }\n338: \n339:     public Object createEdgeRight(MutableGraphModel mgm, MClass cls,\n340:                                   MClass newCls) {\n341:         return mgm.connect(newCls, cls, MGeneralization.class);\n342:     }\n343: \n344:     public Object addAssocClassRight(MutableGraphModel mgm, MClass cls,\n345:                                      MClass newCls) {\n346:         return mgm.connect(cls, newCls, MAssociation.class);\n347:     }\n348: \n349:     public Object addAssocClassLeft(MutableGraphModel mgm, MClass cls,\n350:         