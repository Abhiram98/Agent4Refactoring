262:      * \n263:      * @return true, if any diagrams where modified and the project should be\n264:      *         saved before exit.\n265:      */\n266:     public boolean needsSave() {\n267: \treturn (!diagram.getModifiedDiagrams().isEmpty());\n268:     }\n269: \n270:     /**\n271:      * @see org.argouml.application.api.ArgoModule#getTabPanel()\n272:      *\n273:      * Textual description of the module.\n274:      */\n275:     public String getTabPanel() {\n276: \treturn \"Java import from IDL files\";\n277:     }\n278: \n279:     /**\n280:      * @see org.argouml.application.api.ArgoModule#getModuleKey()\n281:      */\n282:     public String getModuleKey() {\n283: \treturn \"module.import.idl\";\n284:     }\n285: \n286:     /**\n287:      * @see org.argouml.application.api.ArgoModule#initializeModule()\n288:      */\n289:     public boolean initializeModule() {\n290: \n291: \t// Advertise a little\n292: \tLOG.info(\"IDL import module enabled!\");\n293: \n294: \treturn true;\n295:     }\n296: \n297:     /**\n298:      * @see org.argouml.application.api.ArgoModule#getModuleName()\n299:      * \n300:      * Display name of the module.\n301:      */\n302:     public String getModuleName() {\n303: \treturn \"IDL\";\n304:     }\n305: \n306:     /**\n307:      * Provides an array of suffixe filters for the module. Must be implemented\n308:      * in child class.\n309:      * \n310:      * @return SuffixFilter[] suffixes for processing\n311:      */\n312:     public SuffixFilter[] getSuffixFilters() {\n313: \tSuffixFilter[] result = {\n314: \t    FileFilters.IDLFilter,\n315: \t};\n316: \treturn result;\n317:     }\n318: \n319: }\n320: ",
