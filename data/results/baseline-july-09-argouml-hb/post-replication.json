rue;\n950:                 // only need to manually delete diagrams because they\n951:                 // don't have a decent event system set up.\n952:                 ExplorerEventAdaptor.getInstance().modelElementRemoved(obj);\n953:             }\n954:             if (obj instanceof Fig) {\n955:                 ((Fig) obj).dispose();\n956:                 needSave = true;\n957:                 // for explorer deletion:\n958:                 obj = ((Fig) obj).getOwner();\n959:             }\n960:         }        \n961:         setNeedsSave(needSave);\n962:     }\n963: \n964:     /**\n965:      * @param obj the object to be moved from the trash\n966:      * TODO: Is \"move\" remove or restore? \n967:      */\n968:     public void moveFromTrash(Object obj) {\n969:         if (LOG.isDebugEnabled()) {\n970:             LOG.debug(\"TODO: not restoring \" + obj);\n971:         }\n972:     }\n973: \n974:     /**\n975:      * @param dm the object \n976:      * @return true if the object is trashed\n977:      */\n978:     public boolean isInTrash(Object dm) {\n979:         return Trash.SINGLETON.contains(dm);\n980:     }\n981: \n982:     /**\n983:      * @param theDefaultModel a uml model\n984:      */\n985:     public void setDefaultModel(Object theDefaultModel) {\n986:         \n987:         if (!ModelFacade.isAModel(theDefaultModel)) {\n988:             throw new IllegalArgumentException();\n989:         }\n990:         \n991:         defaultModel = theDefaultModel;\n992:         defaultModelCache = new HashMap();\n993:     }\n994: \n995:     /**\n996:      * Get the default model.\n997:      * \n998:      * @return A model.\n999:      */\n1000:     public Object getDefaultModel() {\n1001:         return defaultModel;\n1002:     }\n1003: \n1004:     /** Find a type by name in the default model.\n1005:      *\n1006:      * @param name the name.\n1007:      * @return the type.\n1008:      */\n1009:     public Object findTypeInDefaultModel(String name) {\n1010:         if