 diagram node: \" + node);\n243:         if (!canAddNode(node)) return;\n244:         if (!(ModelFacade.isAStateVertex(node))) {\n245:             LOG.error(\"internal error: got past canAddNode\");\n246:             return;\n247:         }\n248:         Object sv = /* (MStateVertex) */node;\n249: \n250:         if (_nodes.contains(sv)) return;\n251:         _nodes.addElement(sv);\n252:         // TODO: assumes public, user pref for default visibility?\n253:         //if (sv.getNamespace() == null)\n254:         //_namespace.addOwnedElement(sv);\n255:         // TODO: assumes not nested in another composite state\n256:         Object top = /* (MCompositeState) */StateMachinesHelper.getHelper()\n257:                 .getTop(getMachine());\n258: \n259:         ModelFacade.addSubvertex(top, sv);\n260:         //       sv.setParent(top); this is done in setEnclosingFig!!\n261:         //      if ((sv instanceof MState) &&\n262:         //      (sv.getNamespace()==null))\n263:         //      ((MState)sv).setStateMachine(_machine);\n264:         fireNodeAdded(node);\n265:     }\n266: \n267:     /** Add the given edge to the graph, if valid.     \n268:      * @see org.tigris.gef.graph.MutableGraphModel#addEdge(java.lang.Object)\n269:      */\n270:     public void addEdge(Object edge) {\n271:         LOG.debug(\"adding statechart diagram edge!!!!!!\");\n272: \n273:         if (!canAddEdge(edge)) return;\n274:         Object tr = /* (MTransition) */edge;\n275:         _edges.addElement(tr);\n276:         fireEdgeAdded(edge);\n277:     }\n278: \n279:     /**\n280:      * @see org.tigris.gef.graph.MutableGraphModel#addNodeRelatedEdges(java.lang.Object)\n281:      */\n282:     public void addNodeRelatedEdges(Object node) {\n283:         if (ModelFacade.isAStateVertex(node)) {\n284:             Vector transen = new Vector(ModelFacade.getOutgoings(node));\n285:             transen.addAll(ModelFacade.getIncomings(node));\n286:             Iterator iter = transen.iterator();\n287:             while (iter.hasNext()) {\n288:                 Object dep = /* (MTransition) */iter.next();\n289:                 if (canAddEdge(dep)) addEdge(dep);\n290:             }\n291:         }\n292:     }\n293: \n294:     /**\n295:      * Return true if the two given ports can be connected by a kind of edge to\n296:      * be determined by the ports.\n297:      *\n298:      * @see org.tigris.gef.graph.MutableGraphModel#canConnect(java.lang.Object, java.lang.Object)\n299:      */\n300:     public boolean canConnect(Object fromPort, Object toPort) {\n301:         if (!(ModelFacade.isAStateVertex(fromPort))) {\n302:             LOG.error(\"internal error not from sv\");\n303:             return false;\n304:         }\n305:         if (!(ModelFacade.isAStateVertex(toPort))) {\n306:             LOG.error(\"internal error not to sv\");\n307:             return false;\n308:         }\n309: \n310:         if (ModelFacade.isAFinalState(fromPort)) { return false; }\n311:         if (ModelFacade.isAPseudostate(toPort)) {\n312:             if ((ModelFacade.INITIAL_PSEUDOSTATEKIND).equals(ModelFacade\n313:                     .getKind(toPort))) { return false; }\n314:         }        \n315:         return true;\n316:     }\n317: \n318:     /** Contruct and add a new edge of the given kind\n319:      * \n320:      * @see org.tigris.gef.graph.MutableGraphModel#connect(java.lang.Object, java.lang.Object, java.lang.Class)\n321:      */\n322:     public Object connect(Object fromPort, Object toPort,\n323: \t\t\t  Class edgeClass) {\n324: \n325:         if (ModelFacade.isAFinalState(fromPort)) {\n326: \t    return null;\n327: \t}\n328:         if (ModelFacade.isAPseudostate(toPort)) {\n329: \t    if ((ModelFacade.INITIAL_PSEUDOSTATEKIND).equals(\n330: \t\t\tModelFacade.getKind(toPort))) {\n331: \t\treturn null;\n332: \t    }\n333: \t}\n334: \n335:         if (edgeClass == (Class) ModelFacade.TRANSITION) {\n336:             Object tr = null;\n337:             Object comp = ModelFacade.getContainer(fromPort);\n338:             tr = StateMachinesFactory.getFactory()\n339:                     .buildTransition(fromPort, toPort);\n340:             if (canAddEdge(tr)) {\n341:                 addEdge(tr);\n342:             } else {\n343:                 ProjectManager.getManager().getCurrentProject().moveToTrash(tr);\n344:                 tr = null;\n345:             }\n346:             return tr;\n347:         } else\n348:             if (edgeClass == CommentEdge.class) {\n349:                 try {\n350:                     Object connection = UmlFactory.getFactory()\n351:                         .buildConnection(edgeClass, fromPort, null, \n352:                                                 toPort, null, null);\n353:                     addEdge(connection);\n354:                     return connection;\n355:                 }\n356:                 catch (Exception ex) {\n357:                     // fail silently                \n358:                 }\n359:                 return null;\n360:             }\n361:             \n362:             else {\n363:                 LOG.debug(\"wrong kind of edge in StateDiagram connect3 \"\n364:                         + edgeClass);\n365:                 return null;\n366:             }\n367:     }\n368: \n369:     ////////////////////////////////////////////////////////////////\n370:     // VetoableChangeListener implementation\n371: \n372:     /**\n373:      * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n374:      */\n375:     public void vetoableChange(PropertyChangeEvent pce) {\n376:         //throws PropertyVetoException\n377: \n378:         if (\"ownedElement\".equals(pce.getPropertyName())) {\n379:             Vector oldOwned = (Vector) pce.getOldValue();\n380:             Object eo = /* (MElementImport) */pce.getNewValue();\n381:             Object me = ModelFacade.getModelElement(eo);\n382:             if (oldOwned.contains(eo)) {\n383:                 LOG.debug(\"model removed \" + me);\n384:                 if (ModelFacade.isAState(me)) removeNode(me);\n385:                 if (ModelFacade.isAPseudostate(me)) removeNode(me);\n386:                 if (ModelFacade.isATransition(me)) removeEdge(me);\n387:             } else {\n388:                 LOG.debug(\"model added \" + me);\n389:             }\n390:         }\n391:     }\n392: \n393:     static final long serialVersionUID = -8056507319026044174L;\n394: \n395:     /**\n396:      * @param newNode\n397:      *            this is the new node that one of the ends is dragged to.\n398:      * @param oldNode\n399:      *            this is the existing node that is already connected.\n400:      * @param edge\n401:      *            this is the edge that is being dragged/rerouted\n402:      * @return true if a transition is being rerouted between two states.\n403:      */\n404:     public boolean canChangeConnectedNode(Object newNode, Object oldNode,\n405:             Object edge) {\n406:         // prevent no changes...\n407:         if (newNode == oldNode) return false;\n408: \n409:         // check parameter types:\n410:         if (!(ModelFacade.isAState(newNode)\n411: \t      || ModelFacade.isAState(oldNode)\n412: \t      || ModelFacade.isATransition(edge))) {\n413: \t    return false;\n414: \t}\n415: \n416:         return true;\n417:     }\n418: \n419:     /**\n420:      * Reroutes the connection to the old node to be connected to the new node.\n421:      * \n422:      * @param newNode\n423:      *            this is the new node that one of the ends is dragged to.\n424:      * @param oldNode\n425:      *            this is the existing node that is already connected.\n426:      * @param edge\n427:      *            this is the edge that is being dragged/rerouted\n428:      * @param isSource\n429:      *            tells us which end is being rerouted.\n430:      */\n431:     public void changeConnectedNode(Object newNode, Object oldNode,\n432:             Object edge, boolean isSource) {\n433: \n434:         if (isSource)\n435:             ModelFacade.setSource(edge, newNode);\n436:         else\n437:             ModelFacade.setTarget(edge, newNode);\n438: \n439:     }\n440: \n441: } /* end class StateDiagramGraphModel */\n442: ",
