   MClass cl = (MClass) createClass();\n986:         // cl.setNamespace(ProjectBrowser.getInstance().getProject()\n987:         // .getModel());\n988:         cl.setName(\"\");\n989:         cl.setStereotype(null);\n990:         cl.setAbstract(false);\n991:         cl.setActive(false);\n992:         cl.setRoot(false);\n993:         cl.setLeaf(false);\n994:         cl.setSpecification(false);\n995:         cl.setVisibility(MVisibilityKind.PUBLIC);\n996:         return cl;\n997:     }\n998: \n999:     /**\n1000:      * Builds a class with a given namespace.\n1001:      *\n1002:      * @param owner the namespace\n1003:      * @return MClass\n1004:      * @see #buildClass()\n1005:      */\n1006:     public Object buildClass(Object owner) {\n1007:         Object clazz = buildClass();\n1008:         if (owner instanceof MNamespace) {\n1009:             nsmodel.getCoreHelper().setNamespace(clazz, /*MNamespace*/ owner);\n1010:         }\n1011:         return clazz;\n1012:     }\n1013: \n1014:     /**\n1015:      * Builds a class with a given name.\n1016:      *\n1017:      * @param name the given name\n1018:      * @return MClass\n1019:      * @see #buildClass()\n1020:      */\n1021:     public Object buildClass(String name) {\n1022:         Object clazz = buildClass();\n1023:         nsmodel.getCoreHelper().setName(clazz, name);\n1024:         return clazz;\n1025:     }\n1026: \n1027:     /**\n1028:      * Builds a class with a given name and namespace.\n1029:      *\n1030:      * @param name the given name\n1031:      * @param owner the namespace\n1032:      * @return MClass\n1033:      * @see #buildClass()\n1034:      */\n1035:     public Object buildClass(String name, Object owner) {\n1036:         Object clazz = buildClass();\n1037:         nsmodel.getCoreHelper().setName(clazz, name);\n1038:         if (owner instanceof MNamespace) {\n1039:             nsmodel.getCoreHelper().setNamespace(clazz, /*MNamespace*/ owner);\n1040:         }\n1041:         return clazz;\n1042:     }\n1043: \n1044:     /**\n1045:      * Builds a default implementation for an interface. The interface\n1046:      * is not owned by any model element by default. Users should not\n1047:      * forget to add ownership.\n1048:      *\n1049:      * @return MInterface\n1050:      */\n1051:     public Object buildInterface() {\n1052: \tMInterface cl = (MInterface) createInterface();\n1053: \t// cl.setNamespace(ProjectBrowser.getInstance().getProject()\n1054: \t// .getModel());\n1055: \tcl.setName(\"\");\n1056: \tcl.setStereotype(null);\n1057: \tcl.setAbstract(false);\n1058: \tcl.setRoot(false);\n1059: \tcl.setLeaf(false);\n1060: \tcl.setSpecification(false);\n1061: \tcl.setVisibility(MVisibilityKind.PUBLIC);\n1062: \treturn cl;\n1063:     }\n1064: \n1065:     /**\n1066:      * Builds an interface with a given namespace.\n1067:      *\n1068:      * @param owner is the owner\n1069:      * @return MInterface\n1070:      * @see #buildInterface()\n1071:      */\n1072:     public Object buildInterface(Object owner) {\n1073: \tMInterface cl = (MInterface) buildInterface();\n1074: \tif (owner instanceof MNamespace) {\n1075: \t    cl.setNamespace((MNamespace) owner);\n1076: \t}\n1077: \treturn cl;\n1078:     }\n1079: \n1080:     /**\n1081:      * Builds an interface with a given name.\n1082:      *\n1083:      * @param name is the given name.\n1084:      * @return MInterface\n1085:      * @see #buildInterface()\n1086:      */\n1087:     public Object buildInterface(String name) {\n1088: \tMInterface cl = (MInterface) buildInterface();\n1089: \tcl.setName(name);\n1090: \treturn cl;\n1091:     }\n1092: \n1093:     /**\n1094:      * Builds an interface with a given name and namespace.\n1095:      *\n1096:      * @param name is the given name\n1097:      * @param owner is the namespace\n1098:      * @return MInterface\n1099:      * @see #buildInterface()\n1100:      */\n1101:     public Object buildInterface(String name, Object owner) {\n1102: \tMInterface cl = (MInterface) buildInterface();\n1103: \tcl.setName(name);\n1104: \tif (owner instanceof MNamespace) {\n1105: \t    cl.setNamespace((MNamespace) owner);\n1106: \t}\n1107: \treturn cl;\n1108:     }\n1109: \n1110:     /**\n1111:      * Builds a datatype with a given name and namespace.\n1112:      *\n1113:      * @param name is the name\n1114:      * @param owner is the namespace\n1115:      * @return an initialized UML DataType instance.\n1116:      */\n1117:     public Object buildDataType(String name, Object owner) {\n1118: \tMDataType dt = (MDataType) createDataType();\n1119: \tdt.setName(name);\n1120: \tif (owner instanceof MNamespace) {\n1121: \t    dt.setNamespace((MNamespace) owner);\n1122: \t}\n1123: \treturn dt;\n1124:     }\n1125: \n1126:     /**\n1127:      * Builds a modelelement dependency between two modelelements.<p>\n1128:      *\n1129:      * @param clientObj is the client\n1130:      * @param supplierObj is the supplier\n1131:      * @return MDependency\n1132:      */\n1133:     public Object buildDependency(Object clientObj,\n1134: \t\t\t\t       Object supplierObj) {\n1135: \n1136: \tMModelElement client = (MModelElement) clientObj;\n1137: \tMModelElement supplier = (MModelElement) supplierObj;\n1138: \tif (client == null\n1139:                 || supplier == null\n1140:                 || client.getNamespace() == null\n1141:                 || supplier.getNamespace() == null) {\n1142: \t    throw new IllegalArgumentException(\"client or supplier is null \"\n1143: \t\t\t\t\t       + \"or their namespaces.\");\n1144: \t}\n1145: \tMDependency dep = (MDependency) createDependency();\n1146: \tdep.addSupplier(supplier);\n1147: \tdep.addClient(client);\n1148: \tif (supplier.getNamespace() != null) {\n1149: \t    dep.setNamespace(supplier.getNamespace());\n1150: \t} else if (client.getNamespace() != null) {\n1151: \t    dep.setNamespace(client.getNamespace());\n1152: \t}\n1153: \treturn dep;\n1154:     }\n1155: \n1156:     /**\n1157:      * Builds a modelelement permission between two modelelements.\n1158:      *\n1159:      * @param clientObj is the client\n1160:      * @param supplierObj is the supplier\n1161:      * @return MPermission\n1162:      */\n1163:     public Object buildPermission(Object clientObj,\n1164: \t\t\t\t       Object supplierObj) {\n1165: \n1166: \tMModelElement client = (MModelElement) clientObj;\n1167: \tMModelElement supplier = (MModelElement) supplierObj;\n1168: \tif (client == null\n1169: \t    || supplier == null\n1170: \t    || client.getNamespace() == null\n1171: \t    || supplier.getNamespace() == null) {\n1172: \t    throw new IllegalArgumentException(\"client or supplier is null \"\n1173: \t\t\t\t\t       + \"or their namespaces.\");\n1174: \t}\n1175: \tMPermission per = (MPermission) createPermission();\n1176: \tper.addSupplier(supplier);\n1177: \tper.addClient(client);\n1178: \tif (supplier.getNamespace() != null) {\n1179: \t    per.setNamespace(supplier.getNamespace());\n1180: \t} else if (client.getNamespace() != null) {\n1181: \t    per.setNamespace(client.getNamespace());\n1182: \t}\n1183: \tnsmodel.getExtensionMechanismsFactory()\n1184: \t    .buildStereotype(per, \"import\", per.getNamespace());\n1185: \treturn per;\n1186:     }\n1187: \n1188:     /**\n1189:      * Builds a generalization between a parent and a child with a given name.\n1190:      *\n1191:      * @param child is the child\n1192:      * @param parent is the parent\n1193:      * @param name is the given name\n1194:      * @return generalization\n1195:      */\n1196:     public Object buildGeneralization(Object child, Object parent,\n1197: \t\t\t\t      String name) {\n1198:         if (child == null\n1199: \t    || parent == null\n1200: \t    || !(child instanceof MGeneralizableElement)\n1201: \t    || !(parent instanceof MGeneralizableElement)) {\n1202:             return null;\n1203:         }\n1204:         Object gen = buildGeneralization(child, parent);\n1205:         if (gen != null) {\n1206:             ((MGeneralization) gen).setName(name);\n1207:         }\n1208:         return gen;\n1209:     }\n1210: \n1211:     /**\n1212:      * Builds a generalization between a parent and a child. Does not check if\n1213:      * multiple inheritance is allowed for the current notation.\n1214:      *\n1215:      * @param child1 is the child\n1216:      * @param parent1 is the parent\n1217:      * @return MGeneralization\n1218:      */\n1219:     public Object buildGeneralization(Object child1, Object parent1) {\n1220:         if (!(child1 instanceof MGeneralizableElement)\n1221: \t    || !(parent1 instanceof MGeneralizableElement)) {\n1222:             throw new IllegalArgumentException();\n1223:         }\n1224: \n1225:         MGeneralizableElement child = (MGeneralizableElement) child1;\n1226:         MGeneralizableElement parent = (MGeneralizableElement) parent1;\n1227: \n1228:         if (parent.getParents().contains(child)) {\n1229:             return null;\n1230:         }\n1231:         Iterator it = parent.getGeneralizations().iterator();\n1232:         while (it.hasNext()) {\n1233:             MGeneralization gen = (MGeneralization) it.next();\n1234:             if (gen.getParent().equals(child)) {\n1235:                 return null;\n1236:             }\n1237:         }\n1238: \n1239:         if (parent.getNamespace() == null) {\n1240:             throw new IllegalArgumentException(\"parent has no namespace\");\n1241:         }\n1242:         if (parent.isLeaf()) {\n1243:             throw new IllegalArgumentException(\"parent is leaf\");\n1244:         }\n1245:         if (child.isRoot()) {\n1246:             throw new IllegalArgumentException(\"child is root\");\n1247:         }\n1248: \n1249:         MGeneralization gen = (MGeneralization) createGeneralization();\n1250:         gen.setParent(parent);\n1251:         gen.setChild(child);\n1252:         if (parent.getNamespace() != null) {\n1253:             gen.setNamespace(parent.getNamespace());\n1254:         } else if (child.getNamespace() != null) {\n1255:             gen.setNamespace(child.getNamespace());\n1256:         }\n1257:         return gen;\n1258:     }\n1259: \n1260: \n1261:     /**\n1262:      * Builds a method with a given name.\n1263:      *\n1264:      * @param name is the given name\n1265:      * @return method\n1266:      */\n1267:     public Object buildMethod(String name) {\n1268:         MMethod method = (MMethod) createMethod();\n1269:         if (method != null) {\n1270:             method.setName(name);\n1271:         }\n1272:         return method;\n1273:     }\n1274: \n1275:     /**\n1276:      * Builds an operation for a classifier.\n1277:      *\n1278:      * @param classifier is the given classifier\n1279:      * @param model is the model to which the class belongs\n1280:      * @param voidType the type of the return parameter\n1281:      * @param propertyChangeListeners the listeners\n1282:      * @return the operation\n1283:      */\n1284:     public Object buildOperation(Object classifier, Object model,\n1285:             Object voidType, Collection propertyChangeListeners) {\n1286:         if (!(classifier instanceof MClassifier)) {\n1287:             throw new IllegalArgumentException(\"Handle is not a classifier\");\n1288:         }\n1289:         MClassifier cls = (MClassifier) classifier;\n1290:         MOperation oper = (MOperation) createOperation();\n1291:         oper.setName(\"newOperation\");\n1292:         oper.setStereotype(null);\n1293:         oper.setOwner(cls);\n1294:         oper.setVisibility(MVisibilityKind.PUBLIC);\n1295:         oper.setAbstract(false);\n1296:         oper.setLeaf(false);\n1297:         oper.setRoot(false);\n1298:         oper.setQuery(false);\n1299:         oper.setOwnerScope(MScopeKind.INSTANCE);\n1300:         // Jaap Branderhorst 6-4-2003 commented out next line since an\n1301:         // operation cannot have two owners.  the owner must be the\n1302:         // owning classifier which must be set via the setOwner\n1303:         // method, not via the namespace.\n1304:         //\n1305:         // oper.setNamespace(cls);\n1306:         oper.setConcurrency(MCallConcurrencyKind.SEQUENTIAL);\n1307: \n1308:         MParameter returnParameter =\n1309:             (MParameter)\n1310:             \tbuildParameter(oper, model, voidType, propertyChangeListeners);\n1311:         returnParameter.setKind(MParameterDirectionKind.RETURN);\n1312:         returnParameter.setName(\"return\");\n1313:         // we set the listeners to the figs here too it would be\n1314:         // better to do that in the figs themselves the\n1315:         // elementlistener for the parameter is allready set in\n1316:         // buildparameter(oper)\n1317:         Iterator it = propertyChangeListeners.iterator();\n1318:         while (it.hasNext()) {\n1319:             PropertyChangeListener listener =\n1320:                 (PropertyChangeListener) it.next();\n1321:             // UmlModelEventPump.getPump().removeModelEventListener(listener,\n1322:             // oper);\n1323:             nsmodel.getModelEventPump().addModelEventListener(listener, oper);\n1324:         }\n1325:         return oper;\n1326:     }\n1327: \n1328:     /**\n1329:      * Builds an operation with a given name for classifier.\n1330:      *\n1331:      * @param cls is the classifier that shall own the operation\n1332:      * @param model is the model that contains the class\n1333:      * @param voidType the type of the return parameter\n1334:      * @param name the given name for the operation\n1335:      * @param propertyChangeListeners the listeners\n1336:      * @return the operation\n1337:      */\n1338:     public Object buildOperation(Object cls, Object model, Object voidType,\n1339:             String name, Collection propertyChangeListeners) {\n1340:         Object oper =\n1341:             buildOperation(cls, model, voidType, propertyChangeListeners);\n1342:         if (oper != null) {\n1343:             ((MOperation) oper).setName(name);\n1344:         }\n1345:         return oper;\n1346:     }\n1347: \n1348:     /**\n1349:      * Constructs a default parameter.\n1350:      *\n1351:      * @return      The newly created parameter.\n1352:      */\n1353:     private Object buildParameter(MModel model, MClassifier voidType) {\n1354:         // this should not be here via the ProjectBrowser but the CoreHelper\n1355:         // should provide this functionality\n1356:         if (voidType.getModel() != model) {\n1357:             voidType.setNamespace(model);\n1358:         }\n1359:         MParameter res =\n1360:             (MParameter) nsmodel.getCoreFactory().createParameter();\n1361:         res.setName(\"\");\n1362:         res.setStereotype(null);\n1363:         res.setType(voidType);\n1364:         res.setKind(MParameterDirectionKind.IN);\n1365:         res.setDefaultValue(null);\n1366: \n1367:         return res;\n1368:     }\n1369: \n1370:     /**\n1371:      * Adds a parameter initialized to default values to a given event\n1372:      * or behavioral feature.\n1373:      *\n1374:      * @param o an event or behavioral feature\n1375:      * @param model the model to which the event or behavioral feature belongs\n1376:      * @param voidType the type of the return parameter\n1377:      * @param propertyChangeListeners the listeners\n1378:      * @return the parameter\n1379:      */\n1380:     public Object buildParameter(Object o, Object model, Object voidType,\n1381:             Collection propertyChangeListeners) {\n1382:         if (o instanceof MEvent) {\n1383:             MEvent event = (MEvent) o;\n1384:             MParameter res =\n1385:                 (MParameter) buildParameter((MModel) model,\n1386:                         (MClassifier) voidType);\n1387:             res.setKind(MParameterDirectionKind.IN);\n1388:             //    removing this next line solves issue 2209\n1389:             //res.setNamespace(event.getNamespace());\n1390:             event.addParameter(res);\n1391:             return res;\n1392:         } else if (o instanceof MBehavioralFeature) {\n1393:             MBehavioralFeature oper = (MBehavioralFeature) o;\n1394:             if (oper == null || oper.getOwner() == null) {\n1395:                 throw new IllegalArgumentException(\n1396:                         \"operation is null or does not have an owner\");\n1397:             }\n1398:             MParameter res =\n1399:                 (MParameter) buildParameter((MModel) model,\n1400:                         (MClassifier) voidType);\n1401:             String name = \"arg\";\n1402:             int counter = 1;\n1403: \n1404:             oper.addParameter(res);\n1405:             Iterator it = oper.getParameters().iterator();\n1406:             while (it.hasNext()) {\n1407:                 MParameter para = (MParameter) it.next();\n1408:                 if ((name + counter).equals(para.getName())) {\n1409:                     counter++;\n1410:                 }\n1411:             }\n1412: \n1413:             res.setName(name + counter);\n1414: \n1415:             // we set the listeners to the figs here too\n1416:             // it would be better to do that in the figs themselves\n1417:             it = propertyChangeListeners.iterator();\n1418:             while (it.hasNext()) {\n1419:                 PropertyChangeListener listener =\n1420:                     (PropertyChangeListener) it.next();\n1421:                 // nsmodel.getModelEventPump()\n1422:                 //\t.removeModelEventListener(listener, res);\n1423:                 nsmodel.getModelEventPump()\n1424:                 \t.addModelEventListener(listener, res);\n1425:             }\n1426:             return res;\n1427:         } else {\n1428:             return null;\n1429:         }\n1430:     }\n1431: \n1432:     /**\n1433:      * Builds a realization between some supplier (for example an\n1434:      * interface in Java) and a client who implements the realization.\n1435:      *\n1436:      * @param clnt is the client\n1437:      * @param spplr is the supplier\n1438:      * @param model the namespace to use if client and\n1439:      *              supplier are of different namespace\n1440:      * @return Object the created abstraction\n1441:      */\n1442:     public Object buildRealization(\n1443:             Object clnt,\n1444:             Object spplr,\n1445:             Object model) {\n1446:         MModelElement client = (MModelElement) clnt;\n1447:         MModelElement supplier = (MModelElement) spplr;\n1448: \tif (client == null\n1449: \t    || supplier == null\n1450: \t    || client.getNamespace() == null\n1451: \t    || supplier.getNamespace() == null) {\n1452: \t    throw new IllegalArgumentException(\"faulty arguments.\");\n1453: \t}\n1454: \tObject realization = createAbstraction();\n1455: \tMNamespace nsc = client.getNamespace();\n1456: \tMNamespace nss = supplier.getNamespace();\n1457: \tMNamespace ns = null;\n1458: \tif (nsc.equals(nss)) {\n1459: \t    ns = nsc;\n1460: \t} else {\n1461: \t    ns = (MNamespace) model;\n1462: \t}\n1463: \tnsmodel.getExtensionMechanismsFactory().buildStereotype(realization,\n1464: \t\t\t\t\t\t\t\t\"realize\", ns);\n1465: \tnsmodel.getCoreHelper().addClientDependency(client, realization);\n1466: \tnsmodel.getCoreHelper().addSupplierDependency(supplier, realization);\n1467: \treturn realization;\n1468:     }\n1469: \n1470:     /**\n1471:      * Builds a usage between some client and a supplier. If client\n1472:      * and supplier do not have the same model, an\n1473:      * {@link IllegalArgumentException} is thrown.\n1474:      *\n1475:      * @param client is the client\n1476:      * @param supplier is the supplier\n1477:      * @return MUsage\n1478:      */\n1479:     public Object buildUsage(Object client, Object supplier) {\n1480: \tif (client == null || supplier == null) {\n1481: \t    throw new IllegalArgumentException(\"In buildUsage null arguments.\");\n1482: \t}\n1483: \tif (!(client instanceof MModelElement)) {\n1484: \t    throw new IllegalArgumentException(\"client ModelElement\");\n1485: \t}\n1486: \tif (!(supplier instanceof MModelElement)) {\n1487: \t    throw new IllegalArgumentException(\"supplier ModelElement\");\n1488: \t}\n1489: \n1490: \tif (((MModelElement) client).getModel()\n1491: \t        != ((MModelElement) supplier).getModel()) {\n1492: \t    throw new IllegalArgumentException(\"To construct a usage, the \"\n1493: \t\t\t\t\t       + \"client and the supplier \"\n1494: \t\t\t\t\t       + \"must be part of the same \"\n1495: \t\t\t\t\t       + \"model.\");\n1496: \t}\n1497: \tMUsage usage = (MUsage) nsmodel.getCoreFactory().createUsage();\n1498: \tusage.addSupplier((MModelElement) supplier);\n1499: \tusage.addClient((MModelElement) client);\n1500: \tif (((MModelElement) supplier).getNamespace() != null) {\n1501: \t    usage.setNamespace(((MModelElement) supplier).getNamespace());\n1502: \t} else if (((MModelElement) client).getNamespace() != null) {\n1503: \t    usage.setNamespace(((MModelElement) client).getNamespace());\n1504: \t}\n1505: \treturn usage;\n1506:     }\n1507: \n1508:     /**\n1509:      * Builds a comment inluding a reference to the given modelelement\n1510:      * to comment.  If the element is null, the comment is still build\n1511:      * since it is not mandatory to have an annotated element in the\n1512:      * comment.\n1513:      *\n1514:      * @param element is the model element\n1515:      * @param model the namespace for the comment\n1516:      * @return MComment\n1517:      */\n1518:     public Object buildComment(Object element, Object model) {\n1519:         if (model == null) {\n1520:             throw new IllegalArgumentException(\"A namespace must be supplied.\");\n1521:         }\n1522:         MModelElement elementToAnnotate = (MModelElement) element;\n1523:         MComment comment = (MComment) createComment();\n1524: \n1525:         MNamespace commentsModel = null;\n1526:         if (eleme