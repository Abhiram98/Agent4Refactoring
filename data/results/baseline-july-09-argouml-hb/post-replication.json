       Object visibility);\n325: \n326:     /**\n327:      * Builds a simply configured association end.\n328:      *\n329:      * @param type the given classifier\n330:      * @param assoc the given association\n331:      * @return the newly build associationend\n332:      */\n333:     Object buildAssociationEnd(Object type, Object assoc);\n334: \n335:     /**\n336:      * Builds a default attribute.\n337:      *\n338:      * @param model The model the attribute belongs to.\n339:      * @param theIntType The type of the attribute.\n340:      * @return The newly built attribute.\n341:      */\n342:     Object buildAttribute(Object model, Object theIntType);\n343: \n344:     /**\n345:      * Builds an attribute owned by some classifier cls. I don't know\n346:      * if this is legal for an interface (purely UML speaking). In\n347:      * this method it is.<p>\n348:      *\n349:      * @param handle the given classifier\n350:      * @param model the enclosing model\n351:      * @param intType the type\n352:      * @param propertyChangeListeners the listeners\n353:      * @return the newly build attribute\n354:      */\n355:     Object buildAttribute(Object handle, Object model, Object intType,\n356:             Collection propertyChangeListeners);\n357: \n358:     /**\n359:      * Builds a default implementation for a class. The class is not owned by\n360:      * any model element by default. Users should not forget to add ownership.\n361:      *\n362:      * @return MClass\n363:      */\n364:     Object buildClass();\n365: \n366:     /**\n367:      * Builds a class with a given namespace.\n368:      *\n369:      * @param owner the namespace\n370:      * @return MClass\n371:      * @see #buildClass()\n372:      */\n373:     Object buildClass(Object owner);\n374: \n375:     /**\n376:      * Builds a class with a given name.\n377:      *\n378:      * @param name the given name\n379:      * @return MClass\n380:      * @see #buildClass()\n381:      */\n382:     Object buildClass(String name);\n383: \n384:     /**\n385:      * Builds a class with a given name and namespace.\n386:      *\n387:      * @param name the given name\n388:      * @param owner the namespace\n389:      * @return MClass\n390:      * @see #buildClass()\n391:      */\n392:     Object buildClass(String name, Object owner);\n393: \n394:     /**\n395:      * Builds a default implementation for an interface. The interface\n396:      * is not owned by any model element by default. Users should not\n397:      * forget to add ownership.\n398:      *\n399:      * @return MInterface\n400:      */\n401:     Object buildInterface();\n402: \n403:     /**\n404:      * Builds an interface with a given namespace.\n405:      *\n406:      * @param owner is the owner\n407:      * @return MInterface\n408:      * @see #buildInterface()\n409:      */\n410:     Object buildInterface(Object owner);\n411: \n412:     /**\n413:      * Builds an interface with a given name.\n414:      *\n415:      * @param name is the given name.\n416:      * @return MInterface\n417:      * @see #buildInterface()\n418:      */\n419:     Object buildInterface(String name);\n420: \n421:     /**\n422:      * Builds an interface with a given name and namespace.\n423:      *\n424:      * @param name is the given name\n425:      * @param owner is the namespace\n426:      * @return MInterface\n427:      * @see #buildInterface()\n428:      */\n429:     Object buildInterface(String name, Object owner);\n430: \n431:     /**\n432:      * Builds a datatype with a given name and namespace.\n433:      *\n434:      * @param name is the name\n435:      * @param owner is the namespace\n436:      * @return an initialized UML DataType instance.\n437:      */\n438:     Object buildDataType(String name, Object owner);\n439:     \n440:     /**\n441:      * @param name is the name\n442:      * @param owner is the namespace\n443:      * @return an initialized UML Enumeration instance\n444:      * @since UML 1.4\n445:      */\n446