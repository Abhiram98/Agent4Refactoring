ass, \"Polygon\",\n129:         Translator.localize(\"misc.primitive.polygon\")));\n130: \n131:     protected static Action _actionSpline =\n132:         new RadioAction(new CmdSetMode(ModeCreateFigSpline.class, \"Spline\",\n133:         Translator.localize(\"misc.primitive.spline\")));\n134: \n135:     protected static Action _actionInk =\n136:         new RadioAction(new CmdSetMode(ModeCreateFigInk.class, \"Ink\",\n137:         Translator.localize(\"misc.primitive.ink\")));\n138: \n139:     ////////////////////////////////////////////////////////////////\n140:     // instance variables\n141:     protected Object _namespace;\n142:     protected DiagramInfo _diagramName = new DiagramInfo(this);\n143: \n144:     private JToolBar toolBar;\n145: \n146:     ////////////////////////////////////////////////////////////////\n147:     // constructors\n148: \n149:     public UMLDiagram() {\n150:         super();\n151:     }\n152: \n153:     public UMLDiagram(Object ns) {\n154:         this();\n155: \n156:         if (!ModelFacade.isANamespace(ns))\n157:             throw new IllegalArgumentException();\n158: \n159:         setNamespace(ns);\n160:     }\n161: \n162:     public UMLDiagram(String diagramName, Object ns) {\n163:         this(ns);\n164:         try {\n165:             setName(diagramName);\n166:         } catch (PropertyVetoException pve) {\n167:             cat.fatal(\"Name not allowed in construction of diagram\");\n168:         }\n169:     }\n170: \n171:     public void initialize(Object owner) {\n172:         super.initialize(owner);\n173:         if (org.argouml.model.ModelFacade.isANamespace(owner))\n174:             setNamespace(owner);\n175:         else\n176:             cat.debug(\"unknown object in UMLDiagram initialize:\" + owner);\n177:     }\n178: \n179:     ////////////////////////////////////////////////////////////////\n180:     // accessors\n181: \n182:     public Object getNamespace() {\n183:         return _namespace;\n184:     }\n185: \n186:     /**\n187:      * sets the namespace of the Diagram, and\n188:      * adds the diagram as a listener of its namspace in the UML model.\n189:      * (so that it can delete itself when the model element is deleted).\n190:      */\n191:     public void setNamespace(Object ns) {\n192:         if (!ModelFacade.isANamespace(ns)) {\n193:             cat.error(\"Not a namespace\");\n194:             cat.error(ns);\n195:             throw new IllegalArgumentException(\"Given object not a namespace\");\n196:         }\n197:         _namespace = ns;\n198:         // add the diagram as a listener to the namspace so\n199:         // that when the namespace is remove()d the diagram is deleted also.\n200:         UmlModelEventPump.getPump().addModelEventListener(\n201:             this,\n202:             _namespace,\n203:             UmlModelEventPump.REMOVE);\n204:     }\n205: \n206:     public String getClassAndModelID() {\n207:         String s = super.getClassAndModelID();\n208:         if (getOwner() == null)\n209:             return s;\n210:         String id = ModelFacade.getUUID(getOwner());\n211:         return s + \"|\" + id;\n212:     }\n213: \n214:     // TODO: should be overwritten by each subclass of UMLDiagram\n215: \n216:     public Object getOwner() {\n217:         return getNamespace();\n218:     }\n219: \n220:     public void setName(String n) throws PropertyVetoException {\n221:         super.setName(n);\n222:         _diagramName.updateName();\n223:     }\n224: \n225:     static final long serialVersionUID = -401219134410459387L;\n226: \n227:     /**\n228:      * Get the toolbar for the diagram\n229:      * @return the diagram toolbar\n230:      */\n231:     public JToolBar getJToolBar() {\n232:         if (toolBar == null) {\n233:             initToolBar();\n234:         }\n235:         return toolBar;\n236:     }\n237: \n238:     /**\n239:      * Create the toolbar based on actions for the spcific diagram\n240:      * subclass.\n241:      * @see org.tigris.gef.base.Diagram#initToolBar()\n242:      */\n243:     public void initToolBar() {\n244:         toolBar =\n245: \t    ToolBarFactory.createToolBar(true /*rollover*/,\n246: \t\t\t\t\t getActions(),\n247: \t\t\t\t\t false /*floating*/);\n248:     }\n249: \n250:     /**\n251:      * Return actions available for building toolbar or similar.\n252:      * @return an array of available actions.\n253:      */\n254:     public Object[] getActions() {\n255:         Object manipulateActions[] = getManipulateActions();\n256:         Object umlActions[] = getUmlActions();\n257:         Object shapeActions[] = getShapeActions();\n258: \n259:         Object actions[] =\n260:             new Object[manipulateActions.length\n261:                 + umlActions.length\n262:                 + shapeActions.length];\n263: \n264:         int posn = 0;\n265:         System.arraycopy(\n266:             manipulateActions,\n267:             0,\n268:             actions,\n269:             posn,\n270:             manipulateActions.length);\n271:         posn += manipulateActions.length;\n272:         System.arraycopy(umlActions, 0, actions, posn, umlActions.length);\n273:         posn += umlActions.length;\n274:         System.arraycopy(shapeActions, 0, actions, posn, shapeActions.length);\n275: \n276:         return actions;\n277:     }\n278: \n279:     /**\n280:      * Implement on the ancestor to get actions to populate toolbar.\n281:      */\n282:     protected abstract Object[] getUmlActions();\n283: \n284:     private Object[] getManipulateActions() {\n285:         Object actions[] =\n286:         {\n287: \t    new RadioAction(_actionSelect),\n288: \t    new RadioAction(_actionBroom),\n289: \t    null\n290: \t};\n291:         return actions;\n292:     }\n293: \n294:     private Object[] getShapeActions() {\n295:         Object actions[] = {\n296: \t    null, getShapePopupActions(),\n297: \t};\n298:         return actions;\n299:     }\n300: \n301:     private Object[] getShapePopupActions() {\n302:         Object actions[][] = {\n303: \t    {\n304: \t\t_actionRectangle, _actionRRectangle\n305: \t    },\n306: \t    {\n307:                 _actionCircle, _actionLine }, {\n308:                 _actionText, _actionPoly }, {\n309:                 _actionSpline, _actionInk }\n310:         };\n311: \n312:         return actions;\n313:     }\n314: \n315:     /**\n316:      * This diagram listens to events from is namespace ModelElement;\n317:      * When the modelelement is removed, we also want to delete this\n318:      * diagram too.  <p>\n319:      *\n320:      * There is also a risk that if this diagram was the one shown in\n321:      * the diagram panel, then it will remain after it has been\n322:      * deleted. so we need to deselect this diagram.\n323:      */\n324:     public void removed(MElementEvent e) {\n325:         Object newTarget =\n326:             ProjectManager.getManager().getCurrentProject().getDiagrams().get(\n327:                 0);\n328:         TargetManager.getInstance().setTarget(newTarget);\n329:         UmlModelEventPump.getPump().removeModelEventListener(\n330:             this,\n331:             _namespace,\n332:             UmlModelEventPump.REMOVE);\n333:         ProjectManager.getManager().getCurrentProject().moveToTrash(this);\n334: \n335:     }\n336: \n337:     /**\n338:      * not used the UMLDiagram is only interested in the removed() event.\n339:      */\n340:     public void propertySet(MElementEvent e) {\n341:     }\n342: \n343:     /**\n344:      * not used the UMLDiagram is only interested in the removed() event.\n345:      */\n346:     public void roleAdded(MElementEvent e) {\n347:     }\n348: \n349:     /**\n350:      * not used the UMLDiagram is only interested in the removed() event.\n351:      */\n352:     public void roleRemoved(MElementEvent e) {\n353:     }\n354: \n355:     /**\n356:      * not used the UMLDiagram is only interested in the removed() event.\n357:      */\n358:     public void listRoleItemSet(MElementEvent e) {\n359:     }\n360: \n361:     /**\n362:      * not used the UMLDiagram is only interested in the removed() event.\n363:      */\n364:     public void recovered(MElementEvent e) {\n365:     }\n366: \n367:     /**\n368:      * Removes the UMLDiagram and all the figs on it as listener to \n369:      * UmlModelEventPump. Is called by setTarget in TabDiagram to improve \n370:      * performance. \n371:      *\n372:      */\n373:     public void removeAsTarget() {\n374:         Enumeration elems = elements();\n375:         UmlModelEventPump pump = UmlModelEventPump.getPump();\n376:         while (elems.hasMoreElements()) {\n377:             Object o = elems.nextElement();\n378:             if (ModelFacade.isAElementListener(o)) {\n379:                 MElementListener listener = (MElementListener) o;\n380:                 Fig fig = (Fig) o;\n381:                 pump.removeModelEventListener(listener, fig.getOwner());\n382:             }\n383:         }\n384:         pump.removeModelEventListener(this, getNamespace());\n385: \n386:     }\n387: \n388:     /**\n389:      * Adds the UMLDiagram and all the figs on it as listener to\n390:      * UmlModelEventPump.  Together with removeAsModelListener this is\n391:      * a performance improvement.\n392:      *\n393:      */\n394:     public void setAsTarget() {\n395:         Enumeration elems = elements();\n396:         while (elems.hasMoreElements()) {\n397:             Fig fig = (Fig) elems.nextElement();\n398:             if (org.argouml.model.ModelFacade.isAElementListener(fig)) {\n399:                 Object owner = fig.getOwner();\n400:                 // pump.addModelEventListener((MElementListener)fig, owner);\n401:                 // this will make sure all the correct event listeners are set. \n402:                 fig.setOwner(null);\n403:                 fig.setOwner(owner);\n404:             }\n405:         }\n406:     }\n407: \n408:     /**\n409:      * Set all toolbar buttons to unselected other then the toolbar button\n410:      * with the supplied action.\n411:      */\n412:     public void deselectOtherTools(Action otherThanAction) {\n413:         //cat.debug(\"Looking for action \" + otherThanAction);\n414:         int toolCount = toolBar.getComponentCount();\n415:         for (int i = 0; i < toolCount; ++i) {\n416:             Component c = toolBar.getComponent(i);\n417:             if (c instanceof ToolButton) {\n418:                 ToolButton tb = (ToolButton) c;\n419:                 Action action = tb.getRealAction();\n420:                 if (action instanceof RadioAction) {\n421:                     action = ((RadioAction) action).getAction();\n422:                 }\n423:                 Action otherAction = otherThanAction;\n424:                 if (otherThanAction instanceof RadioAction) {\n425:                     otherAction = ((RadioAction) otherThanAction).getAction();\n426:                 }\n427:                 if (!action.equals(otherAction)) {\n428:                     //cat.debug(\"Unselecting \" + tb);\n429:                     tb.setSelected(false);\n430:                     ButtonModel bm = tb.getModel();\n431:                     bm.setRollover(false);\n432:                     bm.setSelected(false);\n433:                     bm.setArmed(false);\n434:                     bm.setPressed(false);\n435:                     tb.setBorderPainted(false);\n436:                 } else {\n437:                     //cat.debug(\"Selecting \" + tb);\n438:                     tb.setSelected(true);\n439:                     ButtonModel bm = tb.getModel();\n440:                     bm.setRollover(true);\n441:                     tb.setBorderPainted(true);\n442:                 }\n443:             }\n444:         }\n445:     }\n446: \n447:     /**\n448:      * Set all toolbar buttons to unselected other then the toolbar button\n449:      * with the supplied action.\n450:      */\n451:     public void deselectAllTools() {\n452:         int toolCount = toolBar.getComponentCount();\n453:         for (int i = 0; i < toolCount; ++i) {\n454:             Component c = toolBar.getComponent(i);\n455:             if (c instanceof ToolButton) {\n456:                 ToolButton tb = (ToolButton) c;\n457:                 Action action = tb.getRealAction();\n458:                 if (action instanceof RadioAction) {\n459:                     action = ((RadioAction) action).getAction();\n460:                 }\n461:                 tb.setSelected(false);\n462:                 ButtonModel bm = tb.getModel();\n463:                 bm.setRollover(false);\n464:                 bm.setSelected(false);\n465:                 bm.setArmed(false);\n466:                 bm.setPressed(false);\n467:                 tb.setBorderPainted(false);\n468:             }\n469:         }\n470:     }\n471: } /* end class UMLDiagram */\n472: \n473: ",
