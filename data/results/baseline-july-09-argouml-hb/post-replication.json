        break;\n1257:                         } else if (\"=\".equals(token)) {\n1258:                             if (propvalue != null)\n1259:                                 throw new ParseException(\"Property \" + propname\n1260:                                         + \" cannot have two values\", st\n1261:                                         .getTokenIndex());\n1262:                             propvalue = \"\";\n1263:                         } else if (propvalue == null) {\n1264:                             propname += token;\n1265:                         } else {\n1266:                             propvalue += token;\n1267:                         }\n1268:                     }\n1269:                     if (propname.length() > 0) {\n1270:                         properties.add(propname);\n1271:                         properties.add(propvalue);\n1272:                     }\n1273:                 } else if (\":\".equals(token)) {\n1274:                     hasColon = true;\n1275:                     hasEq = false;\n1276:                 } else if (\"=\".equals(token)) {\n1277:                     if (value != null)\n1278:                         throw new ParseException(\"Attribute cannot have two \"\n1279:                                 + \"default values\", st.getTokenIndex());\n1280:                     value = \"\";\n1281:                     hasColon = false;\n1282:                     hasEq = true;\n1283:                 } else {\n1284:                     if (hasColon) {\n1285:                         if (type != null)\n1286:                             throw new ParseException(\n1287:                                     \"Attribute cannot have two\" + \" types\", st\n1288:                                             .getTokenIndex());\n1289:                         if (token.length() > 0\n1290:                                 && (token.charAt(0) == '\\\"' \n1291:                                     || token.charAt(0) == '\\''))\n1292:                             throw new ParseException(\"Type cannot be quoted\",\n1293:                                     st.getTokenIndex());\n1294:                         if (token.length() > 0 && token.charAt(0) == '(')\n1295:                             throw new ParseException(\"Type cannot be an \"\n1296:                                     + \"expression\", st.getTokenIndex());\n1297:                         type = token;\n1298:                     } else if (hasEq) {\n1299:                         value += token;\n1300:                     } else {\n1301:                         if (name != null && visibility != null)\n1302:                             throw new ParseException(\"Extra text in Attribute\",\n1303:                                     st.getTokenIndex());\n1304:                         if (token.length() > 0\n1305:                                 && (token.charAt(0) == '\\\"' \n1306:                                     || token.charAt(0) == '\\''))\n1307:                             throw new ParseException(\n1308:                                     \"Name or visibility cannot\" + \" be quoted\",\n1309:                                     st.getTokenIndex());\n1310:                         if (token.length() > 0 && token.charAt(0) == '(')\n1311:                             throw new ParseException(\n1312:                                     \"Name or visibility cannot\"\n1313:                                             + \" be an expression\", st\n1314:                                             .getTokenIndex());\n1315: \n1316:                         if (name == null\n1317:                                 && visibility == null\n1318:                                 && token.length() > 1\n1319:                                 && VISIBILITYCHARS.indexOf(token.charAt(0)) \n1320:                                                         >= 0) {\n1321:                             visibility = token.substring(0, 1);\n1322:                             token = token.substring(1);\n1323:                         }\n1324: \n1325:                         if (name != null) {\n1326:                             visibility = name;\n1327:                             name = token;\n1328:                         } else {\n1329:                             name = token;\n1330:                         }\n1331:                     }\n1332:                 }\n1333:             }\n1334:         } catch (NoSuchElementException nsee) {\n1335:             throw new ParseException(\"Unexpected end of attribute\", s.length());\n1336:         } catch (ParseException pre) {\n1337:             throw pre;\n1338:         }\n1339: \n1340:         LOG.debug(\"ParseAttribute [name: \" + name + \" visibility: \"\n1341:                 + visibility + \" type: \" + type + \" value: \" + value\n1342:                 + \" stereo: \" + stereotype + \" mult: \" + multiplicity);\n1343: \n1344:         if (properties != null) {\n1345:             for (int i = 0; i + 1 < properties.size(); i += 2) {\n1346:                 LOG.debug(\"\\tProperty [name: \" + properties.get(i) + \" = \"\n1347:                         + properties.get(i + 1) + \"]\");\n1348:             }\n1349:         }\n1350: \n1351:         if (visibility != null) {\n1352:             short vis = getVisibility(visibility.trim());\n1353:             ModelFacade.setVisibility(attr, vis);\n1354:         }\n1355: \n1356:         if (name != null)\n1357:             ModelFacade.setName(attr, name.trim());\n1358:         else if (ModelFacade.getName(attr) == null\n1359:                 || \"\".equals(ModelFacade.getName(attr)))\n1360:             ModelFacade.setName(attr, \"anonymous\");\n1361: \n1362:         if (type != null) {\n1363:             Object ow = ModelFacade.getOwner(attr);\n1364:             Object ns = null;\n1365:             if (ow != null && ModelFacade.getNamespace(ow) != null)\n1366:                 ns = ModelFacade.getNamespace(ow);\n1367:             else\n1368:                 ns = ModelFacade.getModel(attr);\n1369:             ModelFacade.setType(attr, getType(type.trim(), ns));\n1370:         }\n1371: \n1372:         if (value != null) {\n1373:             Object initExpr = UmlFactory.getFactory().getDataTypes()\n1374:                     .createExpression(Notation.getDefaultNotation().toString(),\n1375:                             value.trim());\n1376:             ModelFacade.setInitialValue(attr, initExpr);\n1377:         }\n1378: \n1379:         if (multiplicity != null) {\n1380:             try {\n1381:                 ModelFacade\n1382:                         .setMultiplicity(attr, UmlFactory.getFactory()\n1383:                                 .getDataTypes().createMultiplicity(\n1384:                                         multiplicity.trim()));\n1385:             } catch (IllegalArgumentException iae) {\n1386:                 throw new ParseException(\"Bad multiplicity (\" + iae + \")\",\n1387:                         multindex);\n1388:             }\n1389:         }\n1390: \n1391:         if (properties != null)\n1392:             setProperties(attr, properties, attributeSpecialStrings);\n1393: \n1394:         if (stereotype != null) {\n1395:             stereotype = stereotype.trim();\n1396:             Object stereo = getStereotype(attr, stereotype);\n1397:             if (stereo != null)\n1398:                 ModelFacade.setStereotype(attr, stereo);\n1399:             else if (\"\".equals(stereotype))\n1400:                 ModelFacade.setStereotype(attr, null);\n1401:         }\n1402:     }\n1403: \n1404:     /**\n1405:      * Finds the classifier associated with the type named in name.\n1406:      * \n1407:      * @param name\n1408:      *            The name of the type to get.\n1409:      * @param defaultSpace\n1410:      *            The default name-space to place the type in.\n1411:      * @return The classifier associated with the name.\n1412:      */\n1413:     private Object getType(String name, Object defaultSpace) {\n1414:         Object type = null;\n1415:         Project p = ProjectManager.getManager().getCurrentProject();\n1416:         // Should we be getting this from the GUI? BT 11 aug 2002\n1417:         type = p.findType(name, false);\n1418:         if (type == null) { // no type defined yet\n1419:             type = UmlFactory.getFactory().getCore().buildClass(name,\n1420:                     defaultSpace);\n1421:         }\n1422:         if (ModelFacade.getModel(type) != p.getModel()\n1423:                 && !ModelManagementHelper.getHelper().getAllNamespaces(\n1424:                        p.getModel()).contains(ModelFacade.getNamespace(type))) {\n1425:             type = ModelManagementHelper.getHelper().getCorrespondingElement(\n1426:                     type, ModelFacade.getModel(defaultSpace));\n1427:         }\n1428:         return type;\n1429:     }\n1430: \n1431:     /**\n1432:      * Finds a visibility for the visibility specified by name. If no known\n1433:      * visibility can be deduced, private visibility is used.\n1434:      * \n1435:      * @param name\n1436:      *            The Java name of the visibility.\n1437:      * @return A visibility corresponding to name.\n1438:      */\n1439:     private short getVisibility(String name) {\n1440:         if (\"+\".equals(name) || \"public\".equals(name))\n1441:             return ModelFacade.ACC_PUBLIC;\n1442:         else if (\"#\".equals(name) || \"protected\".equals(name))\n1443:             return ModelFacade.ACC_PROTECTED;\n1444:         else\n1445:             /* if (\"-\".equals(name) || \"private\".equals(name)) */\n1446:             return ModelFacade.ACC_PRIVATE;\n1447:     }\n1448: \n1449:     /**\n1450:      * Applies a Vector of name value pairs of properties to a model element.\n1451:      * The name is treated as the tag of a tagged value unless it is one of the\n1452:      * PropertySpecialStrings, in which case the action of the\n1453:      * PropertySpecialString is invoked.\n1454:      * \n1455:      * @param elem\n1456:      *            An model element to apply the properties to.\n1457:      * @param prop\n1458:      *            A Vector with name, value pairs of properties.\n1459:      * @param spec\n1460:      *            An array of PropertySpecialStrings to use.\n1461:      */\n1462:     private void setProperties(Object elem, Vector prop,\n1463:             PropertySpecialString spec[]) {\n1464:         String name;\n1465:         String value;\n1466:         int i, j;\n1467: \n1468:     nextProp: \n1469:         for (i = 0; i + 1 < prop.size(); i += 2) {\n1470:             name = (String) prop.get(i);\n1471:             value = (String) prop.get(i + 1);\n1472: \n1473:             if (name == null)\n1474:                 continue;\n1475: \n1476:             name = name.trim();\n1477:             if (value != null)\n1478:                 value = value.trim();\n1479: \n1480:             for (j = i + 2; j < prop.size(); j += 2) {\n1481:                 String s = (String) prop.get(j);\n1482:                 if (s != null && name.equalsIgnoreCase(s.trim()))\n1483:                     continue nextProp;\n1484:             }\n1485: \n1486:             if (spec != null) {\n1487:                 for (j = 0; j < spec.length; j++)\n1488:                     if (spec[j].invoke(elem, name, value))\n1489:                         continue nextProp;\n1490:             }\n1491: \n1492:             ModelFacade.setTaggedValue(elem, name, value);\n1493:         }\n1494:     }\n1495: \n1496:     /**\n1497:      * Recursively search a hive of a model for a stereotype with the name given\n1498:      * in name.\n1499:      * \n1500:      * @param obj\n1501:      *            The model element to be suitable for.\n1502:      * @param root\n1503:      *            The model element to search from.\n1504:      * @param name\n1505:      *            The name of the stereotype to search for.\n1506:      * @return An stereotype named name, or null if none is found.\n1507:      */\n1508:     private Object recFindStereotype(Object obj, Object root, String name) {\n1509:         Object stereo;\n1510: \n1511:         if (root == null)\n1512:             return null;\n1513: \n1514:         if (ModelFacade.isAStereotype(root)\n1515:                 && name.equals(ModelFacade.getName(root))) {\n1516:             if (ExtensionMechanismsHelper.getHelper().isValidStereoType(obj,\n1517:             /* (MStereotype) */root))\n1518:                 return root;\n1519:             else\n1520:                 LOG.debug(\"Missed stereotype \"\n1521:                                 + ModelFacade.getBaseClass(root));\n1522:         }\n1523: \n1524:         if (!ModelFacade.isANamespace(root))\n1525:             return null;\n1526: \n1527:         Collection ownedElements = ModelFacade.getOwnedElements(root);\n1528: \n1529:         if (ownedElements == null) {\n1530:             return null;\n1531:         }\n1532: \n1533:         // Loop through each element in the namespace, recursing.\n1534: \n1535:         Iterator iter = ownedElements.iterator();\n1536: \n1537:         while (iter.hasNext()) {\n1538:             stereo = recFindStereotype(obj, iter.next(), name);\n1539:             if (stereo != null)\n1540:                 return stereo;\n1541:         }\n1542:         return null;\n1543:     }\n1544: \n1545:     /**\n1546:      * Finds a stereotype named name either in the subtree of the model rooted\n1547:      * at root, or in the the ProfileJava model.\n1548:      * \n1549:      * <p>\n1550:      * TODO: Should create the stereotype under root if it isn't found.\n1551:      * \n1552:      * @param obj\n1553:      *            A MModelElements to find a suitable stereotype for.\n1554:      * @param name\n1555:      *            The name of the stereotype to search for.\n1556:      * @return A stereotype named name, or possibly null.\n1557:      */\n1558:     private Object getStereotype(Object obj, String name) {\n1559:         Object root = ModelFacade.getModel(obj);\n1560:         Object stereo;\n1561: \n1562:         stereo = recFindStereotype(obj, root, name);\n1563:         if (stereo != null)\n1564:             return stereo;\n1565: \n1566:         stereo = recFindStereotype(obj, ProfileJava.getInstance()\n1567:                 .getProfileModel(), name);\n1568: \n1569:         if (stereo != null)\n1570:             return ModelManagementHelper.getHelper().getCorrespondingElement(\n1571:                     stereo, root);\n1572: \n1573:         if (root != null && name.length() > 0) {\n1574:             stereo = ExtensionMechanismsFactory.getFactory().buildStereotype(\n1575:                     obj, name, root);\n1576:         }\n1577: \n1578:         return stereo;\n1579:     }\n1580: \n1581: \n1582:     /**\n1583:      * Parse user input for state bodies and assign the individual lines to\n1584:      * according actions or transistions. The user input consists of multiple\n1585:      * lines like:<br>\n1586:      *   action-label / action-expression \n1587:      * <br> or the format of a regular\n1588:      * transition - see parseTransition(). <p>\n1589:      * \n1590:      * \"action-label\" stands for one of \"entry\", \"do\" and \"exit\". \n1591:      * The words \"entry\", \"do\" and \"exit\" are case-independent.\n1592:      * \n1593:      * @param st  The State object.\n1594:      * @param s   The string to parse.\n1595:      * @throws ParseException when there is a syntax problem, \n1596:      *         e.g. non-matching brackets () or []\n1597:      */\n1598:     public void parseStateBody(Object st, String s) throws ParseException {\n1599:         boolean foundEntry = false;\n1600:         boolean foundExit = false;\n1601:         boolean foundDo = false;\n1602: \n1603:         /* Generate all the existing internal transitions, \n1604:          * so that we can compare them as text with the newly entered ones.\n1605:          */\n1606:         ModelElementInfoList internalsInfo = \n1607:             new ModelElementInfoList(\n1608:                     ModelFacade.getInternalTransitions(st));\n1609:                 \n1610:         StringTokenizer lines = new StringTokenizer(s, \"\\n\\r\");\n1611:         while (lines.hasMoreTokens()) {\n1612:             String line = lines.nextToken().trim();\n1613:             /* Now let's check if the new line is already present in \n1614:              * the old list of internal transitions; if it is, then\n1615:              * mark the old one to be retained (i.e. do not create a new one), \n1616:              * if it isn't, continue with parsing:\n1617:              */\n1618:             if (!internalsInfo.checkRetain(line)) {\n1619:                 if (line.toLowerCase().startsWith(\"entry\") \n1620:                         && line.substring(5).trim().startsWith(\"/\")) {\n1621:                     parseStateEntryAction(st, line);\n1622:                     foundEntry = true;\n1623:                 } else if (line.toLowerCase().startsWith(\"exit\") \n1624:                         && line.substring(4).trim().startsWith(\"/\")) {\n1625:                     parseStateExitAction(st, line);\n1626:                     foundExit = true;\n1627:                 } else if (line.toLowerCase().startsWith(\"do\") \n1628:                         && line.substring(2).trim().startsWith(\"/\")) {\n1629:                     parseStateDoAction(st, line);\n1630:                     foundDo = true;\n1631:                 } else {\n1632:                     Object t = UmlFactory.getFactory().getStateMachines()\n1633:                         .buildInternalTransition(st);\n1634:                     if (t == null)\n1635:                         continue;\n1636:                     /* TODO: If the next line trows an exception, then what \n1637:                      * do we do with the remainder of the \n1638:                      * parsed/to be parsed lines? */\n1639:                     parseTransition(t, line);\n1640:                     /* Add this new one, and mark it to be retained: */\n1641:                     internalsInfo.add(t, true);\n1642:                 }\n1643:             }\n1644:         }\n1645: \n1646:         if (!foundEntry) {\n1647:             delete(ModelFacade.getEntry(st));\n1648:         }\n1649:         if (!foundExit) {\n1650:             delete(ModelFacade.getExit(st));\n1651:         }\n1652:         if (!foundDo) {\n1653:             delete(ModelFacade.getDoActivity(st));\n1654:         }\n1655: \n1656:         /* Process the final list of internal transitions, \n1657:          * and hook it to the state: */\n1658:         ModelFacade.setInternalTransitions(st, internalsInfo.finalisedList());\n1659:     }\n1660: \n1661:     /**\n1662:      * This class manages a list of UML modelelements that existed \n1663:      * before and after the parseXxxxx() function was called.\n1664:      * It has all the knowledge to deal with additions and removals.\n1665:      * \n1666:      * @author MVW\n1667:      */\n1668:     class ModelElementInfoList {\n1669:         /** the list that we maintain */\n1670:         private Collection theList;\n1671: \n1672:         /**\n1673:          * An item in a list, maintains all info about one UML object, \n1674:          * its generated version (i.e. textual representation), \n1675:          * and if it needs to be retained after parsing.<p>\n1676:          * \n1677:          * @author MVW\n1678:          */\n1679:         class InfoItem {\n1680:             private String generated;\n1681:             private Object umlObject;\n1682:             private boolean retainIt = false;\n1683:             \n1684:             InfoItem(Object obj) {\n1685:                 umlObject = obj;\n1686:                 generated = \n1687:                     GeneratorDisplay.getInstance().generate(obj); \n1688:             }\n1689:             InfoItem(Object obj, boolean r) {\n1690:                 this(obj);\n1691:                 retainIt = r;\n1692:             }\n1693: \n1694:             /**\n1695:              * @return the generated string representation\n1696:              */\n1697:             String getGenerated() {\n1698:                 return generated;\n1699:             }\n1700: \n1701:             /**\n1702:              * @return the UML Object\n1703:              */\n1704:             Object getUmlObject() {\n1705:                 return umlObject;\n1706:             }\n1707: \n1708:             /**\n1709:              * Retain this UML object.\n1710:              */\n1711:             void retain() {\n1712:                 retainIt = true;\n1713:             }\n1714: \n1715:             /**\n1716:              * @return true if the UML object is to be retained, \n1717:              *         false if it is to be deleted\n1718:              */\n1719:             boolean isRetained() {\n1720:                 return retainIt;\n1721:             }\n1722:         }\n1723:         \n1724:         /**\n1725:          * The constructor.\n1726:          * \n1727:          * @param c the collection of the UML objects\n1728:          *          that were present before\n1729:          */\n1730:         ModelElementInfoList(Collection c) {\n1731:             theList = new ArrayList();\n1732:             Iterator i = c.iterator();\n1733:             while (i.hasNext()) {\n1734:                 theList.add(new InfoItem(i.next()));\n1735:             }\n1736:         }\n1737: \n1738:         /**\n1739:          * @param obj the UML object \n1740:          * @param r true if this UML object needs to be retained\n1741:          */\n1742:         void add(Object obj, boolean r) {\n1743:             theList.add(new InfoItem(obj, r));\n1744:         }\n1745:                     \n1746:         /**\n1747:          * Check the given textual description, \n1748:          * and if already present in the list, then retain it.\n1749:          * @param line the given textual description \n1750:          * @return true if the item was already present in the list\n1751:          */\n1752:         boolean checkRetain(String line) {\n1753:             Iterator i = theList.iterator();\n1754:             while (i.hasNext()) {\n1755:                 InfoItem tInfo = \n1756:                     (InfoItem) i.next();\n1757:                 if (tInfo.getGenerated().equals(line)) {\n1758:                     tInfo.retain();\n1759:                     return true;\n1760:                 }\n1761:             }\n1762:             return false;\n1763:         }\n1764:         \n1765:         /**\n1766:          * Finish the procedure, by deleting the UML model items \n1767:          * that are not to be retained, and return a collection \n1768:          * of the ones to be retained. \n1769:          * This method should only be called once!\n1770:          * @return the UML objects that survive.\n1771:          */\n1772:         Collection finalisedList() {\n1773:             // don't forget to remove old internals!\n1774:             Collection newModelElementsList = new ArrayList();\n1775:             Iterator i = theList.iterator();\n1776:             while (i.hasNext()) {\n1777:                 InfoItem tInfo = \n1778:                     (InfoItem) i.next();\n1779:                 if (tInfo.isRetained()) {\n1780:                     newModelElementsList.add(tInfo.getUmlObject());\n1781:                 } else {\n1782:                     delete(tInfo.getUmlObject());\n1783:                 }\n1784:             }\n1785:             // Make next accesses to this instance predictable:\n1786:             theList.clear(); \n1787:             // and hook in the new ones:\n1788:             return newModelElementsList;            \n1789:         }\n1790:     }\n1791: \n1792: \n1793:     /**\n1794:      * Parse a line of the form: \"entry /action\" and create an action. \n1795:      * We do not need to check for the presence of the word \"entry\" - that \n1796:      * is done by the caller.\n1797:      * \n1798:      * @param st  the state object\n1799:      * @param s   the string to be parsed\n1800:      */\n1801:     private void parseStateEntryAction(Object st, String s) {\n1802:         if (s.indexOf(\"/\") > -1)\n1803:             s = s.substring(s.indexOf(\"/\") + 1).trim();\n1804:         Object oldEntry = ModelFacade.getEntry(st);\n1805:         if (oldEntry == null) {\n1806:             ModelFacade.setEntry(st, buildNewCallAction(s));\n1807:         } else {\n1808:             updateAction(oldEntry, s);\n1809:         }\n1810:     }\n1811: \n1812:     /**\n1813:      * Parse a line of the form: \"exit /action\" and create an action. \n1814:      * We do not need to check for the presence of the word \"exit\" - that \n1815:      * is done by the caller.\n1816:      * \n1817:      * @param st\n1818:      *            the state object\n1819:      * @param s\n1820:      *            the string to be parsed\n1821:      */\n1822:     private void parseStateExitAction(Object st, String s) {\n1823:         if (s.indexOf(\"/\") > -1)\n1824:             s = s.substring(s.indexOf(\"/\") + 1).trim();\n1825:         Object oldExit = ModelFacade.getExit(st);\n1826:         if (oldExit == null) {\n1827:             ModelFacade.setExit(st, buildNewCallAction(s));\n1828:         } else {\n1829:             updateAction(oldExit, s);\n1830:         }\n1831:     }\n1832: \n1833:     /**\n1834:      * Parse a line of the form: \"do /action\" and create an action. \n1835:      * We do not need to check for the presence of the word \"do\" - that \n1836:      * is done by the caller.\n1837:      * \n1838:      * @param st  the state object\n1839:      * @param s   the string to be parsed\n1840:      */\n1841:     private void parseStateDoAction(Object st, String s) {\n1842:         if (s.indexOf(\"/\") > -1)\n1843:             s = s.substring(s.indexOf(\"/\") + 1).trim();\n1844:         Object oldDo = ModelFacade.getDoActivity(st);\n1845:         if (oldDo == null) {\n1846:             ModelFacade.setDoActivity(st, buildNewCallAction(s));\n1847:         } else {\n1848:             updateAction(oldDo, s);\n1849:         }\n1850:     }\n1851: \n1852:     /**\n1853:      * Parse a transition description line of the form:<br>\n1854:      *    \"event-signature [guard-condition] / action-expression\". <p> \n1855:      * \n1856:      * If the last character of this line\n1857:      * is a \";\", then it is ignored.<p>\n1858:      *  \n1859:      * The \"event-signature\" may be one of the 4\n1860:      * formats:<p> \n1861:      *      ChangeEvent: \"when(condition)\"   <br> \n1862:      *      TimeEvent: \"after(duration)\"     <br>\n1863:      *      CallEvent: \"a(parameter-list)\".  <br>\n1864:      *      SignalEvent: any string without ().<p>\n1865:      * \n1866:      * Remark: The UML standard does not make a distinction between \n1867:      * the syntax of a CallEvent and SignalEvent: \n1868:      * both may have parameters between (). \n1869:      * For simplicity and user-friendlyness, we chose for this distinction.\n1870:      * If a user wants parameters for a SignalEvent, \n1871:      * then he may add them in the properties panels, but not on the diagram.<p>\n1872:      * \n1873:      * An alternative solution would be to create a CallEvent by default, \n1874:      * and when editing an existing event, do not change the type.<p>\n1875:      * \n1876:      * TODO: This function fails when the event-signature contains a \"[\" \n1877:      * or a \"/\".\n1878:      * \n1879:      * @param trans the transition object to which this string applies\n1880:      * @param s     the string to be parsed\n1881:      * @return      the transition object\n1882:      * @throws ParseException when no matching [] are found\n1883:      * @see org.argouml.uml.generator.Parser#parseTransition(java.lang.Object, \n1884:      *      java.lang.String)\n1885:      */\n1886:     public Object parseTransition(Object trans, String s) \n1887:         throws ParseException {\n1888:         s = s.trim();\n1889:         \n1890:         int a = s.indexOf(\"[\");\n1891:         int b = s.indexOf(\"]\");\n1892:         int c = s.indexOf(\"/\");\n1893:         if (((a < 0) && (b >= 0)) || ((b < 0) && (a >= 0)) || (b < a)) \n1894:             throw new ParseException(\"No matching brackets [] found.\", 0);\n1895:         if ((c >= 0) && (c < b))\n1896:             throw new ParseException(\"Found a ']' after a '/'\", 0);\n1897:         \n1898:         StringTokenizer tokenizer = new StringTokenizer(s, \"[/\");\n1899:         String eventSignature = null;\n1900:         String guardCondition = null;\n1901:         String actionExpression = null;\n1902:         while (tokenizer.hasMoreTokens()) {\n1903:             String nextToken = tokenizer.nextToken().trim();\n1904:             if (nextToken.endsWith(\"]\")) {\n1905:                 guardCondition = nextToken.substring(0, nextToken.length() - 1);\n1906:             } else {\n1907:                 if (s.startsWith(nextToken)) {\n1908:                     eventSignature = nextToken;\n1909:                 } else {\n1910:                     if (s.endsWith(nextToken)) {\n1911:                         actionExpression = nextToken;\n1912:                     }\n1913:                 }\n1914:             }\n1915:         }\n1916:            \n1917:         if (eventSignature != null) {\n1918:             // parseEventSignature(trans, eventSignature);\n1919:             parseTrigger(trans, eventSignature);\n1920:         }\n1921:       \n1922:         if (guardCondition != null) {\n1923:             parseGuard(trans, \n1924:                 guardCondition.substring(guardCondition.indexOf('[') + 1));\n1925:         }\n1926:        \n1927:         if (actionExpression != null) {\n1928:             parseEffect(trans, actionExpression.trim());\n1929:         }\n1930:         return trans;\n1931:     }\n1932:     \n1933:     /**\n1934:      * Parse the Event that is the trigger of the given transition.\n1935:      * \n1936:      * @param trans the transition which is triggered by the given event\n1937:      * @param trigger the given trigger\n1938:      */\n1939:     private void parseTrigger(Object trans, String trigger) \n1940:         throws ParseException {\n1941:         // let's look for a TimeEvent, ChangeEvent, CallEvent or SignalEvent\n1942:         String s = \"\";\n1943:         boolean timeEvent = false;\n1944:         boolean changeEvent = false;\n1945:         boolean callEvent = false;\n1946:         boolean signalEvent = false;\n1947:         trigger = trigger.trim();\n1948:         \n1949:         StringTokenizer tokenizer = new StringTokenizer(trigger, \"()\");\n1950:         String name = tokenizer.nextToken().trim();\n1951:         if (name.equalsIgnoreCase(\"after\")) {\n1952:             timeEvent = true;\n1953:             if (tokenizer.hasMoreTokens()) {\n1954:                 s = tokenizer.nextToken().trim();\n1955:             }\n1956:         } else if (name.equalsIgnoreCase(\"when\")) {\n1957:             changeEvent = true;\n1958:             if (tokenizer.hasMoreTokens()) {\n1959:                 s = tokenizer.nextToken().trim();\n1960:             }\n1961:         } else {\n1962:             // the part after the || is for when there's nothing between the ()\n1963:             if (tokenizer.hasMoreTokens() \n1964:                     || (trigger.indexOf(\"(\") > 0) \n1965:                     || (trigger.indexOf(\")\") > 1)) {\n1966:                 callEvent = true;\n1967:                 if (!trigger.endsWith(\")\") || !(trigger.indexOf(\"(\") > 0))\n1968:                     throw new ParseException(\n1969:                             \"No matching brackets () found.\", 0);\n1970:                 if (tokenizer.hasMoreTokens()) {\n1971:                     s = tokenizer.nextToken().trim();\n1972:                 } // else the empty s will do\n1973:             } else {\n1974:                 signalEvent = true;\n1975:             }   \n1976:         }\n1977:         \n1978:         /* \n1979:          * We can distinct between 4 cases:\n1980:          * 1. A trigger is given. None exists yet.\n1981:          * 2. The name of the trigger was present, but is (the same or)\n1982:          * altered.\n1983:          * 3. A trigger is not given. None exists yet.\n1984:          * 4. The name of the trigger was present, but is removed.\n1985:          * The reaction in these cases should be:\n1986:          * 1. Create a new trigger, name it, and hook it to the transition.\n1987:          * 2. Rename the trigger.\n1988:          * 3. Nop.\n1989:          * 4. Unhook and erase the existing trigger.\n1990:          */\n1991:         Object evt = ModelFacade.getTrigger(trans);\n1992:         boolean createdEvent = false;\n1993:         if (trigger.length() > 0) {\n1994:             // case 1 and 2\n1995:             if (evt == null) {\n1996:                 // case 1\n1997:                 if (timeEvent) { // after(...)\n1998:                     Object model = ProjectManager.getManager()\n1999:                         .getCurrentProject().getModel();\n2000:                     evt = UmlFactory.getFactory().getStateMachines()\n2001:                         .buildTimeEvent(s, model);\n2002:                 }\n2003:                 if (changeEvent) { // when(...)\n2004:                     Object model = ProjectManager.getManager()\n2005:                         .getCurrentProject().getModel();\n2006:                     evt = UmlFactory.getFactory().getStateMachines()\n2007:                         .buildChangeEvent(s, model);\n2008:                 }\n2009:                 if (callEvent) { // operation(paramlist)\n2010:                     String triggerName = trigger.indexOf(\"(\") > 0 \n2011:                         ? trigger.substring(0, trigger.indexOf(\"(\")).trim()\n2012:                         : trigger;\n2013:                     Object model = ProjectManager.getManager()\n2014:                              .getCurrentProject().getModel();\n2015:                     evt = UmlFactory.getFactory().getStateMachines()\n2016:                         .buildCallEvent(trans, triggerName, model);\n2017:                     // and parse the parameter list\n2018:                     parseParamList(evt, s, 0);\n2019:                 }\n2020:                 if (signalEvent) { // signalname\n2021:                     Object model = ProjectManager.getManager()\n2022:                         .getCurrentProject().getModel();\n2023:                     evt = UmlFactory.getFactory().getStateMachines()\n2024:                         .buildSignalEvent(trigger, model);\n2025:                 }\n2026:                 createdEvent = true;\n2027:             } else {\n2028:                 // case 2\n2029:                 if (!ModelFacade.getName(evt).equals(trigger)) {\n2030:                     ModelFacade.setName(evt, trigger);\n2031:                     if (timeEvent && !ModelFacade.isATimeEvent(evt)) {\n2032:                         Object model = ProjectManager.getManager()\n2033:                             .getCurrentProject().getModel();\n2034:                         UmlFactory.getFactory().delete(evt);\n2035:                         evt = UmlFactory.getFactory().getStateMachines()\n2036:                             .buildTimeEvent(s, model);\n2037:                         createdEvent = true;\n2038:                     }\n2039:                     if (changeEvent && !ModelFacade.isAChangeEvent(evt)) {\n2040:                         Object model = ProjectManager.getManager()\n2041:                             .getCurrentProject().getModel();\n2042:                         UmlFactory.getFactory().delete(evt);\n2043:                         evt = UmlFactory.getFactory().getStateMachines()\n2044:                             .buildChangeEvent(s, model);\n2045:                         createdEvent = true;\n2046:                     }\n2047:                     if (callEvent && !ModelFacade.isACallEvent(evt)) {\n2048:                         UmlFactory.getFactory().delete(evt);\n2049:                         Object model = ProjectManager.getManager()\n2050:                             .getCurrentProject().getModel();\n2051:                         evt = UmlFactory.getFactory().getStateMachines()\n2052:                             .buildCallEvent(trans, trigger, model);\n2053:                         // and parse the parameter list\n2054:                         parseParamList(evt, s, 0);\n2055:                         createdEvent = true;\n2056:                     }\n2057:                     if (signalEvent && !ModelFacade\n2058:                             .isASignalEvent(evt)) {\n2059:                         Object model = ProjectManager.getManager()\n2060:                             .getCurrentProject().getModel();\n2061:                         UmlFactory.getFactory().delete(evt);\n2062:                         evt = UmlFactory.getFactory().getStateMachines()\n2063:                             .buildSignalEvent(trigger, model);\n2064:                         createdEvent = true;\n2065:                     }\n2066:                 }\n2067:             }\n2068:             if (createdEvent && (evt != null)) {\n2069:                 StateMachinesHelper.getHelper().setEventAsTrigger(trans, evt);\n2070:                 \n2071:                 /* The next part is explained by the following\n2072:                  * quote from the UML spec:\n2073:                  * \"The event declaration has scope within\n2074:                  * the package it appears in and may be used in\n2075:                  * state diagrams for classes that have visibility\n2076:                  * inside the package. An event is not local to\n2077:                  * a single class.\"\n2078:                  */\n2079:                 Object enclosing = StateMachinesHelper.getHelper()\n2080:                     .getStateMachine(trans);\n2081:                 while ((!ModelFacade.isAPackage(enclosing))\n2082:                         && (enclosing != null)) {\n2083:                     enclosing = ModelFacade.getNamespace(enclosing);\n2084:                 }\n2085:                 if (enclosing != null) {\n2086:                     ModelFacade.setNamespace(evt, enclosing);\n2087:                 }\n2088:             }\n2089:         } else {\n2090:             // case 3 and 4\n2091:             if (evt == null) {\n2092:                 ;// case 3\n2093:             } else {\n2094:                 // case 4\n2095:                 UmlFactory.getFactory().delete(evt); // erase it\n2096:             }\n2097:         }\n2098:     }\n2099: \n2100:     /** \n2101:      * Handle the Guard of a Transition.<p>\n2102:      * \n2103:      * We can distinct between 4 cases: <br>\n2104:      * 1. A guard is given. None exists yet. <br>\n2105:      * 2. The expression of the guard was present, but is altered. <br>\n2106:      * 3. A guard is not given. None exists yet. <br>\n2107:      * 4. The expression of the guard was present, but is removed.<p>\n2108:      * \n2109:      * The reaction in these cases should be: <br>\n2110:      * 1. Create a new guard, set its name, language & expression,\n2111:      *    and hook it to the transition. <br>\n2112:      * 2. Change the guard's expression. Leave the name & language\n2113:      *    untouched. See also issue 2742. <br>\n2114:      * 3. Nop. <br>\n2115:      * 4. Unhook and erase the existing guard.\n2116:      *\n2117:      * @param trans the UML element transition\n2118:      * @param guard the string that represents the guard expression\n2119:      */\n2120:     private void parseGuard(Object trans, String guard) {\n2121:         Object g = ModelFacade.getGuard(trans);\n2122:         if (guard.length() > 0) {\n2123:             if (g == null) {\n2124:                 // case 1\n2125:                 /*TODO: In the next line, I should use buildGuard(),\n2126:                  * but it doesn't show the guard on the diagram...\n2127:                  * Why? (MVW)*/\n2128:                 g = UmlFactory.getFactory().getStateMachines().createGuard();\n2129:                 if (g != null) {\n2130:                     ModelFacade.setExpression(g, UmlFactory.getFactory()\n2131:                             .getDataTypes().createBooleanExpression(\n2132:                                     \"\", guard));\n2133:                     ModelFacade.setName(g, \"anon\");\n2134:                     ModelFacade.setTransition(g, trans);\n2135:                     //ModelFacade.setGuard(trans, g); //NSUML does this (?)\n2136:                 }\n2137:             } else {\n2138:                 // case 2\n2139:                 Object expr = ModelFacade.getExpression(g);\n2140:                 String language = \"\";\n2141:                 \n2142:                 /* TODO: This does not work! Why not? (MVW)\n2143:                  ModelFacade.setBody(expr,guard);\n2144:                  ModelFacade.setExpression(g,expr); */\n2145:                 \n2146:                 //hence a less elegant workaround that works:\n2147:                 if (expr != null)\n2148:                     language = ModelFacade.getLanguage(expr);\n2149:                 ModelFacade.setExpression(g, UmlFactory.getFactory()\n2150:                         .getDataTypes().createBooleanExpression(\n2151:                                 language, guard));\n2152:                 /* TODO: In this case, the properties panel \n2153:                  is not updated\n2154:                  with the changed expression! */\n2155:             }\n2156:         } else {\n2157:             if (g == null) {\n2158:                 ;// case 3\n2159:             } else {\n2160:                 // case 4\n2161:                 UmlFactory.getFactory().delete(g); // erase it\n2162:             }\n2163:         }\n2164:     }\n2165:     \n2166:     /** \n2167:      * Handle the Effect (Action) of a Transition.\n2168:      * \n2169:      * We can distinct between 4 cases:\n2170:      * 1. An effect is given. None exists yet.\n2171:      * 2. The expression of the effect was present, but is altered.\n2172:      * 3. An effect is not given. None exists yet.\n2173:      * 4. The expression of the effect was present, but is removed.\n2174:      * The reaction in these cases should be:\n2175:      * 1. Create a new CallAction, set its name, language & \n2176:      * expression, and hook it to the transition.\n2177:      * 2. Change the effect's expression. Leave the actiontype, name \n2178:      * & language untouched.\n2179:      * 3. Nop.\n2180:      * 4. Unhook and erase the existing effect.\n2181:      *\n2182:      * @param actions the string to be parsed\n2183:      * @param trans the transition that causes the effect (actions)\n2184:      */\n2185:     private void parseEffect(Object trans, String actions) {\n2186:         Object effect = ModelFacade.getEffect(trans);\n2187:         if (actions.length() > 0) {\n2188:             if (effect == null) { // case 1\n2189:                 effect = UmlFactory.getFactory().getCommonBehavior()\n2190:                     .createCallAction();\n2191:                 ModelFacade.setScript(effect, UmlFactory.getFactory()\n2192:                         .getDataTypes().createActionExpression(\n2193:                                 \"\"/*language*/, actions));\n2194:                 ModelFacade.setName(effect, \"anon\");\n2195:                 ModelFacade.setEffect(trans, effect);\n2196:             } else { // case 2\n2197:                 String language = ModelFacade.getLanguage(ModelFacade\n2198:                         .getScript(effect));\n2199:                 ModelFacade.setScript(effect, UmlFactory.getFactory()\n2200:                         .getDataTypes().createActionExpression(\n2201:                                 language, actions));\n2202:             }\n2203:         } else { // case 3 & 4\n2204:             if (effect == null) {\n2205:                 ;// case 3\n2206:             } else {\n2207:                 // case 4\n2208:                 UmlFactory.getFactory().delete(effect); // erase it\n2209:             }\n2210:         }\n2211:     }\n2212: \n2213: \n2214:     /**\n2215:      * Parses a ClassifierRole represented by the following line of the format:\n2216:      * \n2217:      * <br>\n2218:      * baselist := [base] [, base]* <br>\n2219:      * classifierRole := [name] [/ role] [: baselist]\n2220:      * \n2221:      * <p>\n2222:      * <b>role </b> and <b>baselist </b> can be given in any order.\n2223:      * \n2224:      * <p>\n2225:      * This syntax is compatible with the UML 1.3 specification.\n2226:      * \n2227:      * (formerly: \"name: base\" )\n2228:      * \n2229:      * @param cls the classifier role to apply any changes to\n2230:      * @param s   the String to parse\n2231:      * @throws java.text.ParseException\n2232:      *            when it detects an error in the attribute string. See also\n2233:      *            ParseError.getErrorOffset().\n2234:      */\n2235:     public void parseClassifierRole(Object cls, String s) \n2236:         throws ParseException {\n2237:         String name = null;\n2238:         String token;\n2239:         String role = null;\n2240:         String base = null;\n2241:         Vector bases = null;\n2242:         boolean hasColon = false;\n2243:         boolean hasSlash = false;\n2244: \n2245:         try {\n2246:             MyTokenizer st = new MyTokenizer(s, \" ,\\t,/,:,\\\\,\");\n2247: \n2248:             while (st.hasMoreTokens()) {\n2249:                 token = st.nextToken();\n2250:                 if (\" \".equals(token) || \"\\t\".equals(token)) {\n2251:                     ;// Do nothing\n2252:                 } else if (\"/\".equals(token)) {\n2253:                     hasSlash = true;\n2254:                     hasColon = false;\n2255: \n2256:                     if (base != nu