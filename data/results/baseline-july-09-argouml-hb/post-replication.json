                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/model/uml/UmlModelEventPump.java: \n1: // $Id$\n2: // Copyright (c) 2002 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.model.uml;\n26: \n27: import java.util.ArrayList;\n28: import java.util.Collection;\n29: import java.util.HashMap;\n30: import java.util.HashSet;\n31: import java.util.Iterator;\n32: import java.util.List;\n33: import java.util.Map;\n34: import java.util.Set;\n35: \n36: import org.apache.log4j.Category;\n37: import org.argouml.kernel.ProjectManager;\n38: import org.argouml.model.uml.modelmanagement.ModelManagementHelper;\n39: \n40: import ru.novosoft.uml.MBase;\n41: import ru.novosoft.uml.MElementEvent;\n42: import ru.novosoft.uml.MElementListener;\n43: import ru.novosoft.uml.model_management.MModel;\n44: \n45: /**\n46:  * This class implements an event pump for all modelevents (MEvents with the current\n47:  * NSUML model). Two kinds of listeners can be registred to the pump: listeners\n48:  * to class events and listeners to object events. The pump dispatches all\n49:  * events fired by objects of a certain class to the class listeners (listeners\n50:  * that are registred via addClassModelEventListener). Furthermore, it dispatches\n51:  * all events to listeners that are registered for a certain object if this object\n52:  * fired the original event.\n53:  * <p>\n54:  * Maybe this class should dispatch a thread to handle the incoming event in the\n55:  * future.</p>\n56:  * @since Oct 14, 2002\n57:  * @author jaap.branderhorst@xs4all.nl\n58:  */\n59: public final class UmlModelEventPump implements MElementListener {\n60: \n61:     private Category cat = Category.getInstance(UmlModelEventPump.class);\n62: \n63:     public final static String REMOVE = \"remove\";\n64: \n65:     private static UmlModelEventPump _instance = null;\n66: \n67:     private Map _listenerMap = new HashMap();\n68:     private Map _listenerMap = new HashMap();\n69: \n70:     /**\n71:      * Singleton access method\n72:      * @return UmlModelEventPump\n73:      */\n74:     public synchronized static UmlModelEventPump getPump() {\n75:         if (_instance == null) {\n76:             _instance = new UmlModelEventPump();\n77:         }\n78:         return _instance;\n79:     }\n80: \n81:     /**\n82:      * Constructor for UmlModelEventPump.\n83:      */\n84:     private UmlModelEventPump() {\n85:         super();\n86:     }\n87: \n88:     /**\n89:      * Makes the key for the hashmap where the listeners are stored. For test\n90:      * purposes this method has a 'default' visibility\n91:      * @param modelClass\n92:      * @param eventName\n93:      * @return String\n94:      */\n95:     String getKey(Class modelClass, String eventName) {\n96:         String className = modelClass.getName();\n97:         if (className.endsWith(\"Impl\")) {\n98:             className = className.substring(0, className.lastIndexOf(\"Impl\"));\n99:         }\n100:         return className + eventName;\n101:     }\n102: \n103:     /**\n104:      * Adds a listener that listens to all modelevents that are named eventNames\n105:      * and that occur to instances of a given modelClass.\n106:      *\n107:      * <p>\n108:      * If you want the listener to be registred for remove events (that is: an\n109:      * instance of the class the listener is listening too is removed), then you\n110:      * have to register for the eventname \"remove\"\n111:      * </p>\n112:      * @param listener\n113:      * @param modelClass\n114:      * @param eventNames\n115:      * @throws IllegalArgumentException if one of the arguments is null or if\n116:      *  the modelClass is not a subclass of MBase.\n117:      * @throws IllegalStateException if the listener is allready registred\n118:      */\n119:     public void addClassModelEventListener(MElementListener listener, Class modelClass, String[] eventNames) {\n120:         if (listener == null || modelClass == null || eventNames == null)\n121:             throw new IllegalArgumentException(\"Tried to add null listener to null class\");\n122:         if (!MBase.class.isAssignableFrom(modelClass))\n123:             throw new IllegalArgumentException(\"Tried to add illegal class modeleventlistener.\");\n124:         if (eventNames.length == 0)\n125:             throw new IllegalArgumentException(\"Tried to add an empty eventName list\");\n126:         for (int i = 0; i < eventNames.length; i++) {\n127:             executeAddClassModelEventListener(listener, modelClass, eventNames[i]);\n128:         }\n129:     }\n130: \n131:     /**\n132:      * Convinience method to add a listener that only listens to one specific event\n133:      * @param listener\n134:      * @param modelClass\n135:      * @param eventName\n136:      */\n137:     public void addClassModelEventListener(MElementListener listener, Class modelClass, String eventName) {\n138:         if (listener == null || modelClass == null || eventName == null)\n139:             throw new IllegalArgumentException(\"Tried to add null listener to null class\");\n140:         if (!MBase.class.isAssignableFrom(modelClass))\n141:             throw new IllegalArgumentException(\"Tried to add illegal class modeleventlistener.\");\n142:         if (eventName.equals(\"\"))\n143:             throw new IllegalArgumentException(\"Tried to add an empty eventname\");\n144:         executeAddClassModelEventListener(listener, modelClass, eventName);\n145:     }\n146: \n147:     /**\n148:      * Adds a listener to events fired by metaClass modelClass. All events fired\n149:      * by instances of modelClass or instances of its subclasses will be pumped\n150:      * to the listener.\n151:      *\n152:      * <p><em>Note:</em> Due to the fact that ALL events are pumped for some\n153:      * metaclass and it's children, this is a very powerfull method but also\n154:      * one that can hog performance. Use this with care!</p>\n155:      * @param listener\n156:      * @param modelClass\n157:      */\n158:     public void addClassModelEventListener(MElementListener listener, Class modelClass) {\n159:         if (listener == null || modelClass == null)\n160:             throw new IllegalArgumentException(\"Tried to add null listener to null class\");\n161:         if (!MBase.class.isAssignableFrom(modelClass))\n162:             throw new IllegalArgumentException(\"Tried to add illegal class modeleventlistener.\");\n163:         executeAddClassModelEventListener(listener, modelClass, null);\n164:     }\n165: \n166:     /**\n167:      * Does the actual adding\n168:      * @param listener\n169:      * @param modelClass\n170:      * @param eventName\n171:      */\n172:     private synchronized void executeAddClassModelEventListener(MElementListener listener, Class modelClass, String eventName) {\n173:         // first register the listener for all elements allready in the model\n174:         cat.debug(\"Registring listener \" + listener + \" to class \" + modelClass.getName() + \" and event \" + eventName);\n175:         Collection col = ModelManagementHelper.getHelper().getAllModelElementsOfKind(modelClass);\n176:         MModel root = ProjectManager.getManager().getCurrentProject().getRoot();\n177:         if (modelClass.isAssignableFrom(root.getClass())) {\n178:             col.add(root);\n179:         }\n180:         Iterator it = col.iterator();\n181:         while (it.hasNext()) {\n182:             executeAddModelEventListener(listener, (MBase) it.next(), eventName);\n183:         }\n184:         // add the class to the 'interested classes list' so the listener is added on creation\n185:         // of a modelelement\n186:         Set listenerList = (Set) _listenerMap.get(modelClass);\n187:         if (listenerList == null) {\n188:             listenerList = new HashSet();\n189:             _listenerMap.put(modelClass, listenerList);\n190:         }\n191:         ListenerEventName couple = new ListenerEventName(listener, eventName);\n192:         it = listenerList.iterator();\n193:         boolean addNeeded = true;\n194:         while (it.hasNext()) {\n195:             if (couple.equals(it.next())) {\n196:                 return;\n197:             }\n198:         }\n199:         listenerList.add(couple);\n200:     }\n201: \n202:     /**\n203:      * Removes a listener that listens to all modelevents fired by instances of\n204:      * modelClass and that have the original name eventNames.\n205:      * @param listener\n206:      * @param modelClass\n207:      * @param eventNames\n208:      */\n209:     public void removeClassModelEventListener(MElementListener listener, Class modelClass, String[] eventNames) {\n210:         if (listener == null || modelClass == null || eventNames == null)\n211:             throw new IllegalArgumentException(\"Tried to remove null listener from null class\");\n212:         if (!MBase.class.isAssignableFrom(modelClass))\n213:             throw new IllegalArgumentException(\"Tried to remove illegal class modeleventlistener.\");\n214:         if (eventNames.length == 0)\n215:             throw new IllegalArgumentException(\"Tried to remove an empty eventName list\");\n216:         for (int i = 0; i < eventNames.length; i++) {\n217:             executeRemoveClassModelEventListener(listener, modelClass, eventNames[i]);\n218:         }\n219:     }\n220: \n221:     /**\n222:      * Convinience method to remove a listener that listens to events named eventName\n223:      * that are fired by instances of modelClass\n224:      * @param listener\n225:      * @param modelClass\n226:      * @param eventName\n227:      */\n228:     public void removeClassModelEventListener(MElementListener listener, Class modelClass, String eventName) {\n229:         if (listener == null || modelClass == null || eventName == null)\n230:             throw new IllegalArgumentException(\"Tried to remove null listener from null class\");\n231:         if (!MBase.class.isAssignableFrom(modelClass))\n232:             throw new IllegalArgumentException(\"Tried to remove illegal class modeleventlistener.\");\n233:         executeRemoveClassModelEventListener(listener, modelClass, eventName);\n234:     }\n235: \n236:     /**\n237:      * Removes a listener that listens to all modelevents fired by instances of\n238:      * modelClass.\n239:      * @param listener\n240:      * @param modelClass\n241:      * @param eventName\n242:      */\n243:     public void removeClassModelEventListener(MElementListener listener, Class modelClass) {\n244:         if (listener == null || modelClass == null)\n245:             throw new IllegalArgumentException(\"Tried to remove null listener from null class\");\n246:         if (!MBase.class.isAssignableFrom(modelClass))\n247:             throw new IllegalArgumentException(\"Tried to remove illegal class modeleventlistener.\");\n248:         executeRemoveClassModelEventListener(listener, modelClass, null);\n249:     }\n250: \n251:     private synchronized void executeRemoveClassModelEventListener(MElementListener listener, Class modelClass, String eventName) {\n252:         // remove all registrations of this listener with all instances of modelClass\n253:         cat.debug(\"Removing listener \" + listener.toString() + \" from modelclass \" + modelClass.getName() + \". It was listening to event \" + eventName);\n254:         Iterator it = ModelManagementHelper.getHelper().getAllModelElementsOfKind(modelClass).iterator();\n255:         while (it.hasNext()) {\n256:             MBase base = (MBase)it.next();\n257:             removeModelEventListener(listener, base, eventName);\n258:             cat.debug(\"Removed the listener \" + listener + \" that was registred for modelelement \" + base + \" and event \" + eventName);\n259:         }\n260:         // remove the listener from the registry\n261:         Set listenerList = (Set) _listenerMap.get(modelClass);\n262:         Object[] asArray = listenerList.toArray();\n263:         for (int i = 0; i < asArray.length; i++) {\n264:             ListenerEventName couple = (ListenerEventName) asArray[i];\n265:             if (couple.getListener() == listener && (couple.getEventName().equals(eventName) || eventName == null)) {\n266:                 listenerList.remove(couple);\n267:             }\n268:         }\n269:         if (listenerList.isEmpty()) {\n270:             cat.debug(\"Removed the listenerlist for \" + modelClass.getName() + \" from the eventpump.\");\n271:             _listenerMap.remove(modelClass);\n272:         }\n273:     }\n274: \n275:     /**\n276:      * Gets the key for the map with the listeners to modelevents.\n277:      * @param modelelement\n278:      * @param eventName\n279:      * @return String\n280:      */\n281:     String getKey(MBase modelelement, String eventName) {\n282:         return modelelement.hashCode() + eventName;\n283:     }\n284: \n285:     /**\n286:      * Adds a listener to modelevents that are fired by some given modelelement and that\n287:      * have the name eventNames.\n288:      *\n289:      * <p>\n290:      * If you want the listener to be registred for remove events (that is: the\n291:      * instance the listener is listening too is removed), then you have to\n292:      * register for the eventname \"remove\"\n293:      * </p>\n294:      * @param listener\n295:      * @param modelelement\n296:      * @param eventNames\n297:      */\n298:     public void addModelEventListener(Object listener, Object modelelement, String[] eventNames) {\n299:         if (listener == null || modelelement == null || eventNames == null || eventNames.length == 0)\n300:             throw new IllegalArgumentException(\"Null or empty arguments while adding a modelelement listener\");\n301:         if (!(listener instanceof MElementListener) || !(modelelement instanceof MBase))\n302:             throw new IllegalArgumentException(\"Wrong argument types while adding a modelelement listener\");\n303:         for (int i = 0; i < eventNames.length; i++) {\n304:             executeAddModelEventListener((MElementListener)listener, (MBase)modelelement, eventNames[i]);\n305:         }\n306:     }\n307: \n308:     /**\n309:      * Convinience method to add a listener that only listens to one specific event\n310:      * @param listener\n311:      * @param modelClass\n312:      * @param eventName\n313:      */\n314:     public vo