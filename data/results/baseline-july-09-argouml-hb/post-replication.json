                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/ui/ArgoDiagram.java: \n1: // $Id$\n2: // Copyright (c) 1996-2006 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.ui;\n26: \n27: import java.beans.PropertyVetoException;\n28: import java.util.ArrayList;\n29: import java.util.Iterator;\n30: import java.util.List;\n31: \n32: import org.apache.log4j.Logger;\n33: import org.argouml.cognitive.ItemUID;\n34: import org.argouml.kernel.ProjectManager;\n35: import org.argouml.model.Model;\n36: import org.argouml.uml.diagram.static_structure.ui.FigComment;\n37: import org.argouml.uml.diagram.ui.FigEdgeModelElement;\n38: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n39: import org.tigris.gef.base.Diagram;\n40: import org.tigris.gef.base.Editor;\n41: import org.tigris.gef.graph.MutableGraphSupport;\n42: import org.tigris.gef.presentation.Fig;\n43: import org.tigris.gef.presentation.FigEdge;\n44: import org.tigris.gef.presentation.FigGroup;\n45: import org.tigris.gef.presentation.FigNode;\n46: \n47: /**\n48:  * This class represents all Diagrams within ArgoUML.\n49:  * It is based upon the GEF Diagram.\n50:  */\n51: public class ArgoDiagram extends Diagram {\n52: \n53:     private ItemUID id;\n54: \n55:     /**\n56:      * Logger.\n57:      */\n58:     private static final Logger LOG =\n59:         Logger.getLogger(ArgoDiagram.class);\n60: \n61:     static {\n62:         /**\n63:          * Hack to use vetocheck in constructing names.\n64:          *\n65:          * TODO: Is this needed?\n66:          */\n67:         new ArgoDiagram();\n68:     }\n69: \n70:     /**\n71:      * The constructor.\n72:      */\n73:     public ArgoDiagram() {\n74:         super();\n75:         // really dirty hack to remove unwanted listeners\n76:         getLayer().getGraphModel().removeGraphEventListener(getLayer());\n77:     }\n78: \n79:     /**\n80:      * The constructor.\n81:      *\n82:      * @param diagramName the name of the diagram\n83:      */\n84:     public ArgoDiagram(String diagramName) {\n85:         // next line patch to issue 596 (hopefully)\n86:         super(diagramName);\n87:         try {\n88:             setName(diagramName);\n89:         } catch (PropertyVetoException pve) { }\n90:     }\n91: \n92:     ////////////////////////////////////////////////////////////////\n93:     // accessors\n94: \n95:     /**\n96:      * @see org.tigris.gef.base.Diagram#setName(java.lang.String)\n97:      */\n98:     public void setName(String n) throws PropertyVetoException {\n99:         super.setName(n);\n100:         MutableGraphSupport.enableSaveAction();\n101:     }\n102: \n103:     /**\n104:      * @param i the new id\n105:      */\n106:     public void setItemUID(ItemUID i) {\n107:         id = i;\n108:     }\n109: \n110:     /**\n111:      * USED BY pgml.tee!!\n112:      * @return the item UID\n113:      */\n114:     public ItemUID getItemUID() {\n115:         return id;\n116:     }\n117: \n118:     ////////////////////////////////////////////////////////////////\n119:     // event management\n120:     /**\n121:      * The UID.\n122:      */\n123:     static final long serialVersionUID = -401219134410459387L;\n124: \n125:     /**\n126:      * TODO: The reference to the method\n127:      * org.argouml.uml.ui.VetoablePropertyChange#getVetoMessage(String)\n128:      * was here but the class does exist anymore. Where is it?\n129:      * This method is never used!\n130:      *\n131:      * @param propertyName is the name of the property\n132:      * @return a message or null if not applicable.\n133:      */\n134:     public String getVetoMessage(String propertyName) {\n135:     \tif (propertyName.equals(\"name\")) {\n136: \t    return \"Name of diagram may not exist already\";\n137:     \t}\n138:         return null;\n139:     }\n140: \n141:     /**\n142:      * Finds the presentation (the Fig) for some object. If the object\n143:      * is a modelelement that is contained in some other modelelement\n144:      * that has its own fig, that fig is returned. It extends\n145:      * presentationFor that only gets the fig belonging to the node\n146:      * obj.<p>\n147:      *\n148:      * @author jaap.branderhorst@xs4all.nl\n149:      * @return the Fig for the object\n150:      * @param obj is th object\n151:      */\n152:     public Fig getContainingFig(Object obj) {\n153:         Fig fig = super.presentationFo