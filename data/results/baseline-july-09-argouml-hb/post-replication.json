                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/ui/ActionSaveGraphics.java: \n1: // $Id$\n2: // Copyright (c) 1996-2006 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.uml.ui;\n26: \n27: import java.awt.event.ActionEvent;\n28: import java.io.File;\n29: import java.io.FileNotFoundException;\n30: import java.io.FileOutputStream;\n31: import java.io.IOException;\n32: \n33: import javax.swing.AbstractAction;\n34: import javax.swing.JFileChooser;\n35: import javax.swing.JOptionPane;\n36: \n37: import org.apache.log4j.Logger;\n38: import org.argouml.application.api.CommandLineInterface;\n39: import org.argouml.application.api.Configuration;\n40: import org.argouml.application.helpers.ResourceLoaderWrapper;\n41: import org.argouml.i18n.Translator;\n42: import org.argouml.kernel.Project;\n43: import org.argouml.kernel.ProjectManager;\n44: import org.argouml.ui.ExceptionDialog;\n45: import org.argouml.ui.ProjectBrowser;\n46: import org.argouml.util.SuffixFilter;\n47: import org.tigris.gef.base.CmdSaveGraphics;\n48: import org.tigris.gef.base.Diagram;\n49: import org.tigris.gef.util.Util;\n50: \n51: \n52: /**\n53:  * Wraps a CmdSaveGIF or CmdSave(E)PS to allow selection of an output file.\n54:  */\n55: public class ActionSaveGraphics extends AbstractAction\n56:         implements CommandLineInterface {\n57: \n58:     private static final long serialVersionUID = 3062674953320109889L;\n59:     \n60:     private static final Logger LOG =\n61:         Logger.getLogger(ActionSaveGraphics.class);\n62: \n63:     /**\n64:      * Constructor for this action.\n65:      */\n66:     public ActionSaveGraphics() {\n67:         super(Translator.localize(\"action.save-graphics\"),\n68:                 ResourceLoaderWrapper.lookupIcon(\"action.save-graphics\"));\n69:     }\n70: \n71:     /**\n72:      * @see AbstractAction#actionPerformed(ActionEvent)\n73:      */\n74:     public void actionPerformed(ActionEvent ae) {\n75:         trySave(); //TODO: what to do with the return value?\n76:     }\n77: \n78:     /**\n79:      * Method that does almost everything in this class.<p>\n80:      *\n81:      * @return true if all went well.\n82:      */\n83:     private boolean trySave() {\n84:         Object target =\n85:             ProjectManager.getManager().getCurrentProject().getActiveDiagram();\n86: \n87:         if (!(target instanceof Diagram)) {\n88:             return false;\n89:         }\n90: \n91:         String defaultName = ((Diagram) target).getName();\n92:         defaultName = Util.stripJunk(defaultName);\n93: \n94:         ProjectBrowser pb = ProjectBrowser.getInstance();\n95:         Project p =  ProjectManager.getManager().getCurrentProject();\n96:         SaveGraphicsManager sgm = SaveGraphicsManager.getInstance();\n97:         try {\n98:             JFileChooser chooser = null;\n99: \n100:             if (p != null\n101:                 \t&& p.getURL() != null\n102:                 \t&& p.getURL().getFile().length() > 0) {\n103: \n104:             \tString filename = p.getURL().getFile();\n105:                 // TODO: Someone please explain this.\n106:             \tif (!filename.startsWith(\"/FILE1/+/\")) {\n107:             \t    chooser = new JFileChooser(p.getURL().getFile());\n108:             \t}\n109:             }\n110: \n111:             if (chooser == null) {\n112:                 chooser = new JFileChooser();\n113:             }\n114: \n115:             Object[] s = { defaultName };\n116:             chooser.setDialogTitle(\n117:                     Translator.messageFormat(\"filechooser.save-graphics\", s));\n118:             // Only specified format are allowed.\n119:             chooser.setAcceptAllFileFilterUsed(false);\n120:             sgm.setFileChooserFilters(chooser, defaultName);\n121: \n122:             String fn = Configuration.getString(\n123:                     SaveGraphicsManager.KEY_SAVE_GRAPHICS_PATH);\n124:             if (fn.length() > 0) {\n125:                 chooser.setSelectedFile(new File(fn));\n126:             }\n127: \n128:             int retval = chooser.showSaveDialog(pb);\n129:             if (retval == JFileChooser.APPROVE_OPTION) {\n130:                 File theFile = chooser.getSelectedFile();\n131:                 if (theFile != null) {\n132:                     String path = theFile.getPath();\n133:                     Configuration.setString(\n134:                             SaveGraphicsManager.KEY_SAVE_GRAPHICS_PATH,\n135:                             path);\n136: \n137:                     theFile = new File(theFile.getParentFile(),\n138:                             sgm.fixExtension(theFile.getName()));\n139:                     String suffix = sgm.getFilterFromFileName(theFile.getName())\n140:                         .getSuffix();\n141:                     return doSave(theFile, suffix, true);\n142:                 }\n143:             }\n144:         } catch (OutOfMemoryError e) {\n145:             new ExceptionDialog(ProjectBrowser.getInstance(),\n146:                 \"You have run out of memory. \"\n147:                 + \"Close down ArgoUML and restart with a larger heap size.\", e);\n148:         } catch (Exception e) {\n149:             new ExceptionDialog(ProjectBrowser.getInstance(), e);\n150:             LOG.error(\"Got some exception\", e);\n151:         }\n152: \n153:         return false;\n154:     }\n155: \n156:     /**\n157:      * Actually do the saving of the graphics file.\n158:      *\n159:      * @return true if it was successful.\n160:      * @param theFile is the file that we are writing to\n161:      * @param suffix is the suffix. Used for deciding what format the file\n162:      * shall have.\n163:      * @param useUI is true if we are supposed to use the UI e.g. to warn\n164:      *              the user that we are replacing an old file.\n165:      */\n166:     private boolean doSave(File theFile,\n167: \t\t\t   String suffix, boolean useUI)\n168: \tthrows FileNotFoundException, IOException {\n169: \n170:         SaveGraphicsManager sgm = SaveGraphicsManager.getInstance();\n171:         CmdSaveGraphics cmd = null;\n172: \n173:         cmd = sgm.getSaveCommandBySuffix(suffix);\n174:         if (cmd == null) {\n175:             return false;\n176:         }\n177: \n178:         if (useUI) {\n179:             ProjectBrowser.getInstance().showStatus(\n180:                             \"Writing \" + theFile + \"...\");\n181:         }\n182: \tif (theFile.exists() && useUI) {\n183: \t    int response = JOptionPane.showConfirmDialog(\n184:                 ProjectBrowser.getInstance(),\n185:                 Translator.messageFormat(\"optionpane.confirm-overwrite\",\n186:                         new Object[] {theFile}),\n187:                 Translator.localize(\"optionpane.confirm-overwrite-title\"),\n188:                 JOptionPane.YES_NO_OPTION);\n189: \t    if (response != JOptionPane.YES_OPTION) {\n190: \t\treturn false;\n191: \t    }\n192: \t}\n193: \tFileOutputStream fo = new FileOutputStream(theFile);\n194: \tcmd.setStream(fo);\n195:         cmd.setScale(Configuration.getInteger(\n196:                 SaveGraphicsManager.KEY_GRAPHICS_RESOLUTION, 1));\n197: \tcmd.doIt();\n198: \tfo.close();\n199:         if (useUI) {\n200:             ProjectBrowser.getInstance().showStatus(\"Wrote \" + theFile);\n201:         }\n202: \treturn true;\n203:     }\n204: \n205: \n206:     /**\n207:      * Execute this action from the command line.\n208:      *\n209:      * TODO: The underlying GEF library relies on Acme that doesn't allow\n210:      * us to create these files unless there is a window showing. For this\n211:      * reason I have had to split the performing of commands in\n212:      * {@link org.argouml.application.Main#main(String[])} so that we can,\n213:      * by not supplying the -batch option, run these commands\n214:      * with the window showing. Hopefully this can eventually be fixed.\n215:      *\n216:      * @see org.argouml.application.api.CommandLineInterface#doCommand(String)\n217:      * @param argument is the file name that we save to.\n218:      * @return true if it is OK.\n219:      */\n220:     public boolean doCommand(String argument) {\n221: \tFile file = new File(argument);\n222: \tString suffix = SuffixFilter.getExtension(file);\n223: \tif (suffix == null) {\n224: \t    return false;\n225: \t}\n226: \n227: \ttry {\n228: \t    return doSave(file, suffix, false);\n229: \t} catch (FileNotFoundException e) {\n230: \t    LOG.error(\"File not found error when writing.\", e);\n231: \t} catch (IOException e) {\n232: \t    LOG.error(\"IO error when writing.\", e);\n233: \t}\n234: \treturn false;\n235:     }\n236: } /* end class ActionSaveGraphics */\n237: ",
