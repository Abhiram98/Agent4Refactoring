n { \n259:     super.textEdited(ft); \n260:     MComponentInstance coi = (MComponentInstance) getOwner(); \n261:     if (ft == _name) { \n262:       String s = ft.getText().trim();\n263:       if (s.length()>0) {\n264:         s = s.substring(0, (s.length() - 1)); \n265:       }\n266:       ParserDisplay.SINGLETON.parseComponentInstance(coi, s); \n267:     } \n268:   } \n269: \n270:   protected void modelChanged() {\n271:     super.modelChanged();\n272:     MComponentInstance coi = (MComponentInstance) getOwner(); \n273:     if (coi == null) return; \n274:     String nameStr = \"\"; \n275:     if (coi.getName() != null) { \n276:       nameStr = coi.getName().trim(); \n277:     } \n278:     Collection col = coi.getClassifiers(); \n279:     Iterator it = col.iterator(); \n280:     String baseStr = \"\"; \n281:     while (it.hasNext()) { \n282:         baseStr = ((MClassifier)it.next()).getName(); \n283:     } \n284:     if (_readyToEdit) { \n285:       if( nameStr == \"\" && baseStr == \"\") \n286: \t_name.setText(\"\"); \n287:       else \n288: \t_name.setText(nameStr.trim() + \" : \" + baseStr); \n289:     } \n290:     Dimension nameMin = _name.getMinimumSize(); \n291:     Rectangle r = getBounds(); \n292:     setBounds(r.x, r.y, r.width, r.height); \n293: \n294:     updateStereotypeText();\n295:   }\n296: \n297:   public void updateStereotypeText() {\n298:     MInstance minst = (MInstance) getOwner();\n299:     if (minst == null) return;\n300:     MStereotype stereo = minst.getStereotype();\n301:     if (stereo == null) {\n302:       _stereo.setText(\"\");\n303:       return;\n304:     }\n305:     if (stereo != null) {\n306:       String stereoStr = stereo.getName();\n307:       if (stereoStr.length() == 0) _stereo.setText(\"\");\n308:       else _stereo.setText(\"<<\" + stereoStr + \">>\");\n309:     }\n310:   }\n311: \n312:   static final long serialVersionUID = 1647392857462847651L;\n313: \n314: } /* end class FigComponentInstance */\n315: \n316: ",
