n32: import java.util.Enumeration;\n33: \n34: import org.apache.log4j.Logger;\n35: import org.argouml.kernel.Project;\n36: import org.argouml.uml.diagram.static_structure.layout.ClassdiagramLayouter;\n37: import org.argouml.uml.diagram.ui.UMLDiagram;\n38: import org.argouml.uml.reveng.DiagramInterface;\n39: import org.argouml.uml.reveng.FileImportSupport;\n40: import org.argouml.uml.reveng.Import;\n41: import org.argouml.uml.reveng.java.Modeller;\n42: import org.argouml.util.FileFilters;\n43: import org.argouml.util.SuffixFilter;\n44: \n45: /**\n46:  * This is the main class for the IDL import.\n47:  * \n48:  * @author Andreas Rueckert a_rueckert@gmx.net\n49:  */\n50: public class IDLFileImport extends FileImportSupport {\n51:     /**\n52:      * Logger.\n53:      */\n54:     private static final Logger LOG =\n55:         Logger.getLogger(IDLFileImport.class);\n56: \n57:     /////////////////////////////////////////////////////////\n58:     // Instance variables\n59: \n60:     /**\n61:      * The instance for a singleton pattern.\n62:      */\n63:     private static final IDLFileImport INSTANCE = new IDLFileImport();\n64: \n65:     /**\n66:      * An interface to the current diagram.\n67:      */ \n68:     private DiagramInterface diagram;\n69: \n70:     /** The files that needs a second RE pass. */\n71:     private ArrayList secondPassFiles;\n72: \n73:     // The current project.\n74:     private Project currentProject = null;\n75: \n76:     private Import myImport;\n77: \n78:     /**\n79:      * Return the singleton instance of the Import class.\n80:      * \n81:      * @return The only instance of this class.\n82:      */\n83:     public static IDLFileImport getInstance() {\n84: \treturn INSTANCE;\n85:     }\n86: \n87:     /**\n88:      * @see org.argouml.application.api.PluggableImport#parseFile(\n89:      *         org.argouml.kernel.Project, java.lang.Object, \n90:      *         org.argouml.uml.reveng.DiagramInterface, \n91:      *         org.argouml.uml.reveng.Import)\n92:      */\n93:     public void parseFile(\n94: \t\t\t  Project p,\n95: \t\t\t  Object o,\n96: \t\t\t  DiagramInterface theDiagram,\n97: \t\t\t  Import theImport)\n98: \tthrows Exception {\n99: \tif (o instanceof File) {\n100: \t    File f = (File) o;\n101: \t    diagram = theDiagram;\n102: \t    myImport = theImport;\n103: \t    startImport(p, f);\n104: \t}\n105:     }\n106: \n107:     /**\n108:      * Start the import process for a project and a file.\n109:      * \n110:      * @param p The project, where the import results are added.\n111:      * @param f The file to start with.\n112:      * @throws Exception if something goes wrong.\n113:      */\n114:     public void startImport(Project p, File f) throws Exception {\n115: \tsecondPassFiles = new ArrayList();\n116: \tcurrentProject = p;\n117: \n118: \t// Process the current file. If it's a directory, process all the file\n119: \t// in it.\n120: \tprocessFile(f, true);\n121: \n122: \t// Layout the modified diagrams.\n123: \tfor (Enumeration e = diagram.getModifiedDiagrams().elements();\n124: \t     e.hasMoreElements();\n125: \t     ) {\n126: \t    ClassdiagramLayouter layouter =\n127: \t\tnew ClassdiagramLayouter((UMLDiagram) e.nextElement());\n128: \t    layouter.layout();\n129: \n130: \t    // Resize the diagram???\n131: \t}\n132: \n133: \t// Let the use close the status window.\n134: \t//_status.importCompleted();\n135:     }\n136: \n137:     /**\n138:      * Count all the files, we're going to process, so we can display a\n139:      * progress bar.\n140:      *\n141:      * @param f The directory as a File.\n142:      * @param subdirectories If <tt>true</tt> we process subdirectories.\n143:      * @return The number of files to process.\n144:      * @throws Exception if something goes wrong.\n145:      */\n146:     private int countFiles(File f, boolean subdirectories) throws Exception {\n147: \tif (f.isDirectory() && subdirectories) {\n148: \t    return countDirectory(f);\n149: \t} else {\n150: \t    if (f.getName().endsWith(\".idl\")) {\n151: \t\treturn 1;\n152: \t    }\n153: \t    return 0;\n154: \t}\n155:     }\n156: \n157:     /**\n158:      * Count the files to process in a directory.\n159:      * \n160:      * @param f  The directory as a File.\n161:      * @return The number of files in that directory.\n162:      * @throws Exception if something goes wrong.\n163:      */\n164:     private int countDirectory(File f) throws Exception {\n165: \tint total = 0;\n166: \tString[] files = f.list(); // Get the content of the directory\n167: \n168: \tfor (int i = 0; i < files.length; i++) {\n169: \t    total\n170: \t\t+= countFiles(\n171: \t\t\t      new File(f, files[i]),\n172: \t\t\t      myImport.isDiscendDirectoriesRecursively());\n173: \n174: \t}\n175: \n176: \treturn total;\n177:     }\n178: \n179:     /**\n180:      * The main method for all parsing actions. It calls the actual parser\n181:      * methods depending on the type of the file.\n182:      * \n183:      * @param f The file or directory, we want to parse.\n184:      * @param subdirectories If <tt>true</tt> we process subdirectories.\n185:      * @throws Exception Parser exceptions.\n186:      */\n187:     public void processFile(File f, boolean subdirectories) throws Exception {\n188: \t\t\n189: \tif (f.isDirectory()\n190: \t    && subdirectories) { // If f is a directory and the subdirectory\n191: \t    // flag is set,\n192: \t    processDirectory(f); // import all the files in this directory\n193: \t} else {\n194: \t\t\t\n195: \t    if (f.getName().endsWith(\".idl\")) {\n196: \t\tString fileName = f.getName();\n197: \t\ttry {\n198: \t\t    parseFile(new FileInputStream(f), fileName);\n199: \t\t    // Try to parse this file.\n200: \t\t} catch (Exception e1) {\n201: \t\t    e1.printStackTrace();\n202: \t\t    secondPassFiles.add(f);\n203: \t\t}\n204: \t\t\t\t\n205: \t    }\n206: \t}\n207:     }\n208: \n209:     /**\n210:      * This method imports an entire directory. It calls the parser for