eturn MAssociation\n441:      * @throws IllegalArgumentException if either Classifier is null\n442:      */\n443:     private MAssociation buildAssociation(MClassifier c1,\n444: \t\t\t\t\t boolean nav1,\n445: \t\t\t\t\t MAggregationKind agg1,\n446: \t\t\t\t\t MClassifier c2,\n447: \t\t\t\t\t boolean nav2,\n448: \t\t\t\t\t MAggregationKind agg2) {\n449:         if (c1 == null || c2 == null) {\n450:             throw new IllegalArgumentException(\"one of \"\n451: \t\t\t\t\t       + \"the classifiers to be \"\n452: \t\t\t\t\t       + \"connected is null\");\n453:         }\n454:         MNamespace ns1 = c1.getNamespace();\n455:         MNamespace ns2 = c2.getNamespace();\n456:         if (ns1 == null || ns2 == null) {\n457:             throw new IllegalArgumentException(\"one of \"\n458: \t\t\t\t\t       + \"the classifiers does not \"\n459: \t\t\t\t\t       + \"belong to a namespace\");\n460:         }\n461:         MAssociation assoc =\n462:             UmlFactory.getFactory().getCore().createAssociation();\n463:         assoc.setName(\"\");\n464:         assoc.setNamespace(CoreHelper.getHelper().getFirstSharedNamespace(ns1,\n465:         \t\t\t\t\t\t\t\t  ns2));\n466:         buildAssociationEnd(\n467: \t\t\t    assoc,\n468: \t\t\t    null,\n469: \t\t\t    c1,\n470: \t\t\t    null,\n471: \t\t\t    null,\n472: \t\t\t    nav1,\n473: \t\t\t    null,\n474: \t\t\t    agg1,\n475: \t\t\t    null,\n476: \t\t\t    null,\n477: \t\t\t    null);\n478:         buildAssociationEnd(\n479: \t\t\t    assoc,\n480: \t\t\t    null,\n481: \t\t\t    c2,\n482: \t\t\t    null,\n483: \t\t\t    null,\n484: \t\t\t    nav2,\n485: \t\t\t    null,\n486: \t\t\t    agg2,\n487: \t\t\t    null,\n488: \t\t\t    null,\n489: \t\t\t    null);\n490:         return assoc;\n491:     }\n492: \n493:     /**\n494:      * Builds a binary associationrole on basis of two classifierroles,\n495:      * navigation and aggregation.\n496:      *\n497:      * @param fromClassifier   the first given classifier\n498:      * @param aggregationKind1 the first aggregationkind\n499:      * @param toClassifier     the second given classifier\n500:      * @param aggregationKind2 the second aggregationkind\n501:      * @param unidirectional true if unidirectional\n502:      * @return the newly build binary associationrole\n503:      */\n504:     public Object buildAssociation(\n505: \t\t\t\t\t Object fromClassifier,\n506: \t\t\t\t\t Object aggregationKind1,\n507: \t\t\t\t\t Object toClassifier,\n508: \t\t\t\t\t Object aggregationKind2,\n509: \t\t\t\t\t Boolean unidirectional) {\n510:         if (fromClassifier == null || toClassifier == null)\n511:                 throw new IllegalArgumentException(\"one of \"\n512:         \t\t\t\t       + \"the classifiers to be \"\n513:         \t\t\t\t       + \"connected is null\");\n514:         MClassifier from = (MClassifier) fromClassifier;\n515:         MClassifier to = (MClassifier) toClassifier;\n516:         MAggregationKind agg1 = (MAggregationKind) aggregationKind1;\n517:         MAggregationKind agg2 = (MAggregationKind) aggregationKind2;\n518:         \n519:         MNamespace ns1 = from.getNamespace();\n520:         MNamespace ns2 = to.getNamespace();\n521:         if (ns1 == null || ns2 == null)\n522:                 throw new IllegalArgumentException(\"one of \"\n523:         \t\t\t\t       + \"the classifiers does not \"\n524:         \t\t\t\t       + \"belong to a namespace\");\n525:         MAssociation assoc =\n526:                 UmlFactory.getFactory().getCore().createAssociation();\n527:         assoc.setName(\"\");\n528:         assoc.setNamespace(\n529:         \t\t   CoreHelper.getHelper().getFirstSharedNamespace(ns1,\n530:         \t\t\t\t\t\t\t\t  ns2));\n531:         \n532:         boolean nav1 = true;\n533:         boolean nav2 = true;\n534: \n535:         if (from instanceof MInterface) {\n536:             nav2 = false;\n537:             agg2 = agg1;\n538:             agg1 = null;\n539:         } else if (to instanceof MInterface) {\n540:             nav1 = false;\n541:         } else {\n542:             nav1 = !Boolean.TRUE.equals(unidirectional);\n543:             nav2 = true;\n544:         }\n545: \n546:         buildAssociationEnd(\n547: \t\t\t    assoc,\n548: \t\t\t    null,\n549: \t\t\t    from,\n550: \t\t\t    null,\n551: \t\t\t    null,\n552: \t\t\t    nav1,\n553: \t\t\t    null,\n554: \t\t\t    agg1,\n555: \t\t\t    null,\n556: \t\t\t    null,\n557: \t\t\t    null);\n558:         buildAssociationEnd(\n559: \t\t\t    assoc,\n560: \t\t\t    null,\n561: \t\t\t    to,\n562: \t\t\t    null,\n563: \t\t\t    null,\n564: \t\t\t    nav2,\n565: \t\t\t    null,\n566: \t\t\t    agg2,\n567: \t\t\t    null,\n568: \t\t\t    null,\n569: \t\t\t    null);\n570: \n571:         return assoc;\n572:     }\n573: \n574: \n575:     /**\n576:      * Builds a binary associations between two classifiers with\n577:      * default values for the association ends and the association\n578:      * itself.<p>\n579:      *\n580:      * @param classifier1 The first classifier to connect\n581:      * @param classifier2 The second classifier to connect\n582:      * @return MAssociation\n583:      */\n584:     public MAssociation buildAssociation(\n585:             Object classifier1,\n586: \t\t\tObject classifier2) {\n587:         MClassifier c1 = (MClassifier) classifier1;\n588:         MClassifier c2 = (MClassifier) classifier2;\n589:         return buildAssociation(c1, true, MAggregationKind.NONE,\n590:                                 c2, true, MAggregationKind.NONE);\n591:     }\n592: \n593:     /**\n594:      * Builds a binary association with a direction, aggregation\n595:      * and a given name.\n596:      *\n597:      * @param c1 The first classifier to connect to\n598:      * @param nav1 The navigability of the Associaton end\n599:      * @param c2 The second classifier to connect to\n600:      * @param nav2 The navigability of the second Associaton end\n601:      * @param name the given name\n602:      * @return association\n603:      */\n604:     public Object buildAssociation(Object c1, boolean nav1,\n605: \t\t\t\t   Object c2, boolean nav2, String name)\n606:     {\n607:         MAssociation assoc =\n608: \t    buildAssociation((MClassifier) c1, nav1, MAggregationKind.NONE,\n609: \t\t\t     (MClassifier) c2, nav2, MAggregationKind.NONE);\n610:         if (assoc != null)\n611:             assoc.setName(name);\n612:         return assoc;\n613:     }\n614: \n615:     /**\n616:      * Builds an associationClass between classifier end1 and end2 with a\n617:      * default class.<p>\n618:      *\n619:      * @param end1 the first given classifier\n620:      * @param end2 the second given classifier\n621:      * @return MAssociationClass\n622:      */\n623:     public MAssociationClass buildAssociationClass(\n624: \t\t\t\t\t\t   MClassifier end1,\n625: \t\t\t\t\t\t   MClassifier end2) {\n626:         if (end1 == null\n627:                 || end2 == null\n628:                 || end1 instanceof MAssociationClass\n629:                 || end2 instanceof MAssociationClass)\n630:             throw new IllegalArgumentException(\"\"\n631:         \t\t\t\t       + \"either one of the arguments \"\n632:         \t\t\t\t       + \"was null or \"\n633:         \t\t\t\t       + \"was instanceof \"\n634:         \t\t\t\t       + \"MAssociationClass\");\n635:         return buildAssociationClass((MClass) buildClass(), end1, end2);\n636:     }\n637: \n638:     /**\n639:      * Builds a fully configurable association end. All variables for\n640:      * an associationend can be given as parameter.\n641:      * @param assoc The associaton this end will be part of\n642:      * @param name The name of the association end\n643:      * @param type The type (classifier) the end will connect. The end\n644:      * is a connection piece between an association and a classifier\n645:      * @param multi The multiplicity\n646:      * @param stereo The stereotype\n647:      * @param navigable The navigability. True if this association end\n648:      *                  can be 'passed' from the other classifier.\n649:      * @param order Ordering of the association\n650:      * @param aggregation the aggregationkind\n651:      * @param scope the scope kind\n652:      * @param changeable the changeablekind\n653:      * @param visibility the visibilitykind\n654:      * @return MAssociationEnd\n655:      */\n656:     private MAssociationEnd buildAssociationEnd(\n657: \t\t\t\t\t       MAssociation assoc,\n658: \t\t\t\t\t       String name,\n659: \t\t\t\t\t       MClassifier type,\n660: \t\t\t\t\t       MMultiplicity multi,\n661: \t\t\t\t\t       MStereotype stereo,\n662: \t\t\t\t\t       boolean navigable,\n663: \t\t\t\t\t       MOrderingKind order,\n664: \t\t\t\t\t       MAggregationKind aggregation,\n665: \t\t\t\t\t       MScopeKind scope,\n666: \t\t\t\t\t       MChangeableKind changeable,\n667: \t\t\t\t\t       MVisibilityKind visibility) {\n668:         // wellformednessrules and preconditions\n669:         if (assoc == null || type == null) {\n670:             throw new IllegalArgumentException(\"either type or association \"\n671: \t\t\t\t\t       + \"are null\");\n672:         }\n673:         if (type instanceof MDataType || type instanceof MInterface) {\n674:             if (!navigable) {\n675:                 throw new IllegalArgumentException(\n676:                         \"Wellformedness rule 2.5.3.3 [1] is broken. \"\n677:                         + \"The Classifier of an AssociationEnd cannot be an \"\n678:                         + \"Interface or a DataType if the association is \"\n679:                         + \"navigable away from that end.\");\n680:             }\n681:             List ends = new ArrayList();\n682:             ends.addAll(assoc.getConnections());\n683:             Iterator it = ends.iterator();\n684:             while (it.hasNext()) {\n685:                 MAssociationEnd end = (MAssociationEnd) it.next();\n686:                 if (end.isNavigable()) {\n687:                     throw new IllegalArgumentException(\"type is either \"\n688: \t\t\t\t\t\t       + \"datatype or \"\n689: \t\t\t\t\t\t       + \"interface and is \"\n690: \t\t\t\t\t\t       + \"navigable to\");\n691:                 }\n692:             }\n693:         }\n694:         if (aggregation != null\n695:                 && aggregation.equals(MAggregationKind.COMPOSITE)\n696:                 && multi != null\n697:                 && multi.getUpper() > 1) {\n698:             throw new IllegalArgumentException(\"aggregation is composite \"\n699: \t\t\t\t\t   + \"and multiplicity > 1\");\n700:         }\n701: \n702:         MAssociationEnd end =\n703:             UmlFactory.getFactory().getCore().createAssociationEnd();\n704:         end.setAssociation(assoc);\n705:         end.setType(type);\n706:         end.setName(name);\n707:         if (multi != null) {\n708:             end.setMultiplicity(multi);\n709:         } else {\n710:             end.setMultiplicity(MMultiplicity.M1_1);\n711:         }\n712:         if (stereo != null) {\n713:             end.setStereotype(stereo);\n714:         }\n715:         end.setNavigable(navigable);\n716:         if (order != null) {\n717:             end.setOrdering(order);\n718:         } else {\n719:             end.setOrdering(MOrderingKind.UNORDERED);\n720:         }\n721:         if (aggregation != null) {\n722:             end.setAggregation(aggregation);\n723:         } else {\n724:             end.setAggregation(MAggregationKind.NONE);\n725:         }\n726:         if (scope != null) {\n727:             end.setTargetScope(scope);\n728:         } else {\n729:             end.setTargetScope(MScopeKind.INSTANCE);\n730:         }\n731:         if (changeable != null) {\n732:             end.setChangeability(changeable);\n733:         } else {\n734:             end.setChangeability(MChangeableKind.CHANGEABLE);\n735:         }\n736:         if (visibility != null) {\n737:             end.setVisibility(visibility);\n738:         } else {\n739:             end.setVisibility(MVisibilityKind.PUBLIC);\n740:         }\n741:         return end;\n742:     }\n743: \n744:     /**\n745:      * Builds an association class from a class and two classifiers\n746:      * that should be associated. Both ends of the associationclass\n747:      * are navigable.<p>\n748:      *\n749:      * @param cl the class\n750:      * @param end1 the first classifier\n751:      * @param end2 the second classifier\n752:      * @return MAssociationClass\n753:      */\n754:     private MAssociationClass buildAssociationClass(MClass cl,\n755: \t\t\t\t\t\t  MClassifier end1,\n756: \t\t\t\t\t\t  MClassifier end2) {\n757:         if (end1 == null\n758:                 || end2 == null\n759:                 || cl == null\n760:                 || end1 instanceof MAssociationClass\n761:                 || end2 instanceof MAssociationClass)\n762:             throw new IllegalArgumentException(\"either one of the arguments \"\n763:         \t\t\t\t       + \"was null or was instanceof \"\n764:         \t\t\t\t       + \"MAssociationClass\");\n765:         MAssociationClass assoc = createAssociationClass();\n766:         assoc.setName(cl.getName());\n767:         assoc.setAbstract(cl.isAbstract());\n768:         assoc.setActive(cl.isActive());\n769:         assoc.setAssociationEnds(cl.getAssociationEnds());\n770:         assoc.setClassifierRoles(cl.getClassifierRoles());\n771:         assoc.setClassifierRoles1(cl.getClassifierRoles1());\n772:         assoc.setClassifiersInState(cl.getClassifiersInState());\n773:         assoc.setClientDependencies(cl.getClientDependencies());\n774:         assoc.setCollaborations(cl.getCollaborations());\n775:         assoc.setCollaborations1(cl.getCollaborations1());\n776:         assoc.setComments(cl.getComments());\n777:         assoc.setConstraints(cl.getConstraints());\n778:         assoc.setCreateActions(cl.getCreateActions());\n779:         assoc.setFeatures(cl.getFeatures());\n780:         assoc.setExtensions(cl.getExtensions());\n781:         assoc.setGeneralizations(cl.getGeneralizations());\n782:         assoc.setInstances(cl.getInstances());\n783:         assoc.setLeaf(cl.isLeaf());\n784:         assoc.setNamespace(cl.getNamespace());\n785:         assoc.setObjectFlowStates(cl.getObjectFlowStates());\n786:         assoc.setParameters(cl.getParameters());\n787:         assoc.setParticipants(cl.getParticipants());\n788:         assoc.setPartitions1(cl.getPartitions1());\n789:         assoc.setPowertypeRanges(cl.getPowertypeRanges());\n790:         assoc.setPresentations(cl.getPresentations());\n791:         assoc.setRoot(cl.isRoot());\n792:         assoc.setSourceFlows(cl.getSourceFlows());\n793:         assoc.setSpecification(cl.isSpecification());\n794:         assoc.setStereotype(cl.getStereotype());\n795:         assoc.setStructuralFeatures(cl.getStructuralFeatures());\n796:         assoc.setTaggedValues(cl.getTaggedValues());\n797:         assoc.setVisibility(cl.getVisibility());\n798:         buildAssociationEnd(\n799:         \t\t    assoc,\n800:         \t\t    null,\n801:         \t\t    end1,\n802:         \t\t    null,\n803:         \t\t    null,\n804:         \t\t    true,\n805:         \t\t    null,\n806:         \t\t    null,\n807:         \t\t    null,\n808:         \t\t    null,\n809:         \t\t    null);\n810:         buildAssociationEnd(\n811:         \t\t    assoc,\n812:         \t\t    null,\n813:         \t\t    end2,\n814:         \t\t    null,\n815:         \t\t    null,\n816:         \t\t    true,\n817:         \t\t    null,\n818:         \t\t    null,\n819:         \t\t    null,\n820:         \t\t    null,\n821:         \t\t    null);\n822:         return assoc;\n823:     }\n824: \n825:     /**\n826:      * Builds a default attribute.\n827:      * @return MAttribute\n828:      */\n829:     public Object buildAttribute() {\n830:         //build the default attribute\n831:         // this should not be here via the ProjectBrowser but the CoreHelper\n832:         // should provide this functionality\n833:         Project p = ProjectManager.getManager().getCurrentProject();\n834:         MClassifier intType = (MClassifier) p.findType(\"int\");\n835:         if (p.getModel() != intType.getNamespace()\n836:                 && !(ModelManagementHelper.getHelper()\n837:                     .getAllNamespaces(p.getModel())\n838:         \t        .contains(intType.getNamespace()))) {\n839:             intType.setNamespace((MModel) p.getModel());\n840:         }\n841:         MAttribute attr = createAttribute();\n842:         attr.setName(\"newAttr\");\n843:         attr.setMultiplicity(\n844:             UmlFactory.getFactory().getDataTypes().createMultiplicity(1, 1));\n845:         attr.setStereotype(null);\n846:         attr.setOwner(null);\n847:         attr.setType(intType);\n848:         attr.setInitialValue(null);\n849:         attr.setVisibility(MVisibilityKind.PUBLIC);\n850:         attr.setOwnerScope(MScopeKind.INSTANCE);\n851:         attr.setChangeability(MChangeableKind.CHANGEABLE);\n852:         attr.setTaggedValue(\"transient\", \"false\");\n853:         attr.setTaggedValue(\"volatile\", \"false\");\n854:         attr.setTargetScope(MScopeKind.INSTANCE);\n855:         \n856:         return attr;\n857:     }\n858: \n859:     /**\n860:      * Builds an attribute owned by some classifier cls. I don't know\n861:      * if this is legal for an interface (purely UML speaking). In\n862:      * this method it is.<p>\n863:      *\n864:      * @param handle the given classifier\n865:      * @return the newly build attribute\n866:      */\n867:     public Object buildAttribute(Object handle) {\n868:         if (!ModelFacade.isAClassifier(handle)) {\n869:             return null;\n870:         }\n871:         MClassifier cls = (MClassifier) handle;\n872:         MAttribute attr = (MAttribute) buildAttribute();\n873:         cls.addFeature(attr);\n874:         // we set the listeners to the figs here too\n875:         // it would be better to do that in the figs themselves\n876:         Project p = ProjectManager.getManager().getCurrentProject();\n877:         Iterator it = p.findFigsForMember(cls).iterator();\n878:         while (it.hasNext()) {\n879:             PropertyChangeListener listener = \n880:                 (PropertyChangeListener) it.next();\n881:             // Model.getPump().removeModelEventListener(listener, attr);\n882:             Model.getPump().addModelEventListener(listener, attr);\n883:         }\n884:         return attr;\n885:     }\n886: \n887:     /**\n888:      * Builds a default implementation for a class. The class is not owned by\n889:      * any model element by default. Users should not forget to add ownership\n890:      * @return MClass\n891:      */\n892:     public Object buildClass() {\n893:         MClass cl = createClass();\n894:         // cl.setNamespace(ProjectBrowser.getInstance().getProject()\n895:         // .getModel());\n896:         cl.setName(\"\");\n897:         cl.setStereotype(null);\n898:         cl.setAbstract(false);\n899:         cl.setActive(false);\n900:         cl.setRoot(false);\n901:         cl.setLeaf(false);\n902:         cl.setSpecification(false);\n903:         cl.setVisibility(MVisibilityKind.PUBLIC);\n904:         return cl;\n905:     }\n906: \n907:     /**\n908:      * Builds a class with a given namespace.\n909:      *\n910:      * @param owner the namespace\n911:      * @return MClass\n912:      * @see #buildClass()\n913:      */\n914:     public Object buildClass(Object owner) {\n915:         Object clazz = buildClass();\n916:         if (owner instanceof MNamespace)\n917:             ModelFacade.setNamespace(clazz, /*MNamespace*/ owner);\n918:         return clazz;\n919:     }\n920: \n921:     /**\n922:      * Builds a class with a given name.\n923:      *\n924:      * @param name the given name\n925:      * @return MClass\n926:      * @see #buildClass()\n927:      */\n928:     public Object buildClass(String name) {\n929:         Object clazz = buildClass();\n930:         ModelFacade.setName(clazz, name);\n931:         return clazz;\n932:     }\n933: \n934:     /**\n935:      * Builds a class with a given name and namespace.\n936:      *\n937:      * @param name the given name\n938:      * @param owner the namespace\n939:      * @return MClass\n940:      * @see #buildClass()\n941:      */\n942:     public Object buildClass(String name, Object owner) {\n943:         Object clazz = buildClass();\n944:         ModelFacade.setName(clazz, name);\n945:         if (owner instanceof MNamespace) {\n946:             ModelFacade.setNamespace(clazz, /*MNamespace*/ owner);\n947:         }\n948:         return clazz;\n949:     }\n950: \n951:     /**\n952:      * Builds a default implementation for an interface. The interface\n953:      * is not owned by any model element by default. Users should not\n954:      * forget to add ownership.\n955:      *\n956:      * @return MInterface\n957:      */\n958:     public Object buildInterface() {\n959: \tMInterface cl = createInterface();\n960: \t// cl.setNamespace(ProjectBrowser.getInstance().getProject()\n961: \t// .getModel());\n962: \tcl.setName(\"\");\n963: \tcl.setStereotype(null);\n964: \tcl.setAbstract(false);\n965: \tcl.setRoot(false);\n966: \tcl.setLeaf(false);\n967: \tcl.setSpecification(false);\n968: \tcl.setVisibility(MVisibilityKind.PUBLIC);\n969: \treturn cl;\n970:     }\n971: \n972:     /**\n973:      * Builds an interface with a given namespace.\n974:      *\n975:      * @param owner is the owner\n976:      * @return MInterface\n977:      * @see #buildInterface()\n978:      */\n979:     public Object buildInterface(Object owner) {\n980: \tMInterface cl = (MInterface) buildInterface();\n981: \tif (owner instanceof MNamespace)\n982: \t    cl.setNamespace((MNamespace) owner);\n983: \treturn cl;\n984:     }\n985: \n986:     /**\n987:      * Builds an interface with a given name.\n988:      *\n989:      * @param name is the given name.\n990:      * @return MInterface\n991:      * @see #buildInterface()\n992:      */\n993:     public Object buildInterface(String name) {\n994: \tMInterface cl = (MInterface) buildInterface();\n995: \tcl.setName(name);\n996: \treturn cl;\n997:     }\n998: \n999:     /**\n1000:      * Builds an interface with a given name and namespace.\n1001:      *\n1002:      * @param name is the given name\n1003:      * @param owner is the namespace\n1004:      * @return MInterface\n1005:      * @see #buildInterface()\n1006:      */\n1007:     public Object buildInterface(String name, Object owner) {\n1008: \tMInterface cl = (MInterface) buildInterface();\n1009: \tcl.setName(name);\n1010: \tif (owner instanceof MNamespace)\n1011: \t    cl.setNamespace((MNamespace) owner);\n1012: \treturn cl;\n1013:     }\n1014: \n1015:     /**\n1016:      * Builds a datatype with a given name and namespace.\n1017:      *\n1018:      * @param name is the name\n1019:      * @param owner is the namespace\n1020:      * @return an initialized UML DataType instance.\n1021:      */\n1022:     public Object buildDataType(String name, Object owner) {\n1023: \tMDataType dt = createDataType();\n1024: \tdt.setName(name);\n1025: \tif (owner instanceof MNamespace)\n1026: \t    dt.setNamespace((MNamespace) owner);\n1027: \treturn dt;\n1028:     }\n1029: \n1030:     /**\n1031:      * Builds a modelelement dependency between two modelelements.<p>\n1032:      *\n1033:      * @param clientObj is the client\n1034:      * @param supplierObj is the supplier\n1035:      * @return MDependency\n1036:      */\n1037:     public Object buildDependency(Object clientObj,\n1038: \t\t\t\t       Object supplierObj) {\n1039: \n1040: \tMModelElement client = (MModelElement) clientObj;\n1041: \tMModelElement supplier = (MModelElement) supplierObj;\n1042: \tif (client == null\n1043:                 || supplier == null\n1044:                 || client.getNamespace() == null\n1045:                 || supplier.getNamespace() == null) {\n1046: \t    throw new IllegalArgumentException(\"client or supplier is null \"\n1047: \t\t\t\t\t       + \"or their namespaces.\");\n1048: \t}\n1049: \tMDependency dep = createDependency();\n1050: \tdep.addSupplier(supplier);\n1051: \tdep.addClient(client);\n1052: \tif (supplier.getNamespace() != null) {\n1053: \t    dep.setNamespace(supplier.getNamespace());\n1054: \t} else if (client.getNamespace() != null) {\n1055: \t    dep.setNamespace(client.getNamespace());\n1056: \t}\n1057: \treturn dep;\n1058:     }\n1059: \n1060:     /**\n1061:      * Builds a modelelement permission between two modelelements.\n1062:      *\n1063:      * @param clientObj is the client\n1064:      * @param supplierObj is the supplier\n1065:      * @return MPermission\n1066:      */\n1067:     public MPermission buildPermission(Object clientObj,\n1068: \t\t\t\t       Object supplierObj) {\n1069: \n1070: \tMModelElement client = (MModelElement) clientObj;\n1071: \tMModelElement supplier = (MModelElement) supplierObj;\n1072: \tif (client == null\n1073: \t    || supplier == null\n1074: \t    || client.getNamespace() == null\n1075: \t    || supplier.getNamespace() == null)\n1076: \t    throw new IllegalArgumentException(\"client or supplier is null \"\n1077: \t\t\t\t\t       + \"or their namespaces.\");\n1078: \tMPermission per = createPermission();\n1079: \tper.addSupplier(supplier);\n1080: \tper.addClient(client);\n1081: \tif (supplier.getNamespace() != null)\n1082: \t    per.setNamespace(supplier.getNamespace());\n1083: \telse if (client.getNamespace() != null)\n1084: \t    per.setNamespace(client.getNamespace());\n1085: \tExtensionMechanismsFactory.getFactory()\n1086: \t    .buildStereotype(per, \"import\", per.getNamespace());\n1087: \treturn per;\n1088:     }\n1089: \n1090:     /**\n1091:      * Builds a generalization between a parent and a child with a given name.\n1092:      *\n1093:      * @param child is the child\n1094:      * @param parent is the parent\n1095:      * @param name is the given name\n1096:      * @return generalization\n1097:      */\n1098:     public Object buildGeneralization(Object child, Object parent,\n1099: \t\t\t\t      String name)\n1100:     {\n1101:         if (child == null\n1102: \t    || parent == null\n1103: \t    || !(child instanceof MGeneralizableElement)\n1104: \t    || !(parent instanceof MGeneralizableElement))\n1105:             return null;\n1106:         Object gen = buildGeneralization(child, parent);\n1107:         if (gen != null)\n1108:             ((MGeneralization) gen).setName(name);\n1109:         return gen;\n1110:     }\n1111: \n1112:     /**\n1113:      * Builds a generalization between a parent and a child. Does not check if\n1114:      * multiple inheritance is allowed for the current notation.\n1115:      *\n1116:      * @param child1 is the child\n1117:      * @param parent1 is the parent\n1118:      * @return MGeneralization\n1119:      */\n1120:     public MGeneralization buildGeneralization(Object child1, Object parent1)\n1121:     {\n1122:         if (!(child1 instanceof MGeneralizableElement)\n1123: \t    || !(parent1 instanceof MGeneralizableElement))\n1124:             throw new IllegalArgumentException();\n1125: \n1126:         MGeneralizableElement child = (MGeneralizableElement) child1;\n1127:         MGeneralizableElement parent = (MGeneralizableElement) parent1;\n1128: \n1129:         if (parent.getParents().contains(child))\n1130:             return null;\n1131:         if (!child.getClass().equals(parent.getClass()))\n1132:             return null;\n1133:         Iterator it = parent.getGeneralizations().iterator();\n1134:         while (it.hasNext()) {\n1135:             MGeneralization gen = (MGeneralization) it.next();\n1136:             if (gen.getParent().equals(child))\n1137:                 return null;\n1138:         }\n1139:         if (parent.getNamespace() == null)\n1140:             return null;\n1141:         if (parent.isLeaf())\n1142:             return null;\n1143:         if (child.isRoot())\n1144:             return null;\n1145: \n1146:         MGeneralization gen = createGeneralization();\n1147:         gen.setParent(parent);\n1148:         gen.setChild(child);\n1149:         if (parent.getNamespace() != null)\n1150:             gen.setNamespace(parent.getNamespace());\n1151:         else if (child.getNamespace() != null)\n1152:             gen.setNamespace(child.getNamespace());\n1153:         return gen;\n1154:     }\n1155: \n1156:     /**\n1157:      * Builds a default method belonging to a certain operation. The\n1158:      * language of the body is set to the selected Notation\n1159:      * language. The body of the method is set to an emtpy string.\n1160:      *\n1161:      * @param op is the operation\n1162:      * @return MMethod\n1163:      */\n1164:     public MMethod buildMethod(MOperation op) {\n1165: \treturn buildMethod(op, Notation.getDefaultNotation(), \"\");\n1166:     }\n1167: \n1168:     /**\n1169:      * Builds a method belonging to a certain operation.\n1170:      * @param op The operation this method belongs to\n1171:      * @param notation The notationname (language name) of the body\n1172:      * @param body The actual body of the method\n1173:      * @return MMethod\n1174:      */\n1175:     public MMethod buildMethod(\n1176: \t\t\t       MOperation op,\n1177: \t\t\t       NotationName notation,\n1178: \t\t\t       String body) {\n1179: \tMMethod method = createMethod();\n1180: \tif (op != null) {\n1181: \t    method.setSpecification(op);\n1182: \t    MClassifier owner = op.getOwner();\n1183: \t    if (owner != null) {\n1184: \t\tmethod.setOwner(owner);\n1185: \t    }\n1186: \t}\n1187: \tif (notation != null && notation.getName() != null) {\n1188: \t    method.setBody(\n1189: \t\t\t   UmlFactory\n1190: \t\t\t   .getFactory()\n1191: \t\t\t   .getDataTypes()\n1192: \t\t\t   .createProcedureExpression(\n1193: \t\t\t\t\t\t      notation.getName(),\n1194: \t\t\t\t\t\t      body));\n1195: \t}\n1196: \treturn method;\n1197:     }\n1198: \n1199:     /**\n1200:      * Builds a method with a given name.\n1201:      *\n1202:      * @param name is the given name\n1203:      * @return method\n1204:      */\n1205:     public MMethod buildMethod(String name) {\n1206:         MMethod method = createMethod();\n1207:         if (method != null)\n1208:             method.setName(name);\n1209:         return method;\n1210:     }\n1211: \n1212:     /**\n1213:      * Builds an operation for a classifier.<p>\n1214:      *\n1215:      * @param handle is the classifier.\n1216:      * @return MOperation\n1217:      */\n1218:     public MOperation buildOperation(Object handle) {\n1219:         if (!(handle instanceof MClassifier)) {\n1220:             throw new IllegalArgumentException(\"Handle is not a classifier\");\n1221:         }\n1222:         MClassifier cls = (MClassifier) handle;\n1223: \tMOperation oper = createOperation();\n1224: \toper.setName(\"newOperation\");\n1225: \toper.setStereotype(null);\n1226: \toper.setOwner(cls);\n1227: \toper.setVisibility(MVisibilityKind.PUBLIC);\n1228: \toper.setAbstract(false);\n1229: \toper.setLeaf(false);\n1230: \toper.setRoot(false);\n1231: \toper.setQuery(false);\n1232: \toper.setOwnerScope(MScopeKind.INSTANCE);\n1233:         // Jaap Branderhorst 6-4-2003 commented out next line since an\n1234:         // operation cannot have two owners.  the owner must be the\n1235:         // owning classifier which must be set via the setOwner\n1236:         // method, not via the namespace.\n1237: \t//\n1238:         // oper.setNamespace(cls);\n1239: \toper.setConcurrency(MCallConcurrencyKind.SEQUENTIAL);\n1240: \n1241: \tMParameter returnParameter = buildParameter(oper);\n1242: \treturnParameter.setKind(MParameterDirectionKind.RETURN);\n1243: \treturnParameter.setName(\"return\");\n1244: \t// we set the listeners to the figs here too it would be\n1245: \t// better to do that in the figs themselves the\n1246: \t// elementlistener for the parameter is allready set in\n1247: \t// buildparameter(oper)\n1248: \tProject p = ProjectManager.getManager().getCurrentProject();\n1249: \tIterator it = p.findFigsForMember(cls).iterator();\n1250: \twhile (it.hasNext()) {\n1251: \t    PropertyChangeListener listener = \n1252: \t        (PropertyChangeListener) it.next();\n1253: \t    // UmlModelEventPump.getPump().removeModelEventListener(listener,\n1254: \t    // oper);\n1255: \t    Model.getPump().addModelEventListener(listener, oper);\n1256: \t}\n1257: \treturn oper;\n1258:     }\n1259: \n1260:     /**\n1261:      * Builds an operation with a given name for classifier.\n1262:      *\n1263:      * @param cls is the classifier.\n1264:      * @param name is the given name.\n1265:      * @return MOperation\n1266:      */\n1267:     public Object buildOperation(Object cls, String name) {\n1268:         MOperation oper = buildOperation(cls);\n1269:         if (oper != null)\n1270:             oper.setName(name);\n1271:         return oper;\n1272:     }\n1273: \n1274:     /**\n1275:      * Constructs a default parameter.\n1276:      *\n1277:      * @return      The newly created parameter.\n1278:      */\n1279:     public MParameter buildParameter() {\n1280: \t// this should not be here via the ProjectBrowser but the CoreHelper\n1281: \t// should provide this functionality\n1282: \tProject p = ProjectManager.getManager().getCurrentProject();\n1283: \tMClassifier voidType = (MClassifier) p.findType(\"void\");\n1284: \tif (voidType.getModel() != p.getModel()) {\n1285: \t    voidType.setNamespace((MModel) p.getModel());\n1286: \t}\n1287: \tMParameter res = UmlFactory.getFactory().getCore().createParameter();\n1288: \tres.setName(\"\");\n1289: \tres.setStereotype(null);\n1290: \tres.setType(voidType);\n1291: \tres.setKind(MParameterDirectionKind.IN);\n1292: \tres.setDefaultValue(null);\n1293: \n1294: \treturn res;\n1295:     }\n1296: \n1297:     /**\n1298:      * Constructs a default parameter and adds it to oper. The name is\n1299:      * unique in the operation so no code generation problems will\n1300:      * exist.\n1301:      *\n1302:      * @param oper  The operation where it is added to.\n1303:      *          If null, it is not added.\n1304:      * @return      The newly created parameter.\n1305:      */\n1306:     public MParameter buildParameter(MBehavioralFeature oper) {\n1307: \tif (oper == null || oper.getOwner() == null)\n1308: \t    throw new IllegalArgumentException(\"operation is null or does not \"\n1309: \t\t\t\t\t       + \"have an owner\");\n1310: \tMParameter res = buildParameter();\n1311: \tString name = \"arg\";\n1312: \tint counter = 1;\n1313: \n1314: \toper.addParameter(res);\n1315: \tIterator it = oper.getParameters().iterator();\n1316: \twhile (it.hasNext()) {\n1317: \t    MParameter para = (MParameter) it.next();\n1318: \t    if ((name + counter).equals(para.getName())) {\n1319: \t\tcounter++;\n1320: \t    }\n1321: \t}\n1322: \n1323: \tres.setName(name + counter);\n1324: \n1325: \t// we set the listeners to the figs here too\n1326: \t// it would be better to do that in the figs themselves\n1327: \tProject p = ProjectManager.getManager().getCurrentProject();\n1328: \tit = p.findFigsForMember(oper).iterator();\n1329: \twhile (it.hasNext()) {\n1330: \t    PropertyChangeListener listener = \n1331: \t        (PropertyChangeListener) it.next();\n1332: \t    // Model.getPump().removeModelEventListener(listener, res);\n1333: \t    Model.getPump().addModelEventListener(listener, res);\n1334: \t}\n1335: \n1336: \treturn res;\n1337:     }\n1338: \n1339:     /**\n1340:      * Constructs a default parameter, adds it to oper and sets its type\n1341:      * (return etc.).<p>\n1342:      *\n1343:      * @param feature The operation where it is added to.\n1344:      *          If null, it is not added.\n1345:      * @param dk The directionkind. If null it is not set.\n1346:      * @return      The newly created parameter.\n1347:      */\n1348:     public Object buildParameter(Object feature, Object dk) {\n1349:         MBehavioralFeature oper = (MBehavioralFeature) feature;\n1350:         MParameterDirectionKind directionKind = (MParameterDirectionKind) dk;\n1351: \tMParameter res = buildParameter(oper);\n1352: \tif (directionKind != null) {\n1353: \t    ModelFacade.setKind(res, directionKind);\n1354: \t}\n1355: \treturn res;\n1356:     }\n1357: \n1358:     /**\n1359:      * Adds a parameter initialized to default values to a given event\n1360:      * or behavioral feature\n1361:      * @param o an event or behavioral feature\n1362:      * @return MParameter\n1363:      */\n1364:     public MParameter buildParameter(Object o) {\n1365: \tif (o instanceof MEvent) {\n1366: \t    MEvent event = (MEvent) o;\n1367: \t    MParameter res = buildParameter();\n1368: \t    res.setKind(MParameterDirectionKind.IN);\n1369: \t    //    removing this next line solves issue 2209\n1370: \t    //res.setNamespace(event.getNamespace()); \n1371:             event.addParameter(res);\n1372: \t    return res;\n1373: \t} else if (o instanceof MBehavioralFeature) {\n1374: \t    return buildParameter((MBehavioralFeature) o);\n1375: \t} else\n1376: \t    return null;\n1377:     }\n1378: \n1379:     /**\n1380:      * Builds a realization between some supplier (for example an\n1381:      * interface in Java) and a client who implements the realization.\n1382:      *\n1383:      * @param client is the client\n1384:      * @param supplier is the supplier\n1385:      * @return Object the created abstraction\n1386:      */\n1387:     public Object buildRealization(MModelElement client,\n1388: \t\t\t\t   MModelElement supplier)\n1389:     {\n1390: \tif (client == null\n1391: \t    || supplier == null\n1392: \t    || client.getNamespace() == null\n1393: \t    || supplier.getNamespace() == null)\n1394: \t{\n1395: \t    throw new IllegalArgumentException(\"faulty arguments.\");\n1396: \t}\n1397: \tObject realization =\n1398: \t    UmlFactory.getFactory().getCore().createAbstraction();\n1399: \tMNamespace nsc = client.getNamespace();\n1400: \tMNamespace nss = supplier.getNamespace();\n1401: \tMNamespace ns = null;\n1402: \tif (nsc != null && nsc.equals(nss)) {\n1403: \t    ns = nsc;\n1404: \t} else {\n1405: \t    ns =\n1406: \t\t(MModel) ProjectManager.getManager().getCurrentProject()\n1407: \t\t    .getModel();\n1408: \t}\n1409: \tExtensionMechanismsFactory.getFactory().buildStereotype(realization,\n1410: \t\t\t\t\t\t\t\t\"realize\", ns);\n1411: \tModelFacade.addClientDependency(client, realization);\n1412: \tModelFacade.addSupplierDependency(supplier, realization);\n1413: \treturn realization;\n1414:     }\n1415: \n1416:     /**\n1417:      * Builds a usage between some client and a supplier. If client\n1418:      * and supplier do not have the same model, an\n1419:      * {@link IllegalArgumentException} is thrown.\n1420:      *\n1421:      * @param client is the client\n1422:      * @param supplier is the supplier\n1423:      * @return MUsage\n1424:      */\n1425:     public MUsage buildUsage(MModelElement client, MModelElement supplier) {\n1426: \tif (client == null || supplier == null) {\n1427: \t    throw new IllegalArgumentException(\"In buildUsage null arguments.\");\n1428: \t}\n1429: \tif (client.getModel() != supplier.getModel()) {\n1430: \t    throw new IllegalArgumentException(\"To construct a usage, the \"\n1431: \t\t\t\t\t       + \"client and the supplier \"\n1432: \t\t\t\t\t       + \"must be part of the same \"\n1433: \t\t\t\t\t       + \"model.\");\n1434: \t}\n1435: \tMUsage usage = UmlFactory.getFactory().getCore().createUsage();\n1436: \tusage.addSupplier(supplier);\n1437: \tusage.addClient(client);\n1438: \tif (supplier.getNamespace() != null)\n1439: \t    usage.setNamespace(supplier.getNamespace());\n1440: \telse if (client.getNamespace() != null)\n1441: \t    usage.setNamespace(client.getNamespace());\n1442: \treturn usage;\n1443:     }