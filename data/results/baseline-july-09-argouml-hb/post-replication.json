                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/ui/PropPanel.java: \n1: // Copyright (c) 1996-02 The Regents of the University of California. All\n2: // Rights Reserved. Permission to use, copy, modify, and distribute this\n3: // software and its documentation without fee, and without ga written\n4: // agreement is hereby granted, provided that the above copyright notice\n5: // and this paragraph appear in all copies.  This software program and\n6: // documentation are copyrighted by The Regents of the University of\n7: // California. The software program and documentation are supplied \"AS\n8: // IS\", without any accompanying services from The Regents. The Regents\n9: // does not warrant that the operation of the program will be\n10: // uninterrupted or error-free. The end-user understands that the program\n11: // was developed for research purposes and is advised not to rely\n12: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n13: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n14: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n15: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n16: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n17: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n18: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n19: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n20: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n21: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n22: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n23: \n24: // File: PropPanel.java\n25: // Classes: PropPanel\n26: // Original Author:\n27: // $Id$\n28: \n29: // 23 Apr 2002: Jeremy Bennett (mail@jeremybennett.com). Added the third party\n30: // event listener.\n31: \n32: // 25 Apr 2002: Jeremy Bennett (mail@jeremybennett.com). Reworked\n33: // setNameEventListener to use third party event listeners, and removed the\n34: // promiscuous listener stuff.\n35: \n36: package org.argouml.uml.ui;\n37: \n38: import java.awt.BorderLayout;\n39: import java.awt.Color;\n40: import java.awt.Component;\n41: import java.awt.Container;\n42: import java.awt.FlowLayout;\n43: import java.awt.Font;\n44: import java.awt.GridBagConstraints;\n45: import java.awt.GridBagLayout;\n46: import java.awt.GridLayout;\n47: import java.awt.event.ActionEvent;\n48: import java.util.EventListener;\n49: import java.util.Iterator;\n50: import java.util.MissingResourceException;\n51: import java.util.ResourceBundle;\n52: import java.util.Vector;\n53: \n54: import javax.swing.Icon;\n55: import javax.swing.ImageIcon;\n56: import javax.swing.JComponent;\n57: import javax.swing.JLabel;\n58: import javax.swing.JPanel;\n59: import javax.swing.SwingConstants;\n60: import javax.swing.SwingUtilities;\n61: import javax.swing.event.EventListenerList;\n62: import javax.swing.plaf.metal.MetalLookAndFeel;\n63: //\n64: import org.argouml.application.helpers.ResourceLoaderWrapper;\n65: import org.argouml.kernel.ProjectManager;\n66: import org.argouml.model.ModelFacade;\n67: import org.argouml.model.uml.UmlModelEventPump;\n68: import org.argouml.swingext.*;\n69: import org.argouml.swingext.ignoreSplittersFlag;\n70: import org.argouml.ui.TabSpawnable;\n71: import org.argouml.ui.targetmanager.TargetEvent;\n72: import org.argouml.ui.targetmanager.TargetListener;\n73: import org.argouml.ui.targetmanager.TargetManager;\n74: import org.argouml.ui.targetmanager.TargettableModelView;\n75: import org.argouml.uml.Profile;\n76: import org.argouml.uml.ProfileJava;\n77: \n78: import org.tigris.gef.presentation.Fig;\n79: \n80: import ru.novosoft.uml.MBase;\n81: import ru.novosoft.uml.MElementEvent;\n82: import ru.novosoft.uml.MElementListener;\n83: import ru.novosoft.uml.foundation.core.MModelElement;\n84: import ru.novosoft.uml.foundation.core.MNamespace;\n85: import ru.novosoft.uml.foundation.extension_mechanisms.MStereotype;\n86: \n87: /**\n88:  *   <p>This abstract class provides the basic layout and event dispatching\n89:  *   support for all Property Panels.</p>\n90:  *\n91:  *   <p>The property panel is {@link org.argouml.swingext.LabelledLayout layed out}\n92:  *   as a number (specified in the constructor) of equally sized panels\n93:  *   that split the available space.  Each panel has a column of\n94:  *   \"captions\" and matching column of \"fields\" which are laid out\n95:  *   indepently from the other panels.\n96:  *   </p>\n97:  *  \n98:  *   <p>The Properties panels for UML Model Elements are structured in an\n99:  *   inheritance hierarchy that matches the UML 1.3 metamodel.\n100:  */\n101: abstract public class PropPanel extends TabSpawnable implements TabModelTarget, MElementListener, UMLUserInterfaceContainer {\n102:     ////////////////////////////////////////////////////////////////\n103:     // instance vars\n104:     private Object _target;\n105:     private MModelElement _modelElement;\n106:     private static Profile _profile;\n107: \n108:     private ResourceBundle _bundle = null;\n109: \n110:     private Vector _panels = new Vector();\n111: \n112:     private int lastRow;\n113:     \n114:     private EventListenerList _listenerList;\n115: \n116:     /**\n117:      * <p>The metaclass/property pairs for the third party listener (if we have\n118:      *   set one up. We use this when creating a new listener on target\n119:      *   change.</p>\n120:      */\n121: \n122:     private Vector _targetList = null;\n123:     private JPanel center;\n124: \n125:     protected Toolbar buttonPanel = new Toolbar();\n126:     private JPanel buttonPanelWithFlowLayout = new JPanel();\n127: \n128:     private JLabel _titleLabel;\n129: \n130:     private JPanel captionPanel = new JPanel();\n131: \n132:     protected static ImageIcon _deleteIcon = ResourceLoaderWrapper.getResourceLoaderWrapper().lookupIconResource(\"RedDelete\");\n133:     protected static ImageIcon _navUpIcon = ResourceLoaderWrapper.getResourceLoaderWrapper().lookupIconResource(\"NavigateUp\");\n134: \n135:     protected Font smallFont = MetalLookAndFeel.getSubTextFont();\n136: \n137:     /**\n138:      * Construct new PropPanel using LabelledLayout\n139:      * @param icon The icon to display for the panel\n140:      * @param title The title of the panel\n141:      * @param sectionCount the number of sections in the proppanel\n142:      */\n143:     public PropPanel(String title, ImageIcon icon, ignoreSplittersFlag orientation) {\n144:         super(title);\n145:         setOrientation(orientation);\n146: \n147:         setLayout(new LabelledLayout(orientation));\n148: \n149:         if (icon != null) {\n150:             _titleLabel = new JLabel(localize(title), icon, SwingConstants.LEFT);\n151:         }\n152:         else {\n153:             _titleLabel = new JLabel(localize(title));\n154:         }\n155:         //buttonPanel = new JPanel(new SerialLayout());\n156:         _titleLabel.setLabelFor(buttonPanel);\n157:         add(_titleLabel);\n158:         add(buttonPanel);\n159:     }\n160:     \n161:     /**\n162:      * Constructs a new Proppanel without an icon. If there is an icon it's\n163:      * updated at runtime via settarget.\n164:      * @param title\n165:      * @param orientation\n166:      */\n167:     public PropPanel(String title, ignoreSplittersFlag orientation) {\n168:         this (title, null, orientation);\n169:     }\n170: \n171:     /**\n172:      * Set the orientation of the panel\n173:      * @param orientation\n174:      */\n175:     public void setOrientation(ignoreSplittersFlag orientation) {\n176:         super.setOrientation(orientation);\n177:     }\n178: \n179:     /**\n180:      * Add a component with the specified label\n181:      * @param label the label for the component\n182:      * @param component the component\n183:      */\n184:     public JLabel addField(String label, Component component) {\n185:         JLabel jlabel = new JLabel(localize(label));\n186:         jlabel.setLabelFor(component);\n187:         add(jlabel);\n188:         add(component);\n189:         return jlabel;\n190:     }\n191: \n192:     /**\n193:      * Add a component with the specified label positioned after another component\n194:      * @param label the label for the component\n195:      * @param component the component\n196:      */\n197:     public JLabel addFieldAfter(String label, Component component, Component afterComponent) {\n198:         int nComponent = this.getComponentCount();\n199:         for (int i = 0; i < nComponent; ++i) {\n200:             if (getComponent(i) == afterComponent) {\n201:                 JLabel jlabel = new JLabel(localize(label));\n202:                 jlabel.setLabelFor(component);\n203:                 add(jlabel, ++i);\n204:                 add(component, ++i);\n205:                 return jlabel;\n206:             }\n207:         }\n208:         throw new IllegalArgumentException(\"Component not found\");\n209:     }\n210: \n211:     /**\n212:      * Add a component with the specified label positioned before another component\n213:      * @param label the label for the component\n214:      * @param component the component\n215:      * @param beforeComponent the component\n216:      */\n217:     public JLabel addFieldBefore(String label, Component component, Component beforeComponent) {\n218:         int nComponent = this.getComponentCount();\n219:         for (int i = 0; i < nComponent; ++i) {\n220:             if (getComponent(i) == beforeComponent) {\n221:                 JLabel jlabel = new JLabel(localize(label));\n222:                 jlabel.setLabelFor(component);\n223:                 add(jlabel, i);\n224:                 add(component, ++i);\n225:                 return jlabel;\n226:             }\n227:         }\n228:         throw new IllegalArgumentException(\"Component not found\");\n229:     }\n230: \n231:     /**\n232:      *   Adds a component to the fields of the specified panel\n233:      *     and sets the background and color to indicate\n234:      *     the field is a link.\n235:      *   @param label the required string label\n236:      *   @param component Component to be added\n237:      */\n238:     public final void addLinkField(String label, JComponent component) {\n239:         component.setBackground(getBackground());\n240:         component.setForeground(Color.blue);\n241:         addField(label, component);\n242:     }\n243: \n244:     final public String localize(String key) {\n245:         String localized = key;\n246:         if (_bundle == null) {\n247:             _bundle = getResourceBundle();\n248:         }\n249:         if (_bundle != null) {\n250:             try {\n251:                 localized = _bundle.getString(key);\n252:             } catch (MissingResourceException e) {\n253:             }\n254:             if (localized == null) {\n255:                 localized = key;\n256:             }\n257:         }\n258:         return localized;\n259:     }\n260: \n261:     final protected void addSeperator() {\n262:         add(LabelledLayout.getSeperator());\n263:     }\n264: \n265:     public ResourceBundle getResourceBundle() {\n266:         return null;\n267:     }\n268: \n269:     public Profile getProfile() {\n270:         if (_profile == null) {\n271:             _profile = ProfileJava.getInstance();\n272:         }\n273:         return _profile;\n274:     }\n275: \n276:     /**\n277:         This method (and addMElementListener) can be overriden if the\n278:         prop panel wants to monitor additional objects.\n279:     \n280:         @param target target of prop panel\n281:     \n282:     */\n283:     protected void removeMElementListener(MBase target) {\n284:         UmlModelEventPump.getPump().removeModelEventListener(this, target);\n285:     }\n286: \n287:     /**\n288:         This m