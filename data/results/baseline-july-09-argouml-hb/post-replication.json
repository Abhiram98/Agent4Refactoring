tial value] <br>\n959:      * list := [param] [, param]*\n960:      * \n961:      * <p>\n962:      * <b>inout </b> is optional and if omitted the old value preserved. If no\n963:      * value has been assigned, then <b>in </b> is assumed. <br>\n964:      * <b>name </b>, <b>type </b> and <b>initial value </b> are optional and if\n965:      * omitted the old value preserved. <br>\n966:      * <b>type </b> and <b>initial value </b> can be given in any order. <br>\n967:      * Unspecified properties is carried over by position, so if a parameter is\n968:      * inserted into the list, then it will inherit properties from the\n969:      * parameter that was there before for unspecified properties.\n970:      * \n971:      * <p>\n972:      * This syntax is compatible with the UML 1.3 specification.\n973:      * \n974:      * @param op\n975:      *            The operation the parameter list belongs to.\n976:      * @param param\n977:      *            The parameter list, without enclosing parentheses.\n978:      * @param paramOffset\n979:      *            The offset to the beginning of the parameter list. Used for\n980:      *            error reports.\n981:      * @throws java.text.ParseException\n982:      *             when it detects an error in the attribute string. See also\n983:      *             ParseError.getErrorOffset().\n984:      */\n985:     private void parseParamList(Object op, String param, int paramOffset)\n986:         throws ParseException {\n987:         MyTokenizer st = new MyTokenizer(param, \" ,\\t,:,=,\\\\,\",\n988:                 parameterCustomSep);\n989:         Collection origParam = ModelFacade.getParameters(op);\n990:         Object ns = ModelFacade.getModel(op);\n991:         if (ModelFacade.isAOperation(op)) {\n992:             Object ow = ModelFacade.getOwner(op);\n993: \n994:             if (ow != null && ModelFacade.getNamespace(ow) != null)\n995:                 ns = ModelFacade.getNamespace(ow);\n996:         }\n997: \n998:         Iterator it = origParam.iterator();\n999:         while (st.hasMoreTokens()) {\n1000:             String kind = null;\n1001:             String name = null;\n1002:             String tok;\n1003:             String type = null;\n1004:             String value = null;\n1005:             Object p = null;\n1006:             boolean hasColon = false;\n1007:             boolean hasEq = false;\n1008: \n1009:             while (it.hasNext() && p == null) {\n1010:                 p = it.next();\n1011:                 if (ModelFacade.isReturn(p))\n1012:                     p = null;\n1013:             }\n1014: \n1015:             while (st.hasMoreTokens()) {\n1016:                 tok = st.nextToken();\n1017: \n1018:                 if (\",\".equals(tok)) {\n1019:                     break;\n1020:                 } else if (\" \".equals(tok) || \"\\t\".equals(tok)) {\n1021:                     if (hasEq)\n1022:                         value += tok;\n1023:                 } else if (\":\".equals(tok)) {\n1024:                     hasColon = true;\n1025:                     hasEq = false;\n1026:                 } else if (\"=\".equals(tok)) {\n1027:                     if (value != null)\n1028:                         throw new ParseException(\"Parameters cannot have two \"\n1029:                                 + \"default values\", paramOffset\n1030:                                 + st.getTokenIndex());\n1031:                     hasEq = true;\n1032:                     hasColon = false;\n1033:                     value = \"\";\n1034:                 } else if (hasColon) {\n1035:                     if (type != null)\n1036:                         throw new ParseException(\"Parameters cannot have two \"\n1037:                                 + \"types\", paramOffset + st.getTokenIndex());\n1038: \n1039:                     if (tok.charAt(0) == '\\'' || tok.charAt(0) == '\\\"')\n1040:                         throw new ParseException(\"Parameter type cannot be \"\n1041:      