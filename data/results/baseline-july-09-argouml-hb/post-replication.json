mentException e) {\n250:                 // We moused over an object just as it was deleted\n251:                 // transient condition - doesn't require I18N\n252:                 LOG.warn(\"A deleted element still exists on the diagram\");\n253:                 return Translator.localize(\"misc.name.deleted\");\n254:             }\n255:         } else {\n256:             tip = toString();\n257:         }\n258: \n259:         if (tip != null && tip.length() > 0 && !tip.endsWith(\" \")) {\n260:             tip += \" \";\n261:         }\n262:         return tip;\n263:     }\n264: \n265:     /*\n266:      * @see org.tigris.gef.ui.PopupGenerator#getPopUpActions(java.awt.event.MouseEvent)\n267:      */\n268:     public Vector getPopUpActions(MouseEvent me) {\n269:         Vector popUpActions = super.getPopUpActions(me);\n270:         \n271:         // TODO: Remove this line after 0.20.\n272:         // This is a hack that removes the ordering menu according to issue 3645\n273:         popUpActions.remove(0);\n274: \n275:         // popupAddOffset should be equal to the number of items added here:\n276:         popUpActions.addElement(new JSeparator());\n277:         popupAddOffset = 1;\n278:         if (removeFromDiagram) {\n279:             popUpActions.addElement(\n280:                     ProjectBrowser.getInstance().getRemoveFromDiagramAction());\n281:             popupAddOffset++;\n282:         }\n283:         popUpActions.addElement(new ActionDeleteModelElements());\n284:         popupAddOffset++;\n285: \n286:         /* Check if multiple items are selected: */\n287:         boolean ms = TargetManager.getInstance().getTargets().size() > 1;\n288:         if (!ms) {\n289:             ToDoList list = Designer.theDesigner().getToDoList();\n290:             Vector items =\n291:                 (Vector) list.elementsForOffender(getOwner()).clone();\n292:             if (items != null && items.size() > 0) {\n293:                 ArgoJMenu critiques = new ArgoJMenu(\"menu.popup.critiques\");\n294:                 ToDoItem itemUnderMouse = hitClarifier(me.getX(), me.getY());\n295:                 if (itemUnderMouse != null) {\n296:                     critiques.add(new ActionGoToCritique(itemUnderMouse));\n297:                     critiques.addSeparator();\n298:                 }\n299:                 int size = items.size();\n300:                 for (int i = 0; i < size; i++) {\n301:                     ToDoItem item = (ToDoItem) items.elementAt(i);\n302:                     if (item == itemUnderMouse)\n303:                         continue;\n304:                     critiques.add(new ActionGoToCritique(item));\n305:                 }\n306:                 popUpActions.insertElementAt(new JSeparator(), 0);\n307:                 popUpActions.insertElementAt(critiques, 0);\n308:             }\n309:         }\n310:         // Add stereotypes submenu\n311:         Action[] stereoActions = getApplyStereotypeActions();\n312:         if (stereoActions != null) {\n313:             popUpActions.insertElementAt(new JSeparator(), 0);\n314:             ArgoJMenu stereotypes = new ArgoJMenu(\n315:                     \"menu.popup.apply-stereotypes\");\n316:             for (int i = 0; i < stereoActions.length; ++i) {\n317:                 stereotypes.addCheckItem(stereoActions[i]);\n318:             }\n319:             popUpActions.insertElementAt(stereotypes, 0);\n320:         }\n321:         return popUpActions;\n322:     }\n323:     \n324:     /**\n325:      * Get the set of Actions which valid for adding/removing\n326:      * Stereotypes on the ModelElement of this Fig's owner.\n327:      *  \n328:      * @return array of Actions \n329:      */\n330:     protected Action[] getApplyStereotypeActions() {\n331:         return StereotypeUtility.getApplyStereotypeActions(getOwner());\n332:     }\n333: \n334:     /**\n335:      * distance formula: (x-h)^2 + (y-k)^2 = distance^2\n336:      *\n337:      * @param p1 point\n338:      * @param p2 point\n339:      * @return the square of the distance\n340:      */\n341:     protected int getSquaredDistance(Point p1, Point p2) {\n342:         int xSquared = p2.x - p1.x;\n343:         xSquared *= xSquared;\n344:         int ySquared = p2.y - p1.y;\n345:         ySquared *= ySquared;\n346:         return xSquared + ySquared;\n347:     }\n348: \n349:     /**\n350:      * @param g the <code>Graphics</code> object\n351:      */\n352:     protected void paintClarifiers(Graphics g) {\n353:         int iconPos = 25, gap = 1, xOff = -4, yOff = -4;\n354:         Point p = new Point();\n355:         ToDoList list = Designer.theDesigner().getToDoList();\n356:         Vector items = list.elementsForOffender(getOwner());\n357:         int size = items.size();\n358:         for (int i = 0; i < size; i++) {\n359:             ToDoItem item = (ToDoItem) items.elementAt(i);\n360:             Icon icon = item.getClarifier();\n361:             if (icon instanceof Clarifier) {\n362:                 ((Clarifier) icon).setFig(this);\n363:                 ((Clarifier) icon).setToDoItem(item);\n364:             }\n365:             if (icon != null) {\n366:                 stuffPointAlongPerimeter(iconPos, p);\n367:                 icon.paintIcon(null, g, p.x + xOff, p.y + yOff);\n368:                 iconPos += icon.getIconWidth() + gap;\n369:             }\n370:         }\n371:         items = list.elementsForOffender(this);\n372:         size = items.size();\n373:         for (int i = 0; i < size; i++) {\n374:             ToDoItem item = (ToDoItem) items.elementAt(i);\n375:             Icon icon = item.getClarifier();\n376:             if (icon instanceof Clarifier) {\n377:                 ((Clarifier) icon).setFig(this);\n378:                 ((Clarifier) icon).setToDoItem(item);\n379:             }\n380:             if (icon != null) {\n381:                 stuffPointAlongPerimeter(iconPos, p);\n382:                 icon.paintIcon(null, g, p.x + xOff, p.y + yOff);\n383:                 iconPos += icon.getIconWidth() + gap;\n384:             }\n385:         }\n386:     }\n387: \n388:     /**\n389:      * @param f the fig to indicate the bounds of\n390:      * @param g the graphics\n391:      */\n392:     protected void indicateBounds(FigText f, Graphics g) {\n393:         if (f == null) {\n394:             return;\n395:         }\n396:         String text = f.getText();\n397:         if (text == null || text.length() == 0) {\n398:             Rectangle rect = f.getBounds();\n399:             Color c = g.getColor();\n400:             g.setColor(Globals.getPrefs().handleColorFor(f));\n401:             g.drawRect(rect.x, rect.y, rect.width, rect.height);\n402:             g.setColor(c); // TODO: Is this needed?\n403:         }\n404:     }\n405:     \n406:     /**\n407:      * The user clicked on the clarifier.\n408:      *\n409:      * @param x the x of the point clicked\n410:      * @param y the y of the point clicked\n411:      * @return the todo item clicked\n412:      */\n413:     public ToDoItem hitClarifier(int x, int y) {\n414:         int iconPos = 25, xOff = -4, yOff = -4;\n415:         Point p = new Point();\n416:         ToDoList list = Designer.theDesigner().getToDoList();\n417:         Vector items = list.elementsForOffender(getOwner());\n418:         int size = items.size();\n419:         for (int i = 0; i < size; i++) {\n420:             ToDoItem item = (ToDoItem) items.elementAt(i);\n421:             Icon icon = item.getClarifier();\n422:             stuffPointAlongPerimeter(iconPos, p);\n423:             int width = icon.getIconWidth();\n424:             int height = icon.getIconHeight();\n425:             if (y >= p.y + yOff\n426:                 && y <= p.y + height + yOff\n427:                 && x >= p.x + xOff\n428:                 && x <= p.x + width + xOff)\n429:                 return item;\n430:             iconPos += width;\n431:         }\n432:         for (int i = 0; i < size; i++) {\n433:             ToDoItem item = (ToDoItem) items.elementAt(i);\n434:             Icon icon = item.getClarifier();\n435:             if (icon instanceof Clarifier) {\n436:                 ((Clarifier) icon).setFig(this);\n437:                 ((Clarifier) icon).setToDoItem(item);\n438:                 if (((Clarifier) icon).hit(x, y))\n439:                     return item;\n440:             }\n441:         }\n442:         items = list.elementsForOffender(this);\n443:         size = items.size();\n444:         for (int i = 0; i < size; i++) {\n445:             ToDoItem item = (ToDoItem) items.elementAt(i);\n446:             Icon icon = item.getClarifier();\n447:             stuffPointAlongPerimeter(iconPos, p);\n448:             int width = icon.getIconWidth();\n449:             int height = icon.getIconHeight();\n450:             if (y >= p.y + yOff\n451:                 && y <= p.y + height + yOff\n452:                 && x >= p.x + xOff\n453:                 && x <= p.x + width + xOff)\n454:                 return item;\n455:             iconPos += width;\n456:         }\n457:         for (int i = 0; i < size; i++) {\n458:             ToDoItem item = (ToDoItem) items.elementAt(i);\n459:             Icon icon = item.getClarifier();\n460:             if (icon instanceof Clarifier) {\n461:                 ((Clarifier) icon).setFig(this);\n462:                 ((Clarifier) icon).setToDoItem(item);\n463:                 if (((Clarifier) icon).hit(x, y))\n464:                     return item;\n465:             }\n466:         }\n467:         return null;\n468:     }\n469: \n470:     /*\n471:      * Returns a {@link SelectionRerouteEdge} object that manages selection\n472:      * and rerouting of the edge.\n473:      *\n474:      * @see org.tigris.gef.presentation.Fig#makeSelection()\n475:      */\n476:     public Selection makeSelection() {\n477:         return new SelectionRerouteEdge(this);\n478:     }\n479: \n480:     /**\n481:      * Getter for name, the name Fig\n482:      * @return the nameFig\n483:      */\n484:     protected FigText getNameFig() {\n485:         return nameFig;\n486:     }\n487:     \n488:     /**\n489:      * Get the Rectangle in which the model elements name is displayed\n490:      *\n491:      * @return the bounds of the namefig\n492:      */\n493:     public Rectangle getNameBounds() {\n494:         return nameFig.getBounds();\n495:     }\n496:     \n497:     /**\n498:      * @return the text of the namefig\n499:      */\n500:     public String getName() {\n501:         return nameFig.getText();\n502:     }\n503: \n504:     /**\n505:      * Getter for stereo, the stereotype Fig\n506:      * @return the stereo Fig\n507:      */\n508:     protected Fig getStereotypeFig() {\n509:         return stereotypeFig;\n510:     }\n511: \n512:     /*\n513:      * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n514:      */\n515:     public void vetoableChange(PropertyChangeEvent pce) {\n516:         Object src = pce.getSource();\n517:         if (src == getOwner()) {\n518:             DelayedChangeNotify delayedNotify =\n519:                 new DelayedChangeNotify(this, pce);\n520:             SwingUtilities.invokeLater(delayedNotify);\n521:         }\n522:     }\n523: \n524:     /*\n525:      * @see org.argouml.kernel.DelayedVChangeListener#delayedVetoableChange(java.beans.PropertyChangeEvent)\n526:      */\n527:     public void delayedVetoableChange(PropertyChangeEvent pce) {\n528:         // update any text, colors, fonts, etc.\n529:         renderingChanged();\n530:         // update the relative sizes and positions of internel Figs\n531:         Rectangle bbox = getBounds();\n532:         setBounds(bbox.x, bbox.y, bbox.width, bbox.height);\n533:         endTrans();\n534:     }\n535: \n536:     /*\n537:      * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n538:      */\n539:     public void propertyChange(PropertyChangeEvent pve) {\n540:         Object src = pve.getSource();\n541:         String pName = pve.getPropertyName();\n542:         if (pve instanceof DeleteInstanceEvent && src == getOwner()) {\n543:             removeFromDiagram();\n544:             return;\n545:         }\n546:         // We handle and consume editing events\n547:         if (pName.equals(\"editing\")\n548:                 && Boolean.FALSE.equals(pve.getNewValue())) {\n549:             LOG.debug(\"finished editing\");\n550:             // parse the text that was edited\n551:             textEdited((FigText) src);\n552:             calcBounds();\n553:             endTrans();\n554:         } else if (pName.equals(\"editing\")\n555:                 && Boolean.TRUE.equals(pve.getNewValue())) {\n556:             textEditStarted((FigText) src);\n557:         } else {\n558:             // Add/remove name change listeners for applied stereotypes\n559:             if (src == getOwner()\n560:                     && \"stereotype\".equals(pName)) {\n561:                 if (pve instanceof RemoveAssociationEvent) {\n562:                     removeElementListener(pve.getOldValue());\n563:                 } else if (pve instanceof AddAssociationEvent) {\n564:                     addElementListener(pve.getNewValue(), \"name\");\n565:                 }\n566:             }\n567:             // Pass everything except editing events to superclass\n568:             super.propertyChange(pve);\n569:         }\n570: \n571:         if (Model.getFacade().isAModelElement(src) \n572:                 && getOwner() != null\n573:                 && !Model.getUmlFactory().isRemoved(getOwner())) {\n574:             /* If the source of the event is an UML object,\n575:              * then the UML model has been changed.*/\n576:             modelChanged(pve);\n577:         }\n578:         if (pve instanceof AttributeChangeEvent) {\n579:             modelAttributeChanged((AttributeChangeEvent) pve);\n580:         } else if (pve instanceof AddAssociationEvent) {\n581:             modelAssociationAdded((AddAssociationEvent) pve);\n582:         } else if (pve instanceof RemoveAssociationEvent) {\n583:             modelAssociationRemoved((RemoveAssociationEvent) pve);\n584:         }\n585:         damage();  // TODO: (MVW) Is this required?\n586:         // After all these events? I doubt it...\n587:     }\n588:     \n589:     /**\n590:      * Called whenever we receive an AttributeChangeEvent.\n591:      * \n592:      * @param ace the event\n593:      */\n594:     protected void modelAttributeChanged(AttributeChangeEvent ace) {\n595:         // Default implementation is to do nothing\n596:     }\n597: \n598:     /**\n599:      * Called whenever we receive an AddAssociationEvent.\n600:      * \n601:      * @param aae the event\n602:      */\n603:     protected void modelAssociationAdded(AddAssociationEvent aae) {\n604:         // Default implementation is to do nothing        \n605:     }\n606: \n607:     /**\n608:      * Called whenever we receive an RemoveAssociationEvent.\n609:      * \n610:      * @param rae the event\n611:      */\n612:     protected void modelAssociationRemoved(RemoveAssociationEvent rae) {\n613:         // Default implementation is to do nothing\n614:     }\n615: \n616:     /**\n617:      * This method is called when the user doubleclicked on the text field,\n618:      * and starts editing. Subclasses should override this method to e.g.\n619:      * supply help to the user about the used format. <p>\n620:      *\n621:      * It is also possible to alter the text to be edited\n622:      * already here, e.g. by adding the stereotype in front of the name,\n623:      * but that seems not user-friendly.\n624:      *\n625:      * @param ft the FigText that will be edited and contains the start-text\n626:      */\n627:     protected void textEditStarted(FigText ft) {\n628:         if (ft == getNameFig()) {\n629:             showHelp(notationProviderName.getParsingHelp());\n630:             ft.setText(notationProviderName.toString(getOwner(), npArguments));\n631:         }\n632:     }\n633: \n634:     /**\n635:      * Utility function to localize the given string with help text,\n636:      * and show it in the status bar of the ArgoUML window.\n637:      * This function is used in favour of the inline call\n638:      * to enable later improvements; e.g. it would be possible to\n639:      * show a help-balloon. TODO: Work this out.\n640:      * One matter to possibly improve: show multiple lines.\n641:      *\n642:      * @param s the given string to be localized and shown\n643:      */\n644:     protected void showHelp(String s) {\n645:         ProjectBrowser.getInstance().getStatusBar().showStatus(\n646:                 Translator.localize(s));\n647:     }\n648: \n649:     /**\n650:      * This method is called after the user finishes editing a text\n651:      * field that is in the FigEdgeModelElement.  Determine which field\n652:      * and update the model.  This class handles the name, subclasses\n653:      * should override to handle other text elements.\n654:      *\n655:      * @param ft the text Fig that has been edited\n656:      */\n657:     protected void textEdited(FigText ft) {\n658:         if (ft == nameFig) {\n659:             if (getOwner() == null)\n660:                 return;\n661:             notationProviderName.parse(getOwner(), ft.getText());\n662:             ft.setText(notationProviderName.toString(getOwner(), npArguments));\n663:         }\n664:     }\n665: \n666:     /**\n667:      * @param f the Fig\n668:      * @return true if editable\n669:      */\n670:     protected boolean canEdit(Fig f) {\n671:         return true;\n672:     }\n673: \n674:     ////////////////////////////////////////////////////////////////\n675:     // event handlers - MouseListener implementation\n676: \n677:     /*\n678:      * @see java.awt.event.MouseListener#mousePressed(java.awt.event.MouseEvent)\n679:      */\n680:     public void mousePressed(MouseEvent me) {\n681:         // Required for MouseListener interface, but we only care about clicks\n682:     }\n683: \n684:     /*\n685:      * @see java.awt.event.MouseListener#mouseReleased(java.awt.event.MouseEvent)\n686:      */\n687:     public void mouseReleased(MouseEvent me) {\n688:         // Required for MouseListener interface, but we only care about clicks\n689:     }\n690: \n691:     /*\n692:      * @see java.awt.event.MouseListener#mouseEntered(java.awt.event.MouseEvent)\n693:      */\n694:     public void mouseEntered(MouseEvent me) {\n695:         // Required for MouseListener interface, but we only care about clicks\n696:     }\n697: \n698:     /*\n699:      * @see java.awt.event.MouseListener#mouseExited(java.awt.event.MouseEvent)\n700:      */\n701:     public void mouseExited(MouseEvent me) {\n702:         // Required for MouseListener interface, but we only care about clicks\n703:     }\n704: \n705:     /*\n706:      * If the user double clicks on any part of this FigNode, pass it\n707:      * down to one of the internal Figs.  This allows the user to\n708:      * initiate direct text editing.\n709:      *\n710:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n711:      */\n712:     public void mouseClicked(MouseEvent me) {\n713:         if (me.isConsumed())\n714:             return;\n715:         if (me.getClickCount() >= 2) {\n716:             Fig f = hitFig(new Rectangle(me.getX() - 2, me.getY() - 2, 4, 4));\n717:             if (f instanceof MouseListener && canEdit(f))\n718: \t\t((MouseListener) f).mouseClicked(me);\n719:         }\n720:         me.consume();\n721:     }\n722: \n723:     /*\n724:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n725:      */\n726:     public void keyPressed(KeyEvent ke) {\n727:         // Required for KeyListener interface, but not used\n728:     }\n729: \n730:     /*\n731:      * @see java.awt.event.KeyListener#keyReleased(java.awt.event.KeyEvent)\n732:      */\n733:     public void keyReleased(KeyEvent ke) {\n734:         // Required for KeyListener interface, but not used\n735:     }\n736: \n737:     /*\n738:      * @see java.awt.event.KeyListener#keyTyped(java.awt.event.KeyEvent)\n739:      */\n740:     public void keyTyped(KeyEvent ke) {\n741:         if (ke.isConsumed())\n742:             return;\n743:         if (nameFig != null && canEdit(nameFig))\n744:             nameFig.keyTyped(ke);\n745:     }\n746: \n747: \n748:     /**\n749:      * Rerenders the fig if needed. This functionality was originally\n750:      * the functionality of modelChanged but modelChanged takes the\n751:      * event now into account.<p>\n752:      * \n753:      * NOTE: If you override this method you probably also want to \n754:      * override the modelChanged() method\n755:      * TODO: Call this method something sensible. What it does rather than\n756:      * one example of when it is called. Its purpose seems to be to update\n757:      * everything if anything has changed. Not very efficient.\n758:      */\n759:     protected void renderingChanged() {\n760:         updateNameText();\n761:         updateStereotypeText();\n762:         damage();\n763:     }\n764:     \n765:     ////////////////////////////////////////////////////////////////\n766:     // internal methods\n767: \n768:     /**\n769:      * This is called after any part of the UML ModelElement has\n770:      * changed. This method automatically updates the name FigText.\n771:      * Subclasses should override and update other parts.\n772:      *\n773:      * @param e the event\n774:      */\n775:     protected void modelChanged(PropertyChangeEvent e) {\n776:         if (e instanceof DeleteInstanceEvent) {\n777:             // No need to update if model element went away\n778:             return;\n779:         }\n780:         if (e.getSource() == getOwner()\n781:                 && \"name\".equals(e.getPropertyName())) {\n782:             updateNameText();\n783:         }\n784: \n785:         updateStereotypeText();\n786: \n787:         // Update attached node figures\n788:         // TODO: Presumably this should only happen on a add or remove event\n789:         determineFigNodes();\n790:     }\n791:     \n792:     /**\n793:      * generate the notation for the modelelement and stuff it into the text Fig\n794:      */\n795:     protected void updateNameText() {\n796: \n797:         if (getOwner() == null) {\n798:             return;\n799:         }\n800:         if (notationProviderName != null) {\n801:             String nameStr = notationProviderName.toString(\n802:                     getOwner(), npArguments);\n803:             nameFig.setText(nameStr);\n804:             calcBounds();\n805:             setBounds(getBounds());\n806:         }\n807:     }\n808: \n809:     /**\n810:      * generate the notation for the stereotype and stuff it into the text Fig\n811:      */\n812:     protected void updateStereotypeText() {\n813:         if (getOwner() == null) {\n814:             return;\n815:         }\n816:         Object modelElement = getOwner();\n817:         stereotypeFig.setOwner(modelElement);\n818:         ((FigStereotypesCompartment) stereotypeFig).populate();\n819:     }\n820: \n821:     /**\n822:      * This method should only be called once for any one Fig instance that\n823:      * represents a model element (ie not for a FigEdgeNote).\n824:      * It is called either by the constructor that takes an model element as an\n825:      * argument or it is called by PGMLStackParser after it has created the Fig\n826:      * by use of the empty constructor.\n827:      * The assigned model element (owner) must not change during the lifetime\n828:      * of the Fig.\n829:      * TODO: It is planned to refactor so that there is only one Fig\n830:      * constructor. When this is achieved this method can refactored out.\n831:      * \n832:      * @param owner the model element that this Fig represents.\n833:      * @throws IllegalArgumentException if the owner given is not a model\n834:      * element\n835:      * @see org.tigris.gef.presentation.Fig#setOwner(java.lang.Object)\n836:      */\n837:     public void setOwner(Object owner) {\n838:         if (owner == null) {\n839:             throw new IllegalArgumentException(\"An owner must be supplied\");\n840:         }\n841:         if (getOwner() != null) {\n842:             throw new IllegalStateException(\n843:                     \"The owner cannot be changed once set\");\n844:         }\n845:         if (!Model.getFacade().isAModelElement(owner)) {\n846:             throw new IllegalArgumentException(\n847:                     \"The owner must be a model element - got a \"\n848:                     + owner.getClass().getName());\n849:         }\n850:         super.setOwner(owner);\n851:         if (edgePort != null) {\n852:             edgePort.setOwner(getOwner());\n853:         }\n854:         initNotationProviders(owner);\n855:         renderingChanged();\n856:         updateListeners(null, owner);\n857:     }\n858: \n859:     /**\n860:      * Create the NotationProviders.\n861:      * \n862:      * @param own the current owner\n863:      */\n864:     protected void initNotationProviders(Object own) {\n865:         if (Model.getFacade().isAModelElement(own)) {\n866:             notationProviderName =\n867:                 NotationProviderFactory2.getInstance().getNotationProvider(\n868:                         NotationProviderFactory2.TYPE_NAME, own);\n869:         }\n870:     }\n871:     \n872:     /**\n873:      * Implementations of this method should register/unregister the fig for all\n874:      * (model)events. For FigEdgeModelElement only the fig itself is registered\n875:      * as listening to events fired by the owner itself. But for, for example,\n876:      * FigAssociation the fig must also register for events fired by the\n877:      * stereotypes of the owner. <p>\n878:      * \n879:      * This function is used in UMLDiagram, which removes all listen