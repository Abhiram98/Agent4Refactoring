.event.KeyEvent;\n31: import java.awt.event.MouseEvent;\n32: import java.beans.PropertyVetoException;\n33: import java.text.ParseException;\n34: import java.util.Collection;\n35: import java.util.Enumeration;\n36: import java.util.Iterator;\n37: import java.util.Vector;\n38: \n39: import javax.swing.JMenu;\n40: \n41: import org.apache.log4j.Category;\n42: import org.argouml.application.api.Notation;\n43: import org.argouml.language.helpers.NotationHelper;\n44: import org.argouml.model.uml.UmlFactory;\n45: import org.argouml.model.uml.UmlHelper;\n46: import org.argouml.ui.ArgoJMenu;\n47: import org.argouml.ui.ProjectBrowser;\n48: import org.argouml.uml.diagram.ui.CompartmentFigText;\n49: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n50: import org.argouml.uml.diagram.ui.UMLDiagram;\n51: import org.argouml.uml.generator.ParserDisplay;\n52: import org.argouml.uml.ui.ActionAddNote;\n53: import org.argouml.uml.ui.ActionAddOperation;\n54: import org.argouml.uml.ui.ActionCompartmentDisplay;\n55: import org.argouml.uml.ui.ActionModifier;\n56: import org.tigris.gef.base.Editor;\n57: import org.tigris.gef.base.Globals;\n58: import org.tigris.gef.base.Selection;\n59: import org.tigris.gef.graph.GraphModel;\n60: import org.tigris.gef.presentation.Fig;\n61: import org.tigris.gef.presentation.FigGroup;\n62: import org.tigris.gef.presentation.FigRect;\n63: import org.tigris.gef.presentation.FigText;\n64: import ru.novosoft.uml.foundation.core.MBehavioralFeature;\n65: import ru.novosoft.uml.foundation.core.MClassifier;\n66: import ru.novosoft.uml.foundation.core.MComponent;\n67: import ru.novosoft.uml.foundation.core.MElementResidence;\n68: import ru.novosoft.uml.foundation.core.MInterface;\n69: import ru.novosoft.uml.foundation.core.MModelElement;\n70: import ru.novosoft.uml.foundation.core.MNamespace;\n71: import ru.novosoft.uml.foundation.core.MOperation;\n72: import ru.novosoft.uml.foundation.data_types.MScopeKind;\n73: import ru.novosoft.uml.foundation.data_types.MVisibilityKind;\n74: import ru.novosoft.uml.model_management.MPackage;\n75: \n76: /** Class to display graphics for a UML Interface in a diagram. */\n77: \n78: public class FigInterface extends FigNodeModelElement {\n79:     protected static Category cat = Category.getInstance(FigInterface.class);\n80: \n81:     ////////////////////////////////////////////////////////////////\n82:     // constants\n83: \n84:     ////////////////////////////////////////////////////////////////\n85:     // instance variables\n86: \n87:     /**\n88:      * <p>The vector of graphics for operations (if any). First one is the\n89:      *   rectangle for the entire operations box.</p>\n90:      */\n91:     protected FigGroup _operVec;\n92: \n93:     /**\n94:      * <p>The rectangle for the entire operations box.</p>\n95:      */\n96:     protected FigRect _operBigPort;\n97: \n98:     /**\n99:      * <p>A rectangle to blank out the line that would otherwise appear at the\n100:      *   bottom of the stereotype text box.</p>\n101:      */\n102:     protected FigRect _stereoLineBlinder;\n103: \n104:     /**\n105:      * <p>Manages residency of an interface within a component on a deployment\n106:      *   diagram. Not clear why it is public, or even why it is an instance\n107:      *   variable (rather than local to the method).</p>\n108:      */\n109:     public MElementResidence resident =\n110:         UmlFactory.getFactory().getCore().createElementResidence();\n111: \n112:     /**\n113:      * <p>Text highlighted by mouse actions on the diagram.</p>\n114:      */\n115:     protected CompartmentFigText highlightedFigText = null;\n116: \n117:     ////////////////////////////////////////////////////////////////\n118:     // constructors\n119: \n120:     /**\n121:      * <p>Main constructor for a {@link FigInterface}.</p>\n122:      *\n123:      * <p>Parent {@link FigNodeModelElement} will have created the main box\n124:      *   {@link #_bigPort} and its name {@link #_name} and stereotype (@link\n125:      *   #_stereo}. This constructor creates a box for the operations.</p>\n126:      *\n127:      * <p>The properties of all these graphic elements are adjusted\n128:      *   appropriately. The main boxes are all filled and have outlines.</p>\n129:      *\n130:      * <p>For reasons I don't understand the stereotype is created in a box\n131:      *   with lines. So we have to created a blanking rectangle to overlay the\n132:      *   bottom line, and avoid three compartments showing.</p>\n133:      *\n134:      * <p><em>Warning</em>. Much of the graphics positioning is hard coded. The\n135:      *   overall figure is placed at location (10,10). The name compartment (in\n136:      *   the parent {@link FigNodeModelElement} is 21 pixels high. The\n137:      *   stereotype compartment is created 15 pixels high in the parent, but we\n138:      *   change it to 19 pixels, 1 more than ({@link #STEREOHEIGHT} here. The\n139:      *   operations box is created at 19 pixels, 2 more than\n140:      *   {@link #ROWHEIGHT}.</p>\n141:      *\n142:      * <p>CAUTION: This constructor (with no arguments) is the only one\n143:      *   that does enableSizeChecking(false), all others must set it true.\n144:      *   This is because this constructor is the only one called when loading\n145:      *   a project. In this case, the parsed size must be maintained.</p>\n146:      */\n147: \n148:     public FigInterface() {\n149: \n150:         // Set name box. Note the upper line will be blanked out if there is\n151:         // eventually a stereotype above.\n152:         _name.setLineWidth(1);\n153:         _name.setFilled(true);\n154: \n155:         // this rectangle marks the operation section; all operations are inside it:\n156:         _operBigPort =\n157:             new FigRect(\n158:                 10,\n159:                 31 + ROWHEIGHT,\n160:                 60,\n161:                 ROWHEIGHT + 2,\n162:                 Color.black,\n163:                 Color.white);\n164:         _operBigPort.setFilled(true);\n165:         _operBigPort.setLineWidth(1);\n166: \n167:         _operVec = new FigGroup();\n168:         _operVec.setFilled(true);\n169:         _operVec.setLineWidth(1);\n170:         _operVec.addFig(_operBigPort);\n171: \n172:         // Set properties of the stereotype box. Make it 1 pixel higher than\n173:         // before, so it overlaps the name box, and the blanking takes out both\n174:         // lines. Initially not set to be displayed, but this will be changed\n175:         // when we try to render it, if we find we have a stereotype.\n176:         _stereo.setText(\n177:             NotationHelper.getLeftGuillemot()\n178:                 + \"Interface\"\n179:                 + NotationHelper.getRightGuillemot());\n180:         _stereo.setExpandOnly(true);\n181:         _stereo.setFilled(true);\n182:         _stereo.setLineWidth(1);\n183:         _stereo.setEditable(false);\n184:         _stereo.setHeight(STEREOHEIGHT + 1);\n185:         // +1 to have 1 pixel overlap with _name\n186:         _stereo.setDisplayed(true);\n187: \n188:         // A thin rectangle to overlap the boundary line between stereotype\n189:         // and name. This is just 2 pixels high, and we rely on the line\n190:         // thickness, so the rectangle does not need to be filled. Whether to\n191:         // display is linked to whether to display the stereotype.\n192:         _stereoLineBlinder =\n193:             new FigRect(11, 10 + STEREOHEIGHT, 58, 2, Color.white, Color.white);\n194:         _stereoLineBlinder.setLineWidth(1);\n195:         _stereoLineBlinder.setDisplayed(true);\n196: \n197:         // Put all the bits together, suppressing bounds calculations until\n198:         // we're all done for efficiency.\n199:         enableSizeChecking(false);\n200:         suppressCalcBounds = true;\n201:         addFig(_bigPort);\n202:         addFig(_stereo);\n203:         addFig(_name);\n204:         addFig(_stereoLineBlinder);\n205:         addFig(_operVec);\n206:         suppressCalcBounds = false;\n207: \n208:         // Set the bounds of the figure to the total of the above (hardcoded)\n209:         setBounds(10, 10, 60, 21 + ROWHEIGHT);\n210:     }\n211: \n212:     /**\n213:      * <p>Constructor for use if this figure is created for an existing interface\n214:      *   node in the metamodel.</p>\n215:      *\n216:      * <p>Set the figure's name according to this node. This is used when the\n217:      *   user click's on 'add to diagram' in the navpane.  Don't know if this\n218:      *   should rather be done in one of the super classes, since similar code\n219:      *   is used in FigClass.java etc.  Andreas Rueckert\n220:      *   &lt;a_rueckert@gmx.net&gt;</p>\n221:      *\n222:      * @param gm   Not actually used in the current implementation\n223:      *\n224:      * @param node The UML object being placed.\n225:      */\n226:     public FigInterface(GraphModel gm, Object node) {\n227:         this();\n228:         setOwner(node);\n229:         enableSizeChecking(true);\n230:         if (node instanceof MInterface\n231:             && (((MInterface) node).getName() != null))\n232:             _name.setText(((MModelElement) node).getName());\n233:     }\n234: \n235:     public String placeString() {\n236:         return \"new Interface\";\n237:     }\n238: \n239:     public Object clone() {\n240:         FigInterface figClone = (FigInterface) super.clone();\n241:         Vector v = figClone.getFigs();\n242:         figClone._bigPort = (FigRect) v.elementAt(0);\n243:         figClone._stereo = (FigText) v.elementAt(1);\n244:         figClone._name = (FigText) v.elementAt(2);\n245:         figClone._stereoLineBlinder = (FigRect) v.elementAt(3);\n246:         figClone._operVec = (FigGroup) v.elementAt(4);\n247:         return figClone;\n248:     }\n249: \n250:     ////////////////////////////////////////////////////////////////\n251:     // accessors\n252: \n253:     public Selection makeSelection() {\n254:         return new SelectionInterface(this);\n255:     }\n256: \n257:     /**\n258:      * Build a collection of menu items relevant for a right-click popup menu on an Interface.\n259:      *\n260:      * @param     me     a mouse event\n261:      * @return           a collection of menu items\n262:      */\n263:     public Vector getPopUpActions(MouseEvent me) {\n264:         Vector popUpActions = super.getPopUpActions(me);\n265:         JMenu addMenu = new JMenu(\"Add\");\n266:         addMenu.add(ActionAddOperation.SINGLETON);\n267:         addMenu.add(ActionAddNote.SINGLETON);\n268:         popUpActions.insertElementAt(addMenu, popUpActions.size() - 1);\n269:         JMenu showMenu = new JMenu(\"Show\");\n270:         if (_operVec.isDisplayed())\n271:             showMenu.add(ActionCompartmentDisplay.HideOperCompartment);\n272:         else\n273:             showMenu.add(ActionCompartmentDisplay.ShowOperCompartment);\n274: \n275:         popUpActions.insertElementAt(showMenu, popUpActions.size() - 1);\n276: \n277:         // Block added by BobTarling 7-Jan-2001\n278:         MInterface mclass = (MInterface) getOwner();\n279:         ArgoJMenu modifierMenu = new ArgoJMenu(\"Modifiers\");\n280: \n281:         modifierMenu.addCheckItem(\n282:             new ActionModifier(\n283:                 \"Public\",\n284:                 \"visibility\",\n285:                 \"getVisibility\",\n286:                 \"setVisibility\",\n287:                 mclass,\n288:                 MVisibilityKind.class,\n289:                 MVisibilityKind.PUBLIC,\n290:                 null));\n291:         modifierMenu.addCheckItem(\n292:             new ActionModifier(\n293:                 \"Abstract\",\n294:                 \"isAbstract\",\n295:                 \"isAbstract\",\n296:                 \"setAbstract\",\n297:                 mclass));\n298:         modifierMenu.addCheckItem(\n299:             new ActionModifier(\"Leaf\", \"isLeaf\", \"isLeaf\", \"setLeaf\", mclass));\n300:         modifierMenu.addCheckItem(\n301:             new ActionModifier(\"Root\", \"isRoot\", \"isRoot\", \"setRoot\", mclass));\n302: \n303:         popUpActions.insertElementAt(modifierMenu, popUpActions.size() - 1);\n304:         // end of block\n305: \n306:         return popUpActions;\n307:     }\n308: \n309:     public FigGroup getOperationsFig() {\n310:         return _operVec;\n311:     }\n312: \n313:     /**\n314:      * Returns the status of the operation field.\n315:      * @return true if the operations are visible, false otherwise\n316:      */\n317:     public boolean isOperationVisible() {\n318:         return _operVec.isDisplayed();\n319:     }\n320: \n321:     public void setOperationVisible(boolean isVisible) {\n322:         Rectangle rect = getBounds();\n323:         int h =\n324:             checkSize\n325:                 ? (ROWHEIGHT * Math.max(1, _operVec.getFigs().size() - 1) + 2)\n326:                     * rect.height\n327:                     / getMinimumSize().height\n328:                 : 0;\n329:         if (_operVec.isDisplayed()) {\n330:             if (!isVisible) {\n331:                 damage();\n332:                 Enumeration enum = _operVec.getFigs().elements();\n333:                 while (enum.hasMoreElements())\n334:                      ((Fig) (enum.nextElement())).setDisplayed(false);\n335:                 _operVec.setDisplayed(false);\n336:                 setBounds(rect.x, rect.y, rect.width, rect.height - h);\n337:             }\n338:         } else {\n339:             if (isVisible) {\n340:                 Enumeration enum = _operVec.getFigs().elements();\n341:                 while (enum.hasMoreElements())\n342:                      ((Fig) (enum.nextElement())).setDisplayed(true);\n343:                 _operVec.setDisplayed(true);\n344:                 setBounds(rect.x, rect.y, rect.width, rect.height + h);\n345:                 damage();\n346:             }\n347:         }\n348:     }\n349: \n350:     /**\n351:      * <p>Gets the minimum size permitted for an interface on the diagram.</p>\n352:      *\n353:      * <p>Parts of this are hardcoded, notably the fact that the name\n354:      *   compartment has a minimum height of 21 pixels.</p>\n355:      *\n356:      * @return  the size of the minimum bounding box.\n357:      */\n358:     public Dimension getMinimumSize() {\n359: \n360:         // Use \"aSize\" to build up the minimum size. Start with the size of the\n361:         // name compartment and build up.\n362: \n363:         Dimension aSize = _name.getMinimumSize();\n364:         int h = aSize.height;\n365:         int w = aSize.width;\n366: \n367:         // Ensure that the minimum height of the name compartment is at least\n368:         // 21 pixels (hardcoded).\n369: \n370:         if (aSize.height < 21)\n371:             aSize.height = 21;\n372: \n373:         // If we have a stereotype displayed, then allow some space for that\n374:         // (width and height)\n375: \n376:         if (_stereo.isDisplayed()) {\n377:             aSize.width = Math.max(aSize.width, _stereo.getMinimumSize().width);\n378:             aSize.height += STEREOHEIGHT;\n379:         }\n380: \n381:         // Allow space for each of the operations we have\n382: \n383:         if (_operVec.isDisplayed()) {\n384: \n385:             // Loop through all the operations, to find the widest (remember\n386:             // the first fig is the box for the whole lot, so ignore it).\n387: \n388:             Enumeration enum = _operVec.getFigs().elements();\n389:             enum.nextElement(); // ignore\n390: \n391:             while (enum.hasMoreElements()) {\n392:                 int elemWidth =\n393:                     ((FigText) enum.nextElement()).getMinimumSize().width + 2;\n394:                 aSize.width = Math.max(aSize.width, elemWidth);\n395:             }\n396:             aSize.height += ROWHEIGHT\n397:                 * Math.max(1, _operVec.getFigs().size() - 1)\n398:                 + 1;\n399:         }\n400: \n401:         // we want to maintain a minimum width for Interfaces\n402:         aSize.width = Math.max(60, aSize.width);\n403: \n404:         // And now aSize has the answer\n405: \n406:         return aSize;\n407:     }\n408: \n409:     public void setFillColor(Color lColor) {\n410:         super.setFillColor(lColor);\n411:         _stereoLineBlinder.setLineColor(lColor);\n412:     }\n413: \n414:     public void setLineColor(Color lColor) {\n415:         super.setLineColor(lColor);\n416:         _stereoLineBlinder.setLineColor(_stereoLineBlinder.getFillColor());\n417:     }\n418: \n419:     public void translate(int dx, int dy) {\n420:         super.translate(dx, dy);\n421:         Editor ce = Globals.curEditor();\n422:         Selection sel = ce.getSelectionManager().findSelectionFor(this);\n423:         if (sel instanceof SelectionClass)\n424:              ((SelectionClass) sel).hideButtons();\n425:     }\n426: \n427:     ////////////////////////////////////////////////////////////////\n428:     // user interaction methods\n429: \n430:     public void mouseClicked(MouseEvent me) {\n431:         super.mousePressed(me);\n432:         boolean targetIsSet = false;\n433:         int i = 0;\n434:         Editor ce = Globals.curEditor();\n435:         Selection sel = ce.getSelectionManager().findSelectionFor(this);\n436:         if (sel instanceof SelectionClass)\n437:              ((SelectionClass) sel).hideButtons();\n438:         unhighlight();\n439:         //display op properties if necessary:\n440:         Rectangle r = new Rectangle(me.getX() - 1, me.getY() - 1, 2, 2);\n441:         Fig f = hitFig(r);\n442:         if (f == _operVec && _operVec.getHeight() > 0) {\n443:             Vector v = _operVec.getFigs();\n444:             i =\n445:                 (v.size() - 1)\n446:                     * (me.getY() - f.getY() - 3)\n447:                     / _operVec.getHeight();\n448:             if (i >= 0 && i < v.size() - 1) {\n449:                 targetIsSet = true;\n450:                 me.consume();\n451:                 f = (Fig) v.elementAt(i + 1);\n452:                 ((CompartmentFigText) f).setHighlighted(true);\n453:                 highlightedFigText = (CompartmentFigText) f;\n454:                 ProjectBrowser.TheInstance.setTarget(f);\n455:             }\n456:         }\n457:         if (targetIsSet == false) {\n458:             me.consume();\n459:             ProjectBrowser.TheInstance.setTarget(getOwner());\n460:         }\n461:     }\n462: \n463:     public void mouseExited(MouseEvent me) {\n464:         super.mouseExited(me);\n465:         unhighlight();\n466:     }\n467: \n468:     public void keyPressed(KeyEvent ke) {\n469:         int key = ke.getKeyCode();\n470:         if (key == KeyEvent.VK_UP || key == KeyEvent.VK_DOWN) {\n471:             CompartmentFigText ft = unhighlight();\n472:             if (ft != null) {\n473:                 int i = _operVec.getFigs().indexOf(ft);\n474:                 if (i != -1) {\n475:                     if (key == KeyEvent.VK_UP) {\n476:                         ft =\n477:                             (CompartmentFigText) getPreviousVisibleFeature(ft,\n478:                                 i);\n479:                     } else {\n480:                         ft = (CompartmentFigText) getNextVisibleFeature(ft, i);\n481:                     }\n482:                     if (ft != null) {\n483:                         ft.setHighlighted(true);\n484:                         highlightedFigText = ft;\n485:                         return;\n486:                     }\n487:                 }\n488:             }\n489:         } else if (key == KeyEvent.VK_ENTER && highlightedFigText != null) {\n490:             highlightedFigText.startTextEditor(ke);\n491:             ke.consume();\n492:             return;\n493:         }\n494:         super.keyPressed(ke);\n495:     }\n496: \n497:     public void setEnclosingFig(Fig encloser) {\n498:         Fig oldEncloser = getEnclosingFig();\n499:         super.setEnclosingFig(encloser);\n500:         if (!(getOwner() instanceof MModelElement))\n501:             return;\n502:         MModelElement me = (MModelElement) getOwner();\n503:         MNamespace m = null;\n504:         ProjectBrowser pb = ProjectBrowser.TheInstance;\n505: \n506:         try {\n507:             // If moved into an Package\n508:             if (encloser != null\n509:                 && oldEncloser != encloser\n510:                 && encloser.getOwner() instanceof MPackage) {\n511:                 me.setNamespace((MNamespace) encloser.getOwner());\n512:             }\n513: \n514:             // If default Namespace is not already set\n515:             if (me.getNamespace() == null\n516:                 && pb.getTarget() instanceof UMLDiagram) {\n517:                 m = (MNamespace) ((UMLDiagram) pb.getTarget()).getNamespace();\n518:                 me.setNamespace(m);\n519:             }\n520:         } catch (Exception e) {\n521:             cat.error(\n522:                 \"could not set package due to:\" + e + \"' at \" + encloser,\n523:                 e);\n524:         }\n525: \n526:         // The next if-clause is important for the Deployment-diagram\n527:         // it detects if the enclosing fig is a component, in this case\n528:         // the ImplementationLocation will be set for the owning MInterface\n529:         if (encloser != null && (encloser.getOwner() instanceof MComponent)) {\n530:             MComponent component = (MComponent) encloser.getOwner();\n531:             MInterface in = (MInterface) getOwner();\n532:             resident.setImplementationLocation(component);\n533:             resident.setResident(in);\n534:         } else {\n535:             resident.setImplementationLocation(null);\n536:             resident.setResident(null);\n537:         }\n538:     }\n539: \n540:     ////////////////////////////////////////////////////////////////\n541:     // internal methods\n542: \n543:     protected void textEdited(FigText ft) throws PropertyVetoException {\n544:         super.textEdited(ft);\n545:         MClassifier cls = (MClassifier) getOwner();\n546:         if (cls == null)\n547:             return;\n548:         int i = _operVec.getFigs().indexOf(ft);\n549:         if (i != -1) {\n550:             highlightedFigText = (CompartmentFigText) ft;\n551:             highlightedFigText.setHighlighted(true);\n552:             try {\n553:                 ParserDisplay.SINGLETON.parseOperationFig(\n554:                     cls,\n555:                     (MOperation) highlightedFigText.getOwner(),\n556:                     highlightedFigText.getText().trim());\n557:                 ProjectBrowser.TheInstance.getStatusBar().showStatus(\"\");\n558:             } catch (ParseException pe) {\n559:                 ProjectBrowser.TheInstance.getStatusBar().showStatus(\n560:                     \"Error: \" + pe + \" at \" + pe.getErrorOffset());\n561:             }\n562:             return;\n563:         }\n564:     }\n565: \n566:     protected FigText getPreviousVisibleFeature(FigText ft, int i) {\n567:         FigText ft2 = null;\n568:         Vector v = _operVec.getFigs();\n569:         if (i < 1\n570:             || i >= v.size()\n571:             || !((FigText) v.elementAt(i)).isDisplayed())\n572:             return null;\n573:         do {\n574:             i--;\n575:             if (i < 1)\n576:                 i = v.size() - 1;\n577:             ft2 = (FigText) v.elementAt(i);\n578:             if (!ft2.isDisplayed())\n579:                 ft2 = null;\n580:         } while (ft2 == null);\n581:         return ft2;\n582:     }\n583: \n584:     protected FigText getNextVisibleFeature(FigText ft, int i) {\n585:         FigText ft2 = null;\n586:         Vector v = _operVec.getFigs();\n587:         if (i < 1\n588:             || i >= v.size()\n589:             || !((FigText) v.elementAt(i)).isDisplayed())\n590:             return null;\n591:         do {\n592:             i++;\n593:             if (i >= v.size())\n594:                 i = 1;\n595:             ft2 = (FigText) v.elementAt(i);\n596:             if (!ft2.isDisplayed())\n597:                 ft2 = null;\n598:         } while (ft2 == null);\n599:         return ft2;\n600:     }\n601: \n602:     protected void createFeatureIn(FigGroup fg, InputEvent ie) {\n603:         CompartmentFigText ft = null;\n604:         MClassifier cls = (MClassifier) getOwner();\n605:         if (cls == null)\n606:             return;\n607:         ActionAddOperation.SINGLETON.actionPerformed(null);\n608:         ft = (CompartmentFigText) fg.getFigs().lastElement();\n609:         if (ft != null) {\n610:             ft.startTextEditor(ie);\n611:             ft.setHighlighted(true);\n612:             highlightedFigText = ft;\n613:         }\n614:     }\n615: \n616:     protected CompartmentFigText unhighlight() {\n617:         CompartmentFigText ft;\n618:         Vector v = _operVec.getFigs();\n619:         int i;\n620:         for (i = 1; i < v.size(); i++) {\n621:             ft = (CompartmentFigText) v.elementAt(i);\n622:             if (ft.isHighlighted()) {\n623:                 ft.setHighlighted(false);\n624:                 highlightedFigText = null;\n625:                 return ft;\n626:             }\n627:         }\n628:         return null;\n629:     }\n630: \n631:     protected void modelChanged() {\n632:         super.updateNameText();\n633:         Rectangle rect = getBounds();\n634:         int xpos = _operBigPort.getX();\n635:         int ypos = _operBigPort.getY();\n636:         MClassifier cls = (MClassifier) getOwner();\n637:         if (cls == null)\n638:             return;\n639:         int ocounter = 1;\n640:         Collection behs = UmlHelper.getHelper().getCore().getOperations(cls);\n641:         if (behs != null) {\n642:             Iterator iter = behs.iterator();\n643:             Vector figs = _operVec.getFigs();\n644:             CompartmentFigText oper;\n645:             while (iter.hasNext()) {\n646:                 MBehavioralFeature bf = (MBehavioralFeature) iter.next();\n647:                 if (figs.size() <= ocounter) {\n648:                     oper =\n649:                         new FigFeature(\n650:                             xpos + 1,\n651:                             ypos + 1 + (ocounter - 1) * ROWHEIGHT,\n652:                             0,\n653:                             ROWHEIGHT - 2,\n654:                             _operBigPort);\n655:                     // bounds not relevant here\n656:                     oper.setFilled(false);\n657:                     oper.setLineWidth(0);\n658:                     oper.setFont(LABEL_FONT);\n659:                     oper.setTextColor(Color.black);\n660:                     oper.setJustification(FigText.JUSTIFY_LEFT);\n661:                     oper.setMultiLine(false);\n662:                     _operVec.addFig(oper);\n663:                 } else {\n664:                     oper = (CompartmentFigText) figs.elementAt(ocounter);\n665:                 }\n666:                 oper.setText(Notation.generate(this, bf));\n667:                 oper.setOwner(bf);\n668:                 // underline, if static\n669:                 oper.setUnderline(\n670:                     MScopeKind.CLASSIFIER.equals(bf.getOwnerScope()));\n671:                 // italics, if abstract\n672:                 //oper.setItalic(((MOperation)bf).isAbstract()); // does not properly work (GEF bug?)\n673:                 if (((MOperation) bf).isAbstract())\n674:                     oper.setFont(ITALIC_LABEL_FONT);\n675:                 else\n676:                     oper.setFont(LABEL_FONT);\n677:                 ocounter++;\n678:             }\n679:             if (figs.size() > ocounter) {\n680:                 //cleanup of unused operation FigText's\n681:                 for (int i = figs.size() - 1; i >= ocounter; i--)\n682:                     _operVec.removeFig((Fig) figs.elementAt(i));\n683:             }\n684:         }\n685: \n686:         if (cls.isAbstract())\n687:             _name.setFont(ITALIC_LABEL_FONT);\n688:         else\n689:             _name.setFont(LABEL_FONT);\n690: \n691:         setBounds(rect.x, rect.y, rect.width, rect.height);\n692:         // recalculates all bounds\n693:     }\n694: \n695:     public void renderingChanged() {\n696:         super.renderingChanged();\n697:         _stereo.setText(\n698:             NotationHelper.getLeftGuillemot()\n699:                 + \"Interface\"\n700:                 + NotationHelper.getRightGuillemot());\n701:         updateNameText();\n702:     }\n703: \n704:     /**\n705:      * <p>Sets the bounds, but the size will be at least the one returned by\n706:      *   {@link #getMinimumSize()}, unless checking of size is disabled.</p>\n707:      *\n708:      * <p>If the required height is bigger, then the additional height is\n709:      *   equally distributed among all figs (i.e. compartments), such that the\n710:      *   cumulated height of all visible figs equals the demanded height<p>.\n711:      *\n712:      * <p>Some of this has \"magic numbers\" hardcoded in. In particular there is\n713:      *   a knowledge that the minimum height of a name compartment is 21\n714:      *   pixels.</p>\n715:      *\n716:      * @param x  Desired X coordinate of upper left corner\n717:      *\n718:      * @param y  Desired Y coordinate of upper left corner\n719:      *\n720:      * @param w  Desired width of the FigInterface\n721:      *\n722:      * @param h  Desired height of the FigInterface\n723:      */\n724:     public void setBounds(int x, int y, int w, int h) {\n725: \n726:         // Save our old boundaries (needed later), and get minimum size\n727:         // info. \"aSize will be used to maintain a running calculation of our\n728:         // size at various points.\n729: \n730:         // \"extra_each\" is the extra height per displayed fig if requested\n731:         // height is greater than minimal. \"height_correction\" is the height\n732:         // correction due to rounded division result, will be added to the name\n733:         // compartment\n734: \n735:         Rectangle oldBounds = getBounds();\n736:         Dimension aSize = checkSize ? getMinimumSize() : new Dimension(w, h);\n737: \n738:         int newW = Math.max(w, aSize.width);\n739:         int newH = h;\n740: \n741:         int extra_each = 0;\n742:         int height_correction = 0;\n743: \n744:         // First compute all nessessary height data. Easy if we want less than\n745:         // the minimum\n746: \n747:         if (newH <= aSize.height) {\n748: \n749:             // Just use the mimimum\n750: \n751:             newH = aSize.height;\n752: \n753:         } else {\n754: \n755:             // Split the extra amongst the number of displayed compartments\n756: \n757:             int displayedFigs = 1; //this is for _name\n758: \n759:             if (_operVec.isDisplayed()) {\n760:                 displayedFigs++;\n761:             }\n762: \n763:             // Calculate how much each, plus a correction to put in the name\n764:             // comparment if the result is rounded\n765: \n766:             extra_each = (newH - aSize.height) / displayedFigs;\n767:             height_correction =\n768:                 (newH - aSize.height) - (extra_each * displayedFigs);\n769:         }\n770: \n771:         // Now resize all sub-figs, including not displayed figs. Start by the\n772:         // name. We override the getMinimumSize if it is less than our view (21\n773:         // pixels hardcoded!). Add in the shared extra, plus in this case the\n774:         // correction.\n775: \n776:         int height = _name.getMinimumSize().height;\n777: \n778:         if (height < 21) {\n779:             height = 21;\n780:         }\n781: \n782:         height += extra_each + height_correction;\n783: \n784:         // Now sort out the stereotype display. If the stereotype is displayed,\n785:         // move the upper boundary of the name compartment up and set new\n786:         // bounds for the name and the stereotype compatments and the\n787:         // stereoLineBlinder that blanks out the line between the two\n788: \n789:         int currentY = y;\n790: \n791:         if (_stereo.isDisplayed()) {\n792:             currentY += STEREOHEIGHT;\n793:         }\n794: \n795:         _name.setBounds(x, currentY, newW, height);\n796:         _stereo.setBounds(x, y, newW, STEREOHEIGHT + 1);\n797:         _stereoLineBlinder.setBounds(x + 1, y + STEREOHEIGHT, newW - 2, 2);\n798: \n799:         // Advance currentY to where the start of the attribute box is,\n800:         // remembering that it overlaps the next box by 1 pixel. Calculate the\n801:         // size of the attribute box, and update the Y pointer past it if it is\n802:         // displayed.\n803: \n804:         currentY += height - 1; // -1 for 1 pixel overlap\n805: \n806:         // Finally update the bounds of the operations box\n807: \n808:         aSize =\n809:             getUpdatedSize(_operVec, x, currentY, newW, newH + y - currentY);\n810: \n811:         // set bounds of big box\n812: \n813:         _bigPort.setBounds(x, y, newW, newH);\n814: \n815:         // Now force calculation of the bounds of the figure, update the edges\n816:         // and trigger anyone who's listening to see if the \"bounds\" property\n817:         // has changed.\n818: \n819:         calcBounds();\n820:         updateEdges();\n821:         firePropChange(\"bounds\", oldBounds, getBounds());\n822:     }\n823: \n824: } /* end class FigInterface */\n825: ",
