ls column\n82:      */\n83:     protected int _labelWidth;\n84: \n85:     private ignoreSplitters _ignoreSplitters;\n86: \n87:     /**\n88:      * Construct a new LabelledLayout.\n89:      */\n90:     public LabelledLayout() {\n91:         _ignoreSplitters = Horizontal.getInstance();\n92:         _hgap = 0;\n93:         _vgap = 0;\n94:     }\n95: \n96:     /**\n97:      * Construct a new LabelledLayout with the given orientation.\n98:      * The orientation determines how panels are layed out. A horizontal orientation\n99:      * has panels to the right of the previous. Vertical orientation has panels layed\n100:      * out below the previous\n101:      */\n102:     public LabelledLayout(ignoreSplitters orientation) {\n103:         _ignoreSplitters = orientation;\n104:         _hgap = 0;\n105:         _vgap = 0;\n106:     }\n107: \n108:     /**\n109:      * Construct a new horizontal LabelledLayout with the specified cell spacing.\n110:      */\n111:     public LabelledLayout(int hgap, int vgap) {\n112:         _ignoreSplitters = Horizontal.getInstance();\n113:         _hgap = hgap;\n114:         _vgap = vgap;\n115:     }\n116: \n117:     /** \n118:      * Adds the specified component with the specified name to the layout. This is included\n119:      * to satisfy the LayoutManager interface but is not actually used in this layout\n120:      * implementation.\n121:      *\n122:      * @param name the name of the component\n123:      * @param comp the component to be added\n124:      */\n125:     public void addLayoutComponent(String name, Component comp) {\n126:     }\n127: \n128:     /** \n129:      * Removes the specified component with the specified name from the layout. This is included\n130:      * to satisfy the LayoutManager interface but is not actually used in this layout\n131:      * implementation.\n132:      *\n133:      * @param name the name of the component\n134:      */\n135:     public void removeLayoutComponent(Component comp) {\n136:     }\n137: \n138:     /**\n139:      * Determines the preferred size of the container argument using this labelled layout.\n140:      * The preferred size is that all child components are in one section at their own preferred size\n141:      * with gaps and border indents.\n142:      */\n143:     public Dimension preferredLayoutSize(Container parent) {\n144:         synchronized (parent.getTreeLock()) {\n145:             Insets insets = parent.getInsets();\n146:             int preferredWidth = 0;\n147:             int preferredHeight = 0;\n148:             int widestLabel = 0;\n149:             ArrayList rowHeights = new ArrayList();\n150: \n151:             int componentCount = parent.getComponentCount();\n152:             for (int i = 0; i < componentCount; ++i) {\n153:                 Component childComp = parent.getComponent(i);\n154:                 if (childComp.isVisible()) {\n155:                     int childHeight = (int) childComp.getPreferredSize().getHeight();\n156:                     if (childComp instanceof JLabel) {\n157:                         JLabel jlabel = (JLabel) childComp;\n158:                         if (widestLabel < jlabel.getPreferredSize().getWidth()) {\n159:                             widestLabel = (int) jlabel.getPreferredSize().getWidth();\n160:                         }\n161:                         childComp = jlabel.getLabelFor();\n162:                         int childWidth = (int) childComp.getPreferredSize().getWidth();\n163:                         if (childWidth > preferredWidth) {\n164:                             preferredWidth = childWidth;\n165:                         }\n166: \n167:                         if (childHeight < jlabel.getPreferredSize().getHeight()) {\n168:                             childHeight = (int) jlabel.getPreferredSize().getHeight();\n169:                         }\n170:                     }\n171:                     preferredHeight += childHeight + _vgap;\n172:                 }\n173:             }\n174:             preferredWidth += insets.left + widestLabel + insets.right;\n175:             preferredHeight += insets.top + insets.bottom;\n176:             return new Dimension(insets.left + widestLabel + preferredWidth + insets.right, preferredHeight);\n177:         }\n178:     }\n179: \n180:     /* Required by LayoutManager. */\n181:     public Dimension minimumLayoutSize(Container parent) {\n182:         synchronized (parent.getTreeLock()) {\n183:             Insets insets = parent.getInsets();\n184:             int minimumHeight = insets.top + insets.bottom;\n185: \n186:             ArrayList rowHeights = new ArrayList();\n187: \n188:             int componentCount = parent.getComponentCount();\n189:             for (int i = 0; i < componentCount; ++i) {\n190:                 Component childComp = parent.getComponent(i);\n191:                 if (childComp instanceof JLabel) {\n192:                     JLabel jlabel = (JLabel) childComp;\n193:                     childComp = jlabel.getLabelFor();\n194:                     int childHeight = (int) childComp.getMinimumSize().getHeight();\n195:                     if (childHeight < jlabel.getMinimumSize().getHeight()) {\n196:                         childHeight = (int) jlabel.getMinimumSize().getHeight();\n197:                     }\n198:                     minimumHeight += childHeight + _vgap;\n199:                 }\n200:             }\n201:             return new Dimension(0, minimumHeight);\n202:         }\n203:     }\n204: \n205:     public void layoutContainer(Container parent) {\n206:         synchronized (parent.getTreeLock()) {\n207:             int sectionX = parent.getInsets().left;\n208: \n209:             ArrayList components = new ArrayList();\n210:             int sectionCount = getSectionCount(parent);\n211:             int sectionWidth = getSectionWidth(parent, sectionCount);\n212:             for (int i = 0; i < parent.getComponentCount(); ++i) {\n213:                 if (parent.getComponent(i) instanceof Seperator) {\n214:                     layoutSection(parent, sectionX, sectionWidth, components);\n215:                     sectionX += sectionWidth + _hgap;\n216:                     components.clear();\n217:                 } else {\n218:                     components.add(parent.getComponent(i));\n219:                 }\n220:             }\n221:             layoutSection(parent, sectionX, sectionWidth, components);\n222:         }\n223:     }\n224: \n225:     /** Determine the number of sections.\n226:      * There is only ever one section if oriented vertically.\n227:      * If oriented horizontally the number of sections is deduced from the number of Splitters\n228:      * in the parent container.\n229:      */\n230:     private int getSectionCount(Container parent) {\n231:         int sectionCount = 1;\n232:         int componentCount = parent.getComponentCount();\n233:         if (_ignoreSplitters.equals(Horizontal.getInstance())) {\n234:             for (int i = 0; i < componentCount; ++i) {\n235:                 if (parent.getComponent(i) instanceof Seperator)\n236:                     ++sectionCount;\n237:             }\n238:         }\n239:         return sectionCount;\n240:     }\n241:     \n242:     /**\n243:      * Determine the width of each section from the section count.\n244:      * This is the working width minus the gaps between sections. This result is then divided\n245:      * equally by the section count.\n246:      */\n247:     private int getSectionWidth(Container parent, int sectionCount) {\n248:         return (getUsableWidth(parent)-(sectionCount-1)*_hgap) / sectionCount;\n249:     }\n250: \n251:     /**\n252:      * Determine the usable width of the parent.\n253:      * This is the full width minus any borders.\n254:      */\n255:     private int getUsableWidth(Container parent) {\n256:         Insets insets = parent.getInsets();\n257:         return parent.getWidth() - (insets.left + insets.right);\n258:     }\n259:     \n260:     /**\n261:      * Layout a single section\n262:      */\n263:     private void layoutSection(Container parent, int sectionX, int sectionWidth, ArrayList components) {\n264:         ArrayList rowHeights = new ArrayList();\n265: \n266:         int componentCount = components.size();\n267:         if (componentCount == 0) {\n268:             return;\n269:         }\n270: \n271:         int childWidth, childHeight;\n272:         int labelWidth = 0;\n273:         int unknownHeightCount = 0;\n274:         int totalHeight = 0;\n275: \n276:         // Build up an array list of the heights of each label/component pair.\n277:         // Heights of zero indicate a proportional height.\n278:         for (int i = 0; i < componentCount; ++i) {\n279:             Component childComp = (Component) components.get(i);\n280:             if (childComp instanceof JLabel) {\n281:                 JLabel jlabel = (JLabel) childComp;\n282:                 childWidth = (int) childComp.getPreferredSize().getWidth();\n283:                 if (childWidth > labelWidth) {\n284:                     labelWidth = childWidth;\n285:                 }\n286:                 childHeight = (int) childComp.getPreferredSize().getHeight();\n287: \n288:                 childComp = jlabel.getLabelFor();\n289:                 if (childComp != null)\n290:                     i++;\n291:                 if (childComp != null && childComp.getMinimumSize() != null && childHeight < childComp.getMinimumSize().getHeight()) {\n292:                     if (childComp != null && childComp.getPreferredSize() != null && childComp.getMinimumSize().getHeight() < childComp.getPreferredSize().getHeight()) {\n293:                         // If the preferred size is greater then the minimum size then this child components\n294:                         // actual current size is currently unknown. It will be calculated later is a\n295:                         // propertion of the available left over space.\n296:                         // For now this is flagged as zero.\n297:                         childHeight = 0;\n298:                         ++unknownHeightCount;\n299:                     } else {\n300:                         // If a preferred height is not given or is the same as the minimum height then\n301:                         // fix the height of this row.\n302:                         childHeight = (int) childComp.getMinimumSize().getHeight();\n303:                     }\n304:                 }\n305:             } else {\n306:                 // to manage the case there are no label/component pairs but just one component\n307:                 childHeight = (int) childComp.getPreferredSize().getHeight();\n308:                 if (childComp != null && childComp.getPreferredSize() != null && childComp.getMinimumSize().getHeight() < childComp.getPreferredSize().getHeight()) {\n309:                     // If the preferred size is greater then the minimum size then this child components\n310:                     // actual current size is currently unknown. It will be calculated later is a\n311:                     // propertion of the available left over space.\n312:                     // For now this is flagged as zero.\n313:                     childHeight = 0;\n314:                     ++unknownHeightCount;\n315:                 } else {\n316:                     // If a preferred height is not given or is the same as the minimum height then\n317:                     // fix the height of this row.\n318:                     childHeight = (int) childComp.getMinimumSize().getHeight();\n319:                 }\n320:             }\n321:             totalHeight += childHeight + _vgap;\n322:             rowHeights.add(new Integer(childHeight));\n323:         }\n324:         totalHeight -= _vgap;\n325:         \n326:         Insets insets = parent.getInsets();\n327:         int parentHeight = parent.getHeight() - (insets.top + insets.bottom);\n328:         // Set the child components to the