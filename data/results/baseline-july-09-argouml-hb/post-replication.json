del.getFacade().isAOperation(o)) {\n228:                     newOperation = o;\n229:                 }\n230:             }\n231:             if (newOperation != oldOperation && method != null) {\n232:                 Model.getCoreHelper().setSpecification(method, newOperation);\n233:             }\n234:         }\n235:     }\n236: \n237:     private static class UMLModelElementLanguageDocument\n238:         extends UMLPlainTextDocument {\n239:         /**\n240:          * Constructor for UMLModelElementNameDocument.\n241:          */\n242:         public UMLModelElementLanguageDocument() {\n243:              super(\"language\");\n244:         }\n245: \n246:         /**\n247:          * @see org.argouml.uml.ui.UMLPlainTextDocument#setProperty(java.lang.String)\n248:          */\n249:         protected void setProperty(String text) {\n250:             Object meth = getTarget();\n251:             if (Model.getFacade().isAMethod(meth)) {\n252:                 Object expr = Model.getFacade().getBody(meth);\n253:                 if (expr != null) {\n254:                     Model.getDataTypesHelper().setLanguage(expr, text);\n255:                 } else {\n256:                     Model.getCoreHelper().setBody(meth,\n257:                             Model.getDataTypesFactory()\n258:                             .createProcedureExpression(text, null));\n259:                 }\n260:             }\n261:         }\n262: \n263:         /**\n264:          * @see org.argouml.uml.ui.UMLPlainTextDocument#getProperty()\n265:          */\n266:         protected String getProperty() {\n267:             Object expr = Model.getFacade().getBody(getTarget());\n268:             if (expr == null) {\n269:                 return null;\n270:             } else {\n271:                 return Model.getDataTypesHelper().getLanguage(expr);\n272:             }\n273:         }\n274: \n275:         /**\n276:          * The UID.\n277:          */\n278:         private static final long serialVersionUID = -2004931253036454061L;\n279:     }\n280: \n281:     private static class UMLMethodBodyDocument extends UMLPlainTextDocument {\n282:         /**\n283:          * Constructor for UMLMethodBodyDocument.\n284:          */\n285:         public UMLMethodBodyDocument() {\n286:             super(\"body\");\n287:             /*\n288:              * TODO: This is probably not the right location\n289:              * for switching off the \"filterNewlines\".\n290:              * The setting gets lost after selecting a different\n291:              * ModelElement in the diagram.\n292:              * BTW, see how it is used in\n293:              * javax.swing.text.PlainDocument.\n294:              * See issue 1812.\n295:              */\n296:             putProperty(\"filterNewlines\", Boolean.FALSE);\n297:         }\n298: \n299:         /**\n300:          * @see org.argouml.uml.ui.UMLPlainTextDocument#setProperty(java.lang.String)\n301:          */\n302:         protected void setProperty(String text) {\n303:             Object meth = getTarget();\n304:             if (Model.getFacade().isAMethod(meth)) {\n305:                 Object expr = Model.getFacade().getBody(meth);\n306:                 if (expr != null) {\n307:                     Model.getDataTypesHelper().setBody(expr, text);\n308:                 } else {\n309:                     Model.getCoreHelper().setBody(meth,\n310:                             Model.getDataTypesFactory()\n311:                             .createProcedureExpression(null, text));\n312:                 }\n313:             }\n314:         }\n315: \n316:         /**\n317:          * @see org.argouml.uml.ui.UMLPlainTextDocument#getProperty()\n318:          */\n319:         protected String getProperty() {\n320:             Object expr = Model.getFacade().getBody(getTarget());\n321:             if (expr == null) {\n322:                 return null;\n323:             } else {\n324:                 return (String) Model.getFacade().getBody(expr);\n32