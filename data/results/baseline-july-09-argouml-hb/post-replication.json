                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/model/uml/UmlModelEventPump.java: \n1: // $Id$\n2: // Copyright (c) 2002-2005 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.model.uml;\n26: \n27: import java.io.IOException;\n28: import java.lang.reflect.Array;\n29: import java.util.ArrayList;\n30: import java.util.Collection;\n31: import java.util.Collections;\n32: import java.util.HashMap;\n33: import java.util.Iterator;\n34: import java.util.Map;\n35: \n36: import javax.xml.parsers.DocumentBuilder;\n37: import javax.xml.parsers.DocumentBuilderFactory;\n38: import javax.xml.parsers.ParserConfigurationException;\n39: \n40: import org.apache.log4j.Logger;\n41: import org.argouml.model.Model;\n42: import org.w3c.dom.Document;\n43: import org.w3c.dom.Element;\n44: import org.w3c.dom.NodeList;\n45: import org.xml.sax.SAXException;\n46: \n47: import ru.novosoft.uml.MBase;\n48: import ru.novosoft.uml.MElementEvent;\n49: import ru.novosoft.uml.MElementListener;\n50: import ru.novosoft.uml.MFactoryImpl;\n51: \n52: \n53: /**\n54:  * This class implements an event pump for all modelevents (MEvents\n55:  * with the current NSUML model). Two kinds of listeners can be\n56:  * registred to the pump: listeners to class events and listeners to\n57:  * object events. The pump dispatches all events fired by objects of a\n58:  * certain class to the class listeners (listeners that are registred\n59:  * via addClassModelEventListener). Furthermore, it dispatches all\n60:  * events to listeners that are registered for a certain object if\n61:  * this object fired the original event.<p>\n62:  *\n63:  * This class is part of the NSUML-dependant API of the model component.\n64:  * Use the NSUML-free {@link org.argouml.model.Model#getPump()} and the\n65:  * {@link org.argouml.model.ModelEventPump} interface everywhere except\n66:  * within the NSUML-implementation.\n67:  *\n68:  * Maybe this class should dispatch a thread to handle the incoming\n69:  * event in the future.\n70:  * @since Oct 14, 2002\n71:  * @author jaap.branderhorst@xs4all.nl\n72:  *\n73:  * TODO: Change visibility to package after reflection problem solved.\n74:  */\n75: public final class UmlModelEventPump implements MElementListener {\n76: \n77:     /**\n78:      * The Logger.\n79:      */\n80:     private static final Logger LOG =\n81: \t    Logger.getLogger(UmlModelEventPump.class);\n82: \n83:     /**\n84:      * Indicate wether we pump events to listeners yes or no.\n85:      * There is some fault in the NSUML implementation\n86:      * but where...\n87:      */\n88:     private boolean pumping = true;\n89: \n90:     /**\n91:      * \"remove\".\n92:      */\n93:     public static final String REMOVE = \"remove\";\n94: \n95:     private static UmlModelEventPump theInstance = new UmlModelEventPump();\n96: \n97:     /**\n98:      * The 'map' with the eventlistenerlists per modelelement.\n99:      */\n100:     private EventListenerHashMap listenerMap = new EventListenerHashMap();\n101: \n102:     private ClassListenerHashMap classListenerMap = new ClassListenerHashMap();\n103: \n104:     private EventTreeDefinition definition = new EventTreeDefinition();\n105: \n106:     /**\n107:      * Singleton access method.\n108:      *\n109:      * @return UmlModelEventPump\n110:      */\n111:     public static synchronized UmlModelEventPump getPump() {\n112:         return theInstance;\n113:     }\n114: \n115:     /**\n116:      * Constructor for UmlModelEventPump, initialises the NSUML event policy.\n117:      */\n118:     private UmlModelEventPump() {\n119:         super();\n120:         // Initialize NSUML\n121: \tMFactoryImpl.setEventPolicy(MFactoryImpl.EVENT_POLICY_IMMEDIATE);\n122:     }\n123: \n124:     /**\n125:      * Adds a listener that listens to all modelevents that are named\n126:      * eventNames and that occur to instances of a given\n127:      * modelClass.<p>\n128:      *\n129:      * If you want the listener to be registered for remove events\n130:      * (that is: an instance of the class the listener is listening\n131:      * too is removed), then you have to register for the eventname\n132:      * \"remove\".<p>\n133:      *\n134:      * @param listener is the listener to add.\n135:      * @param metaType is the given model class\n136:      * @param eventNames is a array of strings with event names.\n137:      * @throws IllegalArgumentException if one of the arguments is null or if\n138:      * the modelClass is not a subclass of MBase.\n139:      * @throws IllegalStateException if the listener is allready registred\n140:      */\n141:     public void addClassModelEventListener(MElementListener listener,\n142: \t\t\t\t\t   Object metaType,\n143: \t\t\t\t\t   String[] eventNames) {\n144:         Class modelClass = (Class) metaType;\n145: //      We don't support non-NSUML modeleventlisteners yet,\n146: //      so we return without addition.\n147:         if (!MBase.class.isAssignableFrom(modelClass)) {\n148:             return;\n149:         }\n150:         if (listener == null\n151:             || modelClass == null\n152:             || eventNames == null\n153:             || eventNames.length == 0) {\n154:             throw new IllegalArgumentException(\"Tried to add illegal class\"\n155: \t\t\t\t\t       + \" modeleventlistener to \"\n156: \t\t\t\t\t       + \"possible null class\");\n157:         }\n158:         for (int i = 0; i < eventNames.length; i++) {\n159:             executeAddClassModelEventListener(\n160: \t\t\t\t\t      listener,\n161: \t\t\t\t\t      modelClass,\n162: \t\t\t\t\t      eventNames[i]);\n163:         }\n164:     }\n165: \n166:     /**\n167:      * Convinience method to add a listener that only listens to one specific\n168:      * event.\n169:      *\n170:      * @param listener The listener to add\n171:      * @param metaType The listener should listen to instances of this class\n172:      * @param eventName The name of the event the listener wants to listen\n173:      * too.\n174:      */\n175:     public void addClassModelEventListener(MElementListener listener,\n176: \t\t\t\t\t   Object metaType,\n177: \t\t\t\t\t   String eventName) {\n178:         Class modelClass = (Class) metaType;\n179:         // We don't support non-NSUML modeleventlisteners yet,\n180:         // so we return without addition.\n181: \n182:         if (!MBase.class.isAssignableFrom(modelClass)) {\n183:             return;\n184:         }\n185:         if (listener == null\n186:             || modelClass == null\n187:             || eventName == null\n188:             || eventName.equals(\"\")) {\n189:             throw new IllegalArgumentException();\n190:         }\n191:         executeAddClassModelEventListener(listener, modelClass, eventName);\n192:     }\n193: \n194:     /**\n195:      * Does the actual adding.\n196:      *\n197:      * @param listener The listener to add\n198:      * @param modelClass The listener should listen to instances of this class\n199:      * @param eventName The name of the event the listener wants to listen\n200:      */\n201:     private synchronized void executeAddClassModelEventListener(\n202: \t    MElementListener listener,\n203: \t    Class modelClass,\n204: \t    String eventName) {\n205:         // first register the listener for all elements allready in\n206:         // the model modelClass = formatClass(modelClass);\n207:         Object model = Model.getModelManagementFactory().getRootModel();\n208:         Collection col =\n209:             Model.getModelManagementHelper()\n210: \t        .getAllModelElementsOfKindWithModel(model, modelClass);\n211: \n212:         if (col == Collections.EMPTY_LIST) {\n213:             col = new ArrayList();\n214:         }\n215: \n216:         /*\n217:         if (modelClass.isAssignableFrom(MModel.class)) {\n218:             Object root =\n219:                 ProjectManager.getManager().getCurrentProject().getRoot();\n220:             if (root != null)\n221:                 col.add(root);\n222:         }\n223:         */\n224:         modelClass = formatClass(modelClass);\n225:         EventKey[] keys = definition.getEventTypes(modelClass, eventName);\n226:         Iterator it = col.iterator();\n227:         while (it.hasNext()) {\n228:             MBase base = (MBase) it.next();\n229:             for (int i = 0; i < keys.length; i++) {\n230:                 listenerMap.put(base, keys[i], listener);\n231:             }\n232:         }\n233:         // add the class to the 'interested classes list' so the listener is\n234:         // added on creation of a modelelement\n235:         for (int i = 0; i < keys.length; i++) {\n236:             classListenerMap.put(modelClass, keys[i], listener);\n237:         }\n238:     }\n239:     /**\n240:      * Retrieves the  implementation class belonging to some given class. For\n241:      * example, retrieves ClassImpl.class if the input was Class.class or\n242:      * ClassImpl.class.\n243:      * @param inputClass An interface or implementation class from NSUML\n244:      * @return The implementation class from NSUML\n245:      */\n246:     private Class formatClass(Class inputClass) {\n247:         String name = inputClass.getName();\n248:         if (name.endsWith(\"Impl\")) {\n249:             return inputClass;\n250:         }\n251:         try {\n252:             Class returnClass = Class.forName(name + \"Impl\");\n253:             return returnClass;\n254:         } catch (ClassNotFoundException ignorable) {\n255:             // cannot happen\n256:         }\n257:         return null;\n258: \n259:     }\n260: \n261:     /**\n262:      * Removes a listener that listens to all modelevents fired by instances of\n263:      * modelClass and that have the original name eventNames.\n264:      * @param listener The listener to remove\n265:      * @param metaType The class the listener does not want to listen to\n266:      * instances anymore\n267:      * @param eventNames The eventnames the listener does not want to listen to\n268:      * anymore\n269:      */\n270:     public void removeClassModelEventListener(\n271: \t\t\t\t\t      MElementListener listener,\n272: \t\t\t\t\t      Object metaType,\n273: \t\t\t\t\t      String[] eventNames) {\n274:         Class modelClass = (Class) metaType;\n275:         // we don't support eventlisteners other then NSUML ModelEventListener.\n276:         // to be forward compatible with other ModelEventListeners,\n277:         // we do not throw an exception but\n278:         // simply return.\n279:         if (!MBase.class.isAssignableFrom(modelClass)) {\n280:             // throw new IllegalArgumentException();\n281:             return;\n282:         }\n283:         if (listener == null\n284:             || modelClass == null\n285:             || eventNames == null\n286:             || eventNames.length == 0) {\n287:             throw new IllegalArgumentException(\n288:                     \"Tried to remove invalid listener\");\n289:         }\n290:         for (int i = 0; i < eventNames.length; i++) {\n291:             executeRemoveClassModelEventListener(\n292: \t\t\t\t\t\t listener,\n293: \t\t\t\t\t\t modelClass,\n294: \t\t\t\t\t\t eventNames[i]);\n295:         }\n296:     }\n297: \n298:     /**\n299:      * Convinience method to remove a listener that listens to events named\n300:      * eventName that are fired by instances of modelClass.\n301:      *\n302:      * @param listener The listener to remove\n303:      * @param metaType The class the listener does not want to listen to\n304:      * instances anymore\n305:      * @param eventName The eventname the listener does not want to listen to\n306:      * anymore\n307:      */\n308:     public void removeClassModelEventListener(\n309: \t\t\t\t\t      MElementListener listener,\n310: \t\t\t\t\t      Object metaType,\n311: \t\t\t\t\t      String eventName) {\n312:         Class modelClass = (Class) metaType;\n313:         // we don't support eventlisteners other then NSUML ModelEventListener.\n314:         // to be forward compatible with other ModelEventListeners,\n315:         // we do not throw an exception but\n316:         // simply return.\n317:         if (!MBase.class.isAssignableFrom(modelClass)) {\n318:             // throw new IllegalArgumentException();\n319:             return;\n320:         }\n321:         if (listener == null\n322:             || modelClass == null\n323:             || eventName == null) {\n324:             throw new IllegalArgumentException(\n325:                     \"Tried to remove invalid listener\");\n326:         }\n327:         executeRemoveClassModelEventListener(listener, modelClass, eventName);\n328:     }\n329: \n330:     /**\n331:      * Executes the removal of a listener to a class.\n332:      *\n333:      * @param listener The listener to remove\n334:      * @param modelClass The class the listener does not want to listen to\n335:      * instances anymore\n336:      * @param eventName The eventname the listener does not want to listen to\n337:      * anymore\n338:      */\n339:     private synchronized void executeRemoveClassModelEventListener(\n340: \t    MElementListener listener,\n341: \t    Class modelClass,\n342: \t    String eventName) {\n343:         // remove all registrations of this listener with all instances of\n344:         // modelClass\n345:         //modelClass = formatClass(modelClass);\n346:         Object model = Model.getModelManagementFactory().getRootModel();\n347:         Iterator it =\n348:             Model.getModelManagementHelper()\n349: \t        .getAllModelElementsOfKindWithModel(model, modelClass)\n350: \t            .iterator();\n351:         while (it.hasNext()) {\n352:             MBase base = (MBase) it.next();\n353:             removeModelEventListener(listener, base, eventName);\n354:         }\n355:         // remove the listener from the registry\n356:         EventKey[] keys = definition.getEventTypes(modelClass, eventName);\n357:         for (int i = 0; i < keys.length; i++) {\n358:             classListenerMap.remove(modelClass, keys[i], listener);\n359:         }\n360:     }\n361: \n362:     /**\n363:      * Adds a listener to modelevents that are fired by some given modelelement\n364:      * and that have the name eventNames.<p>\n365:      *\n366:      * If you want the listener to be registred for remove events (that is: the\n367:      * instance the listener is listening too is removed), then you have to\n368:      * register for the eventname \"remove\".\n369:      *\n370:      * @param listener The listener to add\n371:      * @param modelelement The modelelement the listener should be added too\n372:      * @param eventNames The array of eventnames the listener should listen\n373:      *                   to.\n374:      */\n375:     public void addModelEventListener(\n376: \t\t\t\t      Object listener,\n377: \t\t\t\t      Object modelelement,\n378: \t\t\t\t      String[] eventNames) {\n379:         // we just return if the modelelement is not a base.\n380:         // we don't support non-nsuml elements yet.\n381:         if (modelelement == null || !(modelelement instanceof MBase)) {\n382:             return;\n383:         }\n384:         if (listener == null\n385:             || eventNames == null\n386:             || eventNames.length == 0\n387:             || !(listener instanceof MElementListener)\n388:             || !(modelelement instanceof MBase)) {\n389:             throw new IllegalArgumentException(\"Wrong argument types while \"\n390: \t\t\t\t\t       + \"adding a modelelement \"\n391: \t\t\t\t\t       + \"listener\");\n392:         }\n393:         for (int i = 0; i < eventNames.length; i++) {\n394:             EventKey[] keys =\n395:                 definition.getEventTypes(\n396: \t\t\t\t\t  modelelement.getClass(),\n397: \t\t\t\t\t  eventNames[i]);\n398:             for (int j = 0; j < keys.length; j++) {\n399:                 listenerMap.remove(\n400: \t\t\t\t    (MBase) modelelement,\n401: \t\t\t\t    keys[j],\n402: \t\t\t\t    (MElementListener) listener);\n403:                 listenerMap.put(\n404: \t\t\t\t (MBase) modelelement,\n405: \t\t\t\t keys[j],\n406: \t\t\t\t (MElementListener) listener);\n407:             }\n408:         }\n409:     }\n410: \n411:     /**\n412:      * Convenience method to add a listener that only listens to one specific\n413:      * event.<p>\n414:      *\n415:      * @param listener The listener to add.\n416:      * @param modelelement The modelelement the listener should be added to.\n417:      * @param eventName The eventname the listener should listen to.\n418:      */\n419:     public void addModelEventListener(Object listener,\n420: \t\t\t\t      Object modelelement,\n421: \t\t\t\t      String eventName) {\n422: \n423:         // we just return if the modelelement to add is not a NSUML class.\n424:         // we don't support other event listeners yet.\n425:         if (modelelement == null || !(modelelement instanceof MBase)) {\n426:             return;\n427:         }\n428:         if (listener == null\n429:             || !(listener instanceof MElementListener)\n430:             || eventName == null) {\n431:             throw new IllegalArgumentException();\n432:         }\n433:         EventKey[] keys =\n434:             definition.getEventTypes(modelelement.getClass(), eventName);\n435:         for (int i = 0; i < keys.length; i++) {\n436:             listenerMap.remove((MBase) modelelement,\n437: \t\t\t\tkeys[i],\n438: \t\t\t\t(MElementListener) listener);\n439:             listenerMap.put((MBase) modelelement,\n440: \t\t\t     keys[i],\n441: \t\t\t     (MElementListener) listener);\n442:         }\n443:     }\n444: \n445:     /**\n446:      * Adds a listener to all events fired by some modelelement.\n447:      *\n448:      * <em>Note:</em> Due to the fact that ALL events are pumped for\n449:      * some modelelement, this is a rather powerfull method but also\n450:      * one that can hog performance. Use this with care!<p>\n451:      *\n452:      * @param listener is the listener to add\n453:      * @param modelelement is the model element\n454:      */\n455:     public void addModelEventListener(Object listener, Object modelelement) {\n456:         // we just return if the modelelement to add is not a NSUML class.\n457:         // we don't support other event listeners yet.\n458:         if (modelelement == null || !(modelelement instanceof MBase)) {\n459:             return;\n460:         }\n461:         if (listener == null) {\n462:             throw new IllegalArgumentException(\"A listener must be supplied\");\n463:         }\n464:         if (modelelement == null) {\n465:             throw new IllegalArgumentException(\n466:                     \"A model element must be supplied\");\n467:         }\n468:         if (!(listener instanceof MElementListener)) {\n469:             throw new IllegalArgumentException(\n470:                     \"The listener must be an MElementListener - got a \"\n471:                     + listener.getClass().getName());\n472:         }\n473:         EventKey[] keys = definition.getEventTypes(modelelement.getClass());\n474:         for (int i = 0; i < keys.length; i++) {\n475:             listenerMap.remove(\n476: \t\t\t\t(MBase) modelelement,\n477: \t\t\t\tkeys[i],\n478: \t\t\t\t(MElementListener) listener);\n479:             listenerMap.put(\n480: \t\t\t     (MBase) modelelement,\n481: \t\t\t     keys[i],\n482: \t\t\t     (MElementListener) listener);\n483:         }\n484: \n485:     }\n486: \n487:     /**\n488:      * Removes a listener that listens to modelevents with name\n489:      * eventNames that are fired by the given modelelement.<p>\n490:      *\n491:      * @param listener The listener to remove\n492:      * @param handle The modelelement that fires the events the\n493:      * listener is listening to\n494:      * @param eventNames The list of event names the listener is\n495:      * interested in\n496:      */\n497:     public void removeModelEventListener(Object/*MElementListener*/ listener,\n498: \t\t\t\t\t Object handle,\n499: \t\t\t\t\t String[] eventNames) {\n500:         if (handle == null) {\n501:             return;\n502:         }\n503:         // we don't support eventlisteners other then NSUML ModelEventListener.\n504:         // to be forward compatible with other ModelEventListeners,\n505:         // we do not throw an exception but\n506:         // simply return.\n507:         if (!(handle instanceof MBase)) {\n508:             // throw new IllegalArgumentException();\n509:             return;\n510:         }\n511:         MBase modelElement = (MBase) handle;\n512:         if (listener == null\n513:             || !(listener instanceof MElementListener)\n514:             || modelElement == null\n515:             || eventNames == null\n516:             || eventNames.length == 0) {\n517:             throw new IllegalArgumentException();\n518:         }\n519:         for (int i = 0; i < eventNames.length; i++) {\n520:             EventKey[] keys =\n521:                 definition.getEventTypes(\n522: \t\t\t\t\t  modelElement.getClass(),\n523: \t\t\t\t\t  eventNames[i]);\n524:             for (int j = 0; j < keys.length; j++) {\n525:                 listenerMap.remove(modelElement,\n526: \t\t\t\t    keys[j],\n527: \t\t\t\t    (MElementListener) listener);\n528:             }\n529:         }\n530:     }\n531: \n532:     /**\n533:      * Removes a listener that listens to all events fired by the\n534:      * given modelelement.<p>\n535:      *\n536:      * @param listener is the listener\n537:      * @param handle is the model element\n538:      */\n539:     public void removeModelEventListener(Object/*MElementListener*/ listener,\n540: \t\t\t\t\t Object handle) {\n541:         if (handle == null) {\n542:             return;\n543:         }\n544:         // we don't support eventlisteners other then NSUML ModelEventListener.\n545:         // to be forward compatible with other ModelEventListeners,\n546:         // we do not throw an exception but\n547:         // simply return.\n548:         if (!(handle instanceof MBase)) {\n549:             // throw new IllegalArgumentException();\n550:             return;\n551:         }\n552: \n553: \tMBase modelElement = (MBase) handle;\n554:         if (listener == null\n555: \t    || modelElement == null\n556: \t    || !(listener instanceof MElementListener)) {\n557: \n558:             throw new IllegalArgumentException(\"listener is null or \"\n559: \t\t\t\t\t       + \"an illegal type\");\n560: \n561: \t}\n562:         EventKey[] keys = definition.getEventTypes(modelElement.getClass());\n563:         for (int i = 0; i < keys.length; i++) {\n564:             listenerMap.remove(modelElement,\n565: \t\t\t       keys[i],\n566: \t\t\t       (MElementListener) listener);\n567:         }\n568:     }\n569: \n570:     /**\n571:      * Convenience method to remove a listener to some event.<p>\n572:      *\n573:      * @param listener is the listener to remove\n574:      * @param handle is the object\n575:      * @param eventName is the name of the event\n576:      */\n577:     public void removeModelEventListener(Object/*MElementListener*/ listener,\n578: \t\t\t\t\t Object handle,\n579: \t\t\t\t\t String eventName) {\n580:         if (handle == null) {\n581:             return;\n582:         }\n583:         // we don't support eventlisteners other then NSUML ModelEventListener.\n584:         // to be forward compatible with other ModelEventListeners,\n585:         // we do not throw an exception but\n586:         // simply return.\n587:         if (!(handle instanceof MBase)) {\n588:             // throw new IllegalArgumentException();\n589:             return;\n590:         }\n591:         MBase modelElement = (MBase) handle;\n592:         if (listener == null\n593: \t    || modelElement == null\n594: \t    || eventName == null\n595: \t    || !(listener instanceof MElementListener)) {\n596: \n597:             throw new IllegalArgumentException(\"null listener or illegal type\");\n598: \t}\n599:         EventKey[] keys =\n600:             definition.getEventTypes(modelElement.getClass(), eventName);\n601:         for (int j = 0; j < keys.length; j++) {\n602:             listenerMap.remove(modelElement,\n603: \t\t\t\tkeys[j],\n604: \t\t\t\t(MElementListener) listener);\n605:         }\n606: \n607:     }\n608: \n609:     /**\n610:      * Method to remove some element from the listenerObjectMap. Used by\n611:      * delete on UmlFactory to make sure all listeners are removed.\n612:      * @param element\n613:      */\n614:     synchronized void cleanUp(MBase element) {\n615:         listenerMap.remove(element);\n616:     }\n617: \n618:     /**\n619:      * Make all event sources described by the given document\n620:      * available to the UMLModelEventPump. The document must match the\n621:      * pattern given by the following example:\n622:      *\n623:      * <pre>\n624:      * &lt;eventtree&gt;\n625:      *   &lt;source classname=\"classname of a model element\"&gt;\n626:      *     &lt;eventtype name=\"event fired by this model element\"&gt;\n627:      *       &lt;type&gt;1&lt;/type&gt;\n628:      *     &lt;/eventtype&gt;\n629:      *   &lt;/source&gt;\n630:      * &lt;/eventtree&gt;\n631:      * </pre>\n632:      *\n633:      * The classname is fully qualified.<p>\n634:      *\n635:      * The type is one of the numbers defined in {@link\n636:      * MElementEvent}. Each of the elements can be used multiple\n637:      * times.\n638:      *\n639:      * This operation is particularly provided for use by modules\n640:      * which add custom model elements.\n641:      *\n642:      * @param doc the document, the contents of which should be made available.\n643:      *            This must be preparsed.\n644:      */\n645:     public void addEventSourcesFromDocument (Document doc) {\n646:         definition.addSourcesFromDocument(doc);\n647:     }\n648: \n649:     /**\n650:      * Make event types for a single event source available to this\n651:      * UMLModelEventPump.<p>\n652:      *\n653:      * This operation is particularly provided for use by modules which add\n654:      * custom model elements.\n655:      *\n656:      * @param cSource the source class for which to make event types available.\n657:      *\n658:      * @param mpNameMap a map of the event types to add for the source class.\n659:      *                  The keys are Strings indicating the names of events,\n660:      *                  while the values are int[] which contain all the event\n661:      *                  types the indicated event represents. The specific int\n662:      *                  values used can be found in {@link MElementEvent}.\n663:      */\n664:     public void addEventSource (Class cSource, Map mpNameMap) {\n665:         definition.addSource(cSource, mpNameMap);\n666:     }\n667: \n668:     /**\n669:      * @see MElementListener#listRoleItemSet(MElementEvent)\n670:      */\n671:     public void listRoleItemSet(MElementEvent e) {\n672:         MElementListener[] listeners = getListenerList(e);\n673:         for (int i = 0; i < listeners.length; i++) {\n674: \t    try {\n675: \t\tlisteners[i].listRoleItemSet(e);\n676: \t    } catch (Exception re) {\n677: \t\tLOG.error(\"Listener \" + listeners[i]\n678: \t\t\t  + \" threw an unhandled Exception\", re);\n679: \t    }\n680:         }\n681:     }\n682: \n683:     private MElementListener[] getListenerList(MElementEvent e) {\n684:         return listenerMap.getListeners((MBase) e.getSource(),\n685: \t\t\t\t\tnew EventKey(e.getType(),\n686: \t\t\t\t\t\t     e.getName()));\n687:     }\n688: \n689:     /**\n690:      * @see MElementListener#propertySet(MElementEvent)\n691:      */\n692:     public void propertySet(MElementEvent e) {\n693:         if (!pumping) {\n694:             return;\n695:         }\n696:         if (e.getNewValue() == null\n697:             || !(e.getNewValue().equals(e.getOldValue()))) {\n698:             MElementListener[] listeners = getListenerList(e);\n699:             for (int i = 0; i < listeners.length; i++) {\n700: \t\ttry {\n701: \t\t    listeners[i].propertySet(e);\n702: \t\t} catch (Exception re) {\n703: \t\t    LOG.error(\"Listener \" + listeners[i]\n704: \t\t\t      + \" threw an unhandled Exception\", re);\n705: \t\t}\n706:             }\n707:         }\n708:     }\n709: \n710:     /**\n711:      * @see MElementListener#recovered(MElementEvent)\n712:      */\n713:     public void recovered(MElementEvent e) {\n714:         if (!pumping) {\n715:             return;\n716:         }\n717:         MElementListener[] listeners = getListenerList(e);\n718:         for (int i = 0; i < listeners.length; i++) {\n719: \t    try {\n720: \t\tlisteners[i].recovered(e);\n721: \t    } catch (Exception re) {\n722: \t\tLOG.error(\"Listener \" + listeners[i]\n723: \t\t\t  + \" threw an unhandled Exception\", re);\n724: \t    }\n725:         }\n726:     }\n727: \n728:     /**\n729:      * @see MElementListener#removed(MElementEvent)\n730:      */\n731:     public void removed(MElementEvent e) {\n732:         if (!pumping) {\n733:             return;\n734:         }\n735:         MElementListener[] listeners = getListenerList(e);\n736:         for (int i = 0; i < listeners.length; i++) {\n737: \t    try {\n738: \t\tlisteners[i].removed(e);\n739: \t    } catch (Exception re) {\n740: \t\tLOG.error(\"Listener \" + listeners[i]\n741: \t\t\t  + \" threw an unhandled Exception\", re);\n742: \t    }\n743:         }\n744:     }\n745: \n746:     /**\n747:      * @see MElementListener#roleAdded(MElementEvent)\n748:      */\n749:     public void roleAdded(MElementEvent e) {\n750:         if (!pumping) {\n751:             return;\n752:         }\n753:         MElementListener[] listeners = getListenerList(e);\n754:         for (int i = 0; i < listeners.length; i++) {\n755: \t    try {\n756: \t\tlisteners[i].roleAdded(e);\n757: \t    } catch (Exception re) {\n758: \t\tLOG.error(\"Listener \" + listeners[i]\n759: \t\t\t  + \" threw an unhandled Exception\", re);\n760: \t    }\n761:         }\n762:     }\n763: \n764:     /**\n765:      * @see MElementListener#roleRemoved(MElementEvent)\n766:      */\n767:     public void roleRemoved(MElementEvent e) {\n768:         if (!pumping) {\n769:             return;\n770:         }\n771:         MElementListener[] listeners = getListenerList(e);\n772:         for (int i = 0; i < listeners.length; i++) {\n773: \t    try {\n774: \t\tlisteners[i].roleRemoved(e);\n775: \t    } catch (Exception re) {\n776: \t\tLOG.error(\"Listener \" + listeners[i]\n777: \t\t\t  + \" threw an unhandled Exception\", re);\n778: \t    }\n779:         }\n780:     }\n781: \n782:     /**\n783:      * Clears the hashmaps with listeners. This is only needed by the JUnit\n784:      * tests. It's an implementation detail that the visibility is public.\n785:      * THIS METHOD SHOULD NOT BE USED OUTSIDE JUNIT TESTS.\n786:      */\n787:     public void cleanUp() {\n788:         listenerMap = null;\n789:         listenerMap = new EventListenerHashMap();\n790:         classListenerMap = null;\n791:         classListenerMap = new ClassListenerHashMap();\n792:     }\n793: \n794:     ClassListenerHashMap getClassListenerMap() {\n795:         return classListenerMap;\n796:     }\n797: \n798:     EventListenerHashMap getEventListenerMap() {\n799:         return listenerMap;\n800:     }\n801: \n802:     /**\n803:      * changes the NSUML event policy in order to stop udating the ui.\n804:      */\n805:     public void stopPumpingEvents() {\n806:         pumping = false;\n807: \n808:         MFactoryImpl.setEventPolicy(MFactoryImpl.EVENT_POLICY_DISABLED);\n809:     }\n810: \n811:     /**\n812:      * changes the NSUML event policy in order to start udating the ui.\n813:      */\n814:     public void startPumpingEvents() {\n815:         pumping = true;\n816: \n817:         MFactoryImpl.flushEvents();\n818:         MFactoryImpl.setEventPolicy(MFactoryImpl.EVENT_POLICY_IMMEDIATE);\n819:     }\n820: \n821:     /**\n822:      * changes the NSUML event policy to flush model events.\n823:      */\n824:     public void flushModelEvents() {\n825:         MFactoryImpl.flushEvents();\n826:     }\n827: }\n828: \n829: /**\n830:  * Value object class to find the correct eventlistenerlist in the\n831:  * eventhashmap.<p>\n832:  *\n833:  * @author jaap.branderhorst@xs4all.nl\n834:  */\n835: class EventKey {\n836:     private Integer type;\n837:     private String name;\n838: \n839:     static final EventKey EMPTY_KEY = new EventKey(null, null);\n840: \n841:     public EventKey(int t, String n) {\n842:         setType(t);\n843:         setName(n);\n844:     }\n845: \n846:     /**\n847:      * Constructor for the event key.\n848:      *\n849:      * @param t The type.\n850:      * @param n The name.\n851:      */\n852:     public EventKey(Integer t, String n) {\n853:         type = t;\n854:         setName(n);\n855:     }\n856: \n857:     /**\n858:      * @param t The new type to set.\n859:      */\n860:     private void setType(int t) {\n861:         if (t < 0 || t > 10) {\n862:             throw new IllegalArgumentException(\n863:                 \"This is not a legal eventtype: \" + t);\n864:         }\n865:         type = new Integer(t);\n866:     }\n867: \n868:     /**\n869:      * @return The type.\n870:      */\n871:     public Integer getType() {\n872:         return type;\n873:     }\n874: \n875:     /**\n876:      * @param n The new name.\n877:      */\n878:     private void setName(String n) {\n879:         name = n;\n880:     }\n881: \n882:     /**\n883:      * @return The name.\n884:      */\n885:     public String getName() {\n886:         return name;\n887:     }\n888: \n889:     /**\n890:      * @see java.lang.Object#hashCode()\n891:      */\n892:     public int hashCode() {\n893:         int code = 0;\n894:         if (getType() != null) {\n895:             code += getType().hashCode();\n896:         }\n897:         if (getName() != null) {\n898:             code += getName().hashCode();\n899:         }\n900:         return code;\n901:     }\n902: \n903:     /**\n904:      * @see java.lang.Object#equals(java.lang.Object)\n905:      */\n906:     public boolean equals(Object o) {\n907:         if (o instanceof EventKey) {\n908:             EventKey key = (EventKey) o;\n909:             if ((key.getType() == null && getType() == null)\n910:                 || (key.getType() != null\n911: \t\t    && key.getType().equals(getType())\n912: \t\t    && key.getName() != null\n913: \t\t    && key.getName().equals(getName()))) {\n914:                 return true;\n915:             }\n916:         }\n917:         return false;\n918:     }\n919: \n920: }\n921: \n922: /**\n923:  * A wrapped object array that contains triples of eventtype,\n924:  * eventname, interested listener. I used an Object array for this\n925:  * purpose since it performs fast. Copied a lot of the code from\n926:  * javax.swing.EventListenerList.\n927:  * @author jaap.branderhorst@xs4all.nl\n928:  */\n929: class EventListenerList {\n930:     private static final Logger LOG = Logger.getLogger(EventListenerList.class);\n931:     /**\n932:      * A null array to be shared by all empty listener lists.\n933:      */\n934:     private static final Object[] NULL_ARRAY = new Object[0];\n935:     /**\n936:      *  The list of EventKey - Listener pairs. It's visibility is default since\n937:      * it's used in AbstractUmlModelFactory in a performant but quite awkward\n938:      * way from an encapsulation point of view.\n939:      */\n940:     private Object[] listenerList = NULL_ARRAY;\n941: \n942:     /**\n943:      * Returns an array of listeners that are interested in an event\n944:      * that is typed by the given EventKey. If the name is null of the\n945:      * EventKey, all listeners are returned that have the\n946:      * corresponding name filled or null. Same is true for the type.\n947:      *\n948:      * @param key\n949:      * @return An array of listeners that are interested in the event typed by\n950:      * the given EventKey\n951:      */\n952:     public synchronized MElementListener[] getListeners(EventKey key) {\n953:         Object[] lList = listenerList;\n954:         int n = getListenerCount(lList, key);\n955:         MElementListener[] result =\n956:             (MElementListener[]) Array.newInstance(MElementListener.class, n);\n957:         int j = 0;\n958:         // if the event name is not set we should return all listeners\n959:         // interested\n960:         if (key.getType().intValue() == 0) {\n961:             Integer type = key.getType();\n962:             for (int i = lList.length - 3; i >= 0; i -= 3) {\n963:                 if (type.equals(lList[i])) {\n964:                     result[j++] = (MElementListener) lList[i + 2];\n965:                 }\n966:             }\n967:         } else if (key.getName() != null && key.getType() != null) {\n968:             Integer type = key.getType();\n969:             String name = key.getName();\n970:             for (int i = lList.length - 3; i >= 0; i -= 3) {\n971:                 if (name.equals(lList[i + 1]) && type.equals(lList[i])) {\n972:                     result[j++] = (MElementListener) lList[i + 2];\n973:                 }\n974:             }\n975:         } else {\n976:             throw new IllegalArgumentException(\"Illegal eventkey!\");\n977:         }\n978:         return result;\n979:     }\n980: \n981:     /**\n982:      * Registers the given listeners for the event typed by\n983:      * EventKey. If the name is null (of the EventKey), the listener\n984:      * is registred for all events that have a type corresponding to\n985:      * the type in the given key, no matter what the name of the event\n986:      * is. Vice versa for the type.<p>\n987:      *\n988:      * <strong>A listener that has been added twice will get the\n989:      * events for which it registred twice. Be careful with\n990:      * registring listeners!</strong>\n991:      *\n992:      * @param key\n993:      * @param listener\n994:      */\n995:     public synchronized void add(EventKey key, MElementListener listener) {\n996:         if (listener == null || key == null) {\n997:             throw new IllegalArgumentException(\"Null key or null listener\");\n998:         }\n999:         // check if there allready is a listener\n1000:         // if (!Arrays.asList(getListeners(key)).contains(listener)) {\n1001: \n1002:         if (listenerList == NULL_ARRAY) {\n1003:             // if this is the first listener added,\n1004:             // initialize the lists\n1005:             listenerList =\n1006:                 new Object[] {\n1007: \t\t    key.getType(), key.getName(), listener,\n1008: \t\t};\n1009:         } else {\n1010:             if (!contains(key, listener)) {\n1011:                 // Otherwise copy the array and add the new listener\n1012:                 int i = listenerList.length;\n1013:                 Object[] tmp = new Object[i + 3];\n1014:                 System.arraycopy(listenerList, 0, tmp, 0, i);\n1015: \n1016:                 tmp[i] = key.getType();\n1017:                 tmp[i + 1] = key.getName();\n1018:                 tmp[i + 2] = listener;\n1019: \n1020:                 listenerList = tmp;\n1021:             }\n1022:         }\n1023:     }\n1024: \n1025:     public boolean contains(EventKey key, MElementListener listener) {\n1026:         if (key == null) {\n1027:             LOG.info(\" KEy null\");\n1028:         }\n1029:         for (int i = listenerList.length - 1; i > 0; i -= 3) {\n1030:             if (listenerList[i] == listener\n1031:                 && ((listenerList[i - 1] == null && key.getName() == null)\n1032:                     || (listenerList[i - 1] != null\n1033:                         && listenerList[i - 1].equals(key.getName()))\n1034:                     && ((listenerList[i - 2] == null && key.getType() == null)\n1035:                         || (listenerList[i - 2] != null\n1036:                             && listenerList[i - 2].equals(key.getType()))))) {\n1037:                 return true;\n1038:             }\n1039:         }\n1040:         return false;\n1041:     }\n1042: \n1043:     /**\n1044:      * Removes a listener from the list.\n1045:      *\n1046:      * @param key\n1047:      * @param listener\n1048:      */\n1049:     public void remove(EventKey key, MElementListener listener) {\n1050:         if (key.getName() != null && key.getType() != null) {\n1051:             for (int i = listenerList.length - 3; i >= 0; i -= 3) {\n1052:                 if (listenerList[i + 2] == listener\n1053:                     && key.getName().equals(listenerList[i + 1])\n1054: \t\t    && key.getType().equals(listenerList[i])) {\n1055:                     removeElement(i);\n1056:                     break;\n1057:                 }\n1058:             }\n1059:         } else if (key.equals(EventKey.EMPTY_KEY)) {\n1060:             for (int i = listenerList.length - 1; i >= 0; i -= 3) {\n1061:                 if (listenerList[i] == listener) {\n1062:                     removeElement(i - 2);\n1063:                 }\n1064:             }\n1065:         } else if (key.getName() != null) {\n1066:             String name = key.getName();\n1067:             for (int i = listenerList.length - 1; i >= 0; i -= 3) {\n1068:                 if (listenerList[i] == listener\n1069:                     && name.equals(listenerList[i - 1])) {\n1070:                     removeElement(i - 2);\n1071:                 }\n1072:             }\n1073:         } else {\n1074:             Integer type = key.getType();\n1075:             for (int i = listenerList.length - 1; i >= 0; i -= 3) {\n1076:                 if (listenerList[i] == listener\n1077:                     && type.equals(listenerList[i - 2])) {\n1078:                     removeElement(i - 2);\n1079:                 }\n1080:             }\n1081:         }\n1082: \n1083:     }\n1084: \n1085:     /**\n1086:      * Does the actual removal of an element at the given index in the list.\n1087:      *\n1088:      * @param index\n1089:      */\n1090:     private synchronized void removeElement(int index) {\n1091:         Object[] tmp = new Object[listenerList.length - 3];\n1092:         // Copy the list up to index\n1093:         System.arraycopy(listenerList, 0, tmp, 0, index);\n1094:         // Copy from two past the index, up to\n1095:         // the end of tmp (which is three elements\n1096:         // shorter than the old list)\n1097:         if (index < tmp.length) {\n1098:             System.arraycopy(listenerList,\n1099: \t\t\t     index + 3,\n1100: \t\t\t     tmp,\n1101: \t\t\t     index,\n1102: \t\t\t     tmp.length - index);\n1103:         }\n1104:         // set the listener array to the new array or null\n1105:         if (tmp.length == 0) {\n1106:             listenerList = NULL_ARRAY;\n1107:         } else {\n1108:             listenerList = tmp;\n1109:         }\n1110:     }\n1111: \n1112:     /**\n1113:      * Returns the number of listeners that are interested in the given key and\n1114:      * exist in the given object array.\n1115:      *\n1116:      * @param list\n1117:      * @param key\n1118:      * @return the count of listeners.\n1119:      */\n1120:     private int getListenerCount(Object[] list, EventKey key) {\n1121:         int count = 0;\n1122:         String name = key.getName();\n1123:         Integer type = key.getType();\n1124:         if (type.intValue() == 0) {\n1125:             for (int i = 0; i < list.length; i += 3) {\n1126:                 if (type.equals(list[i])) {\n1127:                     count++;\n1128:                 }\n1129:             }\n1130:         } else if (name != null && type != null) {\n1131:             for (int i = 0; i < list.length; i += 3) {\n1132:                 if (type.equals(list[i]) && name.equals(list[i + 1])) {\n1133:                     count++;\n1134:                 }\n1135:             }\n1136:         } else {\n1137:             throw new IllegalArgumentException(\"Illegal eventkey!\");\n1138:         }\n1139:         return count;\n1140:     }\n1141: \n1142:     /**\n1143:      * Returns the total number of listeners of the supplied type\n1144:      * for this listener list.\n1145:      *\n1146:      * @param key The type.\n1147:      * @return The number of listeners.\n1148:      */\n1149:     public synchronized int getListenerCount(EventKey key) {\n1150:         return getListenerCount(listenerList, key);\n1151:     }\n1152: \n1153:     /**\n1154:      * Returns the total number of listeners for this listener list.\n1155:      *\n1156:      * @return The number of listeners.\n1157:      */\n1158:     public synchronized int getListenerCount() {\n1159:         return listenerList.length / 3;\n1160:     }\n1161: \n1162:     /**\n1163:      * @param ll The listenerList to set.\n1164:      */\n1165:     void setListenerList(Object[] ll) {\n1166:         this.listenerList = ll;\n1167:     }\n1168: \n1169:     /**\n1170:      * @return Returns the listenerList.\n1171:      */\n1172:     Object[] getListenerList() {\n1173:         return listenerList;\n1174:     }\n1175: \n1176: }\n1177: \n1178: /**\n1179:  * A map containing instances of meta-classes (modelelements) as keys and\n1180:  * EventListenerLists as values. The class is a wrapper around an underlying\n1181:  * java.util.HashMap and provides some custom methods for easy access to the\n1182:  * underlying data structure.\n1183:  *\n1184:  * @author jaap.branderhorst@xs4all.nl\n1185:  */\n1186: class EventListenerHashMap {\n1187: \n1188:     /**\n1189:      * A null array to be shared by all empty listener lists.\n1190:      */\n1191:     private static final MElementListener[] NULL_ARRAY =\n1192:         new MElementListener[0];\n1193: \n1194:     /**\n1195:      * The list of ListenerType - Listener pairs.\n1196:      */\n1197:     private transient Map listenerMap = new HashMap();\n1198: \n1199:     /**\n1200:      * Puts the given listener as listener to the given modelelement\n1201:      * and given eventKey in the map.\n1202:      *\n1203:      * @param element\n1204:      * @param key\n1205:      * @param listener\n1206:      */\n1207:     public synchronized void put(\n1208:         MBase elemen