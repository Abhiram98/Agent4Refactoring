dAction() {\n282:         MSendAction modelElement =\n283:             MFactory.getDefaultFactory().createSendAction();\n284:         super.initialize(modelElement);\n285:         return modelElement;\n286:     }\n287: \n288:     /** Create an empty but initialized instance of a UML Signal.\n289:      *  \n290:      *  @return an initialized UML Signal instance.\n291:      */\n292:     public MSignal createSignal() {\n293:         MSignal modelElement = MFactory.getDefaultFactory().createSignal();\n294:         super.initialize(modelElement);\n295:         return modelElement;\n296:     }\n297: \n298:     /** Create an empty but initialized instance of a UML Stimulus.\n299:      *  \n300:      *  @return an initialized UML Stimulus instance.\n301:      */\n302:     public MStimulus createStimulus() {\n303:         MStimulus modelElement = MFactory.getDefaultFactory().createStimulus();\n304:         super.initialize(modelElement);\n305:         return modelElement;\n306:     }\n307: \n308:     /** Create an empty but initialized instance of a UML TerminateAction.\n309:      *  \n310:      *  @return an initialized UML TerminateAction instance.\n311:      */\n312:     public MTerminateAction createTerminateAction() {\n313:         MTerminateAction modelElement =\n314:             MFactory.getDefaultFactory().createTerminateAction();\n315:         super.initialize(modelElement);\n316:         return modelElement;\n317:     }\n318: \n319:     /** Create an empty but initialized instance of a UML UninterpretedAction.\n320:      *  \n321:      *  @return an initialized UML UninterpretedAction instance.\n322:      */\n323:     public MUninterpretedAction createUninterpretedAction() {\n324:         MUninterpretedAction modelElement =\n325:             MFactory.getDefaultFactory().createUninterpretedAction();\n326:         super.initialize(modelElement);\n327:         return modelElement;\n328:     }\n329: \n330:     /**\n331:      * Builds a CallAction belonging to operation oper with a given name. \n332:      * Ownership of this modelelement is not set! It is unwise to build a \n333:      * callaction without an operation since the multiplicity according to the\n334:      * UML spec 1.3 is 1..1. Therefore precondition is that there is an \n335:      * operation.\n336:      * @param oper the given operation\n337:      * @param name the name for the CallAction\n338:      * @return MCallAction\n339:      */\n340:     public Object /*MCallAction*/\n341:     buildCallAction(MOperation oper, String name) {\n342:         if (oper == null) {\n343:             throw new IllegalArgumentException(\n344:                 \"There should be an operation\" + \" with a callaction.\");\n345:         }\n346:         Object action = createCallAction();\n347:         ModelFacade.setName(action, name);\n348:         ModelFacade.setOperation(action, oper);\n349:         return action;\n350:     }\n351:     \n352:     /**\n353:      * Builds a new uninterpreted action. If the argument is an action state,\n354:      * the new action is set as the entry action.\n355:      * \n356:      * @param actionState the given action state or null\n357:      * @return the newly build UninterpretedAction\n358:      */\n359:     public Object buildUninterpretedAction(Object actionState) {\n360:         Object action = createUninterpretedAction();\n361:         if (ModelFacade.isAActionState(actionState)) {\n362:             ModelFacade.setEntry(actionState, action);\n363:         }\n364:         return action;\n365:     }\n366: \n367:     /** \n368:      * Builds a Link between two Instances\n369:      *\n370:      * @param fromInstance the first given instance\n371:      * @param toInstance   the second given instance\n372:      * @return the newly build link\n373:      */\n374:     public Object buildLink(Object fromInstance, Object toInstance) {\n375:         Object link = UmlFactory.getFactory().getCommonBehavior().createLink();\n376:         Object /*MLinkEnd*/ le0 =