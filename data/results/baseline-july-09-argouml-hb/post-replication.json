                    "kwargs": {
                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/diagram/static_structure/ui/FigClass.java: \n1: // $Id$\n2: // Copyright (c) 1996-2004 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.uml.diagram.static_structure.ui;\n26: \n27: import java.awt.Color;\n28: import java.awt.Dimension;\n29: import java.awt.Rectangle;\n30: import java.awt.event.InputEvent;\n31: import java.awt.event.KeyEvent;\n32: import java.awt.event.MouseEvent;\n33: import java.beans.PropertyVetoException;\n34: import java.text.ParseException;\n35: import java.util.Collection;\n36: import java.util.Iterator;\n37: import java.util.Vector;\n38: \n39: import org.argouml.application.api.Notation;\n40: import org.argouml.model.ModelFacade;\n41: import org.argouml.model.uml.UmlModelEventPump;\n42: import org.argouml.ui.ArgoJMenu;\n43: import org.argouml.ui.ProjectBrowser;\n44: import org.argouml.ui.targetmanager.TargetManager;\n45: import org.argouml.uml.diagram.ui.CompartmentFigText;\n46: import org.argouml.uml.diagram.ui.FigAttributesCompartment;\n47: import org.argouml.uml.diagram.ui.FigCompartment;\n48: import org.argouml.uml.diagram.ui.FigEmptyRect;\n49: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n50: import org.argouml.uml.diagram.ui.ActionAddNote;\n51: import org.argouml.uml.diagram.ui.ActionAddAttribute;\n52: import org.argouml.uml.diagram.ui.FigOperationsCompartment;\n53: import org.argouml.uml.diagram.ui.AttributesCompartmentContainer;\n54: import org.argouml.uml.diagram.ui.OperationsCompartmentContainer;\n55: import org.argouml.uml.generator.ParserDisplay;\n56: import org.argouml.uml.diagram.ui.ActionAddOperation;\n57: import org.argouml.uml.diagram.ui.ActionCompartmentDisplay;\n58: import org.argouml.uml.diagram.ui.ActionEdgesDisplay;\n59: import org.argouml.uml.diagram.ui.ActionModifier;\n60: import org.tigris.gef.base.Editor;\n61: import org.tigris.gef.base.Globals;\n62: import org.tigris.gef.base.Selection;\n63: import org.tigris.gef.graph.GraphModel;\n64: import org.tigris.gef.presentation.Fig;\n65: import org.tigris.gef.presentation.FigGroup;\n66: import org.tigris.gef.presentation.FigRect;\n67: import org.tigris.gef.presentation.FigText;\n68: \n69: import ru.novosoft.uml.MElementEvent;\n70: \n71: /**\n72:  * <p>Class to display graphics for a UML Class in a diagram.</p>\n73:  */\n74: \n75: public class FigClass extends FigNodeModelElement \n76:         implements AttributesCompartmentContainer, \n77:         OperationsCompartmentContainer {\n78: \n79: \n80:     ////////////////////////////////////////////////////////////////\n81:     // constants\n82: \n83:     ////////////////////////////////////////////////////////////////\n84:     // instance variables\n85: \n86:     //These are the positions of child figs inside this fig\n87:     //They mst be added in the constructor in this order.\n88:     private static final int BLINDER_POSN = 3;\n89:     private static final int OPERATIONS_POSN = 4;\n90:     private static final int ATTRIBUTES_POSN = 5;\n91:     \n92:     /**\n93:      * <p>Manages residency of a class within a component on a deployment\n94:      *   diagram. Not clear why it is public, or even why it is an instance\n95:      *   variable (rather than local to the method).</p>\n96:      *\n97:      * not currently used. should be lazily instantiated in future.\n98:      */\n99: //    public Object resident =\n100: //\tUmlFactory.getFactory().getCore().createElementResidence();\n101: \n102:     /**\n103:      * <p>Text highlighted by mouse actions on the diagram.</p>\n104:      */\n105:     private CompartmentFigText highlightedFigText = null;\n106: \n107:     /**\n108:      * <p>Flag to indicate that we have just been created. This is to fix the\n109:      *   problem with loading classes that have stereotypes already\n110:      *   defined.</p>\n111:      */\n112:     private boolean newlyCreated = false;\n113: \n114:     ////////////////////////////////////////////////////////////////\n115:     // constructors\n116: \n117:     /**\n118:      * Main constructor for a {@link FigClass}.<p>\n119:      *\n120:      * Parent {@link FigNodeModelElement} will have created the main\n121:      * box {@link #getBigPort()} and its name {@link #getNameFig()}\n122:      * and stereotype (@link #getStereotypeFig()}. This constructor\n123:      * creates a box for the attributes and operations.<p>\n124:      *\n125:      * The properties of all these graphic elements are adjusted\n126:      * appropriately. The main boxes are all filled and have\n127:      * outlines.<p>\n128:      *\n129:      * For reasons I don't understand the stereotype is created in a\n130:      * box with lines. So we have to created a blanking rectangle to\n131:      * overlay the bottom line, and avoid four compartments\n132:      * showing.<p>\n133:      *\n134:      * There is some complex logic to allow for the possibility that\n135:      * stereotypes may not be displayed (unlike operations and\n136:      * attributes this is not a standard thing for UML). Some care is\n137:      * needed to ensure that additional space is not added, each time\n138:      * a stereotyped class is loaded.<p>\n139:      *\n140:      * There is a particular problem when loading diagrams with\n141:      * stereotyped classes. Because we create a FigClass indicating\n142:      * the stereotype is not displayed, we then add extra space for\n143:      * such classes when they are first rendered. This ought to be\n144:      * fixed by correctly saving the class dimensions, but that needs\n145:      * more work. The solution here is to use a simple flag to\n146:      * indicate the FigClass has just been created.<p>\n147:      *\n148:      * <em>Warning</em>. Much of the graphics positioning is hard\n149:      * coded. The overall figure is placed at location (10,10). The\n150:      * name compartment (in the parent {@link FigNodeModelElement} is\n151:      * 21 pixels high. The stereotype compartment is created 15 pixels\n152:      * high in the parent, but we change it to 19 pixels, 1 more than\n153:      * ({@link #STEREOHEIGHT} here. The attribute and operations boxes\n154:      * are created at 19 pixels, 2 more than {@link #ROWHEIGHT}.<p>\n155:      *\n156:      * CAUTION: This constructor (with no arguments) is the only one\n157:      * that does enableSizeChecking(false), all others must set it\n158:      * true.  This is because this constructor is the only one called\n159:      * when loading a project. In this case, the parsed size must be\n160:      * maintained.<p>\n161:      */\n162:     public FigClass() {\n163: \n164:         // Set name box. Note the upper line will be blanked out if there is\n165:         // eventually a stereotype above.\n166:         getNameFig().setLineWidth(1);\n167:         getNameFig().setFilled(true);\n168: \n169:         // Attributes inside. First one is the attribute box itself.\n170:         FigCompartment attrVec = \n171:             new FigAttributesCompartment(10, 30, 60, ROWHEIGHT + 2);\n172: \n173:         // this rectangle marks the operation section; all operations\n174:         // are inside it\n175:         FigCompartment operVec = \n176:             new FigOperationsCompartment(10, 31 + ROWHEIGHT, 60, ROWHEIGHT + 2);\n177: \n178:         // Set properties of the stereotype box. Make it 1 pixel higher than\n179:         // before, so it overlaps the name box, and the blanking takes out both\n180:         // lines. Initially not set to be displayed, but this will be changed\n181:         // when we try to render it, if we find we have a stereotype.\n182:         getStereotypeFigText().setExpandOnly(true);\n183:         getStereotypeFig().setFilled(true);\n184:         getStereotypeFig().setLineWidth(1);\n185:         getStereotypeFigText().setEditable(false);\n186:         getStereotypeFig().setHeight(STEREOHEIGHT + 1);\n187:         // +1 to have 1 pixel overlap with getNameFig()\n188:         getStereotypeFig().setVisible(false);\n189: \n190:         // A thin rectangle to overlap the boundary line between stereotype\n191:         // and name. This is just 2 pixels high, and we rely on the line\n192:         // thickness, so the rectangle does not need to be filled. Whether to\n193:         // display is linked to whether to display the stereotype.\n194:         FigRect stereoLineBlinder =\n195: \t    new FigRect(11, 10 + STEREOHEIGHT, 58, 2,\n196: \t\t\tColor.white, Color.white);\n197:         stereoLineBlinder.setLineWidth(1);\n198:         stereoLineBlinder.setVisible(false);\n199: \n200:         FigEmptyRect bigPort = new FigEmptyRect(10, 10, 0, 0);\n201:         bigPort.setLineWidth(1);\n202:         bigPort.setLineColor(Color.black);\n203:         setBigPort(bigPort);\n204:         \n205:         // Mark this as newly created. This is to get round the problem with\n206:         // creating figs for loaded classes that had stereotypes. They are\n207:         // saved with their dimensions INCLUDING the stereotype, but since we\n208:         // pretend the stereotype is not visible, we add height the first time\n209:         // we render such a class. This is a complete fudge, and really we\n210:         // ought to address how class objects with stereotypes are saved. But\n211:         // that will be hard work.\n212:         newlyCreated = true;\n213: \n214:         // Put all the bits together, suppressing bounds calculations until\n215:         // we're all done for efficiency.\n216:         enableSizeChecking(false);\n217:         setSuppressCalcBounds(true);\n218:         addFig(getStereotypeFig());\n219:         addFig(getNameFig());\n220:         addFig(bigPort);\n221:         addFig(stereoLineBlinder);\n222:         addFig(operVec);\n223:         addFig(attrVec);\n224: \n225:         setSuppressCalcBounds(false);\n226:         // Set the bounds of the figure to the total of the above (hardcoded)\n227:         setBounds(10, 10, 60, 22 + 2 * ROWHEIGHT);\n228:     }\n229: \n230:     /**\n231:      * <p>Constructor for use if this figure is created for an existing class\n232:      *   node in the metamodel.</p>\n233:      *\n234:      * <p>Set the figure's name according to this node. This is used when the\n235:      *   user click's on 'add to diagram' in the navpane.  Don't know if this\n236:      *   should rather be done in one of the super classes, since similar code\n237:      *   is used in FigInterface.java etc.  Andreas Rueckert\n238:      *   &lt;a_rueckert@gmx.net&gt;</p>\n239:      *\n240:      * @param gm   Not actually used in the current implementation\n241:      *\n242:      * @param node The UML object being placed.\n243:      */\n244:     public FigClass(GraphModel gm, Object node) {\n245:         this();\n246:         enableSizeChecking(true);\n247:         setOwner(node);\n248:         if ((ModelFacade.isAClassifier(node))\n249:                 && (ModelFacade.getName(node) != null)) {\n250:             setName(ModelFacade.getName(node));\n251:         }\n252:     }\n253: \n254:     /**\n255:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#getH()\n256:      */\n257:     public String placeString() {\n258:         return \"new Class\";\n259:     }\n260: \n261:     ////////////////////////////////////////////////////////////////\n262:     // accessors\n263: \n264:     /**\n265:      * @see org.tigris.gef.presentation.Fig#makeSelection()\n266:      */\n267:     public Selection makeSelection() {\n268:         return new SelectionClass(this);\n269:     }\n270: \n271:     /**\n272:      * Build a collection of menu items relevant for a right-click\n273:      * popup menu on a Package.\n274:      *\n275:      * @param     me     a mouse event\n276:      * @return           a collection of menu items\n277:      */\n278:     public Vector getPopUpActions(MouseEvent me) {\n279:         Vector popUpActions = super.getPopUpActions(me);\n280: \n281:         ArgoJMenu addMenu = new ArgoJMenu(BUNDLE, \"menu.popup.add\");\n282:         addMenu.add(ActionAddAttribute.getSingleton());\n283:         addMenu.add(ActionAddOperation.getSingleton());\n284:         addMenu.add(ActionAddNote.getSingleton());\n285:         popUpActions.insertElementAt(addMenu,\n286:             popUpActions.size() - POPUP_ADD_OFFSET);\n287: \n288:         ArgoJMenu showMenu = new ArgoJMenu(BUNDLE, \"menu.popup.show\");\n289:         if (isAttributesVisible() && isOperationsVisible()) {\n290:             showMenu.add(ActionCompartmentDisplay.HideAllCompartments);\n291:         } else if (!isAttributesVisible() && !isOperationsVisible()) {\n292:             showMenu.add(ActionCompartmentDisplay.ShowAllCompartments);\n293:         }\n294: \n295:         if (isAttributesVisible()) {\n296:             showMenu.add(ActionCompartmentDisplay.HideAttrCompartment);\n297:         } else {\n298:             showMenu.add(ActionCompartmentDisplay.ShowAttrCompartment);\n299:         }\n300: \n301:         if (isOperationsVisible()) {\n302:             showMenu.add(ActionCompartmentDisplay.HideOperCompartment);\n303:         } else {\n304:             showMenu.add(ActionCompartmentDisplay.ShowOperCompartment);\n305:         }\n306: \n307:         showMenu.add(ActionEdgesDisplay.getShowEdges());\n308:         showMenu.add(ActionEdgesDisplay.getHideEdges());\n309: \n310:         popUpActions.insertElementAt(showMenu,\n311:             popUpActions.size() - POPUP_ADD_OFFSET);\n312: \n313:         Object mclass = /*(MClass)*/ getOwner();\n314:         ArgoJMenu modifierMenu = new ArgoJMenu(BUNDLE, \"menu.popup.modifiers\");\n315: \n316:         modifierMenu.addCheckItem(\n317: \t\tnew ActionModifier(\"Public\",\n318: \t\t\t\t   \"visibility\", \"getVisibility\",\n319: \t\t\t\t   \"setVisibility\",\n320: \t\t\t\t   /*(MClass)*/ mclass,\n321: \t\t\t\t   (Class) ModelFacade.VISIBILITYKIND,\n322: \t\t\t\t   ModelFacade.PUBLIC_VISIBILITYKIND,\n323: \t\t\t\t   null));\n324:         modifierMenu.addCheckItem(\n325: \t\tnew ActionModifier(\"Abstract\",\n326: \t\t\t\t   \"isAbstract\", \"isAbstract\", \"setAbstract\",\n327: \t\t\t\t   mclass));\n328:         modifierMenu.addCheckItem(\n329: \t\tnew ActionModifier(\"Leaf\",\n330: \t\t\t\t   \"isLeaf\", \"isLeaf\", \"setLeaf\", mclass));\n331:         modifierMenu.addCheckItem(\n332: \t\tnew ActionModifier(\"Root\",\n333: \t\t\t\t   \"isRoot\", \"isRoot\", \"setRoot\", mclass));\n334:         modifierMenu.addCheckItem(\n335: \t\tnew ActionModifier(\"Active\",\n336: \t\t\t\t   \"isActive\", \"isActive\", \"setActive\",\n337: \t\t\t\t   mclass));\n338: \n339:         popUpActions.insertElementAt(modifierMenu,\n340:             popUpActions.size() - POPUP_ADD_OFFSET);\n341:         // end of block\n342: \n343:         return popUpActions;\n344:     }\n345: \n346:     /**\n347:      * @return The vector of graphics for operations (if any). \n348:      * First one is the rectangle for the entire operations box.\n349:      */\n350:     public FigGroup getOperationsFig() {\n351:         return (FigGroup) getFigAt(OPERATIONS_POSN);\n352:     }\n353:     \n354:     /**\n355:      * @return The vector of graphics for operations (if any). \n356:      * First one is the rectangle for the entire operations box.\n357:      */\n358:     public FigGroup getAttributesFig() {\n359:         return (FigGroup) getFigAt(ATTRIBUTES_POSN);\n360:     }\n361: \n362:     /**\n363:      * Returns the status of the operation field.\n364:      * @return true if the operations are visible, false otherwise\n365:      */\n366:     public boolean isOperationsVisible() {\n367:         return getOperationsFig().isVisible();\n368:     }\n369: \n370:     /**\n371:      * Returns the status of the attribute field.\n372:      * @return true if the attributes are visible, false otherwise\n373:      */\n374:     public boolean isAttributesVisible() {\n375:         return getAttributesFig().isVisible();\n376:     }\n377: \n378:     /**\n379:      * @param isVisible true if the attribute compartment is visible\n380:      */\n381:     public void setAttributesVisible(boolean isVisible) {\n382:         Rectangle rect = getBounds();\n383:         int h;\n384:     \tif (isCheckSize()) {\n385:     \t    h = ((ROWHEIGHT  \n386:                 * Math.max(1, getAttributesFig().getFigs(null).size() - 1) + 2)\n387:                 * rect.height\n388:                 / getMinimumSize().height);\n389:         } else {\n390:             h = 0;\n391:         }\n392:         if (getAttributesFig().isVisible()) {\n393:             if (!isVisible) {  // hide compartment\n394:                 damage();\n395:                 Iterator it = getAttributesFig().getFigs(null).iterator();\n396:                 while (it.hasNext()) {\n397:                     ((Fig) (it.next())).setVisible(false);\n398:                 }\n399:                 getAttributesFig().setVisible(false);\n400:                 Dimension aSize = this.getMinimumSize();\n401:                 setBounds(rect.x, rect.y,\n402: \t\t\t  (int) aSize.getWidth(), (int) aSize.getHeight());\n403:             }\n404:         } else {\n405:             if (isVisible) { // show compartement\n406:                 Iterator it = getAttributesFig().getFigs(null).iterator();\n407:                 while (it.hasNext()) {\n408:                     ((Fig) (it.next())).setVisible(true);\n409:                 }\n410:                 getAttributesFig().setVisible(true);\n411:                 Dimension aSize = this.getMinimumSize();\n412:                 setBounds(rect.x, rect.y,\n413: \t\t\t  (int) aSize.getWidth(), (int) aSize.getHeight());\n414:                 damage();\n415:             }\n416:         }\n417:     }\n418: \n419:     /**\n420:      * @param isVisible true if the operation compartment is visible\n421:      */\n422:     public void setOperationsVisible(boolean isVisible) {\n423:         Rectangle rect = getBounds();\n424:         int h =\n425:     \t    isCheckSize()\n426:     \t    ? ((ROWHEIGHT  \n427:                 * Math.max(1, getOperationsFig().getFigs(null).size() - 1) + 2)\n428:     \t        * rect.height\n429:     \t        / getMinimumSize().height)\n430:     \t    : 0;\n431:         if (isOperationsVisible()) { // if displayed\n432:             if (!isVisible) {\n433:                 damage();\n434:                 Iterator it = getOperationsFig().getFigs(null).iterator();\n435:                 while (it.hasNext()) {\n436:                     ((Fig) (it.next())).setVisible(false);\n437:                 }\n438:                 getOperationsFig().setVisible(false);\n439:                 Dimension aSize = this.getMinimumSize();\n440:                 setBounds(rect.x, rect.y,\n441: \t\t\t  (int) aSize.getWidth(), (int) aSize.getHeight());\n442:             }\n443:         } else {\n444:             if (isVisible) {\n445:                 Iterator it = getOperationsFig().getFigs(null).iterator();\n446:                 while (it.hasNext()) {\n447:                     ((Fig) (it.next())).setVisible(true);\n448:                 }\n449:                 getOperationsFig().setVisible(true);\n450:                 Dimension aSize = this.getMinimumSize();\n451:                 setBounds(rect.x, rect.y,\n452:                     (int) aSize.getWidth(), (int) aSize.getHeight());\n453:                 damage();\n454:             }\n455:         }\n456:     }\n457: \n458:     /**\n459:      * <p>Gets the minimum size permitted for a class on the diagram.</p>\n460:      *\n461:      * <p>Parts of this are hardcoded, notably the fact that the name\n462:      *   compartment has a minimum height of 21 pixels.</p>\n463:      *\n464:      * @return  the size of the minimum bounding box.\n465:      */\n466:     public Dimension getMinimumSize() {\n467: \n468:         // Use \"aSize\" to build up the minimum size. Start with the size of the\n469:         // name compartment and build up.\n470: \n471:         Dimension aSize = getNameFig().getMinimumSize();\n472:         int h = aSize.height;\n473:         int w = aSize.width;\n474: \n475:         // Ensure that the minimum height of the name compartment is at least\n476:         // 21 pixels (hardcoded).\n477: \n478:         if (aSize.height < 21) {\n479:             aSize.height = 21;\n480:         }\n481: \n482:         // If we have a stereotype displayed, then allow some space for that\n483:         // (width and height)\n484: \n485:         if (getStereotypeFig().isVisible()) {\n486:             aSize.width =\n487: \t\tMath.max(aSize.width,\n488: \t\t\t getStereotypeFig().getMinimumSize().width);\n489:             aSize.height += STEREOHEIGHT;\n490:         }\n491: \n492:         // Allow space for each of the attributes we have\n493: \n494:         if (getAttributesFig().isVisible()) {\n495: \n496:             // Loop through all the attributes, to find the widest (remember\n497:             // the first fig is the box for the whole lot, so ignore it).\n498: \n499:             Iterator it = getAttributesFig().getFigs(null).iterator();\n500:             it.next(); // Ignore first element\n501: \n502:             while (it.hasNext()) {\n503:                 int elemWidth =\n504: \t\t    ((FigText) it.next()).getMinimumSize().width + 2;\n505:                 aSize.width = Math.max(aSize.width, elemWidth);\n506:             }\n507: \n508:             // Height allows one row for each attribute (remember to ignore the\n509:             // first element.\n510: \n511:             aSize.height +=\n512: \t\tROWHEIGHT * Math.max(1, \n513: \t\t        getAttributesFig().getFigs(null).size() - 1) + 1;\n514:         }\n515: \n516:         // Allow space for each of the operations we have\n517: \n518:         if (isOperationsVisible()) {\n519: \n520:             // Loop through all the operations, to find the widest (remember\n521:             // the first fig is the box for the whole lot, so ignore it).\n522: \n523:             Iterator it = getOperationsFig().getFigs(null).iterator();\n524:             it.next(); // ignore\n525: \n526:             while (it.hasNext()) {\n527:                 int elemWidth =\n528: \t\t    ((FigText) it.next()).getMinimumSize().width + 2;\n529:                 aSize.width = Math.max(aSize.width, elemWidth);\n530:             }\n531: \n532:             aSize.height +=\n533: \t\tROWHEIGHT * Math.max(1, \n534: \t\t        getOperationsFig().getFigs(null).size() - 1) + 1;\n535:         }\n536: \n537:         // we want to maintain a minimum width for the class\n538:         aSize.width = Math.max(60, aSize.width);\n539: \n540:         // And now aSize has the answer\n541: \n542:         return aSize;\n543:     }\n544: \n545:     /**\n546:      * @see org.tigris.gef.presentation.Fig#setFillColor(java.awt.Color)\n547:      */\n548:     public void setFillColor(Color lColor) {\n549:         super.setFillColor(lColor);\n550:         getFigAt(BLINDER_POSN).setLineColor(lColor);\n551:     }\n552: \n553:     /**\n554:      * @see org.tigris.gef.presentation.Fig#setLineColor(java.awt.Color)\n555:      */\n556:     public void setLineColor(Color lColor) {\n557:         super.setLineColor(lColor);\n558:         getFigAt(BLINDER_POSN)\n559:             .setLineColor(getFigAt(BLINDER_POSN).getFillColor());\n560:     }\n561: \n562:     /**\n563:      * @see org.tigris.gef.presentation.Fig#translate(int, int)\n564:      */\n565:     public void translate(int dx, int dy) {\n566:         super.translate(dx, dy);\n567:         Editor ce = Globals.curEditor();\n568:         Selection sel = ce.getSelectionManager().findSelectionFor(this);\n569:         if (sel instanceof SelectionClass)\n570: \t    ((SelectionClass) sel).hideButtons();\n571:     }\n572: \n573:     ////////////////////////////////////////////////////////////////\n574:     // user interaction methods\n575: \n576:     /**\n577:      * @see java.awt.event.MouseListener#mouseExited(java.awt.event.MouseEvent)\n578:      */\n579:     public void mouseExited(MouseEvent me) {\n580:         super.mouseExited(me);\n581:         unhighlight();\n582:     }\n583: \n584:     /**\n585:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n586:      */\n587:     public void keyPressed(KeyEvent ke) {\n588:         int key = ke.getKeyCode();\n589:         if (key == KeyEvent.VK_UP || key == KeyEvent.VK_DOWN) {\n590:             CompartmentFigText ft = unhighlight();\n591:             if (ft != null) {\n592:                 int i = new Vector(getAttributesFig().getFigs(null))\n593:                                             .indexOf(ft);\n594:                 FigGroup fg = getAttributesFig();\n595:                 if (i == -1) {\n596:                     i = new Vector(getOperationsFig().getFigs(null))\n597:                                             .indexOf(ft);\n598:                     fg = getOperationsFig();\n599:                 }\n600:                 if (i != -1) {\n601:                     if (key == KeyEvent.VK_UP) {\n602:                         ft = (CompartmentFigText)\n603: \t\t\t    getPreviousVisibleFeature(fg, ft, i);\n604:                     } else {\n605:                         ft = (CompartmentFigText)\n606: \t\t\t    getNextVisibleFeature(fg, ft, i);\n607:                     }\n608:                     if (ft != null) {\n609:                         ft.setHighlighted(true);\n610:                         highlightedFigText = ft;\n611:                         return;\n612:                     }\n613:                 }\n614:             }\n615:         } else if (key == KeyEvent.VK_ENTER && highlightedFigText != null) {\n616:             highlightedFigText.startTextEditor(ke);\n617:             ke.consume();\n618:             return;\n619:         }\n620:         super.keyPressed(ke);\n621:     }\n622: \n623:     ////////////////////////////////////////////////////////////////\n624:     // internal methods\n625: \n626:     /**\n627:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEdited(org.tigris.gef.presentation.FigText)\n628:      */\n629:     protected void textEdited(FigText ft) throws PropertyVetoException {\n630:         super.textEdited(ft);\n631:         Object cls = /*(MClassifier)*/ getOwner();\n632:         if (cls == null) {\n633:             return;\n634:         }\n635:         int i = new Vector(getAttributesFig().getFigs(null)).indexOf(ft);\n636:         if (i != -1) {\n637:             highlightedFigText = (CompartmentFigText) ft;\n638:             highlightedFigText.setHighlighted(true);\n639:             try {\n640:                 ParserDisplay.SINGLETON\n641: \t\t    .parseAttributeFig(cls,\n642: \t\t\t\t       /*(MAttribute)*/\n643: \t\t\t\t       highlightedFigText.getOwner(),\n644: \t\t\t\t       highlightedFigText.getText().trim());\n645:                 ProjectBrowser.getInstance().getStatusBar().showStatus(\"\");\n646:             } catch (ParseException pe) {\n647:                 ProjectBrowser.getInstance().getStatusBar()\n648: \t\t    .showStatus(\"Error: \" + pe + \" at \" + pe.getErrorOffset());\n649:             }\n650:             return;\n651:         }\n652:         i = new Vector(getOperationsFig().getFigs(null)).indexOf(ft);\n653:         if (i != -1) {\n654:             highlightedFigText = (CompartmentFigText) ft;\n655:             highlightedFigText.setHighlighted(true);\n656:             try {\n657:                 ParserDisplay.SINGLETON\n658: \t\t    .parseOperationFig(cls,\n659: \t\t\t\t       /*(MOperation)*/\n660: \t\t\t\t       highlightedFigText.getOwner(),\n661: \t\t\t\t       highlightedFigText.getText().trim());\n662:                 ProjectBrowser.getInstance().getStatusBar().showStatus(\"\");\n663:             } catch (ParseException pe) {\n664:                 ProjectBrowser.getInstance().getStatusBar()\n665: \t\t    .showStatus(\"Error: \" + pe + \" at \" + pe.getErrorOffset());\n666:             }\n667:             return;\n668:         }\n669:     }\n670: \n671:     /**\n672:      * @param fgVec the FigGroup\n673:      * @param ft    the Figtext\n674:      * @param i     get the fig before fig i\n675:      * @return the FigText\n676:      */\n677:     protected FigText getPreviousVisibleFeature(FigGroup fgVec,\n678: \t\t\t\t\t\tFigText ft, int i) {\n679:         if (fgVec == null || i < 1) {\n680:             return null;\n681:         }\n682:         FigText ft2 = null;\n683:         // TODO: come GEF V 0.12 use getFigs returning an array\n684:         Vector v = new Vector(fgVec.getFigs(null));\n685:         if (i >= v.size() || !((FigText) v.elementAt(i)).isVisible()) {\n686:             return null;\n687:         }\n688:         do {\n689:             i--;\n690:             while (i < 1) {\n691:                 fgVec = (fgVec == getAttributesFig()) \n692:                     ? getOperationsFig() \n693:                     : getAttributesFig();\n694:                 v = new Vector(fgVec.getFigs(null));\n695:                 i = v.size() - 1;\n696:             }\n697:             ft2 = (FigText) v.elementAt(i);\n698:             if (!ft2.isVisible()) {\n699:                 ft2 = null;\n700:             }\n701:         } while (ft2 == null);\n702:         return ft2;\n703:     }\n704: \n705:     /**\n706:      * @param fgVec the FigGroup\n707:      * @param ft    the Figtext\n708:      * @param i     get the fig after fig i\n709:      * @return the FigText\n710:      */\n711:     protected FigText getNextVisibleFeature(FigGroup fgVec, FigText ft, int i)\n712:     {\n713:         if (fgVec == null || i < 1) {\n714:             return null;\n715:         }\n716:         FigText ft2 = null;\n717:         // TODO: come GEF V 0.12 use getFigs returning an array\n718:         Vector v = new Vector(fgVec.getFigs(null));\n719:         if (i >= v.size() || !((FigText) v.elementAt(i)).isVisible()) {\n720:             return null;\n721:         }\n722:         do {\n723:             i++;\n724:             while (i >= v.size()) {\n725:                 fgVec = (fgVec == getAttributesFig()) \n726:                     ? getOperationsFig() \n727:                     : getAttributesFig();\n728:                 v = new Vector(fgVec.getFigs(null));\n729:                 i = 1;\n730:             }\n731:             ft2 = (FigText) v.elementAt(i);\n732:             if (!ft2.isVisible())\n733:                 ft2 = null;\n734:         } while (ft2 == null);\n735:         return ft2;\n736:     }\n737: \n738:     /**\n739:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#createFeatureIn(\n740:      * org.tigris.gef.presentation.FigGroup, java.awt.event.InputEvent)\n741:      */\n742:     protected void createFeatureIn(FigGroup fg, InputEvent ie) {\n743:         CompartmentFigText ft = null;\n744:         Object cls = /*(MClassifier)*/ getOwner();\n745:         if (cls == null) {\n746:             return;\n747:         }\n748:         if (fg == getAttributesFig()) {\n749:             ActionAddAttribute.getSingleton().actionPerformed(null);\n750:         } else {\n751:             ActionAddOperation.getSingleton().actionPerformed(null);\n752:         }\n753:         // TODO: When available use getFigs() returning array\n754:         ft = (CompartmentFigText) new Vector(fg.getFigs(null)).lastElement();\n755:         if (ft != null) {\n756:             ft.startTextEditor(ie);\n757:             ft.setHighlighted(true);\n758:             highlightedFigText = ft;\n759:         }\n760:         ie.consume();\n761:     }\n762: \n763:     /**\n764:      * @return the compartment\n765:      */\n766:     protected CompartmentFigText unhighlight() {\n767:         CompartmentFigText ft;\n768:         // TODO: in future version of GEF call getFigs returning array\n769:         Vector v = new Vector(getAttributesFig().getFigs(null));\n770:         int i;\n771:         for (i = 1; i < v.size(); i++) {\n772:             ft = (CompartmentFigText) v.elementAt(i);\n773:             if (ft.isHighlighted()) {\n774:                 ft.setHighlighted(false);\n775:                 highlightedFigText = null;\n776:                 return ft;\n777:             }\n778:         }\n779:         // TODO: in future version of GEF call getFigs returning array\n780:         v = new Vector(getOperationsFig().getFigs(null));\n781:         for (i = 1; i < v.size(); i++) {\n782:             ft = (CompartmentFigText) v.elementAt(i);\n783:             if (ft.isHighlighted()) {\n784:                 ft.setHighlighted(false);\n785:                 highlightedFigText = null;\n786:                 return ft;\n787:             }\n788:         }\n789:         return null;\n790:     }\n791: \n792:     /**\n793:      * Handles changes of the model. Takes into account the event that\n794:      * occured. If you need to update the whole fig, consider using\n795:      * renderingChanged.<p>\n796:      *\n797:      * @see FigNodeModelElement#modelChanged(MElementEvent)\n798:      */\n799:     protected void modelChanged(MElementEvent mee) {\n800:         super.modelChanged(mee);\n801: \n802:         if (getOwner() == null) {\n803:             return;\n804:         }\n805:         Object cls = /*(MClass)*/ getOwner();\n806:         // attributes\n807:         if (mee == null\n808:                 || ModelFacade.isAAttribute(mee.getSource())\n809:                 || (mee.getSource() == getOwner()\n810: \t\t&& mee.getName().equals(\"feature\"))) {\n811:             updateAttributes();\n812:             damage();\n813:         }\n814:         // operations\n815:         if (mee == null\n816:                 || ModelFacade.isAOperation(mee.getSource())\n817:                 || ModelFacade.isAParameter(mee.getSource())\n818:                 || (mee.getSource() == getOwner()\n819: \t\t&& mee.getName().equals(\"feature\"))) {\n820:             updateOperations();\n821:             damage();\n822:         }\n823:         if (mee != null && mee.getName().equals(\"parameter\") \n824:                 && ModelFacade.isAOperation(mee.getSource())) {\n825:             if (mee.getAddedValue() != null) {\n826:                 UmlModelEventPump.getPump().addModelEventListener(this, \n827:                         mee.getAddedValue(), new String[] {\n828:                             \"name\", \"kind\", \"type\", \"defaultValue\"});\n829:             }\n830:             if (mee.getRemovedValue() != null) {\n831:                 UmlModelEventPump.getPump().addModelEventListener(this, \n832:                         mee.getRemovedValue());\n833:             }\n834:         }\n835:         if (mee == null || mee.getName().equals(\"isAbstract\")) {\n836:             updateAbstract();\n837:             damage();\n838:         }\n839:         if (mee == null || mee.getName().equals(\"stereotype\")) {\n840:             updateStereotypeText();\n841:             updateAttributes();\n842:             updateOperations();\n843:             damage();\n844:         }\n845:         if (mee != null && mee.getSource()\n846:                 .equals(ModelFacade.getStereoType(getOwner()))) {\n847:             updateStereotypeText();\n848:             damage();\n849:         }\n850:         // name updating\n851:         super.modelChanged(mee);\n852:     }\n853: \n854:     /**\n855:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateStereotypeText()\n856:      */\n857:     protected void updateStereotypeText() {\n858: \n859:         Object me = /*(MModelElement)*/ getOwner();\n860: \n861:         if (me == null) {\n862:             return;\n863:         }\n864: \n865:         Rectangle rect = getBounds();\n866:         Object stereo = null;\n867:         if (ModelFacade.getStereotypes(me).size() > 0) {\n868:             stereo = ModelFacade.getStereotypes(me).iterator().next();\n869:         }\n870: \n871:         if ((stereo == null)\n872:                 || (ModelFacade.getName(stereo) == null)\n873:                 || (ModelFacade.getName(stereo).length() == 0))\t{\n874: \n875:             if (getStereotypeFig().isVisible()) {\n876:                 getFigAt(BLINDER_POSN).setVisible(false);\n877:                 getStereotypeFig().setVisible(false);\n878:                 rect.y += STEREOHEIGHT;\n879:                 rect.height -= STEREOHEIGHT;\n880:                 setBounds(rect.x, rect.y, rect.width, rect.height);\n881:                 calcBounds();\n882:             }\n883:         } else {\n884:             setStereotype(Notation.generateStereotype(this, stereo));\n885: \n886:             if (!getStereotypeFig().isVisible()) {\n887:                 getFigAt(BLINDER_POSN).setVisible(true);\n888:                 getStereotypeFig().setVisible(true);\n889: \n890:                 // Only adjust the stereotype height if we are not newly\n891:                 // created. This gets round the problem of loading classes with\n892:                 // stereotypes defined, which have the height already including\n893:                 // the stereotype.\n894: \n895:                 if (!newlyCreated) {\n896:                     rect.y -= STEREOHEIGHT;\n897:                     rect.height += STEREOHEIGHT;\n898:                     setBounds(rect.x, rect.y, rect.width, rect.height);\n899:                     calcBounds();\n900:                 }\n901:             }\n902:         }\n903: \n904:         // Whatever happened we are no longer newly created, so clear the\n905:         // flag. Then set the bounds for the rectangle we have defined.\n906:         newlyCreated = false;\n907:     }\n908: \n909:     /**\n910:      * <p>Sets the bounds, but the size will be at least the one returned by\n911:      *   {@link #getMinimumSize()}, unless checking of size is disabled.</p>\n912:      *\n913:      * <p>If the required height is bigger, then the additional height is\n914:      *   equally distributed among all figs (i.e. compartments), such that the\n915:      *   cumulated height of all visible figs equals the demanded height<p>.\n916:      *\n917:      * <p>Some of this has \"magic numbers\" hardcoded in. In particular there is\n918:      *   a knowledge that the minimum height of a name compartment is 21\n919:      *   pixels.</p>\n920:      *\n921:      * @param x  Desired X coordinate of upper left corner\n922:      *\n923:      * @param y  Desired Y coordinate of upper left corner\n924:      *\n925:      * @param w  Desired width of the FigClass\n926:      *\n927:      * @param h  Desired height of the FigClass\n928:      */\n929:     public void setBounds(int x, int y, int w, int h) {\n930: \n931:         // Save our old boundaries (needed later), and get minimum size\n932:         // info. \"aSize will be used to maintain a running calculation of our\n933:         // size at various points.\n934: \n935:         // \"extra_each\" is the extra height per displayed fig if requested\n936:         // height is greater than minimal. \"height_correction\" is the height\n937:         // correction due to rounded division result, will be added to the name\n938:         // compartment\n939: \n940:         Rectangle oldBounds = getBounds();\n941:         Dimension aSize = \n942:             isCheckSize() ? getMinimumSize() : new Dimension(w, h);\n943: \n944:         int newW = Math.max(w, aSize.width);\n945:         int newH = h;\n946: \n947:         int extraEach = 0;\n948:         int heightCorrection = 0;\n949: \n950:         // First compute all nessessary height data. Easy if we want less than\n951:         // the minimum\n952: \n953:         if (newH <= aSize.height) {\n954: \n955:             // Just use the mimimum\n956: \n957:             newH = aSize.height;\n958: \n959:         } else {\n960: \n961:             // Split the extra amongst the number of displayed compartments\n962: \n963:             int displayedFigs = 1; //this is for getNameFig()\n964: \n965:             if (getAttributesFig().isVisible()) {\n966:                 displayedFigs++;\n967:             }\n968: \n969:             if (isOperationsVisible()) {\n970:                 displayedFigs++;\n971:             }\n972: \n973:             // Calculate how much each, plus a correction to put in the name\n974:             // comparment if the result is rounded\n975: \n976:             extraEach = (newH - aSize.height) / displayedFigs;\n977:             heightCorrection =\n978: \t\t(newH - aSize.height) - (extraEach * displayedFigs);\n979:         }\n980: \n981:         // Now resize all sub-figs, including not displayed figs. Start by the\n982:         // name. We override the getMinimumSize if it is less than our view (21\n983:         // pixels hardcoded!). Add in the shared extra, plus in this case the\n984:         // correction.\n985: \n986:         int height = getNameFig().getMinimumSize().height;\n987: \n988:         if (height < 21) {\n989:             height = 21;\n990:         }\n991: \n992:         height += extraEach + heightCorrection;\n993: \n994:         // Now sort out the stereotype display. If the stereotype is displayed,\n995:         // move the upper boundary of the name compartment up and set new\n996:         // bounds for the name and the stereotype compatments and the\n997:         // stereoLineBlinder that blanks out the line between the two\n998: \n999:         int currentY = y;\n1000: \n1001:         if (getStereotypeFig().isVisible()) {\n1002:             currentY += STEREOHEIGHT;\n1003:         }\n1004: \n1005:         getNameFig().setBounds(x, currentY, newW, height);\n1006:         getStereotypeFig().setBounds(x, y, newW, STEREOHEIGHT + 1);\n1007:         getFigAt(BLINDER_POSN).setBounds(x + 1, y + STEREOHEIGHT, newW - 2, 2);\n1008: \n1009:         // Advance currentY to where the start of the attribute box is,\n1010:         // remembering that it overlaps the next box by 1 pixel. Calculate the\n1011:         // size of the attribute box, and update the Y pointer past it if it is\n1012:         // displayed.\n1013: \n1014:         currentY += height - 1; // -1 for 1 pixel overlap\n1015: \n1016:         int na = (isAttributesVisible())\n1017:     \t    ? Math.max(1, getAttributesFig().getFigs(null).size() - 1)\n1018:     \t    : 0;\n1019:         int no = (isOperationsVisible())\n1020:     \t    ? Math.max(1, getOperationsFig().getFigs(null).size() - 1)\n1021:     \t    : 0;\n1022:         if (isCheckSize()) {\n1023:             height = ROWHEIGHT * na + 2 + extraEach;\n1024:         } else if (newH > currentY - y && na + no > 0) {\n1025:             height = (newH + y - currentY) * na / (na + no) + 1;\n1026:         } else {\n1027:             height = 1;\n1028:         }\n1029:         aSize = updateFigGroupSize(getAttributesFig(), x, currentY, \n1030:                 newW, height);\n1031: \n1032:         if (getAttributesFig().isVisible()) {\n1033:             currentY += aSize.height - 1; // -1 for 1 pixel overlap\n1034:         }\n1035: \n1036:         // Finally update the bounds of the operations box\n1037: \n1038:         aSize =\n1039: \t    updateFigGroupSize(getOperationsFig(), x, currentY, \n1040:                 newW, newH + y - currentY);\n1041: \n1042:         // set bounds of big box\n1043: \n1044:         getBigPort().setBounds(x, y, newW, newH);\n1045: \n1046:         // Now force calculation of the bounds of the figure, update the edges\n1047:         // and trigger anyone who's listening to see if the \"bounds\" property\n1048:         // has changed.\n1049: \n1050:         calcBounds();\n1051:         updateEdges();\n1052:         firePropChange(\"bounds\", oldBounds, getBounds());\n1053:     }\n1054: \n1055: \n1056: \n1057:     /**\n1058:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n1059:      */\n1060:     public void mouseClicked(MouseEvent me) {\n1061: \n1062:         if (me.isConsumed()) {\n1063:             return;\n1064:         }\n1065:         super.mouseClicked(me);\n1066: \tif (me.isShiftDown()\n1067:                 && TargetManager.getInstance().getTargets().size() > 0) {\n1068: \t    return;\n1069:         }\n1070: \n1071:         int i = 0;\n1072:         Editor ce = Globals.curEditor();\n1073:         Selection sel = ce.getSelectionManager().findSelectionFor(this);\n1074:         if (sel instanceof SelectionClass) {\n1075: \t    ((SelectionClass) sel).hideButtons();\n1076:         }\n1077:         unhighlight();\n1078:         //display attr/op properties if necessary:\n1079:         Rectangle r = new Rectangle(me.getX() - 1, me.getY() - 1, 2, 2);\n1080:         Fig f = hitFig(r);\n1081:         if (f == getAttributesFig() && getAttributesFig().getHeight() > 0) {\n1082:             // TODO: in future version of GEF call getFigs returning array\n1083:             Vector v = new Vector(getAttributesFig().getFigs(null));\n1084:             i = (v.size() - 1) * (me.getY() - f.getY() - 3)\n1085:                 / getAttributesFig().getHeight();\n1086:             if (i >= 0 && i < v.size() - 1) {\n1087:                 f = (Fig) v.elementAt(i + 1);\n1088:                 ((CompartmentFigText) f).setHighlighted(true);\n1089:                 highlightedFigText = (CompartmentFigText) f;\n1090:                 TargetManager.getInstance().setTarget(f);\n1091:             }\n1092:         } else if (f == getOperationsFig() \n1093:                      && getOperationsFig().getHeight() > 0) {\n1094:             // TODO: in future version of GEF call getFigs returning array\n1095:             Vector v = new Vector(getOperationsFig().getFigs(null));\n1096:             i = (v.size() - 1) * (me.getY() - f.getY() - 3)\n1097:                 / getOperationsFig().getHeight();\n1098:             if (i >= 0 && i < v.size() - 1) {\n1099:                 f = (Fig) v.elementAt(i + 1);\n1100:                 ((CompartmentFigText) f).setHighlighted(true);\n1101:                 highlightedFigText = (CompartmentFigText) f;\n1102:                 TargetManager.getInstance().setTarget(f);\n1103:             }\n1104:         }\n1105:     }\n1106: \n1107:     /**\n1108:      * Updates the attributes in the fig. Called from modelchanged if there is\n1109:      * a modelevent effecting the attributes and from renderingChanged in all\n1110:      * cases.\n1111:      */\n1112:     protected void updateAttributes() {\n1113:         Object cls = /*(MClassifier)*/ getOwner();\n1114:         Fig attrPort = ((FigAttributesCompartment) getFigAt(ATTRIBUTES_POSN))\n1115:             .getBigPort();\n1116:         int xpos = attrPort.getX();\n1117:         int ypos = attrPort.getY();\n1118:         int acounter = 1;\n1119:         Collection strs = ModelFacade.getStructuralFeatures(cls);\n1120:         if (strs != null) {\n1121:             Iterator iter = strs.iterator();\n1122:             // TODO: in future version of GEF call getFigs returning array\n1123:             Vector figs = new Vector(getAttributesFig().getFigs(null));\n1124:             CompartmentFigText attr;\n1125:             while (iter.hasNext()) {\n1126:                 Object sf = /*(MStructuralFeature)*/ iter.next();\n1127:                 // update the listeners\n1128: \t\t// UmlModelEventPump.getPump().removeModelEventListener(this,\n1129: \t\t// sf);\n1130:                 UmlModelEventPump.getPump().addModelEventListener(this, sf);\n1131:                 if (figs.size() <= acounter) {\n1132:                     attr =\n1133: \t\t\tnew FigFeature(xpos + 1,\n1134: \t\t\t\t       ypos + 1 + (acounter - 1) * ROWHEIGHT,\n1135: \t\t\t\t       0,\n1136: \t\t\t\t       ROWHEIGHT - 2,\n1137: \t\t\t\t       attrPort);\n1138:                     // bounds not relevant here\n1139:                     attr.setFilled(false);\n1140:                     attr.setLineWidth(0);\n1141:                     attr.setFont(getLabelFont());\n1142:                     attr.setTextColor(Color.black);\n1143:                     attr.setJustification(FigText.JUSTIFY_LEFT);\n1144:                     attr.setMultiLine(false);\n1145:                     getAttributesFig().addFig(attr);\n1146:                 } else {\n1147:                     attr = (CompartmentFigText) figs.elementAt(acounter);\n1148:                 }\n1149:                 attr.setText(Notation.generate(this, sf));\n1150:                 attr.setOwner(sf);\n1151:                 // underline, if static\n1152:                 attr.setUnderline(ModelFacade.CLASSIFIER_SCOPEKIND\n1153: \t\t\t\t  .equals(ModelFacade.getOwnerScope(sf)));\n1154:                 acounter++;\n1155:             }\n1156:             if (figs.size() > acounter) {\n1157:                 //cleanup of unused attribute FigText's\n1158:                 for (int i = figs.size() - 1; i >= acounter; i--) {\n1159:                     getAttributesFig().removeFig((Fig) figs.elementAt(i));\n1160:                 }\n1161:             }\n1162:         }\n1163:         Rectangle rect = getBounds();\n1164:         updateFigGroupSize(getAttributesFig(), xpos, ypos, 0, 0);\n1165:         // ouch ugly but that's for a next refactoring\n1166:         // TODO: make setBounds, calcBounds and updateBounds consistent\n1167:         setBounds(rect.x, rect.y, rect.width, rect.height);\n1168:         damage();\n1169:     }\n1170: \n1171:     /**\n1172:      * Updates the operations box. Called from modelchanged if there is\n1173:      * a modelevent effecting the attributes and from renderingChanged in all\n1174:      * cases.\n1175:      */\n1176:     protected void updateOperations() {\n1177:         Object cls = /*(MClassifier)*/ getOwner();\n1178:         Fig operPort = ((FigOperationsCompartment) getFigAt(OPERATIONS_POSN))\n1179:             .getBigPort();\n1180: \n1181:         int xpos = operPort.getX();\n1182:         int ypos = operPort.getY();\n1183:         int ocounter = 1;\n1184:         Collection behs = ModelFacade.getOperations(cls);\n1185:         if (behs != null) {\n1186:             Iterator iter = behs.iterator();\n1187:             // TODO: in future version of GEF call getFigs returning array\n1188:             Vector figs = new Vector(getOperationsFig().getFigs(null));\n1189:             CompartmentFigText oper;\n1190:             while (iter.hasNext()) {\n1191:                 Object bf = /*(MBehavioralFeature)*/ iter.next();\n1192:                 // update the listeners\n1193: \t\t// UmlModelEventPump.getPump().removeModelEventListener(this,\n1194: \t\t// bf);\n1195:                 UmlModelEventPump.getPump().addModelEventListener(this, bf);\n1196:       