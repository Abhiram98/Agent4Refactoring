hine());\n254:             Model.getStateMachinesHelper().addSubvertex(top, node);\n255:         }\n256: \n257:         fireNodeAdded(node);\n258:     }\n259: \n260:     /**\n261:      * Add the given edge to the graph, if valid.\n262:      *\n263:      * @see org.tigris.gef.graph.MutableGraphModel#addEdge(java.lang.Object)\n264:      */\n265:     public void addEdge(Object edge) {\n266:         LOG.debug(\"adding statechart/activity diagram edge!!!!!!\");\n267: \n268:         if (!canAddEdge(edge)) {\n269:             return;\n270:         }\n271:         getEdges().add(edge);\n272:         fireEdgeAdded(edge);\n273:     }\n274: \n275:     /**\n276:      * @see org.tigris.gef.graph.MutableGraphModel#addNodeRelatedEdges(java.lang.Object)\n277:      */\n278:     public void addNodeRelatedEdges(Object node) {\n279:         super.addNodeRelatedEdges(node);\n280: \n281:         if (Model.getFacade().isAStateVertex(node)) {\n282:             Collection transen = new ArrayList(Model.getFacade().getOutgoings(node));\n283:             transen.addAll(Model.getFacade().getIncomings(node));\n284:             Iterator iter = transen.iterator();\n285:             while (iter.hasNext()) {\n286:                 Object dep = /* (MTransition) */iter.next();\n287:                 if (canAddEdge(dep)) {\n288:                     addEdge(dep);\n289:                 }\n290:             }\n291:         }\n292:     }\n293: \n294:     /**\n295:      * Return true if the two given ports can be connected by a kind of edge to\n296:      * be determined by the ports.\n297:      *\n298:      * @see org.tigris.gef.graph.MutableGraphModel#canConnect(java.lang.Object,\n299:      * java.lang.Object)\n300:      */\n301:     public boolean canConnect(Object fromPort, Object toPort) {\n302:         if (!(Model.getFacade().isAStateVertex(fromPort))) {\n303:             LOG.error(\"internal error not from sv\");\n304:             return false;\n305:         }\n306:         if (!(Model.getFacade().isAStateVertex(toPort))) {\n307:             LOG.error(\"internal error not to sv\");\n308:             return false;\n309:         }\n310: \n311:         if (Model.getFacade().isAFinalState(fromPort)) {\n312:             return false;\n313:         }\n314:         if (Model.getFacade().isAPseudostate(toPort)) {\n315:             if ((Model.getPseudostateKind().getInitial()).equals(\n316:                     Model.getFacade().getKind(toPort))) {\n317:                 return false;\n318:             }\n319:         }\n320:         return true;\n321:     }\n322: \n323:     /**\n324:      * Contruct and add a new edge of the given kind.\n325:      *\n326:      * @see org.tigris.gef.graph.MutableGraphModel#connect(java.lang.Object,\n327:      * java.lang.Object, java.lang.Class)\n328:      */\n329:     public Object connect(Object fromPort, Object toPort,\n330: \t\t\t  Object edgeClass) {\n331: \n332:         if (Model.getFacade().isAFinalState(fromPort)) {\n333: \t    return null;\n334: \t}\n335: \n336:         if (Model.getFacade().isAPseudostate(toPort)\n337:                 && Model.getPseudostateKind().getInitial().equals(\n338: \t\t\tModel.getFacade().getKind(toPort))) {\n339:             return null;\n340: \t}\n341: \n342:         if (Model.getMetaTypes().getTransition().equals(edgeClass)) {\n343:             Object tr = null;\n344:             tr =\n345:                 Model.getStateMachinesFactory()\n346:                     .buildTransition(fromPort, toPort);\n347:             if (canAddEdge(tr)) {\n348:                 addEdge(tr);\n349:             } else {\n350:                 ProjectManager.getManager().getCurrentProject().moveToTrash(tr);\n351:                 tr = null;\n352:             }\n353:             return tr;\n354:         } else if (edgeClass == CommentEdge.class) {\n355:             try {\n356:                 Object connection =\n357:                     buildConnection(\n358:                             edgeClass, fromPort, null, toPort, null, null,\n359:                             ProjectManager.getManager().getCurrentProject()\n360:                             .getModel());\n361:                 addEdge(connection);\n362:                 return connection;\n363:             } catch (Exception ex) {\n364:                 // fail silently\n365:             }\n366:             return null;\n367:         } else {\n368:             LOG.debug(\"wrong kind of edge in StateDiagram connect3 \"\n369:                     + edgeClass);\n370:             return null;\n371:         }\n372:     }\n373: \n374:     ////////////////////////////////////////////////////////////////\n375:     // VetoableChangeListener implementation\n376: \n377:     /**\n378:      * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n379:      */\n380:     public void vetoableChange(PropertyChangeEvent pce) {\n381:         //throws PropertyVetoException\n382: \n383:         if (\"ownedElement\".equals(pce.getPropertyName())) {\n384:             Collection oldOwned = (Collection) pce.getOldValue();\n385:             Object eo = /* (MElementImport) */pce.getNewValue();\n386:             Object me = Model.getFacade().getModelElement(eo);\n387:             if (oldOwned.contains(eo)) {\n388:                 LOG.debug(\"model removed \" + me);\n389:                 if (Model.getFacade().isAState(me)) {\n390:                     removeNode(me);\n391:                 }\n392:                 if (Model.getFacade().isAPseudostate(me)) {\n393:                     removeNode(me);\n394:                 }\n395:                 if (Model.getFacade().isATransition(me)) {\n396:                     removeEdge(me);\n397:                 }\n398:             } else {\n399:                 LOG.debug(\"model added \" + me);\n400:             }\n401:         }\n402:     }\n403: \n404:     /**\n405:      * The UID.\n406:      */\n407:     static final long serialVersionUID = -8056507319026044174L;\n408: \n409:     /**\n410:      * @param newNode\n411:      *            this is the new node that one of the ends is dragged to.\n412:      * @param oldNode\n413:      *            this is the existing node that is already connected.\n414:      * @param edge\n415:      *            this is the edge that is being dragged/rerouted\n416:      * @return true if a transition is being rerouted between two states.\n417:      */\n418:     public boolean canChangeConnectedNode(Object newNode, Object oldNode,\n419:             Object edge) {\n420:         // prevent no changes...\n421:         if (newNode == oldNode) {\n422:             return false;\n423:         }\n424: \n425:         // check parameter types:\n426:         if (!(Model.getFacade().isAState(newNode)\n427: \t      || Model.getFacade().isAState(oldNode)\n428: \t      || Model.getFacade().isATransition(edge))) {\n429: \t    return false;\n430: \t}\n431: \n432:         // it's not allowed to move a transition\n433:         // so that it will go from a composite to its substate\n434:         // nor vice versa. See issue 2865.\n435:         Object otherSideNode = Model.getFacade().getSource(edge);\n436:         if (otherSideNode == oldNode) {\n437:             otherSideNode = Model.getFacade().getTarget(edge);\n438:         }\n439:         if (Model.getFacade().isACompositeState(newNode)\n440:                 && Model.getStateMachinesHelper().getAllSubStates(newNode)\n441:                                                     .contains(otherSideNode)) {\n442:             return false;\n443:         }\n444: \n445:         return true;\n446:     }\n447: \n448:     /**\n449:      * Reroutes the connection to the old node to be connected to the new node.\n450:      *\n451:      * @param newNode\n452:      *            this is the new node that one of the ends is dragged to.\n453:      * @param oldNode\n454:      *            this is the existing node that is already connected.\n455:      * @param edge\n456:      *            this is the edge that is being dragged/rerouted\n457:      * @param isSource\n458:      *            tells us which end is being rerouted.\n459:      */\n460:     public void changeConnectedNode(Object newNode, Object oldNode,\n461:             Object edge, boolean isSource) {\n462: \n463:         if (isSource) {\n464:             Model.getStateMachinesHelper().setSource(edge, newNode);\n465:         } else {\n466:             Model.getCommonBehaviorHelper().setTarget(edge, newNode);\n467:         }\n468: \n469:     }\n470: \n471:     /**\n472:      * @see org.argouml.uml.diagram.UMLMutableGraphSupport#isRemoveFromDiagramAllowed(Collection)\n473:      */\n474:     public boolean isRemoveFromDiagramAllowed(Collection figs) {\n475:         /* If nothing is selected, then not allowed to remove it. */\n476:         if (figs.isEmpty()) {\n477:             return false;\n478:         }\n479:         Iterator i = figs.iterator();\n480:         while (i.hasNext()) {\n481:             Object obj = i.next();\n482:             if (!(obj instanceof Fig)) {\n483:                 return false;\n484:             }\n485:             Object uml = ((Fig) obj).getOwner();\n486:             /* If a UML object is found, you can not remove selected elms. */\n487:             if (uml != null) {\n488:                 return false;\n489:             }\n490:         }\n491:         /* If only Figs without owner are selected, then you can remove them! */\n492:         return true;\n493:     }\n494: \n495: \n496: } /* end class StateDiagramGraphModel */\n497: ",
