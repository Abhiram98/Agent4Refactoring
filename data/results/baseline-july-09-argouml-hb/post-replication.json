              \"createObjectFlowState\"));\n423:         elements.put(Uml.SUBACTIVITY_STATE,\n424:                 new ObjectCreateInfo(\n425:                     MSubactivityState.class,\n426:                     factory,\n427:                     \"createSubactivityState\"));\n428:         elements.put(Uml.USE_CASE,\n429:             new ObjectCreateInfo(MUseCase.class, factory, \"createUseCase\"));\n430:         elements.put(Uml.ACTION,\n431:             new ObjectCreateInfo(MAction.class, factory, \"createAction\"));\n432:         elements.put(Uml.ASSOCIATION_END,\n433:             new ObjectCreateInfo(\n434:                 MAssociationEnd.class,\n435:                 factory,\n436:                 \"createAssociationEnd\"));\n437:         elements.put(Uml.CALL_ACTION,\n438:             new ObjectCreateInfo(\n439:                 MCallAction.class,\n440:                 factory,\n441:                 \"createCallAction\"));\n442:         elements.put(Uml.NAMESPACE,\n443:             new ObjectCreateInfo(MNamespace.class, factory, \"createNamespace\"));\n444:         elements.put(Uml.RECEPTION,\n445:             new ObjectCreateInfo(MReception.class, factory, \"createReception\"));\n446:         elements.put(Uml.STEREOTYPE,\n447:             new ObjectCreateInfo(\n448:                 MStereotype.class,\n449:                 factory,\n450:                 \"createStereotype\"));\n451:         elements.put(Uml.ATTRIBUTE,\n452:             new ObjectCreateInfo(MAttribute.class, factory, \"createAttribute\"));\n453:         elements.put(Uml.OPERATION,\n454:             new ObjectCreateInfo(MOperation.class, factory, \"createOperation\"));\n455:         elements.put(Uml.MODEL,\n456:             new ObjectCreateInfo(MModel.class, factory, \"createModel\"));\n457:         elements.put(Uml.DATATYPE,\n458:             new ObjectCreateInfo(MDataType.class, factory, \"createDataType\"));\n459: \n460:         // NSUML does not have a factory method for this\n461:         elements.put(Uml.ACTION_EXPRESSION,\n462:             new ObjectCreateInfo(\n463:                 MActionExpression.class,\n464:                 this,\n465:                 \"createActionExpression\"));\n466: \n467:         // NSUML cannot instantiate an Event object\n468:         // elements.put(Uml.EVENT,\n469:         //     new NsumlObjectInfo(factory,MEvent.class, \"createEvent\"));\n470: \n471:         // NSUML cannot instantiate a State Vertex object\n472:         // elements.put(Uml.STATE_VERTEX,\n473:         //     new NsumlObjectInfo(factory, MStateVertex.class,\n474:         //         \"createStateVertex\"));\n475:     }\n476: \n477:     /**\n478:      * @return boolean to indicate if the JMI Reflective Proxy\n479:      * over NSUML is created.\n480:      */\n481:     public boolean isJmiProxyCreated() {\n482:         return jmiProxyCreated;\n483:     }\n484: \n485:     /**\n486:      * @param arg true to cause the JMI Reflective proxy over NSUML to be used.\n487:      */\n488:     public void setJmiProxyCreated(boolean arg) {\n489:         jmiProxyCreated = arg;\n490:     }\n491:     \n492:     /**\n493:      * Create a new connection model element (a relationship or link)\n494:      * between any existing node model elements.\n495:      * \n496:      * @return the newly created connection element\n497:      * @param connectionType is the type of relationship\n498:      * @param fromElement is an existing model element\n499:      * @param toElement is another existing model element\n500:      * @throws IllegalModelElementConnectionException \n501:      */\n502:     public Object buildConnection(Object connectionType, \n503: \t\t\t\t  Object fromElement, Object toElement)\n504:         throws IllegalModelElementConnectionException {\n505: \n506:         return buildConnection(connectionType,\n507: \t\t\t       fromElement, null, toElement, null, null);\n508: \n509:     }\n510:     \n511:     /**\n512:      * @param connectionType\n513:      * @param fromElement\n514:      * @param fromStyle\n515:      * @param toElement\n516:      * @param toStyle\n517:      * @param unidirectional\n518:      * @return\n519:      * @throws IllegalModelElementConnectionException\n520:      */\n521:     public Object buildConnection(Object connectionType,\n522:                   Object fromElement, Object fromStyle,\n523:                   Object toElement, Object toStyle,\n524:                   Object unidirectional)\n525:         throws IllegalModelElementConnectionException\n526:     {\n527: \n528:         if (!isConnectionValid(connectionType, fromElement, toElement)) {\n529:             throw new IllegalModelElementConnectionException(\n530:                 \"Cannot make a \"\n531:             + connectionType.getClass().getName() \n532:             + \" between a \" + fromElement.getClass().getName() \n533:             + \" and a \" + toElement.getClass().getName());\n534:         }\n535:         \n536:         Object connection = null;\n537:         \n538:         if (connectionType == ModelFacade.ASSOCIATION) {\n539:             connection = getCore().buildAssociation((MClassifier) fromElement, \n540:                        (MAggregationKind) fromStyle, \n541:                        (MClassifier) toElement, \n542:                        (MAggregationKind) toStyle, \n543:                        (Boolean) unidirectional);\n544:         } else if (connectionType == ModelFacade.ASSOCIATION_ROLE) {\n545:             connection = getCollaborations()\n546:                 .buildAssociationRole((MClassifierRole) fromElement, \n547:                       (MAggregationKind) fromStyle, \n548:                       (MClassifierRole) toElement,\n549:                       (MAggregationKind) toStyle, \n550:                       (Boolean) unidirectional);\n551:         } else if (connectionType == ModelFacade.GENERALIZATION) {\n552:             connection = getCore()\n553:                 .buildGeneralization(fromElement, toElement);\n554:         } else if (connectionType == ModelFacade.PERMISSION) {\n555:             connection = getCore().buildPermission(fromElement, toElement);\n556:         } else if (connectionType == ModelFacade.USAGE) {\n557:             connection = getCore().buildUsage((MModelElement) fromElement,\n558:                      (MModelElement) toElement);\n559:         } else if (connectionType == ModelFacade.GENERALIZATION) {\n560:             connection = getCore()\n561:                 .buildGeneralization(fromElement, toElement);\n562:         } else if (connectionType == ModelFacade.DEPENDENCY) {\n563:             connection = getCore().buildDependency(fromElement, toElement);\n564:         } else if (connectionType == ModelFacade.ABSTRACTION) {\n565:             connection = getCore().buildRealization((MModelElement) fromElement,\n566:                 (MModelElement) toElement);\n567:         } else if (connectionType == ModelFacade.LINK) {\n568:             connection = getCommonBehavior().buildLink(fromElement, toElement);\n569:         } else if (connectionType == ModelFacade.EXTEND) {\n570:             // Extend, but only between two use cases. Remember we draw from the\n571:             // extension port to the base port.\n572:             connection = getUseCases().buildExtend(toElement, fromElement);\n573:         } else if (connectionType == ModelFacade.INCLUDE) {\n574:             connection = getUseCases().buildInclude(fromElement, toElement);\n575:         } else if (connectionType == CommentEdge.class) {\n576:             connection = \n577:                 getCore().buildCommentConnection(fromElement, toElement);\n578:         }\n579:     \n580:         if (connection == null) {\n581:             throw new IllegalModelElementConnectionException(\n582:             \"Cannot make a \" \n583:             + connectionType.getClass().getName() \n584:             + \" between a \" + fromElement.getClass().getName() \n585:             + \" and a \" + toElement.getClass().getName());\n586:         }\n587:         \n588:         return connection;\n589:     }\n590:     \n591:     /**\n592:      * Checks if some type of connection is valid between two elements\n593:      * @param connectionType\n594:      * @param fromElement\n595:      * @param toElement\n596:      * @return\n597:      */\n598:     public boolean isConnectionValid(Object connectionType,\n599:                      Object fromElement, Object toElement)\n600:     {\n601:         // Get the list of valid model item pairs for the given connection type\n602:         ArrayList validItems =\n603:             (ArrayList) pvalidConnectionMap.get(connectionType);\n604:         if (validItems == null) {\n605:             return false;\n606:         }\n607:         // See if there's a pair in this list that match the given\n608:         // model elements\n609:         Iterator it = validItems.iterator();\n610:         while (it.hasNext()) {\n611:             Class[] modeElementPair = (Class[]) it.next();\n612:             if (modeElementPair[0].isInstance(fromElement)\n613:                 && modeElementPair[1].isInstance(toElement)) \n614:             {\n615:                 return true;\n616:             }\n617:         }\n618:         return false;\n619:     }\n620:     \n621:     /** Returns the package factory for the UML\n622:      *  package Foundation::ExtensionMechanisms.\n623:      *\n624:      *  @return the ExtensionMechanisms factory instance.\n625:      */\n626:     public ExtensionMechanismsFactory getExtensionMechanisms() {\n627:         return ExtensionMechanismsFactory.getFactory();\n628:     }\n629: \n630:     /** Returns the package factory for the UML\n631:      *  package Foundation::DataTypes.\n632:      *\n633:      *  @return the DataTypes factory instance.\n634:      */\n635:     public DataTypesFactory getDataTypes() {\n636:         return DataTypesFactory.getFactory();\n637:     }\n638: \n639:     /** Returns the package factory for the UML\n640:      *  package Foundation::Core.\n641:      *\n642:      *  @return the Core factory instance.\n643:      */\n644:     public CoreFactory getCore() {\n645:         return CoreFactory.getFactory();\n646:     }\n647: \n648:     /** Returns the package factory for the UML\n649:      *  package BehavioralElements::CommonBehavior.\n650:      *\n651:      *  @return the CommonBehavior factory instance.\n652:      */\n653:     public CommonBehaviorFactory getCommonBehavior() {\n654:         return CommonBehaviorFactory.getFactory();\n655:     }\n656: \n657:     /** Returns the package factory for the UML\n658:      *  package BehavioralElements::UseCases.\n659:      *\n660:      *  @return the UseCases factory instance.\n661:      */\n662:     public UseCasesFactory getUseCases() {\n663:         return UseCasesFactory.getFactory();\n664:     }\n665: \n666:     /** Returns the package factory for the UML\n667:      *  package BehavioralElements::StateMachines.\n668:      *\n669:      *  @return the StateMachines factory instance.\n670:      */\n671:     public StateMachinesFactory getStateMachines() {\n672:         return StateMachinesFactory.getFactory();\n673:     }\n674: \n675:     /** Returns the package factory for the UML\n676:      *  package BehavioralElements::Collaborations.\n677:      *\n678:      *  @return the Collaborations factory instance.\n679:      */\n680:     public CollaborationsFactory getCollaborations() {\n681:         return CollaborationsFactory.getFactory();\n682:     }\n683: \n684:     /** Returns the package factory for the UML\n685:      *  package BehavioralElements::ActivityGraphs.\n686:      *\n687:      *  @return the ActivityGraphs factory instance.\n688:      */\n689:     public ActivityGraphsFactory getActivityGraphs() {\n690:         return ActivityGraphsFactory.getFactory();\n691:     }\n692: \n693:     /** Returns the package factory for the UML\n694:      *  package ModelManagement.\n695:      *\n696:      *  @return the ModelManagement factory instance.\n697:      */\n698:     public ModelManagementFactory getModelManagement() {\n699:         return ModelManagementFactory.getFactory();\n700:     }\n701: \n702:     /**\n703:      * Deletes a modelelement. It calls the remove method of the\n704:      * modelelement but also does 'cascading deletes' that are not\n705:      * provided for in the remove method of the modelelement\n706:      * itself. For example: this delete method also removes the binary\n707:      * associations that a class has if the class is deleted. In this\n708:      * way, it is not longer possible that illegal states exist in the\n709:      * model.<p>\n710:      *\n711:      * The actual deletion is delegated to delete methods in the rest of the\n712:      * factories. For example: a method deleteClass exists on CoreHelper.\n713:      * Delete methods as deleteClass should only do those extra actions that are\n714:      * necessary for the deletion of the modelelement itself. I.e. deleteClass\n715:      * should only take care of things specific to MClass.<p>\n716:      *\n717:      * The delete methods in the UML Factories should not be called directly\n718:      * throughout the code! Calls should allways refer to this method and never\n719:      * call the deleteXXX method on XXXFactory directly. The reason that it is\n720:      * possible to call the deleteXXX methods directly is a pure implementation\n721:      * detail.<p>\n722:      *\n723:      * The implementation of this method uses a quite complicate if then else\n724:      * tree. This is done to provide optimal performance and full compliance to\n725:      * the UML 1.3 model. The last remark refers to the fact that the UML 1.3\n726:      * model knows multiple inheritance in several places. This has to be taken\n727:      * into account.<p>\n728:      * \n729:      * Extensions and its children are not taken into account\n730:      * here. They do not require extra cleanup actions. Not in the\n731:      * form of a call to the remove method as is normal for all\n732:      * children of MBase and not in the form of other behaviour we\n733:      * want to implement via this operation.\n734:      * @param elem The element to be deleted\n735:      */\n736:     public void delete(Object elem) {\n737:         if (elem == null)\n738:             throw new IllegalArgumentException(\"Element may not be null \"\n739:                 + \"in delete\");        \n740:         if (elem instanceof MElement) {\n741:             getCore().deleteElement((MElement) elem);\n742:             if (elem instanceof MModelElement) {\n743:                 getCore().deleteModelElement((MModelElement) elem);\n744:                 if (elem instanceof MFeature) {\n745:                     deleteFeature((MFeature) elem);\n746:                 } else if (elem instanceof MNamespace) {\n747:                     deleteNamespace((MNamespace) elem);\n748:                 } \n749:         // no else here to make sure MClassifier with\n750:         // its double inheritance goes ok\n751:                 // no else here too to make sure MAssociationClass goes ok\n752:         \n753:                 if (elem instanceof MGeneralizableElement) {\n754:                     MGeneralizableElement ge = (MGeneralizableElement) elem;\n755:                     getCore().deleteGeneralizableElement(ge);\n756:                     if (elem instanceof MStereotype) {\n757:                         MStereotype s = (MStereotype) elem;\n758:                         getExtensionMechanisms().deleteStereotype(s);\n759:                     }\n760:                 } // no else here to make sure MAssociationClass goes ok\n761:         \n762:                 if (elem instanceof MParameter) {\n763:                     getCore().deleteParameter((MParameter) elem);\n764:                 } else if (elem instanceof MConstraint) {\n765:                     getCore().deleteConstraint((MConstraint) elem);\n766:                 } else if (elem instanceof MRelationship) {\n767:                     deleteRelationship((MRelationship) elem);\n768:                 } else if (elem instanceof MAssociationEnd) {\n769:                     getCore().deleteAssociationEnd((MAssociationEnd) elem);\n770:                     if (elem instanceof MAssociationEndRole) {\n771:                         getCollaborations()\n772:                             .deleteAssociationEndRole(\n773:                                  (MAssociationEndRole) elem);\n774:                     }\n775:                 } else if (elem instanceof MComment) {\n776:                     getCore().deleteComment((MComment) elem);\n777:                 } else if (ModelFacade.isAAction(elem)) {\n778:                     deleteAction(elem);\n779:                 } else if (elem instanceof MAttributeLink) {\n780:                     getCommonBehavior()\n781:                         .deleteAttributeLink((MAttributeLink) elem);\n782:                 } else if (elem instanceof MInstance) {\n783:                     deleteInstance((MInstance) elem);\n784:                 } // no else to handle multiple inheritance of linkobject\n785: \n786:                 if (elem instanceof MLink) {\n787:                     getCommonBehavior().deleteLink((MLink) elem);\n788:                 } else if (elem instanceof MLinkEnd) {\n789:                     getCommonBehavior().deleteLinkEnd((MLinkEnd) elem);\n790:                 } else if (elem instanceof MInteraction) {\n791:                     getCollaborations().deleteInteraction((MInteraction) elem);\n792:                 } else if (elem instanceof MMessage) {\n793:                     getCollaborations().deleteMessage((MMessage) elem);\n794:                 } else if (elem instanceof MExtensionPoint) {\n795:                     getUseCases().deleteExtensionPoint((MExtensionPoint) elem);\n796:                 } else if (elem instanceof MStateVertex) {\n797:                     deleteStateVertex((MStateVertex) elem);\n798:                 }\n799: \n800:                 if (elem instanceof MStateMachine) {\n801:                     getStateMachines().deleteStateMachine((MStateMachine) elem);\n802:                     if (elem instanceof MActivityGraph) {\n803:                         getActivityGraphs()\n804:                             .deleteActivityGraph((MActivityGraph) elem);\n805:                     }\n806:                 } else if (elem instanceof MTransition) {\n807:                     getStateMachines().deleteTransition((MTransition) elem);\n808:                 } else if (elem instanceof MGuard) {\n809:                     getStateMachines().deleteGuard((MGuard) elem);\n810:                 }\n811:         // else if (elem instanceof MEvent) {\n812:         //\n813:         //}\n814:             } else if (elem instanceof MPresentationElement) {\n815:                 getCore().deletePresentationElement(\n816:                     (MPresentationElement) elem);\n817:             }\n818:         } else if (elem instanceof MTemplateParameter) {\n819:             getCore().deleteTemplateParameter((MTemplateParameter) elem);\n820:         } else if (elem instanceof MTaggedValue) {\n821:             getExtensionMechanisms().deleteTaggedValue((MTaggedValue) elem);\n822:         }\n823: \n824:         if (elem instanceof MPartition) {\n825:             getActivityGraphs().deletePartition((MPartition) elem);\n826:         } else if (elem instanceof MElementImport) {\n827:             getModelManagement().deleteElementImport((MElementImport) elem);\n828:         }\n829: \n830:         if (elem instanceof MBase) {\n831:             ((MBase) elem).remove();\n832:             UmlModelEventPump.getPump().cleanUp((MBase) elem);\n833:         }        \n834:     }\n835: \n836:     /**\n837:      * Factored this method out of delete to simplify the design of the delete\n838:      * operation\n839:      * @param elem\n840:      */\n841:     private void deleteFeature(MFeature elem) {\n842:         getCore().deleteFeature(elem);\n843:         if (elem instanceof MBehavioralFeature) {\n844:             getCore().deleteBehavioralFeature((MBehavioralFeature) elem);\n845:             if (elem instanceof MOperation) {\n846:                 getCore().deleteOperation((MOperation) elem);\n847:             } else if (elem instanceof MMethod) {\n848:                 getCore().deleteMethod((MMethod) elem);\n849:             } else if (elem instanceof MReception) {\n850:                 getCommonBehavior().deleteReception((MReception) elem);\n851:             }\n852:         } else if (elem instanceof MStructuralFeature) {\n853:             getCore().deleteStructuralFeature((MStructuralFeature) elem);\n854:             if (elem instanceof MAttribute) {\n855:                 getCore().deleteAttribute((MAttribute) elem);\n856:             }\n857:         }\n858:     }\n859: \n860:     /**\n861:      * Factored this method out of delete to simplify the design of the delete\n862:      * operation\n863:      * @param elem\n864:      */\n865:     private void deleteNamespace(MNamespace elem) {\n866:         getCore().deleteNamespace(elem);\n867:         if (elem instanceof MClassifier) {\n868:             getCore().deleteClassifier(elem);\n869:             if (elem instanceof MClass) {\n870:                 getCore().deleteClass((MClass) elem);\n871:                 if (elem instanceof MAssociationClass) {\n872:                     getCore().deleteAssociationClass((MAssociationClass) elem);\n873:                 }\n874:             } else if (elem instanceof MInterface) {\n875:                 getCore().deleteInterface((MInterface) elem);\n876:             } else if (elem instanceof MDataType) {\n877:                 getCore().deleteDataType((MDataType) elem);\n878:             } else if (elem instanceof MNode) {\n879:                 getCore().deleteNode((MNode) elem);\n880:             } else if (elem instanceof MComponent) {\n881:                 getCore().deleteCompon