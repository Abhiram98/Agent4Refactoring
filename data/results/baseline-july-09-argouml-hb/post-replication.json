node);\n91:     if (node instanceof MClassifier && (((MClassifier)node).getName() != null))\n92: \t_name.setText(((MModelElement)node).getName());\n93: //     _name.setText(placeString());\n94:     updateBounds();\n95:   }\n96: \n97:   public String placeString() {\n98:     return \"new Component\";\n99:   }\n100: \n101:   public Object clone() {\n102:     FigComponent figClone = (FigComponent) super.clone();\n103:     Vector v = figClone.getFigs();\n104:     figClone._bigPort = (FigRect) v.elementAt(0);\n105:     figClone._cover = (FigRect) v.elementAt(1);\n106:     figClone._stereo = (FigText) v.elementAt(2);\n107:     figClone._name = (FigText) v.elementAt(3);\n108:     figClone._upperRect = (FigRect) v.elementAt(4);\n109:     figClone._lowerRect = (FigRect) v.elementAt(5);\n110: \n111:     return figClone;\n112:   }\n113: \n114:   ////////////////////////////////////////////////////////////////\n115:   // acessors\n116: \n117:   public void setUnderline(boolean b) {\n118:     _name.setUnderline(b);\n119:   }\n120: \n121:   public void setLineColor(Color c) {\n122:      //super.setLineColor(c);\n123:      _cover.setLineColor(c);\n124:      _stereo.setFilled(false);\n125:      _stereo.setLineWidth(0);\n126:      _name.setFilled(false);\n127:      _name.setLineWidth(0);\n128:      _upperRect.setLineColor(c);\n129:      _lowerRect.setLineColor(c);\n130:   }\n131: \n132: \n133:   public Selection makeSelection() {\n134:       return new SelectionComponent(this);\n135:   }\n136: \n137:   public Dimension getMinimumSize() {\n138:     Dimension stereoDim = _stereo.getMinimumSize();\n139:     Dimension nameDim = _name.getMinimumSize();\n140: \n141:     int h = stereoDim.height + nameDim.height - OVERLAP;\n142:     int w = Math.max(stereoDim.width, nameDim.width) + BIGPORT_X;\n143: \n144:     return new Dimension(w, h);\n145:   }\n146: \n147:   public void setBounds(int x, int y, int w, int h) {\n148: \n149:     Rectangle oldBounds = getBounds();\n150:     _bigPort.setBounds(x + BIGPORT_X, y, w - BIGPORT_X, h);\n151:     _cover.setBounds(x + BIGPORT_X, y, w - BIGPORT_X, h);\n152: \n153:     Dimension stereoDim = _stereo.getMinimumSize();\n154:     Dimension nameDim = _name.getMinimumSize();\n155:     if (h<50) {\n156:       _upperRect.setBounds(x, y+h/6, 20, 10);\n157:       _lowerRect.setBounds(x, y+3*h/6, 20, 10);\n158:     }\n159:     else {\n160:       _upperRect.setBounds(x, y+13, 20, 10);\n161:       _lowerRect.setBounds(x, y+39, 20, 10);\n162:     }\n163: \n164:     _stereo.setBounds(x+BIGPORT_X+1, y+1, w-BIGPORT_X-2, stereoDim.height);\n165:     _name.setBounds(x+BIGPORT_X+1, y + stereoDim.height - OVERLAP + 1, w-BIGPORT_X-2,\n166:     \t\t nameDim.height);\n167:     _x = x; _y = y; _w = w; _h = h;\n168:     firePropChange(\"bounds\", oldBounds, getBounds());\n169:     updateEdges();\n170:   }\n171: \n172: \n173:   ////////////////////////////////////////////////////////////////\n174:   // user interaction methods\n175: \n176:   public void mouseClicked(MouseEvent me) {\n177:     super.mouseClicked(me);\n178:     setLineColor(Color.black);\n179:   }\n180: \n181:   public void mousePressed(MouseEvent me) {\n182:     super.mousePressed(me);\n183:     Editor ce = Globals.curEditor();\n184:     Selection sel = ce.getSelectionManager().findSelectionFor(this);\n185:     if (sel instanceof SelectionComponent) {\n186:       ((SelectionComponent) sel).hideButtons();\n187:     }\n188:   }\n189: \n190: \n191:   public void setEnclosingFig(Fig encloser) {\n192:     \n193:     if (encloser != null && encloser.getOwner() instanceof MNode && getOwner() != null) {\n194:         MNode node = (MNode)encloser.getOwner();\n195:         MComponent comp = (MComponent)getOwner();\n196:         if (!comp.getDeploymentLocations().contains(node)) {\n197:             comp.addDeploymentLocation(node);\n198:         }\n199:         super.setEnclosingFig(encloser);\n200:         \n201: \n202:         Vector figures = getEnclosedFigs();\n203:     \n204:  