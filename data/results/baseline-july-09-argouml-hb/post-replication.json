                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/persistence/ZargoFilePersister.java: \n1: // $Id$\n2: // Copyright (c) 1996-2004 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: package org.argouml.persistence;\n25: \n26: import java.io.BufferedWriter;\n27: import java.io.File;\n28: import java.io.FileOutputStream;\n29: import java.io.IOException;\n30: import java.io.OutputStreamWriter;\n31: import java.net.URL;\n32: import java.util.ArrayList;\n33: import java.util.Collection;\n34: import java.util.HashMap;\n35: import java.util.Hashtable;\n36: import java.util.zip.ZipEntry;\n37: import java.util.zip.ZipInputStream;\n38: import java.util.zip.ZipOutputStream;\n39: \n40: import javax.xml.parsers.ParserConfigurationException;\n41: \n42: import org.apache.log4j.Logger;\n43: import org.argouml.application.ArgoVersion;\n44: import org.argouml.kernel.Project;\n45: import org.argouml.kernel.ProjectMember;\n46: import org.argouml.model.uml.UmlHelper;\n47: import org.argouml.model.uml.XmiReader;\n48: import org.argouml.ui.ArgoDiagram;\n49: import org.argouml.uml.cognitive.ProjectMemberTodoList;\n50: import org.argouml.util.FileConstants;\n51: import org.argouml.util.SubInputStream;\n52: import org.tigris.gef.ocl.OCLExpander;\n53: import org.tigris.gef.ocl.TemplateReader;\n54: import org.xml.sax.InputSource;\n55: import org.xml.sax.SAXException;\n56: \n57: /**\n58:  * To persist to and from zargo (zipped file) storage.\n59:  * \n60:  * @author Bob Tarling\n61:  */\n62: public class ZargoFilePersister extends AbstractFilePersister {\n63:     \n64:     private static final Logger LOG = \n65:         Logger.getLogger(ZargoFilePersister.class);\n66:     \n67:     /**\n68:      * This is the old version of the ArgoUML tee file which\n69:      * does not contain the detail of member elements.\n70:      */\n71:     private static final String ARGO_MINI_TEE =\n72:         \"/org/argouml/persistence/argo.tee\";\n73:     \n74:     /**\n75:      * The constructor.\n76:      */\n77:     public ZargoFilePersister() {\n78:     }\n79: \n80:     /**\n81:      * @see org.argouml.persistence.AbstractFilePersister#getExtension()\n82:      */\n83:     public String getExtension() {\n84:         return \"zargo\";\n85:     }\n86:     \n87:     /**\n88:      * @see org.argouml.persistence.AbstractFilePersister#getDesc()\n89:      */\n90:     protected String getDesc() {\n91:         return \"ArgoUML compressed project file\";\n92:     }\n93:     \n94:     /**\n95:      * It is being considered to save out individual\n96:      * xmi's from individuals diagrams to make\n97:      * it easier to modularize the output of Argo.\n98:      * \n99:      * @param file The file to write.\n100:      * @param project the project to save\n101:      * @throws SaveException when anything goes wrong\n102:      *\n103:      * @see org.argouml.persistence.ProjectFilePersister#save(\n104:      * org.argouml.kernel.Project, java.io.File)\n105:      */\n106:     public void doSave(Project project, File file)\n107:         throws SaveException {\n108:         \n109:         // frank: first backup the existing file to name+\"#\"\n110:         File tempFile = new File( file.getAbsolutePath() + \"#\");\n111:         File backupFile = new File( file.getAbsolutePath() + \"~\");\n112:         if (tempFile.exists()) {\n113:             tempFile.delete();\n114:         }\n115:         \n116:         BufferedWriter writer = null;\n117:         try {\n118:             if (file.exists()) {\n119:                 copyFile(tempFile, file);\n120:             }\n121:             // frank end\n122:     \n123:             project.setFile(file);\n124:             project.setVersion(ArgoVersion.getVersion());\n125:             project.setPersistenceVersion(PERSISTENCE_VERSION);\n126: \n127:             ZipOutputStream stream =\n128:                 new ZipOutputStream(new FileOutputStream(file));\n129:             writer =\n130:                 new BufferedWriter(new OutputStreamWriter(stream, \"UTF-8\"));\n131:     \n132:             ZipEntry zipEntry =\n133:                 new ZipEntry(project.getBaseName() \n134:                         + FileConstants.UNCOMPRESSED_FILE_EXT);\n135:             stream.putNextEntry(zipEntry);\n136:             \n137:             Hashtable templates = TemplateReader.getInstance()\n138:                 .read(ARGO_MINI_TEE);\n139:             OCLExpander expander = new OCLExpander(templates);\n140:             expander.expand(writer, project, \"\", \"\");\n141:                 \n142:             writer.flush();\n143:             \n144:             stream.closeEntry();\n145:     \n146:             // First we save all objects that are not XMI objects i.e. the\n147:             // diagrams (first for loop).\n148:             // Then we save all XMI objects (second for loop).\n149:             // This is because order is important on saving.\n150:             // Bob - Why not do it the other way around? Surely\n151:             // when reloading it is better to load XMI first\n152:             // then the diagrams.\n153:             Collection names = new ArrayList();\n154:             int counter = 0;  \n155:             int size = project.getMembers().size();\n156:             for (int i = 0; i < size; i++) {\n157:                 ProjectMember projectMember = \n158:                     (ProjectMember) project.getMembers().elementAt(i);\n159:                 if (!(projectMember.getType().equalsIgnoreCase(\"xmi\"))) {\n160:                     if (LOG.isInfoEnabled()) {\n161:                         LOG.info(\"Saving member: \"\n162:                               + ((ProjectMember) project.getMembers()\n163:                                     .elementAt(i)).getName());\n164:                     }\n165:                     String name = projectMember.getName();\n166:                     String originalName = name;\n167:                     while (names.contains(name)) {\n168:                         name = ++counter + originalName;\n169:                     }\n170:                     names.add(name);\n171:                     stream.putNextEntry(new ZipEntry(name));\n172:                     projectMember.save(writer, null);\n173:                     writer.flush();\n174:                     stream.closeEntry();\n175:                 }\n176:             }\n177: \n178:             for (int i = 0; i < size; i++) {\n179:                 ProjectMember projectMember = \n180:                     (ProjectMember) project.getMembers().elementAt(i);\n181:                 if (projectMember.getType().equalsIgnoreCase(\"xmi\")) {\n182:                     if (LOG.isInfoEnabled()) {\n183:                         LOG.info(\"Saving member of type: \"\n184:                               + ((ProjectMember) project.getMembers()\n185:                                     .elementAt(i)).getType());\n186:                     }\n187:                     stream.putNextEntry(new ZipEntry(projectMember.getName()));\n188:                     projectMember.save(writer, null);\n189:                 }\n190:             }\n191:             \n192:             // if save did not raise an exception \n193:             // and name+\"#\" exists move name+\"#\" to name+\"~\"\n194:             // this is the correct backup file\n195:             if (backupFile.exists()) {\n196:                 backupFile.delete();\n197:             }\n198:             if (tempFile.exists() && !backupFile.exists()) {\n199:                 tempFile.renameTo(backupFile);\n200:             }\n201:             if (tempFile.exists()) {\n202:                 tempFile.delete();\n203:             }\n204:         } catch (Exception e) {\n205:             LOG.error(\"Exception occured during save attempt\", e);\n206:             try {\n207:                 writer.close();\n208:             } catch (IOException ex) { }\n209:             \n210:             // frank: in case of exception \n211:             // delete name and mv name+\"#\" back to name if name+\"#\" exists\n212:             // this is the \"rollback\" to old file\n213:             file.delete();\n214:             tempFile.renameTo( file);\n215:             // we have to give a message to user and set the system to unsaved!\n216:             throw new SaveException(e);\n217:         }\n218: \n219:         try {\n220:             writer.close();\n221:         } catch (IOException ex) {\n222:             LOG.error(\"Failed to close save output writer\", ex);\n223:         }\n224:     }\n225: \n226:     /**\n227:      * @see org.argouml.persistence.ProjectFilePersister#doLoad(java.net.URL)\n228:      */\n229:     public Project loadProject(URL url) throws OpenException {\n230:         try {\n231:             Project p = null;\n232:             // read the argo\n233:             try {\n234:                 // first read the .argo file from Zip\n235:                 ZipInputStream zis =\n236:                     openZipStreamAt(url, FileConstants.PROJECT_FILE_EXT);\n237: \n238:                 // the \"false\" means that members should not be added,\n239:                 // we want to do this by hand from the zipped stream.\n240:                 ArgoParser parser = new ArgoParser();\n241:                 p = new Project(url);\n242:                 parser.readProject(p, zis);\n243:                 zis.close();\n244:             } catch (IOException e) {\n245:                 // exception can occur both due to argouml code as to J2SE\n246:                 // code, so lets log it\n247:                 LOG.error(e);\n248:                 throw e;\n249:             }\n250:             loadProjectMembers(p, url);\n251:             p.postLoad();\n252:             return p;\n253:         } catch (IOException e) {\n254:             throw new OpenException(e);\n255:         } catch (SAXException e) {\n256:             throw new OpenException(e);\n257:         }\n258:     }\n259:     \n260:     /**\n261:      * Open a ZipInputStream to the first file found with\n262:      * a given extension.\n263:      * @param url The URL of the zip file.\n264:      * @param ext The required extension.\n265:      * @return the zip stream positioned at the required location.\n266:      */\n267:     private ZipInputStream openZipStreamAt(URL url, String ext)\n268:         throws IOException {\n269:         ZipInputStream zis = new ZipInputStream(url.openStream());\n270:         ZipEntry entry = zis.getNextEntry();\n271:         while (entry != null && !entry.getName().endsWith(ext)) {\n272:             entry = zis.getNextEntry();\n273:         }\n274:         return zis;\n275:     }\n276:     \n277:     /**\n278:      * Loads all the members from a zipped input stream.\n279:      *\n280:      * @param theUrl The URL to the input stream.\n281:      * @throws OpenException if there is something wrong with the zipped archive\n282:      *                     or with the model.\n283:      * @param project the project to load into\n284:      */\n285:     protected void loadProjectMembers(Project project, URL theUrl) \n286:         throws OpenException {\n287: \n288:         try {\n289:             loadModel(project, theUrl);\n290: \n291:             // now close again, reopen and read the Diagrams.\n292:             PGMLParser parser = new PGMLParser();\n293:             parser.setOwnerRegistry(project.getUUIDRefs());\n294: \n295:             //zis.close();\n296:             ZipInputStream zis = new ZipInputStream(theUrl.openStream());\n297:             SubInputStream sub = new SubInputStream(zis);\n298: \n299:             ZipEntry currentEntry = null;\n300:             while ((currentEntry = sub.getNextEntry()) != null) {\n301:                 if (currentEntry.getName().endsWith(\".pgml\")) {\n302:                     if (LOG.isInfoEnabled()) {\n303:                         LOG.info(\"Now going to load \"\n304:                                  + currentEntry.getName()\n305:                                  + \" from ZipInputStream\");\n306:                     }\n307: \n308:                     // \"false\" means the stream shall not be closed,\n309:                     // but it doesn't seem to matter...\n310:                     ArgoDiagram d =\n311:                         (ArgoDiagram) parser.readDiagram(\n312:                                       sub,\n313:                                       false);\n314:                     if (d != null) {\n315:                         project.addMember(d);\n316:                     }\n317:                     else {\n318:                         LOG.error(\"An error occurred while loading \" \n319:                             + currentEntry.getName());\n320:                     }\n321:                     // sub.closeEntry();\n322:                     if (LOG.isInfoEnabled()) {\n323:                         LOG.info(\"Finished loading \" + currentEntry.getName());\n324:                     }\n325:                 }\n326:                 if (currentEntry.getName().endsWith(\".todo\")) {\n327:                     ProjectMemberTodoList pm =\n328:                         new ProjectMemberTodoList(currentEntry.getName(), \n329:                                 project);\n330:                     pm.load(sub);\n331:                     project.addMember(pm);\n332:                 }\n333:             }\n334:             zis.close();\n335: \n336:         } catch (SAXException e) {\n337:         throw new OpenException(e);\n338:         } catch (ParserConfigurationException e) {\n339:         throw new OpenException(e);\n340:         } catch (IOException e) {\n341:             LastLoadInfo.getInstance().setLastLoadStatus(false);\n342:             LastLoadInfo.getInstance().setLastLoadMessage(e.toString());\n343:             LOG.error(\"Failure in Project.loadProjectMembers()\", e);\n344:             throw new OpenException(e);\n345:         }\n346:     }\n347:     \n348:     /**\n349:      * Loads a model (XMI only) from a .zargo file. BE ADVISED this\n350:      * method has a side effect. It sets _UUIDREFS to the model.\n351:      * \n352:      * If there is a problem with the xmi file, an error is set in the\n353:      * ArgoParser.SINGLETON.getLastLoadStatus() field. This needs to be\n354:      * examined by the calling function.\n355:      *\n356:      * @param theUrl The url with the .zargo file\n357:      * @param project the project to load into\n358:      * @return The model loaded\n359:      * @throws IOException Thrown if the model or the .zargo file is corrupted.\n360:      * @throws SAXException If the parser template is syntactically incorrect. \n361:      * @throws ParserConfigurationException If the initialization of \n362:      *         the parser fails.\n363:      */\n364:     protected Object loadModel(Project project, URL theUrl)\n365:         throws IOException, SAXException, ParserConfigurationException {\n366:         if (LOG.isInfoEnabled()) {\n367:             LOG.info(\"Loading Model from \" + theUrl);\n368:         }\n369:         ZipInputStream zis = openZipStreamAt(theUrl, \".xmi\");\n370:         InputSource source = new InputSource(zis);\n371:         return loadModel(project, source);\n372:     }\n373: \n374:     /**\n375:      * Loads a model (XMI only) from a .zargo file. BE ADVISED this\n376:      * method has a side effect. It sets _UUIDREFS to the model.\n377:      * \n378:      * If there is a problem with the xmi file, an error is set in the\n379:      * ArgoParser.SINGLETON.getLastLoadStatus() field. This needs to be\n380:      * examined by the calling function.\n381:      *\n382:      * @param project the project to load into\n383:      * @param source the source to load from\n384:      * @return The model loaded\n385:      * @throws IOException Thrown if the model or the .zargo file is corrupted.\n386:      * @throws SAXException If the parser template is syntactically incorrect. \n387:      * @throws ParserConfigurationException If the initialization of \n388:      *         the parser fails.\n389:      *\n390:      */\n391:     protected Object loadModel(Project project, InputSource source)\n392:         throws IOException, SAXException, ParserConfigurationException {\n393:         // 2002-07-18\n394:         // Jaap Branderhorst\n395:         // changed the loading of the projectfiles to solve hanging \n396:         // of argouml if a project is corrupted. Issue 913\n397:         // Created xmireader with method getErrors to check if parsing went well\n398:         XmiReader xmiReader = null;\n399:         try {\n400:             xmiReader = new XmiReader();\n401:         } catch (SAXException se) { // duh, this must be caught and handled\n402:             LOG.error(\"SAXException caught\", se);\n403:             throw se;\n404:         } catch (ParserConfigurationException pc) { \n405:             // duh, this must be caught and handled\n406:             LOG.error(\"ParserConfigurationException caught\", pc);\n407:             throw pc;\n408:         }\n409:         Object mmodel = null;\n410: \n411:         source.setEncoding(\"UTF-8\");\n412:         mmodel = xmiReader.parseToModel(source);        \n413:         if (xmiReader.getErrors()) {\n414:             LastLoadInfo.getInstance().setLastLoadStatus(false);\n415:             LastLoadInfo.getInstance().setLastLoadMessage(\n416:                     \"XMI file could not be parsed.\");\n417:             LOG.error(\"XMI file could not be parsed.\");\n418:             throw new SAXException(\n419:                     \"XMI file could not be parsed.\");\n420:         }\n421: \n422:         // This should probably be inside xmiReader.parse\n423:         // but there is another place in this source\n424:         // where XMIReader is used, but it appears to be\n425:         // the NSUML XMIReader.  When Argo XMIReader is used\n426:         // consistently, it can be responsible for loading\n427:         // the listener.  Until then, do it here.\n428:         UmlHelper.getHelper().addListenersToModel(mmodel);\n429: \n430:         project.addMember(mmodel);\n431: \n432:         project.setUUIDRefs(new HashMap(xmiReader.getXMIUUIDToObjectMap()));\n433:         \n434:         return mmodel;\n435:     }\n436: }\n437: ",
