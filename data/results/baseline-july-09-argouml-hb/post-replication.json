t ae ) {\n90:         super.actionPerformed(ae);\n91: \ttrySave( false );\n92:     }\n93: \n94:     /**\n95:      * @param overwrite true if we can overwrite without asking\n96:      * @return success\n97:      */\n98:     public boolean trySave(boolean overwrite) {\n99: \tProject p =  ProjectManager.getManager().getCurrentProject();\n100: \tTargetManager tm = TargetManager.getInstance();\n101: \tVector  targets = p.getDiagrams();\n102: \tIterator it = targets.iterator();\n103: \tFile saveDir = getSaveDir(p);\n104:         if (saveDir == null) {\n105:             /* The user cancelled! */\n106:             return false;\n107:         }\n108: \tboolean okSoFar = true;\n109: \tArgoDiagram activeDiagram = p.getActiveDiagram();\n110: \twhile (it.hasNext() && okSoFar) {\n111: \t    ArgoDiagram d = (ArgoDiagram) it.next();\n112: \t    tm.setTarget(d);\n113: \t    okSoFar = trySaveDiagram(overwrite, d, saveDir);\n114: \t}\n115: \ttm.setTarget(activeDiagram);\n116: \treturn okSoFar;\n117:     }\n118: \n119:     /**\n120:      * @param overwrite true if we can overwrite without asking\n121:      * @param target the diagram\n122:      * @param saveDir the directory to save to\n123:      * @return success\n124:      */\n125:     protected boolean trySaveDiagram(boolean overwrite, Object target,\n126:             File saveDir) {\n127: \tProjectBrowser pb = ProjectBrowser.getInstance();\n128: \tif ( target instanceof Diagram ) {\n129: \t    String defaultName = ((Diagram) target).getName();\n130: \t    defaultName = Util.stripJunk(defaultName);\n131: \t    // FIX - It's probably worthwhile to abstract and factor\n132: \t    // this chooser and directory stuff. More file handling is\n133: \t    // coming, I'm sure.\n134: \t    try {\n135: \t\tFile theFile = new File(saveDir, defaultName + \".\"\n136: \t\t    + SaveGraphicsManager.getInstance().getDefaultSuffix());\n137: \t\tString name = theFile.getName();\n138: \t\tString path = theFile.getParent();\n139: \t\tCmdSaveGraphics cmd = SaveGraphicsManager.getInstance()\n140:                     .getSaveCommandBySuffix(\n141:                         SaveGraphicsManager.getInstance().getDefaultSuffix());\n142: \t\tif (cmd == null) {\n143: \t\t    pb.showStatus(\"Unknown graphics file type with extension \"\n144: \t\t\t+ SaveGraphicsManager.getInstance().getDefaultSuffix());\n145: \t\t    return false;\n146: \t\t}\n147: \t\tpb.showStatus( \"Writing \" + path + name + \"...\" );\n148: \t\tsaveGraphicsToFile(theFile, cmd, overwrite);\n149: \t\tpb.showStatus( \"Wrote \" + path + name );\n150: \t\treturn true;\n151: \t    }\n152: \t    catch ( FileNotFoundException ignore ) {\n153: \t        LOG.error(\"got a FileNotFoundException\", ignore);\n154: \t    }\n155: \t    catch ( IOException ignore ) {\n156: \t\tLOG.error(\"got an IOException\", ignore);\n157: \t    }\n158: \t}\n159: \treturn false;\n160:     }\n161: \n162: \n163:     /**\n164:      * @param p the current project\n165:      * @return returns null if the user did not approve his choice\n166:      */\n167:     protected File getSaveDir(Project p) {\n168: \tJFileChooser chooser = getFileChooser(p);\n169: \n170:         String fn = Configuration.getString(\n171:                 SaveGraphicsManager.KEY_SAVEALL_GRAPHICS_PATH);\n172:         if (fn.length() > 0) {\n173:             chooser.setSelectedFile(new File(fn));\n174:         }\n175: \tProjectBrowser pb = ProjectBrowser.getInstance();\n176: \n177:         int retval = chooser.showSaveDialog( pb );\n178: \n179:         if ( retval == JFileChooser.APPROVE_OPTION ) {\n180:             File theFile = chooser.getSelectedFile();\n181:             String path = theFile.getPath();\n182:             Configuration.setString(\n183:                     SaveGraphicsManager.KEY_SAVEALL_GRAPHICS_PATH,\n184:                     path);\n185: \t    return theFile;\n186: \t}\n187:         return null;\n188:     }\n189: \n190:     private boolean saveGraphicsToFile(File theFile, CmdSaveGraphics cmd,\n191:  