:             if (obj instanceof CommentEdge) {\n952:                 ProjectBrowser.getInstance().getEditorPane()\n953:                     .removePresentationFor(obj, getDiagrams());\n954:                 ((CommentEdge) obj).delete();\n955:             }\n956:         }\n957:         ProjectManager.getManager().setNeedsSave(needSave);\n958:     }\n959: \n960:     /**\n961:      * @param obj the object to be moved from the trash\n962:      * TODO: Is \"move\" remove or restore?\n963:      */\n964:     public void moveFromTrash(Object obj) {\n965:         if (LOG.isDebugEnabled()) {\n966:             LOG.debug(\"TODO: not restoring \" + obj);\n967:         }\n968:     }\n969: \n970:     /**\n971:      * @param dm the object\n972:      * @return true if the object is trashed\n973:      */\n974:     public boolean isInTrash(Object dm) {\n975:         return Trash.SINGLETON.contains(dm);\n976:     }\n977: \n978:     /**\n979:      * @param theDefaultModel a uml model\n980:      */\n981:     public void setDefaultModel(Object theDefaultModel) {\n982: \n983:         if (!ModelFacade.isAModel(theDefaultModel)) {\n984:             throw new IllegalArgumentException();\n985:         }\n986: \n987:         defaultModel = theDefaultModel;\n988:         defaultModelCache = new HashMap();\n989:     }\n990: \n991:     /**\n992:      * Get the default model.\n993:      *\n994:      * @return A model.\n995:      */\n996:     public Object getDefaultModel() {\n997:         return defaultModel;\n998:     }\n999: \n1000:     /**\n1001:      * Find a type by name in the default model.\n1002:      *\n1003:      * @param name the name.\n1004:      * @return the type.\n1005:      */\n1006:     public Object findTypeInDefaultModel(String name) {\n1007:         if (defaultModelCache.containsKey(name)) {\n1008:             return defaultModelCache.get(name);\n1009:         }\n1010: \n1011:         Object result = findTypeInModel(name, getDefaultModel());\n1012:         defaultModelCache.put