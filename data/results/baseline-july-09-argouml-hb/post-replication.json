    while (e2.hasMoreElements()) {\n211:       _activation = (FigActivation) e2.nextElement();\n212:      \n213:       figClone._activation = (FigActivation) v.elementAt(j+i+6);\n214:       j++;\n215:     }\n216:     return figClone;\n217:   }\n218: \n219: \n220:   ////////////////////////////////////////////////////////////////\n221:   // Fig accessors\n222: \n223:   public void parseDynObjects(String dynobjs) {\n224: \n225:     _dynObjects = dynobjs;\n226: \n227:     StringTokenizer st1 = new StringTokenizer(dynobjs, \",[]\");\n228:     while (st1.hasMoreTokens()) {\n229:       String element = st1.nextToken().trim();\n230:       _dynVector.addElement(element);\n231:     }\n232:     int count = 0;\n233:     StringTokenizer st = new StringTokenizer(dynobjs, \",|[]\");\n234: \n235:     while (st.hasMoreTokens()) {\n236:       String next = st.nextToken().trim();\n237:     \n238:       if (next.equals(\"a\")) {\n239:         // next token is an activation fig [\"a\"| _FromPos| _toPos| _fromBegin| end]\n240:         FigActivation fa = new FigActivation(10, 10, 21, 10, 0, 0);\n241:         addFig(fa);\n242:         _activations.addElement(fa);\n243:         bindPort(getOwner(), fa);\n244: \n245:         String fromStr = st.nextToken();\n246:         String toStr = st.nextToken();\n247:         String begStr = st.nextToken();\n248:         String endStr = st.nextToken();\n249: \n250:         Integer fromInt = new Integer(fromStr);\n251:         int from = fromInt.intValue();\n252:         fa.setFromPosition(from);\n253: \n254:         Integer toInt = new Integer(toStr);\n255:         int to = toInt.intValue();\n256:         fa.setToPosition(to);\n257: \n258:         if (begStr.equals(\"true\")) { fa.setFromTheBeg(true); }\n259:         else fa.setFromTheBeg(false);\n260:         if (endStr.equals(\"true\")) { fa.setEnd(true); }\n261:         else fa.setEnd(false);\n262: \n263:         fa.setDynVectorPos(count);\n264:         count++;\n265:       }\n266:       if (next.equals(\"b\")) {\n267: \n268:         // next token is a dynPort figure [\"b\"| _pos]\n269:         FigDynPort fsp = new FigDynPort(10, 10, 21, 1, 0);\n270:         addFig(fsp);\n271:         _ports.addElement(fsp);\n272:         bindPort(getOwner(), fsp);\n273: \n274:         String posStr = st.nextToken();\n275:         Integer posInt = new Integer(posStr);\n276:         int pos = posInt.intValue();\n277:         fsp.setPosition(pos);\n278: \n279:         fsp.setDynVectorPos(count);\n280:         count++;\n281:       }\n282: \n283:     }\n284: \n285:   }\n286: \n287:   public void setOwner(Object node) {\n288:     super.setOwner(node);\n289:     bindPort(node, _lifeline);\n290:   }\n291: \n292:   /** Sets the port (some object in an underlying model) for Fig f.  f\n293:    *  must already be contained in the FigNode. f will now represent\n294:    *  the given port. Overrides the implementation of FigNode.\n295:   */\n296:     \n297:   public void bindPort(Object port, Fig f) {\n298:     Fig oldPortFig = getPortFig(port);\n299:     //if (oldPortFig != null) oldPortFig.setOwner(null);\n300:     f.setOwner(port);\n301:   }\n302: \n303: \n304:   /** Reply the port that \"owns\" the topmost Fig under the given point, or\n305:    *  null if none. \n306:    *  Overrides the implementation of FigNode.\n307:    *  If the hit port has an owner, hitPort() returns that owner object. \n308:    *  The mode manageer tries to create an arc, even in the select mode.\n309:    *  Because the user shall select the FigSeqObject with its lifeline, \n310:    *  which is binded to the underlying object,  a special handling is needed \n311:    *  to make it selectable.\n312:    */\n313: \n314:   public Object hitPort(int x, int y) {\n315:     Fig f = hitFig(new Rectangle(x, y, 1, 1));\n316:    \n317:     if (Globals.mode() instanceof ModeSelect )   {\n318:       /* if we are in the select mode  and the hit fig is tho object's lifeline, \n319:        *  return null, so the object can be selected \n320:        */ \n321:       return null;\n322:     }\n323:  \n324:     if (f != null) return f.getOwner();\n325:     else return null;\n326:       \n327:   }\n328:     \n329:   public Dimension getMinimumSize() {\n330:     Dimension bigPortMin = _bigPort.getMinimumSize();\n331:     Dimension coverMin = _cover.getMinimumSize();\n332:     Dimension nameMin = _name.getMinimumSize();\n333: \n334:     int h = Math.max(bigPortMin.height, Math.max(coverMin.height, nameMin.height));\n335:     int w = Math.max(bigPortMin.width, Math.max(coverMin.width, nameMin.width));\n336:     return new Dimension(w, h);\n337:   }\n338: \n339:   /* Override setBounds to keep shapes looking right */\n340:   public void setBounds(int x, int y, int w, int h, int edges) {\n341: \n342:     if (_name == null) return;\n343: \n344: \n345:     Rectangle oldBounds = getBounds();\n346: \n347:     Dimension nameMin = _name.getMinimumSize();\n348: \n349:     int mainX = 0; int mainY = 0; int mainW = 0; int mainH = 0;\n350:     int lifeX = 0; int lifeY = 0; int lifeW = 0; int lifeH = 0;\n351:     int portX = 0; int portY = 0; int portW = 0; int portH = 0;\n352: \n353: \n354: \n355: \n356:     if (_created && _terminated) {\n357:       mainX = x;        mainY = y+40*(_createHeight+1)+10;\n358:       mainW = nameMin.width+20;     mainH = nameMin.height+10;\n359:       lifeX = x+nameMin.width/2+6;    lifeY = y+nameMin.height+40*(_createHeight+1)+20;\n360:       lifeW = 10;       lifeH = 25+40*(_terminateHeight- _createHeight-1);\n361:       portX = x;        portY = y+nameMin.height+45;\n362:       portW = 10;       portH = 1;\n363: \n364:     }\n365: \n366:     if (_created && (!(_terminated))) {\n367:       \tmainX = x; \t\t\t\tmainY = y+40*(_createHeight+1)+10;\n368:       \tmainW = nameMin.width+20; \t\tmainH = nameMin.height+10;\n369:       \tlifeX = x+nameMin.width/2+6;\t\tlifeY = y+nameMin.height+40*(_createHeight+1)+20;\n370:       \tlifeW = 10;\t\t\t\tlifeH = 30+40*(edges- _createHeight-1);\n371:       \tportX = x;\t\t\t\tportY = y+nameMin.height+45;\n372:       \tportW = 10;\t\t\t\tportH = 1;\n373: \n374: \n375: \n376:     }\n377: \n378:     if ((!(_created)) && _terminated) {\n379:       \tmainX = x; \t\t\t\tmainY = y;\n380:       \tmainW = nameMin.width+20; \t\tmainH = nameMin.height+10;\n381:       \tlifeX = x+nameMin.width/2+6;\t\tlifeY = y+nameMin.height+10;\n382:       \tlifeW = 10;\t\t\t\tlifeH = 40*_terminateHeight+35;\n383:       \tportX = lifeX-3;\t\t\tportY = y+nameMin.height+45;\n384:       \tportW = 21;\t\t\t\tportH = 1;\n385: \n386: \n387:     }\n388:     if ((!(_created)) && (!(_terminated))) {\n389:       \tmainX = x; \t\t\t\tmainY = y;\n390:       \tmainW = nameMin.width+20; \t\tmainH = nameMin.height+10;\n391:       \tlifeX = x+nameMin.width/2+6;\t\tlifeY = y+nameMin.height+10;\n392:       \tlifeW = 10;\t\t\t\tlifeH = 40*edges+40;\n393:       \tportX = lifeX-3;\t\t \tportY = y+nameMin.height+45;\n394:       \tportW = 21;\t\t\t\tportH = 1;\n395: \n396: \n397:     }\n398:     int activX = lifeX-6;\tint activY = 0;\n399:     int activW = 21;\t\tint activH = 0;\n400: \n401:     // the dynamci ports are invisible\n402:     portH=0;\n403:    \n404:      _bigPort.setBounds(mainX, mainY, mainW, mainH);\n405:      _cover.setBounds(mainX, mainY, mainW, mainH);\n406:     _name.setBounds(mainX, mainY, mainW, mainH);\n407:     _lifeline.setBounds(lifeX, lifeY, lifeW, lifeH);\n408: \n409:     Enumeration e = _ports.elements();\n410: \n411:     while (e.hasMoreElements()) {\n412: \n413: \n414:       FigDynPort r = (FigDynPort) e.nextElement();\n415:       int number = r.getPosition();\n416: \n417:       if (_created) {\n418:         if (number == _createHeight) {\n419: \t     r.setBounds(mainX, mainY+ mainH/2 -3 , mainW, portH); //-1\n420:         } else  {\n421:           r.setBounds(portX+((nameMin.width)/2), portY+40*number, 21, portH);\n422:         }\n423:       }\n424:       if (!(_created)) {\n425:         r.setBounds(portX-3, portY+40*number, 21, portH);\n426:       }\n427: \n428: \n429:     }\n430: \n431:     // the y-position of the termination symbol\n432:     int termY1 = lifeY + lifeH;\n433: \n434:     int actSize = _activations.size();\n435:     for (int i=0; i<actSize; i++) {\n436: \n437:       FigActivation figAct = (FigActivation) _activations.elementAt(i);\n438:       int from = figAct.getFromPosition();\n439:       int to = figAct.getToPosition();\n440:       if (i == 0) {\n441:         if (figAct.isFromTheBeg()) {\n442:           if (_created) {\n443:             activY = lifeY;\n444:             activH = 40*(to-_createHeight)-15;\n445:           } else {\n446:             activY = lifeY;\n447:             activH = 40*(to)+35;\n448:           }\n449:         } else {\n450:           if (_created) {\n451:             activY = lifeY;\n452:             activH = 40*(to-_createHeight)-15;\n453:           } else {\n454:             activY = portY+40*from;\n455:             activH = 40*(to-from);\n456:           }\n457:           if ((to-from) == 0 && (!(figAct.isEnd()))) {\n458:             activH = 10;\n459:           }\n460:         }\n461:         figAct.setBounds(activX, activY, activW, activH);\n462:       } else {\n463:         activY = portY+40*from;\n464:         activH = 40*(to-from);\n465:         if ((to-from) == 0 && (!(figAct.isEnd()))) {\n466:           activH = 10;\n467:         }\n468:         figAct.setBounds(activX, activY, activW, activH);\n469: \n470: \n471:       }\n472:       // update the termination y position\n473:       if ( (activY+activH) > termY1) termY1 = activY+activH;\n474:     }\n475:     // set termination symbol under the last activation symbol\n476:     int termX1=lifeX;\n477:     termY1=termY1-1;\n478:     int termX2=lifeX+lifeW-1;\n479:     int termY2=termY1;\n480: \n481:     if  ( _terminated ) {\n482:       // make terminate symbol visible as a cross \n483:       termX1=lifeX-lifeW;\n484:       //termY1=lifeY+lifeH-1;\n485:       termX2=lifeX+2*lifeW;\n486:       termY2=termY1+lifeW*2;\n487:     }\n488:     terminateSymbolSetBounds( termX1, termY1, termX2, termY2);\n489: \n490:     _x = x; _y = y; _w = w; _h = h;\n491: \n492:     firePropChange(\"bounds\", oldBounds, getBounds());\n493:     calcBounds(); //_x = x; _y = y; _w = w; _h = h;\n494:     updateEdges();\n495: \n496:    }\n497: \n498:   ////////////////////////////////////////////////////////////////\n499:   // event handlers\n500: \n501:   protected void textEdited(FigText ft) throws PropertyVetoException {\n502:     // super.textEdited(ft);\n503:     MObject obj = (MObject) getOwner();\n504:     if (ft == _name) {\n505:        String s = ft.getText();\n506: \n507:       // needs more Work:\n508:       ParserDisplay.SINGLETON.parseObject(obj, s);\n509:     }\n510:   }\n511: \n512: \n513:   protected void modelChanged() {\n514:     super.updateNameText();\n515:     MObject obj = (MObject) getOwner();\n516:     if (obj == null) return;\n517:     String nameStr = Notation.generate(this, obj.getName()).trim();\n518: \tString baseString = \"\";\n519: \tVector bases = new Vector(obj.getClassifiers());\n520: \tif (bases.size() == 1)\n521: \t\tbaseString = ((MClassifier)bases.elementAt(0)).getName();\n522: \telse if (bases.size() > 1)\n523: \t\tbaseString = \"(multiple)\";\n524: \n525:     if (_readyToEdit) {\n526:       if( nameStr == \"\" && baseString == \"\")\n527: \t_name.setText(\"\");\n528:       else\n529: \t_name.setText(nameStr.trim() + \" : \" + baseString);\n530:     }\n531:     setEnclosingFig(this);\n532: \n533:     if (getLayer() != null && getLayer() instanceof SequenceDiagramLayout) {\n534:     \t((SequenceDiagramLayout)getLayer()).placeAllFigures();\n535:     } else {\n536:     \tDiagram diagram = ProjectBrowser.TheInstance.getActiveDiagram();\n537:     \tLayer lay = null;\n538:     \tif (diagram != null) {\n539:     \t\tlay = diagram.getLayer();\n540:     \t\tif (lay instanceof SequenceDiagramLayout) {\n541:     \t\t\tsetLayer(lay);\n542:     \t\t} else {\n543:     \t\t\tString name = null;\n544:     \t\t\tGraphModel gm = null;\n545:     \t\t\tif (lay != null && lay instanceof LayerPerspective) {\n546:     \t\t\t\tgm = ((LayerPerspective)lay).getGraphModel();\n547:     \t\t\t\tname = ((LayerPerspective)lay).getName();\n548:     \t\t\t} else {\n549:     \t\t\t\tEditor ed = Globals.curEditor();\n550:     \t\t\t\tif (ed != null && ed.getGraphModel() != null && ed.getLayerManager() != null && ed.getLayerManager().getActiveLayer() != null) {\n551:     \t\t\t\t\tlay = ed.getLayerManager().getActiveLayer();\n552:     \t\t\t\t\tname = lay.getName();\n553:     \t\t\t\t\tgm = ed.getGraphModel();\n554:     \t\t\t\t} else\n555:     \t\t\t\t\tthrow new IllegalStateException(\"No way to get graphmodel. Project corrupted\");\n556:     \t\t\t}\n557:     \t\t\tsetLayer(new SequenceDiagramLayout(name, gm));\n558:     \t\t}\n559:     \t}\n560:     \t((SequenceDiagramLayout)getLayer()).placeAllFigures();\n561:     }\n562:   }\n563: \n564: \n565:  \n566: \n567:   /** This method is called, when the FigSeqObject is\n568:    *    moving around. Changes the position of the\n569:    *    FigSeqObjects. */\n570:   public void changePosition(Vector contents) {\n571: \n572:     int size = contents.size();\n573:     for (int k=0; k<size; k++) {\n574:       if (contents.elementAt(k) instanceof FigSeqObject) {\n575:         FigSeqObject figure = (FigSeqObject) contents.elementAt(k);\n576:         if (figure != this) {\n577:           Rectangle rect = figure.getBounds();\n578:           if (((this.getBounds()).x + (this.getBounds()).width) > (rect.x + rect.width)) {\n579:             int indexFigure = contents.indexOf(figure);\n580:             int indexThis = contents.indexOf(this);\n581:             if (indexFigure>indexThis) {\n582:               contents.setElementAt(this, indexFigure);\n583:               contents.setElementAt(figure, indexThis);\n584:             }\n585:           }\n586:           if (((this.getBounds()).x) < (rect.x)) {\n587:             int indexFigure = contents.indexOf(figure);\n588:             int indexThis = contents.indexOf(this);\n589:             if (indexFigure<indexThis) {\n590:               contents.setElementAt(this, indexFigure);\n591:               contents.setElementAt(figure, indexThis);\n592:             }\n593:           }\n594:         }\n595:       }\n596:     }\n597:   }\n598: \n599: \n600:   /** Count the edges that are in this diagram */\n601:   public int edgesCount(Vector contents) {\n602:     int size = contents.size();\n603:     int countEdges = 0;\n604:     if (contents != null && size > 0) {\n605:       for (int i=0; i<size; i++) {\n606:         if (contents.elementAt(i) instanceof FigSeqLink) {\n607:           countEdges++;\n608:         }\n609:       }\n610:     }\n611:     return countEdges;\n612:   }\n613: \n614:   /** If the FigSeqLink linkFig is connected to a create-action\n615:    *    this FigSeqObject will be updated with the right values */\n616:   public void setForCreate(FigSeqLink linkFig, String connectTo, boolean isCreate) {\n617:     Vector contents = getContents();   \n618:     int portNumber = linkFig.getPortNumber(contents);   \n619:     FigDynPort fsp = (FigDynPort) linkFig.getSourcePortFig();\n620:     if (connectTo == \"Dest\") {\n621:       fsp = (FigDynPort) linkFig.getDestPortFig();\n622:     }\n623:    \n624:     int firstPos = 10000;\n625:     Vector edges = getFigEdges();\n626:     for (int i=0; i<edges.size(); i++) {\n627:       FigSeqLink fsl = (FigSeqLink) edges.elementAt(i);\n628:       int fslNumber = fsl.getPortNumber(contents);\n629:       if (fslNumber < firstPos) { firstPos = fslNumber; }\n630:     }\n631:     if (isCreate == true) {\n632:       if (firstPos == portNumber) {\n633:         _created = isCreate;\n634:         _createHeight = firstPos;\n635: \n636:       }\n637:       else {\n638:         linkFig.setDefaultAction();\n639:       }\n640:     }\n641:     else if (isCreate == false) {\n642:       if (firstPos == portNumber) {\n643:         _created = isCreate;\n644:         _createHeight = 0;\n645:       }\n646:     }\n647:   }\n648: \n649:   /** If the FigSeqLink linkFig is connected to a destroy-action\n650:    *    this FigSeqObject will be updated with the right values */\n651:   public void setForDestroy(FigSeqLink linkFig, String connectTo, boolean isTerminate) {\n652:     Vector contents = getContents();\n653:     int portNumber = linkFig.getPortNumber(contents);   \n654:     FigDynPort fsp = (FigDynPort) linkFig.getSourcePortFig();\n655:     if (connectTo == \"Dest\") fsp = (FigDynPort) linkFig.getDestPortFig();\n656:     int lastPos = 0;\n657:     Vector edges = getFigEdges();\n658: \n659:     for (int i=0; i<edges.size(); i++) {\n660:       FigSeqLink fsl = (FigSeqLink) edges.elementAt(i);\n661:       int fslNumber = fsl.getPortNumber(contents);\n662: \n663:       if (fslNumber > lastPos) { lastPos = fslNumber; }\n664:     }\n665:     if (isTerminate == true) {\n666: \n667:       if (lastPos == portNumber) {\n668: \n669:         _terminated = isTerminate;\n670:         _terminateHeight = lastPos;\n671:       }\n672:       else {\n673:         linkFig.setDefaultAction();\n674:       }\n675: \n676:     }\n677:     else if (isTerminate == false) {\n678:       if (lastPos == portNumber) {\n679:         _terminated = isTerminate;\n680:         _terminateHeight = 0;\n681:       }\n682:     }\n683:   }\n684: \n685:   /** If the connected action of the FigSeqLink figLink is\n686:    *    a return-action, the corresponding FigActivation will\n687:    *    be cut in two FigActivations */\n688:   public void breakActivation(FigSeqLink figLink, Vector contents) {\n689:     int size = contents.size();\n690:     int portNumber = figLink.getPortNumber(contents);\n691:     int edges = edgesCount(contents);\n692: \n693:     for (int i=0; i<_activations.size(); i++) {\n694:       FigActivation figAct = (FigActivation) _activations.elementAt(i);\n695:       if (figAct.getFromPosition() <= portNumber && figAct.getToPosition() > portNumber) {\n696:         Vector figEdges = getFigEdges();\n697:         Vector _nearest = nearestLink(figEdges, portNumber, contents);\n698:         int nearest = ((Integer)_nearest.elementAt(0)).intValue();\n699:         int high = ((Integer)_nearest.elementAt(1)).intValue();\n700: \n701:         if (nearest > portNumber) {\n702:           //FigActivation newAct = new FigActivation(0, 0, 21, 40, nearest, high);\n703:           FigActivation newAct = new FigActivation(0, 0, 21, 40, nearest, figAct.getToPosition());\n704:           _activations.addElement(newAct);\n705:           String dynStr = \"a|\"+newAct.getFromPosition()+\"|\"+newAct.getToPosition()+\"|\"+newAct.isFromTheBeg()+\"|\"+newAct.isEnd();\n706:           _dynVector.addElement(dynStr);\n707:           _dynObjects = _dynVector.toString();\n708:           newAct.setDynVectorPos(_dynVector.indexOf(dynStr));\n709:           addFig(newAct);\n710:           bindPort(getOwner(), newAct);\n711:         }\n712:         figAct.setToPosition(portNumber);\n713:         figAct.setEnd(true);\n714:       }\n715:       else if (figAct.getFromPosition() <= portNumber && figAct.getToPosition() == portNumber) {\n716:         figAct.setEnd(true);\n717:       }\n718: //      else if (figAct.getFromPosition() == portNumber) {\n719: //        figLink.setDefaultAction();\n720: //      }\n721:       int dynPos = figAct.getDynVectorPos();\n722:       _dynVector.removeElementAt(dynPos);\n723:       String newDynStr = \"a|\"+figAct.getFromPosition()+\"|\"+figAct.getToPosition()+\"|\"+figAct.isFromTheBeg()+\"|\"+figAct.isEnd();\n724:       _dynVector.insertElementAt(newDynStr, dynPos);\n725:       _dynObjects = _dynVector.toString();\n726:     }\n727:   }\n728: \n729:   /** This method decides, if two FigActivations can be\n730:    *    replaced with the first of this two FigActivations with\n731:    *    the added lenght of both FigActivations */\n732:   public void concatActivation(FigSeqLink figLink, Vector contents) {\n733:     int portNumber = figLink.getPortNumber(contents);\n734:     boolean canConcat = false;\n735:     FigActivation figConcat = canConcat(portNumber);\n736:     if (figConcat != null) canConcat = true;\n737: \n738:     if (canConcat) {\n739:       figConcat.setEnd(false);\n740:       int max = 10000;\n741:       FigActivation nextAct = null;\n742:       for (int i=0; i<_activations.size(); i++) {\n743:         FigActivation fa = (FigActivation) _activations.elementAt(i);\n744:         if (fa.getFromPosition() > portNumber && fa.getFromPosition() < max)  {\n745:           nextAct = fa;\n746:           max = fa.getFromPosition();\n747:         }\n748:       }\n749:       if (nextAct != null) {\n750:         figConcat.setToPosition(nextAct.getToPosition());\n751:         _activations.removeElement(nextAct);\n752:         int dynPos = nextAct.getDynVectorPos();\n753:         _dynVector.removeElementAt(dynPos);\n754:         Vector dynFigs = getFigs();\n755:         for (int i=0; i<dynFigs.size(); i++) {\n756:           Fig df = (Fig) dynFigs.elementAt(i);\n757:           if (df instanceof FigActivation) {\n758:             FigActivation dfa = (FigActivation) df;\n759:             if (dfa.getDynVectorPos() > dynPos) dfa.setDynVectorPos(dfa.getDynVectorPos()-1);\n760:           }\n761:           else if (df instanceof FigDynPort) {\n762:             FigDynPort dfsp = (FigDynPort) df;\n763:             if (dfsp.getDynVectorPos() > dynPos) dfsp.setDynVectorPos(dfsp.getDynVectorPos()-1);\n764:           }\n765:         }\n766:         _dynObjects = _dynVector.toString();\n767:         removeFig(nextAct);\n768:         nextAct.delete();\n769:       }\n770:       else {\n771:         // do nothing\n772:       }\n773:     }\n774:   }\n775: \n776:   /** Get the Vector of all figures, that are shown in\n777:    *    the diagram, is important because in sequence-\n778:    *    diagrams often you have to update all figur