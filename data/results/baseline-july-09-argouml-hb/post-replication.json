.Logger;\n33: import org.argouml.application.api.ArgoEventListener;\n34: \n35: /**\n36:  * ArgoEventPump is an eventhandler which handles events regarding\n37:  * the loading and unloading of modules.\n38:  */\n39: public final class ArgoEventPump {\n40:     /**\n41:      * Logger.\n42:      */\n43:     private static final Logger LOG = Logger.getLogger(ArgoEventPump.class);\n44: \n45:     /**\n46:      * <code>listeners</code> contains the list of register listeners.\n47:      *\n48:      * It is a list of {@link Pair}.\n49:      */\n50:     private List listeners;\n51: \n52:     /**\n53:      * The singleton.\n54:      */\n55:     static final ArgoEventPump SINGLETON = new ArgoEventPump();\n56: \n57:     /**\n58:      * @return the singleton\n59:      */\n60:     public static ArgoEventPump getInstance() {\n61:         return SINGLETON;\n62:     }\n63: \n64:     /**\n65:      * Constructor.\n66:      */\n67:     private ArgoEventPump() {\n68:     }\n69: \n70:     /**\n71:      * @param listener The listener to be added.\n72:      */\n73:     public static void addListener(ArgoEventListener listener) {\n74:         SINGLETON.doAddListener(ArgoEventTypes.ANY_EVENT, listener);\n75:     }\n76: \n77:     /**\n78:      * @param event the event to what the listener will listen (?)\n79:      * @param listener the listener to be added\n80:      */\n81:     public static void addListener(int event, ArgoEventListener listener) {\n82:         SINGLETON.doAddListener(event, listener);\n83:     }\n84: \n85:     /**\n86:      * @param listener the listener to be removed\n87:      */\n88:     public static void removeListener(ArgoEventListener listener) {\n89:         SINGLETON.doRemoveListener(ArgoEventTypes.ANY_EVENT, listener);\n90:     }\n91: \n92:     /**\n93:      * @param event the event to which the listener will not listen any more\n94:      * @param listener the listener to be removed\n95:      */\n96:     public static void removeListener(int event, ArgoEventListener listener) {\n97:         SINGLETON.doRemoveListener(event, listener);\n98:     }\n99: \n100:     /**\n101:      * @param event the event to what the listener will listen (?)\n102:      * @param listener the listener to be added\n103:      */\n104:     protected void doAddListener(int event, ArgoEventListener listener) {\n105:         if (listeners == null) {\n106:             listeners = new ArrayList();\n107:         }\n108:         listeners.add(new Pair(event, listener));\n109:     }\n110: \n111:     /**\n112:      * Removes a listener, eventtype pair from the listener list.\n113:      *\n114:      * TODO: replace the listener implementation with a EventListenerList\n115:      * for better performance\n116:      *\n117:      * @param event the event to which the listener will not listen any more\n118:      * @param listener the listener to be removed\n119:      */\n120:     protected void doRemoveListener(int event, ArgoEventListener listener) {\n121:         if (listeners == null) {\n122:             return;\n123:         }\n124:         Iterator it = listeners.iterator();\n125:         List removeList = new ArrayList();\n126:         if (event == ArgoEventTypes.ANY_EVENT) {\n127: \n128:             while (it.hasNext()) {\n129:                 Pair p = (Pair) it.next();\n130:                 if (p.listener == listener) {\n131:                     removeList.add(p);\n132:                 }\n133:             }\n134: \n135:         } else {\n136:             Pair test = new Pair(event, listener);\n137:             while (it.hasNext()) {\n138:                 Pair p = (Pair) it.next();\n139:                 if (p.equals(test)) {\n140:                     removeList.add(p);\n141:                 }\n142:             }\n143:         }\n144:         listeners.removeAll(removeList);\n145:     }\n146: \n147:     /**\n148:      * Handle firing a module event to a given listener.\n149:      *\n150:      * @param event The event fired.\n151:      * @param listener The listener.\n152:      */\n153:     private void handleFireModuleEvent(\n154:         ArgoModuleEvent event,\n155:         ArgoModuleEventListener listener) {\n156:         switch (event.getEventType()) {\n157: \tcase ArgoEventTypes.MODULE_LOADED :\n158: \t    listener.moduleLoaded(event);\n159: \t    break;\n160: \n161: \tcase ArgoEventTypes.MODULE_UNLOADED :\n162: \t    listener.moduleUnloaded(event);\n163: \t    break;\n164: \n165: \tcase ArgoEventTypes.MODULE_ENABLED :\n166: \t    listener.moduleEnabled(event);\n167: \t    break;\n168: \n169: \tcase ArgoEventTypes.MODULE_DISABLED :\n170: \t    listener.moduleDisabled(event);\n171: \t    break;\n172: \n173: \tdefault :\n174: \t    LOG.error(\"Invalid event:\" + event.getEventType());\n175: \t    break;\n176:         }\n177:     }\n178: \n179:     /**\n180:      * Handle firing a notation event.\n181:      *\n182:      * @param event The event to be fired.\n183:      * @param listener The listener.\n184:      */\n185:     private void handleFireNotationEvent(\n186:         ArgoNotationEvent event,\n187:         ArgoNotationEventListener listener) {\n188:         switch (event.getEventType()) {\n189: \tcase ArgoEventTypes.NOTATION_CHANGED :\n190: \t    listener.notationChanged(event);\n191: \t    break;\n192: \n193: \tcase ArgoEventTypes.NOTATION_ADDED :\n194: \t    listener.notationAdded(event);\n195: \t    break;\n196: \n197: \tcase ArgoEventTypes.NOTATION_REMOVED :\n198: \t    listener.notationRemoved(event);\n199: \t    break;\n200: \n201: \tcase ArgoEventTypes.NOTATION_PROVIDER_ADDED :\n202: \t    listener.notationProviderAdded(event);\n203: \t    break;\n204: \n205: \tcase ArgoEventTypes.NOTATION_PROVIDER_REMOVED :\n206: \t    listener.notationProviderRemoved(event);\n207: \t    break;\n208: \n209: \tdefault :\n210: \t    LOG.error(\"Invalid event:\" + event.getEventType());\n211: \t    break;\n212:         }\n213:     }\n214: \n215:     /**\n216:      * Handle firing a generator event.\n217:      *\n218:      * @param event The event to be fired.\n219:      * @param listener The listener.\n220:      */\n221:     private void handleFireGeneratorEvent(\n222:         ArgoGeneratorEvent event,\n223:         ArgoGeneratorEventListener listener) {\n224:         switch (event.getEventType()) {\n225:         case ArgoEventTypes.GENERATOR_CHANGED:\n226:             listener.generatorChanged(event);\n227:             break;\n228: \n229:         case ArgoEventTypes.GENERATOR_ADDED:\n230:             listener.generatorAdded(event);\n231:             break;\n232: \n233:         case ArgoEventTypes.GENERATOR_REMOVED:\n234:             listener.generatorRemoved(event);\n235:             break;\n236: \n237:         default:\n238:             LOG.error(\"Invalid event:\" + event.getEventType());\n239:             break;\n240:         }\n241:     }\n242: \n243:     private void handleFireEvent(ArgoEvent event, ArgoEventListener listener) {\n244:         if (event.getEventType() == ArgoEventTypes.ANY_EVENT) {\n245:             if (listener instanceof ArgoModuleEventListener) {\n246:                 handleFireModuleEvent((ArgoModuleEvent) event,\n247: \t\t\t\t      (ArgoModuleEventListener) listener);\n248:             }\n249:             if (listener instanceof ArgoNotationEventListener) {\n250:                 handleFireNotationEvent((ArgoNotationEvent) event,\n251: \t\t\t\t\t(ArgoNotationEventListener) listener);\n252:             }\n253:         } else {\n254:             if (event.getEventType() >= ArgoEventTypes.ANY_MODULE_EVENT\n255:                 && event.getEventType() < ArgoEventTypes.LAST_MODULE_EVENT) {\n256:                 if (listener instanceof ArgoModuleEventListener) {\n257:                     handleFireModuleEvent((ArgoModuleEvent) event,\n258: \t\t\t\t\t  (ArgoModuleEventListener) listener);\n259:                 }\n260:             }\n261:             if (event.getEventType() >= ArgoEventTypes.ANY_NOTATION_EVENT\n262:                 && event.getEventType() < ArgoEventTypes.LAST_NOTATION_EVENT) {\n263:                 if (listener instanceof ArgoNotationEventListener) {\n264:                     handleFireNotationEvent((ArgoNotationEvent) event,\n265: \t\t\t\t\t(ArgoNotationEventListener) listener);\n266:                 }\n267:             }\n268:             if (event.getEventType() >= ArgoEventTypes.ANY_GENERATOR_EVENT\n269:                 && event.getEventType() < ArgoEventTypes.LAST_GENERATOR_EVENT) {\n270:                 if (listener instanceof ArgoGeneratorEventListener) {\n271:                     handleFireGeneratorEvent((ArgoGeneratorEvent) event,\n272:                             (ArgoGeneratorEventListener) listener);\n273:                 }\n274:             }\n275:         }\n276:     }\n277: \n278:     /**\n279:      * @param event the event to be fired\n280:      */\n281:     public static void fireEvent(ArgoEvent event) {\n282:         SINGLETON.doFireEvent(event);\n283:     }\n284: \n285:     /**\n286:      * @param event the event to be fired\n287:      */\n288:     protected void doFireEvent(ArgoEvent event) {\n289: \n290:         if (listeners == null) {\n291:             return;\n292:         }\n293: \n294:         ListIterator iterator = listeners.listIterator();\n295:         while (iterator.hasNext()) {\n296:             Pair pair = (Pair) iterator.next();\n297:             if (pair.getEventType() == ArgoEventTypes.ANY_EVENT) {\n298:                 handleFireEvent(event, pair.getListener());\n299:             } else if (\n300:                 (pair.getEventType() >= event.getEventStartRange())\n301:                     && (pair.getEventType() <= event.getEventEndRange())) {\n302:                 handleFireEvent(event, pair.getListener());\n303:             }\n304:         }\n305: \n306:     }\n307: \n308:     /**\n309:      * Data structure handling listener registrations.\n310:      */\n311:     static class Pair {\n312:         private int eventType;\n313:         private ArgoEventListener listener;\n314: