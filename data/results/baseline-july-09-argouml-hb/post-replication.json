0:         j = 0;\n3231:         for (; i < len;) {\n3232:             int ibv, isv;\n3233:             int jbv, jsv;\n3234: \n3235:             ibv = 0;\n3236:             for (; i < len; i++) {\n3237:                 char c = n1.charAt(i);\n3238:                 if (c < '0' || c > '9')\n3239:                     break;\n3240:                 ibv *= 10;\n3241:                 ibv += c - '0';\n3242:             }\n3243:             isv = 0;\n3244:             for (; i < len; i++) {\n3245:                 char c = n1.charAt(i);\n3246:                 if (c < 'a' || c > 'z')\n3247:                     break;\n3248:                 isv *= 26;\n3249:                 isv += c - 'a';\n3250:             }\n3251: \n3252:             jbv = 0;\n3253:             for (; j < jlen; j++) {\n3254:                 char c = n2.charAt(j);\n3255:                 if (c < '0' || c > '9')\n3256:                     break;\n3257:                 jbv *= 10;\n3258:                 jbv += c - '0';\n3259:             }\n3260:             jsv = 0;\n3261:             for (; j < jlen; j++) {\n3262:                 char c = n2.charAt(j);\n3263:                 if (c < 'a' || c > 'z')\n3264:                     break;\n3265:                 jsv *= 26;\n3266:                 jsv += c - 'a';\n3267:             }\n3268: \n3269:             if (ibv != jbv || isv != jsv) {\n3270:                 return false;\n3271:             }\n3272: \n3273:             if (i < len && n1.charAt(i) != '.') {\n3274:                 return false;\n3275:             } else\n3276:                 i++;\n3277: \n3278:             if (j < jlen && n2.charAt(j) != '.') {\n3279:                 return false;\n3280:             } else\n3281:                 j++;\n3282:         }\n3283:         return true;\n3284:     }\n3285: \n3286:     /**\n3287:      * Finds the operations in Collection c with name name and params number of\n3288:      * parameters. If no operation is found, one is created. The applicable\n3289:      * opera