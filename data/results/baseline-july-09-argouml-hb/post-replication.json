cation());\n132:         }\n133:         return specificationComboBox;\n134:     }\n135: \n136:     private static class UMLMethodSpecificationComboBoxModel\n137:         extends UMLComboBoxModel2 {\n138:         /**\n139:          * Constructor.\n140:          */\n141:         public UMLMethodSpecificationComboBoxModel() {\n142:             super(\"specification\", false);\n143:             Model.getPump().addClassModelEventListener(this,\n144:                     Model.getMetaTypes().getOperation(), \"method\");\n145:         }\n146: \n147:         /**\n148:          * @see org.argouml.uml.ui.UMLComboBoxModel2#isValidElement(\n149:          *         java.lang.Object)\n150:          */\n151:         protected boolean isValidElement(Object element) {\n152:             Object specification =\n153:                 Model.getCoreHelper().getSpecification(getTarget());\n154:             return specification == element;\n155:         }\n156: \n157:         /**\n158:          * @see org.argouml.uml.ui.UMLComboBoxModel2#buildModelList()\n159:          */\n160:         protected void buildModelList() {\n161:             if (getTarget() != null) {\n162:                 removeAllElements();\n163:                 Object classifier = Model.getFacade().getOwner(getTarget());\n164:                 addAll(Model.getFacade().getOperations(classifier));\n165:             }\n166:         }\n167: \n168:         /**\n169:          * @see org.argouml.uml.ui.UMLComboBoxModel2#getSelectedModelElement()\n170:          */\n171:         protected Object getSelectedModelElement() {\n172:             return Model.getCoreHelper().getSpecification(getTarget());\n173:         }\n174: \n175:         /**\n176:          * @see java.beans.PropertyChangeListener#propertyChange(\n177:          *         java.beans.PropertyChangeEvent)\n178:          */\n179:         public void propertyChange(PropertyChangeEvent evt) {\n180:             if (evt instanceof AttributeChangeEvent) {\n181:                 if