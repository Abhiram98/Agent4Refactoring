s.PropertyChangeEvent;\n32: import java.beans.PropertyVetoException;\n33: import java.text.ParseException;\n34: import java.util.Iterator;\n35: \n36: import org.argouml.application.events.ArgoEvent;\n37: import org.argouml.application.events.ArgoEventPump;\n38: import org.argouml.i18n.Translator;\n39: import org.argouml.model.Model;\n40: import org.argouml.notation.Notation;\n41: import org.argouml.ui.ProjectBrowser;\n42: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n43: import org.argouml.uml.generator.ParserDisplay;\n44: import org.tigris.gef.graph.GraphModel;\n45: import org.tigris.gef.presentation.FigRect;\n46: import org.tigris.gef.presentation.FigText;\n47: \n48: \n49: /**\n50:  * Class to display graphics for a UML ObjectFlowState in a diagram.<p>\n51:  *\n52:  * The Fig of this modelelement may either contain the Classifier name, or\n53:  * it contains the name of the ClassifierInState AND the name of its state.\n54:  * In the examples in the UML standard, this is written like<pre>\n55:  *      PurchaseOrder\n56:  *       [approved]\n57:  * </pre>\n58:  * i.e. in 2 lines. The first line is underlined,\n59:  * to indicate that it is an instance (object).<p>\n60:  *\n61:  * The fact that the first line is underlined, and the 2nd not, is the\n62:  * reason to implement them in 2 seperate Figs.<p>\n63:  *\n64:  * TODO: Allow stereotypes to be shown.\n65:  *\n66:  * @author mvw\n67:  */\n68: public class FigObjectFlowState extends FigNodeModelElement {\n69: \n70:     private static final int PADDING = 8;\n71:     private static final int OFFSET = 10;\n72:     private static final int WIDTH = 70;\n73:     private static final int HEIGHT = 40;\n74: \n75:     private FigRect cover;\n76:     private FigText classifier; // the classifier(instate) name\n77:     private FigText state;      // the state name\n78: \n79:     ////////////////////////////////////////////////////////////////\n80:     // constructors\n81: \n82:     /**\n83:      * Main Constructor FigObjectFlowState (called from file loading).\n84:      */\n85:     public FigObjectFlowState() {\n86:         setBigPort(new FigRect(OFFSET, OFFSET, WIDTH, HEIGHT,\n87:                 Color.cyan, Color.cyan));\n88:         cover =\n89:             new FigRect(OFFSET, OFFSET, WIDTH, HEIGHT,\n90:                     Color.black, Color.white);\n91: \n92:         classifier = new FigText(OFFSET, HEIGHT - OFFSET, WIDTH, 21);\n93:         classifier.setFont(getLabelFont());\n94:         classifier.setTextColor(Color.black);\n95:         classifier.setReturnAction(FigText.END_EDITING);\n96:         classifier.setTabAction(FigText.END_EDITING);\n97:         classifier.setLineWidth(0);\n98:         classifier.setFilled(false);\n99:         classifier.setUnderline(true);\n100: \n101:         state = new FigText(OFFSET, OFFSET, WIDTH, 21);\n102:         state.setFont(getLabelFont());\n103:         state.setTextColor(Color.black);\n104:         state.setReturnAction(FigText.END_EDITING);\n105:         state.setReturnAction(FigText.END_EDITING);\n106:         state.setLineWidth(0);\n107:         state.setFilled(false);\n108: \n109:         // add Figs to the FigNode in back-to-front order\n110:         addFig(getBigPort());\n111:         addFig(cover);\n112:         addFig(classifier);\n113:         addFig(state);\n114: \n115:         enableSizeChecking(false);\n116:         setReadyToEdit(false);\n117:         Rectangle r = getBounds();\n118:         setBounds(r.x, r.y, r.width, r.height);\n119: \n120:         setNameFig(null); // DEBUG only!\n121: \n122:         ArgoEventPump.addListener(ArgoEvent.ANY_NOTATION_EVENT, this);\n123:     }\n124: \n125:     /**\n126:      * Constructor FigObjectFlowState that hooks the Fig into\n127:      * an existing UML model element.\n128:      *\n129:      * @param gm ignored!\n130:      * @param node owner, i.e. the UML element\n131:      */\n132:     public FigObjectFlowState(GraphModel gm, Object node) {\n133:         this();\n134:         setOwner(node);\n135:         enableSizeChecking(true);\n136:     }\n137: \n138:     /**\n139:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#modelChanged(java.beans.PropertyChangeEvent)\n140:      */\n141:     protected void modelChanged(PropertyChangeEvent mee) {\n142:         super.modelChanged(mee);\n143:         if ((mee.getSource() == getOwner())\n144:             || (mee.getSource() == Model.getFacade().getType(getOwner()))) {\n145:             renderingChanged();\n146:         }\n147:     }\n148: \n149:     /**\n150:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#placeString()\n151:      */\n152:     public String placeString() {\n153:         return \"new ObjectFlowState\";\n154:     }\n155: \n156:     /**\n157:      * @see java.lang.Object#clone()\n158:      */\n159:     public Object clone() {\n160:         FigObjectFlowState figClone = (FigObjectFlowState) super.clone();\n161:         Iterator it = figClone.getFigs().iterator();\n162:         figClone.setBigPort((FigRect) it.next());\n163:         figClone.cover = (FigRect) it.next();\n164:         figClone.classifier = (FigText) it.next();\n165:         figClone.state = (FigText) it.next();\n166:         return figClone;\n167:     }\n168: \n169:     /**\n170:      * Get the minimum size.\n171:      * The space between the 2 text figs is: PADDING.\n172:      * @see org.tigris.gef.presentation.Fig#getMinimumSize()\n173:      */\n174:     public Dimension getMinimumSize() {\n175:         Dimension tempDim = classifier.getMinimumSize();\n176:         int w = tempDim.width + PADDING * 2;\n177:         int h = tempDim.height + PADDING;\n178:         tempDim = state.getMinimumSize();\n179:         w = Math.max(w, tempDim.width + PADDING * 2);\n180:         h = h + PADDING + tempDim.height + PADDING;\n181: \n182:         return new Dimension(Math.max(w, WIDTH / 2), Math.max(h, HEIGHT / 2));\n183:     }\n184: \n185:     /**\n186:      * Override setBounds to keep shapes looking right.\n187:      * The classifier and state Figs are nicely centered vertically,\n188:      * and stretched out over the full width,\n189:      * to allow easy selection with the mouse.\n190:      * The Fig can only be shrinked to half its original size - so that\n191:      * it is not reduceable to a few pixels only.\n192:      *\n193:      * @see org.tigris.gef.presentation.Fig#setBoundsImpl(int, int, int, int)\n194:      */\n195:     protected void setBoundsImpl(int x, int y, int w, int h) {\n196:         //if (getNameFig() == null) return;\n197:         Rectangle oldBounds = getBounds();\n198: \n199:         Dimension classDim = classifier.getMinimumSize();\n200:         Dimension stateDim = state.getMinimumSize();\n201:         /* the height of the blank space above and below the text figs: */\n202:         int blank = (h - PADDING - classDim.height - stateDim.height) / 2;\n203:         classifier.setBounds(x + PADDING,\n204:                 y + blank,\n205:                 w - PADDING * 2,\n206:                 classDim.height);\n207:         state.setBounds(x + PADDING,\n208:                 y + blank + classDim.height + PADDING,\n209:                 w - PADDING * 2,\n210:                 stateDim.height);\n211: \n212:         getBigPort().setBounds(x, y, w, h);\n213:         cover.setBounds(x, y, w, h);\n214: \n215:         calcBounds();\n216:         updateEdges();\n217:         firePropChange(\"bounds\", oldBounds, getBounds());\n218:     }\n219: \n220:     /**\n221:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#renderingChanged()\n222:      */\n223:     public void renderingChanged() {\n224:         updateClassifierText();\n225:         updateStateText();\n226:         updateBounds();\n227:         damage();\n228:     }\n229: \n230:     /**\n231:      * Updates the text of the classifier FigText.\n232:      */\n233:     private void updateClassifierText() {\n234:         if (isReadyToEdit()) {\n235:             if (getOwner() == null) {\n236:                 return;\n237:             }\n238:             String theNewText =\n239:                 Notation.generate(this, getOwner()); // the ObjectFlowState\n240:             classifier.setText(theNewText);\n241:         }\n242:     }\n243: \n244:     /**\n245:      * Updates the text of the state FigText.\n246:      */\n247:     private void updateStateText() {\n248:         if (isReadyToEdit()) {\n249:             if (getOwner() == null) {\n250:                 return;\n251:             }\n252:             String theNewText = \"\";\n253:             Object cis = Model.getFacade().getType(getOwner());\n254:             if (Model.getFacade().isAClassifierInState(cis)) {\n255:                 theNewText = \"[\" + Notation.generate(this, cis) + \"]\";\n256:             }\n257:             state.setText(theNewText);\n258:         }\n259:     }\n260: \n261:     ////////////////////////////////////////////////////////////////\n262:     // Fig accessors\n263: \n264:     /**\n265:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#getNameFig()\n266:      */\n267:     public FigText getNameFig() {\n268:         return null;\n269:     }\n270: \n271:     /**\n272:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#getName()\n273:      */\n274:     public String getName() {\n275:         return null;\n276:     }\n277: \n278:     /**\n279:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#setName(java.lang.String)\n280:      */\n281:     public void setName(String n) {\n282: \n283:     }\n284: \n285:     /**\n286:      * @see org.tigris.gef.presentation.Fig#setLineColor(java.awt.Color)\n287:      */\n288:     public void setLineColor(Color col) { cover.setLineColor(col); }\n289: \n290:     /**\n291:      * @see org.tigris.gef.presentation.Fig#getLineColor()\n292:      */\n293:     public Color getLineColor() { return cover.getLineColor(); }\n294: \n295:     /**\n296:      * @see org.tigris.gef.presentation.Fig#setFillColor(java.awt.Color)\n297:      */\n298:     public void setFillColor(Color col) { cover.setFillColor(col); }\n299: \n300:     /**\n301:      * @see org.tigris.gef.presentation.Fig#getFillColor()\n302:      */\n303:     public Color getFillColor() { return cover.getFillColor(); }\n304: \n305:     /**\n306:      * @see org.tigris.gef.presentation.Fig#setFilled(boolean)\n307:      */\n308:     public void setFilled(boolean f) {\n309:         cover.setFilled(f);\n310:     }\n311: \n312:     /**\n313:      * @see org.tigris.gef.presentation.Fig#getFilled()\n314:      */\n315:     public boolean getFilled() {\n316:         return cover.getFilled();\n317:     }\n318: \n319:     /**\n320:      * @see org.tigris.gef.presentation.Fig#setLineWidth(int)\n321:      */\n322:     public void setLineWidth(int w) {\n323:         cover.setLineWidth(w);\n324:     }\n325: \n326:     /**\n327:      * @see org.tigris.gef.presentation.Fig#getLineWidth()\n328:      */\n329:     public int getLineWidth() {\n330:         return cover.getLineWidth();\n331:     }\n332: \n333:     /**\n334:      * @see java.awt.event.KeyListener#keyTyped(java.awt.event.KeyEvent)\n335:      */\n336:     public void keyTyped(KeyEvent ke) {\n337:         // TODO: Review - should be keyTyped()??? - Bob\n338:         if (!isReadyToEdit()) {\n339:             if (Model.getFacade().isAModelElement(getOwner())) {\n340:                 updateClassifierText();\n341:                 updateStateText();\n342:                 setReadyToEdit(true);\n343:             } else {\n344:                 //LOG.debug(\"not ready to edit name\");\n345:                 return;\n346:             }\n347:         }\n348:         if (ke.isConsumed() || getOwner() == null) {\n349:             return;\n350:         }\n351:         classifier.keyPressed(ke);\n352:     }\n353: \n354:     /**\n355:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEdited(org.tigris.gef.presentation.FigText)\n356:      */\n357:     protected void textEdited(FigText ft) throws PropertyVetoException {\n358:         try {\n359:             if (ft == classifier && this.getOwner() != null) {\n360:                 ParserDisplay.SINGLETON.parseObjectFlowState1(ft.getText(),\n361:                     this.getOwner());\n362:             } else if (ft == state && this.getOwner() != null) {\n363:                 ParserDisplay.SINGLETON.parseObjectFlowState2(ft.getText(),\n364:                         this.getOwner());\n365:             }\n366:             ProjectBrowser.getInstance().getStatusBar().showStatus(\"\");\n367:         } catch (ParseException pe) {\n368:             String msg = \"statusmsg.bar.error.parsing.objectflowstate\";\n369:             Object[] args = {\n370:                 pe.getLocalizedMessage(),\n371:                 new Integer(pe.getErrorOffset()),\n372:             };\n373:             ProjectBrowser.getInstance().getStatusBar().showStatus(\n374:                     Translator.messageFormat(msg, args));\n375:             updateClassifierText();\n376:             updateStateText();\n377:         }\n378:     }\n379: \n380:     /**\n381:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEditStarted(org.tigris.gef.presentation.FigText)\n382:      */\n383:     protected void textEditStarted(FigText ft) {\n384:         if (ft == classifier) {\n385:             showHelp(\"parsing.help.fig-objectflowstate1\");\n386:         }\n387:         if (ft == state) {\n388:             showHelp(\"parsing.help.fig-objectflowstate2\");\n389:         }\n390:     }\n391: \n392: } /* end class FigObjectFlowState */\n393: ",
