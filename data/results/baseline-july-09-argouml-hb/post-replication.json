g.argouml.kernel.ProjectManager;\n34: import org.argouml.model.ModelFacade;\n35: import org.argouml.model.uml.ExtensionMechanismsFactory;\n36: import org.argouml.model.uml.ExtensionMechanismsHelper;\n37: import org.argouml.model.uml.UmlFactory;\n38: import org.argouml.model.uml.UmlHelper;\n39: \n40: import ru.novosoft.uml.behavior.collaborations.MClassifierRole;\n41: import ru.novosoft.uml.foundation.core.MAttribute;\n42: import ru.novosoft.uml.foundation.core.MClassifier;\n43: import ru.novosoft.uml.foundation.core.MNamespace;\n44: import ru.novosoft.uml.foundation.core.MOperation;\n45: import ru.novosoft.uml.foundation.core.MParameter;\n46: import ru.novosoft.uml.foundation.data_types.MMultiplicity;\n47: import ru.novosoft.uml.foundation.data_types.MParameterDirectionKind;\n48: import ru.novosoft.uml.foundation.extension_mechanisms.MStereotype;\n49: \n50: /**\n51:  * Testing the ParserDisplay class.<p>\n52:  *\n53:  * For some mysterious reason these tests depend on the ProjectBrowser\n54:  * which means that they cannot be run in Headless mode.\n55:  */\n56: public class GUITestParserDisplay extends TestCase {\n57:     private static final String ATTR01 = \"name\";\n58:     private static final String ATTR02 = \"+name\";\n59:     private static final String ATTR03 = \"-name : void\";\n60:     private static final String ATTR04 = \"#name [1..1] : int {a=b}\";\n61:     private static final String ATTR05 = \n62: \t\"public name {a=b, c = d } : [1..*] int = 0\";\n63:     private static final String ATTR06 =\n64: \t\"private name {a=b, c = d } [*..*] : int = 15 {frozen}\";\n65:     private static final String ATTR07 = \"+name : String = \\'val[15] \\'\";\n66:     private static final String ATTR08 = \n67: \t\"  + name : String = \\\"a <<string>>\\\"\";\n68:     private static final String ATTR09 = \"+name : String = (a * (b+c) - d)\";\n69:     private static final String ATTR10 =\n70: \t\"+name << attrstereo1 >> : String = 2 * (b+c) - 10\";\n71:     private static final String ATTR11 =\n72: \t\"<<attrstereo2>> +name : String = a[15]\";\n73:     private static final String ATTR12 = \"+ name : String = a << 5\";\n74: \n75:     private static final String NATTR01 = \"too many string in an attribute\";\n76:     private static final String NATTR02 = \"+vis name\";\n77:     private static final String NATTR03 = \"vis name : type : type\";\n78:     private static final String NATTR04 = \"vis name = 0 = 1\";\n79:     private static final String NATTR05 = \"vis name [1..1] [1..1]\";\n80:     private static final String NATTR06 = \"vis name [1..1\";\n81:     private static final String NATTR07 = \"vis name { a = b, cv = \";\n82:     private static final String NATTR08 = \"vis \\\"name\\\"\";\n83:     private static final String NATTR09 = \"\\\"vis\\\" name\";\n84:     private static final String NATTR10 = \"vis (name)\";\n85:     private static final String NATTR11 = \"(vis) name\";\n86:     private static final String NATTR12 = \"vis name : \\\"type\\\"\";\n87:     private static final String NATTR13 = \"vis name : (type)\";\n88: \n89:     private static final String OPER01 = \"name()\";\n90:     private static final String OPER02 =\n91: \t\"<<opstereo1>> -name(in foo: float = 0) \"\n92: \t+ \"{root, abstract = false} : int\";\n93:     private static final String OPER03 =\n94: \t\"<< opstereo2 >> protected name2(\"\n95: \t+ \"out foo: double = 0., inout bar = \\\"\\\"some\\\"\\\":String) \"\n96: \t+ \"{leaf,query} : String\";\n97:     private static final String OPER04 = \"<<>> # name2()\";\n98: \n99:     private static final String NOPER01 = \"name(\";\n100:     private static final String NOPER02 = \"\\\"name\\\"()\";\n101:     private static final String NOPER03 = \"\\\"vis\\\" name()\";\n102:     private static final String NOPER04 = \"\\'name\\'()\";\n103:     private static final String NOPER05 = \"\\'vis\\' name()\";\n104:     private static final String NOPER06 = \"(name)()\";\n105:     private static final String NOPER07 = \"(vis) name()\";\n106:     private static final String NOPER08 = \"name() : \\\"type\\\"\";\n107:     private static final String NOPER09 = \"name() : \\'type\\'\";\n108:     private static final String NOPER10 = \"name() : (type)\";\n109: \n110: \n111:     /**\n112:      * @see junit.framework.TestCase#TestCase()\n113:      */\n114:     public GUITestParserDisplay(String str) {\n115: \tsuper(str);\n116:     }\n117: \n118:     /**\n119:      * Test the parsing of an attribute name.\n120:      *\n121:      * @throws ParseException if the parsing fails.\n122:      */\n123:     public void testAttributeName()\n124: \tthrows ParseException\n125:     {\n126:         Object feature;\n127:         \n128:         MNamespace ns = (MNamespace)\n129:             ProjectManager.getManager().getCurrentProject().getModel();\n130:         \n131:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n132:         ModelFacade.setNamespace(feature, ns);\n133:         \n134:         checkName(feature, ATTR01, \"name\");\n135:         \n136:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n137:         ModelFacade.setNamespace(feature, ns);\n138:         \n139:         checkName(feature, ATTR02, \"name\");\n140:         \n141:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n142:         ModelFacade.setNamespace(feature, ns);\n143:         \n144:         checkName(feature, ATTR03, \"name\");\n145:         \n146:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n147:         ModelFacade.setNamespace(feature, ns);\n148:         \n149:         checkName(feature, ATTR04, \"name\");\n150:         \n151:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n152:         ModelFacade.setNamespace(feature, ns);\n153:         \n154:         checkName(feature, ATTR05, \"name\");\n155:         \n156:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n157:         ModelFacade.setNamespace(feature, ns);\n158:         \n159:         checkName(feature, ATTR06, \"name\");\n160:     }\n161: \n162: \n163:     /**\n164:      * Test the parsing of an attribute's type.\n165:      *\n166:      * @throws ParseException if the parsing fails.\n167:      */\n168:     public void testAttributeType() throws ParseException {\n169:         Object feature;\n170:         \n171:         MNamespace ns =  (MNamespace)\n172:             ProjectManager.getManager().getCurrentProject().getModel();\n173:         \n174:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n175:         ModelFacade.setNamespace(feature, ns);\n176:         \n177:         checkType(feature, ATTR03, \"void\");\n178:         \n179:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n180:         ModelFacade.setNamespace(feature, ns);\n181:         \n182:         checkType(feature, ATTR04, \"int\");\n183:         \n184:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n185:         ModelFacade.setNamespace(feature, ns);\n186:         \n187:         checkType(feature, ATTR05, \"int\");\n188:         \n189:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n190:         ModelFacade.setNamespace(feature, ns);\n191:         \n192:         checkType(feature, ATTR06, \"int\");\n193:     }\n194: \n195:     /**\n196:      * Test the parsing of the attribute's visibility.\n197:      *\n198:      * @throws ParseException if the parsing fails.\n199:      */\n200:     public void testAttributeVisibility() throws ParseException {\n201:         Object feature;\n202:         \n203:         MNamespace ns =  (MNamespace)\n204:             ProjectManager.getManager().getCurrentProject().getModel();\n205:         \n206:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n207:         ModelFacade.setNamespace(feature, ns);\n208:         \n209:         checkVisibility(feature, ATTR02, \"public\");\n210:         \n211:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n212:         ModelFacade.setNamespace(feature, ns);\n213:         \n214:         checkVisibility(feature, ATTR03, \"private\");\n215:         \n216:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n217:         ModelFacade.setNamespace(feature, ns);\n218:         \n219:         checkVisibility(feature, ATTR04, \"protected\");\n220:         \n221:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n222:         ModelFacade.setNamespace(feature, ns);\n223:         \n224:         checkVisibility(feature, ATTR05, \"public\");\n225:         checkVisibility(feature, ATTR01, \"public\");\n226:         \n227:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n228:         ModelFacade.setNamespace(feature, ns);\n229:         \n230:         checkVisibility(feature, ATTR06, \"private\");\n231:         checkVisibility(feature, ATTR01, \"private\");\n232:         \n233:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n234:         ModelFacade.setNamespace(feature, ns);\n235:         \n236:         checkVisibility(feature, ATTR08, \"public\");\n237:         \n238:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n239:         ModelFacade.setNamespace(feature, ns);\n240:         \n241:         checkVisibility(feature, ATTR11, \"public\");\n242:     }\n243: \n244:     /**\n245:      * Test the parsing of an attribute's property.\n246:      *\n247:      * @throws ParseException if the parsing fails.\n248:      */\n249:     public void testAttributeProperty() throws ParseException {\n250:         Object feature;\n251:         String res1[] = {\n252:             \"a\", \"b\" \n253:         };\n254:         String res2[] = {\n255:             \"a\", \"b\", \"c\", \"d\"\n256:         };\n257:         String res3[] = {\n258:             \"a\", \"b\", \"c\", \"d\", \"frozen\", null \n259:         };\n260:         \n261:         MNamespace ns =  (MNamespace)\n262:             ProjectManager.getManager().getCurrentProject().getModel();\n263:         \n264:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n265:         ModelFacade.setNamespace(feature, ns);\n266:         \n267:         checkProperties(feature, ATTR04, res1);\n268:         \n269:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n270:         ModelFacade.setNamespace(feature, ns);\n271:         \n272:         checkProperties(feature, ATTR05, res2);\n273:         \n274:         feature = UmlFactory.getFactory().getCore().buildAttribute();\n275:         ModelFacade.setNamespace(feature, ns);\n276:         \n277:         checkProperties(feature, ATTR06, res3);\n278:     }\n279: \n280:     /**\n281:      * Test parsing an attribute's multiplicity.\n282:      *\n283:      * @throws ParseException if the parsing fails.\n284:      */\n285:     public void testAttributeMultiplicity() throws ParseException {\n286:         Object attr;\n287:         \n288:         MNamespace ns =  (MNamespace)\n289:             ProjectManager.getManager().getCurrentProject().getModel();\n290:         \n291:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n292:         ModelFacade.setNamespace(attr, ns);\n293:         \n294:         checkMultiplicity(attr, ATTR04, new MMultiplicity(\"1..1\"));\n295:         \n296:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n297:         ModelFacade.setNamespace(attr, ns);\n298:         \n299:         checkMultiplicity(attr, ATTR05, new MMultiplicity(\"1..*\"));\n300:         \n301:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n302:         ModelFacade.setNamespace(attr, ns);\n303:         \n304:         checkMultiplicity(attr, ATTR06, new MMultiplicity(\"*..*\"));\n305:     }\n306: \n307:     /**\n308:      * Test that the parser throws the correct exceptions.\n309:      *\n310:      * @throws ParseException if the parsing fails.\n311:      */\n312:     public void testAttributeParseExceptions() throws ParseException {\n313:         Object attr;\n314:         \n315:         MNamespace ns =  (MNamespace)\n316:             ProjectManager.getManager().getCurrentProject().getModel();\n317:         \n318:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n319:         ModelFacade.setNamespace(attr, ns);\n320:         \n321:         checkThrows(attr, NATTR01, true, false, false);\n322:         checkThrows(attr, NATTR02, true, false, false);\n323:         checkThrows(attr, NATTR03, true, false, false);\n324:         checkThrows(attr, NATTR04, true, false, false);\n325:         checkThrows(attr, NATTR05, true, false, false);\n326:         checkThrows(attr, NATTR06, true, false, false);\n327:         checkThrows(attr, NATTR07, true, false, false);\n328:         checkThrows(attr, NATTR08, true, false, false);\n329:         checkThrows(attr, NATTR09, true, false, false);\n330:         checkThrows(attr, NATTR10, true, false, false);\n331:         checkThrows(attr, NATTR11, true, false, false);\n332:         checkThrows(attr, NATTR12, true, false, false);\n333:         checkThrows(attr, NATTR13, true, false, false);\n334:     }\n335: \n336:     /**\n337:      * Test the parsing of an attribute's value.\n338:      *\n339:      * @throws ParseException if the parsing fails.\n340:      */\n341:     public void testAttributeValue() throws ParseException {\n342:         Object attr;\n343:         \n344:         MNamespace ns =  (MNamespace)\n345:             ProjectManager.getManager().getCurrentProject().getModel();\n346:         \n347:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n348:         ModelFacade.setNamespace(attr, ns);\n349:         \n350:         checkValue(attr, ATTR05, \"0\");\n351:         checkValue(attr, ATTR01, \"0\");\n352:         checkValue(attr, ATTR06, \"15\");\n353:         \n354:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n355:         ModelFacade.setNamespace(attr, ns);\n356:         \n357:         checkValue(attr, ATTR07, \"\\'val[15] \\'\");\n358:         \n359:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n360:         ModelFacade.setNamespace(attr, ns);\n361:         \n362:         checkValue(attr, ATTR08, \"\\\"a <<string>>\\\"\");\n363:         \n364:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n365:         ModelFacade.setNamespace(attr, ns);\n366:         \n367:         checkValue(attr, ATTR09, \"(a * (b+c) - d)\");\n368:         \n369:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n370:         ModelFacade.setNamespace(attr, ns);\n371:         \n372:         checkValue(attr, ATTR10, \"2 * (b+c) - 10\");\n373:         \n374:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n375:         ModelFacade.setNamespace(attr, ns);\n376:         \n377:         checkValue(attr, ATTR11, \"a[15]\");\n378:         \n379:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n380:         ModelFacade.setNamespace(attr, ns);\n381:         \n382:         checkValue(attr, ATTR12, \"a << 5\");\n383:     }\n384: \n385:     private void softAddStereotype(String name, Object elem)\n386:         throws ParseException {\n387:         MNamespace ns =  (MNamespace)\n388:             ProjectManager.getManager().getCurrentProject().getModel();\n389:         \n390:         Iterator it =\n391:             ExtensionMechanismsHelper.getHelper()\n392:                 .getStereotypes(ns).iterator();\n393:         while (it.hasNext()) {\n394:             MStereotype s = (MStereotype) it.next();\n395:             if (name.equals(s.getName())) {\n396:                 return;\n397:             }\n398:         }\n399:         ExtensionMechanismsFactory.getFactory().buildStereotype(\n400:             elem, \n401:             name,\n402:             ns);\n403:     }\n404: \n405: \n406:     /**\n407:      * Test the parsing of an attribute's stereotype.\n408:      *\n409:      * @throws ParseException if the parsing fails.\n410:      */\n411:     public void testAttributeStereotype() throws ParseException {\n412:         Object attr;\n413:         \n414:         MNamespace ns =  (MNamespace)\n415:             ProjectManager.getManager().getCurrentProject().getModel();\n416:         \n417:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n418:         ModelFacade.setNamespace(attr, ns);\n419:         \n420:         softAddStereotype(\"attrstereo1\", attr);\n421:         softAddStereotype(\"attrstereo2\", attr);\n422:         \n423:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n424:         ModelFacade.setNamespace(attr, ns);\n425:         \n426:         checkStereotype(attr, ATTR01, null);\n427:         \n428:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n429:         ModelFacade.setNamespace(attr, ns);\n430:         \n431:         checkStereotype(attr, ATTR10, \"attrstereo1\");\n432:         \n433:         attr = UmlFactory.getFactory().getCore().buildAttribute();\n434:         ModelFacade.setNamespace(attr, ns);\n435:         \n436:         checkStereotype(attr, ATTR11, \"attrstereo2\");\n437:         checkStereotype(attr, ATTR01, \"attrstereo2\");\n438:     }\n439: \n440:     /**\n441:      * Test the parsing of an operation's name.\n442:      *\n443:      * @throws ParseException if the parsing fails.\n444:      */\n445:     public void testOperationName() throws ParseException {\n446:         MOperation op;\n447:         Object cl = UmlFactory.getFactory().getCore().buildClass();\n448:         \n449:         MNamespace ns =  (MNamespace)\n450:             ProjectManager.getManager().getCurrentProject().getModel();\n451:         \n452:         ModelFacade.setNamespace(cl, ns);\n453:         \n454:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n455:         checkName(op, OPER01, \"name\");\n456:         \n457:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n458:         checkName(op, OPER02, \"name\");\n459:         \n460:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n461:         checkName(op, OPER03, \"name2\");\n462:     }\n463: \n464:     /**\n465:      * Test the parsing of an operation's type.\n466:      *\n467:      * @throws ParseException if the parsing fails.\n468:      */\n469:     public void testOperationType() throws ParseException {\n470:         MOperation op;\n471:         Object cl = UmlFactory.getFactory().getCore().buildClass();\n472:         \n473:         MNamespace ns =  (MNamespace)\n474:             ProjectManager.getManager().getCurrentProject().getModel();\n475:         \n476:         ModelFacade.setNamespace(cl, ns);\n477:         \n478:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n479:         checkType(op, OPER01, \"void\");\n480:         \n481:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n482:         checkType(op, OPER02, \"int\");\n483:         checkType(op, OPER01, \"int\");\n484:         \n485:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n486:         checkType(op, OPER03, \"String\");\n487:     }\n488: \n489:     /**\n490:      * Test the parsing of an operation's visibility.\n491:      *\n492:      * @throws ParseException if the parsing fails.\n493:      */\n494:     public void testOperationVisibility() throws ParseException {\n495:         MOperation op;\n496:         Object cl = UmlFactory.getFactory().getCore().buildClass();\n497:         MNamespace ns =  (MNamespace)\n498:             ProjectManager.getManager().getCurrentProject().getModel();\n499:         \n500:         ModelFacade.setNamespace(cl, ns);\n501:         \n502:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n503:         checkVisibility(op, OPER01, \"public\");\n504:         \n505:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n506:         checkVisibility(op, OPER02, \"private\");\n507:         \n508:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n509:         checkVisibility(op, OPER03, \"protected\");\n510:         checkVisibility(op, OPER01, \"protected\");\n511:         checkVisibility(op, OPER02, \"private\");\n512:         \n513:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n514:         checkVisibility(op, OPER04, \"protected\");\n515:     }\n516: \n517:     /**\n518:      * Test the parsing of an operation's parameters.\n519:      *\n520:      * @throws ParseException if the parsing fails.\n521:      */\n522:     public void testOperationParameters() throws ParseException {\n523:         MOperation op;\n524:         Object cl = UmlFactory.getFactory().getCore().buildClass();\n525:         MNamespace ns =  (MNamespace)\n526:             ProjectManager.getManager().getCurrentProject().getModel();\n527:         \n528:         ModelFacade.setNamespace(cl, ns);\n529:         \n530:         String res1[] = {\n531:         };\n532:         String res2[] = {\n533:             \"in\", \"foo\", \"float\", \"0\" \n534:         };\n535:         String res3[] = {\n536:             \"out\",\n537:             \"foo\",\n538:             \"double\",\n539:             \"0.\",\n540:             \"inout\",\n541:             \"bar\",\n542:             \"String\",\n543:             \"\\\"\\\"some\\\"\\\"\" \n544:         };\n545:         \n546:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n547:         checkParameters(op, OPER01, res1);\n548:         \n549:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n550:         checkParameters(op, OPER02, res2);\n551:         \n552:         op = UmlFactory.getFactory().getCore().buildOperation(cl);\n553:         checkParameters(op, OPER03, res3);\n554:         checkParameters(op, OPER01, res1);\n555:         checkParameters(op, OPER