    public Collection getAllSupertypes(Object cls1) {\n123:         \n124:         if (!(cls1 instanceof MClassifier))\n125:             throw new IllegalArgumentException();\n126:         \n127:         MClassifier cls = (MClassifier) cls1;\n128:         \n129:         Collection result = new HashSet();\n130:         Collection add = getSupertypes(cls);\n131:         do {\n132:             Collection newAdd = new HashSet();\n133:             Iterator addIter = add.iterator();\n134:             while (addIter.hasNext()) {\n135:                 MGeneralizableElement next =\n136:                     (MGeneralizableElement) addIter.next();\n137:                 if (next instanceof MClassifier) {\n138:                     newAdd.addAll(getSupertypes(next));\n139:                 }\n140:             }\n141:             result.addAll(add);\n142:             add = newAdd;\n143:             add.removeAll(result);\n144:         }\n145:         while (!add.isEmpty());\n146:         return result;\n147:     }\n148: \n149:     /**\n150:      * This method returns all Classifiers of which this class is a\n151:      * direct subtype.<p>\n152:      *\n153:      * @param ogeneralizableelement the class you want to have the parents for\n154:      * @return a collection of the parents, each of which is a\n155:      *         {@link MGeneralizableElement MGeneralizableElement}\n156:      */\n157:     public Collection getSupertypes(Object ogeneralizableelement) {\n158:         Collection result = new HashSet();\n159:         if (ModelFacade.isAGeneralizableElement(ogeneralizableelement)) {\n160:             MGeneralizableElement cls =\n161:                 (MGeneralizableElement) ogeneralizableelement;\n162:             Collection gens = cls.getGeneralizations();\n163:             Iterator genIterator = gens.iterator();\n164:             while (genIterator.hasNext()) {\n165:                 MGeneralization next = (MGeneralization) genIterator.next();\n166:                 result.add(next.getParent());\n167:             }\n168:         }\n169:         return result;\n170:     }\n171: \n172:     /** This method returns all opposite AssociationEnds of a given\n173:      * Classifier\n174:      *\n175:      * @param classifier the classifier you want to have the opposite\n176:      * association ends for\n177:      * @return a collection of the opposite associationends\n178:      */\n179:     public Collection getAssociateEnds(MClassifier classifier) {\n180:         Collection result = new ArrayList();\n181:         Iterator ascends = classifier.getAssociationEnds().iterator();\n182:         while (ascends.hasNext()) {\n183:             MAssociationEnd ascend = (MAssociationEnd) ascends.next();\n184:             if ((ascend.getOppositeEnd() != null))\n185:                 result.add(ascend.getOppositeEnd());\n186:         }\n187:         return result;\n188:     }\n189: \n190:     /**\n191:      * This method returns all opposite AssociationEnds of a given\n192:      * Classifier, including inherited\n193:      *\n194:      * @param classifier1 the classifier you want to have the opposite\n195:      * association ends for\n196:      * @return a collection of the opposite associationends\n197:      */\n198:     public Collection getAssociateEndsInh(Object classifier1) {\n199:         \n200:         if (!(classifier1 instanceof MClassifier))\n201:             throw new IllegalArgumentException();\n202:         \n203:         MClassifier classifier = (MClassifier) classifier1;\n204:         \n205:         Collection result = new ArrayList();\n206:         result.addAll(getAssociateEnds(classifier));\n207:         Iterator parents = classifier.getParents().iterator();\n208:         while (parents.hasNext()) {\n209:             result.addAll(getAssociateEndsInh(parents.next()));\n210:         }\n211:         return result;\n212:     }\n213: \n214:     /**\n215:      * This method removes a feature from a classifier.\n216:      *\n217:      * @param cls the classifier\n218:      * @param feature the feature to be removed\n219:      */\n220:     public void removeFeature(Object cls, Object feature) {\n221:         if (cls != null\n222:             && feature != null\n223:             && cls instanceof MClassifier\n224:             && feature instanceof MFeature) {\n225:             ((MClassifier) cls).removeFeature((MFeature) feature);\n226:         }\n227:     }\n228: \n229:     /**\n230:      * This method returns the name of a feature.\n231:      *\n232:      * @param o is the feature\n233:      * @return name\n234:      */\n235:     public String getFeatureName(Object o) {\n236:         if (o != null && o instanceof MFeature)\n237:             return ((MFeature) o).getName();\n238:         return null;\n239:     }\n240: \n241:     /**\n242:      * This method returns if the object is a method.\n243:      *\n244:      * @param o object\n245:      * @return true if it's a method, false if not\n246:      */\n247:     public boolean isMethod(Object o) {\n248:         return (o instanceof MMethod);\n249:     }\n250: \n251:     /** This method returns if the object is an operation.\n252:      *\n253:      * @param o object\n254:      * @return true if it's an operation, false if not\n255:      */\n256:     public boolean isOperation(Object o) {\n257:         return (o instanceof MOperation);\n258:     }\n259:     /** This method returns all operations of a given Classifier\n260:      *\n261:      * @param classifier the classifier you want to have the operations for\n262:      * @return a collection of the operations\n263:      */\n264:     public Collection getOperations(Object classifier) {\n265:         Collection result = new ArrayList();\n266:         if (ModelFacade.isAClassifier(classifier)) {\n267:             MClassifier mclassifier = (MClassifier) classifier;\n268:             Iterator features = mclassifier.getFeatures().iterator();\n269:             while (features.hasNext()) {\n270:                 MFeature feature = (MFeature) features.next();\n271:                 if (ModelFacade.isAOperation(feature))\n272:                     result.add(feature);\n273:             }\n274:         }\n275:         return result;\n276:     }    \n277: \n278:     /** This method returns all attributes of a given Classifier.\n279:      *\n280:      * @param classifier the classifier you want to have the attributes for\n281:      * @return a collection of the attributes\n282:      */\n283:     public Collection getAttributes(MClassifier classifier) {\n284: \tCollection result = new ArrayList();\n285: \tIterator features = classifier.getFeatures().iterator();\n286: \twhile (features.hasNext()) {\n287: \t    MFeature feature = (MFeature) features.next();\n288: \t    if (feature instanceof MAttribute)\n289: \t\tresult.add(feature);\n290: \t}\n291: \treturn result;\n292:     }  \n293: \n294:     /** This method returns all attributes of a given Classifier,\n295:      * including inherited\n296:      *\n297:      * @param classifier the classifier you want to have the attributes for\n298:      * @return a collection of the attributes\n299:      */\n300:     public Collection getAttributesInh(Object classifier) {\n301:         \n302:         if (!(classifier instanceof MClassifier))\n303:             throw new IllegalArgumentException();\n304:         \n305:         Collection result = new ArrayList();\n306:         result.addAll(ModelFacade.getStructuralFeatures(classifier));\n307:         Iterator parents = ((MClassifier) classifier).getParents().iterator();\n308:         while (parents.hasNext()) {\n309:             MClassifier parent = (MClassifier) parents.next();\n310:             LOG.debug(\"Adding attributes for: \" + parent);\n311:             result.addAll(getAttributesInh(parent));\n312:         }\n313:         return result;\n314:     }\n315: \n316:     /** This method returns all operations of a given Classifier,\n317:      * including inherited\n318:      *\n319:      * @param classifier the classifier you want to have the operations for\n320:      * @return a collection of the operations\n321:      */\n322:     public Collection getOperationsInh(MClassifier classifier) {\n323:         Collection result = new ArrayList();\n324:         result.addAll(ModelFacade.getOperations(classifier));\n325:         Iterator parents = classifier.getParents().iterator();\n326:         while (parents.hasNext()) {\n327:             result.addAll(getOperationsInh((MClassifier) parents.next()));\n328:         }\n329:         return result;\n330:     }\n331: \n332:     /**\n333:      * This method finds all paramters of the given operation which\n334:      * have the MParamterDirectionType RETURN. If it is only one, it\n335:      * is returned.  In case there are no return parameters, null is\n336:      * returned. If there is more than one return paramter, first of\n337:      * them is returned, but a message is logged.<p>\n338:      *\n339:      * @param operation1 the operation you want to find the return\n340:      * parameter for.\n341:      * @return If this operation has only one paramter with Kind: RETURN,\n342:      *         this is it, otherwise null\n343:      */\n344:     public MParameter getReturnParameter(Object operation1) {\n345:         \n346:         if (!(operation1 instanceof MOperation))\n347:             throw new IllegalArgumentException();\n348:         \n349:         MOperation operation = (MOperation) operation1;\n350:         \n351:         Vector returnParams = new Vector();\n352:         Iterator params = operation.getParameters().iterator();\n353:         while (params.hasNext()) {\n354:             MParameter parameter = (MParameter) params.next();\n355:             if ((parameter.getKind()).equals(MParameterDirectionKind.RETURN)) {\n356:                 returnParams.add(parameter);\n357:             }\n358:         }\n359:         switch (returnParams.size()) {\n360: \tcase 1 :\n361: \t    return (MParameter) returnParams.elementAt(0);\n362: \tcase 0 :\n363: \t    //Next line gives too many strings while debugging\n364: \t    // obscuring other errors.\n365: \t    //cat.debug(\"No ReturnParameter found!\");\n366: \t    return null;\n367: \tdefault :\n368: \t    LOG.debug(\n369: \t\t      \"More than one ReturnParameter found, returning first!\");\n370: \t    return (MParameter) returnParams.elementAt(0);\n371:         }\n372:     }\n373:     /**\n374:      * Returns all return parameters for an operation.\n375:      *\n376:      * @param operation is the operation.\n377:      * @return Collection\n378:      */\n379:     public Collection getReturnParameters(Object operation) {\n380:         Vector returnParams = new Vector();\n381:         Iterator params = ((MOperation) operation).getParameters().iterator();\n382:         while (params.hasNext()) {\n383:             MParameter parameter = (MParameter) params.next();\n384:             if ((parameter.getKind()).equals(MParameterDirectionKind.RETURN)) {\n385:                 returnParams.add(parameter);\n386:             }\n387:         }\n388:         return returnParams;\n389:     }\n390:     \n391:     /**\n392:      * Returns the operation that some method realized. Returns null if\n393:      * object isn't a method or, possibly, if the method isn't properly\n394:      * defined.\n395:      *\n396:      * @param object  the method you want the realized operation of.\n397:      * @return an operation, or null.\n398:      */\n399:     public MOperation getSpecification(Object object) {\n400: \tif (!(object instanceof MMethod))\n401: \t    return null;\n402: \treturn ((MMethod) object).getSpecification();\n403:     }\n404: \n405:     /**\n406:      * Returns all Interfaces of which this class is a realization.<p>\n407:      *\n408:      * @param classifier  the class you want to have the interfaces for\n409:      * @return a collection of the Interfaces\n410:      */\n411:     public Collection getSpecifications(Object classifier) {\n412:         Collection result = new Vector();\n413:         Collection deps = ((MClassifier) classifier).getClientDependencies();\n414:         Iterator depIterator = deps.iterator();\n415:         while (depIterator.hasNext()) {\n416:             Object dep = depIterator.next();\n417:             Object stereo = null;\n418:             if (ModelFacade.getStereotypes(dep).size() > 0) {\n419:                 stereo = ModelFacade.getStereotypes(dep).iterator().next();\n420:             }\n421:             if ((ModelFacade.isAAbstraction(dep))\n422:                 && stereo != null\n423:                 && ModelFacade.getName(stereo) != null\n424:                 && ModelFacade.getName(stereo).equals(\"realize\")) {\n425: \t\tObject i = ModelFacade.getSuppliers(dep).toArray()[0];\n426:                 result.add(i);\n427:             }\n428:         }\n429:         return result;\n430:     }\n431:     /** This method returns all Classifiers of which this class is a\n432:      *\tdirect supertype.\n433:      *\n434:      * @param cls  the class you want to have the children for\n435:      * @return a collection of the children, each of which is a\n436:      *         {@link MGeneralizableElement MGeneralizableElement}\n437:      */\n438:     public Collection getSubtypes(MClassifier cls) {\n439:         Collection result = new Vector();\n440:         Collection gens = cls.getSpecializations();\n441:         Iterator genIterator = gens.iterator();\n442:         while (genIterator.hasNext()) {\n443:             MGeneralization next = (MGeneralization) genIterator.next();\n444:             result.add(next.getChild());\n445:         }\n446:         return result;\n447:     }\n448:     /**\n449:      * Build a returnparameter. Removes all current return parameters from the\n450:      * operation and adds the supplied parameter. The directionkind of the\n451:      * parameter will be return. The name will be equal to the name of the last\n452:      * found return parameter or the default value \"return\" if no return\n453:      * parameter was present in the operation.\n454:      *\n455:      * @param operation is the operation\n456:      * @param newReturnParameter is the return parameter.\n457:      */\n458:     public void setReturnParameter(Object/*MOperation*/ operation,\n459: \t\t\t\t   Object/*MParameter*/ newReturnParameter) {\n460:         Iterator params = ModelFacade.getParameters(operation).iterator();\n461:         String name = \"return\";\n462:         while (params.hasNext()) {\n463:             MParameter parameter = (MParameter) params.next();\n464:             if ((parameter.getKind()).equals(MParameterDirectionKind.RETURN)) {\n465:                 ModelFacade.removeParameter(operation, parameter);\n466:                 if (parameter.getName() != null || parameter.getName() == \"\") {\n467:                     name = parameter.getName();\n468:                 }\n469:             }\n470:         }\n471:         ModelFacade.setName(newReturnParameter, name);\n472:         ModelFacade.setKind(newReturnParameter, MParameterDirectionKind.RETURN);\n473:         ModelFacade.addParameter(operation, 0, newReturnParameter);\n474:         // we set the listeners to the figs here too\n475:         // it would be better to do that in the figs themselves\n476:         Project p = ProjectManager.getManager().getCurrentProject();\n477:         Iterator it = p.findFigsForMember(operation).iterator();\n478:         while (it.hasNext()) {\n479:             MElementListener listener = (MElementListener) it.next();\n480:             // UmlModelEventPump.getPump().removeModelEventListener(listener,\n481:             // newReturnParameter);\n482:             UmlModelEventPump.getPump()\n483: \t\t.addModelEventListener(listener,\n484: \t\t\t\t       newReturnParameter);\n485:         }\n486:     }\n487: \n488:     /**\n489:      * Builds a dependency with stereotype support.\n490:      *\n491:      * @param from is the model element where the dependency begins\n492:      * @param to is the model element where dependency ends\n493:      * @return a newly created dependency.\n494:      */\n495:     public MDependency buildSupportDependency(MModelElement from,\n496: \t\t\t\t\t      MModelElement to) {\n497:         MDependency dep = CoreFactory.getFactory().buildDependency(from, to);\n498:         ExtensionMechanismsFactory.getFactory()\n499: \t    .buildStereotype(dep, \"support\", getCurrentModel());\n500:         return dep;\n501:     }\n502: \n503:     /**\n504:      * Returns all behavioralfeatures found in this element and its\n505:      * children.<p>\n506:      *\n507:      * @param element is the element\n508:      * @return Collection\n509:      */\n510:     public Collection getAllBehavioralFeatures(MModelElement element) {\n511:         Iterator it = element.getModelElementContents().iterator();\n512:         List list = new ArrayList();\n513:         while (it.hasNext()) {\n514:             Object o = it.next();\n515:             if (o instanceof MClassifier) {\n516:                 list.addAll(getAllBehavioralFeatures((MClassifier) o));\n517:             } else {\n518:                 list.addAll(getAllBehavioralFeatures(\n519: \t\t\t(MModelElement) it.next()));\n520:             }\n521:         }\n522:         return list;\n523:     }\n524:     \n525:     /**\n526:      * Returns all behavioral features of some classifier.\n527:      * @param clazz The classifier\n528:      * @return the collection with all behavioral features of some classifier\n529:      */\n530:     public Collection getBehavioralFeatures(Object clazz) {\n531:         if (ModelFacade.isAClassifier(clazz)) {\n532:             List ret = new ArrayList();\n533:             Iterator it = ModelFacade.getFeatures(clazz).iterator();\n534:             while (it.hasNext()) {\n535:                 Object o = it.next();\n536:                 if (ModelFacade.isABehavioralFeature(o)) {\n537:                     ret.add(o);\n538:                 }      \n539:             }        \n540:             return ret;\n541:         } else {\n542:             throw new IllegalArgumentException(\"Argument is not a classifier\");\n543:         }\n544:     }\n545: \n546:     /**\n547:      * Returns all behavioralfeatures found in this classifier and its\n548:      * children.<p>\n549:      *\n550:      * @param clazz is the classifier.\n551:      * @return Collection\n552:      */\n553:     public Collection getAllBehavioralFeatures(MClassifier clazz) {\n554:         List features = new ArrayList();\n555:         if (!(clazz instanceof MDataType)) {\n556:             Iterator it = clazz.getFeatures().iterator();\n557:             while (it.hasNext()) {\n558:                 Object o = it.next();\n559:                 if (o instanceof MBehavioralFeature) {\n560:                     features.add(o);\n561:                 }\n562:             }\n563:         }\n564:         return features;\n565:     }\n566: \n567:     /**\n568:      * Returns all behavioralfeatures found in the projectbrowser model\n569:      * @return Collection\n570:      */\n571:     public Collection getAllBehavioralFeatures() {\n572:         MNamespace model = getCurrentModel();\n573:         return getAllBehavioralFeatures(model);\n574:     }\n575: \n576:     /**\n577:      * Returns all interfaces found in the projectbrowser model\n578:      * @return Collection\n579:      */\n580:     public Collection getAllInterfaces() {\n581:         MNamespace model = getCurrentModel();\n582:         return getAllInterfaces(model);\n583:     }\n584: \n585:     /**\n586:      * Returns all interfaces found in this namespace and in its children\n587:      * @param ns the given namespace\n588:      * @return Collection with all interfaces found \n589:      */\n590:     public Collection getAllInterfaces(MNamespace ns) {\n591:         if (ns == null)\n592:             return new ArrayList();\n593:         Iterator it = ns.getOwnedElements().iterator();\n594:         List list = new ArrayList();\n595:         while (it.hasNext()) {\n596:             Object o = it.next();\n597:             if (o instanceof MNamespace) {\n598:                 list.addAll(getAllInterfaces((MNamespace) o));\n599:             }\n600:             if (o instanceof MInterface) {\n601:                 list.add(o);\n602:             }\n603:         }\n604:         return list;\n605:     }\n606: \n607:     /**\n608:      * Returns all classes found in the projectbrowser model.<p>\n609:      * @return Collection\n610:      */\n611:     public Collection getAllClasses() {\n612:         MNamespace model = getCurrentModel();\n613:         return getAllClasses(model);\n614:     }\n615: \n616:     /**\n617:      * Returns all classes found in this namespace and in its children.<p>\n618:      *\n619:      * @param ns is the namespace.\n620:      * @return Collection\n621:      */\n622:     public Collection getAllClasses(MNamespace ns) {\n623:         if (ns == null)\n624:             return new ArrayList();\n625:         Iterator it = ns.getOwnedElements().iterator();\n626:         List list = new ArrayList();\n627:         while (it.hasNext()) {\n628:             Object o = it.next();\n629:             if (o instanceof MNamespace) {\n630:                 list.addAll(getAllClasses((MNamespace) o));\n631:             }\n632:             if (o instanceof MClass) {\n633:                 list.add(o);\n634:             }\n635:         }\n636:         return list;\n637:     }\n638: \n639:     /**\n640:      * Return all interfaces the given class realizes.<p>\n641:      *\n642:      * @param classifier is the class\n643:      * @return Collection\n644:      */\n645:     public Collection getRealizedInterfaces(MClassifier classifier) {\n646:         if (classifier == null)\n647:             return new ArrayList();\n648:         Iterator it = classifier.getClientDependencies().iterator();\n649:         List list = new ArrayList();\n650:         while (it.hasNext()) {\n651:             Object clientDependency = it.next();\n652:             if (ModelFacade.isAAbstraction(clientDependency)) {\n653:                 Object stereo = null;\n654:                 if (ModelFacade.getStereotypes(clientDependency).size() > 0) {\n655:                     stereo =\n656: \t\t\tModelFacade.getStereotypes(clientDependency).iterator()\n657: \t\t\t    .next();\n658:                 }\n659:                 if (stereo != null\n660:                         && ModelFacade.getBaseClass(stereo) != null\n661:                         && ModelFacade.getName(stereo) != null\n662:                         && ModelFacade.getBaseClass(stereo)\n663: \t\t                .equals(\"Abstraction\")\n664:                         && ModelFacade.getName(stereo).equals(\"realize\")) {\n665:                     Iterator it2 =\n666: \t\t\tModelFacade.getSuppliers(clientDependency).iterator();\n667:                     while (it2.hasNext()) {\n668:                         Object supplier = it2.next();\n669:                         if (supplier instanceof MInterface) {\n670:                             list.add(supplier);\n671:                         }\n672:                     }\n673:                 }\n674:             }\n675:         }\n676:         return list;\n677:     }\n678:     \n679:     /**\n680:      * Returns all classes some generalizable element extends.\n681:      *\n682:      * @param clazz is the generalizable element\n683:      * @return Collection\n684:      */\n685:     public Collection getExtendedClassifiers(Object clazz) {\n686:         if (clazz == null)\n687:             return new ArrayList();\n688:         Iterator it = ModelFacade.getGeneralizations(clazz).iterator();\n689:         List list = new ArrayList();\n690:         while (it.hasNext()) {\n691:             MGeneralization gen = (MGeneralization) it.next();\n692:             MGeneralizableElement parent = gen.getParent();\n693:             if (parent != null) {\n694:                 list.add(parent);\n695:             }\n696:         }\n697:         return list;\n698:     }\n699: \n700:     /**\n701:      * Gets the generalization between two generalizable elements.\n702:      * Returns null if there is none.<p>\n703:      *\n704:      * @param achild is the child generalizable element.\n705:      * @param aparent is the parent generalizable element.\n706:      * @return MGeneralization\n707:      */\n708:     public MGeneralization getGeneralization(Object achild,\n709: \t\t\t\t\t     Object aparent) {\n710:         MGeneralizableElement child = (MGeneralizableElement) achild;\n711:         MGeneralizableElement parent = (MGeneralizableElement) aparent;\n712:         if (child == null || parent == null)\n713:             return null;\n714:         Iterator it = child.getGeneralizations().iterator();\n715:         while (it.hasNext()) {\n716:             MGeneralization gen = (MGeneralization) it.next();\n717:             if (gen.getParent() == parent) {\n718:                 return gen;\n719:             }\n720:         }\n721:         return null;\n722:     }\n723: \n724:     /**\n725:      * Returns all flows from some source modelelement to a target\n726:      * modelelement.<p>\n727:      *\n728:      * @param source is the source model element.\n729:      * @param target is the target model element.\n730:      * @return Collection\n731:      */\n732:     public Collection getFlows(MModelElement source, MModelElement target) {\n733:         if (source == null || target == null)\n734:             return null;\n735:         List ret = new ArrayList();\n736:         Collection targetFlows = target.getTargetFlows();\n737:         Iterator it = source.getSourceFlows().iterator();\n738:         while (it.hasNext()) {\n739:             MFlow flow = (MFlow) it.next();\n740:             if (targetFlows.contains(flow)) {\n741:                 ret.add(flow);\n742:             }\n743:         }\n744:         return ret;\n745:     }\n746: \n747:     /**\n748:      * Returns all elements that extend some class.\n749:      *\n750:      * @param clazz is the class (a generalizable element)\n751:      * @return Collection\n752:      */\n753:     public Collection getExtendingElements(Object clazz) {\n754:         if (clazz == null)\n755:             return new ArrayList();\n756:         Iterator it = ModelFacade.getSpecializations(clazz).iterator();\n757:         List list = new ArrayList();\n758:         while (it.hasNext()) {\n759:             Object/*MGeneralization*/ gen = it.next();\n760:             Object/*MGeneralizableElement*/ client = ModelFacade.getChild(gen);\n761:             if (client != null) {\n762:                 list.add(client);\n763:             }\n764:         }\n765:         return list;\n766:     }\n767: \n768:     /**\n769:      * Returns all classifiers that extend some classifier.\n770:      *\n771:      * @param clazz is the classifier.\n772:      * @return Collection\n773:      */\n774:     public Collection getExtendingClassifiers(MClassifier clazz) {\n775:         if (clazz == null)\n776:             return new ArrayList();\n777:         Iterator it = clazz.getSpecializations().iterator();\n778:         List list = new ArrayList();\n779:         while (it.hasNext()) {\n780:             MGeneralization gen = (MGeneralization) it.next();\n781:             MGeneralizableElement client = gen.getChild();\n782:             if (client instanceof MClassifier) {\n783:                 list.add(client);\n784:             }\n785:         }\n786:         return list;\n787:     }\n788: \n789:     /**\n790:      * Returns all components found in the projectbrowser model\n791:      *\n792:      * @return Collection\n793:      */\n794:     public Collection getAllComponents() {\n795:         MNamespace model = getCurrentModel();\n796:         return getAllComponents(model);\n797:     }\n798: \n799:     /**\n800:      * Returns all components found in this namespace and in its children.\n801:      *\n802:      * @param ns is the namespace.\n803:      * @return Collection\n804:      */\n805:     public Collection getAllComponents(MNamespace ns) {\n806:         if (ns == null)\n807:             return new ArrayList();\n808:         Iterator it = ns.getOwnedElements().iterator();\n809:         List list = new ArrayList();\n810:         while (it.hasNext()) {\n811:             Object o = it.next();\n812:             if (o instanceof MNamespace) {\n813:                 list.addAll(getAllComponents((MNamespace) o));\n814:             }\n815:             if (o instanceof MComponent) {\n816:                 list.add(o);\n817:             }\n818:         }\n819:         return list;\n820:     }\n821: \n822:     /**\n823:      * Returns all datatypes found in the projectbrowser model.\n824:      *\n825:      * @return Collection\n826:      */\n827:     public Collection getAllDataTypes() {\n828:         MNamespace model = getCurrentModel();\n829:         return getAllDataTypes(model);\n830:     }\n831: \n832:     /**\n833:      * Returns all components found in this namespace and in its children.\n834:      *\n835:      * @param ns is the namespace\n836:      * @return Collection\n837:      */\n838:     public Collection getAllDataTypes(MNamespace ns) {\n839:         if (ns == null)\n840:             return new ArrayList();\n841:         Iterator it = ns.getOwnedElements().iterator();\n842:         List list = new ArrayList();\n843:         while (it.hasNext()) {\n844:             Object o = it.next();\n845:             if (o instanceof MNamespace) {\n846:                 list.addAll(getAllDataTypes((MNamespace) o));\n847:             }\n848:             if (o instanceof MDataType) {\n849:                 list.add(o);\n850:             }\n851:         }\n852:         return list;\n853:     }\n854: \n855:     /**\n856:      * Returns all nodes found in the projectbrowser model\n857:      * @return Collection\n858:      */\n859:     public Collection getAllNodes() {\n860:         MNamespace model = getCurrentModel();\n861:         return getAllNodes(model);\n862:     }\n863: \n864:     /**\n865:      * Returns all components found in this namespace and in its children.<p>\n866:      *\n867:      * @param ns is the namespace\n868:      * @return Collection\n869:      */\n870:     public Collection getAllNodes(MNamespace ns) {\n871:         if (ns == null)\n872:             return new ArrayList();\n873:         Iterator it = ns.getOwnedElements().iterator();\n874:         List list = new ArrayList();\n875:         while (it.hasNext()) {\n876:             Object o = it.next();\n877:             if (o instanceof MNamespace) {\n878:                 list.addAll(getAllNodes((MNamespace) o));\n879:             }\n880:             if (o instanceof MNode) {\n881:                 list.add(o);\n882:             }\n883:         }\n884:         return list;\n885:     }\n886:     /**\n887:      * Gets all classifiers that are associated to the given\n888:      * classifier (have an association relationship with the\n889:      * classifier).<p>\n890:      *\n891:      * @param aclassifier an MClassifier\n892:      * @return Collection\n893:      */\n894:     public Collection getAssociatedClassifiers(Object aclassifier) {\n895:         MClassifier classifier = (MClassifier) aclassifier;\n896:         if (classifier == null)\n897:             return new ArrayList();\n898:         List list = new ArrayList();\n899:         Iterator it = classifier.getAssociationEnds().iterator();\n900:         while (it.hasNext()) {\n901:             MAssociationEnd end = (MAssociationEnd) it.next();\n902:             MAssociation assoc = end.getAssociation();\n903:             Iterator it2 = assoc.getConnections().iterator();\n904:             while (it2.hasNext()) {\n905:                 MAssociationEnd end2 = (MAssociationEnd) it2.next();\n906:                 if (end2 != end) {\n907:                     list.add(end2.getType());\n908:                 }\n909:             }\n910:         }\n911:         return list;\n912:     }\n913: \n914:     /**\n915:      * Gets the associations between the classifiers from and to. Returns null\n916:      * if from or to is null or if there is no association between them.\n917:      *\n918:      * @param from a classifier\n919:      * @param to a classifier\n920:      * @return MAssociation\n921:      */\n922:     public Collection getAssociations(Object/*MClassifier*/ from,\n923: \t\t\t\t      Object/*MClassifier*/ to) {\n924:         Set ret = new HashSet();\n925:         if (from == null || to == null)\n926:             return ret;\n927:         Iterator it = ModelFacade.getAssociationEnds(from).iterator();\n928:         while (it.hasNext()) {\n929:             MAssociationEnd end = (MAssociationEnd) it.next();\n930:             MAssociation assoc = end.getAssociation();\n931:             Iterator it2 = assoc.getConnections().iterator();\n932:             while (it2.hasNext()) {\n933:                 MAssociationEnd end2 = (MAssociationEnd) it2.next();\n934:                 if (end2.getType() == to) {\n935:                     ret.add(assoc);\n936:                 }\n937:             }\n938:         }\n939:         return ret;\n940:     }\n941:     /**\n942:      * Returns all classifiers found in the projectbrowser model\n943:      * @return Collection\n944:      */\n945:     public Collection getAllClassifiers() {\n946:         MNamespace model = getCurrentModel();\n947:         return getAllClassifiers(model);\n948:     }\n949:     /**\n950:      * Returns all classifiers found in this namespace and in its children\n951:      * @param ns the given namespace\n952:      * @return Collection the collection of all classifiers \n953:      *                    found in the namespace\n954:      */\n955:     public Collection getAllClassifiers(MNamespace ns) {\n956:         if (ns == null)\n957:             return new ArrayList();\n958:         Iterator it = ns.getOwnedElements().iterator();\n959:         List list = new ArrayList();\n960:         while (it.hasNext()) {\n961:             Object o = it.next();\n962:             if (o instanceof MNamespace) {\n963:                 list.addAll(getAllClassifiers((MNamespace) o));\n964:             }\n965:             if (o instanceof MClassifier) {\n966:                 list.add(o);\n967:             }\n968:         }\n969:         return list;\n970:     }\n971: \n972:     /**\n973:      * Returns all associations for some classifier.<p>\n974:      *\n975:      * @param oclassifier the given classifier\n976:      * @return Collection all associations for the given classifier\n977:      */\n978:     public Collection getAssociations(Object oclassifier) {\n979:         Collection col = new ArrayList();\n980:         if (ModelFacade.isAClassifier(oclassifier)) {\n981:             MClassifier classifier = (MClassifier) oclassifier;\n982:             Iterator it = classifier.getAssociationEnds().iterator();\n983:             while (it.hasNext()) {\n984:                 col.add(((MAssociationEnd) it.next()).getAssociation());\n985:             }\n986:         }\n987:         return col;\n988:     }\n989:     /**\n990:      * Returns the associationend between a classifier and\n991:      * an associaton.<p>\n992:      *\n993:      * @param type is the classifier\n994:      * @param assoc is the association\n995:      * @return MAssociationEnd\n996:      */\n997:     public MAssociationEnd getAssociationEnd(MClassifier type,\n998: \t\t\t\t\t     MAssociation assoc) {\n999:         if (type == null || assoc == null)\n1000:             return null;\n1001:         Iterator it = type.getAssociationEnds().iterator();\n1002:         while (it.hasNext()) {\n1003:             MAssociationEnd end = (MAssociationEnd) it.next();\n1004:             if (assoc.getConnections().contains(end))\n1005:                 return end;\n1006:         }\n1007:         return null;\n1008:     }\n1009:     /**\n1010:      * Returns the contents (owned elements) of this classifier and\n1011:      * all its parents as specified in section 2.5.3.8 of the UML 1.3\n1012:      * spec.<p>\n1013:      *\n1014:      * @param clazz is the classifier\n1015:      * @return Collection\n1016:      */\n1017:     public Collection getAllContents(MClassifier clazz) {\n1018:         if (clazz == null)\n1019:             return new ArrayList();\n1020:         List list = new ArrayList();\n1021:         Iterator it = clazz.getOwnedElements().iterator();\n1022:         while (it.hasNext()) {\n1023:             MModelElement element = (MModelElement) it.next();\n1024:             if (element.getVisibility().equals(MVisibilityKind.PUBLIC)\n1025:                 || element.getVisibility().equals(MVisibilityKind.PROTECTED)) {\n1026:                 list.add(element);\n1027:             }\n1028:         }\n1029:         it = clazz.getGeneralizations().iterator();\n1030:         while (it.hasNext()) {\n1031:             list.addAll(getAllContents((MClassifier) it.next()));\n1032:         }\n1033:         return list;\n1034:     }\n1035: \n1036:     /**\n1037:      * Returns all attributes of some classifier and of its parents.\n1038:      *\n1039:      * @param clazz is the classifier\n1040:      * @return Collection\n1041:      */\n1042:     public Collection getAllAttributes(MClassifier clazz) {\n1043:         if (clazz == null)\n1044:             return new ArrayList();\n1045:         List list = new ArrayList();\n1046:         Iterator it = clazz.getFeatures().iterator();\n1047:         while (it.hasNext()) {\n1048:             MFeature element = (MFeature) it.next();\n1049:             if (element instanceof MAttribute) {\n1050:                 list.add(element);\n1051:             }\n1052:         }\n1053:         it = clazz.getGeneralizations().iterator();\n1054:         while (it.hasNext()) {\n1055:             list.addAll(getAllAttributes((MClassifier) it.next()));\n1056:         }\n1057:         return list;\n1058:     }\n1059: \n1060:     /**\n1061:      * Returns the source of a relation. The source of a relation is\n1062:      * defined as the modelelement that propagates this relation. If\n1063:      * there are more then 1 sources, only the first is returned. If\n1064:      * there is no source, null is returned. Examples of sources\n1065:      * include classifiers that are types to associationends, usecases\n1066:      * that are bases to extend and include relations and so on. A\n1067:      * source is allways the start from the arrow in the fig, the\n1068:      * destination the end.<p>\n1069:      *\n1070:      * This method also works to get the source of a Link.<p>\n1071:      * <p>This method also works for CommentEdge</p>\n1072:      * TODO: move this method to a generic ModelHelper\n1073:      *\n1074:      * @param relationship is the relation\n1075:      * @return Object\n1076:      */\n1077:     public Object getSource(Object relationship) {        \n1078:         if (!(relationship instanceof MRelationship)\n1079: \t    && !(ModelFacade.isALink(relationship))) {\n1080: \n1081: \n1082:             throw new IllegalArgumentException(\"Argument \" \n1083:                     \t\t\t       + relationship.toString() \n1084:                     \t\t\t       + \" is not \"\n1085: \t\t\t\t\t       + \"a relationship\");\n1086: \n1087: \t}\n1088:         if (ModelFacade.isALink(relationship)) {\n1089: \t    Iterator it = ModelFacade.getConnections(relationship).iterator();\n1090: \t    if (it.hasNext()) {\n1091: \t\treturn ModelFacade.getInstance(it.next());\n1092: \t    } else {\n1093: \t\treturn null;\n1094: \t    }\n1095:         }       \n1096:         if (relationship instanceof MAssociation) {\n1097:             MAssociation assoc = (MAssociation) relationship;\n1098:             List conns = assoc.getConnections();\n1099:             if (conns == null || conns.isEmpty())\n1100:                 return null;\n1101:             return ((MAssociationEnd) conns.get(0)).getType();\n1102:         }\n1103:         if (relationship instanceof MGeneralization) {\n1104:             MGeneralization gen = (MGeneralization) relationship;\n1105:             return gen.getChild();\n1106:         }\n1107:         if (relationship instanceof MDependency) {\n1108:             MDependency dep = (MDependency) relationship;\n1109:             Collection col = dep.getClients();\n1110:             if (col.isEmpty())\n1111:                 return null;\n1112:             return (MModelElement) (col.toArray())[0];\n1113:         }\n1114:         if (relationship instanceof MFlow) {\n1115:             MFlow flow = (MFlow) relationship;\n1116:             Collection col = flow.getSources();\n1117:             if (col.isEmpty())\n1118:                 return null;\n1119:             return (MModelElement) (col.toArray())[0];\n1120:         }\n1121:         if (relationship instanceof MExtend) {\n1122:             MExtend extend = (MExtend) relationship;\n1123:             return extend.getExtension(); // we have to follow the arrows..\n1124:         }\n1125:         if (relationship instanceof MInclude) {\n1126:             MInclude include = (MInclude) relationship;\n1127:             // we use modelfacade here to cover up for a messup in NSUML\n1128:             return ModelFacade.getBase(include);\n1129:         }\n1130:         if (relationship instanceof CommentEdge) {\n1131:             return ((CommentEdge) relationship).getSource();\n1132:         }\n1133:         return null;\n1134:     }\n1135: \n1136:     /**\n1137:      * Returns the destination of a relation. The destination of a\n1138:      * relation is defined as the modelelement that receives this\n1139:      * relation.  If there are more then 1 destinations, only the\n1140:      * first is returned.  If there is no destination, null is\n1141:      * returned.  Examples of sources include classifiers that are\n1142:      * types to associationends, usecases that are bases to extend and\n1143:      * include relations and so on.  In the case of an association,\n1144:      * the destination is defined as the type of the second element in\n1145:      * the connections list.<p>\n1146:      *\n1147:      * This method also works for links.<p>\n1148:      * <p>This method also works for CommentEdge</p>\n1149:      * TODO: move this method to a generic ModelHelper\n1150:      *\n1151:      * @param relationship is the relation\n1152:      * @return object\n1153:      */\n1154:     public Object getDestination(Object relationship) {\n1155:         \n1156: \tif (!(relationship instanceof MRelationship)\n1157: \t    && !(ModelFacade.isALink(relationship)) \n1158: \t    && !(relationship instanceof CommentEdge)) {\n1159: \n1160: \t    throw new IllegalArgumentException(\"Argument is not \"\n1161: \t\t\t\t\t       + \"a relationship\");\n1162: \t}\n1163: \tif (ModelFacade.isALink(relationship)) {\n1164: \t    Iterator it = ModelFacade.getConnections(relationship).iterator();\n1165: \t    if (it.hasNext()) {\n1166: \t\tit.next();\n1167: \t\tif (it.hasNext()) {\n1168: \t\t    return ModelFacade.getInstance(it.next());\n1169: \t\t} else {\n1170: \t\t    return null;\n1171: \t\t}\t\t\t\t\n1172: \t    } else\n1173: \t\treturn null;        \n1174: \t}\n1175:               \n1176:         \n1177:         if (relationship instanceof MAssociation) {\n1178:             MAssociation assoc = (MAssociation) relationship;\n1179:             List conns = assoc.getConnections();\n1180:             if (conns.size() <= 1)\n1181:                 return null;\n1182:             return ((MAssociationEnd) conns.get(1)).getType();\n1183:         }\n1184:         if (relationship instanceof MGeneralization) {\n1185:             MGeneralization gen = (MGeneralization) relationship;\n1186:             return gen.getParent();\n1187:         }\n1188:         if (relationship instanceof MDependency) {\n1189:             MDependency dep = (MDependency) relationship;\n1190:             Collection col = dep.getSuppliers();\n1191:             if (col.isEmpty())\n1192:                 return null;\n1193:             return (MModelElement) (col.toArray())[0];\n1194:         }\n1195:         if (relationship instanceof MFlow) {\n1196:             MFlow flow = (MFlow) relationship;\n1197:             Collection col = flow.getTargets();\n1198:             if (col.isEmpty())\n1199:                 return null;\n1200:             return (MModelElement) (col.toArray())[0];\n1201:         }\n1202:         if (relationship instanceof MExtend) {\n1203:             MExtend extend = (MExtend) relationship;\n1204:             return extend.getBase();\n1205:         }\n1206:         if (relationship instanceof MInclude) {\n1207:             MInclude include = (MInclude) relationship;\n1208:             return ModelFacade.getAddition(include);\n1209:         }\n1210:         if (relationship instanceof CommentEdge) {\n1211:             return ((CommentEdge) relationship).getDestination();\n1212:         }\n1213:         return null;\n1214:     }\n1215: \n1216:     /**\n1217:      * Returns the dependencies between some supplier modelelement and\n1218:      * some client modelelement.  Does not return the vica versa\n1219:      * relationship (dependency 'from client to supplier').<p>\n1220:      *\n1221:      * @param supplierObj a MModelElement\n1222:      * @param clientObj a MModelElement\n1223:      * @return Collection\n1224:      */\n1225:     public Collection getDependencies(\n1226: \t\t\t\t      Object supplierObj,\n1227: \t\t\t\t      Object clientObj) {\n1228:             \n1229:         if (!(supplierObj instanceof MModelElement)\n1230: \t    || !(clientObj instanceof MModelElement)) {\n1231: \n1232:             return null;\n1233: \n1234: \t}\n1235:         \n1236:         MModelElement supplier = (MModelElement) supplierObj;\n1237:         MModelElement client = (MModelElement) clientObj;\n1238:         \n1239:         List ret = new ArrayList()