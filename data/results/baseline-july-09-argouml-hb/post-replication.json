ion ignore) {\n506:     //      System.out.println(\"got an ClassMismatchException\");\n507:     //    }\n508:     catch (IOException ignore) {\n509:       System.out.println(\"got an IOException\");\n510:       ignore.printStackTrace();\n511:     }\n512:     return false;\n513:   }\n514: } /* end class ActionSaveAsXMI */\n515: \n516: class ActionPrint extends UMLAction {\n517:   public ActionPrint() { super(\"Print...\"); }\n518:   public boolean shouldBeEnabled() {\n519:     Project p = ProjectBrowser.TheInstance.getProject();\n520:     return super.shouldBeEnabled() && p != null;\n521:   }\n522:   public void actionPerformed(ActionEvent ae) {\n523:     CmdPrint cmd = new CmdPrint();\n524:     Object target = ProjectBrowser.TheInstance.getTarget();\n525:     if (target instanceof Diagram) {\n526:       String n = ((Diagram)target).getName();\n527:       cmd.setDiagramName(n);\n528:       cmd.doIt();\n529:     }\n530:   }\n531: } /* end class ActionPrint */\n532: \n533: class ActionAddToProj extends UMLAction {\n534:   public ActionAddToProj() { super(\"Add To Project...\"); }\n535:   public boolean shouldBeEnabled() {\n536:     Project p = ProjectBrowser.TheInstance.getProject();\n537:     return super.shouldBeEnabled() && p != null;\n538:   }\n539: } /* end class ActionAddToProj */\n540: \n541: class ActionExit extends UMLAction {\n542:   public ActionExit() { super(\"Exit\"); }\n543: \n544:   public void actionPerformed(ActionEvent ae) {\n545:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n546:     Project p = pb.getProject();\n547:     if (p != null) { // && p.getNeedsSave()) {\n548:       String t = \"Save changes to \" + p.getName();\n549:       int response =\n550: \tJOptionPane.showConfirmDialog(pb, t, t,\n551: \t\t\t\t      JOptionPane.YES_NO_CANCEL_OPTION);\n552:       if (response == JOptionPane.CANCEL_OPTION) return;\n553:       if (response == JOptionPane.YES_OPTION)\n554: \tif (!((ActionSave)Actions.SaveProject).trySave()) return;\n555:     }\n556:     System.exit(0);\n557:   }\n558: } /* end class ActionExit */\n559: \n560: ////////////////////////////////////////////////////////////////\n561: // generic editing actions\n562: \n563: class ActionUndo extends UMLAction {\n564:   public ActionUndo() { super(\"Undo\"); }\n565:   public boolean shouldBeEnabled() { return false; }\n566: } /* end class ActionUndo */\n567: \n568: class ActionRedo extends UMLAction {\n569:   public ActionRedo() { super(\"Redo\"); }\n570:   public boolean shouldBeEnabled() { return false; }\n571: } /* end class ActionRedo */\n572: \n573: class ActionCut extends UMLAction {\n574:   public ActionCut() { super(\"Cut\"); }\n575:   public boolean shouldBeEnabled() { return false; }\n576: } /* end class ActionCut */\n577: \n578: class ActionCopy extends UMLChangeAction {\n579:   public ActionCopy() { super(\"Copy\"); }\n580:   public boolean shouldBeEnabled() {\n581:     int size = Globals.curEditor().getSelectionManager().selections().size();\n582:     return (size > 0);\n583:   }\n584:   public void actionPerformed(ActionEvent ae) {\n585:     CmdCopy cmd = new CmdCopy();\n586:     cmd.doIt();\n587:     super.actionPerformed(ae);\n588:   }\n589: } /* end class ActionCopy */\n590: \n591: class ActionPaste extends UMLChangeAction {\n592:   public ActionPaste() { super(\"Paste\"); }\n593:   public boolean shouldBeEnabled() {\n594:     if (Globals.clipBoard != null)\n595:       return true;\n596:     return false;\n597:   }\n598:   public void actionPerformed(ActionEvent ae) {\n599:     CmdPaste cmd = new CmdPaste();\n600:     cmd.doIt();\n601:     super.actionPerformed(ae);\n602:   }\n603: \n604: } /* end class ActionPaste */\n605: \n606: \n607: class ActionDeleteFromDiagram extends UMLChangeAction {\n608:   public ActionDeleteFromDiagram() { super(\"Delete From Diagram\"); }\n609:   public boolean shouldBeEnabled() {\n610:     Editor ce = Globals.curEditor();\n611:     Vector figs = ce.getSelectionManager().getFigs();\n612:     return figs.size() > 0;\n613:   }\n614:   public void actionPerformed(ActionEvent ae) {\n615:     Editor ce = Globals.curEditor();\n616:     SelectionManager sm = ce.getSelectionManager();\n617:     sm.delete();\n618:   }\n619: }\n620: \n621: \n622: class ActionRemoveFromModel extends UMLChangeAction {\n623:   public ActionRemoveFromModel() { super(\"Remove From Model\"); }\n624:   public boolean shouldBeEnabled() {\n625:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n626:     Object target = pb.getDetailsTarget();\n627:     if (target instanceof ModelElement) return true;\n628: \n629:     // needs-more-work: trashing diagrams\n630:     Editor ce = Globals.curEditor();\n631:     Vector figs = ce.getSelectionManager().getFigs();\n632:     int size = figs.size();\n633:     for (int i = 0; i < size; i++) {\n634:       Fig f = (Fig) figs.elementAt(i);\n635:       Object owner = f.getOwner();\n636:       if (owner instanceof ModelElement) return true;\n637:     }\n638:     return false;\n639:   }\n640:   public void actionPerformed(ActionEvent ae) {\n641:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n642:     Object target = pb.getDetailsTarget();\n643:     Project p = pb.getProject();\n644:     if (target instanceof ModelElement)\n645:       p.moveToTrash(target);\n646:     // needs-more-work: trashing diagrams\n647:     else {\n648:       Editor ce = Globals.curEditor();\n649:       Vector figs = ce.getSelectionManager().getFigs();\n650:       int size = figs.size();\n651:       for (int i = 0; i < size; i++) {\n652: \tFig f = (Fig) figs.elementAt(i);\n653: \tObject owner = f.getOwner();\n654: \tif (owner instanceof ModelElement)\n655: \t  p.moveToTrash(owner);\n656:       }\n657:     }\n658:     super.actionPerformed(ae);\n659:   }\n660: } /* end class ActionRemoveFromModel */\n661: \n662: class ActionEmptyTrash extends UMLChangeAction {\n663:   public ActionEmptyTrash() { super(\"Empty Trash\"); }\n664:   public boolean shouldBeEnabled() {\n665:     return Trash.S