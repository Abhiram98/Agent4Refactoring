ive, so I remove the current project, before\n137:         // loading the new one.\n138: \n139:         Designer.disableCritiquing();\n140:         Designer.clearCritiquing();\n141:         Project p = null;\n142: \n143:         if (!(new File(url.getFile()).canRead())) {\n144:             showErrorPane(\"File not found \" + url.toString() + \".\");\n145:             Designer.enableCritiquing();\n146:             success = false;\n147:         } else {\n148:             try {\n149:                 ProjectFilePersister persister =\n150:                     pm.getPersisterFromFileName(url.getFile());\n151:                 if (persister == null) {\n152:                     success = false;\n153:                     throw new IllegalStateException(\"Filename \" + url.getFile()\n154:                             + \" is not of a known file type\");\n155:                 }\n156:                 p = persister.doLoad(url, null, null);\n157: \n158:                 ProjectBrowser.getInstance().showStatus(\n159:                         MessageFormat.format(Translator.localize(\n160:                         \"label.open-project-status-read\"),\n161:                         new Object[] {\n162: \t\t\t    url.toString(),\n163:                         }));\n164:             } catch (OpenException ex) {\n165:                 LOG.error(\"Exception while loading project\", ex);\n166:                 success = false;\n167:                 showErrorPane(\n168:                         \"Could not load the project \"\n169:                         + url.toString()\n170:                         + \" due to parser configuration errors.\\n\"\n171:                         + \"Please read the instructions at www.argouml.org \"\n172:                         + \"on the \"\n173:                         + \"requirements of argouml and how to install it.\");\n174:                 p = oldProject;\n175:             } finally {\n176:                 if (!LastLoadInfo.getInstance().getLastLoadStatus()) {\n177:                     p = oldProject;\n178:                     success = false;\n179:                     showErrorPane(\n180:                             \"Problem in loading the project \"\n181:                             + url.toString()\n182:                             + \"\\n\"\n183:                             + \"Project file probably corrupt from \"\n184:                             + \"an earlier version or ArgoUML.\\n\"\n185:                             + \"Error message:\\n\"\n186:                             + LastLoadInfo.getInstance().getLastLoadMessage()\n187:                             + \"\\n\"\n188:                             + \"Since the project was incorrectly \"\n189:                             + \"saved some things might be missing \"\n190:                             + \"from before you saved it.\\n\"\n191:                             + \"These things cannot be restored. \"\n192:                             + \"You can continue working with what \"\n193:                             + \"was actually loaded.\\n\");\n194:                 } else if (oldProject != null) {\n195:                     // if p equals oldProject there was an exception and we do\n196:                     // not have to gc (garbage collect) the old project\n197:                     if (p != null && !p.equals(oldProject)) {\n198:                         //prepare the old project for gc\n199:                         LOG.info(\"There are \" + oldProject.getMembers().size()\n200:                                 + \" members in the old project\");\n201:                         LOG.info(\"There are \" + p.getMembers().size()\n202:                                 + \" members in the new project\");\n203:                         ProjectManager.getManager().removeProject(oldProject);\n204:                     }\n205:                 }\n206:                 ProjectManager.getManager().setCurrentProject(p);\n207:                 if (p == null) {\n208:                    