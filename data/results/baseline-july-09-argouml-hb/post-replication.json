t java.io.File;\n32: import java.io.IOException;\n33: import java.net.MalformedURLException;\n34: import java.net.URL;\n35: import java.util.ArrayList;\n36: import java.util.Collection;\n37: import java.util.HashMap;\n38: import java.util.HashSet;\n39: import java.util.Iterator;\n40: import java.util.Set;\n41: import java.util.Vector;\n42: \n43: import org.apache.log4j.Logger;\n44: import org.argouml.application.ArgoVersion;\n45: import org.argouml.model.Model;\n46: import org.argouml.model.ModelFacade;\n47: import org.argouml.persistence.PersistenceManager;\n48: import org.argouml.ui.ArgoDiagram;\n49: import org.argouml.ui.ProjectBrowser;\n50: import org.argouml.ui.explorer.ExplorerEventAdaptor;\n51: import org.argouml.ui.targetmanager.TargetEvent;\n52: import org.argouml.ui.targetmanager.TargetListener;\n53: import org.argouml.ui.targetmanager.TargetManager;\n54: import org.argouml.uml.ProfileJava;\n55: import org.argouml.uml.ProjectMemberModel;\n56: import org.argouml.uml.cognitive.ProjectMemberTodoList;\n57: import org.argouml.uml.diagram.ProjectMemberDiagram;\n58: import org.argouml.uml.diagram.state.ui.UMLStateDiagram;\n59: import org.argouml.uml.diagram.static_structure.ui.CommentEdge;\n60: import org.argouml.uml.diagram.static_structure.ui.UMLClassDiagram;\n61: import org.argouml.uml.diagram.ui.UMLDiagram;\n62: import org.argouml.uml.diagram.use_case.ui.UMLUseCaseDiagram;\n63: import org.argouml.uml.generator.GenerationPreferences;\n64: import org.argouml.util.Trash;\n65: import org.tigris.gef.base.Diagram;\n66: import org.tigris.gef.presentation.Fig;\n67: import org.tigris.gef.util.Util;\n68: \n69: /**\n70:  * The Project is a datastructure that represents the designer's \n71:  * current project. It manages the list of diagrams and UML models.\n72:  */\n73: public class Project implements java.io.Serializable, TargetListener {\n74: \n75:     /** logger */\n76:     private static final Logger LOG = Logger.getLogger(Project.class);\n77:     \n78:     ////////////////////////////////////////////////////////////////\n79:     // constants\n80: \n81:     /**\n82:      * Default name for a project.\n83:      */\n84:     private static final String UNTITLED_FILE = \"Untitled\";\n85: \n86:     ////////////////////////////////////////////////////////////////\n87:     // static variables\n88:     \n89:     static final long serialVersionUID = 1399111233978692444L;\n90: \n91:     ////////////////////////////////////////////////////////////////\n92:     // instance variables\n93: \n94:     /** TODO: should just be the directory to write\n95:      */\n96:     private URL url;\n97: //    private ChangeRegistry saveRegistry;\n98: \n99:     private String authorname;\n100:     private String description;\n101:     private String version;\n102: \n103:     private Vector searchpath;\n104:     \n105:     // TODO: break into 3 main member types\n106:     // model, diagram and other\n107:     private MemberList members;\n108:     \n109:     private String historyFile;\n110:     \n111:     /**\n112:      * The version number of the persistence format that last\n113:      * saved this project.\n114:      */\n115:     private int persistenceVersion;\n116: \n117:     /**\n118:      * Instances of the uml model.\n119:      */\n120:     private Vector models;\n121: \n122:     /**\n123:      * Instances of the uml diagrams.\n124:      */\n125:     private Vector diagrams;\n126:     private Object defaultModel;\n127:     private Object currentNamespace;\n128:     private HashMap uuidRefs;\n129:     private GenerationPreferences cgPrefs;\n130:     private transient VetoableChangeSupport vetoSupport;\n131: \n132:     /**\n133:      * The root of the modeltree the user is working on. (The untitledModel in\n134:      * the navpane).\n135:      */\n136:     private Object treeRoot;\n137:     \n138:     /**\n139:      * The active diagram, pointer to a diagram in the list with diagrams.\n140:      */\n141:     private ArgoDiagram activeDiagram;\n142: \n143:     /** Cache for the default model.\n144:      */\n145:     private HashMap defaultModelCache;\n146: \n147:     /**\n148:      * Constructor.\n149:      *\n150:      * @param theProjectUrl Url to read the project from.\n151:      */\n152:     public Project(URL theProjectUrl) {\n153:         this();\n154:         url = PersistenceManager.getInstance().fixUrlExtension(theProjectUrl);\n155:     }\n156: \n157:     /**\n158:      * Constructor.\n159:      */\n160:     public Project() {\n161:         \n162:         authorname = \"\";\n163:         description = \"\";\n164:         // this should be moved to a ui action.\n165:         version = ArgoVersion.getVersion();\n166:         \n167:         searchpath = new Vector();\n168:         members = new MemberList();\n169:         historyFile = \"\";\n170:         models = new Vector();\n171:         diagrams = new Vector();\n172:         cgPrefs = new GenerationPreferences();\n173:         defaultModelCache = new HashMap();\n174:         \n175: //        saveRegistry = new ChangeRegistry();\n176:         LOG.info(\"making empty project with empty model\");\n177:         // Jaap Branderhorst 2002-12-09\n178:         // load the default model\n179:         // this is NOT the way how it should be since this makes argo\n180:         // depend on Java even more.\n181:         setDefaultModel(ProfileJava.loadProfileModel());\n182:         addSearchPath(\"PROJECT_DIR\");\n183:         ProjectManager.getManager().setNeedsSave(false);\n184:         TargetManager.getInstance().addTargetListener(this);\n185: \n186:     }\n187: \n188:     /**\n189:      * Makes a just created project to an untitled project with a\n190:      * class diagram and a usecase diagram and an untitled model.\n191:      */\n192:     protected void makeUntitledProject() {\n193:         if (getRoot() != null)\n194:             throw new IllegalStateException(\n195:                     \"Tried to make a non-empty project \"\n196:                     + \"to an untitled project\");\n197:         Object model =\n198:             Model.getUmlFactory().getModelManagement().createModel();\n199:         ModelFacade.setName(model, \"untitledModel\");\n200:         setRoot(model);\n201:         setCurrentNamespace(model);\n202:         addMember(model);\n203:         addMember(new UMLClassDiagram(model));\n204:         addMember(new UMLUseCaseDiagram(model));\n205:         addMember(new ProjectMemberTodoList(\"\", this));\n206:         ProjectManager.getManager().setNeedsSave(false);       \n207:         setActiveDiagram((ArgoDiagram) getDiagrams().get(0));\n208:     }\n209:  \n210:     /**\n211:      * Find the base name of this project.<p>\n212:      * \n213:      * This is the name minus any valid file extension.\n214:      * \n215:      * @return The name (a String).\n216:      */\n217:     public String getBaseName() {\n218:         String n = getName();\n219:         n = PersistenceManager.getInstance().getBaseName(n);\n220:         return n;\n221:     }\n222: \n223:     /**\n224:      * @return the name of the project\n225:      */\n226:     public String getName() {\n227:         // TODO: maybe separate name\n228:         if (url == null)\n229:             return UNTITLED_FILE;\n230:         String name = url.getFile();\n231:         int i = name.lastIndexOf('/');\n232:         return name.substring(i + 1);\n233:     }\n234: \n235:     /**\n236:      * Set the project URL.\n237:      * \n238:      * @param n The new URL (as a String).\n239:      * @throws MalformedURLException if the argument cannot be converted to \n240:      *         an URL.\n241:      */\n242:     public void setName(String n)\n243:         throws MalformedURLException {\n244:         String s = \"\";\n245:         if (getURL() != null)\n246:             s = getURL().toString();\n247:         s = s.substring(0, s.lastIndexOf(\"/\") + 1) + n;\n248:         setURL(new URL(s));\n249:     }\n250: \n251:     /**\n252:      * Get the URL for this project.\n253:      * \n254:      * @return The URL.\n255:      */\n256:     public URL getURL() {\n257:         return url;\n258:     }\n259: \n260:     /**\n261:      * Set the URL for this project.\n262:      * \n263:      * @param theUrl The URL to set.\n264:      */\n265:     public void setURL(URL theUrl) {\n266:         if (theUrl != null) {\n267:             theUrl = PersistenceManager.getInstance().fixUrlExtension(theUrl);\n268:         }\n269: \n270:         if (LOG.isDebugEnabled()) {\n271:             LOG.debug(\"Setting project URL from \\\"\" + url \n272:                       + \"\\\" to \\\"\" + theUrl + \"\\\".\");\n273:         }\n274: \n275:         url = theUrl;\n276:     }\n277: \n278:     /**\n279:      * Set the project file.\n280:      * \n281:      * This only works if it is possible to convert the File to an url.\n282:      *\n283:      * @param file File to set the project to.\n284:      */\n285:     public void setFile(File file) {\n286:         try {\n287:             URL theProjectUrl = Util.fileToURL(file);\n288: \n289:             if (LOG.isDebugEnabled()) {\n290:                 LOG.debug(\"Setting project file name from \\\"\" \n291:                           + url \n292:                           + \"\\\" to \\\"\" \n293:                           + theProjectUrl \n294:                           + \"\\\".\");\n295:             }\n296: \n297:             url = theProjectUrl;\n298:         } catch (MalformedURLException murle) {\n299:             LOG.error(\"problem in setFile:\" + file, murle);\n300:         } catch (IOException ex) {\n301:             LOG.error(\"problem in setFile:\" + file, ex);\n302:         }\n303:     }\n304: \n305:     /**\n306:      * @return the search path\n307:      */\n308:     public Vector getSearchPath() {\n309:         return searchpath;\n310:     }\n311: \n312:     /**\n313:      * @param searchPathElement the element to be added to the searchpath\n314:      */\n315:     public void addSearchPath(String searchPathElement) {\n316:         this.searchpath.addElement(searchPathElement);\n317:     }\n318: \n319:     /**\n320:      * Get all members of the project.\n321:      * \n322:      * @return a Vector with all members.\n323:      */\n324:     public MemberList getMembers() {\n325:         LOG.info(\"Getting the members there are \" + members.size());\n326:         return members;\n327:     }\n328: \n329:     /**\n330:      * @param d the diagram\n331:      */\n332:     private void addDiagramMember(ArgoDiagram d) {\n333:         ProjectMember pm = new ProjectMemberDiagram(d, this);\n334:         addDiagram(d);\n335:         // if diagram added successfully, add the member too\n336:         members.add(pm);\n337:     }\n338: \n339:     /**\n340:      * @param pm the member to be added\n341:      */\n342:     private void addTodoMember(ProjectMemberTodoList pm) {\n343:         // Adding a todo member removes any existing one.\n344:         members.add(pm);\n345:         LOG.info(\"Added todo member, there are now \" + members.size());\n346:     }\n347: \n348:     /**\n349:      * @param m the member to be added\n350:      */\n351:     public void addMember(Object m) {\n352:         \n353:         if (m instanceof ArgoDiagram) {\n354:             LOG.info(\"Adding diagram member\");\n355:             addDiagramMember((ArgoDiagram) m);\n356:         } else if (m instanceof ProjectMemberTodoList) {\n357:             LOG.info(\"Adding todo member\");\n358:             addTodoMember((ProjectMemberTodoList) m);\n359:         } else if (ModelFacade.isAModel(m)) {\n360:             LOG.info(\"Adding model member\");\n361:             addModelMember(m);\n362:         } else {\n363:             throw new IllegalArgumentException(\n364:                     \"The member must be a UML model todo member or diagram.\"\n365:                     + \"It is \" + m.getClass().getName());\n366:         }\n367:         LOG.info(\"There are now \" + members.size() + \" members\");\n368:     }\n369: \n370:     /**\n371:      * @param m the model\n372:      */\n373:     private void addModelMember(Object m) {\n374:         \n375:         boolean memberFound = false;\n376:         Object currentMember =\n377:             members.getMember(ProjectMemberModel.class);\n378:         if (currentMember != null) {\n379:             Object currentModel =\n380:                 ((ProjectMemberModel) currentMember).getModel();\n381:             if (currentModel == m) {\n382:                 memberFound = true;\n383:             }\n384:         }\n385:         \n386:         if (!memberFound) {\n387:             if (!models.contains(m)) {\n388:                 addModel(m);\n389:             }\n390:             // got past the veto, add the member\n391:             ProjectMember pm = new ProjectMemberModel(m, this);\n392:             LOG.info(\"Adding model member to start of member list\");\n393:             members.add(pm);\n394:         } else {\n395:             LOG.info(\"Attempted to load 2 models\");\n396:             throw new IllegalArgumentException(\n397:                     \"Attempted to load 2 models\");\n398:         }\n399:     }\n400:     \n401:     /**\n402:      * @param m a namespace\n403:      */\n404:     public void addModel(Object m) {\n405:         \n406:         if (!ModelFacade.isANamespace(m)) {\n407:             throw new IllegalArgumentException();\n408: \t}\n409:         \n410:         // fire indeterminate change to avoid copying vector\n411:         if (!models.contains(m)) {\n412:             models.addElement(m);\n413:         }\n414:         setCurrentNamespace(m);\n415:         ProjectManager.getManager().setNeedsSave(true);\n416:     }\n417: \n418:     /**\n419:      * Removes a project member diagram completely from the project.\n420:      * @param d the ArgoDiagram\n421:      */\n422:     protected void removeProjectMemberDiagram(ArgoDiagram d) {\n423: \n424:         removeDiagram(d);\n425:         members.remove(d);\n426:         \n427:         /* Issue 2909: if there is no diagram left, then let's add a default\n428:          * new one... */\n429:         if (diagrams.size() < 1) {\n430:             ArgoDiagram defaultDiagram = new UMLClassDiagram(treeRoot);\n431:             addMember(defaultDiagram);\n432:             setActiveDiagram(defaultDiagram); \n433:             TargetManager.getInstance().setTarget(defaultDiagram);\n434:         }\n435:     }\n436: \n437:     /**\n438:      * @param name the name of the member to be found\n439:      * @return the member\n440:      */\n441:     public ProjectMember findMemberByName(String name) {\n442:         if (LOG.isDebugEnabled()) {\n443:             LOG.debug(\"findMemberByName called for \\\"\" + name + \"\\\".\");\n444:         }\n445:         return members.findDiagramMemberByName(name);\n446:     }\n447: \n448:     /**\n449:      * Get the author name.\n450:      * \n451:      * @return The author name.\n452:      */\n453:     public String getAuthorname() {\n454:         return authorname;\n455:     }\n456:     \n457:     /**\n458:      * Set the author name.\n459:      * \n460:      * @param s The new author name.\n461:      */\n462:     public void setAuthorname(String s) {\n463:         authorname = s;\n464:     }\n465: \n466:     /**\n467:      * Get the version.\n468:      * \n469:      * @return the version.\n470:      */\n471:     public String getVersion() {\n472:         return version;\n473:     }\n474:     \n475:     /**\n476:      * Set the new version.\n477:      * @param s The new version.\n478:      */\n479:     public void setVersion(String s) {\n480:         version = s;\n481:     }\n482: \n483:     /**\n484:      * Get the description.\n485:      * \n486:      * @return the description.\n487:      */\n488:     public String getDescription() {\n489:         return description;\n490:     }\n491: \n492:     /**\n493:      * Set a new description.\n494:      *  \n495:      * @param s The new description.\n496:      */\n497:     public void setDescription(String s) {\n498:         description = s;\n499:     }\n500: \n501:     /**\n502:      * Get the history file.\n503:      * \n504:      * @return The history file.\n505:      */\n506:     public String getHistoryFile() {\n507:         return historyFile;\n508:     }\n509: \n510:     /**\n511:      * Set the history file.\n512:      * \n513:      * @param s The new history file.\n514:      */\n515:     public void setHistoryFile(String s) {\n516:         historyFile = s;\n517:     }\n518:     \n519:     /**\n520:      * Returns all models defined by the user. I.e. this does not return the\n521:      * default model but all other models.\n522:      * \n523:      * @return A Vector of all user defined models.\n524:      */\n525:     public Vector getUserDefinedModels() {\n526:         return models;\n527:     }\n528: \n529:     /**\n530:      * Returns all models, including the default model (default.xmi).\n531:      * \n532:      * @return A Collection containing all models.\n533:      */\n534:     public Collection getModels() {\n535:         Set ret = new HashSet();\n536:         ret.addAll(models);\n537:         ret.add(defaultModel);\n538:         return ret;\n539:     }\n540: \n541:     /**\n542:      * Return the model.<p>\n543:      * \n544:      * If there isn't exactly one model, <tt>null</tt> is returned.\n545:      * \n546:      * @return the model.\n547:      */\n548:     public Object getModel() {\n549:         if (models.size() != 1) {\n550:             return null;\n551:         }\n552:         return models.elementAt(0);\n553:     }\n554: \n555:     /**\n556:      * Searches for a type/classifier with name s. If the type is not found,\n557:      * a new type is created and added to the current namespace.\n558:      * @param s the name of the type/classifier to be found\n559:      * @return MClassifier\n560:      */\n561:     public Object findType(String s) {\n562:         return findType(s, true);\n563:     }\n564: \n565:     /**\n566:      * Searches for a type/classifier with name s. If defineNew is\n567:      * true, a new type is defined if the type/classifier is not\n568:      * found. The newly created type is added to the currentNamespace\n569:      * and given the name s.\n570:      * @param s the name of the type/classifier to be found\n571:      * @param defineNew if true, define a new one \n572:      * @return MClassifier the found classifier\n573:      */\n574:     public Object findType(String s, boolean defineNew) {\n575:         if (s != null) {\n576:             s = s.trim();\n577:         }\n578:         if (s == null || s.length() == 0) {\n579:             return null;\n580:         }\n581:         Object cls = null;\n582:         int numModels = models.size();\n583:         for (int i = 0; i < numModels; i++) {\n584:             cls = findTypeInModel(s, models.elementAt(i));\n585:             if (cls != null) {\n586:                 return cls;\n587:             }\n588:         }\n589:         cls = findTypeInModel(s, defaultModel);\n590:         // hey, now we should move it to the model the user is working in\n591:         if (cls != null) {\n592:             cls = Model.getModelManagementHelper().getCorrespondingElement(cls, \n593:                     getRoot());\n594:         }\n595:         if (cls == null && defineNew) {\n596:             LOG.debug(\"new Type defined!\");\n597:             cls = Model.getUmlFactory().getCore()\n598:         \t\t  .buildClass(getCurrentNamespace());\n599:             ModelFacade.setName(cls, s);\n600:         }\n601:         return cls;\n602:     }\n603: \n604:     /**\n605:      * Finds all figs on the diagrams for some project member,\n606:      * including the figs containing the member (so for some\n607:      * operation, the containing figclass is returned).\n608:      * \n609:      * @param member The member we are looking for. \n610:      *               This can be a NSUML object but also another object.\n611:      * @return Collection The collection with the figs.\n612:      */\n613:     public Collection findFigsForMember(Object member) {\n614:         Collection figs = new ArrayList();\n615:         Iterator it = getDiagrams().iterator();\n616:         while (it.hasNext()) {\n617:             ArgoDiagram diagram = (ArgoDiagram) it.next();\n618:             Object fig = diagram.getContainingFig(member);\n619:             if (fig != null) {\n620:                 figs.add(fig);\n621:             }\n622:         }\n623:         return figs;\n624:     }\n625: \n626:     /** \n627:      * Finds a classifier with a certain name.<p>\n628:      * \n629:      * Will only return first classifier with the matching name.\n630:      *\n631:      * @param s is short name.\n632:      * @param ns Namespace where we do the search.\n633:      * @return the found classifier (or <tt>null</tt> if not found).\n634:      */\n635:     public Object findTypeInModel(String s, Object ns) {\n636:         \n637:         if (!ModelFacade.isANamespace(ns)) {\n638:             throw new IllegalArgumentException();\n639:     \t}\n640:         \n641:         Collection allClassifiers =\n642:             Model.getModelManagementHelper()\n643: \t        .getAllModelElementsOfKind(ns, ModelFacade.CLASSIFIER);\n644:         \n645:         Object[] classifiers = allClassifiers.toArray();\n646:         Object classifier = null;\n647:         \n648:         for (int i = 0; i < classifiers.length; i++) {\n649:             \n650:             classifier = classifiers[i];\n651:             if (ModelFacade.getName(classifier) != null\n652:             \t\t&& ModelFacade.getName(classifier).equals(s)) {\n653:                 return classifier;\n654:             }\n655:         }\n656:         \n657:         return null;\n658:     }\n659: \n660:     /**\n661:      * @param m the namespace\n662:      */\n663:     public void setCurrentNamespace(Object m) {\n664:         \n665:         if (m != null && !ModelFacade.isANamespace(m)) {\n666:             throw new IllegalArgumentException();\n667:     \t}\n668:         \n669:         currentNamespace = m;\n670:     }\n671: \n672:     /**\n673:      * @return the namespace\n674:      */\n675:     public Object getCurrentNamespace() {\n676:         return currentNamespace;\n677:     }\n678: \n679:     /**\n680:      * @return the diagrams\n681:      */\n682:     public Vector getDiagrams() {\n683:         return diagrams;\n684:     }\n685: \n686:     /**\n687:      * Get the number of diagrams in this project.\n688:      * Used by argo2.tee!!\n689:      * @return the number of diagrams in this project.\n690:      */\n691:     public int getDiagramCount() {\n692:         return diagrams.size();\n693:     }\n694: \n695:     /**\n696:      * Finds a diagram with a specific name or UID.\n697:      *\n698:      * @return the diagram object (if found). Otherwize null.\n699:      * @param name is the name to search for.\n700:      */\n701:     public ArgoDiagram getDiagram(String name) {\n702:         Iterator it = diagrams.iterator();\n703:         while (it.hasNext()) {\n704:             ArgoDiagram ad = (ArgoDiagram) it.next();\n705:             if (ad.getName() != null && ad.getName().equals(name)) {\n706:                 return ad;\n707:             }\n708:             if (ad.getItemUID() != null\n709:                     && ad.getItemUID().toString().equals(name)) {\n710:                 return ad;\n711:             }\n712:         }\n713:         return null;\n714:     } \n715: \n716:     /**\n717:      * @param d the diagram to be added\n718:      */\n719:     public void addDiagram(ArgoDiagram d) {\n720:         // send indeterminate new value instead of making copy of vector\n721:         diagrams.addElement(d);\n722:         d.addVetoableChangeListener(new Vcl());\n723:         ProjectManager.getManager().setNeedsSave(true);\n724:     }\n725: \n726:     /**\n727:      * Removes a diagram from the list with diagrams. \n728:      * \n729:      * Removes (hopefully) the event listeners for this diagram.  Does\n730:      * not remove the diagram from the project members. This should\n731:      * not be called directly. Use moveToTrash if you want to remove a\n732:      * diagram.\n733:      * \n734:      * @param d the ArgoDiagram\n735:      */\n736:     protected void removeDiagram(ArgoDiagram d) {\n737:         d.removeVetoableChangeListener(new Vcl());\n738:         diagrams.removeElement(d);\n739:         // if the diagram is a statechart,\n740:         // remove its associated statemachine model elements\n741:         if (d instanceof UMLStateDiagram) {\n742:             UMLStateDiagram statediagram = (UMLStateDiagram) d;\n743:             // if the statemachine has already been deleted,\n744:             // and is now null,\n745:             // don't attempt to delete it!\n746:             if (statediagram.getStateMachine() != null) {\n747:                 this.moveToTrash(statediagram.getStateMachine());\n748:             }\n749:         }\n750:     }\n751: \n752:     /**\n753:      * Listener to events from the Diagram class. <p>\n754:      * \n755:      * Purpose: changing the name of a diagram shall set the need save flag.\n756:      * \n757:      * @author mvw@tigris.org\n758:      */\n759:     private class Vcl implements VetoableChangeListener {\n760:         /**\n761:          * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n762:          */\n763:         public void vetoableChange(PropertyChangeEvent evt)\n764:             throws PropertyVetoException {\n765:             if (evt.getPropertyName().equals(\"name\"))\n766:                 ProjectManager.getManager().setNeedsSave(true);\n767:         }\n768:     }\n769:     \n770:     /**\n771:      * @param me the given modelelement\n772:      * @return the total number of presentation \n773:      *         for the given modelelement in the project\n774:      */\n775:     public int getPresentationCountFor(Object me) {\n776:         \n777:         if (!ModelFacade.isAModelElement(me)) {\n778:             throw new IllegalArgumentException();\n779:     \t}\n780:         \n781:         int presentations = 0;\n782:         int size = diagrams.size();\n783:         for (int i = 0; i < size; i++) {\n784:             Diagram d = (Diagram) diagrams.elementAt(i);\n785:             presentations += d.getLayer().presentationCountFor(me);\n786:         }\n787:         return presentations;\n788:     }\n789: \n790:     /**\n791:      * @return an initial target, in casu a diagram or a model\n792:      */\n793:     public Object getInitialTarget() {\n794:         if (diagrams.size() > 0) {\n795:             return diagrams.elementAt(0);\n796:         }\n797:         if (models.size() > 0) {\n798:             return models.elementAt(0);\n799:         }\n800:         return null;\n801:     }\n802: \n803: \n804:     /**\n805:      * @param cgp the generation preferences\n806:      */\n807:     public void setGenerationPrefs(GenerationPreferences cgp) {\n808:         cgPrefs = cgp;\n809:     }\n810:     \n811:     /**\n812:      * @return the generation preferences\n813:      */\n814:     public GenerationPreferences getGenerationPrefs() {\n815:         return cgPrefs;\n816:     }\n817: \n818:     ////////////////////////////////////////////////////////////////\n819:     // event handling\n820: \n821:     /**\n822:      * @return the VetoableChangeSupport\n823:      */\n824:     public VetoableChangeSupport getVetoSupport() {\n825:         if (vetoSupport == null) {\n826:             vetoSupport = new VetoableChangeSupport(this);\n827:         }\n828:         return vetoSupport;\n829:     }\n830: \n831:     /**\n832:      * This is executed before a save.\n833:      */\n834:     public void preSave() {\n835:         for (int i = 0; i < diagrams.size(); i++) {\n836:             ((Diagram) diagrams.elementAt(i)).preSave();\n837:         }\n838:         // TODO: is preSave needed for models?\n839:     }\n840: \n841:     /**\n842:      * This is execcuted after a save.\n843:      */\n844:     public void postSave() {\n845:         for (int i = 0; i < diagrams.size(); i++) {\n846:             ((Diagram) diagrams.elementAt(i)).postSave();\n847:         }\n848:         // TODO: is postSave needed for models?\n849:         ProjectManager.getManager().setNeedsSave(false);\n850:     }\n851: \n852:     /**\n853:      * This is executed after a load.\n854:      */\n855:     public void postLoad() {\n856:         for (int i = 0; i < diagrams.size(); i++) {\n857:             ((Diagram) diagrams.elementAt(i)).postLoad();\n858:         }\n859:         // issue 1725: the root is not set, which leads to problems\n860:         // with displaying prop panels\n861:         setRoot( getModel());\n862:         \n863:         ProjectManager.getManager().setNeedsSave(false);\n864:         // we don't need this HashMap anymore so free up the memory\n865:         uuidRefs = null;\n866:     }\n867: \n868:     ////////////////////////////////////////////////////////////////\n869:     // trash related methods\n870: \n871:     /**\n872:      * Moves some object to trash. \n873:      *\n874:      * TODO: This mechanism must be rethought since it only deletes an\n875:      * object completely from the project\n876:      *\n877:      * @param obj The object to be deleted\n878:      * @see org.argouml.kernel.Project#trashInternal(Object)\n879:      */\n880:     // Attention: whole Trash mechanism should be rethought concerning nsuml\n881:     public void moveToTrash(Object obj) {\n882:         if (Trash.SINGLETON.contains(obj)) {\n883:             return;\n884:         }\n885:         trashInternal(obj);\n886:     }\n887: \n888:     /**\n889:      * Removes some object from the project. Does not update GUI since\n890:      * this method only handles project management.\n891:      * @param obj\n892:      *\n893:      * <p>Attention: whole Trash mechanism should be rethought concerning nsuml\n894:      * \n895:      * <p>Note that at present these are all if, not\n896:      * else-if. Rather than make a big change, I've just explicitly dealt with\n897:      * the case where we have a use case that is not classifier.\n898:      */\n899:     protected void trashInternal(Object obj) {\n900:         boolean needSave = false;\n901:         if (obj != null) {\n902:             TargetManager.getInstance().removeTarget(obj);\n903:             TargetManager.getInstance().removeHistoryElement(obj);\n904:             Trash.SINGLETON.addItemFrom(obj, null);\n905:         }\n906:         if (ModelFacade.isABase(obj)) { // an object that can be represented\n907:             ProjectBrowser.getInstance().getEditorPane()\n908:         \t\t.removePresentationFor(obj, getDiagrams());\n909: \n910:             Model.getUmlFactory().delete(obj);\n911: \n912:             if (obj instanceof ProjectMember\n913:                     && members.contains(obj)) {\n914:                 members.remove(obj);\n915:             }\n916:             \n917:             if (models.contains(obj)) {\n918:                 models.remove(obj);\n919:             }\n920:             \n921:             needSave = true;\n922:             \n923:             // scan if some diagrams need to be deleted, too\n924:             // copy diagrams, otherwise ConcurrentModificationException\n925:             Collection c = new ArrayList(diagrams);\n926:             Iterator i = c.iterator();\n927:             while (i.hasNext()) {\n928:                 Object d = i.next();\n929:                 if (d instanceof UMLDiagram) {\n930:                     if (((UMLDiagram) d).needsToBeRemoved()) {\n931:                         moveToTrash(d);\n932:                     }\n933:                 }    \n934:             }\n935:         } else {\n936:             if (obj instanceof ArgoDiagram) {\n937:                 removeProjectMemberDiagram((ArgoDiagram) obj);\n938:                 needSave = true;\n939:                 // only need to manually delete diagrams because they\n940:                 // don't have a decent event system set up.\n941:                 ExplorerEventAdaptor.getInstance().modelElementRemoved(obj);\n942:             }\n943:             if (obj instanceof Fig) {\n944:                 ((Fig) obj).deleteFromModel();\n945:                 needSave = true;\n946:                 // for explorer deletion:\n947:                 obj = ((Fig) obj).getOwner();\n948:             } \n949:             if (obj instanceof CommentEdge) {\n950:                 ProjectBrowser.getInstance().getEditorPane()\n951:                     .removePresentationFor(obj, getDiagrams());\n952:                 ((CommentEdge) obj).delete();\n953:             }\n954:         }        \n955:         ProjectManager.getManager().setNeedsSave(needSave);\n956:     }\n957: \n958:     /**\n959:      * @param obj the object to be moved from the trash\n960:      * TODO: Is \"move\" remove or restore? \n961:      */\n962:     public void moveFromTrash(Object obj) {\n963:         if (LOG.isDebugEnabled()) {\n964:             LOG.debug(\"TODO: not restoring \" + obj);\n965:         }\n966:     }\n967: \n968:     /**\n969:      * @param dm the object \n970:      * @return true if the object is trashed\n971:      */\n972:     public boolean isInTrash(Object dm) {\n973:         return Trash.SINGLETON.contains(dm);\n974:     }\n975: \n976:     /**\n977:      * @param theDefaultModel a uml model\n978:      */\n979:     public void setDefaultModel(Object theDefaultModel) {\n980:         \n981:         if (!ModelFacade.isAModel(theDefaultModel)) {\n982:             throw new IllegalArgumentException();\n983:         }\n984:         \n985:         defaultModel = theDefaultModel;\n986:         defaultModelCache = new HashMap();\n987:     }\n988: \n989:     /**\n990:      * Get the default model.\n991:      * \n992:      * @return A model.\n993:      */\n994:     public Object getDefaultModel() {\n995:         return defaultModel;\n996:     }\n997: \n998:     /** Find a type by name in the default model.\n999:      *\n1000:      * @param name the name.\n1001:      * @return the type.\n1002:      */\n1003:     public Object findTypeInDefaultModel(String name) {\n1004:         if (defaultModelCache.containsKey(name)) {\n1005:             return defaultModelCache.get(name);\n1006:         }\n1007:         \n1008:         Object result = findTypeInModel(name, getDefaultModel());\n1009:         defaultModelCache.put(name, result);\n1010:         return result;\n1011:     }\n1012: \n1013:     /**\n1014:      * Returns the root.\n1015:      * @return MModel\n1016:      */\n1017:     public Object getRoot() {\n1018:         return treeRoot;\n1019:     }\n1020: \n1021:     /**\n1022:      * Sets the root.\n1023:      * @param root The root to set, a uml model\n1024:      */\n1025:     public void setRoot(Object root) {\n1026:         \n1027:         if (!ModelFacade.isAModel(root)) {\n1028:             throw new IllegalArgumentException();\n1029:         }\n1030:         \n1031:         if (treeRoot != null) {\n1032:             models.remove(treeRoot);\n1033:         }\n1034:         treeRoot = root;\n1035:         addModel(root);\n1036:     }\n1037: \n1038:     /**\n1039:      * Returns true if the given name is a valid name for a diagram. Valid means\n1040:      * that it does not occur as a name for a diagram yet.\n1041:      * @param name The name to test\n1042:      * @return boolean True if there are no problems with this name, false if\n1043:      * it's not valid.\n1044:      */\n1045:     public boolean isValidDiagramName(String name) {\n1046:         Iterator it = getDiagrams().iterator();\n1047:         boolean rv = true;\n1048:         while (it.hasNext()) {\n1049:             ArgoDiagram diagram = (ArgoDiagram) it.next();\n1050:             if (diagram.getName().equals(name)) {\n1051:                 rv = false;\n1052:                 break;\n1053:             }\n1054:         }\n1055:         return rv;\n1056:     }\n1057: \n1058:     /**\n1059:      * Returns the cgPrefs.\n1060:      * @return GenerationPreferences\n1061:      */\n1062:     public GenerationPreferences getCgPrefs() {\n1063:         return cgPrefs;\n1064:     }\n1065: \n1066:     /**\n1067:      * Returns the searchpath.\n1068:      * @return Vector\n1069:      */\n1070:     public Vector getSearchpath() {\n1071:         return searchpath;\n1072:     }\n1073: \n1074:     /**\n1075:      * Returns the url.\n1076:      * @return URL\n1077:      */\n1078:     public URL getUrl() {\n1079:         return url;\n1080:     }\n1081: \n1082:     /**\n1083:      * Returns the uUIDRefs.\n1084:      * @return HashMap\n1085:      */\n1086:     public HashMap getUUIDRefs() {\n1087:         return uuidRefs;\n1088:     }\n1089: \n1090:     /**\n1091:      * Sets the cgPrefs.\n1092:      * @param theCgPrefs The cgPrefs to set\n1093:      */\n1094:     public void setCgPrefs(GenerationPreferences theCgPrefs) {\n1095:         this.cgPrefs = theCgPrefs;\n1096:     }\n1097: \n1098:     /**\n1099:      * Sets the searchpath.\n1100:      * @param theSearchpath The searchpath to set\n1101:      */\n1102:     public void setSearchpath(Vector theSearchpath) {\n1103:         this.searchpath = theSearchpath;\n1104:     }\n1105: \n1106:     /**\n1107:      * Sets the url.\n1108:      * @param theUrl The url to set\n1109:      */\n1110:     public void setUrl(URL theUrl) {\n1111:         url = theUrl;\n1112:     }\n1113: \n1114:     /**\n1115:      * Sets the uUIDRefs.\n1116:      * @param uUIDRefs The uUIDRefs to set\n1117:      */\n1118:     public void setUUIDRefs(HashMap uUIDRefs) {\n1119:         uuidRefs = uUIDRefs;\n1120:     }\n1121: \n1122:     /**\n1123:      * Sets the vetoSupport.\n1124:      * @param theVetoSupport The vetoSupport to set\n1125:      */\n1126:     public void setVetoSupport(VetoableChangeSupport theVetoSupport) {\n1127:         this.vetoS