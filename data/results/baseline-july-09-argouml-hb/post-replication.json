ication.security.ArgoSecurityManager;\n34: import org.argouml.kernel.ProjectManager;\n35: import org.argouml.model.uml.foundation.core.CoreFactory;\n36: \n37: import ru.novosoft.uml.MElementEvent;\n38: import ru.novosoft.uml.MElementListener;\n39: import ru.novosoft.uml.MFactoryImpl;\n40: import ru.novosoft.uml.foundation.core.MClass;\n41: import ru.novosoft.uml.foundation.core.MOperationImpl;\n42: import ru.novosoft.uml.foundation.core.MParameter;\n43: import ru.novosoft.uml.foundation.core.MParameterImpl;\n44: \n45: /**\n46:  * @since Oct 15, 2002\n47:  * @author jaap.branderhorst@xs4all.nl\n48:  */\n49: public class TestUmlModelEventPump extends TestCase {\n50:     \n51:     private MClass elem;\n52:     private MockModelEventListener listener;\n53:     private boolean eventcalled;\n54:     private TestListener listener2;\n55: \n56:     \n57:     private class TestListener implements MElementListener {\n58:         \n59:         /**\n60:          * @see ru.novosoft.uml.MElementListener#listRoleItemSet(ru.novosoft.uml.MElementEvent)\n61:          */\n62:         public void listRoleItemSet(MElementEvent e) {\n63:             eventcalled = true;\n64:         }\n65: \n66:         /**\n67:          * @see ru.novosoft.uml.MElementListener#propertySet(ru.novosoft.uml.MElementEvent)\n68:          */\n69:         public void propertySet(MElementEvent e) {\n70:             eventcalled = true;\n71:         }\n72: \n73:         /**\n74:          * @see ru.novosoft.uml.MElementListener#recovered(ru.novosoft.uml.MElementEvent)\n75:          */\n76:         public void recovered(MElementEvent e) {\n77:             eventcalled = true;\n78:         }\n79: \n80:         /**\n81:          * @see ru.novosoft.uml.MElementListener#removed(ru.novosoft.uml.MElementEvent)\n82:          */\n83:         public void removed(MElementEvent e) {\n84:             eventcalled = true;\n85:         }\n86: \n87:         /**\n88:          * @see ru.novosoft.uml.MElementListener#roleAdded(ru.novosoft.uml.MElementEvent)\n89:          */\n90:         public void roleAdded(MElementEvent e) {\n91:             eventcalled = true;\n92:         }\n93: \n94:         /**\n95:          * @see ru.novosoft.uml.MElementListener#roleRemoved(ru.novosoft.uml.MElementEvent)\n96:          */\n97:         public void roleRemoved(MElementEvent e) {\n98:             eventcalled = true;\n99:         }\n100: \n101:     }\n102:     \n103:     \n104:     \n105:     /**\n106:      * Constructor for TestUmlModelEventPump.\n107:      * @param arg0\n108:      */\n109:     public TestUmlModelEventPump(String arg0) {\n110:         super(arg0);\n111:     }\n112:     \n113:     /**\n114:      * @see junit.framework.TestCase#setUp()\n115:      */\n116:     protected void setUp() throws Exception {\n117:         super.setUp(); \n118:         ArgoSecurityManager.getInstance().setAllowExit(true);\n119:         MFactoryImpl.setEventPolicy(MFactoryImpl.EVENT_POLICY_IMMEDIATE);\n120:         elem = CoreFactory.getFactory().createClass();\n121:         ProjectManager.getManager().getCurrentProject().getRoot().addOwnedElement(elem);\n122:         listener = new MockModelEventListener();\n123:         eventcalled = false;\n124:         listener2 = new TestListener();\n125:     }\n126: \n127:     /**\n128:      * @see junit.framework.TestCase#tearDown()\n129:      */\n130:     protected void tearDown() throws Exception {\n131:         super.tearDown();\n132:         UmlFactory.getFactory().delete(elem);\n133:         UmlModelEventPump.getPump().cleanUp();\n134:         listener2 = null;\n135:         listener = null;\n136:     }\n137:     \n138:     /**\n139:      * Test wether a listener can be registred to both the registry with class\n140:      * modelevent listeners as the object modelevent listeners\n141:      */\n142:     public void testAddLegalListener() {\n143:         UmlModelEventPump.getPump().cleanUp();\n144:         assertTrue(UmlModelEventPump.getPump().getListenerMap().isEmpty());\n145:         assertEquals(UmlModelEventPump.getPump().getListenerModelEventsMap().size(), 0);\n146:         UmlModelEventPump.getPump().addClassModelEventListener(listener, elem.getClass(), new String[] {\"name\"});\n147:         UmlModelEventPump.getPump().addModelEventListener(listener, elem, new String[] {\"name\"});\n148:         assertTrue(!UmlModelEventPump.getPump().getListenerMap().isEmpty());\n149:         assertTrue(!UmlModelEventPump.getPump().getListenerModelEventsMap().isEmpty());\n150:         assertTrue(UmlModelEventPump.getPump().getListenerModelEventsMap().get(elem.hashCode() + \"name\") instanceof Collection);\n151:         assertTrue(((Collection)UmlModelEventPump.getPump().getListenerModelEventsMap().get(elem.hashCode() + \"name\")).contains(listener));\n152:     }\n153:    \n154:     /**\n155:      * Tests wether an exception is thrown if one tries to register a listener\n156:      * to a class that is no subclass of MBase\n157:      */\n158:     public void testAddNonMBaseClassListener() {\n159:         try {\n160:             UmlModelEventPump.getPump().addClassModelEventListener(listener, Object.class, new String[] {\"name\"});\n161:             fail();\n162:         }\n163:         catch(Exception ex) {}\n164:     }\n165:     \n166:     /**\n167:      * Tests wether it is possible (it should not be) to give empty arguments\n168:      * while registring a listener\n169:      */\n170:     public void testAddEmptyParametersListener() {\n171:         try {\n172:             UmlModelEventPump.getPump().addClassModelEventListener(null, elem.getClass(), new String[] {\"name\"});\n173:             fail();\n174:         } catch (Exception ex) {}\n175:         try {\n176:             UmlModelEventPump.getPump().addClassModelEventListener(listener, null, new String[] {\"name\"});\n177:             fail();\n178:         } catch (Exception ex) {}\n179:         try {\n180:             UmlModelEventPump.getPump().addModelEventListener(null, elem, new String[] {\"name\"});\n181:             fail();\n182:         } catch (Exception ex) {}\n183:         try {\n184:             UmlModelEventPump.getPump().addModelEventListener(listener, null, new String[] {\"name\"});\n185:         } catch (Exception ex) {}\n186:     }\n187:     \n188:     /**\n189:      * Tests if the association from a modelelement to the pump is thrown away\n190:      * after deletion of the element.\n191:      */\n192:     public void testCreateDelete() {\n193:         WeakReference ref = new WeakReference(elem);\n194:         UmlFactory.getFactory().delete(elem);\n195:         elem = null;\n196:         System.gc();\n197:         assertNull(ref.get());\n198:         try {\n199:             setUp(); // to avoid NP's during teardown\n200:         } catch (Exception ex) {}\n201:     }\n202:     \n203:     /**\n204:      * Tests if it is possible to add a listener twice to the same subclass of\n205:      * MBase. Adding a listener twice, should result in only 1 such element in the listenerlist.\n206:      */\n207:     public void testDoubleClassAdd() {\n208:         UmlModelEventPump.getPump().addClassModelEventListener(listener, elem.getClass(), new String[] {\"name\"});\n209:         UmlModelEventPump.getPump().addClassModelEventListener(listener, elem.getClass(), new String[] {\"name\"});\n210:         assertEquals(1, UmlModelEventPump.getPump().getListenerMap().size());\n211:         assertEquals(1, ((Set)UmlModelEventPump.getPump().getListenerMap().get(elem.getClass())).size());\n212:     }\n213:     \n214:     /**\n215:      * Tests if it is possible to add a listener twice to the same modelelement.\n216:      * Adding a listener twice, should result in only 1 such element in the listenerlist.\n217:      */\n218:     public void testDoubleObjectAdd() {\n219:         UmlModelEventPump.getPump().addModelEventListener(listener, elem, new String[] {\"name\"});\n220:         UmlModelEventPump.getPump().addModelEventListener(listener, elem, new String[] {\"name\"});\n221:         assertEquals(1, UmlModelEventPump.getPump().getListenerModelEventsMap().size());\n222:         assertEquals(1, ((Set)UmlModelEventPump.getPump().getListenerModelEventsMap().get(UmlModelEventPump.getPump().getKey(elem, \"name\"))).size());\n223:     } \n224:     \n225:     /**\n226:      * Tests if a listener that registred for a ListRoleItemSet event on the class level really\n227:      * received the event.\n228:      */\n229:     public void testListRoleItemSetClass() {   \n230:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, elem.getClass(), new String[] {\"feature\"});     \n231:         elem.addFeature(new MOperationImpl());        \n232:         elem.setFeature(0, new MOperationImpl());\n233:         assertTrue(eventcalled);\n234:     }\n235:     \n236:     /**\n237:      * Tests if a listener that registred for a PropertySet event on the class level really\n238:      * received the event.\n239:      */\n240:     public void testPropertySetClass() {        \n241:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, elem.getClass(), new String[] {\"isRoot\"});\n242:         elem.setRoot(true);\n243:         assertTrue(eventcalled);\n244:     }\n245:     \n246:     /**\n247:      * Tests if a listener that registred for a ListRoleItemSet event on the class level really\n248:      * received the event.\n249:      */\n250:     public void testRecoveredClass() {       \n251:         // this is never done, not by NSUML and not by Argo... \n252:         // therefore no implementation possible\n253:     }\n254:     \n255:     /**\n256:      * Tests if a listener that registred for a Removed event on the class level really\n257:      * received the event.\n258:      */\n259:     public void testRemovedClass() {        \n260:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, elem.getClass(), new String[] {\"remove\"});\n261:         elem.remove();\n262:         assertTrue(eventcalled);\n263:     }\n264:     \n265:     /**\n266:      * Tests if a listener that registred for a RoleAdded event on the class level really\n267:      * received the event.\n268:      */\n269:     public void testRoleAddedSetClass() {        \n270:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, elem.getClass(), new String[] {\"parameter\"});\n271:         elem.addParameter(new MParameterImpl());\n272:         assertTrue(eventcalled);\n273:     }\n274:     \n275:     /**\n276:      * Tests if a listener that registred for a RoleRemoved event on the class level really\n277:      * received the event.\n278:      */\n279:     public void testRoleRemovedSetClass() {  \n280:         MParameter param = new MParameterImpl();\n281:         elem.addParameter(param);\n282:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, elem.getClass(), new String[] {\"parameter\"});\n283:         elem.removeParameter(param);\n284:         assertTrue(eventcalled);\n285:     }\n286:     \n287:     \n288:     \n289:     /**\n290:      * Tests if a non registred listener does not receive any events (never can\n291:      * be too sure :))\n292:      */\n293:     public void testFireNonRegistredListener() {\n294:         MClass elem2 = CoreFactory.getFactory().createClass();\n295:         elem.addParameter(new MParameterImpl());\n296:         assertTrue(!eventcalled);\n297:     }\n298:     \n299:     /**\n300:      * Tests if a listener that registred for a ListRoleItemSet event really\n301:      * received the event.\n302:      */\n303:     public void testListRoleItemSet() {        \n304:         elem.addFeature(new MOperationImpl());\n305:         UmlModelEventPump.getPump().addModelEventListener(listener2, elem, new String[] {\"feature\"});\n306:         elem.setFeature(0, new MOperationImpl());\n307:         assertTrue(eventcalled);\n308:     }\n309:     \n310:     /**\n311:      * Tests if a listener that registred for a PropertySet event really\n312:      * received the event.\n313:      */\n314:     public void testPropertySet() {        \n315:         UmlModelEventPump.getPump().addModelEventListener(listener2, elem, new String[] {\"isRoot\"});\n316:         elem.setRoot(true);\n317:         assertTrue(eventcalled);\n318:     }\n319:     \n320:     /**\n321:      * Tests if a listener that registred for a Recovered event really\n322:      * received the event.\n323:      */\n324:     public void testRecovered() {       \n325:         // this is never done, not by NSUML and not by Argo... \n326:         // therefore no implementation possible\n327:     }\n328:     \n329:     /**\n330:      * Tests if a listener that registred for a Removed event really\n331:      * received the event.\n332:      */\n333:     public void testRemoved() {        \n334:         UmlModelEventPump.getPump().addModelEventListener(listener2, elem, new String[] {UmlModelEventPump.REMOVE});\n335:         elem.remove();\n336:         assertTrue(eventcalled);\n337:     }\n338:     \n339:     /**\n340:      * Tests if a listener that registred for a RoleAddedSet event really\n341:      * received the event.\n342:      */\n343:     public void testRoleAddedSet() {        \n344:         UmlModelEventPump.getPump().addModelEventListener(listener2, elem, new String[] {\"parameter\"});\n345:         elem.addParameter(new MParameterImpl());\n346:         assertTrue(eventcalled);\n347:     }\n348:     \n349:     /**\n350:      * Tests if a listener that registred for a RoleRemovedSet event really\n351:      * received the event.\n352:      */\n353:     public void testRoleRemovedSet() {  \n354:         MParameter param = new MParameterImpl()      ;\n355:         elem.addParameter(param);\n356:         UmlModelEventPump.getPump().addModelEventListener(listener2, elem, new String[] {\"parameter\"});\n357:         elem.removeParameter(param);\n358:         assertTrue(eventcalled);\n359:     }\n360:     \n361:     /**\n362:      * Tests if a listener to a class that is legally added and then removed, really is removed.\n363:      */\n364:     public void testRemoveLegalClassListener() {\n365:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, elem.getClass(), new String[] {\"isRoot\"});\n366:         UmlModelEventPump.getPump().removeClassModelEventListener(listener2, elem.getClass(), new String[] {\"isRoot\"});\n367:         assertTrue(UmlModelEventPump.getPump().getListenerMap().isEmpty());\n368:         elem.addParameter(new MParameterImpl());\n369:         assertTrue(!eventcalled);\n370:     }\n371:     \n372:     /**\n373:      * Tests if a listener that is legally added and then removed, really is removed.\n374:      */\n375:     public void testRemoveLegalListener() {\n376:         UmlModelEventPump.getPump().addModelEventListener(listener2, elem, new String[] {\"isRoot\"});\n377:         UmlModelEventPump.getPump().removeModelEventListener(listener2, elem, new String[] {\"isRoot\"});\n378:         assertTrue(UmlModelEventPump.getPump().getListenerModelEventsMap().isEmpty());\n379:         elem.addParameter(new MParameterImpl());\n380:         assertTrue(!eventcalled);\n381:     }\n382:      \n383:     /**\n384:      * Tests if the hashmap with listeners not is empty after removing one \n385:      * listener but not all listeners.\n386:      */\n387:     public void testRemoveListenerNonEmptyClass() {\n388:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, elem.getClass(), new String[] {\"isRoot\"});\n389:         UmlModelEventPump.getPump().addClassModelEventListener(listener, elem.getClass(), new String[] {\"isRoot\"});\n390:         UmlModelEventPump.getPump().removeClassModelEventListener(listener, elem.getClass(), new String[] {\"isRoot\"});\n391:         assertTrue(!UmlModelEventPump.getPump().getListenerMap().isEmpty());\n392:     }    \n393:         \n394:     /**\n395:      * Tests if the hashmap with listeners not is empty after removing one \n396:      * listener but not all listeners.\n397:      */\n398:     public void testRemoveListenerNonEmpty() {\n399:         UmlModelEventPump.getPump().addModelEventListener(listener2, elem, new String[] {\"isRoot\"});\n400:         UmlModelEventPump.getPump().addModelEventListener(listener, elem, new String[] {\"isRoot\"});\n401:         UmlModelEventPump.getPump().removeModelEventListener(listener, elem, new String[] {\"isRoot\"});\n402:         assertTrue(!UmlModelEventPump.getPump().getListenerModelEventsMap().isEmpty());\n403:     }\n404:     \n405:     // the behavior that a registred class not only listens to its own events \n406:     // (for instance a MModelelement listens to name events and to events fired by MElement)\n407:     // is much too powerfull and will cost a lot of performance. Therefore I removed\n408:     // this feature\n409:     /*\n410:     public void testListensDependencyToSuperClass() {\n411:         MDependency dep = CoreFactory.getFactory().createDependency();\n412:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, dep.getClass(), \"behavior\");\n413:         dep.addBehavior(StateMachinesFactory.getFactory().createStateMachine());\n414:         assertTrue(eventcalled);\n415:     }\n416:     \n417:     public void testListensSuperClassToDependency() {\n418:         MDependency dep = CoreFactory.getFactory().createDependency();\n419:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, MModelElement.class, \"behavior\");\n420:         dep.addBehavior(StateMachinesFactory.getFactory().createStateMachine());\n421:         assertTrue(eventcalled);\n422:     }\n423:     */\n424:     /**\n425:      * Tests if a listener that registered for all events for some modelClass\n426:      * receives all events\n427:      */\n428:     public void testPropertySetClass2() {        \n429:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, elem.getClass());\n430:         elem.setRoot(true);\n431:         assertTrue(eventcalled);\n432:     }\n433:     \n434:     /**\n435:      * Tests if a listener that registered for all events for some modelClass\n436:      * receives all events\n437:      */\n438:     public void testListRoleItemSetClass2() {        \n439:         elem.addFeature(new MOperationImpl());\n440:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, elem.getClass());\n441:         elem.setFeature(0, new MOperationImpl());\n442:         assertTrue(eventcalled);\n443:     }\n444:     \n445:     /**\n446:      * Tests if a listener that registered for all events for some modelClass\n447:      * receives all events\n448:      */\n449:     public void testRecoveredClass2() {       \n450:         // this is never done, not by NSUML and not by Argo... \n451:         // therefore no implementation possible\n452:     }\n453:     \n454:     /**\n455:      * Tests if a listener that registered for all events for some modelClass\n456:      * receives all events\n457:      */\n458:     public void testRemovedClass2() {        \n459:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, elem.getClass());\n460:         elem.remove();\n461:         assertTrue(eventcalled);\n462:     }\n463:     \n464:     /**\n465:      * Tests if a listener that registered for all events for some modelClass\n466:      * receives all events\n467:      */\n468:     public void testRoleAddedSetClass2() {        \n469:         UmlModelEventPump.getPump().addClassModelEventListener(listener2, elem.getClass());\n470:         elem.addParameter(new MParameterImpl());\n471:         assertTrue(eventcalled);\n472:     }\n473:     \n474:     /**\n475:      * Tests if a listener that registered for all events for some modelClass\n476:      * receives all events\n477:      */\n478:     public void testRoleRemovedSetClass2() {  \n479:         MParameter param = new MParameterImpl()      ;\n480:         elem.addParameter(param);\n481