n\", and that is\n47:    *  confusing. */\n48:   public final int JUSTIFY_LEFT = 0;\n49:   public final int JUSTIFY_RIGHT = 1;\n50:   public final int JUSTIFY_CENTER = 2;\n51: \n52:   /** Minimum size of a FigText object. */\n53:   public final int MIN_TEXT_WIDTH = 30;\n54: \n55:   ////////////////////////////////////////////////////////////////\n56:   // instance variables\n57: \n58:   /** Font info. */\n59:   protected Font _font = new Font(\"TimesRoman\", Font.PLAIN, 10);\n60:   protected FontMetrics _fm;\n61:   protected int _lineHeight;\n62: \n63:   /** Color of the actual text characters. */\n64:   protected Color _textColor = Color.black;\n65: \n66:   /** Color to be drawn behind the actual text characters. Note that\n67:    *  this will be a smaller area than the bounding box which is\n68:    *  filled with FillColor. */\n69:   protected Color _textFillColor = Color.white;\n70: \n71:   /** True if the area behind individual characters is to be filled\n72:    *  with TextColor. */\n73:   protected boolean _textFilled = false;\n74:   protected boolean _underline = false;\n75:   // needs-more-work: use insets instead\n76:   protected int _lineSpacing = -4;\n77:   protected int _topMargin = 1;\n78:   protected int _botMargin = 1;\n79:   protected int _leftMargin = 1;\n80:   protected int _rightMargin = 1;\n81: \n82:   /** True if the FigText can only grow in size, never shrink. */\n83:   protected boolean _expandOnly = false;\n84: \n85:   /** Text alignment can be JUSTIFY_LEFT, JUSTIFY_RIGHT, or JUSTIFY_CENTER. */\n86:   protected int _justification;\n87: \n88:   /** The current string to display. */\n89:   protected String _curText;\n90: \n91:   ////////////////////////////////////////////////////////////////\n92:   // static initializer\n93:   static {\n94:     PropCategoryManager.categorizeProperty(\"Text\", \"font\");\n95:     PropCategoryManager.categorizeProperty(\"Text\", \"underline\");\n96:     PropCategoryManager.categorizeProperty(\"Text\", \"expandOnly\");\n97:     PropCategoryManager.categorizeProperty(\"Text\", \"lineSpacing\");\n98:     PropCategoryManager.categorizeProperty(\"Text\", \"topMargin\");\n99:     PropCategoryManager.categorizeProperty(\"Text\", \"botMargin\");\n100:     PropCategoryManager.categorizeProperty(\"Text\", \"leftMargin\");\n101:     PropCategoryManager.categorizeProperty(\"Text\", \"rightMargin\");\n102:     PropCategoryManager.categorizeProperty(\"Text\", \"text\");\n103:     PropCategoryManager.categorizeProperty(\"Style\", \"alignment\");\n104:     PropCategoryManager.categorizeProperty(\"Style\", \"textFilled\");\n105:     PropCategoryManager.categorizeProperty(\"Style\", \"textFillColor\");\n106:     PropCategoryManager.categorizeProperty(\"Style\", \"textColor\");\n107:   }\n108: \n109:   ////////////////////////////////////////////////////////////////\n110:   // constructors\n111: \n112:   /** Construct a new FigText with the given position, size, color,\n113:    *  string, and font. */\n114:   public FigText(int x, int y, int w, int h,\n115: \t\t Color textColor, String familyName, int fontSize) {\n116:     super(x, y, w, h);\n117:     _x = x; _y = y; _w = w; _h = h;\n118:     _textColor = textColor;\n119:     _font = new Font(familyName, Font.PLAIN, fontSize);\n120:     _justification = JUSTIFY_CENTER;\n121:     _curText = \"\";\n122:   }\n123: \n124:   /** Construct a new FigText with the given position, size, and attributes. */\n125:   public FigText(int x, int y, int w, int h, Hashtable gAttrs ) {\n126:     this(x, y, w, h, Color.blue, \"TimesRoman\", 10);\n127:     //    put(gAttrs);\n128:   }\n129: \n130:   ////////////////////////////////////////////////////////////////\n131:   // invariant\n132: \n133:   public boolean OK() {\n134:     if (!super.OK()) return false;\n135:     return _font != null && _lineSpacing > -20 && _topMargin >= 0 &&\n136:       _botMargin >= 0 && _leftMargin >= 0 && _rightMargin >= 0 &&\n137:       (_justification == JUSTIFY_LEFT || _justification == JUSTIFY_CENTER ||\n138:        _justification == JUSTIFY_RIGHT) && _textColor != null &&\n139:       _textFillColor != null;\n140:   }\n141:   ////////////////////////////////////////////////////////////////\n142:   // accessors\n143: \n144:   /** Reply a string that indicates how the text is justified: Left,\n145:    *  Center, or Right. */\n146:   public String getJustificationByName() {\n147:     // needs-more-work: index into static array?\n148:     // return _AlignmentNames[_alignment];\n149:     if (_justification == JUSTIFY_LEFT) return \"Left\";\n150:     else if (_justification == JUSTIFY_CENTER) return \"Center\";\n151:     else if (_justification == JUSTIFY_RIGHT) return \"Right\";\n152:     System.out.println(\"internal error, unknown text alignment\");\n153:     return \"Unknown\";\n154:   }\n155: \n156:   /** Set the text justification given one of these strings: Left,\n157:    *  Center, or Right. */\n158:   public void setJustificationByName(String alignString) {\n159:     if (alignString.equals(\"Left\")) _justification = JUSTIFY_LEFT;\n160:     else if (alignString.equals(\"Center\")) _justification = JUSTIFY_CENTER;\n161:     else if (alignString.equals(\"Right\")) _justification = JUSTIFY_RIGHT;\n162:     _fm = null;\n163:   }\n164: \n165: \n166: \n167:   ////////////////////////////////////////////////////////////////\n168:   // accessors and modifiers\n169: \n170:   public Color getTextColor() { return _textColor; }\n171:   public void setTextColor(Color c) { _textColor = c; }\n172:   public Color getTextFillColor() { return _textFillColor; }\n173:   public void setTextFillColor(Color c) { _textFillColor = c; }\n174:   public boolean getTextFilled() { return _textFilled; }\n175:   public void setTextFilled(boolean b) { _textFilled = b; }\n176:   public boolean getUnderline() { return _underline; }\n177:   public void setUnderline(boolean b) { _underline = b; }\n178: \n179:   public String getJustification() { return getJustificationByName(); }\n180:   public void setJustification(String align) { setJustificationByName(align); }\n181:   public int getLineSpacing() { return _lineSpacing; }\n182:   public void setLineSpacing(int s) { _lineSpacing = s; calcBounds(); }\n183: \n184:   public int getTopMargin() { return _topMargin; }\n185:   public void setTopMargin(int m) { _topMargin = m; calcBounds(); }\n186:   public int getBotMargin() { return _botMargin; }\n187:   public void setBotMargin(int m) { _botMargin = m; calcBounds(); }\n188:   public int getLeftMargin() { return _leftMargin; }\n189:   public void setLeftMargin(int m) { _leftMargin = m; calcBounds(); }\n190:   public int getRightMargin() { return _rightMargin; }\n191:   public void setRightMargin(int m) { _rightMargin = m; calcBounds(); }\n192: \n193:   public boolean getExpandOnly() { return _expandOnly; }\n194:   public void setExpandOnly(boolean b) { _expandOnly = b; }\n195: \n196:   public Font getFont() { return _font; }\n197:   public void setFont(Font f) { _font = f; _fm = null; calcBounds(); }\n198: \n199:   public boolean getItalic() { return _font.isItalic(); }\n200:   public void setItalic(boolean b) {\n201:     int style = (getBold() ? Font.BOLD : 0) + (b ? Font.ITALIC : 0);\n202:     setFont(new Font(_font.getFamily(), _font.getSize(), style));\n203:   }\n204: \n205:   public boolean getBold() { return _font.isBold(); }\n206:   public void setBold(boolean b) {\n207:     int style = (b ? Font.BOLD : 0) + (getItalic() ? Font.ITALIC : 0);\n208:     setFont(new Font(_font.getFamily(), _font.getSize(), style));\n209:   }\n210: \n211:   /** Remove the last char from the current string line and return the\n212:    *  new string.  Called whenever the user hits the backspace key.\n213:    *  Needs-More-Work: Very slow.  This will eventually be replaced by\n214:    *  full text editing... if there are any volunteers to do that...*/\n215:   public String deleteLastCharFromString(String string) {\n216:     int string_length = Math.max(string.length() - 1, 0);\n217:     char[] string_char = string.toCharArray();\n218:     String new_string = new String(string_char,0,string_length);\n219:     return new_string;\n220:   }\n221: \n222:   /** Delete the last char from the current string. Called whenever\n223:    *  the user hits the backspace key */\n224:   public void deleteLastChar() {\n225:     _curText = deleteLastCharFromString(_curText);\n226:     calcBounds();\n227:   }\n228: \n229:   /** Append a character to the current String .*/\n230:   public void append(char c) { setText(_curText + c); }\n231: \n232:   /** Append the given String to the current String. */\n233:   public void append(String s) { setText(_curText + s); }\n234: \n235:   /** set the current String to be the given String. */\n236:   public void setText(String s) { _curText = s; calcBounds(); }\n237: \n238:   /** Get the String held by this FigText. Multi-line text is\n239:    *  represented by newline characters embedded in the String. */\n240:   public String getText() { return _curText; }\n241: \n242:   ////////////////////////////////////////////////////////////////\n243:   // painting methods\n244: \n245:   /** Paint the FigText. */\n246:   public void paint(Graphics g) {\n247:     int chunkX = _x + _leftMargin;\n248:     int chunkY = _y + _topMargin;\n249:     StringTokenizer lines;\n250: \n251:     if (_filled) {\n252:       g.setColor(_fillColor);\n253:       g.fillRect(_x, _y, _w, _h);\n254:     }\n255:     if (_lineWidth > 0) {\n256:       g.setColor(_lineColor);\n257:       g.drawRect(_x - 1, _y - 1, _w + 1, _h + 1);\n258:     }\n259: \n260:     if (_font != null) g.setFont(_font);\n261:     _fm = g.getFontMetrics(_font);\n262:     int chunkH = _lineHeight + _lineSpacing;\n263:     chunkY = _y + _topMargin + chunkH;\n264:     if (_textFilled) {\n265:       g.setColor(_textFillColor);\n266:       lines = new StringTokenizer(_curText, \"\\n\\r\", true);\n267:       while (lines.hasMoreTokens()) {\n268: \tString curLine = lines.nextToken();\n269: \t//if (curLine.equals(\"\\r\")) continue;\n270: \tint chunkW = _fm.stringWidth(curLine);\n271: \tswitch (_justification) {\n272: \tcase JUSTIFY_LEFT: break;\n273: \tcase JUSTIFY_CENTER: chunkX = _x + (_w - chunkW) / 2; break;\n274: \tcase JUSTIFY_RIGHT: chunkX = _x + _w - chunkW - _rightMargin; break;\n275: \t}\n276: \tif (curLine.equals(\"\\n\") || curLine.equals(\"\\r\")) chunkY += chunkH;\n277: \telse g.fillRect(chunkX, chunkY - chunkH, chunkW, chunkH);\n278:       }\n279:     }\n280: \n281:     g.setColor(_textColor);\n282:     chunkX = _x + _leftMargin;\n283:     chunkY = _y + _topMargin + _lineHeight + _lineSpacing;\n284:     lines = new StringTokenizer(_curText, \"\\n\\r\", true);\n285:     while (lines.hasMoreTokens()) {\n286:       String curLine = lines.nextToken();\n287:       //if (curLine.equals(\"\\r\")) continue;\n288:       int chunkW = _fm.stringWidth(curLine);\n289:       switch (_justification) {\n290:       case JUSTIFY_LEFT: break;\n291:       case JUSTIFY_CENTER: chunkX = _x + ( _w - chunkW ) / 2; break;\n292:       case JUSTIFY_RIGHT: chunkX = _x + _w  - chunkW; break;\n293:       }\n294:       if (curLine.equals(\"\\n\")  || curLine.equals(\"\\r\")) chunkY += chunkH;\n295:       else g.drawString(curLine, chunkX, chunkY);\n296:     }\n297:   }\n298: \n299: \n300: \n301:   ////////////////////////////////////////////////////////////////\n302:   // event handlers\n303: \n304:   /** When the user presses a key when a FigText is selected, that key\n305:    *  should be added to the current string, or if the key was\n306:    *  backspace, the last character is removed.  Needs-More-Work: Should\n307:    *  also catch arrow keys and mouse clicks for full text\n308:    *  editing... someday... */\n309:   public void keyTyped(KeyEvent ke) {\n310:     if (ke.getModifiers() != 0) return;\n311:     char c = ke.getKeyChar();\n312:     if (!Character.isISOControl(c)) {\n313:       startTrans();\n314:       append(c);\n315:       endTrans();\n316:       ke.consume();\n317:     }\n318:   }\n319: \n320:   public void keyPressed(KeyEvent ke) {\n321:     if (ke.getKeyCode() == KeyEvent.VK_BACK_SPACE) {\n322:       startTrans();\n323:       deleteLastChar();\n324:       endTrans();\n325:       ke.consume();\n326:     }\n327:     if (ke.getKeyCode() == KeyEvent.VK_ENTER) {\n328:       startTrans();\n329:       append('\\n');\n330:       endTrans();\n331:       ke.consume();\n332:     }\n333:   }\n334:   public void keyReleased(KeyEvent ke) { }\n335: \n336:   \n337:   ////////////////////////////////////////////////////////////////\n338:   // internal utility functions\n339: \n340:   /** Compute the overall width and height of the FigText object based\n341:    *  on the font, font size, and current text. Needs-More-Work: Right\n342:    *  now text objects can get larger when you type more, but they\n343:    *  do not get smaller when you backspace.  */\n344:   protected void calcBounds() {\n345:     if (_font == null) return;\n346:     if (_fm == null) _fm = Toolkit.getDefaultToolkit().getFontMetrics(_font);\n347:     int overallW = 0;\n348:     int numLines = 1;\n349:     StringTokenizer lines = new StringTokenizer(_curText, \"\\n\\r\", true);\n350:     while (lines.hasMoreTokens()) {\n351:       String curLine = lines.nextToken();\n352:       int chunkW = _fm.stringWidth(curLine);\n353:       if (curLine.equals(\"\\n\") || curLine.equals(\"\\r\")) numLines++;\n354:       else overallW = Math.max(chunkW, overallW);\n355:     }\n356:     _lineHeight = _fm.getHeight();\n357:     int maxDescent = _fm.getMaxDescent();\n358:     int overallH = (_lineHeight + _lineSpacing) * numLines +\n359:       _topMargin + _botMargin + maxDescent;\n360:     overallW = Math.max(MIN_TEXT_WIDTH, overallW + _leftMargin + _rightMargin);\n361:     switch (_justification) {\n362:     case JUSTIFY_LEFT: break;\n363:     case JUSTIFY_CENTER: if (_w < overallW) _x -= (overallW - _w) / 2; break;\n364:     case JUSTIFY_RIGHT: if (_w < overallW) _x -= (overallW - _w); break;\n365:     }\n366:     _w = _expandOnly ? Math.max(_w, overallW) : overallW;\n367:     _h = _expandOnly ? Math.max(_h, overallH) : overallH;\n368:   }\n369: \n370: } /* end class FigText */\n371: ",
