rt java.awt.Color;\n33: import java.awt.Dimension;\n34: import java.awt.Rectangle;\n35: import java.util.ArrayList;\n36: import java.util.Collection;\n37: import java.util.Iterator;\n38: import java.util.Vector;\n39: \n40: import org.argouml.application.api.Notation;\n41: import org.argouml.model.ModelFacade;\n42: import org.argouml.uml.diagram.ui.FigEdgeModelElement;\n43: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n44: import org.tigris.gef.base.Selection;\n45: import org.tigris.gef.graph.GraphModel;\n46: import org.tigris.gef.presentation.Fig;\n47: import org.tigris.gef.presentation.FigRect;\n48: import org.tigris.gef.presentation.FigText;\n49: \n50: /** Class to display graphics for a UML Component in a diagram. */\n51: \n52: public class FigComponent extends FigNodeModelElement {\n53:     /** The distance between the left edge of the fig and the left edge of the\n54: \tmain rectangle. */\n55:     private static final int BIGPORT_X = 10;\n56: \n57:     private static final int OVERLAP = 4;\n58: \n59:     private FigRect cover;\n60:     private FigRect upperRect;\n61:     private FigRect lowerRect;\n62: \n63: \n64:     ////////////////////////////////////////////////////////////////\n65:     // constructors\n66: \n67:     /**\n68:      * Constructor.\n69:      */\n70:     public FigComponent() {\n71: \tcover = new FigRect(BIGPORT_X, 10, 120, 80, Color.black, Color.white);\n72: \tupperRect = new FigRect(0, 20, 20, 10, Color.black, Color.white);\n73: \tlowerRect = new FigRect(0, 40, 20, 10, Color.black, Color.white);\n74: \n75: \tgetNameFig().setLineWidth(0);\n76: \tgetNameFig().setFilled(false);\n77: \tgetNameFig().setText( getH() );\n78: \n79: \taddFig(getBigPort());\n80: \taddFig(cover);\n81: \taddFig(getStereotypeFig());\n82: \taddFig(getNameFig());\n83: \taddFig(upperRect);\n84: \taddFig(lowerRect);\n85:     }\n86: \n87:     // TODO: Why not just super( gm, node ) instead?? (ChL)\n88:     /**\n89:      * The constructor that hooks the Fig into an existing UML element\n90:      * @param gm ignored\n91:      * @param node the UML element\n92:      */\n93:     public FigComponent(GraphModel gm, Object node) {\n94: \tthis();\n95: \tsetOwner(node);\n96: \tif (org.argouml.model.ModelFacade.isAClassifier(node)\n97: \t        && (org.argouml.model.ModelFacade.getName(node) != null)) {\n98: \t    getNameFig().setText(org.argouml.model.ModelFacade.getName(node));\n99: \t}\n100: \tupdateBounds();\n101:     }\n102: \n103:     /**\n104:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#getH()\n105:      */\n106:     public String placeString() {\n107: \treturn \"new Component\";\n108:     }\n109: \n110:     /**\n111:      * @see java.lang.Object#clone()\n112:      */\n113:     public Object clone() {\n114: \tFigComponent figClone = (FigComponent) super.clone();\n115: \tIterator it = figClone.getFigs(null).iterator();\n116: \tfigClone.setBigPort((FigRect) it.next());\n117: \tfigClone.cover = (FigRect) it.next();\n118: \tfigClone.setStereotypeFig((FigText) it.next());\n119: \tfigClone.setNameFig((FigText) it.next());\n120: \tfigClone.upperRect = (FigRect) it.next();\n121: \tfigClone.lowerRect = (FigRect) it.next();\n122: \n123: \treturn figClone;\n124:     }\n125: \n126:     ////////////////////////////////////////////////////////////////\n127:     // acessors\n128: \n129:     /**\n130:      * @param b switch underline on or off\n131:      */\n132:     public void setUnderline(boolean b) {\n133: \tgetNameFig().setUnderline(b);\n134:     }\n135: \n136:     /**\n137:      * @see org.tigris.gef.presentation.Fig#setLineColor(java.awt.Color)\n138:      */\n139:     public void setLineColor(Color c) {\n140: \t//super.setLineColor(c);\n141: \tcover.setLineColor(c);\n142: \tgetStereotypeFig().setFilled(false);\n143: \tgetStereotypeFig().setLineWidth(0);\n144: \tgetNameFig().setFilled(false);\n145: \tgetNameFig().setLineWidth(0);\n146: \tupperRect.setLineColor(c);\n147: \tlowerRect.setLineColor(c);\n148:     }\n149: \n150: \n151:     /**\n152:      * @see org.tigris.gef.presentation.Fig#makeSelection()\n153:      */\n154:     public Selection makeSelection() {\n155: \treturn new SelectionComponent(this);\n156:     }\n157: \n158:     /**\n159:      * @see org.tigris.gef.presentation.Fig#getMinimumSize()\n160:      */\n161:     public Dimension getMinimumSize() {\n162: \tDimension stereoDim = getStereotypeFig().getMinimumSize();\n163: \tDimension nameDim = getNameFig().getMinimumSize();\n164: \n165: \tint h = stereoDim.height + nameDim.height - OVERLAP;\n166: \tint w = Math.max(stereoDim.width, nameDim.width) + BIGPORT_X;\n167: \n168: \treturn new Dimension(w, h);\n169:     }\n170: \n171:     /**\n172:      * @see org.tigris.gef.presentation.Fig#setBounds(int, int, int, int)\n173:      */\n174:     public void setBounds(int x, int y, int w, int h) {\n175: \n176: \tRectangle oldBounds = getBounds();\n177: \tgetBigPort().setBounds(x + BIGPORT_X, y, w - BIGPORT_X, h);\n178: \tcover.setBounds(x + BIGPORT_X, y, w - BIGPORT_X, h);\n179: \n180: \tDimension stereoDim = getStereotypeFig().getMinimumSize();\n181: \tDimension nameDim = getNameFig().getMinimumSize();\n182: \tif (h < 50) {\n183: \t    upperRect.setBounds(x, y + h / 6, 20, 10);\n184: \t    lowerRect.setBounds(x, y + 3 * h / 6, 20, 10);\n185: \t}\n186: \telse {\n187: \t    upperRect.setBounds(x, y + 13, 20, 10);\n188: \t    lowerRect.setBounds(x, y + 39, 20, 10);\n189: \t}\n190: \n191: \tgetStereotypeFig().setBounds(x + BIGPORT_X + 1,\n192: \t\t\t\t     y + 1,\n193: \t\t\t\t     w - BIGPORT_X - 2,\n194: \t\t\t\t     stereoDim.height);\n195: \tgetNameFig().setBounds(x + BIGPORT_X + 1,\n196: \t\t\t       y + stereoDim.height - OVERLAP + 1,\n197: \t\t\t       w - BIGPORT_X - 2,\n198: \t\t\t       nameDim.height);\n199: \t_x = x; _y = y; _w = w; _h = h;\n200: \tfirePropChange(\"bounds\", oldBounds, getBounds());\n201: \tupdateEdges();\n202:     }\n203: \n204: \n205:     ////////////////////////////////////////////////////////////////\n206:     // user interaction methods\n207: \n208:     /*\n209:       public void mouseClicked(MouseEvent me) {\n210:       super.mouseClicked(me);\n211:       setLineColor(Color.black);\n212:       }\n213: \n214:       public void mousePressed(MouseEvent me) {\n215:       super.mousePressed(me);\n216:       Editor ce = Globals.curEditor();\n217:       Selection sel = ce.getSelectionManager().findSelectionFor(this);\n218:       if (sel instanceof SelectionComponent) {\n219:       ((SelectionComponent) sel).hideButtons();\n220:       }\n221:       }\n222:     */\n223: \n224:     /**\n225:      * @see org.tigris.gef.presentation.Fig#setEnclosingFig(org.tigris.gef.presentation.Fig)\n226:      */\n227:     public void setEnclosingFig(Fig encloser) {\n228:     \n229: \tif (encloser != null\n230: \t    && org.argouml.model.ModelFacade.isANode(encloser.getOwner())\n231: \t    && getOwner() != null)\n232: \t{\n233: \t    Object node = /*(MNode)*/ encloser.getOwner();\n234: \t    Object comp = /*(MComponent)*/ getOwner();\n235: \t    if (!ModelFacade.getDeploymentLocations(comp).contains(node)) {\n236: \t\tModelFacade.addDeploymentLocation(comp, node);\n237: \t    }\n238: \t    super.setEnclosingFig(encloser);\n239:         \n240: \t    if (getLayer() != null) {\n241: \t            // elementOrdering(figures);\n242: \t        Collection contents = getLayer().getContents(null);\n243: \t        Collection bringToFrontList = new ArrayList();\n244: \t        Iterator it = contents.iterator();\n245: \t        while (it.hasNext()) {\n246: \t            Object o = it.next();\n247: \t            if (o instanceof FigEdgeModelElement) {\n248: \t                bringToFrontList.add(o);\n249: \t                \n250: \t            }\n251: \t        }\n252: \t        Iterator bringToFrontIter = bringToFrontList.iterator();\n253: \t        while (bringToFrontIter.hasNext()) {\n254: \t            FigEdgeModelElement figEdge = \n255: \t                (FigEdgeModelElement) bringToFrontIter.next();\n256: \t            figEdge.getLayer().bringToFront(figEdge);\n257: \t        }\n258: \t    }\n259: \t} else\n260: \t    if (encloser == null && getEnclosingFig() != null) {\n261: \t\tif (getEnclosingFig() instanceof FigNodeModelElement)\n262: \t\t    ((FigNodeModelElement)\n263: \t\t     getEnclosingFig()).getEnclosedFigs().removeElement(this);\n264: \t\tsetEncloser(null);\n265: \t    }\n266: \t/*\n267: \n268: \tif (!(getOwner() instanceof MModelElement)) return;\n269: \tif (getOwner() instanceof MComponent) {\n270: \tMComponent me = (MComponent) getOwner();\n271: \tMNode mnode = null;\n272: \n273: \tif (encloser != null && (encloser.getOwner() instanceof MNode)) {\n274:         mnode = (MNode) encloser.getOwner();\n275: \t}\n276: \tif (encloser != null && (encloser.getOwner() instanceof MComponent)) {\n277:         MComponent comp = (MComponent) encloser.getOwner();\n278:         Collection compNodes = comp.getDeploymentLocations();\n279:         Iterator it = compNodes.iterator();\n280:         while (it.hasNext()) {\n281: \tmnode = (MNode) it.next();\n282:         }\n283: \t}\n284: \n285: \ttry {\n286: \n287:         Collection nodes = me.getDeploymentLocations();\n288:         if ((nodes != null) && (nodes.size()>0) && (!(nodes.contains(mnode)))) {\n289: \tIterator itnodes = nodes.iterator();\n290: \twhile (itnodes.hasNext()) {\n291: \tMNode cls = (MNode) itnodes.next();\n292: \tme.removeDeploymentLocation(cls);\n293: \t}\n294:         }\n295: \n296:         if(mnode != null && (!(nodes.contains(mnode)))) {\n297: \tme.addDeploymentLocation(mnode);\n298:         }\n299:         setNode(figures);\n300: \t}\n301: \tcatch (Exception e) {\n302:         cat.error(\"could not set package\", e);\n303: \t}\n304: \t}\n305: \t*/\n306:     }\n307: \n308:     /**\n309:      * TODO: This is not used anywhere. Can we remove it?\n310:      * @param figures ?\n311:      */\n312:     public void setNode(Vector figures) {\n313: \tint size = figures.size();\n314: \tif (figures != null && (size > 0)) {\n315: \t    for (int i = 0; i < size; i++) {\n316: \t\tObject o = figures.elementAt(i);\n317: \t\tif (o instanceof FigComponent) {\n318: \t\t    FigComponent figcomp = (FigComponent) o;\n319: \t\t    figcomp.setEnclosingFig(this);\n320: \t\t}\n321: \t    }\n322: \t}\n323:     }\n324: \n325:     /**\n326:      * @see org.tigris.gef.presentation.Fig#getUseTrapRect()\n327:      */\n328:     public boolean getUseTrapRect() { return true; }\n329: \n330: \n331:     ////////////////////////////////////////////////////////////////\n332:     // internal methods\n333: \n334:     /**\n335:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateStereotypeText()\n336:      */\n337:     protected void updateStereotypeText() {\n338: \tObject me = /*(MModelElement)*/ getOwner();\n339: \tif (me == null) return;\n340: \tObject stereo = null;\n341: \tif (ModelFacade.getStereotypes(me).size() > 0) {\n342:             stereo = ModelFacade.getStereotypes(me).iterator().next();\n343:         }\n344: \tif (stereo == null\n345: \t    || ModelFacade.getName(stereo) == null\n346: \t    || ModelFacade.getName(stereo).length() == 0) {\n347: \n348: \t    setStereotype(\"\");\n349: \n350: \t} else {\n351: \n352: \t    setStereotype(Notation.generateStereotype(this, stereo));\n353: \n354: \t}\n355:     }\n356: \n357: \n358: \n359:     /**\n360:      * @see org.tigris.gef.presentation.Fig#getHandleBox()\n361:      *\n362:      * Get the rectangle on whose corners the dragging handles are to\n363:      * be drawn.  Used by Selection Resize.\n364:      */\n365:     public Rectangle getHandleBox() {\n366: \n367:   \tRectangle r = getBounds();\n368:   \treturn new Rectangle(r.x + BIGPORT_X, r.y, r.width - BIGPORT_X,\n369: \t\t\t     r.height );\n370: \n371:     }\n372: \n373:     /**\n374:      * @see org.tigris.gef.presentation.Fig#setHandleBox(int, int, int, int)\n375:      */\n376:     public void setHandleBox( int x, int y, int w, int h ) {\n377: \n378:   \tsetBounds( x - BIGPORT_X, y, w + BIGPORT_X, h );\n379: \n380:     }\n381: \n382: \n383:     static final long serialVersionUID = 1647392857462847651L;\n384: \n385: } /* end class FigComponent */\n386: ",
