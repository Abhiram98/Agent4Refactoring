e() {\n967:         // TODO: Auto-generated method stub\n968:         return false;\n969:     }\n970: \n971:     // -------------------------------------------------------------------------\n972: \n973:     /**\n974:      * Logs module info block to logger\n975:      */\n976:     protected final void logModuleInfo() {\n977:         logModuleInfo(0);\n978:     }\n979: \n980:     /**\n981:      * Logs module info block to logger\n982:      *\n983:      * @param iMinWidth Minimum block width.\n984:      */\n985:     protected final void logModuleInfo(int iMinWidth) {\n986:         if (!TM_INFO_BLOCK_LOGGED.containsKey(this.getClass().toString())) {\n987:             StringBuffer sbHeadLine = new StringBuffer(\"| Module \");\n988:             sbHeadLine.append(getModuleName() + \" \"\n989:                     + getModuleVersion() + \" |\");\n990: \n991:             StringBuffer sbCopyLine =\n992:                     new StringBuffer(\"| Copyright (c) 2004, \");\n993:             sbCopyLine.append(getModuleAuthor() + \" |\");\n994: \n995:             StringBuffer sbDescLine = new StringBuffer(\"| \");\n996:             sbDescLine.append(getTabPanel() + \" |\");\n997: \n998:             if (sbHeadLine.length() > iMinWidth) {\n999:                 iMinWidth = sbHeadLine.length();\n1000:             }\n1001:             if (sbCopyLine.length() > iMinWidth) {\n1002:                 iMinWidth = sbCopyLine.length();\n1003:             }\n1004:             if (sbDescLine.length() > iMinWidth) {\n1005:                 iMinWidth = sbDescLine.length();\n1006:             }\n1007: \n1008:             String sRulerLine = \"+\";\n1009:             for (int i = 1; i <= iMinWidth - 2; i++) sRulerLine += \"-\";\n1010:             sRulerLine += \"+\";\n1011: \n1012:             String sEmptyLine = \"\";\n1013:             for (int i = 1; i <= iMinWidth; i++) sEmptyLine += \" \";\n1014: \n1015:             while (sbHeadLine.length() < iMinWidth) {\n1016:                 sbHeadLine.insert(sbHeadLine.length() - 2, \" \");\n1017:                 if (sbHeadLine.length() < iMinWidth) {\n1018:                     sbHeadLine.insert(2, \" \");\n1019:                 }\n1020:             }\n1021:             while (sbCopyLine.length() < iMinWidth) {\n1022:                 sbCopyLine.insert(sbCopyLine.length() - 2, \" \");\n1023:             }\n1024:             while (sbDescLine.length() < iMinWidth) {\n1025:                 sbDescLine.insert(sbDescLine.length() - 2, \" \");\n1026:             }\n1027: \n1028:             LOG.info(sEmptyLine);\n1029:             LOG.info(sRulerLine);\n1030:             LOG.info(sbHeadLine.toString());\n1031:             LOG.info(sRulerLine);\n1032:             LOG.info(sbCopyLine.toString());\n1033:             LOG.info(\"| \" + sEmptyLine.substring(4) + \" |\");\n1034:             LOG.info(sbDescLine.toString());\n1035:             LOG.info(sRulerLine);\n1036:             LOG.info(sEmptyLine);\n1037: \n1038:             TM_INFO_BLOCK_LOGGED.put(this.getClass().toString(), \"true\");\n1039:         }\n1040:     }\n1041: \n1042:     /**\n1043:      * Converts a type model element to a PHP type\n1044:      *\n1045:      * @param modelElement The model element to convert to a PHP type.\n1046:      *\n1047:      * @return The PHP type converted from the model element.\n1048:      */\n1049:     protected final String convertType(Object modelElement) {\n1050:         String sName = ModelFacade.getName(modelElement).trim();\n1051: \n1052:         if (sName.equals(\"void\"))    return null;\n1053: \n1054:         if (sName.equals(\"char\"))    return \"string\";\n1055: \n1056:         if (sName.equals(\"boolean\")) return \"bool\";\n1057:         if (sName.equals(\"bool\"))    return \"bool\";\n1058: \n1059:         if (sName.equals(\"int\"))     return \"int\";\n1060:         if (sName.equals(\"byte\"))    return \"int\";\n1061:         if (sName.equals(\"short\"))   return \"int\";\n1062:         if (sName.equals(\"long\"))    return \"int\";\n1063: \n1064:         if (sName.equals(\"float\"))   return \"float\";\n1065:         if (sName.equals(\"double\"))  return \"float\";\n1066: \n1067:         /* user defined type string, not (java.lang.)String */\n1068:         if (sName.equals(\"string\"))  return \"string\";\n1069: \n1070:         /* user defined type array */\n1071:         if (sName.equals(\"array\"))   return \"array\";\n1072: \n1073:         return null;\n1074:     }\n1075: \n1076:     /**\n1077:      * Generates the default value for a type\n1078:      *\n1079:      * @param modelElement classifier representing a type\n1080:      * @param sDefault     default value\n1081:      * @param bCast        prefix value with cast statement\n1082:      *\n1083:      * @return default value with explicite cast (if needed)\n1084:      */\n1085:     protected final String generateDefaultValue(Object modelElement,\n1086:             String sDefault, boolean bCast) {\n1087:         if (modelElement == null) return null;\n1088: \n1089:         if (!ModelFacade.isAClassifier(modelElement)) {\n1090:             throw new ClassCastException(modelElement.getClass()\n1091:                     + \" has wrong object type, Classifier required\");\n1092:         }\n1093: \n1094:         String sType = convertType(modelElement);\n1095:         if (sType == null) {\n1096:             return \"null\";\n1097:         } else if (sType.equals(\"string\")) {\n1098:             String sReturn = bCast ? \"(string) \" : \"\";\n1099:             if (sDefault != null) {\n1100:                 int iFirstApos = sDefault.indexOf(\"'\");\n1101:                 while (iFirstApos != -1) {\n1102:                     sDefault = sDefault.substring(0, iFirstApos)\n1103:                             + \"\\\\\" + sDefault.substring(iFirstApos);\n1104:                     iFirstApos = sDefault.indexOf(\"'\", iFirstApos + 2);\n1105:                 }\n1106:                 return sReturn + \"'\" + sDefault + \"'\";\n1107:             } else {\n1108:                 return sReturn + \"''\";\n1109:             }\n1110:         } else if (sType.equals(\"bool\")) {\n1111:             String sReturn = bCast ? \"(bool) \" : \"\";\n1112:             if (sDefault != null) {\n1113:             \tsDefault = sDefault.trim();\n1114:                 if (sDefault.length() > 0) {\n1115: \t\t    if (sDefault == \"0\") {\n1116: \t\t\treturn sReturn + \"false\";\n1117: \t\t    } else if (sDefault == \"false\") {\n1118: \t\t\treturn sReturn + \"false\";\n1119: \t\t    } else {\n1120: \t\t\treturn sReturn + \"true\";\n1121: \t\t    }\n1122:                 } else {\n1123:                 \treturn sReturn + \"false\";\n1124:                 }\n1125:             } else {\n1126:                 return sReturn + \"false\";\n1127:             }\n1128:         } else if (sType.equals(\"int\")) {\n1129:             String sReturn = bCast ? \"(int) \" : \"\";\n1130:             if (sDefault != null && sDefault.trim().length() > 0) {\n1131:                 return sReturn + sDefault.trim();\n1132:             } else {\n1133:                 return sReturn + String.valueOf(0);\n1134:             }\n1135:         } else if (sType.equals(\"float\")) {\n1136:             String sReturn = bCast ? \"(float) \" : \"\";\n1137:             if (sDefault != null && sDefault.trim().length() > 0) {\n1138:                 return sReturn + sDefault.trim();\n1139:             } else {\n1140:                 return sReturn + \"0.0\";\n1141:             }\n1142:         } else if (sType.equals(\"array\")) {\n1143:             if (sDefault != null && sDefault.trim() != \"\") {\n1144:                 return \"array(\" + sDefault + \")\";\n1145:             } else {\n1146:                 return \"array()\";\n1147:             }\n1148:         }\n1149: \n1150:         return \"null\";\n1151:     }\n1152: \n1153:     /**\n1154:      * Generates section for an operation element\n1155:      *\n1156:      * @param modelElement The model element to generate the section for.\n1157:      *\n1158:      * @return Generated section code for the model element.\n1159:      */\n1160:     private final String generateSection(Object modelElement) {\n1161:         return generateSection(modelElement, INDENT, null);\n1162:     }\n1163: \n1164:     /**\n1165:      * Generates section\n1166:      *\n1167:      * @param modelElement The model element to generate the section for.\n1168:      * @param sIndent      String to indent every section block line with.\n1169:      * @param sSuffix      Section identifier suffix\n1170:      *\n1171:      * @return Generated section code for the model element.\n1172:      */\n1173:     private final String generateSection(Object modelElement, String sIndent,\n1174:                                    String sSuffix) {\n1175:         String sId = ModelFacade.getUUID(modelElement);\n1176:         if (sId == null) {\n1177:             sId = (new UID().toString());\n1178:             ModelFacade.setUUID(modelElement, sId);\n1179:         }\n1180: \n1181:         if (sSuffix != null && sSuffix.trim() != \"\") {\n1182:             return Section.generate(sId + \"-\" + sSuffix.trim(), sIndent);\n1183:         } else {\n1184:             return Section.generate(sId, sIndent);\n1185:         }\n1186:     }\n1187: \n1188:     /**\n1189:      * Creates new source file.\n1190:      *\n1191:      * @param modelElement The class or interface.\n1192:      * @param file         The file object to write to.\n1193:      *\n1194:      * @return <code>true</code> on success,\n1195:      *         <code>false</code> otherwise;\n1196:      */\n1197:     private final boolean createFile(Object modelElement, File file) {\n1198:         if (!ModelFacade.isAClassifier(modelElement)) {\n1199:             throw new ClassCastException(modelElement.getClass()\n1200:                     + \" has wrong object type, Classifier required\");\n1201:         }\n1202: \n1203:         LOG.info(\"    Generating new \" + file.getPath());\n1204: \n1205:         String sOutput = \"<?php\\n\\n\";\n1206: \n1207:         sOutput += \"error_reporting(E_ALL);\\n\\n\";\n1208: \n1209:         PHPDocumentor objPHPDoc = null;\n1210:         try {\n1211:             objPHPDoc = new PHPDocumentor(modelElement,\n1212:                     PHPDocumentor.BLOCK_TYPE_FILE);\n1213:         } catch (Exception exp) {\n1214:             LOG.error(\"Generating file DocBlock FAILED: \"\n1215:                     + exp.getMessage());\n1216:         } finally {\n1217:             if (objPHPDoc != null) {\n1218:                 try {\n1219:                     objPHPDoc.setFilename(NameGenerator\n1220:                         .generateFilename(modelElement, iLanguageMajorVersion));\n1221:                 } catch (Exception exp) {\n1222:                     LOG.error(\"Setting filename for DocBlock FAILED: \"\n1223:                             + exp.getMessage());\n1224:                 } finally {\n1225:                     sOutput += objPHPDoc.toString() + \"\\n\";\n1226:                 }\n1227:             }\n1228:         }\n1229: \n1230:         sOutput += \"if (0 > version_compare(PHP_VERSION, '\"\n1231:                 + iLanguageMajorVersion + \"')) {\\n\";\n1232:         sOutput += INDENT + \"die('This file was generated for PHP \"\n1233:                 + iLanguageMajorVersion + \"');\\n\" + \"}\\n\\n\";\n1234: \n1235:         sOutput += generateRequired(modelElement);\n1236: \n1237:         sOutput += \"/* user defined includes */\\n\";\n1238:         sOutput += generateSection(modelElement, \"\", \"includes\") + \"\\n\";\n1239: \n1240:         sOutput += \"/* user defined constants */\\n\";\n1241:         sOutput += generateSection(modelElement, \"\", \"constants\") + \"\\n\";\n1242: \n1243:         sOutput += generate(modelElement);\n1244:         sOutput += \"\\n\\n?>\";\n1245: \n1246:         boolean bReturn = true;\n1247:         BufferedWriter bwOutput = null;\n1248:         try {\n1249:             File parentDir = new File(file.getParent());\n1250:             if (!parentDir.exists()) {\n1251:                 parentDir.mkdirs();\n1252:             }\n1253: \n1254:             bwOutput = new BufferedWriter(new FileWriter(file));\n1255:             bwOutput.write(sOutput);\n1256:         } catch (IOException exp) {\n1257:             LOG.error(\"    Catched IOException: \" + exp\n1258:                     + \", for file \" + file.getPath());\n1259:             bReturn = false;\n1260:         } finally {\n1261:             try {\n1262:                 if (bwOutput != null) {\n1263:                     bwOutput.close();\n1264:                 }\n1265:             } catch (IOException exp) {\n1266:                 LOG.error(\"    Catched IOException: \" + exp\n1267:                         + \", for file \" + file.getPath());\n1268: \n1269:                 bReturn = false;\n1270:             }\n1271:         }\n1272: \n1273:         return bReturn;\n1274:     }\n1275: \n1276:     /**\n1277:      * Updates the output file for a model element.\n1278:      *\n1279:      * @param modelElement The model element to update file for.\n1280:      * @param fileOrig     The original (previous) output file.\n1281:      *\n1282:      * @throws Exception\n1283:      */\n1284:     private final void updateFile(Object modelElement, File fileOrig)\n1285:         throws Exception {\n1286:         if (!ModelFacade.isAClassifier(modelElement)) {\n1287:             throw new ClassCastException(modelElement.getClass()\n1288:                 + \" has wrong object type, Classifier required\");\n1289:         }\n1290: \n1291:         objSection = new Section();\n1292: \n1293:         File fileNew    = new File(fileOrig.getAbsolutePath() + \".out\");\n1294:         File fileBackup = new File(fileOrig.getAbsolutePath() + \".bak\");\n1295: \n1296:         LOG.debug(\"    Parsing sections from \" + fileOrig.getPath());\n1297:         objSection.read(fileOrig.getAbsolutePath());\n1298: \n1299:         if (fileBackup.exists()) {\n1300:             LOG.debug(\"    Delete (old) backup \" + fileBackup.getPath());\n1301:             fileBackup.delete();\n1302:         }\n1303: \n1304:         LOG.debug(\"    Backup \" + fileOrig.getPath() + \" to \"\n1305:                 + fileBackup.getPath());\n1306:         fileOrig.renameTo(fileBackup);\n1307: \n1308:         if (this.createFile(modelElement, fileOrig)) {\n1309:             LOG.debug(\"    Merging sections into \" + fileNew.getPath());\n1310:             objSection.write(fileOrig.getAbsolutePath(), INDENT, true);\n1311: \n1312:             LOG.debug(\"    Renaming \" + fileNew.getPath()\n1313:                     + \" to \" + fileOrig.getPath());\n1314:             fileOrig.delete();\n1315:             fileNew.renameTo(fileOrig);\n1316:         } else {\n1317:             if (fileBackup.exists()) {\n1318:                 LOG.debug(\"    Renaming (restore) \" + fileBackup.getPath()\n1319:                         + \" to \" + fileOrig.getPath());\n1320:                 fileBackup.renameTo(fileOrig);\n1321:             }\n1322: \n1323:             LOG.error(\"    Updating \" + fileOrig.getPath() + \" failed\");\n1324:         }\n1325:     }\n1326: \n1327:     /**\n1328:      * Generates classifier attributes\n1329:      *\n1330:      * @param modelElement classifier\n1331:      *\n1332:      * @return source code for class attributes\n1333:      */\n1334:     private String generateClassifierAttributes(Object modelElement) {\n1335:         if (!ModelFacade.isAClassifier(modelElement)) {\n1336:             throw new ClassCastException(modelElement.getClass()\n1337:                     + \" has wrong object type, Classifier required\");\n1338:         }\n1339: \n1340:         String sClsAttr = \"\";\n1341: \n1342:         if (ModelFacade.isAClass(modelElement)) {\n1343:             sClsAttr += INDENT + \"// --- ATTRIBUTES ---\\n\";\n1344: \n1345:             Collection colAttributes =\n1346:                 ModelFacade.getAttributes(modelElement);\n1347: \n1348:             if (colAttributes != null) {\n1349:                 Iterator itAttributes = colAttributes.iterator();\n1350:                 while (itAttributes.hasNext()) {\n1351:                     Object attr = itAttributes.next();\n1352: \n1353:                     sClsAttr += \"\\n\";\n1354: \n1355:                     PHPDocumentor objPHPDoc = null;\n1356:                     try {\n1357:                         objPHPDoc = new PHPDocumentor(attr);\n1358:                     } catch (Exception exp) {\n1359:                         LOG.error(\"Generating attribute DocBlock FAILED: \"\n1360:                                 + exp.getMessage());\n1361:                     } finally {\n1362:                         if (objPHPDoc != null) {\n1363:                             sClsAttr += objPHPDoc.toString(INDENT);\n1364:                         }\n1365:                     }\n1366: \n1367:                     sClsAttr += INDENT + generate(attr) + \"\\n\";\n1368:                 }\n1369:             }\n1370: \n1371:             sClsAttr += \"\\n\";\n1372:         }\n1373: \n1374:         return sClsAttr;\n1375:     }\n1376: \n1377:     /**\n1378:      * Generates classifier generalisations\n1379:      *\n1380:      * @param modelElement classifier\n1381:      *\n1382:      * @return source code for extends part of class declaration\n1383:      */\n1384:     private String generateClassifierGeneralisations(Object modelElement) {\n1385:         if (!ModelFacade.isAClassifier(modelElement)) {\n1386:             throw new ClassCastException(modelElement.getClass()\n1387:                     + \" has wrong object type, Classifier required\");\n1388:         }\n1389: \n1390:         String sClsGen = \"\";\n1391: \n1392:         Collection colGeneralizations =\n1393:             ModelFacade.getGeneralizations(modelElement);\n1394:         if (colGeneralizations != null) {\n1395:             Iterator itGen = colGeneral