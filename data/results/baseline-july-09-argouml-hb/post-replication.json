     return super.getNodes();\n211:     }\n212: \n213: \n214:     /**\n215:      * @see java.lang.Object#toString()\n216:      */\n217:     public String toString() {\n218:         return \"Diagram: \" + getName();\n219:     }\n220: \n221:     /**\n222:      * We hang our heads in shame. There are still bugs in ArgoUML\n223:      * and/or GEF that cause corruptions in the model.\n224:      * Before a save takes place we repair the model in order to\n225:      * be as certain as possible that the saved file will reload.\n226:      * TODO: Split into small inner classes for each fix.\n227:      */\n228:     public String repair() {\n229:         StringBuffer report = new StringBuffer(500);\n230: \n231:         boolean faultFixed;\n232:         do {\n233:             faultFixed = false;\n234:             List figs = new ArrayList(getLayer().getContentsNoEdges());\n235:             for (Iterator i = figs.iterator(); i.hasNext();) {\n236:                 Fig f = (Fig) i.next();\n237:                 if (repairFig(f, report)) {\n238:                     faultFixed = true;\n239:                 }\n240:             }\n241:             figs = new ArrayList(getLayer().getContentsEdgesOnly());\n242:             for (Iterator i = figs.iterator(); i.hasNext();) {\n243:                 Fig f = (Fig) i.next();\n244:                 if (repairFig(f, report)) {\n245:                     faultFixed = true;\n246:                 }\n247:             }\n248:         } while (faultFixed); // Repeat until no faults are fixed\n249: \n250:         return report.toString();\n251:     }\n252:     \n253:     private boolean repairFig(Fig f, StringBuffer report) {\n254:         LOG.info(\"Checking \" + figDescription(f) + f.getOwner());\n255:         boolean faultFixed = false;\n256:         String figDescription = null;\n257:         \n258:         // 1. Make sure all Figs in the Diagrams layer refer back to\n259:         // that layer.\n260:         if (!getLayer().equals(f.getLayer())) {\n26