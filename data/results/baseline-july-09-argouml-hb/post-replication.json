                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/reveng/java/Modeller.java: \n1: // $Id$\n2: // Copyright (c) 2003-2004 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: // File: Modeller.java\n26: // Classes: Modeller\n27: // Original Author: Marcus Andersson andersson@users.sourceforge.net\n28: \n29: package org.argouml.uml.reveng.java;\n30: \n31: import java.util.Collection;\n32: import java.util.Iterator;\n33: import java.util.Stack;\n34: import java.util.Vector;\n35: import java.util.Hashtable;\n36: \n37: import org.apache.log4j.Logger;\n38: import org.argouml.model.ModelFacade;\n39: import org.argouml.model.uml.UmlFactory;\n40: import org.argouml.model.uml.UmlHelper;\n41: import org.argouml.model.uml.foundation.core.CoreFactory;\n42: import org.argouml.ocl.OCLUtil;\n43: import org.argouml.uml.reveng.DiagramInterface;\n44: import org.argouml.uml.reveng.Import;\n45: import org.tigris.gef.base.Globals;\n46: \n47: /**\n48:  * Modeller maps Java source code(parsed/recognised by ANTLR) to UML model\n49:  * elements, it applies some of the semantics in JSR26.\n50:  */\n51: public class Modeller\n52: {\n53:     /**\n54:      * Logger.<p>\n55:      */\n56:     private static final Logger LOG = Logger.getLogger(Modeller.class);\n57: \n58:     /**\n59:      * Current working model.\n60:      */\n61:     private Object model;\n62: \n63:     private DiagramInterface diagram;\n64:     \n65:     /** Current import session */\n66:     private Import importSession;\n67: \n68:     /** The package which the currentClassifier belongs to. */\n69:     private Object currentPackage;\n70:     \n71:     /** Last package name used in addPackage().\n72:      * It is null for classes wich are not packaged.\n73:      * Used in popClassifier() to create diagram for that\n74:      * packaget. \n75:      */\n76:     private String currentPackageName;\n77: \n78:     /** Keeps the data that varies during parsing. */\n79:     private ParseState parseState;\n80: \n81:     /** Stack up the state when descending inner classes. */\n82:     private Stack parseStateStack;\n83: \n84:     /** Only attributes will be generated. */\n85:     private boolean noAssociations;\n86: \n87:     /** Arrays will be modelled as unique datatypes. */\n88:     private boolean arraysAsDatatype;\n89: \n90:     /** the name of the file being parsed */\n91:     private String fileName;\n92:     \n93:     /** Arbitrary attributes */\n94:     private Hashtable attributes = new Hashtable();\n95:     \n96:     /** Create a new modeller.\n97:      * @param diag the interface to the diagram to add nodes and edges to\n98:      * @param imp The current Import session.\n99:      * @param noAss whether associations are modelled as attributes\n100:      * @param arraysAsDT whether darrays are modelled as dataypes\n101:      * @param fName the current file name\n102:      *\n103:      * @param m The model to work with.\n104:      */\n105:     public Modeller(Object m,\n106: \t\t    DiagramInterface diag,\n107: \t\t    Import imp,\n108: \t\t    boolean noAss,\n109: \t\t    boolean arraysAsDT,\n110: \t\t    String fName)\n111:     {\n112: \tmodel = m;\n113: \tnoAssociations = noAss;\n114: \tarraysAsDatatype = arraysAsDT;\n115: \timportSession = imp;\n116: \tcurrentPackage = this.model;\n117: \tparseState = new ParseState(this.model, getPackage(\"java.lang\"));\n118: \tparseStateStack = new Stack();\n119: \tdiagram = diag;\n120:         fileName = fName;\n121:     }\n122: \n123:     public Object getAttribute(String key) {\n124:         return attributes.get(key);\n125:     }\n126:     \n127:     public void setAttribute(String key, Object value) {\n128:         attributes.put(key, value);\n129:     }\n130:     \n131:     \n132:     /**\n133:      * Get the current diagram.\n134:      *\n135:      * @return a interface to the current diagram.\n136:      */\n137:     private DiagramInterface getDiagram() {\n138: \treturn diagram;\n139:     }\n140: \n141:     /**\n142:      * This is a mapping from a Java compilation Unit -> a UML component.\n143:      * Classes are resident in a component.\n144:      * Imports are relationships between components and other classes\n145:      * / packages.<p>\n146:      *\n147:      * See JSR 26.<p>\n148:      *\n149:      * Adding components is a little messy since there are 2 cases:\n150:      *\n151:      * <ol>\n152:      * <li>source file has package statement, will be added several times\n153:      *     since lookup in addComponent() only looks in the model since the\n154:      *     package namespace is not yet known.\n155:      *\n156:      * <li>source file has not package statement: component is added\n157:      *     to the model namespace. the is no package statement so the\n158:      *     lookup will always work.\n159:      *\n160:      * </ol>\n161:      * Therefore in the case of (1), we need to delete duplicate components\n162:      * in the addPackage() method.<p>\n163:      *\n164:      * In either case we need to add a package since we don't know in advance\n165:      * if there will be a package statement.<p>\n166:      */\n167:     public void addComponent() {\n168:         \n169:         // try and find the component in the current package\n170:         // to cope with repeated imports\n171:         // [this will never work if a package statmeent exists:\n172:         // because the package statement is parsed after the component is \n173:         // identified]\n174:         Object component = ModelFacade.lookupIn(currentPackage, fileName);\n175:         \n176:         if (component == null) {\n177:         \n178:             // remove the java specific ending (per JSR 26).\n179:             // BUT we can't do this because then the component will be confused\n180:             // with its class with the same name when invoking\n181:             // ModelFacade.lookupIn(Object,String)\n182:             /*\n183: \t      if(fileName.endsWith(\".java\"))\n184: \t      fileName = fileName.substring(0,\n185: \t      fileName.length()-5);\n186:             */\n187:             \n188:             component = UmlFactory.getFactory().getCore().createComponent();\n189:             ModelFacade.setName(component, fileName);\n190:         }\n191:         \n192:         parseState.addComponent(component);\n193:         \n194:         // set the namespace of the component, in the event\n195:         // that the source file does not have a package stmt\n196:         ModelFacade.setNamespace(parseState.getComponent(), model);\n197:     }\n198:     \n199:     /**\n200:        Called from the parser when a package clause is found.\n201: \n202:        @param name The name of the package.\n203:     */\n204:     public void addPackage(String name)\n205:     {\n206: \t// Add a package figure for this package to the owners class\n207: \t// diagram, if it's not in the diagram yet. I do this for all\n208: \t// the class diagrams up to the top level, since I need\n209: \t// diagrams for all the packages.\n210: \tString ownerPackageName, currentName = name;\n211: \twhile (!\"\".equals((ownerPackageName = getPackageName(currentName)))) {\n212: \t    if (getDiagram() != null\n213: \t\t&& importSession.isCreateDiagramsChecked()\n214: \t\t&& getDiagram().isDiagramInProject(ownerPackageName)) {\n215: \n216:                 getDiagram().selectClassDiagram(getPackage(ownerPackageName),\n217: \t\t\t\t\t\townerPackageName);\n218:                 getDiagram().addPackage(getPackage(currentName));\n219: \n220:             }\n221: \t    currentName = ownerPackageName;\n222: \t}\n223: \t// Save src_path in the upper package\n224: \tObject mPackage = getPackage(currentName);\n225: \tif (importSession.getSrcPath() != null\n226: \t    && ModelFacade.getTaggedValue(mPackage, \"src_path\") == null)\n227: \t    ModelFacade.setTaggedValue(mPackage, \"src_path\",\n228: \t\t\t\t       importSession.getSrcPath());\n229: \t\t\n230: \t// Find or create a MPackage NSUML object for this package.\n231: \tmPackage = getPackage(name);\n232:         currentPackageName = name;\n233: \n234: \t// Set the current package for the following source code.\n235: \tcurrentPackage = mPackage;\n236: \tparseState.addPackageContext(mPackage);\n237: \n238:         // Delay diagram creation until any classifier (class or\n239:         // interface) will be found\n240:         \n241:         //set the namespace of the component\n242:         // check to see if there is already a component defined:\n243:         Object component = ModelFacade.lookupIn(currentPackage, fileName);\n244:         \n245:         if (component == null) {\n246:             \n247:             // set the namespace of the component\n248:             ModelFacade.setNamespace(parseState.getComponent(), currentPackage);\n249:         } else {\n250:             \n251:             // a component already exists,\n252:             // so delete the latest one(the duplicate)\n253:             UmlFactory.getFactory().delete(parseState.getComponent());\n254:         // change the parse state to the existing one.\n255:             parseState.addComponent(component);\n256:         }\n257:     }\n258: \n259:     /**\n260:        Called from the parser when an import clause is found.\n261: \n262:        @param name The name of the import. Can end with a '*'.\n263:     */\n264:     public void addImport(String name)\n265:     {\n266:         // only do imports on the 2nd pass.\n267:         Object level = this.getAttribute(\"level\");\n268:         if (level != null) {\n269:             if (level.equals(new Integer(0))) {\n270:                 return;\n271:             }\n272:         }\n273:         \n274: \tString packageName = getPackageName(name);\n275: \tString classifierName = getClassifierName(name);\n276: \tObject mPackage = getPackage(packageName);\n277: \n278:         // import on demand\n279: \tif (classifierName.equals(\"*\")) {\n280: \t    parseState.addPackageContext(mPackage);\n281:             Object perm = null;\n282:             \n283:             // try find an existing permission\n284:             Iterator dependenciesIt =\n285:                 UmlHelper.getHelper().getCore()\n286: \t\t    .getDependencies(mPackage, parseState.getComponent())\n287: \t\t        .iterator();\n288:             while (dependenciesIt.hasNext()) {\n289:                 \n290:                 Object dependency = dependenciesIt.next();\n291:                 if (ModelFacade.isAPermission(dependency)) {\n292:                     \n293:                     perm = dependency;\n294:                     break;\n295:                 }\n296:             }\n297:             \n298:             // if no existing permission was found.\n299:             if (perm == null) {\n300: \t\tperm =\n301: \t\t    UmlFactory.getFactory().getCore()\n302: \t\t        .buildPermission(parseState.getComponent(), mPackage);\n303: \t\tString newName =\n304: \t\t    ModelFacade.getName(parseState.getComponent())\n305: \t\t    + \" -> \"\n306: \t\t    + packageName;\n307: \t\tModelFacade.setName(perm, newName);\n308:             }\n309: \t}\n310:         // single type import\n311: \telse {\n312:             Object mClassifier = null;\n313: \t    try {\n314: \t\tmClassifier =\n315: \t\t    (new PackageContext(null, mPackage)).get(classifierName);\n316: \t\tparseState.addClassifierContext(mClassifier);\n317:                 Object perm = null;\n318:                 \n319:                 // try find an existing permission\n320:                 Iterator dependenciesIt =\n321: \t\t    UmlHelper.getHelper().getCore()\n322:                         .getDependencies(mClassifier,\n323: \t\t\t\t\t parseState.getComponent())\n324:                             .iterator();\n325:                 while (dependenciesIt.hasNext()) {\n326:                     \n327:                     Object dependency = dependenciesIt.next();\n328:                     if (ModelFacade.isAPermission(dependency)) {\n329:                         \n330:                         perm = dependency;\n331:                         break;\n332:                     }\n333:                 }\n334:                 \n335:                 // if no existing permission was found.\n336:                 if (perm == null) {\n337:                     perm =\n338: \t\t\tUmlFactory.getFactory().getCore()\n339: \t\t\t    .buildPermission(parseState.getComponent(),\n340: \t\t\t\t\t     mClassifier);\n341: \t\t    String newName =\n342: \t\t\tModelFacade.getName(parseState.getComponent())\n343: \t\t\t+ \" -> \"\n344: \t\t\t+ ModelFacade.getName(mClassifier);\n345:                     ModelFacade.setName(perm, newName);\n346:                 }\n347: \t    }\n348: \t    catch (ClassifierNotFoundException e) {\n349: \t\t// Currently if a classifier cannot be found in the\n350:                 // model/classpath then information will be lost from\n351:                 // source files, because the classifier cannot be\n352:                 // created on the fly.\n353:                 LOG.warn(\"Modeller.java: a classifier that was in the source\"\n354: \t\t\t + \" file could not be generated in the model \"\n355: \t\t\t + \"(to generate an imported classifier) - \"\n356: \t\t\t + \"information lost\",\n357: \t\t\t e);\n358: \t    }\n359:             \n360:             \n361: \t}\n362:     }\n363: \n364:     /**        Called from the parser when a class declaration is found.\n365:      * @param name The name of the class.\n366:      * @param modifiers A sequence of class modifiers.\n367:      * @param superclassName Zero or one string with the name of the\n368:      *        superclass. Can be fully qualified or\n369:      *        just a simple class name.\n370:      * @param interfaces Zero or more strings with the names of implemented\n371:      *        interfaces. Can be fully qualified or just a\n372:      *        simple interface name.\n373:      * @param javadoc The javadoc comment. null or \"\" if no comment available.\n374:      */\n375:     public void addClass(String name,\n376:                          short modifiers,\n377:                          String superclassName,\n378:                          Vector interfaces,\n379:                          String javadoc)\n380:     {\n381:         Object mClass =\n382: \t    addClassifier(UmlFactory.getFactory().getCore().createClass(),\n383: \t\t\t  name, modifiers, javadoc);\n384: \n385:         ModelFacade.setAbstract(mClass,\n386: \t\t\t\t(modifiers & JavaRecognizer.ACC_ABSTRACT) > 0);\n387:         ModelFacade.setLeaf(mClass, (modifiers & JavaRecognizer.ACC_FINAL) > 0);\n388:         ModelFacade.setRoot(mClass, false);\n389: \n390:         // only do generalizations and realizations on the 2nd pass.\n391:         Object level = this.getAttribute(\"level\");\n392:         if (level != null) {\n393:             if (level.equals(new Integer(0))) {\n394:                 return;\n395:             }\n396:         }\n397: \n398: \tif (superclassName != null) {\n399: \t    try {\n400: \t\tObject parentClass =\n401: \t\t    getContext(superclassName)\n402: \t\t        .get(getClassifierName(superclassName));\n403: \t\tgetGeneralization(currentPackage, parentClass, mClass);\n404: \t    }\n405: \t    catch (ClassifierNotFoundException e) {\n406: \t\t// Currently if a classifier cannot be found in the\n407: \t\t// model/classpath then information will be lost from\n408: \t\t// source files, because the classifier cannot be\n409: \t\t// created on the fly.\n410: \t\tLOG.warn(\"Modeller.java: a classifier that was in the source\"\n411: \t\t\t + \" file could not be generated in the model \"\n412: \t\t\t + \"(to generate a generalization)- information lost\",\n413:                          e);\n414: \t    }\n415: \t}\n416: \n417: \tif (interfaces != null) {\n418: \t    for (Iterator i = interfaces.iterator(); i.hasNext(); ) {\n419: \t\tString interfaceName = (String) i.next();\n420: \t\ttry {\n421: \t\t    Object mInterface =\n422: \t\t\tgetContext(interfaceName)\n423: \t\t\t    .getInterface(getClassifierName(interfaceName));\n424: \t\t    Object mAbstraction =\n425: \t\t\tgetAbstraction(mInterface, mClass);\n426: \t\t    if (ModelFacade.getSuppliers(mAbstraction).size() == 0) {\n427: \t\t\tModelFacade.addSupplier(mAbstraction, mInterface);\n428: \t\t\tModelFacade.addClient(mAbstraction, mClass);\n429: \t\t    }\n430: \t\t    ModelFacade.setNamespace(mAbstraction, currentPackage);\n431: \t\t    ModelFacade.setStereotype(mAbstraction,\n432: \t\t\t\t\t      getStereotype(\"realize\"));\n433: \t\t}\n434: \t\tcatch (ClassifierNotFoundException e) {\n435: \t\t    // Currently if a classifier cannot be found in the\n436: \t\t    // model/classpath then information will be lost from\n437: \t\t    // source files, because the classifier cannot be\n438: \t\t    // created on the fly.\n439: \t\t    LOG.warn(\"Modeller.java: a classifier that was in \"\n440: \t\t\t     + \"the source file could not be generated \"\n441: \t\t\t     + \"in the model \"\n442: \t\t\t     + \"(to generate a abstraction)- information lost\",\n443: \t\t\t     e);\n444: \t\t}\n445: \t    }\n446: \t}\n447:     }\n448: \n449:     /**\n450:      * Called from the parser when an anonymous inner class is found.\n451:      *\n452:      * @param type The type of this anonymous class.\n453:      */\n454:     public void addAnonymousClass(String type) {\n455:         String name = parseState.anonymousClass();\n456:         try {\n457:             Object mClassifier = getContext(type).get(getClassifierName(type));\n458:             Vector interfaces = new Vector();\n459:             if (ModelFacade.isAInterface(mClassifier)) {\n460:                 interfaces.add(type);\n461:             }\n462:             addClass(name,\n463: \t\t     (short) 0,\n464: \t\t     ModelFacade.isAClass(mClassifier) ? type : null,\n465: \t\t     interfaces,\n466: \t\t     \"\");\n467:         }\n468:         catch (ClassifierNotFoundException e) {\n469:             // Must add it anyway, or the class poping will mismatch.\n470:             addClass(name, (short) 0, null, new Vector(), \"\");\n471:             LOG.warn(\"Modeller.java: an anonymous class was created \"\n472: \t\t     + \"although it could not be found in the classpath.\",\n473: \t\t     e);\n474:         }\n475:     }\n476: \n477:     /**\n478:        Called from the parser when an interface declaration is found.\n479: \n480:        @param name The name of the interface.\n481:        @param modifiers A sequence of interface modifiers.\n482:        @param interfaces Zero or more strings with the names of extended\n483:        interfaces. Can be fully qualified or just a\n484:        simple interface name.\n485:        @param javadoc The javadoc comment. \"\" if no comment available.\n486:     */\n487:     public void addInterface(String name,\n488:                              short modifiers,\n489:                              Vector interfaces,\n490:                              String javadoc)\n491:     {\n492:         Object mInterface =\n493: \t    addClassifier(UmlFactory.getFactory().getCore().createInterface(),\n494: \t\t\t  name,\n495: \t\t\t  modifiers,\n496: \t\t\t  javadoc);\n497:         \n498:         // only do generalizations and realizations on the 2nd pass.\n499:         Object level = this.getAttribute(\"level\");\n500:         if (level != null) {\n501:             if (level.equals(new Integer(0))) {\n502:                 return;\n503:             }\n504:         }\n505:         \n506:         for (Iterator i = interfaces.iterator(); i.hasNext(); ) {\n507:             String interfaceName = (String) i.next();\n508:             try {\n509:                 Object parentInterface =\n510: \t\t    getContext(interfaceName)\n511: \t\t        .getInterface(getClassifierName(interfaceName));\n512:                 getGeneralization(currentPackage, parentInterface, mInterface);\n513:             }\n514:             catch (ClassifierNotFoundException e) {\n515: \t\t// Currently if a classifier cannot be found in the\n516:                 // model/classpath then information will be lost from\n517:                 // source files, because the classifier cannot be\n518:                 // created on the fly.\n519:                 LOG.warn(\"Modeller.java: a classifier that was in the source\"\n520: \t\t\t + \" file could not be generated in the model \"\n521: \t\t\t + \"(to generate a generalization)- information lost\",\n522: \t\t\t e);\n523:             }\n524:         }\n525:     }\n526: \n527:     /**\n528:        Common code used by addClass and addInterface.\n529: \n530:        @param newClassifier Supply one if none is found in the model.\n531:        @param name Name of the classifier.\n532:        @param modifiers String of modifiers.\n533:        @param javadoc The javadoc comment. null or \"\" if no comment available.\n534:        @return The newly created/found classifier.\n535:     */\n536:     private Object addClassifier(Object newClassifier,\n537:                                  String name,\n538:                                  short modifiers,\n539:                                  String javadoc)\n540:     {\n541: \tObject mClassifier;\n542: \tObject mNamespace;\n543: \n544:         // the new classifier is a java inner class\n545: \tif (parseState.getClassifier() != null) {\n546: \t    mClassifier =\n547: \t\tModelFacade.lookupIn(parseState.getClassifier(), name);\n548: \t    mNamespace = parseState.getClassifier();\n549: \t}\n550:         // the new classifier is a top level java class\n551: \telse {\n552: \t    parseState.outerClassifier();\n553: \t    mClassifier = ModelFacade.lookupIn(currentPackage, name);\n554: \t    mNamespace = currentPackage;\n555: \t}\n556:         // if the classifier could not be could in the model\n557: \tif (mClassifier == null) {\n558: \t    mClassifier = newClassifier;\n559: \t    ModelFacade.setName(mClassifier, name);\n560: \t    ModelFacade.setNamespace(mClassifier, mNamespace);\n561: \t}\n562:         // it was found and we delete andy existing tagged values.\n563: \telse {\n564: \t    cleanModelElement(mClassifier);\n565: \t}\n566: \tparseState.innerClassifier(mClassifier);\n567:         \n568:         // set up the component residency (only for top level classes)\n569:         if (parseState.getClassifier() == null) {\n570:             // set the clasifier to be a resident in its component:\n571:             // (before we push a new parse state on the stack)\n572:             Object residentDep = null;\n573:             \n574:             // try find an existing residency\n575:             Iterator dependenciesIt =\n576: \t\tUmlHelper.getHelper().getCore()\n577:                     .getDependencies(mClassifier, parseState.getComponent())\n578: \t\t        .iterator();\n579:             while (dependenciesIt.hasNext()) {\n580:                 \n581:                 Object dependency = dependenciesIt.next();\n582:                 residentDep = dependency;\n583:                 break;\n584:             }\n585:             \n586:             // if no existing residency was found.\n587:             if (residentDep == null) {\n588:                 \n589:                 // this doesn't work because of a bug in NSUML (the\n590:                 // ElementResidence association class is never saved\n591:                 // to the xmi).\n592:                 // //UmlHelper.getHelper().getCore()\n593:                 // .setResident(parseState.getComponent(),mClassifier);\n594:                 \n595:                 // therefore temporarily use a non-standard hack:\n596:                 //if (parseState.getComponent() == null) addComponent();\n597:                 residentDep = CoreFactory.getFactory()\n598: \t\t    .buildDependency(parseState.getComponent(), mClassifier);\n599:                 UmlFactory.getFactory().getExtensionMechanisms()\n600: \t\t    .buildStereotype(\n601: \t\t\t\t     residentDep,\n602: \t\t\t\t     \"resident\",\n603: \t\t\t\t     model);\n604: \t\tString newName =\n605: \t\t    ModelFacade.getName(parseState.getComponent())\n606: \t\t    + \" -(location of)-> \"\n607: \t\t    + ModelFacade.getName(mClassifier);\n608:                 ModelFacade.setName(residentDep, newName);\n609:             }\n610:         }\n611:         \n612:         // change the parse state to a classifier parse state\n613:         parseStateStack.push(parseState);\n614:         parseState = new ParseState(parseState, mClassifier, currentPackage);\n615: \n616: \n617: \tsetVisibility(mClassifier, modifiers);\n618: \n619: \t/*\n620: \t * Changed 2001-10-05 STEFFEN ZSCHALER\n621: \t *\n622: \t * Was (space added below!):\n623: \t *\n624: \t if((javadoc == null) || \"\".equals(javadoc)) {\n625: \t javadoc = \"/** * /\";\n626: \t }\n627: \t getTaggedValue(mClassifier, \"documentation\").setValue(javadoc);\n628: \t *\n629: \t */\n630: \n631: \taddDocumentationTag (mClassifier, javadoc);\n632:   \n633:         \n634: \treturn mClassifier;\n635:     }\n636: \n637:     /**\n638:        Called from the parser when a classifier is completely parsed.\n639:     */\n640:     public void popClassifier()\n641:     {\n642:         // now create diagram if it doesn't exists in project\n643: \tif (importSession.isCreateDiagramsChecked()) {\n644: \t    if (getDiagram() == null) {\n645: \t\tdiagram = new DiagramInterface(Globals.curEditor());\n646: \t\tif (currentPackageName != null\n647: \t\t    && !currentPackageName.trim().equals(\"\"))\n648: \t\t{\n649: \t\t    // create new diagram or select existing diagram for package\n650: \t\t    diagram.createOrSelectClassDiagram(currentPackage,\n651: \t\t\t\t\t\t\tcurrentPackageName);\n652: \t\t} else {\n653: \t\t    // create new diagram in root for classifier without package\n654: \t\t    diagram.createRootClassDiagram();\n655: \t\t}\n656: \t\t\t\t\n657: \t    } else {\n658: \t\tif (currentPackageName != null) {\n659: \t\t    getDiagram().selectClassDiagram(currentPackage,\n660: \t\t\t\t\t\t    currentPackageName);\n661: \t\t}\n662: \t\t// the DiagramInterface is instantiated already\n663: \t\t// but the class is in a source file\n664: \t\t// with no package declaration\n665: \t\telse {\n666: \t\t    // create new diagram in root for classifier without package\n667: \t\t    diagram.createRootClassDiagram();\n668: \t\t}\n669: \t    }\n670: \t}\n671:         // add the current classifier to the diagram.\n672:         Object classifier = parseState.getClassifier();\n673:         if (ModelFacade.isAInterface(classifier)) {\n674:             if (getDiagram() != null && importSession.isCreateDiagramsChecked())\n675: \t\tdiagram.addInterface(classifier,\n676: \t\t\t\t      importSession.isMinimiseFigsChecked());\n677:         } else {\n678:             if (ModelFacade.isAClass(classifier)) {\n679:                 if (getDiagram() != null \n680:                         && importSession.isCreateDiagramsChecked()) {\n681:                     diagram.addClass(classifier,\n682: \t\t\t\t      importSession.isMinimiseFigsChecked());\n683:                 }\n684:             }\n685:         }\n686: \n687:         // Remove operations and attributes not in source\n688:         parseState.removeObsoleteFeatures();\n689: \n690:         // Remove inner classes not in source\n691:         parseState.removeObsoleteInnerClasses();\n692: \n693:         parseState = (ParseState) parseStateStack.pop();\n694:     }\n695: \n696:     /** Called from the parser when an operation is\n697:      * found.\n698:      *\n699:      * @param modifiers A sequence of operation modifiers.\n700:      * @param returnType The return type of the operation.\n701:      * @param name The name of the operation as a string\n702:      * @param parameters A number of vectors, each representing a\n703:      *\n704:      * parameter.\n705:      * @param javadoc The javadoc comment. null or \"\" if no comment available.\n706:      * @return The operation.\n707:      */\n708:     public Object addOperation (short modifiers,\n709:                                 String returnType,\n710:                                 String name,\n711:                                 Vector parameters,\n712:                                 String javadoc) {\n713: \tObject mOperation = getOperation(name);\n714: \tparseState.feature(mOperation);\n715: \n716: \tModelFacade.setAbstract(mOperation,\n717: \t\t\t\t(modifiers & JavaRecognizer.ACC_ABSTRACT) > 0);\n718: \tModelFacade.setLeaf(mOperation,\n719: \t\t\t    (modifiers & JavaRecognizer.ACC_FINAL) > 0);\n720: \tModelFacade.setRoot(mOperation, false);\n721: \tsetOwnerScope(mOperation, modifiers);\n722: \tsetVisibility(mOperation, modifiers);\n723: \tif ((modifiers & JavaRecognizer.ACC_SYNCHRONIZED) > 0) {\n724: \t    ModelFacade.setConcurrency(mOperation, ModelFacade.GUARDED);\n725: \t} else if (ModelFacade.getConcurrency(mOperation)\n726: \t\t   == ModelFacade.GUARDED_CONCURRENCYKIND) {\n727: \t    ModelFacade.setConcurrency(mOperation, ModelFacade.SEQUENTIAL);\n728: \t}\n729: \n730: \tfor (Iterator i = ModelFacade.getParameters(mOperation).iterator();\n731: \t     i.hasNext(); )\n732: \t{\n733: \t    ModelFacade.removeParameter(mOperation, i.next());\n734: \t}\n735: \n736: \tObject mParameter;\n737: \tString typeName;\n738: \tObject mClassifier;\n739: \n740: \tif (returnType == null) {\n741: \t    // Constructor\n742: \t    ModelFacade.setStereotype(mOperation, \n743:                 getStereotype(mOperation, \"create\", \"BehavioralFeature\" ));\n744: \t}\n745: \telse {\n746: \t    try {\n747: \t\tmClassifier =\n748: \t\t    getContext(returnType).get(getClassifierName(returnType));\n749:                 \n750: \t\tmParameter =\n751: \t\t    UmlFactory.getFactory().getCore()\n752: \t\t        .buildParameter(mOperation);\n753: \t\tModelFacade.setName(mParameter, \"return\");\n754: \t\tModelFacade.setKindToReturn(mParameter);\n755: \n756:                 ModelFacade.setType(mParameter, mClassifier);\n757: \t    }\n758: \t    catch (ClassifierNotFoundException e) {\n759: \t\t// Currently if a classifier cannot be found in the\n760:                 // model/classpath then information will be lost from\n761:                 // source files, because the classifier cannot be\n762:                 // created on the fly.\n763:                 LOG.warn(\"Modeller.java: a classifier that was in the source \"\n764: \t\t\t + \"file could not be generated in the model \"\n765: \t\t\t + \"(for generating operation return type) - \"\n766: \t\t\t + \"information lost\",\n767: \t\t\t e);\n768: \t    }\n769: \t}\n770: \n771: \tfor (Iterator i = parameters.iterator(); i.hasNext(); ) {\n772: \t    Vector parameter = (Vector) i.next();\n773: \t    typeName = (String) parameter.elementAt(1);\n774: \t    try {\n775:                 mClassifier =\n776: \t\t    getContext(typeName).get(getClassifierName(typeName));\n777:                 mParameter =\n778: \t\t    UmlFactory.getFactory().getCore()\n779: \t\t        .buildParameter(mOperation);\n780: \t\tModelFacade.setName(mParameter,\n781: \t\t\t\t    (String) parameter.elementAt(2));\n782: \t\tModelFacade.setKindToIn(mParameter);\n783:                 if (ModelFacade.isAClassifier(mClassifier)) {\n784:                     ModelFacade.setType(mParameter, mClassifier);\n785:                 }\n786:                 else {\n787:                     // the type resolution failed to find a valid classifier.\n788:                     LOG.warn(\"Modeller.java: a valid type for a parameter \"\n789: \t\t\t     + \"could not be resolved:\\n \"\n790: \t\t\t     + \"In file: \" + fileName + \", for operation: \"\n791: \t\t\t     + ModelFacade.getName(mOperation)\n792: \t\t\t     + \", for parameter: \"\n793: \t\t\t     + ModelFacade.getName(mParameter));\n794:                 }\n795: \t    }\n796: \t    catch (ClassifierNotFoundException e) {\n797: \t\t// Currently if a classifier cannot be found in the\n798:                 // model/classpath then information will be lost from\n799:                 // source files, because the classifier cannot be\n800:                 // created on the fly.\n801:                 LOG.warn(\"Modeller.java: a classifier that was in the source \"\n802: \t\t\t + \"file could not be generated in the model \"\n803: \t\t\t + \"(for generating operation params) - \"\n804: \t\t\t + \"information lost\",\n805: \t\t\t e);\n806: \t    }\n807: \t}\n808: \n809: \n810: \t/*\n811: \t * Changed 2001-10-05 STEFFEN ZSCHALER.\n812: \t *\n813: \t * Was (space added below!):\n814: \t *\n815: \t if((javadoc == null) || \"\".equals(javadoc)) {\n816: \t javadoc = \"/** * /\";\n817: \t }\n818: \t getTaggedValue(mOperation, \"documentation\").setValue(javadoc);\n819: \t *\n820: \t * Moved to end of method 2001-11-05 to allow addDocumentationTag to\n821: \t * access as much information as possible\n822: \t */\n823: \n824: \taddDocumentationTag (mOperation, javadoc);\n825: \n826: \treturn mOperation;\n827:     }\n828: \n829:     /**\n830:      * Called from the parser to add a method body to an operation.\n831:      * (An operation will have exactly one Java body.)\n832:      *\n833:      * @param op An operation.\n834:      * @param body A method body.\n835:      */\n836:     public void addBodyToOperation(Object op, String body)\n837:     {\n838:         if (op == null || !ModelFacade.isAOperation(op)) {\n839: //            LOG.warn(\"adding body failed: no operation!\");\n840:             return;\n841:         }\n842:         if (body == null || body.length() == 0)\n843:             return;\n844: \n845:         Object method = getMethod(ModelFacade.getName(op));\n846:         parseState.feature(method);\n847:         ModelFacade.setBody(method,\n848: \t\t\t    UmlFactory.getFactory().getDataTypes()\n849: \t\t\t    .createProcedureExpression(\"Java\",\n850: \t\t\t\t\t\t       body));\n851: \t// Add the method to it's specification.\n852:         ModelFacade.addMethod(op, method);\n853: \n854:         // Add this method as a feature to the classifier that owns\n855:         // the operation.\n856:         ModelFacade.addFeature(ModelFacade.getOwner(op), method);\n857:     }\n858: \n859:     /**        Called from the parser when an attribute is found.\n860:      * @param modifiers A sequence of attribute modifiers.\n861:      * @param typeSpec The attribute's type.\n862:      * @param name The name of the attribute.\n863:      * @param initializer The initial value of the attribute.\n864:      * @param javadoc The javadoc comment. null or \"\" if no comment available.\n865:      */\n866:     public void addAttribute (short modifiers,\n867:                               String typeSpec,\n868:                               String name,\n869:                               String initializer,\n870:                               String javadoc) {\n871: \tString multiplicity = null;\n872: \n873: \tif (!arraysAsDatatype && typeSpec.indexOf('[') != -1) {\n874: \t    typeSpec = typeSpec.substring(0, typeSpec.indexOf('['));\n875: \t    multiplicity = \"1_N\";\n876: \t} else\n877: \t    multiplicity = \"1_1\";\n878:       \n879: \t// the attribute type\n880: \tObject mClassifier = null;\n881: \ttry {\n882: \t    // get the attribute type\n883: \t    mClassifier = getContext(typeSpec).get(getClassifierName(typeSpec));\n884: \t} catch (ClassifierNotFoundException e) {\n885: \t    // Currently if a classifier cannot be found in the\n886: \t    // model/classpath then information will be lost from\n887: \t    // source files, because the classifier cannot be\n888: \t    // created on the fly.\n889: \t    LOG.warn(\"Modeller.java: a classifier that was in the source \"\n890: \t\t     + \"file could not be generated in the model \"\n891: \t\t     + \"(for generating an attribute)- information lost\",\n892: \t\t     e);\n893:                 \n894: \t    // if we can't find the attribute type then\n895: \t    // we can't add the attribute.\n896: \t    return;\n897: \t}\n898:           \n899: \t// if we want to create a UML attribute:\n900: \tif (noAssociations\n901: \t    || ModelFacade.isADataType(mClassifier)\n902: \t    || (ModelFacade.getNamespace(mClassifier)\n903: \t\t== getPackage(\"java.lang\"))) {\n904:       \n905:             Object mAttribute = getAttribute(name, initializer, mClassifier);\n906: \n907:             parseState.feature(mAttribute);\n908: \n909:             setOwnerScope(mAttribute, modifiers);\n910:             setVisibility(mAttribute, modifiers);\n911:             ModelFacade.setMultiplicity(mAttribute, multiplicity);\n912:             \n913:             if (ModelFacade.isAClassifier(mClassifier)) {\n914:                 ModelFacade.setType(mAttribute, mClassifier);\n915:             }\n916:             else {\n917:                 // the type resolution failed to find a valid classifier.\n918:                 LOG.warn(\"Modeller.java: a valid type for a parameter \"\n919: \t\t\t + \"could not be resolved:\\n \"\n920: \t\t\t + \"In file: \" + fileName + \", for attribute: \"\n921: \t\t\t + ModelFacade.getName(mAttribute));\n922:             }\n923: \n924:             // Set the initial value for the attribute.\n925:             if (initializer != null) {\n926:                 \n927:                 // we must remove line endings and tabs from the intializer\n928:                 // strings, otherwise the classes will display horribly.\n929:                 int index = 0;\n930: \t\tindex = initializer.indexOf(\"\\n\");\n931:                 while (index != -1) {\n932:                     initializer =\n933: \t\t\tinitializer.substring(0, index)\n934: \t\t\t+ initializer.substring(index + 2,\n935: \t\t\t\t\t\tinitializer.length());\n936:                     index = initializer.indexOf(\"\\n\");\n937:                 }\n938:                 \n939: \t\tindex = initializer.indexOf(\"\\t\");\n940:                 while (index != -1) {\n941:                     initializer =\n942: \t\t\tinitializer.substring(0, index)\n943: \t\t\t+ initializer.substring(index + 2,\n944: \t\t\t\t\t\tinitializer.length());\n945:                     index = initializer.indexOf(\"\\t\");\n946:                 }\n947:                 \n948: \t\tObject newInitialValue = \n949: \t\t    UmlFactory.getFactory().getDataTypes()\n950: \t\t        .createExpression(\"Java\",\n951: \t\t\t\t\t  initializer);\n952:                 ModelFacade.setInitialValue(mAttribute, newInitialValue);\n953:             }\n954: \n955:             if ((modifiers & JavaRecognizer.ACC_FINAL) > 0) {\n956:                 ModelFacade.setChangeable(mAttribute, false);\n957:             }\n958:             else if (!ModelFacade.isChangeable(mAttribute)) {\n959:                 ModelFacade.setChangeable(mAttribute, true);\n960:             }\n961:             addDocumentationTag(mAttribute, javadoc);\n962:         }\n963:         // we want to create a UML association from the java attribute\n964:         else {\n965:             \n966:             Object mAssociationEnd = getAssociationEnd(name, mClassifier);\n967:             setTargetScope(mAssociationEnd, modifiers);\n968:             setVisibility(mAssociationEnd, modifiers);\n969:             ModelFacade.setMultiplicity(mAssociationEnd, multiplicity);\n970:             ModelFacade.setType(mAssociationEnd, mClassifier);\n971:             ModelFacade.setName(mAssociationEnd, name);\n972:             if ((modifiers & JavaRecognizer.ACC_FINAL) > 0) {\n973:                 ModelFacade.setChangeable(mAssociationEnd, false);\n974:             }\n975:             ModelFacade.setNavigable(mAssociationEnd, true);\n976:             addDocumentationTag(mAssociationEnd, javadoc);\n977: \t}\n978:     }\n979: \n980:     /**\n981:        Find a generalization in the model. If it does not exist, a\n982:        new generalization is created.\n983: \n984:        @param mPackage Look in this package.\n985:        @param parent The superclass.\n986:        @param child The subclass.\n987:        @return The generalization found or created.\n988:     */\n989:     private Object getGeneralization(Object mPackage,\n990:                                      Object parent,\n991:                                      Object child)\n992:     {\n993:         String name =\n994: \t    ModelFacade.getName(child) + \" -> \" + ModelFacade.getName(parent);\n995:         Object mGeneralization = null;\n996:         mGeneralization = ModelFacade.getGeneralization(child, parent);\n997:         if (mGeneralization == null) {\n998:             mGeneralization =\n999: \t\tCoreFactory.getFactory().buildGeneralization(child, parent,\n1000: \t\t\t\t\t\t\t     name);\n1001:         }\n1002:         if (mGeneralization != null) {\n1003:             ModelFacade.setNamespace(mGeneralization, mPackage);\n1004:         }\n1005:         return mGeneralization;\n1006:     }\n1007: \n1008:     /**\n1009:      * Find an abstraction<<realize>> in the model. If it does not\n1010:      * exist, a new abstraction is created.\n1011:      *\n1012:      * @param parent The superclass.\n1013:      * @param child The subclass.\n1014:      * @return The abstraction found or created.\n1015:      */\n1016:     private Object getAbstraction(Object parent,\n1017:                                   Object child) {\n1018:         String name =\n1019: \t    ModelFacade.getName(child) + \" -> \" + ModelFacade.getName(parent);\n1020:         Object mAbstraction = null;\n1021:         for (Iterator i = ModelFacade.getClientDependencies(child).iterator();\n1022: \t     i.hasNext(); )\n1023: \t{\n1024:             mAbstraction = i.next();\n1025:             Collection c = ModelFacade.getSuppliers(mAbstraction);\n1026:             if (c == null || c.size() == 0) {\n1027:                 ModelFacade.removeClientDependency(child, mAbstraction);\n1028:             }\n1029:             else {\n1030:                 if (parent != c.toArray()[0]) {\n1031:                     mAbstraction = null;\n1032:                 }\n1033:                 else {\n1034:                     break;\n1035:                 }\n1036:             }\n1037:         }\n1038: \n1039:         if (mAbstraction == null) {\n1040:             mAbstraction =\n1041: \t\tUmlFactory.getFactory().getCore().buildAbstraction(name);\n1042:         }\n1043:         return mAbstraction;\n1044:     }\n1045: \n1046:     /**\n1047:        Find a package in the model. If it does not exist, a new\n1048:        package is created.\n1049: \n1050:        @param name The name of the package.\n1051:        @return The package found or created.\n1052:     */\n1053:     private Object getPackage(String name)\n1054:     {\n1055: \tObject mPackage = searchPackageInModel(name);\n1056: \tif (mPackage == null) {\n1057: \t    mPackage =\n1058: \t\tUmlFactory.getFactory().getModelManagement()\n1059: \t\t    .buildPackage(getRelativePackageName(name), name);\n1060: \t    ModelFacade.setNamespace(mPackage, model);\n1061: \n1062: \t    // Find the owner for this package.\n1063: \t    if (\"\".equals(getPackageName(name))) {\n1064: \t\tModelFacade.addOwnedElement(model, mPackage);\n1065: \t    }\n1066: \t    else {\n1067: \t\tModelFacade.addOwnedElement(getPackage(getPackageName(name)),\n1068: \t\t\t\t\t    mPackage);\n1069: \t    }\n1070: \t}\n1071: \treturn mPackage;\n1072:     }\n1073: \n1074:     /**\n1075:      * Search recursivly for nested packages in the model. So if you\n1076:      * pass a package org.argouml.kernel , this method searches for a package\n1077:      * kernel, that is owned by a package argouml, which is owned by a\n1078:      * package org. This method is required to nest the parsed packages.\n1079:      *\n1080:      * @param name The fully qualified package name of the package we\n1081:      * are searching for.\n1082:      * @return The found package or null, if it is not in the model.\n1083:      */\n1084:     private Object searchPackageInModel(String name) {\n1085: \tif (\"\".equals(getPackageName(name))) {\n1086: \t    return ModelFacade.lookupIn(model, name);\n1087: \t} else {\n1088: \t    Object owner = searchPackageInModel(getPackageName(name));\n1089: \t    return owner == null\n1090: \t\t? null\n1091: \t\t: ModelFacade.lookupIn(owner, getRelativePackageName(name));\n1092: \t}\n1093:     }\n1094: \n1095:     /**\n1096:        Find an operation in the currentClassifier. If the operation is\n1097:        not found, a new is created.\n1098: \n1099:        @param name The name of the operation.\n1100:        @return The operation found or created.\n1101:     */\n1102:     private Object getOperation(String name)\n1103:     {\n1104:         Object mOperation = parseState.getOperation(name);\n1105:         if (mOperation == null) {\n1106:             mOperation =\n1107: \t\tUmlFactory.getFactory().getCore()\n1108: \t\t    .buildOperation(parseState.getClassifier(), name);\n1109: //            Iterator it2 =\n1110: //\t\t  ProjectManager.getManager().getCurrentProject()\n1111: //                .findFigsForMember(parseState.getClassifier()).iterator();\n1112: //            while (it2.hasNext()) {\n1113: //                Object listener = it2.next();\n1114: //                // UmlModelEventPump.getPump()\n1115: //                //     .removeModelEventListener(listener,\n1116: //                // mOperation);\n1117: //                UmlModelEventPump.getPump().addModelEventListener(listener,\n1118: //\t\t\t\t\t\t\t\t  mOperation);\n1119: //                // UmlModelEventPump.getPump()\n1120: //                //     .removeModelEventListener(listener,\n1121: //                // mOperation.getParameter(0));\n1122: //                UmlModelEventPump.getPump()\n1123: //\t\t    .addModelEventListener(listener,\n1124: //\t\t\t\t\t   ModelFacade.getParameter(mOperation,\n1125: //\t\t\t\t\t\t\t\t    0));\n1126: //            }\n1127:         }\n1128:         return mOperation;\n1129:     }\n1130: \n1131:     /**\n1132:        Find an operation in the currentClassifier. If the operation is\n1133:        not found, a new is created.\n1134: \n1135:        @param name The name of the method.\n1136:        @return The method found or created.\n1137:     */\n1138:     private Object getMethod(String name)\n1139:     {\n1140:         Object mMethod = parseState.getMethod(name);\n1141:         if (mMethod == null) {\n1142:             mMethod = UmlFactory.getFactory().getCore().buildMethod(name);\n1143:             ModelFacade.addFeature(parseState.getClassifier(), mMethod);\n1144:         }\n1145:         return mMethod;\n1146:     }\n1147: \n1148:     /**\n1149:        Find an attribute in the currentClassifier. If the attribute is\n1150:        not found, a new is created.\n1151: \n1152:        @param name The name of the attribute.\n1153:        @param initializer The initializer code.\n1154:        @param mClassifier The type, used when checking for existing\n1155:        association.\n1156:        @return The attribute found or created.\n1157:     */\n1158:     private Object getAttribute(String name,\n1159:                                 String initializer,\n1160:                                 Object mClassifier)\n1161:     {\n1162:     \tCollection list = parseState.getFeatures(name);\n1163:         Object mAttribute = null;\n1164: \tfor (Iterator it = list.iterator(); it.hasNext();) {\n1165: \t    Object o = it.next();\n1166: \t    if (ModelFacade.isAAttribute(o)) {\n1167: \t\tmAttribute = o;\n1168: \t\tbreak;\n1169: \t    }\n1170: \t}\n1171:         if (mAttribute == null) {\n1172:             mAttribute = UmlFactory.getFactory().getCore().buildAttribute(name);\n1173:             ModelFacade.addFeature(parseState.getClassifier(), mAttribute);\n1174:         }\n1175:         return mAttribute;\n1176:     }\n1177: \n1178:     /**\n1179:        Find an associationEnd from the currentClassifier to the type\n1180:        specified. If not found, a new is created.\n1181: \n1182:        @param name The name of the attribute.\n1183:        @param mClassifier Where the association ends.\n1184:        @return The attribute found or created.\n1185:     */\n1186:     private Object getAssociationEnd(String name,\n1187:                                      Object mClassifier)\n1188:     {\n1189:         Object mAssociationEnd = null;\n1190:         for (Iterator i =\n1191: \t\t ModelFacade.getAssociationEnds(mClassifier).iterator();\n1192: \t     i.hasNext(); ) {\n1193:             Object ae = i.next();\n1194:             if (name.equals(ModelFacade.getName(ae))) {\n1195:                 mAssociationEnd = ae;\n1196:             }\n1197:         }\n1198:         if (mAssociationEnd == null && !noAssociations) {\n1199: \t    String newName =\n1200: \t\tModelFacade.getName(parseState.getClassifier())\n1201: \t\t+ \" -> \"\n1202: \t\t+ ModelFacade.getName(mClassifier);\n1203: \n1204:             Object mAssociation = CoreFactory.getFactory()\n1205: \t\t.buildAssociation(mClassifier,\n1206: \t\t\t\t  true,\n1207: \t\t\t\t  parseState.getClassifier(),\n1208: \t\t\t\t  false,\n1209: \t\t\t\t  newName);\n1210:             mAssociationEnd =\n1211: \t\tModelFacade.getAssociationEnd(mClassifier, mAssociation);\n1212:         }\n1213:         return mAssociationEnd;\n1214:     }\n1215: \n1216:     /**\n1217:        Get the stereotype with a specific name.\n1218: \n1219:        @param name The name of the stereotype.\n1220:        @return The stereotype.\n1221:     */\n1222:     private Object getStereotype(String name)\n1223:     {\n1224: \tObject mStereotype = ModelFacade.lookupIn(model, name);\n1225: \n1226: \tif (mStereotype == null || !ModelFacade.isAStereotype(mStereotype)) {\n1227: \t    mStereotype =\n1228: \t\tUmlFactory.getFactory().getExtensionMechanisms()\n1229: \t\t    .buildStereotype(name, model);\n1230: \t}\n1231: \n1232: \treturn mStereotype;\n1233:     }\n1234:     \n1235:     /**\n1236:      * Find the first suitable stereotype with baseclass for a given object.\n1237:      *\n1238:      * @param me\n1239:      * @param name\n1240:      * @param baseClass\n1241:      * @return the stereotype if found\n1242:      *\n1243:      * @throws IllegalArgumentException if the desired stereotypes for\n1244:      * the modelelement and baseclass was not found. No stereotype is\n1245:      * created.\n1246:      */\n1247:     private Object getStereotype(Object me, String name, String baseClass) {\n1248:         Collection stereos =\n12