rator();\n208:             int size = figs.size();\n209: \t    for (int i = 0; i < size; i++) {\n210:                 Fig fig = (Fig) it.next();\n211: \n212:                 if (i == 0) {\n213:                     first = fig;\n214:                 }\n215:                 if (i == size - 1) {\n216:                     last = fig;\n217:                 }\n218: \n219: \t\tif (fig.getWidth() > _w) {\n220: \t\t    _w = fig.getWidth();\n221: \t\t}\n222: \t    }\n223:             _h = last.getY() + last.getHeight() - first.getY();\n224: \t} else {\n225: \t    _w = 0;\n226: \t    _h = 0;\n227: \t}\n228:     }\n229: \n230: \n231: \n232:     /**\n233:      * @see org.tigris.gef.presentation.FigGroup#addFig(Fig)\n234:      */\n235:     public void addFig(Fig f) {\n236: \tsuper.addFig(f);\n237: \tupdateFigPositions();\n238: \tcalcBounds();\n239:     }\n240: \n241: \n242:     /**\n243:      * @see org.tigris.gef.presentation.Fig#removeFromDiagramImpl()\n244:      */\n245:     public void removeFromDiagram() {\n246:         Collection figs = getFigs();\n247:         if (figs != null) {\n248:             Iterator it = figs.iterator();\n249:             while (it.hasNext()) {\n250:                 Fig fig = (Fig) it.next();\n251:                 fig.removeFromDiagram();\n252:             }\n253:         }\n254:         removeAll();\n255:         super.removeFromDiagram();\n256:     }\n257: \n258: \n259:     /**\n260:      * @see org.tigris.gef.presentation.Fig#deleteFromModel()\n261:      */\n262:     public void deleteFromModel() {\n263:     \tCollection figs = getFigs();\n264:         if (figs != null) {\n265: \t    Iterator it = figs.iterator();\n266: \t    while (it.hasNext()) {\n267: \t\tFig fig = (Fig) it.next();\n268: \t\tfig.deleteFromModel();\n269: \t    }\n270:         }\n271:         removeAll();\n272:         super.deleteFromModel();\n273:     }\n274: \n275: }\n276: \n277: ",
