ss to copy.\n600:      * @param ns is the namespace to put the copy in.\n601:      * @return a newly created class.\n602:      */\n603:     Object copyClass(Object source, Object ns);\n604: \n605:     /**\n606:      * Copies a datatype, and it's features. This may also require other\n607:      * classifiers to be copied.\n608:      *\n609:      * @param source is the datatype to copy.\n610:      * @param ns is the namespace to put the copy in.\n611:      * @return a newly created data type.\n612:      */\n613:     Object copyDataType(Object source, Object ns);\n614: \n615:     /**\n616:      * Copies an interface, and it's features. This may also require other\n617:      * classifiers to be copied.\n618:      *\n619:      * @param source is the interface to copy.\n620:      * @param ns is the namespace to put the copy in.\n621:      * @return a newly created interface.\n622:      */\n623:     Object copyInterface(Object source, Object ns);\n624: \n625:     /**\n626:      * Additional support for generalization.\n627:      *\n628:      * @return A generalization.\n629:      */\n630:     Object createGeneralization();\n631: \n632: }\n633: ",
