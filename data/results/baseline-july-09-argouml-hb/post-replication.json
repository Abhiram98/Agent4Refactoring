zed(name, qualifiers, true);\n259:     }\n260: \n261:     /**\n262:      * @see tudresden.ocl.check.types.Type#navigateParameterized(\n263:      *         java.lang.String, tudresden.ocl.check.types.Type[])\n264:      */\n265:     public Type navigateParameterized (String name, Type[] qualifiers)\n266: \tthrows OclTypeException {\n267: \treturn internalNavigateParameterized(name, qualifiers, false);\n268:     }\n269: \n270:     public Type internalNavigateParameterized(final String name,\n271:                                               final Type[] params,\n272:                                               boolean fCheckIsQuery)\n273: \tthrows OclTypeException {\n274: \tif (classifier == null) {\n275: \t    throw new OclTypeException(\"attempting to access features of Void\");\n276: \t}\n277: \n278: \tType type = Basic.navigateAnyParameterized(name, params);\n279: \tif (type != null) {\n280: \t    return type;\n281: \t}\n282: \n283: \tObject foundOp = null; //MOperation\n284: \tjava.util.Collection operations = ModelFacade.getOperations(classifier);\n285: \tIterator iter = operations.iterator();\n286: \twhile (iter.hasNext() && foundOp == null) {\n287: \t    Object op = iter.next();\n288: \t    if (operationMatchesCall(op, name, params)) {\n289: \t\tfoundOp = op;\n290: \t    }\n291: \t}\n292: \n293: \tif (foundOp == null) {\n294: \t    throw new OclTypeException(\"operation \" + name \n295: \t\t\t\t       + \" not found in classifier \"\n296: \t\t\t\t       + toString()); \n297: \t}\n298: \n299: \tif (fCheckIsQuery) {\n300: \t    /* Query checking added 05/21/01, sz9 */\n301: \t    if (!ModelFacade.isQuery(foundOp)) {\n302: \t\tthrow new OclTypeException(\"Non-query operations cannot \"\n303: \t\t\t\t\t   + \"be used in OCL expressions. (\"\n304: \t\t\t\t\t   + name + \")\");\n305: \t    }\n306: \t}\n307: \n308: \tObject rp =\n309: \t    org.argouml.model.uml.UmlHelperImpl.getHelper().getCore().getReturnParameter(foundOp);\n310: \n311: \tif (rp == null || ModelF