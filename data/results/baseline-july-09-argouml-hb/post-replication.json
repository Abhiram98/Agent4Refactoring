1:         } catch (NoSuchElementException nsee) {\n2302:             throw new ParseException(\"Unexpected end of attribute\", s.length());\n2303:         } catch (ParseException pre) {\n2304:             LOG.error(\"parseexception\", pre);\n2305: \n2306:             throw pre;\n2307:         }\n2308: \n2309:         if (base != null) {\n2310:             if (bases == null)\n2311:                 bases = new Vector();\n2312:             bases.add(base);\n2313:         }\n2314: \n2315:         // TODO: What to do about object name???\n2316:         //    if (name != null)\n2317:         //\t;\n2318: \n2319:         if (role != null)\n2320:             ModelFacade.setName(cls, role.trim());\n2321: \n2322:         if (bases != null) {\n2323:             // Remove bases that aren't there anymore\n2324:             Collection b = ModelFacade.getBases(cls);\n2325:             Iterator it = b.iterator();\n2326:             Object c;\n2327:             Object ns = ModelFacade.getNamespace(cls);\n2328:             if (ns != null && ModelFacade.getNamespace(ns) != null)\n2329:                 ns = ModelFacade.getNamespace(ns);\n2330:             else\n2331:                 ns = ModelFacade.getModel(cls);\n2332: \n2333:             while (it.hasNext()) {\n2334:                 c = it.next();\n2335:                 if (!bases.contains(ModelFacade.getName(c)))\n2336:                     ModelFacade.removeBase(cls, c);\n2337:             }\n2338: \n2339:             it = bases.iterator();\n2340:         addBases: \n2341:             while (it.hasNext()) {\n2342:                 String d = ((String) it.next()).trim();\n2343: \n2344:                 Iterator it2 = b.iterator();\n2345:                 while (it2.hasNext()) {\n2346:                     c = it2.next();\n2347:                     if (d.equals(ModelFacade.getName(c)))\n2348:                         continue addBases;\n2349:                 }\n2350:                 c = getType(d, ns);\n2351:                 if (ModelFacade.isACollaboration(ModelFacade.getNamespace(c)))\n2352:                     ModelFacade.setNamespace(c, ns);\n2353:                 ModelFacade.addBase(cls, c);\n2354:             }\n2355:         }\n2356:     }\n2357: \n2358:     /**\n2359:      * Parse a Message textual description.<p>\n2360:      * \n2361:      * TODO: - This method is too complex, lets break it up. Parses a message\n2362:      * line on the form:\n2363:      * \n2364:      * <br>\n2365:      * intno := integer|name <br>\n2366:      * seq := intno ['.' intno]* <br>\n2367:      * recurrance := '*'['//'] | '*'['//']'[' <i>iteration </i>']' | '['\n2368:      * <i>condition </i>']' <br>\n2369:      * seqelem := {[intno] ['['recurrance']']} <br>\n2370:      * seq2 := seqelem ['.' seqelem]* <br>\n2371:      * ret_list := lvalue [',' lvalue]* <br>\n2372:      * arg_list := rvalue [',' rvalue]* <br>\n2373:      * message := [seq [',' seq]* '/'] seq2 ':' [ret_list :=] name ([arg_list])\n2374:      * \n2375:      * <p>\n2376:      * Which is rather complex, so a few examples: <br>\n2377:      * 2: display(x, y)<br>\n2378:      * 1.3.1: p := find(specs) <br>\n2379:      * [x < 0] 4: invert(color) <br>\n2380:      * A3, B4/ C3.1*: update()\n2381:      * \n2382:      * <p>\n2383:      * This syntax is compatible with the UML 1.3 specification.\n2384:      * \n2385:      * <p>\n2386:      * Actually, only a subset of this syntax is currently supported, and some\n2387:      * is not even planned to be supported. The exceptions are intno, which\n2388:      * allows a number possibly followed by a sequence of letters in the range\n2389:      * 'a' - 'z', seqelem, which does not allow a recurrance, and message, which\n2390:      * does allow one recurrance near seq2. (formerly: name: action )\n2391:      * \n2392:      * @param mes the MMessage to apply any changes to\n2393:      * @param s   the String to parse\n2394:      * @throws ParseException\n2395:      *            when it detects an error in the attribute string. See also\n2396:      *            ParseError.getErrorOffset().\n2397:      */\n2398:     public void parseMessage(Object mes, String s) throws ParseException {\n2399:         String fname = null;\n2400:         String guard = null;\n2401:         String paramExpr = null;\n2402:         String token;\n2403:         String varname = null;\n2404:         Vector predecessors = new Vector();\n2405:         Vector seqno = null;\n2406:         Vector currentseq = new Vector();\n2407:         Vector args = null;\n2408:         boolean mustBePre = false;\n2409:         boolean mustBeSeq = false;\n2410:         boolean parallell = false;\n2411:         boolean iterative = false;\n2412:         boolean mayDeleteExpr = false;\n2413:         boolean refindOperation = false;\n2414:         boolean hasPredecessors = false;\n2415:         int i;\n2416: \n2417:         currentseq.add(null);\n2418:         currentseq.add(null);\n2419: \n2420:         try {\n2421:             MyTokenizer st = new MyTokenizer(s, \" ,\\t,*,[,],.,:,=,/,\\\\,\",\n2422:                     MyTokenizer.PAREN_EXPR_STRING_SEPARATOR);\n2423: \n2424:             while (st.hasMoreTokens()) {\n2425:                 token = st.nextToken();\n2426: \n2427:                 if (\" \".equals(token) || \"\\t\".equals(token)) {\n2428:                     if (currentseq == null) {\n2429:                         if (varname != null && fname == null) {\n2430:                             varname += token;\n2431:                         }\n2432:                     }\n2433:                 } else if (\"[\".equals(token)) {\n2434:                     if (mustBePre)\n2435:                         throw new ParseException(\"Predecessors cannot be \"\n2436:                                 + \"qualified\", st.getTokenIndex());\n2437:                     mustBeSeq = true;\n2438: \n2439:                     if (guard != null)\n2440:                         throw new ParseException(\"Messages cannot have several\"\n2441:  