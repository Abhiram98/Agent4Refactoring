                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/application/helpers/ResourceLoaderWrapper.java: \n1: // $Id$\n2: // Copyright (c) 1996-2005 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies. This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason. IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.application.helpers;\n26: \n27: import java.util.HashMap;\n28: import java.util.Hashtable;\n29: import java.util.Map;\n30: \n31: import javax.swing.Icon;\n32: import javax.swing.ImageIcon;\n33: import javax.swing.UIManager;\n34: \n35: import org.apache.log4j.Logger;\n36: import org.argouml.i18n.Translator;\n37: import org.argouml.model.DataTypesHelper;\n38: import org.argouml.model.Model;\n39: import org.argouml.uml.util.namespace.StringNamespace;\n40: import org.tigris.gef.util.ResourceLoader;\n41: \n42: /**\n43:  * Wrapper around org.tigris.gef.util.ResourceLoader.<p>\n44:  *\n45:  * Necessary since ArgoUML needs some extra init.\n46:  *\n47:  * @since Nov 24, 2002\n48:  * @author jaap.branderhorst@xs4all.nl @stereotype singleton\n49:  */\n50: public final class ResourceLoaderWrapper {\n51: \n52:     /**\n53:      * Logger.\n54:      */\n55:     private static final Logger LOG =\n56:         Logger.getLogger(ResourceLoaderWrapper.class);\n57: \n58:     private static ImageIcon initialStateIcon;\n59:     private static ImageIcon deepIcon;\n60:     private static ImageIcon shallowIcon;\n61:     private static ImageIcon forkIcon;\n62:     private static ImageIcon joinIcon;\n63:     private static ImageIcon branchIcon;\n64:     private static ImageIcon junctionIcon;\n65:     private static ImageIcon realizeIcon;\n66:     private static ImageIcon signalIcon;\n67:     private static ImageIcon commentIcon;\n68: \n69:     private Hashtable iconCache = new Hashtable();\n70: \n71:     /**\n72:      * Singleton implementation.\n73:      */\n74:     private static ResourceLoaderWrapper instance = new ResourceLoaderWrapper();\n75: \n76: \n77:     /**\n78:      * Returns the singleton instance.\n79:      *\n80:      * @return ResourceLoaderWrapper\n81:      */\n82:     public static ResourceLoaderWrapper getInstance() {\n83:         return instance;\n84:     }\n85: \n86:     /**\n87:      * Constructor for ResourceLoaderWrapper.\n88:      */\n89:     private ResourceLoaderWrapper() {\n90:         initResourceLoader();\n91:     }\n92: \n93:     /**\n94:      * Calculate the path to a look and feel object.\n95:      *\n96:      * @param classname\n97:      *            The look and feel classname\n98:      * @param element\n99:      *            The en part of the path.\n100:      * @return the complete path.\n101:      */\n102:     private static String lookAndFeelPath(String classname, String element) {\n103:         return \"/org/argouml/Images/plaf/\"\n104:             + classname.replace('.', '/')\n105:             + \"/toolbarButtonGraphics/\"\n106:             + element;\n107:     }\n108: \n109:     /**\n110:      * Initializes the resourceloader.\n111:      *\n112:      * LookupIconResource checks if there are locations and extensions known.\n113:      * If there are none, this method is called to initialize the resource\n114:      * loader. Originally, this method was placed within Main but this coupled\n115:      * Main and the resourceLoader too much.\n116:      */\n117:     private static void initResourceLoader() {\n118: \tString lookAndFeelClassName;\n119: \tif (\"true\".equals(System.getProperty(\"force.nativelaf\", \"false\"))) {\n120: \t    lookAndFeelClassName = UIManager.getSystemLookAndFeelClassName();\n121: \t} else {\n122: \t    lookAndFeelClassName = \"javax.swing.plaf.metal.MetalLookAndFeel\";\n123: \t}\n124: \tString lookAndFeelGeneralImagePath =\n125: \t    lookAndFeelPath(lookAndFeelClassName, \"general\");\n126: \tString lookAndFeelNavigationImagePath =\n127: \t    lookAndFeelPath(lookAndFeelClassName, \"navigation\");\n128: \tString lookAndFeelDiagramImagePath =\n129: \t    lookAndFeelPath(lookAndFeelClassName, \"argouml/diagrams\");\n130: \tString lookAndFeelElementImagePath =\n131: \t    lookAndFeelPath(lookAndFeelClassName, \"argouml/elements\");\n132: \tString lookAndFeelArgoUmlImagePath =\n133: \t    lookAndFeelPath(lookAndFeelClassName, \"argouml\");\n134: \tResourceLoader.addResourceExtension(\"gif\");\n135: \tResourceLoader.addResourceLocation(lookAndFeelGeneralImagePath);\n136: \tResourceLoader.addResourceLocation(lookAndFeelNavigationImagePath);\n137: \tResourceLoader.addResourceLocation(lookAndFeelDiagramImagePath);\n138: \tResourceLoader.addResourceLocation(lookAndFeelElementImagePath);\n139: \tResourceLoader.addResourceLocation(lookAndFeelArgoUmlImagePath);\n140: \tResourceLoader.addResourceLocation(\"/org/argouml/Images\");\n141: \tResourceLoader.addResourceLocation(\"/org/tigris/gef/Images\");\n142: \n143:         initialStateIcon = ResourceLoader.lookupIconResource(\"Initial\");\n144:         deepIcon = ResourceLoader.lookupIconResource(\"DeepHistory\");\n145:         shallowIcon = ResourceLoader.lookupIconResource(\"ShallowHistory\");\n146:         forkIcon = ResourceLoader.lookupIconResource(\"Fork\");\n147:         joinIcon = ResourceLoader.lookupIconResource(\"Join\");\n148:         branchIcon = ResourceLoader.lookupIconResource(\"Choice\");\n149:         junctionIcon = ResourceLoader.lookupIconResource(\"Junction\");\n150:         realizeIcon = ResourceLoader.lookupIconResource(\"Realization\");\n151:         signalIcon = ResourceLoader.lookupIconResource(\"SignalSending\");\n152:         commentIcon = ResourceLoader.lookupIconResource(\"Note\");\n153:     }\n154: \n155:     /**\n156:      * @see ResourceLoader#lookupIconResource(String)\n157:      */\n158:     public static ImageIcon lookupIconResource(String resource) {\n159: \treturn ResourceLoader.lookupIconResource(resource);\n160:     }\n161: \n162:     /**\n163:      * @see ResourceLoader#lookupIconResource(String, String)\n164:      */\n165:     public static ImageIcon lookupIconResource(String resource, String desc) {\n166: \treturn ResourceLoader.lookupIconResource(resource, desc);\n167:     }\n168: \n169:     /**\n170:      * Look up the Icon for a key.\n171:      *\n172:      * @param key The key to find.\n173:      * @return The found Icon.\n174:      */\n175:     public static Icon lookupIcon(String key) {\n176:         return lookupIconResource(getImageBinding(key),\n177:                 \t\t  Translator.localize(key));\n178:     }\n179: \n180:     /**\n181:      * Find the Icon for a given model element.\n182:      *\n183:      * @return The Icon.\n184:      * @param value The model element.\n185:      *\n186:      * TODO: This should not use string matching on classnames to do this\n187:      *       since this means that we have knowledge about how the model\n188:      *       elements are implemented outside of the Model component.\n189:      */\n190:     public Icon lookupIcon(Object value) {\n191:         if (value == null) {\n192:             throw new IllegalArgumentException(\n193:                     \"Attempted to get an icon given a null key\");\n194:         }\n195: \n196: \tIcon icon = (Icon) iconCache.get(value.getClass());\n197: \n198:         if (Model.getFacade().isAPseudostate(value)) {\n199: \n200:             Object kind = Model.getFacade().getKind(value);\n201:             DataTypesHelper helper = Model.getDataTypesHelper();\n202:             if (helper.equalsINITIALKind(kind)) {\n203:                 icon = initialStateIcon;\n204:             }\n205:             if (helper.equalsDeepHistoryKind(kind)) {\n206:                 icon = deepIcon;\n207:             }\n208:             if (helper.equalsShallowHistoryKind(kind)) {\n209:                 icon = shallowIcon;\n210:             }\n211:             if (helper.equalsFORKKind(kind)) {\n212:                 icon = forkIcon;\n213:             }\n214:             if (helper.equalsJOINKind(kind)) {\n215:                 icon = joinIcon;\n216:             }\n217:             if (helper.equalsBRANCHKind(kind)) {\n218:                 icon = branchIcon;\n219:             }\n220:             if (helper.equalsJUNCTIONKind(kind)) {\n221:                 icon = junctionIcon;\n222:             }\n223:             // if (MPseudostateKind.FINAL.equals(kind))\n224:             // icon = _FinalStateIcon;\n225:         }\n226: \n227:         if (Model.getFacade().isAAbstraction(value)) {\n228:             icon = realizeIcon;\n229:         }\n230:         // needs more work: sending and receiving icons\n231:         if (Model.getFacade().isASignal(value)) {\n232:             icon = signalIcon;\n233:         }\n234: \n235:         if (Model.getFacade().isAComment(value)) {\n236:             icon = commentIcon;\n237:         }\n238: \n239:         if (icon == null) {\n240: \n241:             StringNamespace sns =\n242:                 (StringNamespace) StringNamespace.parse(value.getClass());\n243:             StringNamespace org =\n244:                 new StringNamespace(new String[] {\"org\"});\n245:             StringNamespace ru = new StringNamespace(new String[] {\"ru\"});\n246: \n247:             String cName = sns.popNamespaceElement().toString();\n248:             if (ru.equals(sns.getCommonNamespace(ru))\n249:                     || org.equals(sns.getCommonNamespace(org))) {\n250: \n251:                 if (cName.startsWith(\"UML\")) {\n252:                     cName = cName.substring(3);\n253:                 }\n254:                 if (cName.startsWith(\"M\")) {\n255:                     cName = cName.substring(1);\n256:                 }\n257:                 if (cName.endsWith(\"Impl\")) {\n258:                     cName = cName.substring(0, cName.length() - 4);\n259:                 }\n260:             }\n261:             icon = lookupIconResource(cName);\n262:             if (icon == null) {\n263:                 LOG.warn(\"Can't find icon for \" + cName);\n264:             } else {\n265:                 synchronized (iconCache) {\n266:                     iconCache.put(value.getClass(), icon);\n267:                 }\n268:             }\n269: \n270:         }\n271: \treturn icon;\n272:     }\n273: \n274:     /**\n275:      * Map to convert tokens into file names.\n276:      */\n277:     private static Map images = new HashMap();\n278:     static {\n279:         images.put(\"action.about-argouml\", \"AboutArgoUML\");\n280:         images.put(\"action.activity-diagram\", \"Activity Diagram\");\n281:         images.put(\"action.class-diagram\", \"Class Diagram\");\n282:         images.put(\"action.collaboration-diagram\", \"Collaboration Diagram\");\n283:         images.put(\"action.deployment-diagram\", \"Deployment Diagram\");\n284:         images.put(\"action.sequence-diagram\", \"Sequence Diagram\");\n285:         images.put(\"action.state-diagram\", \"State Diagram\");\n286:         images.put(\"action.usecase-diagram\", \"Use Case Diagram\");\n287:     }\n288: \n289:     static {\n290:         images.put(\"action.add-concurrent-region\", \"Add Concurrent Region\");\n291:         images.put(\"action.add-message\", \"Add Message\");\n292:         images.put(\"action.configure-perspectives\", \"ConfigurePerspectives\");\n293:         images.put(\"action.copy\", \"Copy\");\n294:         images.put(\"action.cut\", \"Cut\");\n295:         images.put(\"action.delete-concurrent-region\", \"DeleteConcurrentRegion\");\n296:         images.put(\"action.delete-from-model\", \"DeleteFromModel\");\n297:         images.put(\"action.find\", \"Find...\");\n298:         images.put(\"action.import-sources\", \"Import Sources...\");\n299:         images.put(\"action.more-info\", \"More Info...\");\n300:         images.put(\"action.navigate-back\", \"Navigate Back\");\n301:         images.put(\"action.navigate-forward\", \"Navigate Forward\");\n302:         images.put(\"action.new\", \"New\");\n303:         images.put(\"action.new-todo-item\", \"New To Do Item...\");\n304:         images.put(\"action.open-project\", \"Open Project...\");\n305:         images.put(\"action.page-setup\", \"Page Setup...\");\n306:         images.put(\"action.paste\", \"Paste\");\n307:         images.put(\"action.print\", \"Print...\");\n308:         images.put(\"action.remove-from-diagram\", \"Remove From Diagram\");\n309:         images.put(\"action.resolve-item\", \"Resolve Item...\");\n310:         images.put(\"action.save-project\", \"Save Project\");\n311:         images.put(\"action.save-project-as\", \"Save P