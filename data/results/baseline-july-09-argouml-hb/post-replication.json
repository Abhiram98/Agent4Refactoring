t java.awt.event.*;\n33: import java.lang.reflect.*;\n34: import java.util.*;\n35: \n36: import javax.swing.*;\n37: \n38: \n39: /** Action object for handling Argo tests\n40:  *\n41:  *  @author Andreas Rueckert\n42:  *  @since  0.9.4\n43:  */\n44: public class ActionTestJunit extends UMLAction\n45:     implements PluggableMenu \n46: {\n47: \n48: \n49:     ////////////////////////////////////////////////////////////////\n50:     // Static variables\n51: \n52:     /** logger */\n53:     private static final Logger LOG = Logger.getLogger(ActionTestJunit.class);\n54: \n55:     /** \n56:      * A singleton as the only instance of this action.\n57:      */\n58:     private static ActionTestJunit singleton = new ActionTestJunit();\n59: \n60:     private static final String JUNIT_CLASS = \"junit.swingui.TestRunner\";\n61:     private static JMenuItem menuItem = null;\n62: \n63:     /** Internal flag to avoid multiple reports of failure. */\n64:     private boolean failed = false;\n65: \n66:     ////////////////////////////////////////////////////////////////\n67:     // Constructors.\n68: \n69:     /**\n70:      * Create a new ActionTestJunit instance (is not public, due to \n71:      * singleton pattern).\n72:      */\n73:     protected ActionTestJunit() {\n74: \tsuper(Translator.localize(\"Test Panel...\"), false);\n75: \tfailed = false;\n76:     }\n77: \n78:     ////////////////////////////////////////////////////////////////\n79:     // Main methods.\n80: \n81:     /** \n82:      * Get the instance.\n83:      *\n84:      * @return The ActionTestJunit instance\n85:      */\n86:     public static ActionTestJunit getInstance() {\n87:         return singleton;\n88:     }\n89: \n90:     /**\n91:      * Start the actual tests.\n92:      *\n93:      * The event, that triggered this action.\n94:      *\n95:      * Use reflection rather than directly executing class.main itself\n96:      * This executes the equivalent of:\n97:      *\n98:      * <code>junit.swingui.TestRunner.m