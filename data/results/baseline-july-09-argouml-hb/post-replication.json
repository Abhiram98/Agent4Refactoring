er pb = ProjectBrowser.TheInstance;\n1195:     Object target = pb.getDetailsTarget();\n1196:     return super.shouldBeEnabled() && target instanceof Classifier;\n1197:   }\n1198: } /* end class ActionAttr */\n1199: \n1200: class ActionAddOperation extends UMLChangeAction {\n1201:   // needs-more-work: should be part of java binding or common elements\n1202:   public static DataType VOID_TYPE = new DataType(\"void\");\n1203: \n1204:   public ActionAddOperation() { super(\"Operation\"); }\n1205: \n1206:   public void actionPerformed(ActionEvent ae) {\n1207:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n1208:     Object target = pb.getDetailsTarget();\n1209:     if (!(target instanceof Classifier)) return;\n1210:     Classifier cls = (Classifier) target;\n1211:     try {\n1212:       Operation oper = new Operation(VOID_TYPE, \"newOperation\");\n1213:       oper.setVisibility(VisibilityKind.PUBLIC);\n1214:       cls.addBehavioralFeature(oper);\n1215:       super.actionPerformed(ae);\n1216:     }\n1217:     catch (PropertyVetoException pve) {\n1218:       System.out.println(\"PropertyVetoException in ActionOper\");\n1219:     }\n1220:   }\n1221:   public boolean shouldBeEnabled() {\n1222:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n1223:     Object target = pb.getDetailsTarget();\n1224:     return super.shouldBeEnabled() && target instanceof Classifier;\n1225:   }\n1226: } /* end class ActionOper */\n1227: \n1228: \n1229: class ActionMessage extends UMLChangeAction {\n1230:   public ActionMessage() { super(\"Message\"); }\n1231: \n1232:   public void actionPerformed(ActionEvent ae) {\n1233:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n1234:     Object target = pb.getDetailsTarget();\n1235:     Object d = pb.getTarget();\n1236:     if (!(d instanceof UMLCollaborationDiagram)) return;\n1237:     if (!(target instanceof AssociationRole)) return;\n1238:     AssociationRole ar = (AssociationRole) target;\n1239:     try {\n1240:       Editor _curEditor = Globals.curEditor();\n1241:       GraphModel gm = _curEditor.getGraphModel();\n1242:       GraphNodeRenderer renderer = _curEditor.getGraphNodeRenderer();\n1243:       Layer lay = _curEditor.getLayerManager().getActiveLayer();\n1244:       SelectionManager _sm = _curEditor.getSelectionManager();\n1245:       Vector figs = _sm.selections();\n1246:       Selection _cf = (Selection) figs.firstElement();\n1247:       FigEdge _curFig = (FigEdge) _cf.getContent();\n1248:       Point _center = _curFig.center();\n1249: \n1250:       Message msg = new Message();\n1251:       Vector ascEnds = ar.getAssociationEndRole();\n1252: \n1253:       AssociationEndRole aer1 = (AssociationEndRole) ascEnds.firstElement();\n1254:       AssociationEndRole aer2 = (AssociationEndRole) ascEnds.lastElement();\n1255:       ClassifierRole crSrc = (ClassifierRole) aer1.getType();\n1256:       ClassifierRole crDst = (ClassifierRole) aer2.getType();\n1257:       msg.setSender(crSrc);\n1258:       msg.setReceiver(crDst);\n1259:       UninterpretedAction ua = new UninterpretedAction();\n1260:       msg.setAction(ua);\n1261:       ar.addMessage(msg);\n1262: \n1263:       FigNode _pers = renderer.getFigNodeFor(gm, lay, msg);\n1264:       Vector messages = ar.getMessages();\n1265:       int size = messages.size();\n1266:       int offsetY = _pers.getHeight()/2;\n1267:       _pers.setLocation(_center.x, _center.y - (offsetY * size));\n1268:       _curFig.addPathItem(_pers, new PathConvPercent(_curFig, 50, 10));\n1269:       lay.add(_pers);\n1270:       super.actionPerformed(ae);\n1271:       //System.out.println(\"sender = \" + msg.getSender().getName());\n1272:       //System.out.println(\"receiver = \" + msg.getReceiver().getName());\n1273:     }\n1274:     catch (PropertyVetoException pve) {\n1275:       System.out.println(\"PropertyVetoException in ActionMessage\");\n1276:     }\n1277:   }\n1278: \n1279:   public boolean shouldBeEnabled() {\n1280:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n1281:     Object target = pb.getDetailsTarget();\n1282:     return super.shouldBeEnabled() && target instanceof AssociationRole;\n1283:   }\n1284: } /* end class ActionMessage */\n1285: \n1286: class ActionModel extends UMLChangeAction {\n1287:   //uci.gef.Cmd _cmdCreateNode = new\n1288:   //uci.gef.CmdCreateNode(uci.uml.Model_Management.Model.class, \"Model\");\n1289:   // needs-more-work: need FigModel and UMLPackageDiagram\n1290:   public ActionModel() { super(\"Model\"); }\n1291: \n1292:   public void actionPerformed(ActionEvent ae) {\n1293:     System.out.println(\"making model...\");\n1294:     //_cmdCreateNode.doIt();\n1295:     Project p = ProjectBrowser.TheInstance.getProject();\n1296:     try {\n1297:       p.addModel(new Model());\n1298:       super.actionPerformed(ae);\n1299:     }\n1300:     catch (PropertyVetoException pve) { }\n1301:   }\n1302: \n1303:   public boolean shouldBeEnabled() {\n1304:     Project p = ProjectBrowser.TheInstance.getProject();\n1305:     return super.shouldBeEnabled() && p != null;\n1306:   }\n1307: } /* end class ActionModel */\n1308: \n1309: ////////////////////////////////////////////////////////////////\n1310: // generate menu actions\n1311: \n1312: class ActionGenerateOne extends UMLAction {\n1313:   public ActionGenerateOne() { super(\"Generate Selected Classes\"); }\n1314: \n1315:   public void actionPerformed(ActionEvent ae) {\n1316:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n1317:     Editor ce = uci.gef.Globals.curEditor();\n1318:     Vector sels = ce.getSelectionManager().getFigs();\n1319:     java.util.Enumeration enum = sels.elements();\n1320:     Vector classes = new Vector();\n1321:     while (enum.hasMoreElements()) {\n1322:       Fig f = (Fig) enum.nextElement();\n1323:       Object owner = f.getOwner();\n1324:       if (!(owner instanceof MMClass) && !(owner instanceof Interface))\n1325: \tcontinue;\n1326:       Classifier cls = (Classifier) owner;\n1327:       String name = cls.getName().getBody();\n1328:       if (name == null || name.length() == 0) continue;\n1329:       classes.addElement(cls);\n1330:     }\n1331:     ClassGenerationDialog cgd = new ClassGenerationDialog(classes);\n1332:     cgd.show();\n1333:   }\n1334: \n1335:   public boolean shouldBeEnabled() {\n1336:     if (!super.shouldBeEnabled()) return false;\n1337:     Editor ce = uci.gef.Globals.curEditor();\n1338:     Vector sels = ce.getSelectionManager().getFigs();\n1339:     java.util.Enumeration enum = sels.elements();\n1340:     boolean foundOne = false;\n1341:     while (enum.hasMoreElements()) {\n1342:       Fig f = (Fig) enum.nextElement();\n1343:       Object owner = f.getOwner();\n1344:       if (!(owner instanceof MMClass) && !(owner instanceof Interface))\n1345: \tcontinue;\n1346:       Classifier cls = (Classifier) owner;\n1347:       String name = cls.getName().getBody();\n1348:       if (name == null || name.length() == 0) return false;\n1349:       foundOne = true;\n1350:     }\n1351:     return foundOne;\n1352:   }\n1353: } /* end class ActionGenerateOne */\n1354: \n1355: class ActionGenerateAll extends UMLAction {\n1356:   public ActionGenerateAll() { super(\"Generate All Classes\"); }\n1357: \n1358:   public void actionPerformed(ActionEvent ae) {\n1359:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n1360:     Object target = pb.getTarget();\n1361:     if (!(target instanceof UMLClassDiagram)) return;\n1362:     UMLClassDiagram d = (UMLClassDiagram) target;\n1363:     Vector classes = new Vector();\n1364:     Vector nodes = d.getGraphModel().getNodes();\n1365:     java.util.Enumeration enum = nodes.elements();\n1366:     while (enum.hasMoreElements()) {\n1367:       Object owner = enum.nextElement();\n1368:       if (!(owner instanceof MMClass) && !(owner instanceof Interface))\n1369: \tcontinue;\n1370:       Classifier cls = (Classifier) owner;\n1371:       String name = cls.getName().getBody();\n1372:       if (name == null || name.length() == 0) continue;\n1373:   