l.kernel.ProjectManager;\n32: import org.argouml.model.Model;\n33: import org.argouml.ui.CmdCreateNode;\n34: import org.argouml.ui.CmdSetMode;\n35: import org.argouml.uml.diagram.sequence.SequenceDiagramGraphModel;\n36: import org.argouml.uml.diagram.ui.RadioAction;\n37: import org.argouml.uml.diagram.ui.UMLDiagram;\n38: \n39: /**\n40:  * The diagram for sequence diagrams.<p>\n41:  *\n42:  * Totally rewritten for release 0.16.<p>\n43:  *\n44:  * @author jaap.branderhorst@xs4all.nl Aug 3, 2003\n45:  * @author 5eichler@informatik.uni-hamburg.de originally.\n46:  */\n47: public class UMLSequenceDiagram extends UMLDiagram {\n48: \n49:     private Object[] actions;\n50: \n51:     /**\n52:      * Constructs a new sequence diagram with a default name and NO namespace.\n53:      * namespaces are used to determine the 'owner' of the diagram for diagrams\n54:      * but that's plain misuse.\n55:      */\n56:     public UMLSequenceDiagram() {\n57:         this(Model.getCollaborationsFactory().buildCollaboration(\n58: \t\t ProjectManager.getManager().getCurrentProject().getRoot()));\n59:     }\n60: \n61:     /**\n62:      * The constructor.\n63:      *\n64:      * @param collaboration the collaboration\n65:      */\n66:     public UMLSequenceDiagram(Object collaboration) {\n67:         super();\n68:         try {\n69:             setName(getNewDiagramName());\n70:         } catch (PropertyVetoException pve) {\n71:         }\n72:         // Dirty hack to remove the trash the Diagram constructor leaves\n73:         SequenceDiagramGraphModel gm =\n74:             new SequenceDiagramGraphModel(collaboration);\n75:         SequenceDiagramLayout lay =\n76:             new SequenceDiagramLayout(this.getName(), gm);\n77:         SequenceDiagramRenderer rend = new SequenceDiagramRenderer();\n78:         lay.setGraphEdgeRenderer(rend);\n79:         lay.setGraphNodeRenderer(rend);\n80:         setLayer(lay);\n81:     }\n82: \n83:     /**\n84:      * Returns the owner of this diagram. In the case of sequencediagrams it's\n85:      * allways the root model.\n86:      *\n87:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getOwner()\n88:      */\n89:     public Object getOwner() {\n90:         // TODO: in the future (when there are multiple models) this\n91:         // should be changeable\n92:         return ProjectManager.getManager().getCurrentProject().getRoot();\n93:     }\n94: \n95:     /**\n96:      * Creates a new diagramname.\n97:      *\n98:      * @return a new unique name.\n99:      */\n100:     protected String getNewDiagramName() {\n101:         String name = \"Sequence Diagram \" + getNextDiagramSerial();\n102:         if (!(ProjectManager.getManager().getCurrentProject()\n103: \t      .isValidDiagramName(name))) {\n104:             name = getNewDiagramName();\n105:         }\n106:         return name;\n107:     }\n108: \n109:     /**\n110:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getLabelName()\n111:      */\n112:     public String getLabelName() {\n113:         return Translator.localize(\"label.sequence-diagram\");\n114:     }\n115: \n116:     /**\n117:      * Must return an array of actions via which the model can be\n118:      * manipulated. To use the 'nested actions' feature (like the\n119:      * different association types on UMLClassDiagram) these nested\n120:      * actions must be in an array of their own.<p>\n121:      *\n122:      * In case of the sequence diagram this method must return the\n123:      * following actions:<ul>\n124:      * <li>Action to create an object\n125:      * <li>Action to add a procedural link\n126:      * <li>Action to add a create link\n127:      * <li>Action to add a asynchronous link\n128:      * <li>Action to add a synchronous link\n129:      * <li>Action to add a return link\n130:      * </ul>\n131:      *\n132:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getUmlActions()\n133:      */\n134:     protected Object[] getUmlActions() {\n135:         if (actions == null) {\n136:             actions = new Object[5];\n137:             actions[0] =\n138:                 new CmdCreateNode(Model.getMetaTypes().getObject(), \"Object\");\n139: \t    int offset = 1;\n140: \n141: \t    Object[][] actionList = {\n142: \t\t{Model.getMetaTypes().getCallAction(), \"CallAction\"},\n143: \t\t{Model.getMetaTypes().getReturnAction(), \"ReturnAction\"},\n144: \t\t{Model.getMetaTypes().getCreateAction(), \"CreateAction\"},\n145: \t\t{Model.getMetaTypes().getDestroyAction(), \"DestroyAction\"},\n146: \t    };\n147: \n148: \t    for (int i = 0; i < actionList.length; i++) {\n149: \t\tHashtable args = new Hashtable();\n150: \t\targs.put(\"edgeClass\", Model.getMetaTypes().getLink());\n151: \t\targs.put(\"action\", actionList[i][0]);\n152: \t\tactions[i + offset] =\n153: \t\t    new RadioAction(new CmdSetMode(ModeCreateLink.class, args,\n154: \t\t\t\t\t\t   (String) actionList[i][1]));\n155: \t    }\n156:         }\n157:         return actions;\n158:     }\n159: \n160:     /**\n161:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getNamespace()\n162:      */\n163:     public Object getNamespace() {\n164:         if (getGraphModel() == null\n165:             || !(getGraphModel() instanceof SequenceDiagramGraphModel)) {\n166:             SequenceDiagramGraphModel model =\n167:                 new SequenceDiagramGraphModel(\n168:                     Model.getCollaborationsFactory().buildCollaboration(\n169:                         ProjectManager.getManager().getCurrentProject()\n170:                             .getRoot()));\n171:             SequenceDiagramLayout lay =\n172:                 new SequenceDiagramLayout(this.getName(), model);\n173:             SequenceDiagramRenderer rend = new SequenceDiagramRenderer();\n174:             lay.setGraphEdgeRenderer(rend);\n175:             lay.setGraphNodeRenderer(rend);\n176:             setLayer(lay);\n177:         }\n178:         return ((SequenceDiagramGraphModel) getGraphModel()).getCollaboration();\n179:     }\n180: \n181:     /**\n182:      * UMLSequencediagram does not have a namespace.<p>\n183:      *\n184:      * This method throws therefore an UnsupportedOperationException.<p>\n185:      *\n186:      * @see org.argouml.uml.diagram.ui.UMLDiagram#setNamespace(Object)\n187:      */\n188:     public void setNamespace(Object ns) {\n189:         if (getGraphModel() == null\n190:             || !(getGraphModel() instanceof SequenceDiagramGraphModel)) {\n191:             SequenceDiagramGraphModel model =\n192:                 new SequenceDiagramGraphModel(\n193:                     Model.getCollaborationsFactory().buildCollaboration(\n194:                         ProjectManager.getManager().getCurrentProject()\n195: \t\t\t    .getRoot()));\n196:             SequenceDiagramLayout lay =\n197:                 new SequenceDiagramLayout(this.getName(), model);\n198:             SequenceDiagramRenderer rend = new SequenceDiagramRenderer();\n199:             lay.setGraphEdgeRenderer(rend);\n200:             lay.setGraphNodeRenderer(rend);\n201:             setLayer(lay);\n202:         }\n203:         Model.getCoreHelper().setNamespace(\n204:             ((SequenceDiagramGraphModel) getLayer().getGraphModel())\n205:                 .getCollaboration(),\n206:             ns);\n207:     }\n208: \n209:     /**\n210:      * Method called by Project.removeDiagram to clean up the mess in\n211:      * this diagram when the diagram is removed.\n212:      */\n213:     public void cleanUp() {\n214:         Object collab =\n215:             ((SequenceDiagramGraphModel) getGraphModel()).getCollaboration();\n216:         ProjectManager.getManager().getCurrentProject().moveToTrash(collab);\n217:     }\n218: \n219: } /* end class UMLSequenceDiagram */\n220: ",
