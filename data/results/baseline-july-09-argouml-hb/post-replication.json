i.server.UID;\n33: \n34: import java.util.Collection;\n35: import java.util.Comparator;\n36: import java.util.Iterator;\n37: import java.util.TreeMap;\n38: import java.util.TreeSet;\n39: \n40: import javax.swing.Icon;\n41: \n42: import org.apache.log4j.Logger;\n43: \n44: import org.argouml.application.ArgoVersion;\n45: \n46: import org.argouml.application.api.Argo;\n47: import org.argouml.application.api.Notation;\n48: import org.argouml.application.api.PluggableNotation;\n49: \n50: import org.argouml.language.php.PHPDocumentor;\n51: \n52: import org.argouml.model.ModelFacade;\n53: \n54: import org.argouml.uml.generator.FileGenerator;\n55: import org.argouml.uml.generator.Generator2;\n56: \n57: /**\n58:  * Generator class for PHP 4.x source code\n59:  *\n60:  * @author Kai Schr&ouml;der\n61:  * @since  ArgoUML 0.15.5\n62:  */\n63: public class GeneratorPHP4\n64:     extends Generator2\n65:     implements PluggableNotation, FileGenerator {\n66: \n67:     /**\n68:      * Sets the indentation level to four spaces\n69:      */\n70:     protected static final String INDENT = \"    \";\n71: \n72:     /**\n73:      * The name of the language this module generates source code for\n74:      */\n75:     protected static final String LANGUAGE_NAME = \"PHP\";\n76: \n77:     /**\n78:      * Icon to represent this notation in the GUI\n79:      */\n80:     protected static final Icon ICON = Argo.lookupIconResource(\"PHPNotation\");\n81: \n82:     /**\n83:      * Info block already written to log file?\n84:      */\n85:     protected static final TreeMap TM_INFO_BLOCK_LOGGED = new TreeMap();\n86: \n87:     /**\n88:      * The major version of the language this module generates source code for\n89:      */\n90:     private int iLanguageMajorVersion = LANGUAGE_MAJOR_VERSION;\n91: \n92:     /**\n93:      * source section handler\n94:      */\n95:     private static Section objSection = null;\n96: \n97:     /**\n98:      * The log4j logger to log messages to\n99:      */\n100:     private static final Logger LOG = Logger.getLogger(GeneratorPHP4.class);\n101: \n102:     /**\n103:      * The major version of the language this module generates source code for\n104:      */\n105:     private static final int LANGUAGE_MAJOR_VERSION = 4;\n106: \n107:     // ----- class constructors ------------------------------------------------\n108: \n109:     /**\n110:      * Zero-argument class constructor\n111:      */\n112:     private GeneratorPHP4() {\n113:         super(Notation.makeNotation(LANGUAGE_NAME, LANGUAGE_MAJOR_VERSION\n114:                 + \".x\", ICON));\n115: \n116:         logModuleInfo();\n117:     }\n118: \n119:     /**\n120:      * Class constructor\n121:      *\n122:      * @param iLangMajorVersion The major version of the language this module\n123:      *                          generates source code for.\n124:      */\n125:     protected GeneratorPHP4(int iLangMajorVersion) {\n126:         super(Notation.makeNotation(LANGUAGE_NAME, iLangMajorVersion\n127:                 + \".x\", ICON));\n128: \n129:         iLanguageMajorVersion = iLangMajorVersion;\n130: \n131:         logModuleInfo();\n132:     }\n133: \n134:     // ----- org.argouml.application.api.NotationProvider ----------------------\n135: \n136:     /**\n137:      * Generates extension point\n138:      *\n139:      * @param modelElement Model element to generate notation for.\n140:      *\n141:      * @return Generated notation for model element.\n142:      */\n143:     public String generateExtensionPoint(Object modelElement) {\n144:         // TODO: Auto-generated method stub\n145:         LOG.debug(\"generateExtensionPoint(MExtensionPoint modelElement)\");\n146: \n147:         if (!ModelFacade.isAExtensionPoint(modelElement)) {\n148:             throw new ClassCastException(modelElement.getClass()\n149:                     + \" has wrong object type, ExtensionPoint required\");\n150:         }\n151: \n152:         return \"generateExtensionPoint(MExtensionPoint modelElement)\";\n153:     }\n154: \n155:     /**\n156:      * @see org.argouml.application.api.NotationProvider2#generateObjectFlowState(java.lang.Object)\n157:      */\n158:     public String generateObjectFlowState(Object m) {\n159:         Object c = ModelFacade.getType(m);\n160:         if (c == null) return \"\";\n161:         return ModelFacade.getName(c);\n162:     }\n163:     \n164:     /**\n165:      * Generates operation\n166:      *\n167:      * @param modelElement Model element to generate notation for.\n168:      * @param bAddDocs     Add documentation in front of notation?\n169:      *\n170:      * @return Generated notation for model element.\n171:      */\n172:     public String generateOperation(Object modelElement, boolean bAddDocs) {\n173:         if (!ModelFacade.isAOperation(modelElement)) {\n174:             throw new ClassCastException(modelElement.getClass()\n175:                     + \" has wrong object type, Operation required\");\n176:         }\n177: \n178:         String sOperation = \"\";\n179: \n180:         if (bAddDocs) {\n181:             PHPDocumentor objPHPDoc = null;\n182:             try {\n183:                 objPHPDoc = new PHPDocumentor(modelElement);\n184:             } catch (Exception exp) {\n185:                 LOG.error(\"Generating operation DocBlock FAILED: \"\n186:                     + exp.getMessage());\n187:             } finally {\n188:                 if (objPHPDoc != null) {\n189:                     sOperation += objPHPDoc.toString();\n190:                 }\n191:             }\n192:         }\n193: \n194:         String sVisibility = generate(ModelFacade.getVisibility(modelElement));\n195:         if (sVisibility != null && sVisibility != \"\") {\n196:             sOperation += sVisibility + \" \";\n197:         }\n198: \n199:         if (iLanguageMajorVersion > 4) {\n200:             /* scope */\n201:             Object ownerScope = ModelFacade.getOwnerScope(modelElement);\n202:             if (ModelFacade.CLASSIFIER_SCOPEKIND.equals(ownerScope)) {\n203:                 sOperation += \"static \";\n204:             }\n205: \n206:             /* changeability */\n207:             if (ModelFacade.isLeaf(modelElement)) {\n208:                 sOperation += \"final \";\n209:             }\n210: \n211:             /* abstractness */\n212:             if (ModelFacade.isAbstract(modelElement)) {\n213:                 sOperation += \"abstract \";\n214:             }\n215:         }\n216: \n217:         boolean bReturnByReference = false;\n218: \n219:         Iterator itTaggedValues = ModelFacade.getTaggedValues(modelElement);\n220:         if (itTaggedValues != null && itTaggedValues instanceof Iterator) {\n221:             while (itTaggedValues.hasNext()) {\n222:                 Object objTaggedValue = itTaggedValues.next();\n223:                 if (ModelFacade.getTagOfTag(objTaggedValue).equals(\"&\")) {\n224:                     if (ModelFacade.getValueOfTag(objTaggedValue)\n225:                             .equals(\"true\")) {\n226:                         bReturnByReference = true;\n227: \n228:                         break;\n229:                     }\n230:                 }\n231:             }\n232:         }\n233: \n234:         String sOperationName = NameGenerator.generate(modelElement,\n235:                 iLanguageMajorVersion);\n236: \n237:         if (bReturnByReference) {\n238:             sOperationName = \"&\" + sOperationName;\n239:         }\n240: \n241:         sOperation += \"function \" + sOperationName + \"(\";\n242: \n243:         Collection colParameters = ModelFacade.getParameters(modelElement);\n244:         if (colParameters != null) {\n245:             Iterator itParameters = colParameters.iterator();\n246:             boolean bFirst = true;\n247:             while (itParameters.hasNext()) {\n248:                 Object objParameter = itParameters.next();\n249:                 if (!ModelFacade.isReturn(objParameter)) {\n250:                     if (!bFirst) {\n251:                         sOperation += \", \";\n252:                     } else {\n253:                         bFirst = false;\n254:                     }\n255: \n256:                     sOperation += generate(objParameter);\n257:                 }\n258:             }\n259:         }\n260: \n261:         sOperation += \")\";\n262: \n263:         return sOperation;\n264:     }\n265: \n266:     /**\n267:      * Generates attribute\n268:      *\n269:      * @param modelElement Model element to generate notation for.\n270:      * @param bAddDocs     Add documentation in front of notation?\n271:      *\n272:      * @return Generated notation for model element.\n273:      */\n274:     public String generateAttribute(Object modelElement, boolean bAddDocs) {\n275:         if (!ModelFacade.isAAttribute(modelElement)) {\n276:             throw new ClassCastException(modelElement.getClass()\n277:                     + \" has wrong object type, Attribute required\");\n278:         }\n279: \n280:         String sAttribute = \"\";\n281: \n282:         if (bAddDocs) {\n283:             PHPDocumentor objPHPDoc = null;\n284:             try {\n285:                 objPHPDoc = new PHPDocumentor(modelElement);\n286:             } catch (Exception exp) {\n287:                 LOG.error(\"Generating attribute DocBlock FAILED: \"\n288:                     + exp.getMessage());\n289:             } finally {\n290:                 if (objPHPDoc != null) {\n291:                     sAttribute += objPHPDoc.toString(INDENT);\n292:                 }\n293:             }\n294:         }\n295: \n296:         String sVisibility = generate(ModelFacade.getVisibility(modelElement));\n297:         if (sVisibility != null && sVisibility != \"\") {\n298:             sAttribute += sVisibility + \" \";\n299:         }\n300: \n301:         if (iLanguageMajorVersion > 4) {\n302:             /* scope */\n303:             Object ownerScope = ModelFacade.getOwnerScope(modelElement);\n304:             if (ModelFacade.CLASSIFIER_SCOPEKIND.equals(ownerScope)) {\n305:                 sAttribute += \"static \";\n306:             }\n307:         } else {\n308:             sAttribute += \"var \";\n309:         }\n310: \n311:         sAttribute += \"$\" + NameGenerator.generate(modelElement,\n312:                 iLanguageMajorVersion);\n313: \n314:         String sInitialValue = null;\n315:         Object exprInitialValue = ModelFacade.getInitialValue(modelElement);\n316:         if (exprInitialValue != null) {\n317:             sInitialValue = generateDefaultValue(\n318:                     ModelFacade.getType(modelElement),\n319:                     generate(exprInitialValue).trim(), false);\n320:         } else {\n321:             sInitialValue = generateDefaultValue(\n322:                     ModelFacade.getType(modelElement), null, false);\n323:         }\n324: \n325:         if (sInitialValue != null && sInitialValue.length() > 0) {\n326:             sAttribute += \" = \" + sInitialValue;\n327:         } else {\n328:             sAttribute += \"[ \";\n329:             sAttribute += (exprInitialValue != null) ? \"!= null\" : \"null\";\n330:             sAttribute += \" | \";\n331:             sAttribute += generateDefaultValue(\n332:                 ModelFacade.getType(modelElement),\n333:                     generate(exprInitialValue).trim(), false);\n334:             sAttribute += \" | \";\n335:             sAttribute += generateDefaultValue(\n336:                 ModelFacade.getType(modelElement),\n337:                     generate(exprInitialValue).trim(), true);\n338:             sAttribute += \" ]\";\n339:         }\n340: \n341:         sAttribute += \";\";\n342: \n343:         return sAttribute;\n344:     }\n345: \n346:     /**\n347:      * Generates parameter\n348:      *\n349:      * @param modelElement Model element to generate notation for.\n350:      *\n351:      * @return Generated notation for model element.\n352:      */\n353:     public String generateParameter(Object modelElement) {\n354:         if (!ModelFacade.isAParameter(modelElement)) {\n355:             throw new ClassCastException(modelElement.getClass()\n356:                     + \" has wrong object type, Parameter required\");\n357:         }\n358: \n359:         String sParameter = \"\";\n360: \n361:         if (ModelFacade.isReturn(modelElement)) {\n362:             Object objType = ModelFacade.getType(modelElement);\n363:             if (ModelFacade.getName(objType).equals(\"void\")) {\n364:                 return \"\";\n365:             } else {\n366:                 String sType = convertType(objType);\n367:                 if (sType != null && sType.trim() != \"\") {\n368:                     return \"return (\" + sType + \") $returnValue;\";\n369:                 } else {\n370:                     return \"return $returnValue;\";\n371:                 }\n372:             }\n373:         } else {\n374:             if (iLanguageMajorVersion < 5) {\n375:                 // TODO: Do we really need this for PHP5?\n376:                 // TODO: Implent this in ModelFacade\n377:                 /* if OUT or INOUT, then pass by reference */\n378:                 if (ModelFacade.getKind(modelElement).equals(\n379:                         ModelFacade.INOUT_PARAMETERDIRECTIONKIND)\n380:                         || ModelFacade.getKind(modelElement).equals(\n381:                             ModelFacade.OUT_PARAMETERDIRECTIONKIND)) {\n382:                     sParameter += \"&\";\n383:                 }\n384:             }\n385: \n386:             sParameter += \"$\" + ModelFacade.getName(modelElement);\n387: \n388:             String sDefaultValue =\n389:                 generate(ModelFacade.getDefaultValue(modelElement));\n390:             if (sDefaultValue != null && sDefaultValue.length() > 0) {\n391:                 sParameter += \" = \" + sDefaultValue;\n392:             } else {\n393:                 boolean bAddDefaultValue = false;\n394: \n395:                 Collection colParameters =\n396:                         ModelFacade.getParameters(ModelFacade\n397:                                 .getBehavioralFeature(modelElement));\n398:                 if (colParameters != null) {\n399:                     Iterator itParameters = colParameters.iterator();\n400:                     while (itParameters.hasNext()) {\n401:                         Object objParameter = itParameters.next();\n402:                         if (!ModelFacade.isReturn(objParameter)) {\n403:                             if (!modelElement.equals(objParameter)) {\n404:                                 if (ModelFacade.getDefaultValue(objParameter)\n405:                                         != null) {\n406:                                     bAddDefaultValue = true;\n407:                                 }\n408:                             } else {\n409:                                 break;\n410:                             }\n411:                         }\n412:                     }\n413:                 }\n414: \n415:                 if (bAddDefaultValue) {\n416:                     sParameter += \" = \" + generateDefaultValue(\n417:                         ModelFacade.getType(modelElement), null, false);\n418:                 }\n419:             }\n420:         }\n421: \n422:         return sParameter;\n423:     }\n424: \n425:     /**\n426:      * Generates package\n427:      *\n428:      * @param modelElement Model element to generate notation for.\n429:      *\n430:      * @return Generated notation for model element.\n431:      *\n432:      * TODO: fix org.argouml.model.ModelFacade#getType\n433:      */\n434:     public String generatePackage(Object modelElement) {\n435:         String sPackage = \"\";\n436: \n437:         if (!ModelFacade.isAPackage(modelElement)) {\n438:             throw new ClassCastException(modelElement.getClass()\n439:                     + \" has wrong object type, Package required\");\n440:         }\n441: \n442:         String sPackageName =\n443:                 NameGenerator.generate(modelElement, iLanguageMajorVersion);\n444: \n445:         PHPDocumentor objPHPDoc = null;\n446:         try {\n447:             objPHPDoc = new PHPDocumentor(modelElement);\n448:         } catch (Exception exp) {\n449:             LOG.error(\"Generating package DocBlock FAILED: \"\n450:                     + exp.getMessage());\n451:         } finally {\n452:             if (objPHPDoc != null) {\n453:                 sPackage += objPHPDoc.toString() + \"\\n\";\n454:             }\n455:         }\n456: \n457:         Collection colElements = ModelFacade.getOwnedElements(modelElement);\n458:         if (colElements != null) {\n459:             Iterator itElements = colElements.iterator();\n460:             if (itElements != null) {\n461:                 while (itElements.hasNext()) {\n462:                     Object objElement = itElements.next();\n463:                     if (ModelFacade.isAPackage(objElement)) {\n464:                         sPackage += generate(objElement) + \"\\n\";\n465:                     } else if (ModelFacade.isAClassifier(objElement)) {\n466:                         sPackage += generate(objElement) + \"\\n\";\n467:                     } else {\n468:                         sPackage += \"/*\\n\";\n469:                         sPackage += \"feature not supported by PHP:\\n\";\n470:                         sPackage += \"-----------------------------\\n\";\n471:                         sPackage += generate(objElement) + \"\\n\";\n472:                         sPackage += \"*/\\n\";\n473:                     }\n474:                     if (itElements.hasNext()) {\n475:                         sPackage += \"\\n\";\n476:                     }\n477:                 }\n478:             }\n479:         } else {\n480:             sPackage += \"// this package contains no elements\\n\";\n481:         }\n482: \n483:         sPackage += \"\\n/* end of package \" + sPackageName + \" */\";\n484: \n485:         return sPackage;\n486:     }\n487: \n488:     /**\n489:      * Generates class or interface\n490:      *\n491:      * @param modelElement Model element to generate notation for.\n492:      *\n493:      * @return Generated notation for model element.\n494:      */\n495:     public String generateClassifier(Object modelElement) {\n496:         if (!ModelFacade.isAClassifier(modelElement)) {\n497:             throw new ClassCastException(modelElement.getClass()\n498:                     + \" has wrong object type, Classifier required\");\n499:         }\n500: \n501:         String sClassifier = \"\";\n502: \n503:         String sClassType = \"\";\n504:         if (iLanguageMajorVersion > 4) {\n505:             if (ModelFacade.isAClass(modelElement)) {\n506:                 if (ModelFacade.isLeaf(modelElement)) {\n507:                     sClassType = \"final class\";\n508:                 } else {\n509:                     sClassType = \"class\";\n510:                 }\n511:                 if (ModelFacade.isAbstract(modelElement)) {\n512:                     sClassType = \"abstract \" + sClassType;\n513:                 }\n514:             } else if (ModelFacade.isAInterface(modelElement)) {\n515:                 sClassType = \"interface\";\n516:                 if (ModelFacade.isLeaf(modelElement)) {\n517:                     sClassType = \"final \" + sClassType;\n518:                 }\n519:             } else {\n520:                 return null;\n521:             }\n522:         } else {\n523:             if (ModelFacade.isAClass(modelElement)\n524:                     || ModelFacade.isAInterface(modelElement)) {\n525:                 sClassType = \"class\";\n526:             } else {\n527:                 return null;\n528:             }\n529:         }\n530: \n531:         PHPDocumentor objPHPDoc = null;\n532:         try {\n533:             objPHPDoc = new PHPDocumentor(modelElement);\n534:         } catch (Exception exp) {\n535:             LOG.error(\"Generating classifier DocBlock FAILED: \"\n536:                     + exp.getMessage());\n537:         } finally {\n538:             if (objPHPDoc != null) {\n539:                 sClassifier += objPHPDoc.toString();\n540:             }\n541:         }\n542: \n543:         String sClassName =\n544:                 NameGenerator.generate(modelElement, iLanguageMajorVersion);\n545: \n546:         sClassifier += sClassType + \" \" + sClassName + \"\\n\";\n547: \n548:         sClassifier += generateClassifierGeneralisations(modelElement);\n549:         sClassifier += generateClassifierSpecifications(modelElement);\n550: \n551:         sClassifier += \"{\\n\";\n552: \n553:         sClassifier += generateClassifierAttributes(modelElement);\n554:         sClassifier += generateClassifierOperations(modelElement);\n555: \n556:         sClassifier += \"\\n} /* end of \" + sClassType + \" \" + sClassName + \" */\";\n557: \n558:         return sClassifier;\n559:     }\n560: \n561:     /**\n562:      * Generates tagged value\n563:      *\n564:      * @param modelElement Model element to generate notation for.\n565:      *\n566:      * @return Generated notation for model element.\n567:      */\n568:     public String generateTaggedValue(Object modelElement) {\n569:         // TODO: Auto-generated method stub\n570:         LOG.debug(\"generateTaggedValue(MTaggedValue modelElement)\");\n571: \n572:         if (!ModelFacade.isATaggedValue(modelElement)) {\n573:             throw new ClassCastException(modelElement.getClass()\n574:                     + \" has wrong object type, TaggedValue required\");\n575:         }\n576: \n577:         return \"generateTaggedValue(MTaggedValue modelElement)\";\n578:     }\n579: \n580:     /**\n581:      * Generates association\n582:      *\n583:      * @param modelElement Model element to generate notation for.\n584:      *\n585:      * @return Generated notation for model element.\n586:      */\n587:     public String generateAssociation(Object modelElement) {\n588:         // TODO: Auto-generated method stub\n589:         LOG.debug(\"generateExtensionPoint(MExtensionPoint modelElement)\");\n590: \n591:         if (!ModelFacade.isAAssociation(modelElement)) {\n592:             throw new ClassCastException(modelElement.getClass()\n593:                     + \" has wrong object type, Association required\");\n594:         }\n595: \n596:         return \"generateAssociation(MAssociation modelElement)\";\n597:     }\n598: \n599:     /**\n600:      * Generates association end\n601:      *\n602:      * @param modelElement Model element to generate notation for.\n603:      *\n604:      * @return Generated notation for model element.\n605:      */\n606:     public String generateAssociationEnd(Object modelElement) {\n607:         // TODO: Auto-generated method stub\n608:         LOG.debug(\"generateAssociationEnd(MAssociationEnd modelElement)\");\n609: \n610:         if (!ModelFacade.isAAssociationEnd(modelElement)) {\n611:             throw new ClassCastException(modelElement.getClass()\n612:                     + \" has wrong object type, AssociationEnd required\");\n613:         }\n614: \n615:         return \"generateAssociationEnd(MAssociationEnd modelElement)\";\n616:     }\n617: \n618:     /**\n619:      * Genarates multiplicity\n620:      *\n621:      * @param modelElement Model element to generate notation for.\n622:      *\n623:      * @return Generated notation for model element.\n624:      */\n625:     public String generateMultiplicity(Object modelElement) {\n626:         // TODO: Auto-generated method stub\n627:         LOG.debug(\"generateMultiplicity(MMultiplicity modelElement)\");\n628: \n629:         if (!ModelFacade.isAMultiplicity(modelElement)) {\n630:             throw new ClassCastException(modelElement.getClass()\n631:                     + \" has wrong object type, Multiplicity required\");\n632:         }\n633: \n634:         return \"generateMultiplicity(MMultiplicity modelElement)\";\n635:     }\n636: \n637:     /**\n638:      * Generates state\n639:      *\n640:      * @param modelElement Model element to generate notation for.\n641:      *\n642:      * @return Generated notation for model element.\n643:      */\n644:     public String generateState(Object modelElement) {\n645:         // TODO: Auto-generated method stub\n646:         LOG.debug(\"generateState(MState modelElement)\");\n647: \n648:         if (!ModelFacade.isAState(modelElement)) {\n649:             throw new ClassCastException(modelElement.getClass()\n650:                     + \" has wrong object type, State required\");\n651:         }\n652: \n653:         return \"generateState(MState modelElement)\";\n654:     }\n655: \n656:     /**\n657:      * Generates transition\n658:      *\n659:      * @param modelElement Model element to generate notation for.\n660:      *\n661:      * @return Generated notation for model element.\n662:      */\n663:     public String generateTransition(Object modelElement) {\n664:         // TODO: Auto-generated method stub\n665:         LOG.debug(\"generateTransition(MTransition modelElement)\");\n666: \n667:         if (!ModelFacade.isATransition(modelElement)) {\n668:             throw new ClassCastException(modelElement.getClass()\n669:                     + \" has wrong object type, Transition required\");\n670:         }\n671: \n672:         return \"generateTransition(MTransition modelElement)\";\n673:     }\n674: \n675:     /**\n676:      * Generates action\n677:      *\n678:      * @param modelElement Model element to generate notation for.\n679:      *\n680:      * @return Generated notation for model element.\n681:      */\n682:     public String generateAction(Object modelElement) {\n683:         // TODO: Auto-generated method stub\n684:         LOG.debug(\"generateAction(Object modelElement)\");\n685: \n686:         if (!ModelFacade.isAAction(modelElement)) {\n687:             throw new ClassCastException(modelE