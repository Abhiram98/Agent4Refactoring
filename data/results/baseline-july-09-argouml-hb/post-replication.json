rt java.beans.VetoableChangeListener;\n32: import java.util.ArrayList;\n33: import java.util.Collection;\n34: import java.util.Hashtable;\n35: import java.util.Iterator;\n36: import java.util.List;\n37: import java.util.Vector;\n38: \n39: import org.apache.log4j.Logger;\n40: import org.argouml.model.ModelFacade;\n41: import org.argouml.model.uml.*;\n42: import org.argouml.uml.diagram.UMLMutableGraphSupport;\n43: import org.argouml.uml.diagram.sequence.ui.FigLink;\n44: import org.argouml.uml.diagram.sequence.ui.FigLinkPort;\n45: import org.argouml.uml.diagram.sequence.ui.FigObject;\n46: import org.argouml.uml.diagram.sequence.ui.FigReturnActionLink;\n47: import org.tigris.gef.base.Editor;\n48: import org.tigris.gef.base.Globals;\n49: import org.tigris.gef.base.Mode;\n50: import org.tigris.gef.base.ModeManager;\n51: import org.tigris.gef.presentation.Fig;\n52: \n53: /** This class defines a bridge between the UML meta-model\n54:  *  representation of the design and the GraphModel interface used by\n55:  *  GEF.  This class handles only UML Sequence Digrams.\n56:  *\n57:  *  @author 5eichler@informatik.uni-hamburg.de\n58:  */\n59: public class SequenceDiagramGraphModel\n60:     extends UMLMutableGraphSupport\n61:     implements VetoableChangeListener {\n62: \n63:     private static final Logger LOG = \n64:         Logger.getLogger(SequenceDiagramGraphModel.class);\n65:     \n66:     private abstract class CanConnectCmd {\n67:         private Object srcPort;\n68:         private Object destPort;\n69:         private Object srcObject;\n70:         private Object destObject;\n71:         private FigObject srcFigObject;\n72:         private FigObject destFigObject;\n73:         private Fig srcFigPort;\n74:         private Fig destFigPort;       \n75: \n76:         public CanConnectCmd(Object fromPort, Object toPort) {\n77:             Editor curEditor = Globals.curEditor();\n78:             srcPort = fromPort;\n79:             destPort = toPort;\n80:             if (srcPort instanceof LinkPort) {\n81:                 srcObject = ((LinkPort) srcPort).getObject();\n82:             } \n83:             if (destPort instanceof LinkPort) {\n84:                 destObject = ((LinkPort) destPort).getObject();\n85:             } \n86: \n87:             srcFigObject =\n88:                 (FigObject) curEditor.getLayerManager().getActiveLayer()\n89: \t\t    .presentationFor(srcObject);\n90:             destFigObject =\n91:                 (FigObject) curEditor.getLayerManager().getActiveLayer()\n92:                     .presentationFor(destObject);\n93:             srcFigPort = srcFigObject.getPortFig(srcPort);\n94:             destFigPort = destFigObject.getPortFig(destPort);            \n95:         }\n96:        \n97:         /**\n98:          * @return the {@link FigObject} of the destination.\n99:          */\n100:         public FigObject getDestFigObject() {\n101:             return destFigObject;\n102:         }\n103: \n104:         /**\n105:          * @return\n106:          */\n107:         public Fig getDestFigPort() {\n108:             return destFigPort;\n109:         }\n110: \n111:         /**\n112:          * @return\n113:          */\n114:         public Object getDestObject() {\n115:             return destObject;\n116:         }\n117: \n118:         /**\n119:          * @return\n120:          */\n121:         public Object getDestPort() {\n122:             return destPort;\n123:         }\n124: \n125:        \n126: \n127:         /**\n128:          * @return the {@link FigObject} of the source.\n129:          */\n130:         public FigObject getSrcFigObject() {\n131:             return srcFigObject;\n132:         }\n133: \n134:         /**\n135:          * @return\n136:          */\n137:         public Fig getSrcFigPort() {\n138:             return srcFigPort;\n139:         }\n140: \n141:         /**\n142:          * @return\n143:          */\n144:         public Object getSrcObject() {\n145:             return srcObject;\n146:         }\n147: \n148:         /**\n149:          * @return\n150:          */\n151:         public Object getSrcPort() {\n152:             return srcPort;\n153:         }\n154: \n155:        \n156: \n157:         /**\n158:          * @param object\n159:          */\n160:         public void setDestFigObject(FigObject object) {\n161:             destFigObject = object;\n162:         }\n163: \n164:         /**\n165:          * @param fig\n166:          */\n167:         public void setDestFigPort(Fig fig) {\n168:             destFigPort = fig;\n169:         }\n170: \n171:         /**\n172:          * @param object\n173:          */\n174:         public void setDestObject(Object object) {\n175:             destObject = object;\n176:         }\n177: \n178:         /**\n179:          * @param object\n180:          */\n181:         public void setDestPort(Object object) {\n182:             destPort = object;\n183:         }\n184:        \n185:         /**\n186:          * @param object\n187:          */\n188:         public void setSrcFigObject(FigObject object) {\n189:             srcFigObject = object;\n190:         }\n191: \n192:         /**\n193:          * @param fig\n194:          */\n195:         public void setSrcFigPort(Fig fig) {\n196:             srcFigPort = fig;\n197:         }\n198: \n199:         /**\n200:          * @param object\n201:          */\n202:         public void setSrcObject(Object object) {\n203:             srcObject = object;\n204:         }\n205: \n206:         /**\n207:          * @param object\n208:          */\n209:         public void setSrcPort(Object object) {\n210:             srcPort = object;\n211:         }\n212: \n213:         /**\n214:          * Checks if a certain combination of ports and edgeclass can\n215:          * be connected.\n216:          */\n217:         public abstract boolean doit();\n218: \n219:     }\n220: \n221:     private class CanConnectCallActionCmd extends CanConnectCmd {\n222: \n223:         public CanConnectCallActionCmd(Object fromPort, Object toPort) {\n224:             super(fromPort, toPort);\n225:         }\n226: \n227:         /**\n228:          * @see SequenceDiagramGraphModel.CanConnectCmd#doit()\n229:          */\n230:         public boolean doit() {\n231:             if (!(this.getDestPort() instanceof LinkPort)\n232:                 || !(getSrcPort() instanceof LinkPort)) {\n233:                 return false;\n234:             }\n235:             if (this.getDestPort() instanceof ActivationNode\n236: \t\t&& !(getDestFigObject().getActivationNodes(\n237: \t\t\t (Node) this.getDestPort()).isEmpty())) {\n238:                 // cannot connect a callaction to a destactivation\n239:                 // that already exists\n240:                 return false;\n241:             }\n242:            //  if (getSrcFigObject().getPreviousActivation((Node)getSrcPort()).)\n243:             if (getSrcPort() instanceof LinkNode\n244: \t\t&& ((LinkNode) getSrcPort()).isDestroyed()) {\n245:                 // cannot connect a callaction to a sourceActivation\n246:                 // that is allready destroyed.\n247:                 return false;\n248:             }\n249:             if (getSrcPort() instanceof LinkNode) {\n250:             \tint index =\n251: \t\t    getSrcFigObject().getIndexOf((LinkNode) getSrcPort());\n252:             \tIterator it =\n253: \t\t    getSrcFigObject().getActivationNodes(\n254: \t\t        (Node) getSrcPort()).iterator();\n255:             \twhile (it.hasNext()) {\n256: \t\t    Node node = (Node) it.next();\n257: \t\t    if (node instanceof LinkPort\n258: \t\t\t&& (getSrcFigObject().getFigLink(\n259: \t\t\t\t((LinkPort) node).getFigLinkPort())\n260: \t\t\t    instanceof FigReturnActionLink)\n261: \t\t\t&& index > getSrcFigObject().getIndexOf(node)) {\n262: \n263: \t\t\t// cannot connect a callaction to a\n264: \t\t\t// sourceActivation that is allready returned.\n265: \t\t\treturn false;\n266: \n267: \t\t    }\n268:             \t}\n269:             }                    \n270:             return true;\n271:         }\n272: \n273:     }\n274: \n275:     private class CanConnectDestroyActionCmd extends CanConnectCmd {\n276: \n277:         public CanConnectDestroyActionCmd(Object fromPort, Object toPort) {\n278:             super(fromPort, toPort);\n279:         }\n280: \n281:         /**\n282:          * @see SequenceDiagramGraphModel.CanConnectCmd#doit()\n283:          */\n284:         public boolean doit() {\n285:             if (!(this.getDestPort() instanceof LinkPort)\n286:                 || !(getSrcPort() instanceof LinkPort)) {\n287:                 return false;\n288:             }\n289:             if (getDestFigObject().getActivationNodes(\n290: \t\t    (Node) this.getDestPort()).isEmpty()) {\n291:                 // there must be a destination activation.\n292:                 return false;\n293:             }\n294:             if (this.getDestPort() instanceof ActivationNode\n295: \t\t&& !((ActivationNode) this.getDestPort()).isEnd()) {\n296:                 // cannot destroy an object in the middle of an activation.\n297:                 return false;\n298:             }          \n299:             return true;\n300: \n301:         }\n302:     }\n303: \n304:     private class CanConnectReturnActionCmd extends CanConnectCmd {\n305: \n306:         public CanConnectReturnActionCmd(Object fromPort, Object toPort) {\n307:             super(fromPort, toPort);\n308:         }\n309: \n310:         /**\n311:          * @see SequenceDiagramGraphModel.CanConnectCmd#doit()\n312:          */\n313:         public boolean doit() {\n314:             if (!(this.getDestPort() instanceof LinkPort)\n315:                 || !(getSrcPort() instanceof LinkPort)) {\n316:                 return false;\n317:             }\n318: \t    if (getDestFigObject().getActivationNodes(\n319: \t\t    (Node) this.getDestPort()).isEmpty()) {\n320: \t\t// there must be a destination activation.\n321: \t\treturn false;\n322: \t    }\n323: \t    if (this.getSrcPort() instanceof ActivationNode\n324: \t\t&& !((ActivationNode) this.getSrcPort()).isEnd()) {\n325: \n326: \t\t// cannot return in the middle of an activation.\n327: \t\treturn false;\n328: \t    } \n329: \t    Node startNode =\n330: \t\t(Node) getSrcFigObject().getActivationNodes(\n331: \t\t    (Node) getSrcPort()).get(0);\n332: \t    if (startNode instanceof LinkPort) {\n333: \t\tLinkPort linkNode = (LinkPort) startNode;\n334: \t\tFigLink figLink =\n335: \t\t    getSrcFigObject().getFigLink(linkNode.getFigLinkPort());\n336: \t\t   \t \n337: \t\tif (!(getDestFigObject().getActivationNodes(\n338: \t\t\t  (Node) ((FigLinkPort) figLink.getSourcePortFig())\n339: \t\t\t             .getOwner())\n340: \t\t      .contains(this.getDestPort()))) {\n341: \t\t    // cannot let a activation return to an activation\n342: \t\t    // that did not start the source activation\n343: \t\t    return false;\n344: \t\t}\n345: \t    } else {\n346: \t\treturn false;\n347: \t    }\t\t\n348:             return true;\n349: \n350:         }\n351:     }\n352: \n353:     private class CanConnectCreateActionCmd extends CanConnectCmd {\n354: \n355:         public CanConnectCreateActionCmd(Object fromPort, Object toPort) {\n356:             super(fromPort, toPort);\n357:         }\n358: \n359:         /**\n360:         * @see SequenceDiagramGraphModel.CanConnectCmd#doit()\n361:         */\n362:         public boolean doit() {\n363:             if (!(ModelFacade.isAObject(this.getDestPort()))\n364:                 || !(getSrcPort() instanceof LinkPort)) {\n365:                 return false;\n366:             }\n367:             return true;\n368:         }\n369:     }\n370: \n371:     ////////////////////////////////////////////////////////////////\n372:     // instance variables\n373: \n374:     /**\n375:      * The collaboration this sequence diagram belongs too.\n376:      */\n377:     private Object collaboration;\n378: \n379:     /**\n380:      * The interaction that is shown on the sequence diagram\n381:      */\n382:     private Object interaction;\n383: \n384:     ////////////////////////////////////////////////////////////////\n385:     // GraphModel implementation\n386: \n387:     /** \n388:      * Return all nodes in the graph.\n389:      * \n390:      * @see org.tigris.gef.graph.GraphModel#getNodes()\n391:      */\n392:     public List getNodes() {\n393:         Vector allNodes = new Vector();\n394:         Collection elements = ModelFacade.getOwnedElements(collaboration);\n395:         Iterator it = elements.iterator();\n396:         Collection classifierRoles = new ArrayList();\n397:         while (it.hasNext()) {\n398:             Object o = it.next();\n399:             if (ModelFacade.isAClassifierRole(o)) {\n400:                 classifierRoles.add(o);\n401:             }\n402:         }\n403:         it = classifierRoles.iterator();\n404:         while (it.hasNext()) {\n405:             Iterator it2 = ModelFacade.getInstances(it.next()).iterator();\n406:             while (it2.hasNext()) {\n407:                 Object instance = it2.next();\n408:                 if (ModelFacade.isAObject(instance)) {\n409:                     allNodes.add(instance);\n410:                 }\n411:             }\n412:         }\n413:         return allNodes;\n414:     }\n415: \n416:     /**\n417:      * Default constructor. Constructs a model and a collaboration in\n418:      * the root of the current project.\n419:      *\n420:      * @param c the collaboration\n421:      */\n422:     public SequenceDiagramGraphModel(Object c) {\n423:         collaboration = c;\n424:         interaction =\n425:             CollaborationsFactory.getFactory().buildInteraction(c);\n426:     }\n427: \n428:     /** \n429:      * Return all edges in the graph.\n430:      * \n431:      * @see org.tigris.gef.graph.GraphModel#getEdges()\n432:      */\n433:     public List getEdges() {\n434:         Vector allEdges = new Vector();\n435:         Iterator it = ModelFacade.getOwnedElements(collaboration).iterator();\n436:         while (it.hasNext()) {\n437:             Object o = it.next();\n438:             if (ModelFacade.isAAssociationRole(o)) {\n439:                 Iterator it2 = ModelFacade.getLinks(o).iterator();\n440:                 while (it2.hasNext()) {\n441:                     Object link = it2.next();\n442:                     if (ModelFacade.isALink(link)) {\n443:                         allEdges.add(link);\n444:                     }\n445:                 }\n446:             }\n447:         }\n448:         return allEdges;\n449:     }\n450: \n451:     /** \n452:      * Return all ports on node or edge.\n453:      * \n454:      * @see org.tigris.gef.graph.GraphModel#getPorts(java.lang.Object)\n455:      */\n456:     public List getPorts(Object nodeOrEdge) {\n457:         Vector ports = new Vector();\n458:         if (ModelFacade.isAObject(nodeOrEdge)) {\n459:             ports.addAll(ModelFacade.getLinkEnds(nodeOrEdge));\n460:         } else if (ModelFacade.isALink(nodeOrEdge)) {\n461:             ports.addAll(ModelFacade.getLinkEnds(nodeOrEdge));\n462:         }\n463:         return ports;\n464:     }\n465: \n466:     /** \n467:      * Return the node or edge that owns the given port.\n468:      * \n469:      * @see org.tigris.gef.graph.BaseGraphModel#getOwner(java.lang.Object)\n470:      */\n471:     public Object getOwner(Object port) {\n472:         Object owner = null;\n473:         if (ModelFacade.isALinkEnd(port)) {\n474:             Iterator it = getNodes().iterator();\n475:             while (it.hasNext()) {\n476:                 Object o = it.next();\n477:                 if (ModelFacade.isAInstance(o)) {\n478:                     Collection linkEnds = ModelFacade.getLinkEnds(o);\n479:                     if (linkEnds.contains(port)) {\n480:                         owner = o;\n481:                         break;\n482:                     }\n483:                 }\n484:             }\n485:         }\n486:         return owner;\n487:     }\n488: \n489:     /** \n490:      * Return all edges going to given port.\n491:      * \n492:      * @see org.tigris.gef.graph.GraphModel#getInEdges(java.lang.Object)\n493:      */\n494:     public List getInEdges(Object port) {\n495:         Vector res = new Vector();\n496:         if (ModelFacade.isAObject(port)) {\n497:             Iterator it = ModelFacade.getLinkEnds(port).iterator();\n498:             while (it.hasNext()) {\n499:                 Object link = ModelFacade.getLink(it.next());\n500:                 Iterator it2 = ModelFacade.getStimuli(link).iterator();\n501:                 while (it2.hasNext()) {\n502:                     Object stimulus = it2.next();\n503:                     Object instance = ModelFacade.getReceiver(stimulus);\n504:                     if (instance == port) {\n505:                         res.add(link);\n506:                     }\n507:                 }\n508:             }\n509:         }\n510:         return res;\n511:     }\n512: \n513:     /** \n514:      * Return all edges going from given port.\n515:      * \n516:      * @see org.tigris.gef.graph.GraphModel#getOutEdges(java.lang.Object)\n517:      */\n518:     public List getOutEdges(Object port) {\n519:         Vector res = new Vector();\n520:         if (ModelFacade.isAObject(port)) {\n521:             Iterator it = ModelFacade.getLinkEnds(port).iterator();\n522:             while (it.hasNext()) {\n523:                 Object link = ModelFacade.getLink(it.next());\n524:                 Iterator it2 = ModelFacade.getStimuli(link).iterator();\n525:                 while (it2.hasNext()) {\n526:                     Object stimulus = it2.next();\n527:                     Object instance = ModelFacade.getSender(stimulus);\n528:                     if (instance == port) {\n529:                         res.add(link);\n530:                     }\n531:                 }\n532:             }\n533:         }\n534:         return res;\n535:     }\n536: \n537:     /** \n538:      * Return one end of an edge.\n539:      * \n540:      * @see org.tigris.gef.graph.BaseGraphModel#getSourcePort(java.lang.Object)\n541:      */\n542:     public Object getSourcePort(Object edge) {\n543:         Object res = null;\n544:         if (ModelFacade.isALink(edge)) {\n545:             res = CommonBehaviorHelper.getHelper().getSource(edge);\n546:         }\n547:         return res;\n548:     }\n549: \n550:     /** \n551:      * Return  the other end of an edge.\n552:      * \n553:      * @see org.tigris.gef.graph.BaseGraphModel#getDestPort(java.lang.Object)\n554:      */\n555:     public Object getDestPort(Object edge) {\n556:         Object res = null;\n557:         if (ModelFacade.isALink(edge)) {\n558:             res = CommonBehaviorHelper.getHelper().getDestination(edge);\n559:         }\n560:         return res;\n561:     }\n562: \n563:     ////////////////////////////////////////////////////////////////\n564:     // MutableGraphModel implementation\n565: \n566:     /** \n567:      * Return true if the given object is a valid node in this graph.\n568:      * \n569:      * @see org.tigris.gef.graph.MutableGraphModel#canAddNode(java.lang.Object)\n570:      */\n571:     public boolean canAddNode(Object node) {\n572:         if (node == null)\n573:             return false;\n574:         if (getNodes().contains(node))\n575:             return false;\n576:         return ModelFacade.isAObject(node);\n577:     }\n578: \n579:     /** \n580:      * Return true if the given object is a valid edge in this graph.\n581:      * \n582:      * @see org.tigris.gef.graph.MutableGraphModel#canAddEdge(java.lang.Object)\n583:      */\n584:     public boolean canAddEdge(Object edge) {\n585:         if (edge == null)\n586:             return false;\n587:         Object end0 = null;\n588:         Object end1 = null;\n589:         if (org.argouml.model.ModelFacade.isALink(edge)) {\n590:             end0 =\n591: \t\tCommonBehaviorHelper.getHelper().getSource(/*(MLink)*/\n592: \t\t\t\t\t\t\t   edge);\n593:             end1 =\n594: \t\tCommonBehaviorHelper.getHelper().getDestination(/*(MLink)*/\n595: \t\t\t\t\t\t\t\tedge);\n596:         }\n597:         if (end0 == null || end1 == null)\n598:             return false;\n599:         if (!getNodes().contains(end0))\n600:             return false;\n601:         if (!getNodes().contains(end1))\n602:             return false;\n603:         if (getEdges().contains(edge))\n604:             return false;\n605:         return true;\n606: \n607:     }\n608: \n609:     /** \n610:      * Add the given node to the graph, if valid.\n611:      * \n612:      * @see org.tigris.gef.graph.MutableGraphModel#addNode(java.lang.Object)\n613:      */\n614:     public void addNode(Object node) {\n615:         if (canAddNode(node)) {\n616:             Object clasrole =\n617:                 CollaborationsFactory.getFactory().buildClassifierRole(\n618:                     collaboration);\n619:             ModelFacade.addInstance(clasrole, node);\n620:             fireNodeAdded(node);\n621:         }\n622: \n623:     }\n624: \n625:     /**\n626:      * Adds an edge to the model if this is allowed. If the edge is a link, \n627:      * an associationrole and a stimulus to accompany this link are build. \n628:      *\n629:      * @see org.tigris.gef.graph.MutableGraphModel#addEdge(java.lang.Object)\n630:      */\n631:     public void addEdge(Object edge) {\n632:         // if (canAddEdge(edge)) {            \n633:         fireEdgeAdded(edge);\n634:         // }\n635:     }\n636: \n637:     /**\n638:      * @see org.tigris.gef.graph.MutableGraphModel#addNodeRelatedEdges(java.lang.Object)\n639:      */\n640:     public void addNodeRelatedEdges(Object node) {\n641:         if (ModelFacade.isAInstance(node)) {\n642:             Collection ends = ModelFacade.getLinkEnds(node);\n643:             Iterator iter = ends.iterator();\n644:             while (iter.hasNext()) {\n645:                 Object /*MLinkEnd*/ le = iter.next();\n646:                 if (canAddEdge(ModelFacade.getLink(le)))\n647:                     addEdge(ModelFacade.getLink(le));\n648:                 return;\n649:             }\n650:         }\n651:     }\n652: \n653:     /** \n654:      * Return true if the two given ports can be connected by a\n655:      * kind of edge to be determined by the ports. \n656:      *\n657:      * @see org.tigris.gef.graph.MutableGraphModel#canConnect(\n658:      * java.lang.Object, java.lang.Object)\n659:      */\n660:     public boolean canConnect(Object fromP, Object toP) {\n661:         Editor curEditor = Globals.curEditor();\n662:         ModeManager modeManager = curEditor.getModeManager();\n663:         Mode mode = (Mode) modeManager.top();\n664:         Hashtable args = mode.getArgs();\n665:         Class actionClass = (Class) args.get(\"action\");\n666:         CanConnectCmd cmd = null;\n667:         if (actionClass == ModelFacade.CALL_ACTION) {\n668:             cmd = new CanConnectCallActionCmd(fromP, toP);\n669:         } else if (actionClass == ModelFacade.RETURN_ACTION) {\n670:             cmd = new CanConnectReturnActionCmd(fromP, toP);\n671:         } else if (actionClass == ModelFacade.CREATE_ACTION) {\n672:             cmd = new CanConnectCreateActionCmd(fromP, toP);\n673:         } else if (actionClass == ModelFacade.DESTROY_ACTION) {\n674:             cmd = new CanConnectDestroyActionCmd(fromP, toP);\n675:         } else {\n676:             // not supported action\n677:             return false;\n678:         }\n679:         return cmd.doit();\n680:     }\n681: \n682:     /**\n683:      * Creates a link based on the given from and toPort. The fromPort\n684:      * should allways point to a LinkCoordinates instance. The toPort\n685:      * can point to a LinkCoordinates instance or to a Object\n686:      * instance. On a sequence diagram you can only draw Links. So\n687:      * other edgeClasses then links are not supported.