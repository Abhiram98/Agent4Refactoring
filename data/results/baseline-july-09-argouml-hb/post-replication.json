  \n228:     public void testValues_Iterator_Remove() {\n229:         System.out.println(\"testValues_Iterator_Remove\");\n230:         \n231:         // What happens when we remove an item from the values that appear more than once?\n232:         Set keySet = linkedHashMap.keySet();\n233:         Set entrySet = linkedHashMap.entrySet();\n234:         Collection valuesCollection = linkedHashMap.values();\n235:         Iterator it = valuesCollection.iterator();\n236:         while (it.hasNext()) {\n237:             Object o = it.next();\n238:             if (value7and8.equals(o)) {\n239:                 it.remove();\n240:                 break;\n241:             }\n242:         }\n243:         \n244:         assertEquals(9, valuesCollection.size());\n245:         assertEquals(9, keySet.size());\n246:         assertEquals(9, entrySet.size());\n247:         \n248:         Object[] keys = {key0, key1, key2, key3, key4, key5, key6, key8, key9};\n249: \n250:         Object[] values = {value0, value1, value2, value3, value4, value5, value6, value7and8, value9};\n251: \n252:         assertIteratorAgainstArray(keySet.iterator(), keys);\n253:         assertIteratorAgainstArray(valuesCollection.iterator(), values);\n254:         assertEntrySetAgainstArrays(entrySet, keys, values);\n255:     }\n256: \n257:     public void testValues_Iterator_Remove2() {\n258:         System.out.println(\"testValues_Iterator_Remove2\");\n259:         \n260:         // What happens when we remove an item from the values that appear more than once\n261:         // removing the first one found?\n262:         Set keySet = linkedHashMap.keySet();\n263:         Set entrySet = linkedHashMap.entrySet();\n264:         Collection valuesCollection = linkedHashMap.values();\n265:         Iterator it = valuesCollection.iterator();\n266:         while (it.hasNext()) {\n267:             Object o = it.next();\n268:             if (value7and8.equals(o)) {\n269:                 it.remove();\n270:                 