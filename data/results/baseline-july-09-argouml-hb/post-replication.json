             AbstractFilePersister persister =\n143:                 (AbstractFilePersister) iter.next();\n144:             if (persister.isFileExtensionApplicable(name)) {\n145:                 return persister;\n146:             }\n147:         }\n148:         return null;\n149:     }\n150: \n151:     /**\n152:      * @param chooser the filechooser of which the filters will be set\n153:      * @param fileName the filename of the file to be saved (optional)\n154:      */\n155:     public void setSaveFileChooserFilters(JFileChooser chooser, \n156:             String fileName) {\n157:         \n158:         chooser.addChoosableFileFilter(defaultPersister);\n159:         AbstractFilePersister defaultFileFilter = defaultPersister;\n160:         \n161:         Iterator iter = otherPersisters.iterator();\n162:         while (iter.hasNext()) {\n163:             AbstractFilePersister fp = (AbstractFilePersister) iter.next();\n164:             if (!fp.equals(xmiPersister) && !fp.equals(xmlPersister)) {\n165:                 chooser.addChoosableFileFilter(fp);\n166:                 if (fileName != null \n167:                         && fp.isFileExtensionApplicable(fileName)) {\n168:                     defaultFileFilter = fp;\n169:                 }\n170:             }\n171:         }\n172:         chooser.setFileFilter(defaultFileFilter);\n173:     }\n174: \n175:     /**\n176:      * @param chooser the filechooser of which the filters will be set\n177:      */\n178:     public void setOpenFileChooserFilter(JFileChooser chooser) {\n179:         MultitypeFileFilter mf = new MultitypeFileFilter();\n180:         mf.add(defaultPersister);\n181:         chooser.addChoosableFileFilter(mf);\n182:         chooser.addChoosableFileFilter(defaultPersister);\n183:         Iterator iter = otherPersisters.iterator();\n184:         while (iter.hasNext()) {\n185:             AbstractFilePersister ff = (AbstractFilePersister) iter.next();\n186:             mf.add(ff);\n187:             chooser.addChoosableFileFilter(ff);\n188:         }\n189:         chooser.setFileFilter(mf);\n190:     }\n191: \n192:     /**\n193:      * @param chooser the filechooser of which the filters will be set\n194:      */\n195:     public void setXmiFileChooserFilter(JFileChooser chooser) {\n196:         chooser.addChoosableFileFilter(xmiPersister);\n197:         chooser.setFileFilter(xmiPersister);\n198:     }\n199: \n200:     /**\n201:      * @return the extension of the default persister\n202:      *         (just the text, not the \".\")\n203:      */\n204:     public String getDefaultExtension() {\n205:         return defaultPersister.getExtension();\n206:     }\n207: \n208:     /**\n209:      * @return the extension of the xmi persister\n210:      *         (just the text, not the \".\")\n211:      */\n212:     public String getXmiExtension() {\n213:         return xmiPersister.getExtension();\n214:     }\n215: \n216:     /**\n217:      * @param in the input file or path name which may or may not\n218:      *           have a recognised extension\n219:      * @return the amended file or pathname, guaranteed to have\n220:      *         a recognised extension\n221:      */\n222:     public String fixExtension(String in) {\n223:         if (getPersisterFromFileName(in) == null) {\n224:             in += \".\" + getDefaultExtension();\n225:         }\n226:         return in;\n227:     }\n228: \n229:     /**\n230:      * @param in the input file or path name which may or may not\n231:      *           have a \"xmi\" extension\n232:      * @return the amended file or pathname, guaranteed to have\n233:      *         a \"xmi\" extension\n234:      */\n235:     public String fixXmiExtension(String in) {\n236:         if (getPersisterFromFileName(in) != xmiPersister) {\n237:             in += \".\" + getXmiExtension();\n238:         }\n239:         return in;\n240:     }\n241: \n242: \n243:     /**\n244:      * @param in the input url which may or may not have a recognised extension\n245:      * @return the url with default extension added,\n246:      *         if it did not have a valid extension yet\n247:      */\n248:     public URL fixUrlExtension(URL in) {\n249:         URL newUrl;\n250:         String n = in.toString();\n251:         n = fixExtension(n);\n252:         try {\n253:             newUrl = new URL(n);\n254:         } catch (java.net.MalformedURLException e) {\n255:             throw new UnexpectedException(e);\n256:         }\n257:         return newUrl;\n258:     }\n259: \n260:     /**\n261:      * Find the base name of the given filename.<p>\n262:      *\n263:      * This is the name minus any valid file extension.\n264:      * Invalid extensions are left alone.\n265:      *\n266:      * @param n the given file name\n267:      * @return the name (a String) without extension\n268:      */\n269:     public String getBaseName(String n) {\n270:         AbstractFilePersister p = getPersisterFromFileName(n);\n271:         if (p == null) {\n272:             return n;\n273:         }\n274:         int extLength = p.getExtension().length() + 1;\n275:         return n.substring(0, n.length() - extLength);\n276:     }\n277: \n278:     /**\n279:      * Generates a String dump of the current model for quick viewing.\n280:      *\n281:      * @param project The project to generate.\n282:      * @return The whole model in a String.\n283:      */\n284:     public String getQuickViewDump(Project project) {\n285:         OutputStream stream = new ByteArrayOutputStream();\n286:         try {\n287:             quickViewDump.writeProject(project, stream, null);\n288:         } catch (Exception e) {\n289:             // If anything goes wrong return the stack\n290:             // trace as a string so that we get some\n291:             // useful feedback.\n292:             e.printStackTrace(new PrintStream(stream));\n293:         }\n294:         return stream.toString();\n295:     }\n296: \n297:     /**\n298:      * Get the file persister for