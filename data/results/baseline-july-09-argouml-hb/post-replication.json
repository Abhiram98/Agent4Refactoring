                    "kwargs": {
                        "content": "Here is the source code to modify: \nsrc/uci/gef/ModeCreateEdge.java: \n1: // Copyright (c) 1996-98 The Regents of the University of California. All\n2: // Rights Reserved. Permission to use, copy, modify, and distribute this\n3: // software and its documentation for educational, research and non-profit\n4: // purposes, without fee, and without a written agreement is hereby granted,\n5: // provided that the above copyright notice and this paragraph appear in all\n6: // copies. Permission to incorporate this software into commercial products\n7: // must be negotiated with University of California. This software program and\n8: // documentation are copyrighted by The Regents of the University of\n9: // California. The software program and documentation are supplied \"as is\",\n10: // without any accompanying services from The Regents. The Regents do not\n11: // warrant that the operation of the program will be uninterrupted or\n12: // error-free. The end-user understands that the program was developed for\n13: // research purposes and is advised not to rely exclusively on the program for\n14: // any reason. IN NO EVENT SHALL THE UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY\n15: // PARTY FOR DIRECT, INDIRECT, SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES,\n16: // INCLUDING LOST PROFITS, ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS\n17: // DOCUMENTATION, EVEN IF THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE\n18: // POSSIBILITY OF SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY\n19: // DISCLAIMS ANY WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n20: // WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE\n21: // SOFTWARE PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT, UPDATES,\n23: // ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: \n26: \n27: // File: ModeCreateEdge.java\n28: // Classes: ModeCreateEdge\n29: // Original Author: ics125 spring 1996\n30: // $Id$\n31: \n32: package uci.gef;\n33: \n34: import java.awt.*;\n35: import java.awt.event.MouseEvent;\n36: \n37: import uci.graph.*;\n38: \n39: /** A Mode to interpret user input while creating an edge.  Basically\n40:  *  mouse down starts creating an edge from a source port Fig, mouse\n41:  *  motion paints a rubberband line, mouse up finds the destination port\n42:  *  and finishes creating the edge and makes an FigEdge and sends\n43:  *  it to the back of the Layer.\n44:  *\n45:  *  The argument \"edgeClass\" determines the type if edge to suggest\n46:  *  that the Editor's GraphModel construct.  The GraphModel is\n47:  *  responsible for acutally making an edge in the underlying model\n48:  *  and connecting it to other model elements. */\n49: \n50: public class ModeCreateEdge extends ModeCreate {\n51:   ////////////////////////////////////////////////////////////////\n52:   // instance variables\n53: \n54:   /** The NetPort where the arc is paintn from */\n55:   private Object _startPort;\n56: \n57:   /** The Fig that presents the starting NetPort */\n58:   private Fig _startPortFig;\n59: \n60:   /** The FigNode on the NetNode that owns the start port */\n61:   private FigNode _sourceFigNode;\n62: \n63:   /** The new NetEdge that is being created */\n64:   private Object _newEdge;\n65: \n66:   ////////////////////////////////////////////////////////////////\n67:   // constructor\n68: \n69:   public ModeCreateEdge() { super(); }\n70:   public ModeCreateEdge(Editor par) { super(par); }\n71: \n72:   ////////////////////////////////////////////////////////////////\n73:   // Mode API\n74: \n75:   public String instructions() {\n76:     return \"Drag to define an edge to another port\";\n77:   }\n78: \n79:   ////////////////////////////////////////////////////////////////\n80:   // ModeCreate API\n81: \n82:   /** Create the new item that will be drawn. In this case I would\n83:    *  rather create the FigEdge when I am done. Here I just\n84:    *  create a rubberband FigLine to show during dragging. */\n85:   public Fig createNewItem(MouseEvent me, int snapX, int snapY) {\n86:     return new FigLine(snapX, snapY, 0, 0,\n87: \t\t       Globals.getPrefs().getRubberbandColor());\n88:   }\n89: \n90:   ////////////////////////////////////////////////////////////////\n91:   // event handlers\n92: \n93:   /** On mousePressed determine what port the user is dragging from.\n94:    *  The mousePressed event is sent via ModeSelect. */\n95:   public void mousePressed(MouseEvent me) {\n96:     int x = me.getX(), y = me.getY();\n97:     Editor ce = Globals.curEditor();\n98:     Fig underMouse = ce.hit(x, y);\n99:     if (underMouse == null) { \n100:       //System.out.println(\"bighit\");\n101:         underMouse = ce.hit(x-16, y-16, 32, 32);\n102:     }\n103:     if (underMouse == null) { done(); me.consume(); return; }\n104:     if (!(underMouse instanceof FigNode)) { done(); me.consume(); return; }\n105:     _sourceFigNode = (FigNode) underMouse;\n106:     _startPort = _sourceFigNode.deepHitPort(x, y);\n107:     if (_startPort == null) { done(); me.consume(); return; }\n108:     _startPortFig = _sourceFigNode.getPortFig(_startPort);\n109:     super.mousePressed(me);\n110:   }\n111: \n112:   /** On mouseReleased, find the destination port, ask the GraphModel\n113:    *  to connect the two ports.  If that connection is allowed, then\n114:    *  construct a new FigEdge and add it to the Layer and send it to\n115:    *  the back. */\n116:   public void mouseReleased(MouseEvent me) {\n117:     if (_sourceFigNode == null) { done(); me.consume(); return; }\n118: \n119:     int x = me.getX(), y = me.getY();\n120:     Class arcClass;\n121:     Editor ce = Globals.curEditor();\n122:     Fig f = ce.hit(x, y);\n123:     if (f == null) { f = ce.hit(x-16, y-16, 32, 32); }\n124:     GraphModel gm = ce.getGraphModel();\n125:     if (!(gm instanceof MutableGraphModel)) f = null;\n126:     MutableGraphModel mgm = (MutableGraphModel) gm;\n127:     // needs-more-work: potential class cast exception\n128: \n129:     if (f instanceof FigNode) {\n130:       FigNode destFigNode = (FigNode) f;\n131:       // If its a FigNode, then check within the  \n132:       // FigNode to see if a port exists \n133:       Object foundPort = destFigNode.deepHitPort(x, y);\n134: \n135:       if (foundPort != null && foundPort != _startPort) {\n136: \tFig destPortFig = destFigNode.getPortFig(foundPort);\n137: \tClass edgeClass = (Class) getArg(\"edgeClass\");\n138: \tif (edgeClass != null)\n139: \t  _newEdge = mgm.connect(_startPort, foundPort, edgeClass);\n140: \telse\n141: \t  _newEdge = mgm.connect(_startPort, foundPort);\n142: \n143: \t// Calling connect() will add the edge to the GraphModel and\n144: \t// any LayerPersectives on that GraphModel will get a\n145: \t// edgeAdded event and will add an appropriate FigEdge\n146: \t// (determined by the GraphEdgeRenderer).\n147: \n148: \tif (null != _newEdge) {\n149: \t  LayerManager lm = ce.getLayerManager();\n150: \t  ce.damaged(_newItem);\n151: \t  _sourceFigNode.damage();\n152: \t  destFigNode.damage();\n153: \t  _newItem = null;\n154: \n155: \t  Fig pers = ce.getLayerManager().getActiveLayer().\n156: \t    presentationFor(_newEdge);\n157: \t  if (pers != null) ce.getSelectionManager().select(pers);\n158: \t  done();\n159: \t  me.consume();\n160: \t  return;\n161: \t}\n162: \telse\n163: \t  System.out.println(\"connection return null\");\n164:       }\n165:     }\n166:     _sourceFigNode.damage();\n167:     ce.damaged(_newItem);\n168:     _newItem = null;\n169:     done();\n170:     me.consume();\n171:   }\n172: \n173: } /* end class ModeCreateEdge */\n174: ",
