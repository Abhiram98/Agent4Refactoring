ee() {\n474:         ToDoPerspective tm = (ToDoPerspective) _combo.getSelectedItem();\n475:         _curPerspective = tm;\n476:         if (_curPerspective == null) {\n477: \t    _tree.setVisible(false);\n478: \t} else {\n479:             LOG.debug(\"ToDoPane setting tree model\");\n480:             _curPerspective.setRoot(_root);\n481:             _curPerspective.setFlat(_flat);\n482:             if (_flat) {\n483: \t\t_tree.setShowsRootHandles(false);\n484: \t    } else {\n485: \t\t_tree.setShowsRootHandles(true);\n486: \t    }\n487:             _tree.setModel(_curPerspective);\n488:             _tree.setVisible(true); // blinks?\n489:         }\n490:     }\n491:     \n492:     /**\n493:      * @see org.argouml.application.api.QuadrantPanel#getQuadrant()\n494:      */\n495:     public int getQuadrant() { return Q_BOTTOM_LEFT; }\n496:     \n497:     \n498:     /** called when the user clicks once on an item in the tree.\n499:      *\n500:      * TODO: what should the difference be between a single\n501:      * and double click?\n502:      */\n503:     public static void mySingleClick(int row, TreePath path) {\n504:         _clicksInToDoPane++;\n505:         /*\n506: \t  if (getSelectedObject() == null){return;}\n507: \t  Object sel = getSelectedObject();\n508: \t  if (sel instanceof ToDoItem){\n509: \t  selectItem((ToDoItem)sel);}\n510: \t  cat.debug(\"1: \" + getSelectedObject().toString());\n511:         */\n512:     }\n513:     \n514:     /**\n515:      * Called when the user clicks once on an item in the tree.\n516:      * myDoubleClick will invoke the action() on the ToDoItem.\n517:      */\n518:     public void myDoubleClick(int row, TreePath path) {\n519:         _dblClicksInToDoPane++;\n520:         if (getSelectedObject() == null) {\n521: \t    return;\n522: \t}\n523:         Object sel = getSelectedObject();\n524:         if (sel instanceof ToDoItem) {\n525:             ((ToDoItem) sel).action();\n526:         }\n527:         \n528:         //TODO: should