tyDiagramSerial = 1;\n85: \n86:     /**\n87:      * Constructor\n88:      */\n89:     public UMLActivityDiagram() {\n90: \n91:         try {\n92:             setName(getNewDiagramName());\n93:         } catch (PropertyVetoException pve) { }\n94: \n95:         actionState = new RadioAction(\n96:                 new CmdCreateNode(ModelFacade.ACTION_STATE, \"ActionState\"));\n97:         \n98: \t// start state, end state, forks, joins, etc.\n99: \tactionStartPseudoState =  new RadioAction(\n100: \t    new ActionCreatePseudostate(ModelFacade.INITIAL_PSEUDOSTATEKIND, \n101: \t\t\t\t\t\"Initial\"));\n102: \n103: \tactionFinalPseudoState = new RadioAction(\n104:             new CmdCreateNode(ModelFacade.FINALSTATE, \n105:                                         \"FinalState\"));\n106: \n107: \tactionJunctionPseudoState = new RadioAction(\n108: \t    new ActionCreatePseudostate(ModelFacade.JUNCTION_PSEUDOSTATEKIND,\n109: \t\t\t\t\t\"Junction\"));\n110: \n111: \tactionForkPseudoState = new RadioAction(\n112: \t    new ActionCreatePseudostate(ModelFacade.FORK_PSEUDOSTATEKIND, \n113: \t\t\t\t\t\"Fork\"));\n114: \n115: \tactionJoinPseudoState = new RadioAction(\n116: \t    new ActionCreatePseudostate(ModelFacade.JOIN_PSEUDOSTATEKIND,\n117: \t\t\t\t\t\"Join\"));\n118: \n119: \tactionTransition = new RadioAction(\n120:             new CmdSetMode(\n121:                     ModeCreatePolyEdge.class,\n122:                     \"edgeClass\",\n123:                     ModelFacade.TRANSITION,\n124:                     \"Transition\"));\n125: \n126: \n127: \t// actionNewSwimlane = new CmdCreateNode(ModelFacade.PARTITION, \n128: \t// \"Create a new swimlane\");\n129: \n130:         actionCallState = new RadioAction(\n131:             new CmdCreateNode(ModelFacade.CALLSTATE, \"CallState\"));\n132: \n133:         actionObjectFlowState = new RadioAction(\n134:             new CmdCreateNode(ModelFacade.OBJECTFLOWSTATE, \"ObjectFlowState\"));\n135: \n136:         actionSubactivityState = new 