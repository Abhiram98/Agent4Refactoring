                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/diagram/activity/ui/UMLActivityDiagram.java: \n1: // $Id$\n2: // Copyright (c) 1996-2005 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.uml.diagram.activity.ui;\n26: \n27: import java.beans.PropertyVetoException;\n28: \n29: import javax.swing.Action;\n30: \n31: import org.argouml.i18n.Translator;\n32: import org.argouml.kernel.ProjectManager;\n33: import org.argouml.model.Model;\n34: import org.argouml.ui.CmdCreateNode;\n35: import org.argouml.ui.CmdSetMode;\n36: import org.argouml.uml.diagram.activity.ActivityDiagramGraphModel;\n37: import org.argouml.uml.diagram.state.ui.ActionCreatePseudostate;\n38: import org.argouml.uml.diagram.ui.RadioAction;\n39: import org.argouml.uml.diagram.ui.UMLDiagram;\n40: import org.tigris.gef.base.LayerPerspective;\n41: import org.tigris.gef.base.LayerPerspectiveMutable;\n42: import org.tigris.gef.base.ModeCreatePolyEdge;\n43: \n44: /**\n45:  * The Activity diagram.<p>\n46:  *\n47:  * TODO: Finish the work on swimlanes, callstates, subactivity states.\n48:  */\n49: public class UMLActivityDiagram extends UMLDiagram {\n50:     private Action actionState;\n51:     private Action actionStartPseudoState;\n52:     private Action actionFinalPseudoState;\n53:     private Action actionJunctionPseudoState;\n54:     private Action actionForkPseudoState;\n55:     private Action actionJoinPseudoState;\n56:     private Action actionTransition;\n57:     private Action actionObjectFlowState;\n58:     private Action actionNewSwimlane; //MVW\n59:     private Action actionCallState;\n60:     private Action actionSubactivityState;\n61: \n62:     /**\n63:      * Constructor.\n64:      */\n65:     public UMLActivityDiagram() {\n66:         try {\n67:             setName(getNewDiagramName());\n68:         } catch (PropertyVetoException pve) { }\n69:     }\n70: \n71:     /**\n72:      * Constructor.\n73:      *\n74:      * @param namespace the namespace for the diagram\n75:      * @param agraph the ActivityGraph for the diagram\n76:      */\n77:     public UMLActivityDiagram(Object namespace, Object agraph) {\n78: \n79:         this();\n80: \n81:         if (!Model.getFacade().isANamespace(namespace)\n82:             || !Model.getFacade().isAActivityGraph(agraph)) {\n83:             throw new IllegalArgumentException();\n84:         }\n85: \n86:         if (namespace != null && Model.getFacade().getName(namespace) != null) {\n87:             if (Model.getFacade().getName(namespace).trim() != \"\") {\n88:                 String name =\n89:                     Model.getFacade().getName(namespace)\n90:                     + \" activity \"\n91:                     + (Model.getFacade().getBehaviors(namespace).size());\n92:                 try {\n93:                     setName(name);\n94:                 } catch (PropertyVetoException pve) { }\n95:             }\n96:         }\n97:         if (namespace != null) {\n98:             setup(namespace, agraph);\n99:         } else {\n100:             throw new NullPointerException(\"Namespace may not be null\");\n101:         }\n102:     }\n103: \n104:     /**\n105:      * @see org.tigris.gef.base.Diagram#initialize(java.lang.Object)\n106:      */\n107:     public void initialize(Object o) {\n108:         if (!(Model.getFacade().isAActivityGraph(o))) {\n109:             return;\n110:         }\n111:         Object context = Model.getFacade().getContext(o);\n112:         if (context != null) {\n113:             if (Model.getFacade().isABehavioralFeature(context)) {\n114:                 setup(Model.getFacade().getNamespace(\n115:                                 Model.getFacade().getOwner(context)), o);\n116:             } else {\n117:                 setup(context, o);\n118:             }\n119:         } else {\n120:             throw new IllegalStateException(\"Cannot find context namespace \"\n121:                         + \"while initializing \"\n122:                         + \"activity diagram\");\n123:         }\n124:     }\n125: \n126:     /**\n127:      * Method to perform a number of important initializations of an\n128:      * <em>Activity Diagram</em>.<p>\n129:      *\n130:      * Each diagram type has a similar <em>UMLxxxDiagram</em> class.<p>\n131:      *\n132:      * Changed <em>lay</em> from <em>LayerPerspective</em> to\n133:      * <em>LayerPerspectiveMutable</em>.  This class is a child of\n134:      * <em>LayerPerspective</em> and was implemented to correct some\n135:      * difficulties in changing the model. <em>lay</em> is used mainly\n136:      * in <em>LayerManager</em>(GEF) to control the adding, changing and\n137:      * deleting layers on the diagram...  psager@tigris.org Jan. 24,\n138:      * 2002\n139: \n140:      * @param m  Namespace from the model\n141:      * @param agraph ActivityGraph from the model\n142:      */\n143:     public void setup(Object m, Object agraph) {\n144: \n145:         if (!Model.getFacade().isANamespace(m)\n146:             || !Model.getFacade().isAActivityGraph(agraph)) {\n147:             throw new IllegalArgumentException();\n148:         }\n149: \n150:         super.setNamespace(m);\n151:         ActivityDiagramGraphModel gm = new ActivityDiagramGraphModel();\n152: //        setGraphModel(gm); //MVW\n153:         gm.setHomeModel(m);\n154:         if (agraph != null) {\n155:             gm.setMachine(agraph);\n156: //            setStateMachine(agraph); // MVW\n157:         }\n158:         LayerPerspective lay =\n159:             new LayerPerspectiveMutable(Model.getFacade().getName(m), gm);\n160:         ActivityDiagramRenderer rend = new ActivityDiagramRenderer();\n161:         lay.setGraphNodeRenderer(rend);\n162:         lay.setGraphEdgeRenderer(rend);\n163: \n164:         setLayer(lay);\n165: \n166:     }\n167: \n168:     /**\n169:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getOwner()\n170:      */\n171:     public Object getOwner() {\n172:         ActivityDiagramGraphModel gm =\n173:             (ActivityDiagramGraphModel) getGraphModel();\n174:         return gm.getMachine();\n175:     }\n176: \n177:     /**\n178:      * @return the statemachine\n179:      */\n180:     public Object getStateMachine() {\n181:         return ((ActivityDiagramGraphModel) getGraphModel()).getMachine();\n182:     }\n183: \n184:     /**\n185:      * @param sm set the statemachine for this diagram\n186:      */\n187:     public void setStateMachine(Object sm) {\n188: \n189:         if (!Model.getFacade().isAStateMachine(sm)) {\n190:             throw new IllegalArgumentException();\n191:         }\n192: \n193:         ((ActivityDiagramGraphModel) getGraphModel()).setMachine(sm);\n194:     }\n195: \n196:     /**\n197:      * Get the actions from which to create a toolbar or equivalent\n198:      * graphic triggers.\n199:      *\n200:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getUmlActions()\n201:      */\n202:     protected Object[] getUmlActions() {\n203:         Object[] actions =\n204:         {\n205:             getActionState(),\n206:             getActionTransition(),\n207: \t    null,\n208: \t    getActionStartPseudoState(),\n209: \t    getActionFinalPseudoState(),\n210: \t    getActionJunctionPseudoState(),\n211: \t    getActionForkPseudoState(),\n212: \t    getActionJoinPseudoState(),\n213: \t    //getActionNewSwimlane(),\n214: \t    null,\n215: \t    /*getActionCallState(),*/ // uncomment these ...\n216:             getActionObjectFlowState(),\n217:             /*getActionSubactivityState()*/\n218: \t};\n219:         return actions;\n220:     }\n221: \n222:     /**\n223:      * Creates a new diagram name.<p>\n224:      *\n225:      * @return String\n226:      */\n227:     protected String getNewDiagramName() {\n228:         String name = getLabelName() + \" \" + getNextDiagramSerial();\n229:         if (!ProjectManager.getManager().getCurrentProject()\n230:                  .isValidDiagramName(name)) {\n231:             name = getNewDiagramName();\n232:         }\n233:         return name;\n234:     }\n235: \n236:     /**\n237:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getLabelName()\n238:      */\n239:     public String getLabelName() {\n240:         return Translator.localize(\"label.activity-diagram\");\n241:     }\n242: \n243:     /**\n244:      * @return Returns the actionCallState.\n245:      */\n246:     protected Action getActio