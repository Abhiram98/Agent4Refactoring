   }\n85: \n86:     ////////////////////////////////////////////////////////////////\n87:     // accessors\n88: \n89:     public void setTarget(Object t) {\n90:         _parseChanges = false;\n91:         _target = t;\n92:         if (t == null) {\n93:             _text.setEnabled(false);\n94:             _text.setText(\"Nothing selected\");\n95:             _shouldBeEnabled = false;\n96:         } else {\n97:             _text.setEnabled(true);\n98:             String generatedText = genText(t);\n99:             if (generatedText != null) {\n100:                 _text.setText(generatedText);\n101:                 _shouldBeEnabled = true;\n102:                 _text.setCaretPosition(0);\n103:             } else {\n104:                 _text.setEnabled(false);\n105:                 _text.setText(\"N/A\");\n106:                 _shouldBeEnabled = false;\n107:             }\n108:         }\n109:         _parseChanges = true;\n110:     }\n111: \n112:     /**\n113:      * Returns the target of this tab.\n114:      */\n115:     public Object getTarget() {\n116:         return _target;\n117:     }\n118: \n119:     public void refresh() {\n120:         Object target = TargetManager.getInstance().getTarget();\n121:         setTarget(target);\n122:     }\n123: \n124:     /**\n125:      * the target must not be null.\n126:      */\n127:     public boolean shouldBeEnabled(Object target) {\n128:         return (target != null);\n129:     }\n130: \n131:     protected String genText(Object target) {\n132:         return target == null ? \"Nothing selected\" : target.toString();\n133:     }\n134: \n135:     protected void parseText(String s) {\n136:         if (s == null)\n137:             s = \"(null)\";\n138:         cat.debug(\"parsing text:\" + s); // THN\n139:     }\n140: \n141:     ////////////////////////////////////////////////////////////////\n142:     // event handlers\n143:     public void insertUpdate(DocumentEvent e) {\n144:         if (_parseChanges)\n145:            