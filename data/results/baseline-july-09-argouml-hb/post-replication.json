                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/diagram/state/StateDiagramGraphModel.java: \n1: // $Id$\n2: // Copyright (c) 1996-2006 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies. This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason. IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.uml.diagram.state;\n26: \n27: import java.beans.PropertyChangeEvent;\n28: import java.beans.VetoableChangeListener;\n29: import java.util.ArrayList;\n30: import java.util.Collection;\n31: import java.util.Collections;\n32: import java.util.Iterator;\n33: import java.util.List;\n34: \n35: import org.apache.log4j.Logger;\n36: import org.argouml.kernel.ProjectManager;\n37: import org.argouml.model.Model;\n38: import org.argouml.uml.diagram.UMLMutableGraphSupport;\n39: import org.argouml.uml.diagram.static_structure.ui.CommentEdge;\n40: import org.tigris.gef.presentation.Fig;\n41: \n42: /**\n43:  * This class defines a bridge between the UML meta-model representation of the\n44:  * design and the GraphModel interface used by GEF. This class handles UML\n45:  * Statemachine Diagrams, and is also used for Activity diagrams.\n46:  */\n47: public class StateDiagramGraphModel extends UMLMutableGraphSupport implements\n48:         VetoableChangeListener {\n49: \n50:     /**\n51:      * Logger.\n52:      */\n53:     private static final Logger LOG =\n54:         Logger.getLogger(StateDiagramGraphModel.class);\n55: \n56: \n57:     /**\n58:      * The statemachine we are diagramming.\n59:      */\n60:     private Object machine;\n61: \n62:     ////////////////////////////////////////////////////////////////\n63:     // accessors\n64: \n65:     /**\n66:      * @return the statemachine of this diagram\n67:      */\n68:     public Object getMachine() {\n69:         return machine;\n70:     }\n71: \n72:     /**\n73:      * @param sm   the statemachine of this diagram\n74:      */\n75:     public void setMachine(Object sm) {\n76: \n77:         if (!Model.getFacade().isAStateMachine(sm)) {\n78:             throw new IllegalArgumentException();\n79:         }\n80: \n81:         if (sm != null) {\n82:             machine = sm;\n83:         }\n84:     }\n85: \n86:     ////////////////////////////////////////////////////////////////\n87:     // GraphModel implementation\n88: \n89:     /**\n90:      * Return all ports on node or edge.\n91:      *\n92:      * @return The ports.\n93:      * @param nodeOrEdge The node or the edge.\n94:      */\n95:     public List getPorts(Object nodeOrEdge) {\n96:         List res = new ArrayList();\n97:         if (Model.getFacade().isAState(nodeOrEdge)) {\n98: \t    res.add(nodeOrEdge);\n99: \t}\n100:         if (Model.getFacade().isAPseudostate(nodeOrEdge)) {\n101: \t    res.add(nodeOrEdge);\n102: \t}\n103:         return res;\n104:     }\n105: \n106:     /**\n107:      * Return the node or edge that owns the given port.\n108:      *\n109:      * @param port the port\n110:      * @return The owner of the port.\n111:      * @see org.tigris.gef.graph.BaseGraphModel#getOwner(java.lang.Object)\n112:      */\n113:     public Object getOwner(Object port) {\n114:         return port;\n115:     }\n116: \n117:     /**\n118:      * Return all edges going to given port.\n119:      *\n120:      * @see org.tigris.gef.graph.GraphModel#getInEdges(java.lang.Object)\n121:      */\n122:     public List getInEdges(Object port) {\n123:         if (Model.getFacade().isAStateVertex(port)) {\n124: \t    return new ArrayList(Model.getFacade().getIncomings(port));\n125: \t}\n126:         LOG.debug(\"TODO: getInEdges of MState\");\n127:         return Collections.EMPTY_LIST;\n128:     }\n129: \n130:     /**\n131:      * Return all edges going from given port.\n132:      *\n133:      * @see org.tigris.gef.graph.GraphModel#getOutEdges(java.lang.Object)\n134:      */\n135:     public List getOutEdges(Object port) {\n136:         if (Model.getFacade().isAStateVertex(port)) {\n137: \t    return new ArrayList(Model.getFacade().getOutgoings(port));\n138: \t}\n139:         LOG.debug(\"TODO: getOutEdges of MState\");\n140:         return Collections.EMPTY_LIST;\n141:     }\n142: \n143:     ////////////////////////////////////////////////////////////////\n144:     // MutableGraphModel implementation\n145: \n146:     /**\n147:      * Return true if the given object is a valid node in this graph.\n148:      *\n149:      * @see org.tigris.gef.graph.MutableGraphModel#canAddNode(java.lang.Object)\n150:      */\n151:     public boolean canAddNode(Object node) {\n152:         if (node == null) {\n153:             return false;\n154:         }\n155:         if (containsNode(node)) {\n156:             return false;\n157:         }\n158: \n159:         /* The next solves issue 3665:\n160:          * Do not allow to add an element to a statemachine that is contained\n161:          * by another statemachine then the one represented by this diagram.\n162:          */\n163:         Object nodeMachine =\n164:             Model.getStateMachinesHelper().getStateMachine(node);\n165:         if (nodeMachine != null) {\n166:             if (nodeMachine != getMachine()) {\n167:                 return false;\n168:             }\n169:         }\n170: \n171:         return (Model.getFacade().isAStateVertex(node)\n172:                 || Model.getFacade().isAPartition(node)\n173:                 || Model.getFacade().isAComment(node));\n174:     }\n175: \n176:     /**\n177:      * Return true if the given object is a valid edge in this graph.\n178:      *\n179:      * @see org.tigris.gef.graph.MutableGraphModel#canAddEdge(java.lang.Object)\n180:      */\n181:     public boolean canAddEdge(Object edge) {\n182:         if (super.canAddEdge(edge)) {\n183:             return true;\n184:         }\n185:         if (edge == null) {\n186:             return false;\n187:         }\n188:         if (containsEdge(edge)) {\n189:             return false;\n190:         }\n191:         \n192:         Object end0 = null;\n193:         Object end1 = null;\n194: \n195:         if (Model.getFacade().isATransition(edge)) {\n196:             end0 = Model.getFacade().getSource(edge);\n197:             end1 = Model.getFacade().getTarget(edge);\n198:             // it's not allowed to directly draw a transition\n199:             // from a composite state to one of it's substates.\n200:             if (Model.getFacade().isACompositeState(end0)\n201:                     && Model.getStateMachinesHelper().getAllSubStates(end0)\n202:                                                         .contains(end1)) {\n203:                 return false;\n204:             }\n205:         } else if (edge instanceof CommentEdge) {\n206:             end0 = ((CommentEdge) edge).getSource();\n207:             end1 = ((CommentEdge) edge).getDestination();\n208:         } else {\n209:             return false;\n210:         }\n211: \n212:         // Both ends must be defined and nodes that are on the graph already.\n213:         if (end0 == null || end1 == null) {\n214:             LOG.error(\"Edge rejected. Its ends are not attached to anything\");\n215:             return false;\n216:         }\n217: \n218:         if (!containsNode(end0)\n219:                 && !containsEdge(end0)) {\n220:             LOG.error(\"Edge rejected. Its source end is attached to \"\n221:                     + end0\n222:                     + \" but this is not in the graph model\");\n223:             return false;\n224:         }\n225:         if (!containsNode(end1)\n226:                 && !containsEdge(end1)) {\n227:             LOG.error(\"Edge rejected. Its destination end is attached to \"\n228:                     + end1\n229:                     + \" but this is not in the graph model\");\n230:             return false;\n231:         }\n232: \n233:         return true;\n234:     }\n235: \n236:     /**\n237:      * Add the given node to the graph, if valid.\n238:      *\n239:      * @see org.tigris.gef.graph.MutableGraphModel#addNode(java.lang.Object)\n240:      */\n241:     public void addNode(Object node) {\n242:         LOG.debug(\"adding statechart/activity diagram node: \" + node);\n243:         if (!canAddNode(node)) {\n244:             return;\n245:         }\n246:         if (containsNode(node)) {\n247:             return;\n248:         }\n249: \n250:         getNodes().add(node);\n251: \n252:         if (Model.getFacade().isAStateVertex(node)) {\n253:             Object top = Model.getStateMachinesHelper().getTop(getMachine());\n254:             Model.getStateMachinesHelper().addSubvertex(top, node);\n255:         }\n256: \n257:         fireNodeAdded(node);\n258:     }\n259: \n260:     /**\n261:      * Add the given edge to the graph, if valid.\n262:      *\n263:      * @see org.tigris.gef.graph.MutableGraphModel#addEdge(java.lang.Object)\n264:      */\n265:     public void addEdge(Object edge) {\n266:         LOG.debug(\"adding statechart/activity diagram edge!!!!!!\");\n267: \n268:         if (!canAddEdge(edge)) {\n269:             return;\n270:         }\n271:         getEdges().add(edge);\n272:         fireEdgeAdded(edge);\n273:     }\n274: \n275:     /**\n276:      * @see org.tigris.gef.graph.MutableGraphModel#addNodeRelatedEdges(java.lang.Object)\n277:      */\n278:     public void addNodeRelatedEdges(Object node) {\n279:         super.addNodeRelatedEdges(node);\n280: \n281:         if (Model.getFacade().isAStateVertex(node)) {\n282:             Collection transen = new ArrayList(Model.getFacade().getOutgoings(node));\n283:             transen.addAll(Model.getFacade().getIncomings(node));\n284:             Iterator iter = transen.iterator();\n285:             while (iter.hasNext()) {\n286:                 Object dep = /* (MTransition) */iter.next();\n287:                 if (canAddEdge(dep)) {\n288:                     addEdge(dep);\n289:                 }\n290:             }\n291:         }\n292:     }\n293: \n294:     /**\n295:      * Return true if the two given ports can be connected by a kind of edge to\n296:      * be determined by the ports.\n297:      *\n298:      * @see org.tigris.gef.graph.MutableGraphModel#canConnect(java.lang.Object,\n299:      * java.lang.Object)\n300:      */\n301:     public boolean canConnect(Object fromPort, Object toPort) {\n302:         if (!(Model.getFacade().isAStateVertex(fromPort))) {\n303:             LOG.error(\"internal error not from sv\");\n304:             return false;\n305:         }\n306:         if (!(Model.getFacade().isAStateVertex(toPort))) {\n307:             LOG.error(\"internal error not to sv\");\n308:             return false;\n309:         }\n310: \n311:         if (Model.getFacade().isAFinalState(fromPort)) {\n312:             return false;\n313:         }\n314:         if (Model.getFacade().isAPseudostate(toPort)) {\n315:             if ((Model.getPseudostateKind().getInitial()).equals(\n316:                     Model.getFacade().getKind(toPort))) {\n317:                 return false;\n318:             }\n319:         }\n320:         return true;\n321:     }\n322: \n323:     /**\n324:      * Contruct and add a new edge of the given kind.\n325:      *\n326:      * @see org.tigris.gef.graph.MutableGraphModel#connect(java.lang.Object,\n327:      * java.lang.Object, java.lang.Class)\n328:      */\n329:     public Object connect(Object fromPort, Object toPort,\n330: \t\t\t  Object edgeClass) {\n331: \n332:         if (Model.getFacade().isAFinalState(fromPort)) {\n333: \t    return null;\n334: \t}\n335: \n336:         if (Model.getFacade().isAPseudostate(toPort)\n337:                 && Model.getPseudostateKind().getInitial().equals(\n338: \t\t\tModel.getFacade().getKind(toPort))) {\n339:             return null;\n340: \t}\n341: \n342:         if (Model.getMetaTypes().getTransition().equals(edgeClass)) {\n343:             Object tr = null;\n344:             tr =\n345:                 Model.getStateMachinesFactory()\n346:                     .buildTransition(fromPort, toPort);\n347:             if (canAddEdge(tr)) {\n348:                 addEdge(tr);\n349:             } else {\n350:                 ProjectManager.getManager().getCurrentProject().moveToTrash(tr);\n351:                 tr = null;\n352:             }\n353:             return tr;\n354:         } else if (edgeClass == CommentEdge.class) {\n355:             try {\n356:                 Object connection =\n357:                     buildConnection(\n358:                             edgeClass, fromPort, null, toPort, null, null,\n359:                             ProjectManager.getManager().getCurrentProject()\n360:                             .getModel());\n361:                 addEdge(connection);\n362:                 return connection;\n363:             } catch (Exception ex) {\n364:                 // fail silently\n365:             }\n366:             return null;\n367:         } else {\n368:             LOG.debug(\"wrong kind of edge in StateDiagram connect3 \"\n369:                     + edgeClass);\n370:             return null;\n371:         }\n372:     }\n373: \n374:     ////////////////////////////////////////////////////////////////\n375:     // VetoableChangeListener implementation\n376: \n377:     /**\n378:      * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n379:      */\n380:     public void vetoableChange(PropertyChangeEvent pce) {\n381:         //throws PropertyVetoException\n382: \n383:         if (\"ownedElement\".equals(pce.getPropertyName())) {\n384:             Collection oldOwned = (Collection) pce.getOldValue();\n385:             Object eo = /* (MElementImport) */pce.getNewValue();\n386:             Object me = Model.getFacade().getModelElement(eo);\n387:             if (oldOwned.contains(eo)) {\n388:                 LOG.debug(\"model removed \" + me);\n389:                 if (Model.getFacade().isAState(me)) {\n390:                     removeNode(me);\n391:                 }\n392:                 if (Model.getFacade().isAPseudostate(me)) {\n393:                     removeNode(me);\n394:                 }\n395:                 if (Model.getFacade().isATransition(me)) {\n396:                     removeEdge(me);\n397:                 }\n398:             } else {\n399:                 LOG.debug(\"model added \" + me);\n400:             }\n401:         }\n402:     }\n403: \n404:     /**\n405:      * The UID.\n406:      */\n407:     static final long serialVersionUID = -8056507319026044174L;\n408: \n409:     /**\n410:      * @param newNode\n411:      *            this is the new node that one of the ends is dragged to.\n412:      * @param oldNode\n413:      *            this is the existing node that is already connected.\n414:      * @param edge\n415:      *            this is the edge that is being dragged/rerouted\n416:      * @return true if a transition is being rerouted between two states.\n417:      */\n418:     public boolean canChangeConnectedNode(Object newNode, Object oldNode,\n419:             Object edge) {\n420:         // prevent no changes...\n421:         if (newNode == oldNode) {\n422:             return false;\n423:         }\n424: \n425:         // check parameter types:\n426:         if (!(Model.getFacade().isAState(newNode)\n427: \t      || Model.getFacade().isAState(oldNode)\n428: \t      || Model.getFacade().isATransition(edge))) {\n429: \t    return false;\n430: \t}\n431: \n432:         // it's not allowed to move a transition\n433:         // so that it will go from a composite to its substate\n434:         // nor vice versa. See issue 2865.\n435:         Object otherSideNode = Model.getFacade().getSource(edge);\n436:         if (otherSideNode == oldNode) {\n437:             otherSideNode = Model.getFacade().getTarget(edge);\n438:         }\n439:         if (Model.getFacade().isACompositeState(newNode)\n440:                 && Model.getStateMachinesHelper().getAllSubStates(newNode)\n441:                                                     .contains(otherSideNode)) {\n442:             return false;\n443:         }\n444: \n445:         return true;\n446:     }\n447: \n448:     /**\n449:      * Reroutes the connection to the old node to be connected to the new node.\n450:      *\n451:      * @param newNode\n452:      *            this is the new node that one of the ends is dragged to.\n453:      * @param oldNode\n454:      *            this is the existing node that is already connected.\n455:      * @param edge\n456:      *            this is the edge that is being dragged/rerouted\n457:      * @param isSource\n458:      *            tells us which end is being rerouted.\n459:      */\n460:     public void changeConnectedNode(Object newNode, Object oldNode,\n461:             Object edge, boolean isSource) {\n462: \n463:         if (isSource) {\n464:             Model.getStateMachinesHelper().setSource(edge, newNode);\n465:         } else {\n466:             Model.getCommonBehaviorHelper().setTarget(edge, newNode);\n467:         }\n468: \n469:     }\n470: \n471:     /**\n472:      * @see org.argouml.uml.diagram.UMLMutableGraphSupport#isRemoveFromDiagramAllowed(Collection)\n473:      */\n474:     public boolean isRemoveFromDiagramAllowed(Collection figs) {\n475:         /* If nothing is selected, then not allowed to remove it. */\n476:         if (figs.isEmpty()) {\n477:             return false;\n478:         }\n479:         Iterator i = figs.iterator();\n480:         while (i.hasNext()) {\n481:             Object obj = i.next();\n482:             if (!(obj instanceof Fig)) {\n483:                 return false;\n484:             }\n485:             Object uml = ((Fig) obj).getOwner();\n486:             /* If a UML object is found, you can not remove selected elms. */\n487:             if (uml != null) {\n488:                 return false;\n489:             }\n490:         }\n491:         /* If only Figs without owner are selected, then you can remove them! */\n492:         return true;\n493:     }\n494: \n495: \n496: } /* end class StateDiagramGraphModel */\n497: ",
