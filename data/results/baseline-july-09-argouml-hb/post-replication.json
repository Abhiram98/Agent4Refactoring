llPane;\n33: import javax.swing.JTable;\n34: import javax.swing.table.DefaultTableModel;\n35: import javax.swing.table.TableColumn;\n36: \n37: import org.argouml.i18n.Translator;\n38: import org.argouml.kernel.Project;\n39: import org.argouml.kernel.ProjectManager;\n40: import org.argouml.model.ModelFacade;\n41: import org.argouml.model.uml.modelmanagement.ModelManagementHelper;\n42: import org.argouml.ui.ArgoDialog;\n43: import org.argouml.ui.ProjectBrowser;\n44: import org.argouml.uml.generator.Generator2;\n45: \n46: /**\n47:  * Provides support for setting a \"src_path\" tagged value used in Java\n48:  * round trip engineering.\n49:  */\n50: public class SourcePathDialog extends ArgoDialog implements ActionListener {\n51: \n52:     ////////////////////////////////////////////////////////////////\n53:     // instance variables\n54:     private SrcPathTableModel _srcPathTableModel = new SrcPathTableModel();\n55: \n56:     protected JTable _srcPathTable;\n57: \n58:     ////////////////////////////////////////////////////////////////\n59:     // constructors\n60: \n61:     public SourcePathDialog() {\n62:         super(\n63:             ProjectBrowser.getInstance(),\n64:             Translator.localize(\"action.generate-code-for-project\"),\n65:             ArgoDialog.OK_CANCEL_OPTION,\n66:             true);\n67: \n68:         _srcPathTable = new JTable();\n69:         _srcPathTable.setModel(_srcPathTableModel);\n70:         _srcPathTable.setAutoResizeMode(JTable.AUTO_RESIZE_LAST_COLUMN);\n71:         TableColumn elemCol = _srcPathTable.getColumnModel().getColumn(0);\n72:         elemCol.setMinWidth(0);\n73:         elemCol.setMaxWidth(0);\n74: \n75:         setContent(new JScrollPane(_srcPathTable));\n76:     }\n77: \n78:     ////////////////////////////////////////////////////////////////\n79:     // event handlers\n80: \n81:     public void actionPerformed(ActionEvent e) {\n82:         super.actionPerformed(e);\n83: \n84:         // OK Button ------------------------------------------\n85:         if (e.getSource() == getOkButton()) {\n86:             buttonOkActionPerformed();\n87:         }\n88:     }\n89: \n90:     public void buttonOkActionPerformed() {\n91:         for (int i = 0; i < _srcPathTableModel.getRowCount(); i++) {\n92:             Object elem = _srcPathTableModel.getValueAt(i, 0);\n93:             String path = (String) _srcPathTableModel.getValueAt(i, 3);\n94:             if (elem != null\n95:                 && path != null\n96:                 && !path.equals(ModelFacade.getTaggedValue(elem, \"src_path\"))) {\n97:                 ModelFacade.setTaggedValue(elem, \"src_path\", path);\n98:             }\n99:         }\n100:     }\n101: } /* end class SourcePathDialog */\n102: \n103: /**\n104:  * Provides support for setting a \"src_path\" tagged value used in Java\n105:  * round trip engineering.\n106:  */\n107: class SrcPathTableModel extends DefaultTableModel {\n108: \n109:     /** Creates a new instance of SrcPathTableModel */\n110:     public SrcPathTableModel() {\n111:         super(new Object[][] {\n112:         }, new String[] {\n113: \t    \" \", \"Name\", \"Type\", \"Source path\"\n114: \t});\n115:         Project p = ProjectManager.getManager().getCurrentProject();\n116:         Collection elems =\n117:             ModelManagementHelper.getHelper().getAllModelElementsOfKind(\n118:                 (Class) ModelFacade.MODELELEMENT);\n119:         elems.add(p.getRoot());\n120:         Iterator iter = elems.iterator();\n121:         while (iter.hasNext()) {\n122:             Object me = iter.next();\n123:             String path = Generator2.getCodePath(me);\n124:             if (path != null) {\n125:                 String type = \"\";\n126:                 String name = ModelFacade.getName(me);\n127:                 if (ModelFacade.isAModel(me)) {\n128:                     type = \"Model\";\n129:                 } else if (ModelFacade.isAPackage(me)) {\n130:                     type = \"Package\";\n131:                     Object parent = ModelFacade.getNamespace(me);\n132:                     while (parent != null) {\n133:                         // ommit root package name; it's the model's root\n134:                         if (ModelFacade.getNamespace(parent) != null)\n135:                             name = ModelFacade.getName(parent) + \".\" + name;\n136:                         parent = ModelFacade.getNamespace(parent);\n137:                     }\n138:                 } else if (ModelFacade.isAClass(me)) {\n139:                     type = \"Class\";\n140:                 } else if (ModelFacade.isAInterface(me)) {\n141:                     type = \"Interface\";\n142:                 }\n143:                 addRow(new Object[] {\n144: \t\t    me, name, type, path\n145: \t\t});\n146:             }\n147:         }\n148:     }\n149: \n150:     public boolean isCellEditable(int rowIndex, int columnIndex) {\n151:         return columnIndex == 3;\n152:     }\n153: }\n154: ",
