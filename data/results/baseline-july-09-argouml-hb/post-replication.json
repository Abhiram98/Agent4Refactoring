  * Create an empty but initialized instance of a UML Abstraction.\n36:      * \n37:      * @return an initialized UML Abstraction instance.\n38:      */\n39:     public Object createAbstraction();\n40:     \n41:     /**\n42:      * Build an empty but initialized instance of a UML Abstraction\n43:      * with a given name.\n44:      *\n45:      * @param name The name.\n46:      * @return an initialized UML Abstraction instance.\n47:      * @param supplier the supplier of the abstraction\n48:      * @param client the client of the abstraction\n49:      */\n50:     Object buildAbstraction(String name, Object supplier, Object client);\n51: \n52:     /**\n53:      * Create an empty but initialized instance of an Artifact\n54:      * \n55:      * @since UML 1.4\n56:      * @return an initialized Artifact instance.\n57:      */\n58:     public Object createArtifact();\n59:     \n60:     /**\n61:      * Create an empty but initialized instance of a UML Association.\n62:      * \n63:      * @return an initialized UML Association instance.\n64:      */\n65:     public Object createAssociation();\n66: \n67:     /**\n68:      * Create an empty but initialized instance of a UML AssociationClass.\n69:      * \n70:      * @return an initialized UML AssociationClass instance.\n71:      */\n72:     public Object createAssociationClass();\n73:     \n74:     /**\n75:      * Create an empty but initialized instance of a UML AssociationEnd.\n76:      *\n77:      * @return an initialized UML AssociationEnd instance.\n78:      */\n79:     Object createAssociationEnd();\n80: \n81:     /**\n82:      * Create an empty but initialized instance of a UML Attribute.\n83:      *\n84:      * @return an initialized UML Attribute instance.\n85:      */\n86:     Object createAttribute();\n87: \n88:     /**\n89:      * Create an empty but initialized instance of a UML Binding.\n90:      *\n91:      * @return an initialized UML Binding instance.\n92:      */\n93:     Object createBinding();\n94: \n95:     /**\n96:      * Create an empty but initialized instance of a UML Class.\n97:      *\n98:      * @return an initialized UML Class instance.\n99:      */\n100:     Object createClass();\n101: \n102:     /**\n103:      * Create an empty but initialized instance of a UML Comment.\n104:      *\n105:      * @return an initialized UML Comment instance.\n106:      */\n107:     Object createComment();\n108: \n109:     /**\n110:      * Create an empty but initialized instance of a UML Component.\n111:      *\n112:      * @return an initialized UML Component instance.\n113:      */\n114:     Object createComponent();\n115: \n116:     /**\n117:      * Create an empty but initialized instance of a UML Constraint.\n118:      *\n119:      * @return an initialized UML Constraint instance.\n120:      */\n121:     Object createConstraint();\n122: \n123:     /**\n124:      * Create an empty but initialized instance of a UML DataType.\n125:      *\n126:      * @return an initialized UML DataType instance.\n127:      */\n128:     Object createDataType();\n129:     \n130:     /**\n131:     * Create an empty but initialized instance of a UML Dependency.\n132:     *\n133:     * @return an initialized UML Dependency instance.\n134:     */\n135:     public Object createDependency();\n136: \n137:     /**\n138:      * Create an empty but initialized instance of a UML ElementResidence.\n139:      *\n140:      * @return an initialized UML ElementResidence instance.\n141:      */\n142:     Object createElementResidence();\n143:     \n144:     /**\n145:      * Create an Enumeration.\n146:      * @return Object new Enumeration\n147:      * @since UML 1.4\n148:      */\n149:     Object createEnumeration();\n150: \n151:     /**\n152:      * Create an EnumerationLiteral.\n153:      * @return Object new Enumeration\n154:      * @since UML 1.4\n155:      */\n156:     Object createEnumerationLiteral();\n157: \n158:     /**\n159:      * Create an empty but initialized instance of a UML Flow.\n160:      *\n161:      * @return an initialized UML Flow instance.\n162:      */\n163:     Object createFlow();\n164: \n165:     /**\n166:      * Create an empty but initialized instance of a UML Interface.\n167:      *\n168:      * @return an initialized UML Interface instance.\n169:      */\n170:     Object createInterface();\n171: \n172:     /**\n173:      * Create an empty but initialized instance of a UML Method.\n174:      *\n175:      * @return an initialized UML Method instance.\n176:      */\n177:     Object createMethod();\n178: \n179:     /**\n180:      * Create an empty but initialized instance of a UML Node.\n181:      *\n182:      * @return an initialized UML Node instance.\n183:      */\n184:     Object createNode();\n185: \n186:     /**\n187:      * Create an empty but initialized instance of a UML Operation.\n188:      *\n189:      * @return an initialized UML Operation instance.\n190:      */\n191:     Object createOperation();\n192: \n193:     /**\n194:      * Create an empty but initialized instance of a UML Parameter.\n195:      *\n196:      * @return an initialized UML Parameter instance.\n197:      */\n198:     Object createParameter();\n199: \n200:     /**\n201:      * Create an empty but initialized instance of a UML Permission.\n202:      *\n203:      * @return an initialized UML Permission instance.\n204:      */\n205:     Object createPermission();\n206:     \n207:     /**\n208:      * Create a UML Primitive.\n209:      * \n210:      * @since UML 1.4\n211:      * @return an initialized UML Primitive instance.\n212:      */\n213:     public Object createPrimitive();\n214: \n215:     /**\n216:      * Create a UML ProgrammingLanguageDataType.\n217:      * \n218:      * @since UML 1.4\n219:      * @return an initialized ProgrammingLanguageDataType\n220:      */\n221:     public Object createProgrammingLanguageDataType();\n222: \n223:     /**\n224:      * Create a UML TemplateArgument.\n225:      * \n226:      * @since UML 1.4\n227:      * @return an initialized TemplateArgument instance.\n228:      */\n229:     public Object createTemplateArgument();\n230: \n231:     /**\n232:      * Create an empty but initialized instance of a UML TemplateParameter.\n233:      *\n234:      * @return an initialized UML TemplateParameter instance.\n235:      */\n236:     Object createTemplateParameter();\n237: \n238:     /**\n239:      * Create an empty but initialized instance of a UML Usage.\n240:      *\n241:      * @return an initialized UML Usage instance.\n242:      */\n243:     Object createUsage();\n244: \n245:     /**\n246:      * Builds a binary associationrole on basis of two classifierroles,\n247:      * navigation and aggregation.\n248:      *\n249:      * @param fromClassifier   the first given classifier\n250:      * @param aggregationKind1 the first aggregationkind\n251:      * @param toClassifier     the second given classifier\n252:      * @param aggregationKind2 the second aggregationkind\n253:      * @param unidirectional true if unidirectional\n254:      * @return the newly build binary associationrole\n255:      */\n256:     Object buildAssociation(Object fromClassifier, Object aggregationKind1,\n257:             Object toClassifier, Object aggregationKind2,\n258:             Boolean unidirectional);\n259: \n260:     /**\n261:      * Builds a binary associations between two classifiers with\n262:      * default values for the association ends and the association\n263:      * itself.<p>\n264:      *\n265:      * @param classifier1 The first classifier to connect\n266:      * @param classifier2 The second classifier to connect\n267:      * @return MAssociation\n268:      */\n269:     Object buildAssociation(Object classifier1, Object classifier2);\n270: \n271:     /**\n272:      * Builds a binary association with a direction, aggregation\n273:      * and a given name.\n274:      *\n275:      * @param c1 The first classifier to connect to\n276:      * @param nav1 The navigability of the Associaton end\n277:      * @param c2 The second classifier to connect to\n278:      * @param nav2 The navigability of the second Associaton end\n279:      * @param name the given name\n280:      * @return association\n281:      */\n282:     Object buildAssociation(Object c1, boolean nav1, Object c2, boolean nav2,\n283:             String name);\n284: \n285:     /**\n286:      * Builds an associationClass between classifier end1 and end2 with a\n287:      * default class.<p>\n288:      *\n289:      * @param end1 the first given classifier\n290:      * @param end2 the second given classifier\n291:      * @return MAssociationClass\n292:      */\n293:     Object buildAssociationClass(Object end1, Object end2);\n294: \n295:     /**\n296:      * Builds a fully configurable association end. All variables for\n297:      * an associationend can be given as parameter.\n298:      * @param assoc The associaton this end will be part of\n299:      * @param name The name of the association end\n300:      * @param type The type (classifier) the end will connect. The end\n301:      * is a connection piece between an association and a classifier\n302:      * @param multi The multiplicity\n303:      * @param stereo The stereotype\n304:      * @param navigable The navigability. True if this association end\n305:      *                  can be 'passed' from the other classifier.\n306:      * @param order Ordering of the association\n307:      * @param aggregation the aggregationkind\n308:      * @param scope the scope kind\n309:      * @param changeable the changeablekind\n310:      * @param visibility the visibilitykind\n311:      * @return MAssociationEnd\n312:      */\n313:     Object buildAssociationEnd(\n314:         Object assoc,\n315:         String name,\n316:         Object type,\n317:         Object multi,\n318:         Object stereo,\n319:         boolean navigable,\n320:         Object order,\n321:         Object aggregation,\n322:         Object scope,\n323:         Object changeable,\n324:         Object visibility);\n325: \n326:     /**\n327:      * Builds a simply configured association end.\n328:      *\n329:      * @param type the given classifier\n330:      * @param assoc the given association\n331:      * @return the newly build associationend\n332:      */\n333:     Object buildAssociationEnd(Object type, Object assoc);\n334: \n335:     /**\n336:      * Builds a default attribute.\n337:      *\n338:      * @param model The model the attribute belongs to.\n339:      * @param theIntType The type of the attribute.\n340:      * @return The newly built attribute.\n341:      */\n342:     Object buildAttribute(Object model, Object theIntType);\n343: \n344:     /**\n345:      * Builds an attribute owned by some classifier cls. I don't know\n346:      * if this is legal for an interface (purely UML speaking). In\n347:      * this method it is.<p>\n348:      *\n349:      * @param handle the given classifier\n350:      * @param model the enclosing model\n351:      * @param intType the type\n352:      * @param propertyChangeListeners the listeners\n353:      * @return the newly build attribute\n354:      */\n355:     Object buildAttribute(Object handle, Object model, Object intType,\n356:             Collection propertyChangeListeners);\n357: \n358:     /**\n359:      * Builds a default implementation for a class. The class is not owned by\n360:      * any model element by default. Users should not forget to add ownership.\n361:      *\n362:      * @return MClass\n363:      */\n364:     Object buildClass();\n365: \n366:     /**\n367:      * Builds a class with a given namespace.\n368:      *\n369:      * @param owner the namespace\n370:      * @return MClass\n371:      * @see #buildClass()\n372:      */\n373:     Object buildClass(Object owner);\n374: \n375:     /**\n376:      * Builds a class with a given name.\n377:      *\n378:      * @param name the given name\n379:      * @return MClass\n380:      * @see #buildClass()\n381:      */\n382:     Object buildClass(String name);\n383: \n384:     /**\n385:      * Builds a class with a given name and namespace.\n386:      *\n387:      * @param name the given name\n388:      * @param owner the namespace\n389:      * @return MClass\n390:      * @see #buildClass()\n391:      */\n392:     Object buildClass(String name, Object owner);\n393: \n394:     /**\n395:      * Builds a default implementation for an interface. The interface\n396:      * is not owned by any model element by default. Users should not\n397:      * forget to add ownership.\n398:      *\n399:      * @return MInterface\n400:      */\n401:     Object buildInterface();\n402: \n403:     /**\n404:      * Builds an interface with a given namespace.\n405:      *\n406:      * @param owner is the owner\n407:      * @return MInterface\n408:      * @see #buildInterface()\n409:      */\n410:     Object buildInterface(Object owner);\n411: \n412:     /**\n413:      * Builds an interface with a given name.\n414:      *\n415:      * @param name is the given name.\n416:      * @return MInterface\n417:      * @see #buildInterface()\n418:      */\n419:     Object buildInterface(String name);\n420: \n421:     /**\n422:      * Builds an interface with a given name and namespace.\n423:      *\n424:      * @param name is the given name\n425:      * @param owner is the namespace\n426:      * @return MInterface\n427:      * @see #buildInterface()\n428:      */\n429:     Object buildInterface(String name, Object owner);\n430: \n431:     /**\n432:      * Builds a datatype with a given name and namespace.\n433:      *\n434:      * @param name is the name\n435:      * @param owner is the namespace\n436:      * @return an initialized UML DataType instance.\n437:      */\n438:     Object buildDataType(String name, Object owner);\n439:     \n440:     /**\n441:      * @param name is the name\n442:      * @param owner is the namespace\n443:      * @return an initialized UML Enumeration instance\n444:      * @since UML 1.4\n445:      */\n446:     Object buildEnumeration(String name, Object owner);\n447:     \n448:     /**\n449:      * @param name is the name\n450:      * @param enumeration is the enumeration of the literal\n451:      * @return an initialized UML EnumerationLiteral instance\n452:      * @since UML 1.4\n453:      */\n454:     Object buildEnumerationLiteral(String name, Object enumeration);\n455: \n456:     /**\n457:      * Builds a modelelement dependency between two modelelements.<p>\n458:      *\n459:      * @param clientObj is the client\n460:      * @param supplierObj is the supplier\n461:      * @return MDependency\n462:      */\n463:     Object buildDependency(Object clientObj, Object supplierObj);\n464: \n465:     /**\n466:      * Builds a modelelement permission between two modelelements.\n467:      *\n468:      * @param clientObj is the client\n469:      * @param supplierObj is the supplier\n470:      * @return MPermission\n471:      */\n472:     Object buildPermission(Object clientObj, Object supplierObj);\n473: \n474:     /**\n475:      * Builds a generalization between a parent and a child with a given name.\n476:      *\n477:      * @param child is the child\n478:      * @param parent is the parent\n479:      * @param name is the given name\n480:      * @return generalization\n481:      */\n482:     Object buildGeneralization(Object child, Object parent, String name);\n483: \n484:     /**\n485:      * Builds a generalization between a parent and a child. Does not check if\n486:      * multiple inheritance is allowed for the current notation.\n487:      *\n488:      * @param child is the child\n489:      * @param parent is the parent\n490:      * @return MGeneralization\n491:      */\n492:     Object buildGeneralization(Object child, Object parent);\n493: \n494: \n495:     /**\n496:      * Builds a method with a given name.\n497:      *\n498:      * @param name is the given name\n499:      * @return method\n500:      */\n501:     Object buildMethod(String name);\n502: \n503:     /**\n504:      * Builds an operation for a classifier.\n505:      *\n506:      * @param classifier is the given classifier\n507:      * @param model is the model to which the class belongs\n508:      * @param returnType the type of value returned by a method\n509:      * @param propertyChangeListeners the listeners\n510:      * @return the operation\n511:      */\n512:     Object buildOperation(Object classifier, Object model, Object returnType,\n513:             Collection propertyChangeListeners);\n514: \n515:     /**\n516:      * Builds an operation with a given name for classifier.\n517:      *\n518:      * @param cls is the classifier that shall own the operation\n519:      * @param model is the model that contains the class\n520:      * @param voidType the type of the return parameter\n521:      * @param name the given name for the operation\n522:      * @param propertyChangeListeners the listeners\n523:      * @return the operation\n524:      */\n525:     Object buildOperation(Object cls, Object model, Object voidType,\n526:             String name, Collection propertyChangeListeners);\n527: \n528:     /**\n529:      * Adds a parameter initialized to default values to a given event\n530:      * or behavioral feature.\n531:      *\n532:      * @param o an event or behavioral feature\n533:      * @param model the model to which the event or behavioral feature belongs\n534:      * @param voidType the type of the return parameter\n535:      * @param propertyChangeListeners the listeners\n536:      * @return the parameter\n537:      */\n538:     Object buildParameter(Object o, Object model, Object voidType,\n539:             Collection propertyChangeListeners);\n540: \n541:     /**\n542:      * Builds a realization between some supplier (for example an\n543:      * interface in Java) and a client who implements the realization.\n544:      *\n545:      * @param clnt is the client\n546:      * @param spplr is the supplier\n547:      * @param model the namespace to use if client and\n548:      * supplier are of different namespace\n549:      * @return Object the created abstraction\n550:      */\n551:     Object buildRealization(Object clnt, Object spplr, Object model);\n552: \n553:     /**\n554:      * Builds a usage between some client and a supplier. If client\n555:      * and supplier do not have the same model, an\n556:      * {@link IllegalArgumentException} is thrown.\n557:      *\n558:      * @param client is the client\n559:      * @param supplier is the supplier\n560:      * @return MUsage\n561:      */\n562:     Object buildUsage(Object client, Object supplier);\n563: \n564:     /**\n565:      * Builds a comment inluding a reference to the given modelelement\n566:      * to comment.  If the element is null, the comment is still build\n567:      * since it is not mandatory to have an annotated element in the\n568:      * comment.<p>\n569:      *\n570:      * @param element is the model element\n571:      * @param model the namespace for the comment\n572:      * @return MComment\n573:      */\n574:     Object buildComment(Object element, Object model);\n575: \n576:     /**\n577:      * Builds a constraint that constraints the given modelelement.\n578:      * The namespace of the constraint will be the same as the\n579:      * namespace of the given modelelement.<p>\n580:      *\n581:      * @param constrElement The constrained element.\n582:      * @return MConstraint\n583:      */\n584:     Object buildConstraint(Object constrElement);\n585: \n586:     /**\n587:      * Builds a constraint with a given name and boolean expression.<p>\n588:      *\n589:      * @param name is the given name\n590:      * @param bexpr boolean expression\n591:      * @return constraint\n592:      */\n593:     Object buildConstraint(String name, Object bexpr);\n594: \n595:     /**\n596:      * Copies a class, and it's features. This may also require other\n597:      * classifiers to be copied.\n598:      *\n599:      * @param source is the class to copy.\n600:      * @param ns is the namespace to put the copy in.\n601:      * @return a newly created class.\n602:      */\n603:     Object copyClass(Object source, Object ns);\n604: \n605:     /**\n606:      * Copies a datatype, and it's features. This may also require other\n607:      * classifiers to be copied.\n608:      *\n609:      * @param source is the datatype to copy.\n610:      * @param ns is the namespace to put the copy in.\n611:      * @return a newly created data type.\n612:      */\n613:     Object copyDataType(Object source, Object ns);\n614: \n615:     /**\n616:      * Copies an interface, and it's features. This may also require other\n617:      * classifiers to be copied.\n618:      *\n619:      * @param source is the interface to copy.\n620:      * @param ns is the namespace to put the copy in.\n621:      * @return a newly created interface.\n622:      */\n623:     Object copyInterface(Object source, Object ns);\n624: \n625:     /**\n626:      * Additional support for generalization.\n627:      *\n628:      * @return A generalization.\n629:      */\n630:     Object createGeneralization();\n631: \n632: }\n633: ",
