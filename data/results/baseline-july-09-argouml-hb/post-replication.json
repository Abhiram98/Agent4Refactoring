ments\n1953:      * TODO: flows, dependencies, comments, bindings, contexts ???\n1954:      * TODO: contents, residences ???\n1955:      *\n1956:      * @param source the source me\n1957:      * @param target the target me\n1958:      */\n1959:     public void doCopyModelElement(MModelElement source, MModelElement target) {\n1960: \t// Set the name so that superclasses can find the newly\n1961: \t// created element in the model, if necessary.\n1962: \ttarget.setName(source.getName());\n1963: \tdoCopyElement(source, target);\n1964: \n1965: \ttarget.setSpecification(source.isSpecification());\n1966: \ttarget.setVisibility(source.getVisibility());\n1967: \tDataTypesHelper.getHelper().copyTaggedValues(source, target);\n1968: \n1969: \tif (source.getStereotype() != null) {\n1970: \t    // Note that if we're copying this element then we\n1971: \t    // must also be allowed to copy other necessary\n1972: \t    // objects.\n1973: \t    MStereotype st = (MStereotype)\n1974: \t\tModelManagementHelper.getHelper()\n1975: \t\t    .getCorrespondingElement(source.getStereotype(),\n1976: \t\t\t\t\t     target.getModel(),\n1977: \t\t\t\t\t     true);\n1978: \t    target.setStereotype(st);\n1979: \t}\n1980:     }\n1981: \n1982:     /**\n1983:      * Used by the copy functions. Do not call this function directly.\n1984:      *\n1985:      * @param source the source namespace\n1986:      * @param target the target namespace\n1987:      */\n1988:     public void doCopyNamespace(MNamespace source, MNamespace target) {\n1989: \tdoCopyModelElement(source, target);\n1990: \t// Nothing more to do, don't copy owned elements.\n1991:     }\n1992: }\n1993: \n1994: ",
