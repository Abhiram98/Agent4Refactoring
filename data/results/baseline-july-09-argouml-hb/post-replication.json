eight + 4));\n91:     _internal.setFont(LABEL_FONT);\n92:     _internal.setTextColor(Color.black);\n93:     _internal.setLineWidth(0);\n94:     _internal.setFilled(false);\n95:     _internal.setExpandOnly(true);\n96:     _internal.setMultiLine(true);\n97:     _internal.setJustification(FigText.JUSTIFY_LEFT);\n98: \n99:     // add Figs to the FigNode in back-to-front order\n100:     addFig(_bigPort);\n101:     addFig(_cover);\n102:     addFig(_name);\n103:     addFig(_divider);\n104:     addFig(_internal);\n105: \n106:     //setBlinkPorts(false); //make port invisble unless mouse enters\n107:     Rectangle r = getBounds();\n108:     setBounds(r.x, r.y, r.width, r.height);\n109:   }\n110: \n111:   public FigState(GraphModel gm, Object node) {\n112:     this();\n113:     setOwner(node);\n114:   }\n115: \n116:   public String placeString() { return \"new MState\"; }\n117: \n118:   public Object clone() {\n119:     FigState figClone = (FigState) super.clone();\n120:     Vector v = figClone.getFigs();\n121:     figClone._bigPort = (FigRect) v.elementAt(0);\n122:     figClone._cover = (FigRect) v.elementAt(1);\n123:     figClone._name = (FigText) v.elementAt(2);\n124:     figClone._divider = (FigLine) v.elementAt(3);\n125:     figClone._internal = (FigText) v.elementAt(4);\n126:     return figClone;\n127:   }\n128: \n129:   ////////////////////////////////////////////////////////////////\n130:   // accessors\n131: \n132:   public Selection makeSelection() {\n133:     return new SelectionState(this);\n134:   }\n135: \n136: \n137:   public void setOwner(Object node) {\n138:     super.setOwner(node);\n139:     bindPort(node, _bigPort);\n140:   }\n141: \n142:   public Dimension getMinimumSize() {\n143:     Dimension nameDim = _name.getMinimumSize();\n144:     Dimension internalDim = _internal.getMinimumSize();\n145: \n146:     int h = nameDim.height + 4 + internalDim.height;\n147:     int w = Math.max(nameDim.width + 4, internalDim.width + 4);\n148:     return new Dimension(w,