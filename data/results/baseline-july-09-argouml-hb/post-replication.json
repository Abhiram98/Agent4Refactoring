                        "content": "Here is the source code to modify: \nmodules/cpp/src/org/argouml/language/cpp/generator/GeneratorCpp.java: \n1: // $Id$\n2: // Copyright (c) 1996-2005 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.language.cpp.generator;\n26: \n27: import java.io.BufferedReader;\n28: import java.io.BufferedWriter;\n29: import java.io.File;\n30: import java.io.FileReader;\n31: import java.io.FileWriter;\n32: import java.io.IOException;\n33: import java.rmi.server.UID;\n34: import java.text.DateFormat;\n35: import java.util.Calendar;\n36: import java.util.Collection;\n37: import java.util.GregorianCalendar;\n38: import java.util.HashSet;\n39: import java.util.Iterator;\n40: import java.util.LinkedHashSet;\n41: import java.util.Set;\n42: import java.util.StringTokenizer;\n43: import java.util.TreeSet;\n44: import java.util.Vector;\n45: \n46: import org.apache.log4j.Logger;\n47: import org.argouml.application.api.Argo;\n48: import org.argouml.application.api.Configuration;\n49: import org.argouml.application.api.ConfigurationKey;\n50: import org.argouml.model.Model;\n51: import org.argouml.notation.Notation;\n52: import org.argouml.uml.DocumentationManager;\n53: import org.argouml.uml.UUIDHelper;\n54: import org.argouml.uml.generator.CodeGenerator;\n55: import org.argouml.uml.generator.FileGenerator;\n56: import org.argouml.uml.generator.Generator2;\n57: import org.argouml.uml.generator.GeneratorHelper;\n58: import org.argouml.uml.generator.GeneratorManager;\n59: import org.argouml.uml.generator.Language;\n60: import org.argouml.uml.generator.SourceUnit;\n61: \n62: /**\n63:  * Generator2 subclass to generate C++ source code that is used in ArgoUML GUI\n64:  * and text fields when the cpp notation is selected by the user. It also\n65:  * implements FileGenerator and makes it possible for the user to generate\n66:  * the source code files for model elements of his choice.\n67:  *\n68:  * WARNING: Don't know if this is a threat (and I think it's not), but this\n69:  * class is NOT THREAD SAFE. DO NOT CALL METHODS FROM DIFFERENT THREADS.\n70:  * At the moment, it works, but this is just in case someone in the future\n71:  * tries to generate 1265 files in parallel and guesses why it doesn't work :-)\n72:  */\n73: public class GeneratorCpp extends Generator2\n74:     implements CodeGenerator {\n75: \n76:     /**\n77:      * The logger.\n78:      */\n79:     private static final Logger LOG = Logger.getLogger(GeneratorCpp.class);\n80: \n81:     // Customizable variables\n82: \n83:     private boolean verboseDocs = false;\n84:     private boolean lfBeforeCurly = false;\n85:     private String indent = INDENT; // customizable (non final) indent\n86: \n87:     // Configuration keys for the above configurable variables\n88:     private static final ConfigurationKey KEY_CPP_INDENT =\n89:         Configuration.makeKey(\"cpp\", \"indent\");\n90:     private static final ConfigurationKey KEY_CPP_LF_BEFORE_CURLY =\n91:         Configuration.makeKey(\"cpp\", \"lf-before-curly\");\n92:     private static final ConfigurationKey KEY_CPP_VERBOSE_COMM =\n93:         Configuration.makeKey(\"cpp\", \"verbose-comments\");\n94:     private static final ConfigurationKey KEY_CPP_SECT =\n95:         Configuration.makeKey(\"cpp\", \"sections\");\n96: \n97:     private static Section sect;\n98: \n99:     /**\n100:      * Store actual namespace, to avoid unneeded curley braces.\n101:      *\n102:      * @author Achim Spangler\n103:      * @since 2002-12-07\n104:      */\n105:     private Object actualNamespace;\n106: \n107:     /** Current classifier, for which the code is being generated.\n108:      */\n109:     private Object currClass = null;\n110: \n111:     /**\n112:      * Set of the local files to include with #include \"file.h\"\n113:      * Automatically generated from classifier dependencies.\n114:      */\n115:     private Set localInc = new TreeSet();\n116: \n117:     /**\n118:      * Set of the external files to include with #include <file.h>\n119:      * Automatically generated from classifier dependencies.\n120:      */\n121:     private Set extInc = new TreeSet();\n122: \n123:     /**\n124:      * Set of the system files to include, like #include <vector>\n125:      * Automatically generated.\n126:      */\n127:     private Set systemInc = new TreeSet();\n128:  \n129:     /** Set of classifier that needs to be defined (i.e. #included)\n130:      */\n131:     private Set includeCls = new LinkedHashSet();\n132: \n133:     /** Set of classifier that only needs to be predeclared\n134:      */\n135:     private Set predeclCls = new LinkedHashSet();\n136: \n137:     /**\n138:      * System newline separator.\n139:      */\n140:     private static final String LINE_SEPARATOR =\n141:         System.getProperty(\"line.separator\");\n142: \n143: \n144:     /**\n145:      * C++ doesn't place visibility information for each class member\n146:      * --> sort items during generation and store visibility state\n147:      * of lastly generated member in central class variable, so that\n148:      * the appropriate lines: \"public:\\n\", \"protected:\\n\", \"private:\\n\"\n149:      * can be created.\n150:      *\n151:      * @author Achim Spangler\n152:      * @since 2002-11-28\n153:      */\n154:     private static final int PUBLIC_PART = 0;\n155:     private static final int PROTECTED_PART = 1;\n156:     private static final int PRIVATE_PART = 2;\n157: \n158:     private static final int[] ALL_PARTS = {\n159:         PUBLIC_PART,\n160:         PROTECTED_PART,\n161:         PRIVATE_PART,\n162:     };\n163: \n164:     private static final String[] PART_NAME = {\n165:         \"public\", \"protected\", \"private\"\n166:     };\n167: \n168:     /**\n169:      * C++ uses two files for each class: header (.h) with class definition\n170:      * and source (.cpp) with methods implementation\n171:      * --> two generation passes are needed.\n172:      *\n173:      * @author Achim Spangler\n174:      * @since 2002-11-28\n175:      */\n176:     private static final int NONE_PASS = 1;\n177:     private static final int HEADER_PASS = 2;\n178:     private static final int SOURCE_PASS = 3;\n179:     private static int generatorPass = NONE_PASS;\n180: \n181:     /**\n182:      * use Tag generation for generation of: doccomment, simple tags of\n183:      * tags which are not used for doccomment or simple tags for all.\n184:      *\n185:      * @author Achim Spangler\n186:      * @since 2002-12-05\n187:      */\n188:     private static final int DOC_COMMENT_TAGS = 1;\n189:     private static final int ALL_BUT_DOC_TAGS = 2;\n190:     private static final int ALL_TAGS = 3;\n191: \n192:     /**\n193:      * C++ developers need to specify for parameters whether they are\n194:      * pointers or references (especially for class-types)\n195:      * -> a general check function must get the searched tag.\n196:      *\n197:      * @author Achim Spangler\n198:      * @since 2002-12-06\n199:      */\n200:     private static final int NORMAL_MOD = 0;\n201:     private static final int REFERENCE_MOD = 1;\n202:     private static final int POINTER_MOD = 2;\n203: \n204:     private static GeneratorCpp singleton;\n205: \n206:     /**\n207:      * Prefix for names in the std namespace. Defaults to \"std::\",\n208:      * but could be \"\" if a \"using namsepace std;\" directive is used.  \n209:      */\n210:     private String stdPrefix = \"std::\";\n211:     \n212:     /**\n213:      * Get the instance of the singleton for the C++ generator.\n214:      *\n215:      * @return the singleton of the generator.\n216:      */\n217:     public static synchronized GeneratorCpp getInstance() {\n218:         if (singleton != null)\n219:             return singleton;\n220:         return new GeneratorCpp(); // the constructor will set singleton\n221:     }\n222: \n223:     /**\n224:      * Constructor.\n225:      */\n226:     protected GeneratorCpp() {\n227:         super (Notation.makeNotation(\"Cpp\", null,\n228:                                      Argo.lookupIconResource (\"CppNotation\")));\n229:         singleton = this;\n230:         Language cppLang = GeneratorHelper.makeLanguage(\"cpp\", \"C++\",\n231:                 Argo.lookupIconResource (\"CppNotation\"));\n232:         GeneratorManager.getInstance().addGenerator(cppLang, this);\n233:         loadConfig();\n234:     }\n235: \n236:     /** Reset the generator in the initial state before\n237:      * starting to generate code.\n238:      */\n239:     protected void cleanupGenerator() {\n240:         // clears collections of dependencies\n241:         localInc.clear();\n242:         extInc.clear();\n243:         systemInc.clear();\n244:         includeCls.clear();\n245:         predeclCls.clear();\n246:         // set currClass to null, so if it's used when it shouldn't\n247:         // it will raise a NullPointerException\n248:         currClass = null;\n249:         actualNamespace = null;\n250:     }\n251: \n252:     /** Set up the generator in order to generate the code\n253:      * for 'cls'.\n254:      * @param o The classifier to generate the code for\n255:      */\n256:     protected void setupGenerator(Object o) {\n257:         cleanupGenerator();\n258:         currClass = o;\n259:     }\n260: \n261:     /**\n262:      * @param o the object to be generated\n263:      * @return the generated string\n264:      */\n265:     public static String cppGenerate(Object o) {\n266:         return getInstance().generate(o);\n267:     }\n268: \n269: \n270:     /** Internal helper that generates the file content (.cpp or .h)\n271:      * and returns it as a String, without actually creating a file.\n272:      */\n273:     private String generateFileAsString(Object o, String pathname) {\n274:         setupGenerator(o);\n275:         if (generatorPass == SOURCE_PASS \n276:                 && Model.getFacade().isAInterface(o))\n277:             return \"\"; // don't generate the .cpp, it's useless.\n278: \n279:         String headerTop = generateHeaderTop(pathname);\n280:         String header = generateHeader(o);\n281:         String src = generate(o);\n282:         String footer = generateFooter();\n283:         // generate #includes and predeclarations\n284:         // this must be *after* generate()\n285:         StringBuffer incl = new StringBuffer();\n286:         if (generatorPass == SOURCE_PASS) {\n287:             localInc.add(Model.getFacade().getName(o) + \".h\");\n288:         }\n289:         generateIncludes(incl);\n290:         if (generatorPass == HEADER_PASS) {\n291:             if (incl.length() > 0) incl.append(LINE_SEPARATOR);\n292:             generatePredeclare(incl);\n293:         }\n294:         // paste all the pieces in the final result\n295:         StringBuffer result = new StringBuffer();\n296:         if (generatorPass == HEADER_PASS) {\n297:             String name = Model.getFacade().getName(o);\n298:             String guardPack =\n299:                 generateRelativePackage(o, null, \"_\").substring(1);\n300:             String guard = name + getFileExtension().replace('.', '_');\n301:             if (guardPack.length() > 0) {\n302:                 guard = guardPack + \"_\" + guard;\n303:             }\n304:             result.append(\"#ifndef \" + guard + LINE_SEPARATOR \n305:                       + \"#define \" + guard \n306:                       + LINE_SEPARATOR + LINE_SEPARATOR);\n307:         }\n308:         result.append(headerTop);\n309:         result.append(incl.toString());\n310:         result.append(header);\n311:         result.append(src);\n312:         result.append(footer);\n313:         if (generatorPass == HEADER_PASS) {\n314:             result.append(\"#endif\");\n315:             result.append(LINE_SEPARATOR);\n316:         }\n317:         return result.toString();\n318:     }\n319: \n320:     /**\n321:      * Generate the source code (.cpp) for the given object\n322:      * @param o the object to be generated\n323:      * @return the generated code as a string\n324:      */\n325:     public String generateCpp(Object o) {\n326:         generatorPass = SOURCE_PASS;\n327:         String name =\n328:             generateRelativePackage(o, null, \"/\").substring(1);\n329:         if (name.length() > 0) name += \"/\";\n330:         name += Model.getFacade().getName(o) + \".cpp\";\n331:         String ret = generateFileAsString(o, name);\n332:         cleanupGenerator();\n333:         generatorPass = NONE_PASS;\n334:         return ret;\n335:     }\n336: \n337:     /**\n338:      * Generate the header code (.h) for the given object\n339:      * @param o the object to be generated\n340:      * @return the generated header as a string\n341:      */\n342:     public String generateH(Object o) {\n343:         generatorPass = HEADER_PASS;\n344:         String name =\n345:             generateRelativePackage(o, null, \"/\").substring(1);\n346:         if (name.length() > 0) name += \"/\";\n347:         name += Model.getFacade().getName(o) + \".h\";\n348:         String ret = generateFileAsString(o, name);\n349:         cleanupGenerator();\n350:         generatorPass = NONE_PASS;\n351:         return ret;\n352:     }\n353: \n354:     /**\n355:      * Generate the package name for the specified object,\n356:      * relative to the specified package. Use sep as the\n357:      * package separator. \n358:      * @param o Object to generate the path for\n359:      * @param pack Generate path relative to this package\n360:      * @param sep package separator\n361:      * @return path relative to pack, if pack is a parent of\n362:      *         cls, else relative to the project root. If the\n363:      *         path is relative to the project root, it's prefixed\n364:      *         with sep.\n365:      */\n366:     private String generateRelativePackage(Object o, Object pack,\n367:                                            String sep) {\n368:         StringBuffer packagePath = new StringBuffer();\n369:         // avoid model being used as a package name\n370:         Object parent = Model.getFacade().getNamespace(o);\n371: \n372:         while (parent != null && parent != pack) {\n373:             // ommit root package name; it's the model's root\n374:             Object grandParent = Model.getFacade().getNamespace(parent); \n375:             if (grandParent != null) {\n376:                 String name = Model.getFacade().getName(parent);\n377:                 if (packagePath.length() > 0) {\n378:                     packagePath.insert(0, sep);\n379:                 }\n380:                 packagePath.insert(0, name);\n381:             }\n382:             parent = grandParent;\n383:         }\n384:         if (parent == null) { // relative to root, prefix with sep\n385:             packagePath.insert(0, sep);\n386:         }\n387:        return packagePath.toString();\n388:     }\n389: \n390:     /** 2002-11-28 Achim Spangler\n391:      * @return file extension for actual generation pass\n392:      */\n393:     private String getFileExtension() {\n394:         if (generatorPass == HEADER_PASS) return \".h\";\n395:         return \".cpp\";\n396:     }\n397: \n398:     /**\n399:      * Generates the relative path for the specified classifier.\n400:      * @param cls The classifier. \n401:      * @return Returns relative path of cls (without filename).\n402:      */\n403:     private String generatePath(Object cls) {\n404:         String packagePath =\n405:             generateRelativePackage(cls, null, CodeGenerator.FILE_SEPARATOR);\n406:         packagePath = packagePath.substring(1);\n407:         return packagePath;\n408:     }\n409: \n410:     /**\n411:      * create the needed directories for the derived appropriate pathname\n412:      * @return Returns the filename with full path of cls.\n413:      */\n414:     private String createDirectoriesPathname(Object o, String path) {\n415:         String name = Model.getFacade().getName(o);\n416:         if (name == null || name.length() == 0) {\n417:             return \"\";\n418:         }\n419: \n420:         if (!path.endsWith (CodeGenerator.FILE_SEPARATOR)) {\n421:             path += CodeGenerator.FILE_SEPARATOR;\n422:         }\n423: \n424:         String packagePath = generateRelativePackage(o, null, \".\");\n425:         packagePath = packagePath.substring(1);\n426:         String filename = name + getFileExtension();\n427: \n428:         int lastIndex = -1;\n429:         do {\n430:             File f = new File (path);\n431:             if (!f.isDirectory()) {\n432:                 if (!f.mkdir()) {\n433:                     LOG.error(\" could not make directory \" + path);\n434:                     return null;\n435:                 }\n436:             }\n437: \n438:             if (lastIndex == packagePath.length()) {\n439:                 break;\n440:             }\n441: \n442:             int index = packagePath.indexOf (\".\", lastIndex + 1);\n443:             if (index == -1) {\n444:                 index = packagePath.length();\n445:             }\n446: \n447:             path += packagePath.substring(lastIndex + 1, index)\n448:                 + CodeGenerator.FILE_SEPARATOR;\n449:             lastIndex = index;\n450:         } while (true);\n451: \n452:         String pathname = path + filename;\n453:         //LOG.info(\"-----\" + pathname + \"-----\");\n454:         return pathname;\n455:     }\n456: \n457:     /* Returns true if the given object is a class (or interface) within\n458:      * another class (not within a package).\n459:      */\n460:     private static boolean isAInnerClass(Object cls) {\n461:         Object parent = Model.getFacade().getNamespace(cls);\n462:         return parent != null && !Model.getFacade().isAPackage(parent);\n463:     }\n464: \n465:     /** 2002-12-07 Achim Spangler\n466:      * @return date\n467:      */\n468:     private String getDate() {\n469:         GregorianCalendar cal = new GregorianCalendar();\n470:         DateFormat df;\n471:         df = DateFormat.getDateInstance(DateFormat.DEFAULT);\n472:         return df.format(cal.getTime());\n473:     }\n474: \n475:     /** 2002-12-07 Achim Spangler\n476:      * @return year\n477:      */\n478:     private String getYear() {\n479:         GregorianCalendar cal = new GregorianCalendar();\n480:         return Integer.toString(cal.get(Calendar.YEAR));\n481:     }\n482: \n483:     /** 2002-12-07 Achim Spangler\n484:      * write template content on top of file\n485:      */\n486:     private void writeTemplate(Object cls, String path, BufferedWriter fos) {\n487:         String templatePathName = path + \"/templates/\";\n488:         String fileName = Model.getFacade().getName(cls);\n489:         String tagTemplatePathName =\n490:             Model.getFacade().getTaggedValueValue(cls, \"TemplatePath\");\n491:         String authorTag = Model.getFacade().getTaggedValueValue(cls, \"author\");\n492:         String emailTag = Model.getFacade().getTaggedValueValue(cls, \"email\");\n493:         if (tagTemplatePathName != null && tagTemplatePathName.length() > 0)\n494:             templatePathName = tagTemplatePathName;\n495:         if (generatorPass == HEADER_PASS) {\n496:             templatePathName = templatePathName + \"header_template\";\n497:             fileName = fileName + \".h\";\n498:         }\n499:         else {\n500:             templatePathName = templatePathName + \"cpp_template\";\n501:             fileName = fileName + \".cpp\";\n502:         }\n503:         \n504:         File templateFile = new File(templatePathName);\n505:         if (templateFile.exists()) {\n506:             boolean eof = false;\n507:             BufferedReader templateFileReader = null;\n508:             try {\n509:                 templateFileReader =\n510:                     new BufferedReader(new FileReader(\n511:                         templateFile.getAbsolutePath()));\n512:                 while (!eof) {\n513:                     String lineStr = templateFileReader.readLine();\n514:                     if (lineStr == null) {\n515:                         eof = true;\n516:                     } else {\n517:                         StringBuffer line = new StringBuffer(lineStr);\n518:                         replaceToken(line, \"|FILENAME|\", fileName);\n519:                         replaceToken(line, \"|DATE|\", getDate());\n520:                         replaceToken(line, \"|YEAR|\", getYear());\n521:                         replaceToken(line, \"|AUTHOR|\", authorTag);\n522:                         replaceToken(line, \"|EMAIL|\", emailTag);\n523: \n524:                         fos.write(line + LINE_SEPARATOR);\n525:                     }\n526:                 }\n527:                 templateFileReader.close();\n528:             }\n529:             catch (IOException exp) { }\n530:             finally {\n531:                 try {\n532:                     if (templateFileReader != null) templateFileReader.close();\n533:                 }\n534:                 catch (IOException exp) {\n535:                     LOG.error(\"FAILED: \" + templateFile.getPath());\n536:                 }\n537:             }\n538:         }\n539:     }\n540: \n541:     /**\n542:      * Replace the first occurences of tokenName with tokenValue.\n543:      *\n544:      * @param line is the line where we do the replacing.\n545:      * @param tokenName is the string we search for.\n546:      * @param tokenValue is the value we replace.\n547:      */\n548:     private void replaceToken(StringBuffer line, String tokenName,\n549:             String tokenValue) {\n550:         int tokenStart;\n551:         tokenStart = line.toString().indexOf(tokenName);\n552:         if ((tokenStart != -1)\n553:             && (tokenValue != null && tokenValue.length() > 0)) {\n554:             line.replace(tokenStart,\n555:                  tokenStart + tokenName.length(),\n556:                  tokenValue);\n557:         }\n558:     }\n559: \n560:     /** 2002-11-28 Achim Spangler\n561:      * seperate constant Header Top into function\n562:      */\n563:     private String generateHeaderTop(String pathname) {\n564:         StringBuffer sb = new StringBuffer(80);\n565:         //TODO: add user-defined copyright\n566:         if (verboseDocs) {\n567:             sb.append(\"// FILE: \").append(pathname.replace('\\\\', '/'));\n568:             sb.append(LINE_SEPARATOR).append(LINE_SEPARATOR);\n569:         }\n570:         return sb.toString();\n571:     }\n572: \n573:     /** Helper for checkIncludeNeeded4Element. Returns true if\n574:      * an #include is needed.\n575:      */\n576:     private boolean checkInclude4UsageIndirection(boolean isIndirect,\n577:             String usageTag) {\n578:         if (isIndirect) {\n579:             // needs only to be included in the .cpp\n580:             if (usageTag.indexOf(\"header\") != -1) {\n581:                 // but user explicitly requested its presence in the header\n582:                 return generatorPass == HEADER_PASS;\n583:             } else {\n584:                 return generatorPass == SOURCE_PASS;\n585:             }\n586:         }\n587: \n588:         // must be included in the header, whatever usageTag is\n589:         return generatorPass == HEADER_PASS;\n590:     }\n591: \n592:     private boolean checkIncludeNeeded4Element(Object cls) {\n593:         String usageTag = \"\";\n594:         boolean predeclareCandidate = false;\n595: \n596:         Iterator iter = Model.getFacade().getTaggedValues(cls);\n597:         while (iter.hasNext()) {\n598:             Object tv = iter.next();\n599:             String tag = Model.getFacade().getTagOfTag(tv);\n600:             if (tag.equals(\"usage\")) {\n601:                 usageTag = Model.getFacade().getValueOfTag(tv);\n602:             }\n603: \n604:             if (tag.indexOf(\"ref\") != -1 || tag.equals(\"&\")\n605:                     || tag.indexOf(\"pointer\") != -1 || tag.equals(\"*\")) {\n606:                 predeclareCandidate = true;\n607:             }\n608:         }\n609:         return checkInclude4UsageIndirection(predeclareCandidate, usageTag);\n610:     }\n611: \n612:     private StringBuffer generateIncludes(StringBuffer sb) {\n613:         for (Iterator it = systemInc.iterator(); it.hasNext(); ) {\n614:             String inc = (String) it.next();\n615:             sb.append(\"#include <\");\n616:             sb.append(inc).append('>').append(LINE_SEPARATOR);\n617:         }\n618:         // separate system from external headers\n619:         if (systemInc.size() > 0) sb.append(LINE_SEPARATOR);\n620:         for (Iterator it = extInc.iterator(); it.hasNext(); ) {\n621:             String inc = (String) it.next();\n622:             sb.append(\"#include <\");\n623:             sb.append(inc).append('>').append(LINE_SEPARATOR);\n624:         }\n625:         // separate external from local headers\n626:         if (extInc.size() > 0) sb.append(LINE_SEPARATOR);\n627:         for (Iterator it = localInc.iterator(); it.hasNext(); ) {\n628:             String inc = (String) it.next();\n629:             sb.append(\"#include \\\"\").append(inc).append(\"\\\"\\n\");\n630:         }\n631:         return sb;\n632:     }\n633: \n634:     private StringBuffer generatePredeclare(StringBuffer sb) {\n635:         for (Iterator it = predeclCls.iterator(); it.hasNext(); ) {\n636:             Object cls = it.next();\n637:             String name = Model.getFacade().getName(cls);\n638:             sb.append(generateHeaderPackageStart(cls));\n639:             sb.append(\"class \").append(name);\n640:             sb.append(\";\").append(LINE_SEPARATOR);\n641:         }\n642:         sb.append(generateHeaderPackageEnd());\n643:         return sb;\n644:     }\n645: \n646:     /**\n647:      * Parses header_incl or source_incl tags and adds the\n648:      * user-speficied headers to localInc or systemInc.\n649:      * @param cls The classifier which code is being generated for.\n650:      * @param source if true parses source_incl tags, else header_incl.\n651:      */\n652:     private void addUserHeaders(Object cls, boolean source) {\n653:         Iterator iter = Model.getFacade().getTaggedValues(cls);\n654:         String tagPrefix;\n655:         if (source)\n656:             tagPrefix = \"source\";\n657:         else\n658:             tagPrefix = \"header\";\n659:             \n660:         while (iter.hasNext()) {\n661:             Object tv = iter.next();\n662:             String tag = Model.getFacade().getTagOfTag(tv);\n663:             if (tag.equals(tagPrefix + \"_incl\")\n664:                     || tag.equals(tagPrefix + \"_include\")) {\n665:                 String name = Model.getFacade().getValueOfTag(tv);\n666:                 if (name.length() > 2 && name.charAt(0) == '<') {\n667:                     systemInc.add(name.substring(1, name.length() - 1));\n668:                 } else if (name.length() > 2 && name.charAt(0) == '\"') {\n669:                     localInc.add(name.substring(1, name.length() - 1));\n670:                 } else if (name.length() > 0) { // skip empty values\n671:                     localInc.add(name);\n672:                 }\n673:             }\n674:         }\n675:     }\n676: \n677:     /**\n678:      * Adds dep to the set of dependencies of currClass. If predecl\n679:      * then only a predeclaration is generated, else an #include.\n680:      * @param dep The classifier whose currClass depends on.\n681:      * @param predecl If true then only a predeclaration is needed\n682:      */\n683:     private void addDependency(Object dep, boolean predecl) {\n684:         if (generatorPass == NONE_PASS) {\n685:             return; // skip dependencies if generating notation\n686:         }\n687:         if (!(Model.getFacade().isAClass(dep))\n688:             && !(Model.getFacade().isAInterface(dep))) {\n689:             // Do nothing for things such as datatypes, etc.\n690:             // TODO: check for namespace when using directives are implemented\n691:             return;\n692:         }\n693:         if (predecl && !includeCls.contains(dep)) {\n694:             if (generatorPass == HEADER_PASS) {\n695:                 predeclCls.add(dep);\n696:             }\n697:         } else {\n698:             if (predeclCls.contains(dep)) {\n699:                 predeclCls.remove(dep);\n700:             }\n701:             if (includeCls.add(dep)) {\n702:                 // dep was not already in includeCls\n703:                 Object ns = Model.getFacade().getNamespace(currClass);\n704:                 String name = Model.getFacade().getName(dep);\n705:                 // use '/', not FILE_SEPARATOR (this is intentional)\n706:                 String path =\n707:                     generateRelativePackage(dep, ns, \"/\");\n708:                 Set inc = localInc;\n709:                 if (path.startsWith(\"/\")) { // external include\n710:                     path = path.substring(1); // remove leading /\n711:                     inc = extInc;\n712:                 }\n713:                 if (path.length() > 0) {\n714:                     inc.add(path + \"/\" + name + \".h\");\n715:                 } else {\n716:                     inc.add(name + \".h\");\n717:                 }\n718:             }\n719:         }\n720:     }\n721: \n722:     private String generateHeaderPackageStartSingle(Object pkg) {\n723:         StringBuffer sb = new StringBuffer(30);\n724:         String packageName = Model.getFacade().getName(pkg);\n725:         StringTokenizer st = new StringTokenizer(packageName, \".\");\n726:         String token = \"\";\n727: \n728:         sb.append(generateTaggedValues(pkg, DOC_COMMENT_TAGS));\n729:         while (st.hasMoreTokens()) {\n730:             token = st.nextToken();\n731:             // create line: namespace FOO {\"\n732:             sb.append(\"namespace \").append(token).append(\" {\")\n733:                 .append(LINE_SEPARATOR);\n734:         }\n735:         return sb.toString();\n736:     }\n737: \n738:     private String generateHeaderPackageEndSingle(Object pkg) {\n739:         StringBuffer sb = new StringBuffer(30);\n740:         String packageName = Model.getFacade().getName(pkg);\n741:         StringTokenizer st = new StringTokenizer(packageName, \".\");\n742:         String token = \"\";\n743:         while (st.hasMoreTokens()) {\n744:             token = st.nextToken();\n745:             StringBuffer tempBuf = new StringBuffer(20);\n746:             String absoluteName = generatePackageAbsoluteName(pkg);\n747:             if (absoluteName.indexOf(token) != -1) {\n748:                 absoluteName =\n749:                     absoluteName.substring(0,\n750:                                (absoluteName.indexOf(token)\n751:                                 + token.length()));\n752:             }\n753: \n754:             // create line: namespace FOO {\"\n755:             tempBuf.append(\"} /* End of namespace \").append(absoluteName);\n756:             tempBuf.append(\" */\").append(LINE_SEPARATOR);\n757:             sb.insert(0, tempBuf.toString());\n758:         }\n759:         return sb.toString();\n760:     }\n761: \n762:     private String generatePackageAbsoluteName(Object pkg) {\n763:         String pack = generateRelativePackage(pkg, null, \"::\");\n764:         pack = pack.substring(2); // remove leading ::\n765:         if (pack.length() > 0) {\n766:             pack += \"::\";\n767:         }\n768:         return pack + Model.getFacade().getName(pkg);\n769:     }\n770: \n771:     /** Generate the name of item with package prefix relative to localPkg.\n772:      * localPkg may be null, meaning the global namespace.\n773:      */\n774:     private String generateNameWithPkgSelection(Object item, Object localPkg) {\n775:         if (item == null) {\n776:             return \"void \";\n777:         }\n778:         Object pkg = null;\n779:         if (Model.getFacade().isADataType(item)) {\n780:             return generateName(Model.getFacade().getName(item));\n781:         } else if (Model.getFacade().isAParameter(item)\n782:                    || Model.getFacade().isAAttribute(item)\n783:                    || Model.getFacade().isAAssociationEnd(item)\n784:                    || Model.getFacade().isAClassifier(item)) {\n785:             pkg = getNamespaceWithoutModel(item);\n786:         }\n787: \n788:         if (pkg == null) {\n789:             return generateName(Model.getFacade().getName(item));\n790:         }\n791:         String packPrefix = generateRelativePackage(item, localPkg, \"::\");\n792:         if (packPrefix.length() > 0) {\n793:             packPrefix += \"::\";\n794:         }\n795:         return packPrefix + generateName(Model.getFacade().getName(item));\n796:     }\n797: \n798:     /** Generate name with package specs, relative to actualNamespace.\n799:      */\n800:     private String generateNameWithPkgSelection(Object item) {\n801:         Object pkg = actualNamespace;\n802:         String name = generateNameWithPkgSelection(item, pkg);\n803:         if (name.startsWith(\"::\")) {\n804:             name = name.substring(2); // remove leading ::\n805:             // the leading :: is just ugly to see, but it could\n806:             // be left there to emphasize that item is in the\n807:             // global namespace\n808:         }\n809:         return name;\n810:     }\n811: \n812:     /** Generate the code to go from the current namespace to cls's one\n813:      */\n814:     private String generateHeaderPackageStart(Object cls) {\n815:         StringBuffer sb = new StringBuffer(80);\n816: \n817:         if (actualNamespace != null) {\n818:             Object lastSearch = actualNamespace;\n819:             // iterate while fromSearch != null, but iterate one time\n820:             // when it is null too, because it's the global namespace\n821:             for (Object fromSearch = actualNamespace;\n822:                     fromSearch != null;\n823:                     lastSearch = getNamespaceWithoutModel(fromSearch)) {\n824:                 fromSearch = lastSearch;\n825:                 StringBuffer contPath = new StringBuffer(80);\n826:                 Object toSearch = getNamespaceWithoutModel(cls);\n827:                 for (; (toSearch != null) && (toSearch != fromSearch);\n828:                         toSearch = getNamespaceWithoutModel(toSearch)) {\n829:                     contPath.insert(0,\n830:                             generateHeaderPackageStartSingle(toSearch));\n831:                 }\n832:                 if (toSearch == fromSearch) {\n833:                     sb.append(contPath.toString());\n834:                     break;\n835:                 }\n836:                 // close one namespace\n837:                 sb.append(generateHeaderPackageEndSingle(fromSearch));\n838:             }\n839:         }\n840:         else { // initial start\n841:             for (Object toSearch = getNamespaceWithoutModel(cls);\n842:                     toSearch != null;\n843:                     toSearch = getNamespaceWithoutModel(toSearch)) {\n844:                 sb.insert(0, generateHeaderPackageStartSingle(toSearch));\n845:             }\n846:         }\n847:         actualNamespace = getNamespaceWithoutModel(cls);\n848:         return sb.toString();\n849:     }\n850: \n851:     /**\n852:      * Retrieve the namespace of the given model element, excluding the model,\n853:      * which shouldn't be considered a namespace.\n854:      * @param me the model element for which to get the namespace\n855:      * @return the namespace if it exists or null if the model is the\n856:      * containing namespace for <code>me</code>\n857:      */\n858:     private Object getNamespaceWithoutModel(Object me) {\n859:         Object parent = Model.getFacade().getNamespace(me);\n860:         if (parent != null && Model.getFacade().getNamespace(parent) != null) \n861:             return parent;\n862:         return null;\n863:     }\n864: \n865:     private String generateHeaderPackageEnd() {\n866:         StringBuffer sb = new StringBuffer(20);\n867: \n868:         for (Object closeIt = actualNamespace;\n869:                 closeIt != null;\n870:                 closeIt = getNamespaceWithoutModel(closeIt)) {\n871:             sb.append(generateHeaderPackageEndSingle(closeIt));\n872:         }\n873:         actualNamespace = null;\n874:         return sb.toString();\n875:     }\n876: \n877:     /* This generates the file internal header, not the .h file!\n878:      * That is, things before the class declaration.\n879:      */\n880:     private String generateHeader(Object cls) {\n881:         StringBuffer sb = new StringBuffer(240);\n882: \n883:         addUserHeaders(cls, generatorPass == SOURCE_PASS);\n884: \n885:         if (getNamespaceWithoutModel(cls) != null) {\n886:             String pkgstart = generateHeaderPackageStart(cls);\n887:             if (pkgstart.length() > 0) {\n888:                 sb.append(LINE_SEPARATOR);\n889:                 sb.append(pkgstart);\n890:             }\n891:         }\n892: \n893:         return sb.toString();\n894:     }\n895: \n896:     /* This generates all the things that go after the class declaration.\n897:      */\n898:     private String generateFooter() {\n899:         StringBuffer sb = new StringBuffer(80);\n900:         sb.append(generateHeaderPackageEnd());\n901:         if (sb.length() > 0) {\n902:             sb.insert(0, LINE_SEPARATOR);\n903:         }\n904:         return sb.toString();\n905:     }\n906: \n907:     /**\n908:      * <p>Generate code for an extension point.</p>\n909:      *\n910:      * <p>Provided to comply with the interface, but returns null\n911:      *   since no code will be generated. This should prevent a source tab\n912:      *   being shown.</p>\n913:      *\n914:      * @param ep  The extension point to generate for\n915:      *\n916:      * @return    The generated code string. Always empty in this\n917:      *            implementation.\n918:      */\n919:     public String generateExtensionPoint (Object ep) {\n920:         return null;\n921:     }\n922: \n923:     /**\n924:      * @see org.argouml.application.api.NotationProvider2#generateAssociationRole(java.lang.Object)\n925:      */\n926:     public String generateAssociationRole(Object m) {\n927:         return \"\";\n928:     }\n929: \n930: \n931:     /**\n932:      * @see org.argouml.application.api.NotationProvider2#generateSubmachine(java.lang.Object)\n933:      */\n934:     public String generateSubmachine(Object m) {\n935:         Object c = Model.getFacade().getSubmachine(m);\n936:         if (c == null) {\n937:             return \"include / \";\n938:         }\n939:         if (Model.getFacade().getName(c) == null) {\n940:             return \"include / \";\n941:         }\n942:         if (Model.getFacade().getName(c).length() == 0) {\n943:             return \"include / \";\n944:         }\n945:         return (\"include / \" + generateName(Model.getFacade().getName(c)));\n946:     }\n947: \n948:     \n949:     /**\n950:      * @see org.argouml.application.api.NotationProvider2#generateObjectFlowState(java.lang.Object)\n951:      */\n952:     public String generateObjectFlowState(Object m) {\n953:         Object c = Model.getFacade().getType(m);\n954:         if (c == null) return \"\";\n955:         return Model.getFacade().getName(c);\n956:     }\n957: \n958:     /** 2002-11-28 Achim Spangler\n959:      * seperate generation of Operation Prefix from generateOperation\n960:      * so that generateOperation is language independent\n961:      */\n962:     private String generateOperationPrefix(Object op) {\n963:         StringBuffer sb = new StringBuffer(80);\n964:         // c++ doesn't have any builtin construct for concurrency\n965:         //sb.append(generateConcurrency(op));\n966:         if (generatorPass != SOURCE_PASS) {\n967:             // make all operations to virtual - as long as they are not \"leaf\"\n968:             Object scope = Model.getFacade().getOwnerScope(op);\n969:             if (Model.getFacade().isLeaf(op)\n970:                     && !Model.getFacade().isRoot(op)) {\n971:                 // there's no way to make a leaf method that it's not root in\n972:                 // c++, so warn the user and ignore the 'root' attribute\n973:                 // (or it may be better to ignore the 'leaf' attribute?)\n974:                 LOG.warn(op + \" is leaf but not root: \"\n975:                          + \"C++ can't handle this properly\");\n976:                 LOG.warn(\"    Ignoring the 'root' attribute\");\n977:             }\n978:             // generate a function as virtual, if it can be overriden\n979:             // or override another function AND if this function is\n980:             // not marked as static, which disallows \"virtual\"\n981:             // alternatively every abstract function is defined as\n982:             // virtual\n983:             if ((!Model.getFacade().isLeaf(op)\n984:                     && !Model.getFacade().isConstructor(op)\n985:                     && (!(Model.getScopeKind().getClassifier().equals(scope))))\n986:                     || (Model.getFacade().isAbstract(op))) {\n987:                 sb.append(\"virtual \");\n988:             }\n989:             sb.append(generateOwnerScope(op));\n990:         }\n991:         return sb.toString();\n992:     }\n993: \n994:     /** 2002-11-28 Achim Spangler\n995:      * seperate generation of Operation Suffix from generateOperation\n996:      * so that generateOperation is language independent\n997:      */\n998:     private String generateOperationSuffix(Object op) {\n999:         StringBuffer sb = new StringBuffer(80);\n1000:         sb.append(generateOperationChangeability(op));\n1001:         sb.append(generateAbstractness(op));\n1002:         return sb.toString();\n1003:     }\n1004: \n1005:     /** 2002-11-28 Achim Spangler\n1006:      * seperate generation of Operation Name from generateOperation\n1007:      * so that generateOperation is language independent\n1008:      * -> for C++: if we create .cpp we must prepend Owner name\n1009:      *\n1010:      * @param sb Where to put the result.\n1011:      */\n1012:     private boolean generateOperationNameAndTestForConstructor(Object op,\n1013:             StringBuffer sb) {\n1014:         if (generatorPass == SOURCE_PASS) {\n1015:             Object cls = Model.getFacade().getOwner(op);\n1016:             String prefix = new String();\n1017:             while (!Model.getFacade().isAPackage(cls)) {\n1018:                 prefix = Model.getFacade().getName(cls) + \"::\" + prefix;\n1019:                 cls = Model.getFacade().getNamespace(cls);\n1020:             }\n1021:             sb.append(prefix);\n1022:         }\n1023:         boolean constructor = false;\n1024:         String name;\n1025:         if (Model.getFacade().isConstructor(op)) {\n1026:             // constructor\n1027:             name = Model.getFacade().getName(Model.getFacade().getOwner(op));\n1028:             constructor = true;\n1029:         } else {\n1030:             name = Model.getFacade().getName(op);\n1031:         }\n1032:         sb.append(generateName(name));\n1033:         return constructor;\n1034:     }\n1035: \n1036:     /**\n1037:      * @see org.argouml.application.api.NotationProvider2#generateOperation(\n1038:      *      java.lang.Object, boolean)\n1039:      *\n1040:      * 2002-11-28 Achim Spangler\n1041:      * modified version from Jaap Branderhorst\n1042:      * -> generateOperation is language independent and seperates\n1043:      *    different tasks\n1044:      */\n1045:     public String generateOperation(Object op, boolean documented) {\n1046:         // generate nothing for abstract functions, if we generate the\n1047:         // source .cpp file at the moment\n1048:         if ((generatorPass == SOURCE_PASS) \n1049:                 && (Model.getFacade().isAbstract(op))) {\n1050:             return \"\";\n1051:         }\n1052:         StringBuffer sb = new StringBuffer(80);\n1053:         StringBuffer nameBuffer = new StringBuffer(20);\n1054:         String operationIndent = (generatorPass == HEADER_PASS) ? indent : \"\";\n1055:         boolean constructor =\n1056:             generateOperationNameAndTestForConstructor(op, nameBuffer);\n1057: \n1058:         // if generating a file always document\n1059:         if (documented || generatorPass != NONE_PASS) {\n1060:             // generate DocComment from tagged values\n1061:             String tv = generateTaggedValues (op, DOC_COMMENT_TAGS);\n1062:             if (tv != null && tv.length() > 0) {\n1063:                 sb.append (LINE_SEPARATOR).append(operationIndent).append (tv);\n1064:             }\n1065:         }\n1066: \n1067:         sb.append(operationIndent)\n1068:             .append(generateOperationPrefix(op));\n1069: \n1070:         // pick out return type\n1071:         Object rp = Model.getCoreHelper().getReturnParameter(op);\n1072:         if (!constructor) {\n1073:             if (rp != null) {\n1074:                 Object returnType = Model.getFacade().getType(rp);\n1075:                 if (returnType == null) {\n1076:                     sb.append(\"void \");\n1077:                 }\n1078:                 else if (returnType != null) {\n1079:                     sb.append(generateNameWithPkgSelection(returnType))\n1080:                         .append(' ');\n1081:                     /* fixing 2862 - apply modifiers, \n1082:                      * i.e. pointer or reference TV */\n1083:                     sb.append(generateAttributeParameterModifier(rp));\n1084:                 }\n1085:                 boolean predecl = !checkIncludeNeeded4Element(rp);\n1086:                 addDependency(returnType, predecl);\n1087:             }\n1088:         }\n1089: \n1090:         // name and params\n1091:         Vector params = new Vector(Model.getFacade().getParameters(op));\n1092:         params.remove(rp); // If there are several return parameters, just\n1093:                            // the one found above will be removed.\n1094: \n1095:         sb.append(nameBuffer.toString()).append('(');\n1096: \n1097:         if (params != null) {\n1098:             boolean first = true;\n1099: \n1100:             for (int i = 0; i < params.size(); i++) {\n1101:                 Object p = params.elementAt (i);\n1102: \n1103:                 if (!first) sb.append(\", \");\n1104: \n1105:                 sb.append(generateParameter(p));\n1106:                 first = false;\n1107:             }\n1108:         }\n1109: \n1110:         String suffix = generateOperationSuffix(op);\n1111:         if (suffix.equals(\"\"))\n1112:             sb.append(\")\");\n1113:         else\n1114:             sb.append(\") \").append(suffix);\n1115: \n1116:         return sb.toString();\n1117:     }\n1118: \n1119:     /** 2002-12-06 Achim Spangler\n1120:      * check if a parameter is tagged as pointer or reference (not\n1121:      * part of UML - as far as author knows - but important for C++\n1122:      * developers)\n1123:      * @param elem element to check\n1124:      * @return one of NORMAL_MOD, REFERENCE_MOD, POINTER_MOD, or -1 if\n1125:      *         no specific tag is found\n1126:      */\n1127:     private int getAttributeModifierType(Object elem) {\n1128:         // first check whether the parameter shall be a pointer of reference\n1129:         Iterator iter = Model.getFacade().getTaggedValues(elem);\n1130:         while (iter.hasNext()) {\n1131:             Object tv = iter.next();\n1132:             String tag = Model.getFacade().getTagOfTag(tv);\n1133:             String val = Model.getFacade().getValueOfTag(tv);\n1134:             if (tag.indexOf(\"ref\") != -1 || tag.equals(\"&\")) {\n1135:                 return val.equals(\"false\") ? NORMAL_MOD\n1136:                                            : REFERENCE_MOD;\n1137:             } else if (tag.indexOf(\"pointer\") != -1 || tag.equals(\"*\")) {\n1138:                 return val.equals(\"false\") ? NORMAL_MOD\n1139:                                            : POINTER_MOD;\n1140:             }\n1141:         }\n1142:         return -1; /* no tag found */\n1143:     }\n1144: \n1145: \n1146:     private String generateAttributeParameterModifier(Object attr,\n1147:                                                       String def) {\n1148:         int modType = getAttributeModifierType(attr);\n1149: \n1150:         // if attr has an abstract type it must be pointer or reference\n1151:         if (modType == NORMAL_MOD || modType == -1) {\n1152:             // this is used for association classes to; skip them\n1153:             if (!Model.getFacade().isAAssociationClass(attr)) {\n1154:                 Object type = Model.getFacade().getType(attr);\n1155:                 if (type == null) {\n1156:                     // model corrupt (this really happened -- aslo)\n1157:                     LOG.error(attr + \" has no type!\");\n1158:                     return \"\";\n1159:                 }\n1160:                 if (Model.getFacade().isAbstract(type)\n1161:                     || Model.getFacade().isAInterface(type)) {\n1162:                     if (modType == NORMAL_MOD) {\n1163:                         // user explicitly requested no modifier\n1164:                         LOG.warn(\"Requested no reference or pointer \"\n1165:                                 + \"modifier, but\");\n1166:                         LOG.warn(\"\\t\" + type + \" cannot be instantiated, \"\n1167:                                 + \"using reference\");\n1168:                     }\n1169:                     modType = REFERENCE_MOD;\n1170:                 }\n1171:             }\n1172:         }\n1173: \n1174:         if (modType == NORMAL_MOD) {\n1175:             return \"\";\n1176:         } else if (modType == REFERENCE_MOD) {\n1177:             return \"&\";\n1178:         } else if (modType == POINTER_MOD) {\n1179:             return \"*\";\n1180:         } else if (def.length() == 0) {\n1181:             if (Model.getFacade().isAParameter(attr)\n1182:                     && (Model.getDirectionKind().getOutParameter().equals(\n1183:                         Model.getFacade().getKind(attr))\n1184:                     || Model.getDirectionKind().getInOutParameter().equals(\n1185:                         Model.getFacade().getKind(attr)))) {\n1186:                 // out or inout parameters are defaulted to reference if\n1187:                 // not specified else\n1188:                 return \"&\";\n1189:             }\n1190:         }\n1191:         return def;\n1192:     }\n1193: \n1194:     private String generateAttributeParameterModifier(Object attr) {\n1195:         return generateAttributeParameterModifier(attr, \"\");\n1196:     }\n1197: \n1198:     /**\n1199:      * @see org.argouml.application.api.NotationProvider2#generateAttribute(\n1200:      *         java.lang.Object, boolean)\n1201:      */\n1202:     public String generateAttribute(Object attr, boolean documented) {\n1203:         StringBuffer sb = new StringBuffer(80);\n1204: \n1205:         // list tagged values for documentation\n1206:         if (documented || generatorPass != NONE_PASS) {\n1207:             String tv = generateTaggedValues (attr, DOC_COMMENT_TAGS);\n1208:             if (tv != null && tv.length() > 0) {\n1209:                 sb.append (LINE_SEPARATOR).append (indent).append (tv);\n1210:             }\n1211:         }\n1212:         // cat.info(\"generate Visibility for Attribute\");\n1213:         sb.append(generateVisibility(attr));\n1214:         sb.append(generateOwnerScope(attr));\n1215:         sb.append(generateStructuralFeatureChangeability(attr));\n1216:         sb.append(\n1217:                 generateMultiplicity(\n1218:                         attr,\n1219:                         generateName(Model.getFacade().getName(attr)),\n1220:                         Model.getFacade().getMultiplicity(attr),\n1221:                         generateAttributeParameterModifier(attr)));\n1222:         sb.append(\";\");\n1223:         if (generatorPass != NONE_PASS)\n1224:             sb.append(LINE_SEPARATOR);\n1225: \n1226:         // add the type of the attribute in the dependency list\n1227:         boolean predecl = !checkIncludeNeeded4Element(attr);\n1228:         addDependency(Model.getFacade().getType(attr), predecl);\n1229: \n1230:         return sb.toString();\n1231:     }\n1232: \n1233: \n1234:     /**\n1235:      * @see org.argouml.application.api.NotationProvider2#generateParameter(java.lang.Object)\n1236:      */\n1237:     public String generateParameter(Object param) {\n1238:         StringBuffer sb = new StringBuffer(20);\n1239:         //TODO: qualifiers (e.g., const)\n1240:         // generate const for references or pointers which are\n1241:         // defined as IN - other qualifiers are not important for\n1242:         // C++ parameters\n1243:         Object type = Model.getFacade().getType(param);\n1244:         sb.append(generateParameterChangeability(param));\n1245:         //TODO: stereotypes...\n1246:         sb.append(generateNameWithPkgSelection(type));\n1247:         sb.append(' ');\n1248:         sb.append(generateAttributeParameterModifier(param));\n1249:         sb.append(generateName(Model.getFacade().getName(param)));\n1250: \n1251:         // insert default value, if we are generating the header or notation\n1252:         if (generatorPass != SOURCE_PASS) {\n1253:             Object defvalObj = Model.getFacade().getDefaultValue(param);\n1254:             if (defvalObj != null) {\n1255:                 String defval =\n1256:                     Model.getFacade().getBody(defvalObj).toString().trim();\n1257:                 if (defval.length() > 0) {\n1258:                     sb.append(\" = \").append(defval);\n1259:                 }\n1260:             }\n1261:         }\n1262: \n1263:         // add the type of the parameter in the dependency list\n1264:         boolean predecl = !checkIncludeNeeded4Element(param);\n1265:         addDependency(type, predecl);\n1266: \n1267:         return sb.toString();\n1268:     }\n1269: \n1270: \n1271:     /**\n1272:      * @see org.argouml.application.api.NotationProvider2#generatePackage(java.lang.Object)\n1273:      */\n1274:     public String generatePackage(Object p) {\n1275:         StringBuffer sb = new StringBuffer();\n1276:         String packName = \n1277:                 generateName(Model.getFacade().getName(p));\n1278:         sb.append(\"namespace \").append(packName).append(\" {\")\n1279:             .append(LINE_SEPARATOR);\n1280:         Collection ownedElements = Model.getFacade().getOwnedElements(p);\n1281:         if (ownedElements != null) {\n1282:             Iterator ownedEnum = ownedElements.iterator();\n1283:             while (ownedEnum.hasNext()) {\n1284:                 Object me = ownedEnum.next();\n1285:                 cleanupGenerator();\n1286:                 currClass = me;\n1287:                 actualNamespace = p;\n1288:                 generatorPass = HEADER_PASS;\n1289:                 sb.append(indentString(generate(me), 1));\n1290:                 sb.append(LINE_SEPARATOR).append(LINE_SEPARATOR);\n1291:             }\n1292:             cleanupGenerator();\n1293:             generatorPass = NONE_PASS;\n1294:         }\n1295:         else {\n1296:             sb.append(\"// no elements\");\n1297:         }\n1298:         sb.append(\"}\").append(LINE_SEPARATOR);\n1299:         return sb.toString();\n1300:     }\n1301: \n1302: \n1303:     /**\n1304:      * Generate the start sequence for a classifier. The start sequence is\n1305:      * everything from the preceding javadoc comment to the opening curly brace.\n1306:      * Start sequences are non-empty for classes and interfaces only.\n1307:      *\n1308:      * This method is intented for package internal usage only.\n1309:      *\n1310:      * @param cls the classifier for which to generate the start sequence\n1311:      *\n1312:      * @return the generated start sequence\n1313:      */\n1314:     StringBuffer generateClassifierStart(Object cls) {\n1315:         StringBuffer sb = new StringBuffer (80);\n1316: \n1317:         // don't create class-Start for implementation in .cpp\n1318:         if (generatorPass == SOURCE_PASS) return sb;\n1319: \n1320:         String sClassifierKeyword;\n1321:         if (Model.getFacade().isAClass(cls) \n1322:                 || Model.getFacade().isAInterface(cls)) {\n1323:             sClassifierKeyword = \"class\";\n1324:         } else {\n1325:             return null; // actors, use cases etc.\n1326:         }\n1327:         boolean hasBaseClass = false;\n1328: \n1329:         // Add the comments for this classifier first.\n1330:         sb.append(LINE_SEPARATOR)\n1331:             .append (DocumentationManager.getComments(cls));\n1332: \n1333:         // list tagged values for documentation\n1334:         String tv = generateTaggedValues (cls, DOC_COMMENT_TAGS);\n1335:         if (tv != null && tv.length() > 0) {\n1336:             sb.append (LINE_SEPARATOR).append (indent).append (tv);\n1337:         }\n1338: \n1339:         // add classifier keyword and classifier name\n1340:         sb.append(sClassifierKeyword).append(\" \");\n1341:         sb.append(generateName(Model.getFacade().getName(cls)));\n1342: \n1343:         // add base class/interface\n1344:         String baseClass =\n1345:             generateGeneralization(Model.getFacade().getGeneralizations(cls));\n1346:         if (!baseClass.equals (\"\")) {\n1347:             sb.append (\" : \")\n1348:                 .append (baseClass);\n1349:             hasBaseClass = true;\n1350:         }\n1351: \n1352:         // add implemented interfaces, if needed (uml: realizations)\n1353:         if (Model.getFacade().isAClass(cls)) {\n1354:             String interfaces = generateSpecification(cls);\n1355:             if (!interfaces.equals (\"\")) {\n1356:                 if (!hasBaseClass) sb.append (\" : \");\n1357:                 else sb.append (\", \");\n1358:                 sb.append (interfaces);\n1359:             }\n1360:         }\n1361: \n1362:         // add opening brace\n1363:         if (lfBeforeCurly)\n1364:             sb.append(LINE_SEPARATOR).append('{');\n1365:         else\n1366:             sb.append(\" {\");\n1367: \n1368:         // list tagged values for documentation\n1369:         tv = generateTaggedValues (cls, ALL_BUT_DOC_TAGS);\n1370:         if (tv != null && tv.length() > 0) {\n1371:             sb.append(LINE_SEPARATOR).append (indent).append (tv);\n1372:         }\n1373: \n1374:         return sb;\n1375:     }\n1376: \n1377:     private StringBuffer generateClassifierEnd(Object cls) {\n1378:         StringBuffer sb = new StringBuffer();\n1379:         if (Model.getFacade().isAClass(cls) \n1380:                 || Model.getFacade().isAInterface(cls)) {\n1381:             if ((verboseDocs) && (generatorPass != SOURCE_PASS)) {\n1382:                 String classifierkeyword = null;\n1383:                 if (Model.getFacade().isAClass(cls)) {\n1384:                     classifierkeyword = \"class\";\n1385:                 } else {\n1386:                     classifierkeyword = \"class\";\n1387:                 }\n1388:                 sb.append(LINE_SEPARATOR)\n1389:                     .append(\"//end of \")\n1390:                         .append(classifierkeyword)\n1391:                             .append(\" \").append(Model.getFacade().getName(cls))\n1392:                                 .append(LINE_SEPARATOR);\n1393:             }\n1394:             if (generatorPass != SOURCE_PASS)\n1395:                 sb.append(\"};\").append(LINE_SEPARATOR);\n1396:         }\n1397:         return sb;\n1398:     }\n1399: \n1400:     /**\n1401:      * Generate three parts under public, protected and private visibility,\n1402:      * adding the visibility keywords on top of each part. \n1403:      * @param parts the parts to output\n1404:      * @return the composed parts\n1405:      */\n1406:     private String generateAllParts(StringBuffer[] parts) {\n1407:         StringBuffer sb = new StringBuffer();\n1408:         // generate all parts in order: public, protected, private\n1409:         for (int i = 0; i < ALL_PARTS.length; i++) {\n1410:             if (parts[i].toString().trim().length() > 0) {\n1411:                 if (generatorPass != SOURCE_PASS) {\n1412:                     if (i != 0) sb.append(LINE_SEPARATOR);\n1413:                     sb.append(' ').append(PART_NAME[i]).append(':');\n1414:                     sb.append(LINE_SEPARATOR);\n1415:                 }\n1416:                 sb.append(parts[i]);\n1417:             }\n1418:         }\n1419:         return sb.toString();\n1420:     }\n1421:     \n1422:     private int getVisibilityPart(Object o) {\n1423:         if (Model.getFacade().isPublic(o)) {\n1424:             return PUBLIC_PART;\n1425:         } else if (Model.getFacade().isProtected(o)) {\n1426:             return PROTECTED_PART;\n1427:         } else if (Model.getFacade().isPrivate(o)) {\n1428:             return PRIVATE_PART;\n1429:         } else {\n1430:             LOG.warn(Model.getFacade().getName(o)\n1431:                     + \" is not public, nor protected, \"\n1432:                     + \"nor private!!! (ignored)\");\n1433:             return -1;\n1434:         }\n1435:     }\n1436:     \n1437:     /* Indent each line of the given string by n indent spaces.\n1438:      */\n1439:     private String indentString(String s, int n) {\n1440:         String ind = new String();\n1441:         for (; n > 0; n--)\n1442:             ind += indent;\n1443:         // This works only with jdk 1.5: return s.replace(\"\\n\", \"\\n\" + ind);\n1444:         StringBuffer result = new StringBuffer();\n1445:         for (int i = s.indexOf('\\n'); i != -1; i = s.indexOf('\\n')) {\n1446:             result.append(ind).append(s.substring(0, i + 1));\n1447:             s = s.substring(i + 1);\n1448:         }\n1449:         if (s.length() > 0) {\n1450:             result.append(ind).append(s);\n1451:         }\n1452:         return result.toString();\n1453:     }\n1454: \n1455:     /**\n1456:      * @see org.argouml.application.api.NotationProvider2#generateClassifier(java.lang.Object)\n1457:      *\n1458:      * Generates code for a classifier, for classes and interfaces only\n1459:      * at the moment.\n1460:      */\n1461:     public String generateClassifier(Object cls) {\n1462:         // If we're in the notation pane, do a special trick\n1463:         // to show both header and source\n1464:         if (generatorPass == NONE_PASS\n1465:                 && (Model.getFacade().isAClass(cls)\n1466:                     || Model.getFacade().isAInterface(cls))) {\n1467:             // for inner classes, show source of top level class\n1468:             // TODO: don't know if this is the best thing to do\n1469:             while (isAInnerClass(cls)) {\n1470:                 cls = Model.getFacade().getNamespace(cls);\n1471:             }\n1472:             StringBuffer sb = new StringBuffer();\n1473:             String name = Model.getFacade().getName(cls);\n1474:             sb.append(\"// \").append(name).append(\".h\");\n1475:             sb.append(LINE_SEPARATOR);\n1476:             sb.append(generateH(cls));\n1477:             if (Model.getFacade().isAClass(cls)) {\n1478:                 sb.append(LINE_SEPARATOR);\n1479:                 sb.append(\"// \").append(name).append(\".cpp\");\n1480:                 sb.append(LINE_SEPARATOR);\n1481:                 sb.append(generateCpp(cls));\n1482:             }\n1483:             return sb.toString();\n1484:         }\n1485:         \n1486:         StringBuffer returnValue = new StringBuffer();\n1487:         StringBuffer start = generateClassifierStart(cls);\n1488:         if (((start != null) && (start.length() > 0))\n1489:             || (generatorPass == SOURCE_PASS)) {\n1490:             StringBuffer typedefs = generateGlobalTypedefs(cls);\n1491:             StringBuffer body = generateClassifierBody(cls);\n1492:             StringBuffer end = generateClassifierEnd(cls);\n1493:             returnValue.append((typedefs != null) ? typedefs.toString() : \"\");\n1494:             returnValue.append(start);\n1495:             if ((body != null) && (body.length() > 0)) {\n1496:                 returnValue.append(LINE_SEPARATOR);\n1497:                 returnValue.append(body);\n1498:                 if (lfBeforeCurly) {\n1499:                     returnValue.append(LINE_SEPARATOR);\n1500:                 }\n1501:             }\n1502:             returnValue.append((end != null) ? end.toString() : \"\");\n1503:         }\n1504:         return returnValue.toString();\n1505:     }\n1506: \n1507:     /** 2002-12-12 Achim Spangler\n1508:      * generate global typedefs\n1509:      */\n1510:     private StringBuffer generateGlobalTypedefs(Object cls) {\n1511:         StringBuffer sb = new StringBuffer();\n1512:         if (Model.getFacade().isAClass(cls) \n1513:                 || Model.getFacade().isAInstance(cls)) {\n1514:             // add typedefs\n1515:             if (generatorPass == HEADER_PASS) {\n1516:                 Collection globalTypedefStatements =\n1517:                     findTagValues(cls, \"typedef_global_header\");\n1518:                 if (!globalTypedefStatements.isEmpty()) {\n1519:                     sb.append(\"// global type definitions for header defined \"\n1520:                               + \"by Tag entries in ArgoUML\");\n1521:                     sb.append(LINE_SEPARATOR);\n1522:                     sb.append(\"// Result: typedef <typedef_global_header> \"\n1523:                               + \"<tag_value>;\");\n1524:                     sb.append(LINE_SEPARATOR);\n1525:                     Iterator typedefEnum =\n1526:                         globalTypedefStatements.iterator();\n1527:                     while (typedefEnum.hasNext()) {\n1528:                         sb.append(\"typedef \").append(typedefEnum.next());\n1529:                         sb.append(\";\").append(LINE_SEPARATOR);\n1530:                     }\n1531:                 }\n1532:             }\n1533:             else {\n1534:                 Collection globalTypedefStatements =\n1535:                     findTagValues(cls, \"typedef_global_source\");\n1536:                 if (!globalTypedefStatements.isEmpty()) {\n1537:                     sb.append(\"// global type definitions for class \"\n1538:                             + \"implementation in source file defined by Tag \"\n1539:                             + \"entries in ArgoUML\");\n1540:                     sb.append(LINE_SEPARATOR);\n1541:                     sb.append(\"// Result: typedef <typedef_global_source> \"\n1542:                             + \"<tag_value>;\");\n1543:                     sb.append(LINE_SEPARATOR);\n1544:                     Iterator typedefEnum = globalTypedefStatements.iterator();\n1545:                     while (typedefEnum.hasNext()) {\n1546:                         sb.append(\"typedef \").append(typedefEnum.next());\n1547:                         sb.append(\";\").append(LINE_SEPARATOR);\n1548:                     }\n1549:                 }\n1550:             }\n1551:         }\n1552:         return sb;\n1553:     }\n1554: \n1555:     /**\n1556:      * Generates the attributes of the body of a class or interface.\n1557:      * @param cls\n1558:      * @param sb Where to put the result.\n1559:      */\n1560:     private void generateClassifierBodyAttributes(Object cls,\n1561:             StringBuffer sb) {\n1562:         Collection attrs = Model.getFacade().getAttributes(cls);\n1563:         if (attrs.isEmpty() || (generatorPass != HEADER_PASS)) {\n1564:             return;\n1565:         }\n1566:         String tv = null; // helper for tagged values\n1567:         sb.append(LINE_SEPARATOR);\n1568:         if (verboseDocs && Model.getFacade().isAClass(cls)) {\n1569:             sb.append(indent).append(\"// Attributes\").append(LINE_SEPARATOR);\n1570:         }\n1571: \n1572:         // generate attributes in order public, protected, private\n1573:         StringBuffer part[] = new StringBuffer[ALL_PARTS.length];\n1574:         for (int i = 0; i < part.length; i++)\n1575:             part[i] = new StringBuffer(80);\n1576:         \n1577:         Iterator attrIter = attrs.iterator();\n1578:         while (attrIter.hasNext()) {\n1579:             Object attr = attrIter.next();\n1580:             int i = getVisibilityPart(attr);\n1581: \n1582:             part[i].append(indent).append(generate(attr));\n1583: \n1584:             tv = generateTaggedValues(attr, ALL_BUT_DOC_TAGS);\n1585:             if (tv != null && tv.length() > 0) {\n1586:                 part[i].append(indent).append(tv);\n1587:             }\n1588:         }\n1589:         sb.append(generateAllParts(part));\n1590:     }\n1591: \n1592:     /**\n1593:      * Generates the association ends of the body of a class or interface.\n1594:      * @param cls The classifier to generate.\n1595:      * @param sb Where to put the result.\n1596:      */\n1597:     private void generateClassifierBodyAssociations(Object cls,\n1598:             StringBuffer sb) {\n1599: \n1600:         if (generatorPass == SOURCE_PASS)\n1601:             return;\n1602: \n1603:         Collection ends = Model.getFacade().getAssociationEnds(cls);\n1604:         if (!ends.isEmpty()) {\n1605: \n1606:             sb.append(LINE_SEPARATOR);\n1607:             if (verboseDocs && Model.getFacade().isAClass(cls)) {\n1608:                 sb.append(indent).append(\"// Associations\").append(\n1609:                         LINE_SEPARATOR);\n1610:             }\n1611: \n1612:             StringBuffer part[] = new StringBuffer[3];\n1613:             for (int i = 0; i < ALL_PARTS.length; i++)\n1614:                 part[i] = new StringBuffer(80);\n1615:             \n1616:             Iterator endEnum = ends.iterator();\n1617:             while (endEnum.hasNext()) {\n1618:                 Object ae = endEnum.next();\n1619:                 Object a = Model.getFacade().getAssociation(ae);\n1620:                 generateAssociationFrom(a, ae, part);\n1621:             }\n1622:             sb.append(generateAllParts(part));\n1623:         }\n1624:         // if this is an association class, generate attributes for\n1625:         // all the AssociationEnds\n1626:         if (Model.getFacade().isAAssociationClass(cls)) {\n1627:             if (verboseDocs) {\n1628:                 sb.append(LINE_SEPARATOR).append(indent);\n1629:                 sb.append(\"// AssociationClass associated classes\");\n1630:             }\n1631:             // make all ends public... does it make sense?\n1632:             // should we declare friend all the associated and make\n1633:             // these protected? (private is too restrictive anyway, IMHO)\n1634:             // TODO: make it configurable, with a tag \n1635:             sb.append(LINE_SEPARATOR).append(\" public:\").append(LINE_SEPARATOR);\n1636:             ends = Model.getFacade().getConnections(cls);\n1637:             Iterator iter = ends.iterator();\n1638:             while (iter.hasNext()) {\n1639:                 Object ae = iter.next();\n1640:                 sb.append(LINE_SEPARATOR);\n1641:                 String comment = generateConstraintEnrichedDocComment(cls, ae);\n1642:                 if (comment.length() > 0)\n1643:                     sb.append(comment).append(indent);\n1644: \n1645:                 String n = Model.getFacade().getName(ae);\n1646:                 String name;\n1647:                 Object type = Model.getFacade().getType(ae);\n1648: \n1649:                 if (n != null && n.length() > 0) {\n1650:                     name = generateName(n);\n1651:                 } else {\n1652:                     name = \"my\" + generateClassifierRef(type);\n1653:                 }\n1654: \n1655:                 sb.append(generateNameWithPkgSelection(type));\n1656:                 sb.append(generateAttributeParameterModifier(ae));\n1657:                 sb.append(\" \").append(name);\n1658:                 sb.append(\";\").append(LINE_SEPARATOR);\n1659: \n1660:                 // add the type of the association end in the dependency list\n1661:                 addDependency(type, !checkIncludeNeeded4Element(type));\n1662: \n1663:                 String tv = generateTaggedValues(ae, ALL_BUT_DOC_TAGS);\n1664:                 if (tv != null && tv.length() > 0) {\n1665:                     sb.append(indent).append(tv);\n1666:                 }\n1667:             }\n1668:         }\n1669:     }\n1670: \n1671:     /**\n1672:      * Check whether an operation body shall be generated within the actual\n1673:      * pass. This is normally done during the imeplementation path.\n1674:      * But if the Tag \"inline\" exists, the method body shall be defined as\n1675:      * as inline in header file\n1676:      * @return true -> generate body in actual path\n1677:      */\n1678:     private boolean checkGenerateOperationBody(Object cls) {\n1679:         boolean result = !((generatorPass == HEADER_PASS)\n1680:             || (Model.getFacade().isAbstract(cls))\n1681:             || Model.getFacade().isAInterface(Model.getFacade().getOwner(cls)));\n1682: \n1683:         // if this operation has Tag \"inline\" the method shall be\n1684:         // generated in header\n1685:         if (Model.getFacade().getTaggedValue(cls, \"inline\") != null) {\n1686:             result = generatorPass == HEADER_PASS;\n1687:         }\n1688:         return result;\n1689:     }\n1690: \n1691:     /** 2002-12-13 Achim Spangler\n1692:      * generate a single set function for a given attribute and StringBuffer\n1693:      */\n1694:     private void generateSingleAttributeSet(Object attr, StringBuffer sb) {\n1695:         if (Model.getFacade().getType(attr) == null) {\n1696:             return;\n1697:         }\n1698:         // generate for attributes with class-type:\n1699:         // \"indent void set_<name>( const <type> &value ) { <name> = value; };\"\n1700:         // generate for other (small) data types:\n1701:         // \"indent void set_<name>( <type> value ) { <name> = value; };\"\n1702:         // generate: \"indent void set_<name>( \"\n1703:         sb.append(LINE_SEPARATOR).append(indent);\n1704:         sb.append(\"/** simple access function to set the attribute \");\n1705:         sb.append(Model.getFacade().getName(attr));\n1706:         sb.append(\" by function\").append(LINE_SEPARATOR).append(indent);\n1707:         sb.append(\"  * @param value value to set for the attribute \");\n1708:         sb.append(Model.getFacade().getName(attr)).append(LINE_SEPARATOR);\n1709:         sb.append(indent).append(\"  */\").append(LINE_SEPARATOR);\n1710:         sb.append(indent);\n1711:         sb.append(\"void set_\").append(Model.getFacade().getName(attr))\n1712:             .append(\"( \");\n1713:         String modifier = generateAttributeParameterModifier(attr);\n1714:         if (modifier != null && modifier.length() > 0) {\n1715:             // generate: \"const <type> <modifier>value\"\n1716:             if (modifier.equals(\"&\")) sb.append(\"const \");\n1717:             sb.append(generateClassifierRef(Model.getFacade().getType(attr)))\n1718:                 .append(' ').append(modifier).append(\"value\");\n1719:         } else if (Model.getFacade().isAClass(\n1720:                 Model.getFacade().getType(attr))) {\n1721:             // generate: \"const <type> &value\"\n1722:             sb.append(\"const \");\n1723:             sb.append(generateClassifierRef(Model.getFacade().getType(attr)));\n1724:             sb.append(\" &value\");\n1725:         } else {\n1726:             // generate: \"<type> value\"\n1727:             sb.append(generateClassifierRef(Model.getFacade().getType(attr)))\n1728:                 .append(\" value\");\n1729:         }\n1730:         // generate: \" ) { <name> = value; };\"\n1731:         sb.append(\" ) { \").append(Model.getFacade().getName(attr));\n1732:         sb.append(\" = value; };\").append(LINE_SEPARATOR);\n1733:     }\n1734: \n1735:     /** 2002-12-13 Achim Spangler\n1736:      * generate a single get function for a given attribute and StringBuffer\n1737:      */\n1738:     private void generateSingleAttributeGet(Object attr, StringBuffer sb) {\n1739:         if (Model.getFacade().getType(attr) == null) return;\n1740:         // generate for attributes with class-type:\n1741:         // \"const <type>& get_<name>( void ) { return <name>; };\"\n1742:         // generate for other (small) data types\n1743:         // \"<type> get_<name>( void ) { return <name>; };\"\n1744:         // generate: \"indent\"\n1745:         sb.append(LINE_SEPARATOR).append(indent);\n1746:         sb.append(\"/** simple access function to get the attribute \");\n1747:         sb.append(Model.getFacade().getName(attr));\n1748:         sb.append(\" by function */\").append(LINE_SEPARATOR).append(indent);\n1749:         String modifier = generateAttributeParameterModifier(attr);\n1750:         if (modifier != null && modifier.length() > 0) {\n1751:             // generate: \"const <type><modifier>\"\n1752:             sb.append(\"const \");\n1753:             sb.append(generateClassifierRef(Model.getFacade().getType(attr)));\n1754:             sb.append(modifier);\n1755:         } else if (Model.getFacade().isAClass(\n1756:                 Model.getFacade().getType(attr))) {\n1757:             // generate: \"const <type>&\"\n1758:             sb.append(\"const \");\n1759:             sb.append(generateClassifierRef(Model.getFacade().getType(attr)));\n1760:             sb.append(\"&\");\n1761:         } else {\n1762:             // generate: \"<type>\"\n1763:             sb.append(generateClassifierRef(Model.getFacade().getType(attr)));\n1764:         }\n1765:         // generate: \" get_<name>( void ) const { return <name>; };\"\n1766:         sb.append(\" get_\").append(Model.getFacade().getName(attr));\n1767:         sb.append(\"( void ) const { return \")\n1768:             .append(Model.getFacade().getName(attr));\n1769:         sb.append(\"; };\").append(LINE_SEPARATOR);\n1770:     }\n1771: \n1772:     /**\n1773:      * Generates the attributes of the body of a class or interface.\n1774:      * @param cls\n1775:      */\n1776:     private void generateClassifierBodyTaggedAccess4Attributes(\n1777:             Object cls,\n1778:             StringBuffer funcPrivate,\n1779:             StringBuffer funcProtected,\n1780:             StringBuffer funcPublic) {\n1781:         Collection strs = Model.getFacade().getAttributes(cls);\n1782:         if (strs.isEmpty() || (generatorPass != HEADER_PASS)) {\n1783:             return;\n1784:         }\n1785:         String accessTag = null;\n1786: \n1787:         Iterator strEnum = strs.iterator();\n1788:         while (strEnum.hasNext()) {\n1789:             Object attr = strEnum.next();\n1790:             accessTag = Model.getFacade().getTaggedValueValue(attr, \"set\");\n1791:             if (accessTag != null && accessTag.length() > 0) {\n1792:                 if (accessTag.indexOf(\"public\") != -1) {\n1793:                     generateSingleAttributeSet(attr, funcPublic);\n1794:                 }\n1795:                 if (accessTag.indexOf(\"protected\") != -1) {\n1796:                     generateSingleAttributeSet(attr, funcProtected);\n1797:                 }\n1798:                 if (accessTag.indexOf(\"private\") != -1) {\n1799:                     generateSingleAttributeSet(attr, funcPrivate);\n1800:                 }\n1801:             }\n1802: \n1803:             accessTag = Model.getFacade().getTaggedValueValue(attr, \"get\");\n1804:             if (accessTag != null && accessTag.length() > 0) {\n1805:                 if (accessTag.indexOf(\"public\") != -1) {\n1806:                     generateSingleAttributeGet(attr, funcPublic);\n1807:                 }\n1808:                 if (accessTag.indexOf(\"protected\") != -1) {\n1809:                     generateSingleAttributeGet(attr, funcProtected);\n1810:                 }\n1811:                 if (accessTag.indexOf(\"private\") != -1) {\n1812:                     generateSingleAttributeGet(attr, funcPrivate);\n1813:                 }\n1814:             }\n1815:         }\n1816:     }\n1817: \n1818:     /**\n1819:      * Generates the association ends of the body of a class or interface.\n1820:      * @param cls\n1821:      * @param sb Where to put the result.\n1822:      */\n1823:     private void generateClassifierBodyOperations(Object cls,\n1824:             StringBuffer sb) {\n1825:         Collection behs = Model.getCoreHelper().getOperations(cls);\n1826:         if (behs.isEmpty()) return;\n1827:         sb.append(LINE_SEPARATOR);\n1828:         if (verboseDocs) {\n1829:             sb.append(indent).append(\"// Operations\").append(LINE_SEPARATOR);\n1830:         }\n1831: \n1832:         // generate tag controlled access functions for attributes\n1833:         StringBuffer[] funcs = new StringBuffer[3]; \n1834:         funcs[0] = new StringBuffer(80);\n1835:         funcs[1] = new StringBuffer(80);\n1836:         funcs[2] = new StringBuffer(80);\n1837:         generateClassifierBodyTaggedAccess4Attributes(cls, funcs[PRIVATE_PART],\n1838:                                                       funcs[PROTECTED_PART],\n1839:                                                       funcs[PUBLIC_PART]);\n1840: \n1841:         Iterator behEnum = behs.iterator();\n1842:         while (behEnum.hasNext()) {\n1843:             Object bf = behEnum.next();\n1844:             StringBuffer tb = null;\n1845: \n1846:             int p = getVisibilityPart(bf);\n1847:             if (p < 0) continue;\n1848:             tb = funcs[p];\n1849:             tb.append(LINE_SEPARATOR);\n1850: \n1851:             boolean mustGenBody = checkGenerateOperationBody(bf);\n1852:             if (tb != null \n1853:                 && ((generatorPass == HEADER_PASS) || mustGenBody))\n1854:             {\n1855:                 tb.append(generate(bf));\n1856:                 \n1857:                 // helper for tagged values\n1858:                 String tv = generateTaggedValues(bf, ALL_BUT_DOC_TAGS);\n1859:                 \n1860:                 if (mustGenBody && (Model.getFacade().isAClass(cls))\n1861:                         && (Model.getFacade().isAOperation(bf))\n1862:                         && (!Model.getFacade().isAbstract(bf))) {\n1863:                     // there is no ReturnType in behavioral feature (uml)\n1864:                     tb.append(LINE_SEPARATOR).append(generateMethodBody(bf));\n1865:                 } else {\n1866:                     tb.append(\";\").append(LINE_SEPARATOR);\n1867:                     if (tv.length() > 0) {\n1868:                         tb.append(indent).append(tv).append(LINE_SEPARATOR);\n1869:                     }\n1870:                 }\n1871:             }\n1872:         } // end loop through all operations\n1873: \n1874:         sb.append(generateAllParts(funcs));\n1875:     }\n1876: \n1877:     /**\n1878:      * Generates the association ends of the body of a class or interface.\n1879:      * @param cls\n1880:      * @param sb Where to put the result.\n1881:      */\n1882:     private void generateClassifierBodyTypedefs(Object cls, StringBuffer sb) {\n1883:         if (generatorPass == HEADER_PASS) {\n1884:             Collection publicTypedefStatements =\n1885:                 findTagValues(cls, \"typedef_public\");\n1886:             Collection protectedTypedefStatements =\n1887:                 findTagValues(cls, \"typedef_protected\");\n1888:             Collection privateTypedefStatements =\n1889:                 findTagValues(cls, \"typedef_private\");\n1890:             if (!publicTypedefStatements.isEmpty()) {\n1891:                 sb.append(LINE_SEPARATOR).append(\" public:\")\n1892:                     .append(LINE_SEPARATOR).append(indent);\n1893:                 sb.append(\"// public type definitions for header defined \"\n1894:                       + \"by Tag entries in ArgoUML\").append(LINE_SEPARATOR);\n1895:                 sb.append(indent);\n1896:                 sb.append(\"// Result: typedef <typedef_public> \"\n1897:                       + \"<tag_value>;\").append(LINE_SEPARATOR);\n1898:                 Iterator typedefEnum = publicTypedefStatements.iterator();\n1899: \n1900:                 while (typedefEnum.hasNext()) {\n1901:                     sb.append(indent).append(\"typedef \");\n1902:                     sb.append(typedefEnum.next())\n1903:                         .append(\";\").append(LINE_SEPARATOR);\n1904:                 }\n1905:             }\n1906:             if (!protectedTypedefStatements.isEmpty()) {\n1907:                 sb.append(LINE_SEPARATOR).append(\" protected:\")\n1908:                     .append(LINE_SEPARATOR).append(indent);\n1909:                 sb.append(\"// protected type definitions for header defined \"\n1910:                       + \"by Tag entries in ArgoUML\").append(LINE_SEPARATOR);\n1911:                 sb.append(indent);\n1912:                 sb.append(\"// Result: typedef <typedef_protected> \"\n1913:                       + \"<tag_value>;\").append(LINE_SEPARATOR);\n1914:                 Iterator typedefEnum = protectedTypedefStatements.iterator();\n1915: \n1916:                 while (typedefEnum.hasNext()) {\n1917:                     sb.append(indent).append(\"typedef \");\n1918:                     sb.append(typedefEnum.next())\n1919:                         .append(\";\").append(LINE_SEPARATOR);\n1920:                 }\n1921:             }\n1922:             if (!privateTypedefStatements.isEmpty()) {\n1923:                 sb.append(LINE_SEPARATOR).append(\" private:\")\n1924:                     .append(LINE_SEPARATOR).append(indent);\n1925:                 sb.append(\"// private type definitions for header defined \"\n1926:                       + \"by Tag entries in ArgoUML\").append(LINE_SEPARATOR);\n1927:                 sb.append(indent);\n1928:                 sb.append(\"// Result: typedef <typedef_private> \"\n1929:                       + \"<tag_value>;\").append(LINE_SEPARATOR);\n1930:                 Iterator typedefEnum = privateTypedefStatements.iterator();\n1931: \n1932:                 while (typedefEnum.hasNext()) {\n1933:                     sb.append(indent).append(\"typedef \");\n1934:                     sb.append(typedefEnum.next()).append(\";\")\n1935:                         .append(LINE_SEPARATOR);\n1936:                 }\n1937:             }\n1938:         }\n1939:     }\n1940: \n1941:     /**\n1942:      * Generates a virtual destructor when the classifier is an interface.\n1943:      * @param cls the classifier object\n1944:      * @param sb the buffer to where the generate code goes\n1945:      */\n1946:     private void generateClassifierDestructor(Object cls, StringBuffer sb) {\n1947:         if (Model.getFacade().isAInterface(cls) \n1948:                 && generatorPass == HEADER_PASS) {\n1949:             sb.append(LINE_SEPARATOR).append(\"public:\").append(LINE_SEPARATOR);\n1950:             sb.append(indent).append(\"// virtual destructor for interface \")\n1951:                 .append(LINE_SEPARATOR);\n1952:             sb.append(indent).append(\"virtual \").append('~').append(\n1953:                 Model.getFacade().getName(cls)).append(\"() { }\")\n1954:                     .append(LINE_SEPARATOR);\n1955:         }\n1956:     }\n1957: \n1958:     private void generateClassifierInnerClasses(Object cls, StringBuffer sb) {\n1959:         StringBuffer part[] = new StringBuffer[ALL_PARTS.length];\n1960:         for (int i = 0; i < part.length; i++)\n1961:             part[i] = new StringBuffer(80);\n1962: \n1963:         Collection inners = Model.getFacade().getOwnedElements(cls);\n1964:         for (Iterator it = inners.iterator(); it.hasNext();) {\n1965:             Object inner = it.next();\n1966:             if (Model.getFacade().isAClass(inner)\n1967:                 || Model.getFacade().isAInterface(inner)) {\n1968:                 String innerCode = generateClassifier(inner);\n1969:                 int p = getVisibilityPart(inner);\n1970:                 part[p].append(LINE_SEPARATOR);\n1971:                 if (generatorPass == HEADER_PASS) {\n1972:                     part[p].append(indentString(innerCode, 1));\n1973:                 } else {\n1974:                     part[p].append(innerCode);\n1975:                 }\n1976:                 part[p].append(LINE_SEPARATOR);\n1977:             }\n1978:         }\n1979:         sb.append(generateAllParts(part));\n1980:     }\n1981: \n1982:     /**\n1983:      * Generates the body of a class or interface.\n1984:      * @param cls\n1985:      * @return a StringBuffer with the result.\n1986:      */\n1987:     private StringBuffer generateClassifierBody(Object cls) {\n1988:         StringBuffer sb = new StringBuffer();\n1989:         if (Model.getFacade().isAClass(cls) \n1990:                 || Model.getFacade().isAInterface(cls))\n1991:         { \n1992:             // Inner classes\n1993:             generateClassifierInnerClasses(cls, sb);\n1994: \n1995:             // add operations\n1996:             // TODO: constructors\n1997:             generateClassifierBodyOperations(cls, sb);\n1998: \n1999:             // fixing issue #2587\n2000:             generateClassifierDestructor(cls, sb);\n2001: \n2002:             // add attributes\n2003:             generateClassifierBodyAttributes(cls, sb);\n2004: \n2005:             // add attributes implementing associations\n2006:             generateClassifierBodyAssociations(cls, sb);\n2007: \n2008:             // add typedefs\n2009:             generateClassifierBodyTypedefs(cls, sb);\n2010:         }\n2011:         return sb;\n2012:     }\n2013: \n2014:     /**\n2015:      * Generate the body of a method associated with the given\n2016:      * operation.  This assumes there's at most one method associated!\n2017:      *\n2018:      * If no method is associated with the operation, a default method\n2019:      * body will be generated.\n2020:      */\n2021:     private String generateMethodBody(Object op) {\n2022:         if (op != null) {\n2023:             StringBuffer sb = new StringBuffer(80);\n2024:             Collection methods = Model.getFacade().getMethods(op);\n2025:             Iterator i = methods.iterator();\n2026:             Object method = null;\n2027:             boolean methodFound = false;\n2028:             String tv = generateTaggedValues(op, ALL_BUT_DOC_TAGS);\n2029:             String operationIndent =\n2030:                 (generatorPass == HEADER_PASS) ? indent : \"\";\n2031: \n2032:             // append tags which are not Doc-Comments\n2033:             if (tv.length() > 0) {\n2034:                 sb.append(operationIndent).append(tv).append(LINE_SEPARATOR);\n2035:             }\n2036: \n2037:             // place the curley braces within the protected area, to\n2038:             // allow placement of preserved contructor initialisers in\n2039:             // this area otherwise all possible constructor-attribute\n2040:             // initialisers would have to be autogenerated with an\n2041:             // army of special tags\n2042:             sb.append(generateSectionTop(op, operationIndent))\n2043:                 .append(operationIndent).append(\"{\").append(LINE_SEPARATOR);\n2044: \n2045:             while (i != null && i.hasNext()) {\n2046:                 method = i.next();\n2047: \n2048:                 if (method != null) {\n2049:                     if ((Model.getFacade().getBody(method) != null)\n2050:                             && (!methodFound)) {\n2051:                         Object body = Model.getFacade().getBody(method);\n2052:                         sb.append(Model.getFacade().getBody(body));\n2053:                         methodFound = true;\n2054:                         break;\n2055:                     }\n2056:                 }\n2057:             }\n2058: \n2059:             if (!methodFound) {\n2060:                 // pick out return type as default method body\n2061:                 Object rp =\n2062:                     Model.getCoreHelper().getReturnParameter(op);\n2063:                 if (rp != null) {\n2064:                     Object returnType = Model.getFacade().getType(rp);\n2065:                     sb.append(generateDefaultReturnStatement(returnType));\n2066:                 }\n2067:             }\n2068:             sb.append(operationIndent).append(\"}\").append(LINE_SEPARATOR)\n2069:                 .append(generateSectionBottom(op, operationIndent));\n2070:             return sb.toString();\n2071:         }\n2072:         return generateDefaultReturnStatement (null);\n2073:     }\n2074: \n2075: \n2076:     private String generateSectionTop(Object op, String localIndent) {\n2077:         String id = UUIDHelper.getUUID(op);\n2078:         if (id == null) {\n2079:             id = (new UID().toString());\n2080:             Model.getCoreHelper().setUUID(op, id);\n2081:         }\n2082:         return Section.generateTop(id, localIndent);\n2083:     }\n2084: \n2085:     private String generateSectionBottom(Object op, String localIndent) {\n2086:         String id = UUIDHelper.getUUID(op);\n2087:         if (id == null) {\n2088:             id = (new UID().toString());\n2089:             Model.getCoreHelper().setUUID(op, id);\n2090:         }\n2091:         return Section.generateBottom(id, localIndent);\n2092:     }\n2093: \n2094:     private String generateDefaultReturnStatement(Object cls) {\n2095:         if (cls == null) return \"\";\n2096: \n2097:         String clsName = Model.getFacade().getName(cls);\n2098:         String res = null;\n2099:         if (clsName.equals(\"void\")) res = \"\";\n2100:         else if (clsName.equals(\"char\")) res = \"return 'x';\";\n2101:         else if (clsName.equals(\"int\")) res = \"return 0;\";\n2102:         else if (clsName.equals(\"bool\")) res = \"return false;\";\n2103:         else if (clsName.equals(\"byte\")) res = \"return 0;\";\n2104:         else if (clsName.equals(\"long\")) res = \"return 0;\";\n2105:         else if (clsName.equals(\"float\")) res = \"return 0.0;\";\n2106:         else if (clsName.equals(\"double\")) res = \"return 0.0;\";\n2107: \n2108:         if (res == null) {\n2109:             return \"\"; // in doubt, let the choice to the user\n2110:         }\n2111:         return indent + res + LINE_SEPARATOR;\n2112:     }\n2113: \n2114:     private String generateTaggedValues(Object e, int tagSelection) {\n2115:         Iterator iter = Model.getFacade().getTaggedValues(e);\n2116:         if (!iter.hasNext()) {\n2117:             return \"\";\n2118:         }\n2119:         StringBuffer buf = new StringBuffer();\n2120:         boolean first = true;\n2121: \n2122:         String s = null;\n2123:         while (iter.hasNext()) {\n2124:             s = generateTaggedValue(iter.next(), tagSelection);\n2125:             if (s != null && s.length() > 0) {\n2126:                 if (first) {\n2127:                     /*\n2128:                      * Corrected 2001-09-26 STEFFEN ZSCHALER\n2129:                      *\n2130:                      * Was:\n2131:                      buf.append(\"// {\");\n2132:                      *\n2133:                      * which caused problems with new lines characters\n2134:                      * in tagged values (e.g. comments...). The new\n2135:                      * version still has some problems with tagged\n2136:                      * values containing \"*\"+\"/\" as this closes the\n2137:                      * comment prematurely, but comments should be\n2138:                      * taken out of the tagged values list anyway...\n2139:                      */\n2140: \n2141:                     if (tagSelection == DOC_COMMENT_TAGS) {\n2142:                         // insert main documentation for DocComment at first\n2143:                         String doc =\n2144:                             (DocumentationManager.hasDocs(e))\n2145:                             ? DocumentationManager.getDocs(e, indent)\n2146:                             : null;\n2147:                         if (doc != null && doc.trim().length() > 0) {\n2148:                             buf.append(doc.substring(0, doc.indexOf(\"*/\") + 1));\n2149:                             buf.append(\"  \");\n2150:                         }\n2151:                         else {\n2152:                             buf.append(\"/** \");\n2153:                         }\n2154:                     }\n2155:                     else {\n2156:                         buf.append(\"/* {\");\n2157:                     }\n2158:                     first = false;\n2159:                 } // end first\n2160:                 else {\n2161:                     if (tagSelection == DOC_COMMENT_TAGS) {\n2162:                         buf.append(LINE_SEPARATOR)\n2163:                             .append(indent).append(\" *  \");\n2164:                     }\n2165:                     else {\n2166:                         buf.append(\", \");\n2167:                     }\n2168:                 } // end not first tag\n2169:                 buf.append(s);\n2170:             } // end tag not empty\n2171:         } // end while\n2172:         /*\n2173:          * Corrected 2001-09-26 STEFFEN ZSCHALER\n2174:          *\n2175:          * Was:\n2176:          if (!first) buf.append(\"}\\n\");\n2177:          *\n2178:          * which caused problems with new-lines in tagged values.\n2179:          */\n2180:         if (!first) {\n2181:             if (tagSelection == DOC_COMMENT_TAGS) {\n2182:                 buf.append(LINE_SEPARATOR).append(indent).append(\" */\")\n2183:                     .append(LINE_SEPARATOR);\n2184:             } else {\n2185:                 buf.append (\"}*/\").append(LINE_SEPARATOR);\n2186:             }\n2187:         }\n2188:         else if (tagSelection == DOC_COMMENT_TAGS) {\n2189:             // create at least main documentation field, if no other tag found\n2190:             String doc = (DocumentationManager.hasDocs(e))\n2191:                 ? DocumentationManager.getDocs(e, indent)\n2192:                 : null;\n2193:             if (doc != null && doc.trim().length() > 0) {\n2194:                 buf.append(doc).append(LINE_SEPARATOR);\n2195:             }\n2196:         }\n2197: \n2198:         return buf.toString();\n2199:     }\n2200: \n2201:     private String generateTaggedValue(Object tv, int tagSelection) {\n2202:         if (tv == null) return \"\";\n2203:         String s = generateUninterpreted(Model.getFacade().getValueOfTag(tv));\n2204: \n2205:         String tagName = Model.getFacade().getTagOfTag(tv);\n2206:         if (s == null || s.length() == 0 || s.equals(\"/** */\")\n2207:             || (tagName.indexOf(\"include\") != -1)\n2208:             || (tagName.indexOf(\"_incl\") != -1)) {\n2209:             return \"\";\n2210:         }\n2211:         if ((tagSelection == DOC_COMMENT_TAGS)\n2212:                 && (isDocCommentTag(tagName))) {\n2213:             return generateDocComment4Tag(generateName(tagName)) + s;\n2214:         } else if (((tagSelection == ALL_BUT_DOC_TAGS)\n2215:                      && (!isDocCommentTag(tagName))\n2216:                      && (!tagName.equals(\"documentation\"))\n2217:                      && (!tagName.equals(\"javadocs\"))\n2218:                     )\n2219:                    || (tagSelection == ALL_TAGS)) {\n2220:             return tagName + \"=\" + s;\n2221:         } else {\n2222:             return \"\";\n2223:         }\n2224:     }\n2225: \n2226:     private Collection findTagValues(Object item, String searchedName) {\n2227:         Collection result = new Vector();\n2228: \n2229:         Iterator iter = Model.getFacade().getTaggedValues(item);\n2230:         String s = null;\n2231:         while (iter.hasNext()) {\n2232:             Object tag = iter.next();\n2233:             if (Model.getFacade().getTagOfTag(tag).equals(searchedName)) {\n2234:                 s = Model.getFacade().getValueOfTag(tag);\n2235:                 if (s != null && s.length() != 0) result.add(s);\n2236:             }\n2237:         }\n2238:         return result;\n2239:     }\n2240: \n2241:     private boolean isDocCommentTag(String tagName) {\n2242:         boolean result = false;\n2243:         if (tagName.equals (\"inv\")) {\n2244:             result = true;\n2245:         }\n2246:         else if (tagName.equals (\"post\")) {\n2247:             result = true;\n2248:         }\n2249:         else if (tagName.equals (\"pre\")) {\n2250:             result = true;\n2251:         }\n2252:         else if (tagName.equals (\"author\")) {\n2253:             result = true;\n2254:         }\n2255:         else if (tagName.equals (\"version\")) {\n2256:             result = true;\n2257:         }\n2258:         else if (tagName.equals (\"see\")) {\n2259:             result = true;\n2260:         }\n2261:         else if (tagName.equals (\"param\")) {\n2262:             result = true;\n2263:         }\n2264:         return result;\n2265:     }\n2266: \n2267:     private String generateDocComment4Tag(String tagName) {\n2268:         if (tagName.equals (\"inv\")) {\n2269:             return \"@invariant \";\n2270:         }\n2271:         else if (tagName.equals (\"post\")) {\n2272:             return \"@postcondition \";\n2273:         }\n2274:         else if (tagName.equals (\"pre\")) {\n2275:             return \"@precondition \";\n2276:         }\n2277:         else if (tagName.equals (\"author\")) {\n2278:             return \"@author \";\n2279:         }\n2280:         else if (tagName.equals (\"version\")) {\n2281:             return \"@version \";\n2282:         }\n2283:         else if (tagName.equals (\"see\")) {\n2284:             return \"@see \";\n2285:         }\n2286:         else if (tagName.equals (\"param\")) {\n2287:             return \"@param \";\n2288:         }\n2289:         else return \"\";\n2290:     }\n2291: \n2292:     /**\n2293:      * @see org.argouml.application.api.NotationProvider2#generateTaggedValue(java.lang.Object)\n2294:      */\n2295:     public String generateTaggedValue(Object tv) {\n2296:         if (tv == null) return \"\";\n2297:         String s = generateUninterpreted(Model.getFacade().getValueOfTag(tv));\n2298:         if (s == null || s.length() == 0 || s.equals(\"/** */\")) return \"\";\n2299:         String t = Model.getFacade().getTagOfTag(tv);\n2300:         if (t.equals(\"documentation\")) return \"\";\n2301:         return generateName(t) + \"=\" + s;\n2302:     }\n2303: \n2304:     /**\n2305:      * Enhance/Create the doccomment for the given model element,\n2306:      * including tags for any OCL constraints connected to the model\n2307:      * element. The tags generated are suitable for use with the ocl\n2308:      * injector which is part of the Dresden OCL Toolkit and are in\n2309:      * detail:\n2310:      *\n2311:      * &nbsp;@invariant for each invariant specified\n2312:      * &nbsp;@precondition for each precondition specified\n2313:      * &nbsp;@postcondition for each postcondition specified\n2314:      * &nbsp;@key-type specifying the class of the keys of a mapped association\n2315:      * &nbsp; Currently mapped associations are not supported yet...\n2316:      * &nbsp;@element-type specifying the class referenced in an association\n2317:      *\n2318:      * @since 2001-09-26 ArgoUML 0.9.3\n2319:      * @author Steffen Zschaler\n2320:      *\n2321:      * @param me the model element for which the documentation comment is needed\n2322:      * @param ae the association end which is represented by the model element\n2323:      * @return the documentation comment for the specified model element, either\n2324:      * enhanced or completely generated\n2325:      */\n2326:     public String generateConstraintEnrichedDocComment(Object me, Object ae) {\n2327:         // list tagged values for documentation\n2328:         String s = generateTaggedValues (me, DOC_COMMENT_TAGS);\n2329: \n2330:         if (Model.getFacade().getUpper(ae) != 1) {\n2331:             // Multiplicity greater 1, that means we will generate some sort of\n2332:             // collection, so we need to specify the element type tag\n2333:             StringBuffer sDocComment = new StringBuffer(80);\n2334: \n2335:             // Prepare doccomment\n2336:             if (!(s == null || \"\".equals(s))) {\n2337:                 // Just remove closing \"*/\"\n2338:                 sDocComment.append(indent)\n2339:                     .append(s.substring(0, s.indexOf(\"*/\") + 1));\n2340:             }\n2341:             else {\n2342:                 sDocComment.append(indent).append(\"/**\").append(LINE_SEPARATOR);\n2343:                 sDocComment.append(indent).append(\" *\");\n2344:             }\n2345: \n2346:             // Build doccomment\n2347:             Object type = Model.getFacade().getType(ae);\n2348:             if (type != null) {\n2349:                 sDocComment.append(\" @element-type \");\n2350:                 sDocComment.append(Model.getFacade().getName(type));\n2351:             }\n2352:             sDocComment.append(LINE_SEPARATOR).append(indent)\n2353:                 .append(\" */\").append(LINE_SEPARATOR);\n2354:             return sDocComment.toString();\n2355:         }\n2356:         return (s != null) ? s : \"\";\n2357:     }\n2358: \n2359:     /**\n2360:      * \n2361:      * @param a association object\n2362:      * @param ae association end attached to the classifier\n2363:      *        for which the code is to be generated\n2364:      * @param parts the buffers associated with the public, protected\n2365:      *        and private parts, where the code is to be written.\n2366:      */\n2367:     private void generateAssociationFrom(Object a, Object ae,\n2368:             StringBuffer[] parts) {\n2369:         // TODO: does not handle n-ary associations\n2370: \n2371:         /*\n2372:          * Moved into while loop 2001-09-26 STEFFEN ZSCHALER\n2373:          *\n2374:          * Was:\n2375:          *\n2376:          s += DocumentationManager.getDocs(a) + \"\\n\" + indent;\n2377:         */\n2378: \n2379:         Collection connections = Model.getFacade().getConnections(a);\n2380:         Iterator connEnum = connections.iterator();\n2381:         while (connEnum.hasNext()) {\n2382:             Object ae2 = connEnum.next();\n2383:             if (ae2 != ae) {\n2384:                 int p = getVisibilityPart(ae2);\n2385:                 if (p >= 0) {\n2386:                     StringBuffer sb = parts[p];\n2387:                     /**\n2388:                      * Added generation of doccomment 2001-09-26 STEFFEN\n2389:                      * ZSCHALER\n2390:                      */\n2391:                     sb.append(LINE_SEPARATOR);\n2392:                     String assend = generateAssociationEnd(ae2);\n2393:                     if (assend.length() > 0) {\n2394:                         String comment =\n2395:                             generateConstraintEnrichedDocComment(a, ae2);\n2396:                         if (comment.length() > 0)\n2397:                             sb.append(comment);\n2398:                         // both comment and assend ends with simple newline\n2399:                         sb.append(indent).append(assend);\n2400:                     }\n2401: \n2402:                     String tv = generateTaggedValues(a, ALL_BUT_DOC_TAGS);\n2403:                     if (tv != null && tv.length() > 0) {\n2404:                         sb.append(indent).append(tv);\n2405:                     }\n2406:                 }\n2407:             }\n2408:         }\n2409:     }\n2410: \n2411:     /**\n2412:      * @see org.argouml.application.api.NotationProvider2#generateAssociation(java.lang.Object)\n2413:      */\n2414:     public String generateAssociation(Object handle) {\n2415:         return \"\"; // Maybe Model.getFacade().getName(handle) ???\n2416:     }\n2417: \n2418:     /**\n2419:      * @see org.argouml.application.api.NotationProvider2#generateAssociationEnd(java.lang.Object)\n2420:      */\n2421:     public String generateAssociationEnd(Object ae) {\n2422:         if (!Model.getFacade().isNavigable(ae)) {\n2423:             return \"\";\n2424:         }\n2425:         if (Model.getFacade().isAbstract(\n2426:                 Model.getFacade().getAssociation(ae))) {\n2427:             return \"\";\n2428:         }\n2429:         StringBuffer sb = new StringBuffer(80);\n2430: \n2431:         sb.append(generateAssociationEndScope(ae));\n2432: \n2433:         String n = Model.getFacade().getName(ae);\n2434:         Object asc = Model.getFacade().getAssociation(ae);\n2435:         String ascName = Model.getFacade().getName(asc);\n2436:         String name = null;\n2437: \n2438:         if (n != null && n.length() > 0) {\n2439:             name = generateName(n);\n2440:         } else if (ascName != null && ascName.length() > 0) {\n2441:             name = generateName(ascName);\n2442:         } else {\n2443:             name = \"my\" + generateClassifierRef(Model.getFacade().getType(ae));\n2444:         }\n2445: \n2446:         String modifier;\n2447:         if (Model.getFacade().isAAssociationClass(asc)) {\n2448:             // With an association class, we actually make an association\n2449:             // between us and the association class itself.\n2450:             // Usually, this is a pointer or a reference, so default\n2451:             // to a pointer.\n2452:             modifier = generateAttributeParameterModifier(asc, \"*\");\n2453:             // add the association class in the dependency list\n2454:             addDependency(asc, !checkIncludeNeeded4Element(ae)); \n2455:         } else {\n2456:             modifier = generateAttributeParameterModifier(ae);\n2457:             // add the type of the association end in the dependency list\n2458:             boolean predecl = !checkIncludeNeeded4Element(ae);\n2459:             addDependency(Model.getFacade().getType(ae), predecl);\n2460:         }\n2461:         \n2462:         sb.append(generateMultiplicity(ae, name,\n2463:                              Model.getFacade().getMultiplicity(ae),\n2464:                              modifier));\n2465: \n2466:         return (sb.append(\";\").append(LINE_SEPARATOR)).toString();\n2467:     }\n2468: \n2469: \n2470:     private String generateGeneralization(Collection generalizations) {\n2471:         if (generalizations == null) {\n2472:             return \"\";\n2473:         }\n2474:         StringBuffer sb = new StringBuffer(80);\n2475:         Iterator genEnum = generalizations.iterator();\n2476:         while (genEnum.hasNext()) {\n2477:             Object generalization = genEnum.next();\n2478:             Object ge = Model.getFacade().getParent(generalization);\n2479:             if (ge != null) {\n2480:                 if (sb.length() > 0) sb.append(\", \");\n2481:                 String visTag =\n2482:                     Model.getFacade().getTaggedValueValue(generalization,\n2483:                                             \"visibility\").trim();\n2484:                 if (visTag != null && !visTag.equals(\"\")) {\n2485:                     sb.append(visTag).append(\" \");\n2486:                 } else {\n2487:                     if (Model.getFacade().isAInterface(ge)) {\n2488:                         sb.append(\"virtual public \");\n2489:                     } else {\n2490:                         sb.append(\"public \");\n2491:                     }\n2492:                 }\n2493:                 sb.append(generateNameWithPkgSelection(ge));\n2494:                 // add the type of the base class in the dependency list\n2495:                 addDependency(ge, false);\n2496:             }\n2497:         }\n2498:         return sb.toString();\n2499:     }\n2500: \n2501:     //  public String generateSpecification(Collection realizations) {\n2502:     private String generateSpecification(Object cls) {\n2503:         Collection deps = Model.getFacade().getClientDependencies(cls);\n2504:         Iterator depIterator = deps.iterator();\n2505:         StringBuffer sb = new StringBuffer(80);\n2506: \n2507:         while (depIterator.hasNext()) {\n2508:             Object dependency = depIterator.next();\n2509:             if (Model.getFacade().isAAbstraction(dependency)\n2510:                     && Model.getFacade().isRealize(dependency)) {\n2511:                 if (sb.length() > 0) sb.append(\", \");\n2512:                 Object iFace = Model.getFacade().getSuppliers(dependency)\n2513:                     .iterator().next();\n2514:                 String visTag =\n2515:                     Model.getFacade().getTaggedValueValue(dependency,\n2516:                                             \"visibility\").trim();\n2517:                 if (visTag != null && !visTag.equals(\"\")) {\n2518:                     sb.append(visTag).append(\" \");\n2519:                 } else {\n2520:                     sb.append(\"virtual public \");\n2521:                 }\n2522:                 sb.append(generateNameWithPkgSelection(iFace));\n2523:                 // add the type of the interface in the dependency list\n2524:                 addDependency(iFace, false);\n2525:             }\n2526:         }\n2527:         return sb.toString();\n2528:     }\n2529: \n2530:     /**\n2531:      * Generates the String representation for an Event.\n2532:      *\n2533:      * @param modelElement Model element to generate notation for.\n2534:      *\n2535:      * @return Generated notation for model element.\n2536:      */\n2537:     public String generateEvent(Object modelElement) {\n2538:         if (!Model.getFacade().isAEvent(modelElement)) {\n2539:             throw new ClassCastException(modelElement.getClass()\n2540:                     + \" has wrong object type, Event required\");\n2541:         }\n2542: \n2543:         return \"\";\n2544:     }\n2545: \n2546:     /**\n2547:      * @see org.argouml.application.api.NotationProvider2#generateVisibility(java.lang.Object)\n2548:      */\n2549:     public String generateVisibility(Object o) {\n2550:         if (Model.getFacade().isAAttribute(o)) {\n2551:             return \"\";\n2552:         }\n2553:         // cut'n'pasted from GeneratorJava.java\n2554:         if (Model.getFacade().isAFeature(o)) {\n2555:             Object tv = Model.getFacade().getTaggedValue(o, \"src_visibility\");\n2556:             if (tv != null) {\n2557:                 String tagged = (String) Model.getFacade().getValue(tv);\n2558:                 if (tagged != null) {\n2559:                     if (tagged.trim().equals(\"\")\n2560:                             || tagged.trim().toLowerCase().equals(\"default\")) {\n2561:                         return \"\";\n2562:                     } \n2563:                     return tagged + \": \";\n2564:                 }\n2565:             }\n2566:         }\n2567:         if (Model.getFacade().isAModelElement(o)) {\n2568:             if (Model.getFacade().isPublic(o))\n2569:                 return \"public: \";\n2570:             if (Model.getFacade().isPrivate(o))\n2571:                 return \"private: \";\n2572:             if (Model.getFacade().isProtected(o))\n2573:                 return \"protected: \";\n2574:         }\n2575:         if (Model.getFacade().isAVisibilityKind(o)) {\n2576:             if (Model.getVisibilityKind().getPublic().equals(o))\n2577:                 return \"public: \";\n2578:             if (Model.getVisibilityKind().getPrivate().equals(o))\n2579:                 return \"private: \";\n2580:             if (Model.getVisibilityKind().getProtected().equals(o))\n2581:                 return \"protected: \";\n2582:         }\n2583:         return \"\";\n2584:     }\n2585: \n2586:     private String generateAssociationEndScope(Object ae) {\n2587:         return generateScope(Model.getFacade().getTargetScope(ae));\n2588:     }\n2589: \n2590:     private String generateOwnerScope(Object f) {\n2591:         return generateScope(Model.getFacade().getOwnerScope(f));\n2592:     }\n2593: \n2594:     /**\n2595:      * @param scope The scope to compare.\n2596:      * @return The generated text representing the scope.\n2597:      */\n2598:     private String generateScope(Object scope) {\n2599:         if (Model.getScopeKind().getClassifier().equals(scope)) {\n2600:             return \"static \";\n2601:         }\n2602:         return \"\";\n2603:     }\n2604: \n2605: \n2606:     /**\n2607:      * Generate \"abstract\" keyword for an abstract operation.\n2608:      * In C++, since it does not have an explicit \"interface\" keyword, we must\n2609:      * check against this and set the operation to abstract if so.\n2610:      */\n2611:     private String generateAbstractness(Object op) {\n2612:         // use Model subsystem Facade to check if the operation is \n2613:         // owned by an interface\n2614:         Object opOwner = Model.getFacade().getOwner(op);\n2615:         if (Model.getFacade().isAbstract(op) \n2616:                 || Model.getFacade().isAInterface(opOwner)) {\n2617:             return \" = 0\";\n2618:         }\n2619:         return \"\";\n2620:     }\n2621: \n2622:     /**\n2623:      * Generate \"const\" keyword for query operations.\n2624:      */\n2625:     private String generateOperationChangeability(Object op) {\n2626:         if (Model.getFacade().isQuery(op)) {\n2627:             return \"const \";\n2628:         }\n2629:         return \"\";\n2630:     }\n2631: \n2632:     /**\n2633:      * Generate \"const\" keyword for const pointer/reference parameters.\n2634:      */\n2635:     private String generateParameterChangeability(Object par) {\n2636:         int parType = getAttributeModifierType(par);\n2637:         if (parType != -1 && parType != NORMAL_MOD\n2638:                 && (Model.getFacade().getKind(par)).equals(\n2639:                         Model.getDirectionKind().getInParameter())) {\n2640:             return \"const \";\n2641:         }\n2642:         return \"\";\n2643:     }\n2644: \n2645:     private String generateStructuralFeatureChangeability(Object sf) {\n2646:         Object changeableKind = Model.getFacade().getChangeability(sf);\n2647:         if (Model.getChangeableKind().getFrozen().equals(changeableKind)) {\n2648:             return \"const \";\n2649:         }\n2650:         return \"\";\n2651:     }\n2652: \n2653:     /**\n2654:      * Generates \"synchronized\" keyword for guarded operations.\n2655:      * Not needed for c++, it doesn't handle concurrency directly.\n2656:      * TODO: Maybe, implement this in the methods body using \n2657:      * some kind of API (posix, win32, ... as user wishes ...)?\n2658:      * @param op The operation\n2659:      * @return The synchronized keyword if the operation is guarded, else \"\"\n2660:      */\n2661:     private String generateConcurrency(Object op) {\n2662:         return \"\";\n2663:     }\n2664: \n2665:     /**\n2666:      * @see org.argouml.application.api.NotationProvider2#generateMultiplicity(java.lang.Object)\n2667:      */\n2668:     public String generateMultiplicity(Object multiplicity) {\n2669:         if (multiplicity == null\n2670:                 || \"1\".equals(Model.getFacade().toString(multiplicity))) {\n2671:             return \"\";\n2672:         } else {\n2673:             return Model.getFacade().toString(multiplicity);\n2674:         }\n2675:     }\n2676: \n2677:     private String generateMultiplicity(Object item, String name,\n2678:             Object m, String modifier) {\n2679:         String type = null;\n2680:         String containerType = null;\n2681:         Object typeCls = null;\n2682:         if (Model.getFacade().isAAssociationEnd(item)) {\n2683:             // take into account association classes\n2684:             Object assoc = Model.getFacade().getAssociation(item);\n2685:             if (Model.getFacade().isAAssociationClass(assoc)) {\n2686:                 typeCls = assoc;\n2687:                 name += \"Assoc\";\n2688:             }\n2689:             else\n2690:                 typeCls = Model.getFacade().getType(item);\n2691:         } else if (Model.getFacade().isAAttribute(item)) {\n2692:             typeCls = Model.getFacade().getType(item);\n2693:         } else if (Model.getFacade().isAClassifier(item)) {\n2694:             //type = Model.getFacade().getName(item);\n2695:             typeCls = item;\n2696:         } else {\n2697:             type = \"\";\n2698:         }\n2699:         if (typeCls != null) {\n2700:             type = generateNameWithPkgSelection(typeCls);\n2701:         }\n2702:         if (m == null) {\n2703:             return (type + \" \" + modifier + name);\n2704:         }\n2705:         StringBuffer sb = new StringBuffer(80);\n2706:         int countUpper = Model.getFacade().getUpper(m);\n2707:         int countLower = Model.getFacade().getLower(m);\n2708: \n2709:         if (countUpper == 1 && countLower == 1) {\n2710:             // simple generate identifier for default 1:1 multiplicity\n2711:             sb.append(type).append(' ').append(modifier).append(name);\n2712:         } else if (countUpper == 1 && countLower == 0) {\n2713:             // use a simple pointer for 0:1 multiplicity\n2714:             // TODO: use an auto_ptr in case of attributes or compositions\n2715:             sb.append(type).append(' ').append(modifier)\n2716:                 .append(\"* \").append(name);\n2717:         } else if (countUpper == countLower) {\n2718:             // fixed array -> <type> <name>[<count>];\n2719:             sb.append(type).append(' ').append(modifier).append(name)\n2720:                 .append(\"[ \" + countUpper + \"]\");\n2721:         } else {\n2722:             // variable association -> if no tag found use vector\n2723:             // else search for tag:\n2724:             // <MultipliciyType> : vector|list|slist|map|stack|stringmap\n2725:             String multType =\n2726:                 Model.getFacade().getTaggedValueValue(item, \"MultiplicityType\");\n2727:             if (multType != null && multType.length() > 0) {\n2728:                 if (multType.equals(\"vector\")) {\n2729:                     containerType = \"vector\";\n2730:                 } else if (multType.equals(\"list\")) {\n2731:                     containerType = \"list\";\n2732:                 } else if (multType.equals(\"slist\")) {\n2733:                     containerType = \"slist\";\n2734:                 } else if (multType.equals(\"map\")) {\n2735:                     // FIXME: map does not work this way, needs a index type\n2736:                     containerType = \"map\";\n2737:                 } else if (multType.equals(\"stack\")) {\n2738:                     containerType = \"stack\";\n2739:                 } else if (multType.equals(\"stringmap\")) {\n2740:                     systemInc.add(\"string\");\n2741:                     systemInc.add(\"map\");\n2742:                     sb.append(stdPrefix + \"map<\" + stdPrefix + \"string, \");\n2743:                     if (modifier.indexOf('&') != -1) {\n2744:                         LOG.warn(\"cannot generate STL container \"\n2745:                                 + \"with references, using pointers\");\n2746:                         modifier = \"*\";\n2747:                     }\n2748:                     sb.append(type).append(modifier);\n2749:                     sb.append(\" > \").append(name);\n2750:                 } else {\n2751:                     LOG.warn(\"unknown MultiplicityType \\\"\" + multType\n2752:                             + \"\\\", using default\");\n2753:                     containerType = \"vector\";\n2754:                 }\n2755:             } else {\n2756:                 containerType = \"vector\";\n2757:             }\n2758: \n2759:             if (containerType != null) {\n2760:                 // these container are declared the same except the name\n2761:                 systemInc.add(containerType);\n2762:                 sb.append(stdPrefix).append(containerType).append(\"< \");\n2763:                 if (modifier.indexOf('&') != -1) {\n2764:                     LOG.warn(\"cannot generate STL container \"\n2765:                             + \"with references, using pointers\");\n2766:                     modifier = \"*\";\n2767:                 }\n2768:                 sb.append(type).append(modifier);\n2769:                 sb.append(\" > \").append(name);\n2770:             }\n2771:         }\n2772:         return sb.toString();\n2773:     }\n2774: \n2775:     /* TODO: The following methods (generateState/StateBody/Transition/\n2776:      * Action/Guard/Message) are provided to comply with the interface\n2777:      * NotationProvider2 but they aren't specific for C++ (mostly).\n2778:      * Why don't we provide a default implementation for these methods\n2779:      * in NotationHelper or in Generator2?   -- Daniele Tamino\n2780:      */\n2781: \n2782:     /**\n2783:      * @see org.argouml.application.api.NotationProvider2#generateState(java.lang.Object)\n2784:      */\n2785:     public String generateState(Object handle) {\n2786:         return Model.getFacade().getName(handle);\n2787:     }\n2788: \n2789:     /**\n2790:      * @see org.argouml.application.api.NotationProvider2#generateStateBody(java.lang.Object)\n2791:      */\n2792:     public String generateStateBody(Object state) {\n2793:         String s = \"\";\n2794:         Object entry = Model.getFacade().getEntry(state);\n2795:         Object exit = Model.getFacade().getExit(state);\n2796:         Object doact = Model.getFacade().getDoActivity(state);\n2797:         if (entry != null) {\n2798:             String entryStr = generate(entry);\n2799:             if (entryStr.length() > 0) s += \"entry / \" + entryStr;\n2800:         }\n2801:         if (exit != null) {\n2802:             String doStr = generate(doact);\n2803:             if (s.length() > 0) s += LINE_SEPARATOR;\n2804:             if (doStr.length() > 0) s += \"do / \" + doStr;\n2805:         }\n2806:         if (exit != null) {\n2807:             String exitStr = generate(exit);\n2808:             if (s.length() > 0) s += LINE_SEPARATOR;\n2809:             if (exitStr.length() > 0) s += \"exit / \" + exitStr;\n2810:         }\n2811:         Collection trans = Model.getFacade().getInternalTransitions(state);\n2812:         if (trans != null) {\n2813:             Iterator iter = trans.iterator();\n2814:             while (iter.hasNext()) {\n2815:                 if (s.length() > 0) s += LINE_SEPARATOR;\n2816:                 s += generateTransition(iter.next());\n2817:             }\n2818:         }\n2819:         return s;\n2820:     }\n2821: \n2822:     /**\n2823:      * @see org.argouml.application.api.NotationProvider2#generateTransition(java.lang.Object)\n2824:      */\n2825:     public String generateTransition(Object transition) {\n2826:         String s = generate(Model.getFacade().getName(transition));\n2827:         String t = generate(Model.getFacade().getTrigger(transition));\n2828:         String g = generate(Model.getFacade().getGuard(transition));\n2829:         String e = generate(Model.getFacade().getEffect(transition));\n2830:         if (s.length() > 0) s += \": \";\n2831:         s += t;\n2832:         if (g.length() > 0) s += \" [\" + g + \"]\";\n2833:         if (e.length() > 0) s += \" / \" + e;\n2834:         return s;\n2835:     }\n2836: \n2837:     /**\n2838:      * @see org.argouml.application.api.NotationProvider2#generateAction(java.lang.Object)\n2839:      */\n2840:     public String generateAction(Object m) {\n2841:         Object script = Model.getFacade().getScript(m);\n2842:         if ((script != null) && (Model.getFacade().getBody(script) != null))\n2843:             return Model.getFacade().getBody(script).toString();\n2844:         return \"\";\n2845:     }\n2846: \n2847:     /**\n2848:      * @see org.argouml.application.api.NotationProvider2#generateActionState(java.lang.Object)\n2849:      */\n2850:     public String generateActionState(Object actionState) {\n2851:         String ret = \"\";\n2852:         Object action = Model.getFacade().getEntry(actionState);\n2853:         if (action != null) {\n2854:             Object expression = Model.getFacade().getScript(action);\n2855:             if (expression != null) {\n2856:                 ret = generateExpression(expression);\n2857:             }\n2858:         }\n2859:         return ret;\n2860:     }\n2861: \n2862:     /**\n2863:      * @see org.argouml.application.api.NotationProvider2#generateGuard(java.lang.Object)\n2864:      */\n2865:     public String generateGuard(Object guard) {\n2866:         if (Model.getFacade().getExpression(guard) != null)\n2867:             return generateExpression(Model.getFacade().getExpression(guard));\n2868:         return \"\";\n2869:     }\n2870: \n2871:     /**\n2872:      * @see org.argouml.application.api.NotationProvider2#generateMessage(java.lang.Object)\n2873:      */\n2874:     public String generateMessage(Object message) {\n2875:         if (message == null) {\n2876:             return \"\";\n2877:         }\n2878:         return generateName(Model.getFacade().getName(message)) + \"::\"\n2879:             + generateAction(Model.getFacade().getAction(message));\n2880:     }\n2881: \n2882:     /**\n2883:      * @see org.argouml.application.api.ArgoModule#getModuleName()\n2884:      */\n2885:     public String getModuleName() { return \"GeneratorCpp\"; }\n2886:     /**\n2887:      * @see org.argouml.application.api.ArgoModule#getModuleDescription()\n2888:      */\n2889:     public String getModuleDescription() {\n2890:         return \"Cpp Notation and Code Generator\";\n2891:     }\n2892:     /**\n2893:      * @see org.argouml.application.api.ArgoModule#getModuleAuthor()\n2894:      */\n2895:     public String getModuleAuthor() { return \"Achim Spangler\"; }\n2896:     /**\n2897:      * @see org.argouml.application.api.ArgoModule#getModuleVersion()\n2898:      */\n2899:     public String getModuleVersion() { return \"0.17.2\"; }\n2900:     /**\n2901:      * @see org.argouml.application.api.ArgoModule#getModuleKey()\n2902:      */\n2903:     public String getModuleKey() { return \"module.language.cpp.generator\"; }\n2904: \n2905:     /** Load configurable parameters.\n2906:      */\n2907:     public void loadConfig() {\n2908:         int indWidth = Configuration.getInteger(KEY_CPP_INDENT, 4);\n2909:         char[] ind = new char[indWidth];\n2910:         for (int i = 0; i < indWidth; i++)\n2911:             ind[i] = ' ';\n2912:         this.indent = new String(ind);\n2913:         lfBeforeCurly =\n2914:             Configuration.getBoolean(KEY_CPP_LF_BEFORE_CURLY, false);\n2915:         verboseDocs = Configuration.getBoolean(KEY_CPP_VERBOSE_COMM, false);\n2916:         int useSect = Configuration.getInteger(KEY_CPP_SECT,\n2917:                                                Section.SECT_NORMAL);\n2918:         Section.setUseSect(useSect);\n2919:     }\n2920: \n2921:     /**\n2922:      * @return true if the generator outputs a newline before the\n2923:      * curly brace starting a class declaration.\n2924:      */\n2925:     public boolean isLfBeforeCurly() {\n2926:         return lfBeforeCurly;\n2927:     }\n2928: \n2929:     /**\n2930:      * Sets whether to output a newline character before the curly\n2931:      * brace starting a class declaration.\n2932:      * @param beforeCurly true to generate the '{' on a line on its own.\n2933:      */\n2934:     public void setLfBeforeCurly(boolean beforeCurly) {\n2935:         this.lfBeforeCurly = beforeCurly;\n2936:         Configuration.setBoolean(KEY_CPP_LF_BEFORE_CURLY, beforeCurly);\n2937:     }\n2938: \n2939:     /**\n2940:      * @return If the generator generates verbose comments and docs or not.\n2941:      */\n2942:     public boolean isVerboseDocs() {\n2943:         return verboseDocs;\n2944:     }\n2945:     \n2946:     /**\n2947:      * Tells whether to generate verbose comments and docs or not.\n2948:      * @param verbose true to generate more verbose comments.\n2949:      */\n2950:     public void setVerboseDocs(boolean verbose) {\n2951:         this.verboseDocs = verbose;\n2952:         Configuration.setBoolean(KEY_CPP_VERBOSE_COMM, verbose);\n2953:     }\n2954: \n2955:     /**\n2956:      * @return The current width of the indentation.\n2957:      */\n2958:     public int getIndent() {\n2959:         return indent.length();\n2960:     }\n2961: \n2962:     /**\n2963:      * Sets the indentation width.\n2964:      * @param indWidth The number of spaces to use for indentation.\n2965:      */\n2966:     public void setIndent(int indWidth) {\n2967:         char[] ind = new char[indWidth];\n2968:         for (int i = 0; i < indWidth; i++)\n2969:             ind[i] = ' ';\n2970:         this.indent = new String(ind);\n2971:         Configuration.setInteger(KEY_CPP_INDENT, indWidth);\n2972:     }\n2973: \n2974:     /**\n2975:      * @return Whether sections are generated and how.\n2976:      * @see setUseSect\n2977:      */\n2978:     public int getUseSect() {\n2979:         return Section.getUseSect();\n2980:     }\n2981: \n2982:     /**\n2983:      * Tells the generator if and how to generate sections.\n2984:      * @param use Must be one of: \n2985:      * <ul>\n2986:      *   <li>SECT_NONE: sections are not generated;</li>\n2987:      *   <li>SECT_NORMAL: sections are generated;</li>\n2988:      *   <li>SECT_BRIEF: sections are generated, but the \"do not delete...\"\n2989:      *       line is skipped.</li>\n2990:      * </ul>\n2991:      */\n2992:     public void setUseSect(int use) {\n2993:         Section.setUseSect(use);\n2994:         Configuration.setInteger(KEY_CPP_SECT, use);\n2995:     }\n2996: \n2997:     /*\n2998:      * Set of already-generated classifiers.\n2999:      */\n3000:     private Set generatedFiles = null;\n3001:     /*\n3002:      * Number of calls to startGenerateFile non closed.\n3003:      */\n3004:     private int generateRecur = 0;\n3005: \n3006:     /* implementation of CodeGenerator */\n3007:     \n3008:     /*\n3009:      *  Start generating files. Needed to track dependencies.\n3010:      */\n3011:     private void startFileGeneration() {\n3012:         if (generateRecur++ == 0) {\n3013:             generatedFiles = new HashSet();\n3014:         }\n3015:     }\n3016:     \n3017:     /*\n3018:      * End generating files. Needed to track dependencies.\n3019:      */\n3020:     private void endFileGeneration() {\n3021:         if (--generateRecur == 0) {\n3022:             generatedFiles = null;\n3023:         }\n3024:     }\n3025:     \n3026:     /**\n3027:      * Generate files for element 'o' (and dependencies, eventually).\n3028:      * Return the collection of files (as Strings).\n3029:      * Do nothing (and return an empty collection) it 'o' is in generatedFiles.\n3030:      */\n3031:     private Collection generateFilesForElem(Object o,\n3032:                                             String path, boolean deps) {\n3033:         Vector ret = new Vector();\n3034:         if (generatedFiles.contains(o)) {\n3035:             return ret; // generated already\n3036:         }\n3037:         if (!Model.getFacade().isAClass(o)\n3038:                 && !Model.getFacade().isAInterface(o)) {\n3039:             return ret; // not a class or interface\n3040:         }\n3041:         while (isAInnerClass(o)) {\n3042:             o = Model.getFacade().getNamespace(o);\n3043:         }\n3044:         String pathname = null;\n3045: \n3046:         // use unique section for both passes -> allow move of\n3047:         // normal function body to inline and vice versa\n3048:         if (Section.getUseSect() != Section.SECT_NONE) {\n3049:             sect = new Section();\n3050: \n3051:             /*\n3052:              * 2002-11-28 Achim Spangler\n3053:              * first read header and source file into global/unique section\n3054:              */\n3055:             for (generatorPass = HEADER_PASS;\n3056:                  generatorPass <= SOURCE_PASS;\n3057:                  generatorPass++) {\n3058:                 pathname = createDirectoriesPathname(o, path);\n3059:                 //String pathname = path + filename;\n3060:                 // TODO: package, project basepath, tagged values to configure\n3061:                 File f = new File(pathname);\n3062:                 if (f.exists()) {\n3063:                     LOG.info(\"Generating (updated) \" + f.getPath());\n3064:                     sect.read(pathname);\n3065:                     File bakFile = new File(pathname + \".bak\");\n3066:                     if (bakFile.exists()) {\n3067:                         bakFile.delete();\n3068:                     }\n3069:                     f.renameTo(bakFile);\n3070:                 } else {\n3071:                     LOG.info(\"Generating (new) \" + f.getPath());\n3072:                 }\n3073:             }\n3074:         }\n3075: \n3076:         Set dependencies = null;\n3077:         if (deps) dependencies = new TreeSet();\n3078:         /**\n3079:          * 2002-11-28 Achim Spangler\n3080:          * run basic generation function two times for header and implementation\n3081:          */\n3082:         for (generatorPass = HEADER_PASS;\n3083:              generatorPass <= SOURCE_PASS;\n3084:              generatorPass++) {\n3085:             pathname = createDirectoriesPathname(o, path);\n3086:             String fileContent = generateFileAsString(o, pathname);\n3087:             if (fileContent.length() == 0) continue;\n3088:             BufferedWriter fos = null;\n3089:             //String pathname = pa