                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/swingext/GridLayout2.java: \n1: // $Id$\n2: // Copyright (c) 2003-2004 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: /*\n26:  * GridLayout2.java\n27:  */\n28: package org.argouml.swingext;\n29: \n30: import java.awt.*;\n31: \n32: /**\n33:  * Same as the standard java class GridLayout but allows more\n34:  * flexability for sizing of columns and rows.\n35:  *\n36:  * @author Bob Tarling\n37:  */\n38: public class GridLayout2 implements LayoutManager, java.io.Serializable {\n39: \n40:      /**\n41:        * Do not resize the child components.\n42:        */\n43:     public static final int NONE = 0;\n44: \n45:      /**\n46:        * Resize all child components to fit their cell both\n47:        * horizontally and vertically.\n48:        */\n49:     public static final int BOTH = 1;\n50: \n51:      /**\n52:        * Resize all child components to fit their cell horizontally\n53:        * but not vertically.\n54:        */\n55:     public static final int HORIZONTAL = 2;\n56: \n57:      /**\n58:        * Resize all child components to fit their cell vertically but\n59:        * not horizontally.\n60:        */\n61:     public static final int VERTICAL = 3;\n62: \n63:      /**\n64:       * Put the component in the center of its display area.\n65:       */\n66:     public static final int CENTER = 10;\n67: \n68:      /**\n69:        * Put the component at the top of its display area,\n70:        * centered horizontally.\n71:        */\n72:     public static final int NORTH = 11;\n73: \n74:       /**\n75:        * Put the component at the top-right corner of its display area.\n76:        */\n77:     public static final int NORTHEAST = 12;\n78: \n79:       /**\n80:        * Put the component on the right side of its display area,\n81:        * centered vertically.\n82:        */\n83:     public static final int EAST = 13;\n84: \n85:       /**\n86:        * Put the component at the bottom-right corner of its display area.\n87:        */\n88:     public static final int SOUTHEAST = 14;\n89: \n90:       /**\n91:        * Put the component at the bottom of its display area, centered\n92:        * horizontally.\n93:        */\n94:     public static final int SOUTH = 15;\n95: \n96:      /**\n97:        * Put the component at the bottom-left corner of its display area.\n98:        */\n99:     public static final int SOUTHWEST = 16;\n100: \n101:       /**\n102:        * Put the component on the left side of its display area,\n103:        * centered vertically.\n104:        */\n105:     public static final int WEST = 17;\n106: \n107:      /**\n108:        * Put each component in the top-left corner of its display area.\n109:        */\n110:     public static final int NORTHWEST = 18;\n111: \n112:     /**\n113:      * This is the horizontal gap (in pixels) which specifies the space\n114:      * between columns.  They can be changed at any time.\n115:      * This should be a non negative integer.\n116:      *\n117:      * @serial\n118:      * @see #getHgap()\n119:      * @see #setHgap(int)\n120:      */\n121:     private int h;\n122:     /**\n123:      * This is the vertical gap (in pixels) which specifies the space\n124:      * between rows.  They can be changed at any time.\n125:      * This should be a non negative integer.\n126:      *\n127:      * @serial\n128:      * @see #getVgap()\n129:      * @see #setVgap(int)\n130:      */\n131:     private int vgap;\n132:     /**\n133:      * This is the number of rows specified for the grid.  The number\n134:      * of rows can be changed at any time.\n135:      * This should be a non negative integer, where '0' means\n136:      * 'any number' meaning that the number of Rows in that\n137:      * dimension depends on the other dimension.\n138:      *\n139:      * @serial\n140:      * @see #getRows()\n141:      * @see #setRows(int)\n142:      */\n143:     private int rows;\n144:     /**\n145:      * This is the number of columns specified for the grid.  The number\n146:      * of columns can be changed at any time.\n147:      * This should be a non negative integer, where '0' means\n148:      * 'any number' meaning that the number of Columns in that\n149:      * dimension depends on the other dimension.\n150:      *\n151:      * @serial\n152:      * @see #getColumns()\n153:      * @see #setCols(int)\n154:      */\n155:     private int cols;\n156: \n157:     /**\n158:      * Size all cells as the largest prefered width and height\n159:      * component. <p>\n160:      *\n161:      * A possible value for the cellSizing parameter of the\n162:      * constructor in order to size cells so that each have the same\n163:      * width and height. The width is the largest prefered width and\n164:      * the height is the largest prefered height of all these child\n165:      * components.\n166:      */\n167:     public static final int MAXPREFERRED = 20;\n168: \n169:     /**\n170:      * Size all cells so that all in the same row are the same height\n171:      * and all in the same column are the same width.<p>\n172:      *\n173:      * A possible value for the cellSizing parameter of the\n174:      * constructor. The width is the largest prefered width of all\n175:      * components in the same column and the height is the largest\n176:      * prefered height of all components in the same row.\n177:      */\n178:     public static final int ROWCOLPREFERRED = 21;\n179: \n180:     /**\n181:      * Size all cells as the same width and height to fit the parent\n182:      * component. <p>\n183:      *\n184:      * A possible value for the cellSizing parameter of the\n185:      * constructor in order to size cells so that each has the same\n186:      * height and width and are sized to fit their parent.  This\n187:      * emulates the sizing done by a standard GridLayout.\n188:      */\n189:     public static final int FITPARENT = 22;\n190: \n191:     int cellSizing = FITPARENT;\n192: \n193:     private int fill = BOTH;\n194:     private int anchor = WEST;\n195: \n196:     /**\n197:      * The height of the child component with the largest height\n198:      */\n199:     protected int largestHeight;\n200:     /**\n201:      * The width of the child component with the largest width\n202:      */\n203:     protected int largestWidth;\n204:     /**\n205:      * The required cell width of each column\n206:      */\n207:     protected int[] colWidth;\n208:     /**\n209:      * The required cell height of each row\n210:      */\n211:     protected int[] rowHeight;\n212: \n213:     /**\n214:      * Construct a new GridLayout2 with a default of one column per\n215:      * component, in a single row.\n216:      */\n217:     public GridLayout2() {\n218: \tthis(1, 0, 0, 0);\n219:     }\n220: \n221:     /**\n222:      * Construct a new GridLayout2 with the specified number of rows\n223:      * and columns.\n224:      *\n225:      * @param r the number of rows in the layout\n226:      * @param c the number of columns in the layout\n227:      */\n228:     public GridLayout2(int r, int c) {\n229: \tthis(r, c, 0, 0);\n230:     }\n231: \n232:     /**\n233:      * Construct a new GridLayout2 with the specified number of rows\n234:      * and columns and cell spacing.\n235:      *\n236:      * @param r the number of rows in the layout\n237:      * @param c the number of columns in the layout\n238:      * @param hgap the horizontal gap between cells\n239:      * @param vgap the vertical gap between cells\n240:      */\n241:     public GridLayout2(int r, int c, int hgap, int vgap) {\n242: \tif ((r == 0) && (c == 0)) {\n243: \t    throw new IllegalArgumentException(\"rows and cols cannot \"\n244: \t\t\t\t\t       + \"both be zero\");\n245: \t}\n246: \tthis.rows = r;\n247: \tthis.cols = c;\n248: \tthis.h = hgap;\n249: \tthis.vgap = vgap;\n250:     }\n251: \n252:     /**\n253:      * Construct a new GridLayout2 with the specified number of rows\n254:      * and columns and cell sizing scheme.\n255:      *\n256:      * @param r the number of rows in the layout\n257:      * @param c the number of columns in the layout\n258:      * @param cellSizing the required cell sizing scheme\n259:      */\n260:     public GridLayout2(int r, int c, int cellSizing) {\n261: \tthis(r, c, 0, 0, cellSizing);\n262:     }\n263: \n264:     /**\n265:      * Construct a new GridLayout2 with the specified number of rows\n266:      * and columns, cell spacing and cell sizing scheme.\n267:      *\n268:      * @param r the number of rows in the layout\n269:      * @param c the number of columns in the layout\n270:      * @param hgap the horizontal gap between cells\n271:      * @param vgap the vertical gap between cells\n272:      * @param cellSizing the required cell sizing scheme\n273:      */\n274:     public GridLayout2(int r, int c, int hgap, int vgap, int cellSizing) {\n275:         this(r, c, hgap, vgap);\n276:         this.cellSizing = cellSizing;\n277:     }\n278: \n279:     /**\n280:      * Construct a new GridLayout2 with the specified number of rows\n281:      * and columns, cell spacing, cell sizing scheme and filling\n282:      * scheme.\n283:      *\n284:      * @param r the number of rows in the layout\n285:      * @param cols the number of columns in the layout\n286:      * @param hgap the horizontal gap between cells\n287:      * @param vgap the vertical gap between cells\n288:      * @param cellSizing the required cell sizing scheme\n289:      * @param fill the required cell filling scheme\n290:      */\n291:     public GridLayout2(int r, int cols, int hgap, int vgap,\n292:                        int cellSizing, int fill)\n293:     {\n294:         this(r, cols, hgap, vgap, cellSizing);\n295:         this.fill = fill;\n296:     }\n297: \n298:     /**\n299:      * Construct a new GridLayout2 with the specified number of rows\n300:      * and columns, cell spacing, cell sizing scheme and component\n301:      * sizing and anchoring scheme.\n302:      *\n303:      * @param rows the number of rows in the layout\n304:      * @param cols the number of columns in the layout\n305:      * @param hgap the horizontal gap between cells\n306:      * @param vgap the vertical gap between cells\n307:      * @param cellSizing the required cell sizing scheme\n308:      * @param fill the required cell filling scheme\n309:      * @param anchor the required anchoring of a child component within its cell\n310:      */\n311:     public GridLayout2(int rows, int cols, int hgap, int vgap,\n312: \t\t       int cellSizing, int fill, int anchor) {\n313:         this(rows, cols, hgap, vgap, cellSizing, fill);\n314:         this.anchor = anchor;\n315:     }\n316: \n317: \n318:     /** \n319:      * Adds the specified component with the specified name to the\n320:      * layout. This is included to satisfy the LayoutManager interface\n321:      * but is not actually used in this layout implementation.\n322:      *\n323:      * @param name the name of the component\n324:      * @param comp the component to be added\n325:      */    \n326:     public void addLayoutComponent(String name, Component comp) {\n327:     }\n328: \n329:     /** \n330:      * Removes the specified component with the specified name from\n331:      * the layout. This is included to satisfy the LayoutManager\n332:      * interface but is not actually used in this layout\n333:      * implementation.<p>\n334:      *\n335:      * @param comp the name of the component\n336:      */    \n337:     public void removeLayoutComponent(Component comp) {\n338:     }\n339: \n340:     /**\n341:      * Determines the preferred size of the container argument using\n342:      * this grid layout.  The preferred size of a grid layout is\n343:      * dependant on the cellSizing scheme.<p>\n344:      *\n345:      * MAXPREFERRED and FITPARENT use the same formula to calculate\n346:      * prefered size.<p>\n347:      *\n348:      * The prefered width using MAXPREFERRED or FITPARENT is the\n349:      * largest preferred width of any of the widths in the container\n350:      * times the number of columns, plus the horizontal padding times\n351:      * the number of columns plus one, plus the left and right insets\n352:      * of the target container.<p>\n353:      *\n354:      * The preferred height using MAXPREFERRED or FITPARENT is the\n355:      * largest preferred height of any of the heights in the container\n356:      * times the number of rows, plus the vertical padding times the\n357:      * number of rows plus one, plus the top and bottom insets of the\n358:      * target container.<p>\n359:      *\n360:      * The prefered width using ROWCOLPREFERRED is the largest\n361:      * preferred is the sum of the widths of of all columns, plus the\n362:      * horizontal padding times the number of columns plus one, plus\n363:      * the left and right insets of the target container.<p>\n364:      *\n365:      * The prefered height using ROWCOLPREFERRED is the largest\n366:      * preferred is the sum of the heights of of all columns, plus the\n367:      * horizontal padding times the number of columns plus one, plus\n368:      * the left and right insets of the target container.\n369:      *\n370:      * @param parent the container to be laid out \n371:      * @return the preferred dimensions to lay out the subcomponents\n372:      * of the specified container\n373:      */\n374:     public Dimension preferredLayoutSize(Container parent) {\n375:         synchronized (parent.getTreeLock()) {\n376:             int componentCount = parent.getComponentCount();\n377:             int actualRows = rows;\n378:             int actualCols = cols;\n379: \n380:             if (actualRows > 0) {\n381:                 actualCols = (componentCount + actualRows - 1) / actualRows;\n382:             } else {\n383:                 actualRows = (componentCount + actualCols - 1) / actualCols;\n384:             }\n385: \n386:             colWidth = new int[actualCols];\n387:             rowHeight = new int[actualRows];\n388:             int largestPreferredWidth = 0;\n389:             int largestPreferredHeight = 0;\n390: \n391:             for (int c = 0; c < actualCols; ++c) {\n392:                 for (int r = 0; r < actualRows; ++r) {\n393:                     int i = r * actualCols + c;\n394:                     if (i < componentCount) {\n395:                         if (parent.getComponent(i).getPreferredSize().getWidth()\n396: \t\t\t    > colWidth[c]) {\n397:                             colWidth[c] =\n398: \t\t\t\t(int) parent.getComponent(i)\n399: \t\t\t\t    .getPreferredSize().getWidth();\n400:                             if (colWidth[c] > largestPreferredWidth)\n401: \t\t\t\tlargestPreferredWidth = colWidth[c];\n402:                         }\n403:                         if (parent.getComponent(i)\n404: \t\t\t    .getPreferredSize().getHeight()\n405: \t\t\t    > rowHeight[r])\n406: \t\t\t{\n407:                             rowHeight[r] =\n408: \t\t\t\t(int) parent.getComponent(i)\n409: \t\t\t\t    .getPreferredSize().getHeight();\n410:                             if (rowHeight[r] > largestPreferredHeight)\n411: \t\t\t\tlargestPreferredHeight = rowHeight[r];\n412:                         }\n413:                     }\n414:                 }\n415:             }\n416: \n417:             return calculateSizes(parent, colWidth, rowHeight,\n418: \t\t\t\t  actualRows, actualCols,\n419: \t\t\t\t  largestPreferredWidth,\n420: \t\t\t\t  largestPreferredHeight);\n421:         }\n422:     }\n423: \n424:     /* Required by LayoutManager. */\n425:     public Dimension minimumLayoutSize(Container parent) {\n426:         synchronized (parent.getTreeLock()) {\n427:             int componentCount = parent.getComponentCount();\n428:             int actualRows = rows;\n429:             int actualCols = cols;\n430: \n431:             if (actualRows > 0) {\n432:                 actualCols = (componentCount + actualRows - 1) / actualRows;\n433:             } else {\n434:                 actualRows = (componentCount + actualCols - 1) / actualCols;\n435:             }\n436: \n437:             colWidth = new int[actualCols];\n438:             rowHeight = new int[actualRows];\n439:             int largestMinimumWidth = 0;\n440:             int largestMinimumHeight = 0;\n441: \n442:             for (int c = 0; c < actualCols; ++c) {\n443:                 for (int r = 0; r < actualRows; ++r) {\n444:                     int i = r * actualCols + c;\n445:                     if (i < componentCount) {\n446:                         if (parent.getComponent(i).getMinimumSize().getWidth()\n447: \t\t\t    > colWidth[c]) \n448: \t\t\t{\n449:                             colWidth[c] =\n450: \t\t\t\t(int) parent.getComponent(i)\n451: \t\t\t\t    .getMinimumSize().getWidth();\n452:                             if (colWidth[c] > largestMinimumWidth)\n453: \t\t\t\tlargestMinimumWidth = colWidth[c];\n454:                         }\n455:                         if (parent.getComponent(i).getMinimumSize().getHeight()\n456: \t\t\t    > rowHeight[r]) {\n457:                             rowHeight[r] =\n458: \t\t\t\t(int) parent.getComponent(i)\n459: \t\t\t\t    .getMinimumSize().getHeight();\n460:                             if (rowHeight[r] > largestMinimumHeight)\n461: \t\t\t\tlargestMinimumHeight = rowHeight[r];\n462:                         }\n463:                     }\n464:                 }\n465:             }\n466: \n467:             return calculateSizes(parent, colWidth, rowHeight,\n468: \t\t\t\t  actualRows, actualCols,\n469: \t\t\t\t  largestMinimumWidth, largestMinimumHeight);\n470:         }\n471:     }\n472: \n473:     public void layoutContainer(Container parent) {\n474:         synchronized (parent.getTreeLock()) {\n475:             int ncomponents = parent.getComponentCount();\n476:             if (ncomponents == 0) {\n477:                 return;\n478:             }\n479:             Insets insets = parent.getInsets();\n480:             int nrows = this.rows;\n481:             int ncols = this.cols;\n482: \n483:             if (nrows > 0) {\n484:                 ncols = (ncomponents + nrows - 1) / nrows;\n485:             } else {\n486:                 nrows = (ncomponents + ncols - 1) / ncols;\n487:             }\n488: \n489:             colWidth = new int[ncols];\n490:             rowHeight = new int[nrows];\n491:             largestWidth = 0;\n492:             largestHeight = 0;\n493: \n494:             if (cellSizing == FITPARENT) {\n495:                 int availableWidth =\n496: \t\t    parent.getWidth() \n497: \t\t    - (insets.left + insets.right + (ncols - 1) * h);\n498:                 int availableHeight =\n499: \t\t    parent.getHeight()\n500: \t\t    - (insets.top + insets.bottom + (nrows - 1) * vgap);\n501:                 largestWidth = availableWidth / ncols;\n502:                 largestHeight = availableHeight / nrows;\n503:             }\n504:             else {\n505:                 for (int c = 0; c < ncols; ++c) {\n506:                     for (int r = 0; r < nrows; ++r) {\n507:                         int i = r * ncols + c;\n508:                         if (i < ncomponents) {\n509:                             if (parent.getComponent(i)\n510: \t\t\t\t.getPreferredSize().getWidth()\n511: \t\t\t\t> colWidth[c])\n512: \t\t\t    {\n513:                                 colWidth[c] =\n514: \t\t\t\t    (int) parent.getComponent(i)\n515: \t\t\t\t        .getPreferredSize().getWidth();\n516:                                 if (colWidth[c] > largestWidth)\n517: \t\t\t\t    largestWidth = colWidth[c];\n518:                             }\n519:                             if (parent.getComponent(i)\n520: \t\t\t\t.getPreferredSize().getHeight()\n521: \t\t\t\t> rowHeight[r])\n522: \t\t\t    {\n523:                                 rowHeight[r] =\n524: \t\t\t\t    (int) parent.getComponent(i)\n525: \t\t\t\t        .getPreferredSize().getHeight();\n526:                                 if (rowHeight[r] > largestHeight)\n527: \t\t\t\t    largestHeight = rowHeight[r];\n528:                             }\n529:                         }\n530:                     }\n531:                 }\n532:             }\n533: \n534:             int cellWidth;\n535:             int cellHeight;\n536:             for (int c = 0, x = insets.left;\n537: \t\t c < ncols;\n538: \t\t x += cellWidth + h, ++c)\n539: \t    {\n540:                 cellWidth = getComponentCellWidth(c);\n541:                 for (int r = 0, y = insets.top;\n542: \t\t     r < nrows;\n543: \t\t     y += cellHeight + vgap, ++r)\n544: \t\t{\n545:                     cellHeight = getComponentCellHeight(r);\n546: \n547:                     int i = r * ncols + c;\n548: \n549:                     if (i < ncomponents) {\n550:                         positionComponentInCell(parent.getComponent(i), x, y,\n551: \t\t\t\t\t\tcellWidth, cellHeight);\n552:                     }\n553:                 }\n554:             }\n555:         }\n556:     }\n557: \n558: \n559:     protected Dimension calculateSizes(Container parent, \n560: \t\t\t\t       int colWidth[], int rowHeight[],\n561: \t\t\t\t       int actualRows, int actualCols,\n562: \t\t\t\t       int largestWidth, int largestHeight)\n563:     {\n564:         int w = 0;\n565:         int h = 0;\n566:         if (cellSizing == GridLayout2.ROWCOLPREFERRED) {\n567:             for (int c = 0; c < actualCols; ++c) w += colWidth[c];\n568:             for (int r = 0; r < actualRows; ++r) h += rowHeight[r];\n569:         }\n570:         else {\n571:             w = largestWidth * actualCols;\n572:             h = largestHeight * actualRows;\n573:         }\n574: \n575:         Insets insets = parent.getInsets();\n576:         return new Dimension(insets.left + insets.right + w \n577: \t\t\t     + (actualCols - 1) * this.h,\n578:                              insets.top + insets.bottom + h\n579: \t\t\t     + (actualRows - 1) * vgap);\n580:     }\n581: \n582:     protected int getComponentCellHeight(int row) {\n583:         if (cellSizing == ROWCOLPREFERRED) return rowHeight[row];\n584:         return largestHeight;\n585:     }\n586: \n587:     protected int getComponentCellWidth(int col) {\n588:         if (cellSizing == ROWCOLPREFERRED) return colWidth[col];\n589:         return largestWidth;\n590:     }\n591: \n592:     protected void positionComponentInCell(Component c