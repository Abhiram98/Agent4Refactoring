;\n31: import java.io.FileOutputStream;\n32: import java.io.IOException;\n33: import java.io.InputStreamReader;\n34: import java.io.OutputStream;\n35: import java.io.OutputStreamWriter;\n36: import java.io.PrintWriter;\n37: import java.io.UnsupportedEncodingException;\n38: import java.io.Writer;\n39: import java.net.URL;\n40: import java.util.Hashtable;\n41: import java.util.List;\n42: \n43: import javax.swing.JProgressBar;\n44: import javax.swing.text.JTextComponent;\n45: import javax.xml.transform.Result;\n46: import javax.xml.transform.Transformer;\n47: import javax.xml.transform.TransformerException;\n48: import javax.xml.transform.TransformerFactory;\n49: import javax.xml.transform.stream.StreamResult;\n50: import javax.xml.transform.stream.StreamSource;\n51: \n52: import org.apache.log4j.Logger;\n53: import org.argouml.application.ArgoVersion;\n54: import org.argouml.kernel.Project;\n55: import org.argouml.kernel.ProjectMember;\n56: import org.argouml.uml.ProjectMemberModel;\n57: import org.argouml.uml.cognitive.ProjectMemberTodoList;\n58: import org.argouml.uml.diagram.ProjectMemberDiagram;\n59: import org.tigris.gef.ocl.ExpansionException;\n60: import org.tigris.gef.ocl.OCLExpander;\n61: import org.tigris.gef.ocl.TemplateReader;\n62: import org.xml.sax.SAXException;\n63: \n64: /**\n65:  * To persist to and from argo (xml file) storage.\n66:  *\n67:  * @author Bob Tarling\n68:  */\n69: public class UmlFilePersister extends AbstractFilePersister {\n70:     /**\n71:      * Logger.\n72:      */\n73:     private static final Logger LOG =\n74:         Logger.getLogger(UmlFilePersister.class);\n75: \n76:     private static final String ARGO_TEE = \"/org/argouml/persistence/argo2.tee\";\n77: \n78:     /**\n79:      * The constructor.\n80:      */\n81:     public UmlFilePersister() {\n82:     }\n83: \n84:     /**\n85:      * @see org.argouml.persistence.AbstractFilePersister#getExtension()\n86:      */\n87:     public String getExtension() {\n88:         return \"uml\";\n89:     }\n90: \n91:     /**\n92:      * @see org.argouml.persistence.AbstractFilePersister#getDesc()\n93:      */\n94:     protected String getDesc() {\n95:         return \"ArgoUML project file\";\n96:     }\n97: \n98:     /**\n99:      * It is being considered to save out individual\n100:      * xmi's from individuals diagrams to make\n101:      * it easier to modularize the output of Argo.\n102:      *\n103:      * @param file The file to write.\n104:      * @param project the project to save\n105:      * @throws SaveException when anything goes wrong\n106:      *\n107:      * @see org.argouml.persistence.ProjectFilePersister#save(\n108:      * org.argouml.kernel.Project, java.io.File)\n109:      */\n110:     public void doSave(Project project, File file)\n111:         throws SaveException {\n112: \n113:         File lastArchiveFile = new File(file.getAbsolutePath() + \"~\");\n114:         File tempFile = null;\n115:         \n116:         try {\n117:             tempFile = createTempFile(file);\n118:         } catch (FileNotFoundException e) {\n119:             throw new SaveException(\n120:                     \"Failed to archive the previous file version\", e);\n121:         } catch (IOException e) {\n122:             throw new SaveException(\n123:                     \"Failed to archive the previous file version\", e);\n124:         }\n125:         \n126:         try {\n127: \n128:             project.setFile(file);\n129:             project.setVersion(ArgoVersion.getVersion());\n130:             project.setPersistenceVersion(PERSISTENCE_VERSION);\n131: \n132:             FileOutputStream stream =\n133:                 new FileOutputStream(file);\n134: \n135:             writeProject(project, stream);\n136: \n137:             stream.close();\n138: \n139:             String path = file.getParent();\n140:             if (LOG.isInfoEnabled()) {\n141:                 LOG.info(\"Dir ==\" + path);\n142:             }\n143: \n144:             // if save did not raise an exception\n145:             // and name+\"#\" exists move name+\"#\" to name+\"~\"\n146:             // this is the correct backup file\n147:             if (lastArchiveFile.exists()) {\n148:                 lastArchiveFile.delete();\n149:             }\n150:             if (tempFile.exists() && !lastArchiveFile.exists()) {\n151:                 tempFile.renameTo(lastArchiveFile);\n152:             }\n153:             if (tempFile.exists()) {\n154:                 tempFile.delete();\n155:             }\n156:         } catch (Exception e) {\n157:             LOG.error(\"Exception occured during save attempt\", e);\n158: \n159:             // frank: in case of exception\n160:             // delete name and mv name+\"#\" back to name if name+\"#\" exists\n161:             // this is the \"rollback\" to old file\n162:             file.delete();\n163:             tempFile.renameTo(file);\n164:             // we have to give a message to user and set the system to unsaved!\n165:             throw new SaveException(e);\n166:         }\n167:     }\n168: \n169:     /**\n170:      * Write the output for a project on the given stream.\n171:      *\n172:      * @param project The project to output.\n173:      * @param stream The stream to write to.\n174:      * @throws SaveException If something goes wrong.\n175:      */\n176:     void writeProject(Project project, OutputStream stream)\n177:         throws SaveException {\n178:         OutputStreamWriter outputStreamWriter;\n179:         try {\n180:             outputStreamWriter = new OutputStreamWriter(stream, \"UTF-8\");\n181:         } catch (UnsupportedEncodingException e) {\n182:             throw new SaveException(e);\n183:         }\n184:         PrintWriter writer =\n185:             new PrintWriter(new BufferedWriter(outputStreamWriter));\n186: \n187:         try {\n188:             Integer indent = new Integer(4);\n189: \n190:             writer.println(\"<?xml version = \\\"1.0\\\" \"\n191:                     + \"encoding = \\\"\" + \"UTF-8\" + \"\\\" ?>\");\n192:             writer.println(\"<uml version=\\\"\" + PERSISTENCE_VERSION + \"\\\">\");\n193:             // Write out header section\n194:             try {\n195:                 Hashtable templates =\n196:                     TemplateReader.getInstance().read(ARGO_TEE);\n197:                 OCLExpander expander = new OCLExpander(templates);\n198:                 expander.expand(writer, project, \"  \");\n199:                 // For next version of GEF:\n200:                 // expander.expand(writer, project, \"  \");\n201:             } catch (FileNotFoundException e) {\n202:                 throw new SaveException(e);\n203:             } catch (ExpansionException e) {\n204:                 throw new SaveException(e);\n205:             }\n206: \n207:             // Write out XMI section first\n208:             int size = project.getMembers().size();\n209:             for (int i = 0; i < size; i++) {\n210:                 ProjectMember projectMember =\n211:                     (ProjectMember) project.getMembers().get(i);\n212:                 if (projectMember.getType().equalsIgnoreCase(\"xmi\")) {\n213:                     if (LOG.isInfoEnabled()) {\n214:                         LOG.info(\"Saving member of type: \"\n215:                               + ((ProjectMember) project.getMembers()\n216:                                     .get(i)).getType());\n217:                     }\n218:                     MemberFilePersister persister = null;\n219:                     if (projectMember instanceof ProjectMemberDiagram) {\n220:                         persister = new DiagramMemberFilePersister();\n221:                     } else if (projectMember instanceof ProjectMemberTodoList) {\n222:                         persister = new TodoListMemberFilePersister();\n223:                     } else if (projectMember instanceof ProjectMemberModel) {\n224:                         persister = new ModelMemberFilePersister();\n225:                     }\n226:                     persister.save(projectMember, writer, indent);\n227:                 }\n228:             }\n229: \n230:             // Write out all non-XMI sections\n231:             for (int i = 0; i < size; i++) {\n232:                 ProjectMember projectMember =\n233:                     (ProjectMember) project.getMembers().get(i);\n234:                 if (!projectMember.getType().equalsIgnoreCase(\"xmi\")) {\n235:                     if (LOG.isInfoEnabled()) {\n236:                         LOG.info(\"Saving member of type: \"\n237:                               + ((ProjectMember) project.getMembers().\n238:                                     get(i)).getType());\n239:                     }\n240:                     MemberFilePersister persister = null;\n241:                     if (projectMember instanceof ProjectMemberDiagram) {\n242:                         persister = new DiagramMemberFilePersister();\n243:                     } else if (projectMember instanceof ProjectMemberTodoList) {\n244:                         persister = new TodoListMemberFilePersister();\n245:                     } else if (projectMember instanceof ProjectMemberModel) {\n246:                         persister = new ModelMemberFilePersister();\n247:                     }\n248:                     persister.save(projectMember, writer, indent);\n249:                 }\n250:             }\n251: \n252:             writer.println(\"</uml>\");\n253: \n254:             writer.flush();\n255:         } finally {\n256:             writer.close();\n257:         }\n258:     }\n259: \n260:     /**\n261:      * @see org.argouml.persistence.ProjectFilePersister#doLoad(java.net.URL,\n262:      * javax.swing.JProgressBar, javax.swing.text.JTextComponent progressText)\n263:      */\n264:     public Project doLoad(URL file, JProgressBar progressBar, JTextComponent progressText) throws OpenException {\n265:         try {\n266:             Project p = new Project(file);\n267: \n268:             // Run through any stylesheet upgrades\n269:             file = upgrade(file);\n270: \n271:             XmlInputStream inputStream =\n272:                         new XmlInputStream(file.openStream(), \"argo\");\n273: \n274:             ArgoParser parser = new ArgoParser();\n275:             parser.readProject(p, inputStream);\n276: \n277:             List memberList = parser.getMemberList();\n278: \n279:             LOG.info(memberList.size() + \" members\");\n280: \n281:             MemberFilePersister persister = null;\n282:             for (int i = 0; i < memberList.size(); ++i) {\n283:                 if (memberList.get(i).equals(\"pgml\")) {\n284:                     persister = new DiagramMemberFilePersister();\n285:                 } else if (memberList.get(i).equals(\"todo\")) {\n286:                     persister = new TodoListMemberFilePersister();\n287:                 } else if (memberList.get(i).equals(\"xmi\")) {\n288:                     persister = new ModelMemberFilePersister();\n289:                 }\n290:                 LOG.info(\"Loading member with \"\n291:                         + persister.getClass().getName());\n292:                 inputStream.reopen(persister.getMainTag());\n293:                 persister.load(p, inputStream);\n294:             }\n295:             inputStream.realClose();\n296:             p.postLoad();\n297:             return p;\n298:         } catch (IOException e) {\n299:             LOG.error(\"IOException\", e);\n300:             throw new OpenException(e);\n301:         } catch (SAXException e) {\n302:             LOG.error(\"SAXException\", e);\n303:             throw new OpenException(e);\n304:         }\n305:     }\n306: \n307:     private URL upgrade(URL file) throws OpenException {\n308:         try {\n309:             int versionFromFile = Integer.parseInt(getVersion(file));\n310: \n311:             LOG.info(\"Loading uml file of version \" + versionFromFile);\n312:             while (versionFromFile < PERSISTENCE_VERSION) {\n313:                 ++versionFromFile;\n314:                 LOG.info(\"Upgrading to version \" + versionFromFile);\n315:                 file = transform(file, versionFromFile);\n316:             }\n317:             return file;\n318:         } catch (IOException e) {\n319:             throw new OpenException(e);\n320:         }\n321:     }\n322: \n323:     /**\n324:      * Transform a string of XML data according to the service required.\n325:      *\n326:      * @param url The URL of the XML to be transformed\n327:      * @param version the version of the persistence format\n328:      *                the XML is to be transformed to.\n329:      * @return the URL of the transformed XML\n330:      * @throws OpenException on XSLT transformation error or file read\n331:      */\n332:     public final URL transform(URL url, int version)\n333:         throws OpenException {\n334: \n335:         try {\n336:             String upgradeFilesPath = \"/org/argouml/persistence/upgrades/\";\n337:             String upgradeFile = \"upgrade\" + version + \".xsl\";\n338: \n339:             // TODO: But should instead access a resource inside the jar\n340:             String xsltFileName = upgradeFilesPath + upgradeFile;\n341:             URL xsltUrl = UmlFilePersister.class.getResource(xsltFileName);\n342:             LOG.info(\"Resource is \" + xsltUrl);\n343: \n344:             // Read xsltStream into a temporary file\n345:             // Get url for temp file.\n346:             // openStream from url and wrap in StreamSource\n347:             StreamSource xsltStreamSource =\n348:                 new StreamSource(xsltUrl.openStream());\n349: \n350:             TransformerFactory factory = TransformerFactory.newInstance();\n351:             Transformer transformer = factory.newTransformer(xsltStreamSource);\n352: \n353:             File file = File.createTempFile(\"upgrade_\" + version + \"_\", \".uml\");\n354:             file.deleteOnExit();\n355: \n356:             String encoding = \"UTF-8\";\n357:             FileOutputStream stream =\n358:                 new FileOutputStream(file);\n359:             Writer writer = new BufferedWriter(new OutputStreamWriter(\n360:                     stream, encoding));\n361:             Result result = new StreamResult(writer);\n362: \n363:             StreamSource inputStreamSource = new StreamSource(url.openStream());\n364:             transformer.transform(inputStreamSource, result);\n365: \n366:             writer.close();\n367:             return file.toURL();\n368:         } catch (IOException e) {\n369:             throw new OpenException(e);\n370:         } catch (TransformerException e) {\n371:             throw new OpenException(e);\n372:         }\n373:     }\n374: \n375:     /**\n376:      * Read an XML file at the given URL and extracts the version number\n377:      * from the root tag.\n378:      * @param url the URL of the XML file\n379:      * @return The version number\n380:      * @throws IOException\n381:      */\n382:     private String getVersion(URL url) throws IOException {\n383:         BufferedInputStream inputStream =\n384:             new BufferedInputStream(url.openStream());\n385:         BufferedReader reader =\n386:             new BufferedReader(new InputStreamReader(inputStream));\n387:         String rootLine = reader.readLine();\n388:         while (!rootLine.startsWith(\"<uml \")) {\n389:             rootLine = reader.readLine();\n390:         }\n391:         inputStream.close();\n392:         reader.close();\n393:         return getVersion(rootLine);\n394:     }\n395: \n396:     /**\n397:      * Get the version attribute value from a string of XML.\n398:      * @param rootLine the line\n399:      * @return the version\n400:      */\n401:     protected String getVersion(String rootLine) {\n402:         String version;\n403:         int versionPos = rootLine.indexOf(\"version=\\\"\");\n404:         if (versionPos > 0) {\n405:             int startPos = versionPos + 9;\n406:             int endPos = rootLine.indexOf(\"\\\"\", startPos);\n407:             version = rootLine.substring(startPos, endPos);\n408:         } else {\n409:             version = \"1\";\n410:         }\n411:         return version;\n412:     }\n413: \n414: }\n415: ",
