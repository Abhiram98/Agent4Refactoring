s gbc = new GridBagConstraints();\n781:         gbc.gridy = row;\n782:         gbc.weighty = weighty;\n783:         gbc.anchor = GridBagConstraints.NORTHWEST;\n784:         gbc.gridheight = 1;\n785:         gbc.gridwidth = 1;\n786:         gbc.gridx = 1;\n787:         gbc.weightx = 1;\n788:         if (weighty == 0)\n789:             gbc.fill = GridBagConstraints.HORIZONTAL;\n790:         else\n791:             gbc.fill = GridBagConstraints.BOTH;\n792: \n793:         JPanel pane = (JPanel) _panels.elementAt(panel);\n794:         GridBagLayout layout = (GridBagLayout) pane.getLayout();\n795:         layout.setConstraints(component, gbc);\n796:         pane.add(component);\n797:     }\n798: \n799:     /**\n800:      *   Adds a component to the fields of the specified panel\n801:      *     and sets the background and color to indicate\n802:      *     the field is a link.\n803:      *   @param component Component to be added\n804:      *   @param row row index, zero-based.\n805:      *   @param panel panel index, zero-based.\n806:      *   @param weighty specifies how to distribute extra vertical space,\n807:      *      see GridBagConstraint for details on usage.\n808:      *\n809:      * @deprecated as of ArgoUml 0.13.5 (10-may-2003),\n810:      *         GridBagConstraints is no longer used as a prop panel layout,\n811:      *             replaced by addLinkField(label, component) - Labelled layout method.\n812:      */\n813:     final public void addLinkField(Component component, int row, int panel, double weighty) {\n814:         component.setBackground(getBackground());\n815:         component.setForeground(Color.blue);\n816:         addField(component, row, panel, weighty);\n817:     }\n818: \n819: } /* end class PropPanel */\n820: ",
