                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/diagram/static_structure/ui/FigComment.java: \n1: // $Id$\n2: // Copyright (c) 1996-2005 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.uml.diagram.static_structure.ui;\n26: \n27: import java.awt.Color;\n28: import java.awt.Dimension;\n29: import java.awt.Graphics;\n30: import java.awt.Point;\n31: import java.awt.Polygon;\n32: import java.awt.Rectangle;\n33: import java.awt.event.InputEvent;\n34: import java.awt.event.KeyEvent;\n35: import java.awt.event.KeyListener;\n36: import java.awt.event.MouseEvent;\n37: import java.awt.event.MouseListener;\n38: import java.beans.PropertyChangeEvent;\n39: import java.beans.PropertyChangeListener;\n40: import java.beans.VetoableChangeListener;\n41: import java.util.Iterator;\n42: \n43: import javax.swing.SwingUtilities;\n44: \n45: import org.apache.log4j.Logger;\n46: import org.argouml.kernel.DelayedChangeNotify;\n47: import org.argouml.kernel.DelayedVChangeListener;\n48: import org.argouml.model.AttributeChangeEvent;\n49: import org.argouml.model.Model;\n50: import org.argouml.uml.diagram.ui.FigMultiLineText;\n51: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n52: import org.tigris.gef.base.Geometry;\n53: import org.tigris.gef.base.Selection;\n54: import org.tigris.gef.graph.GraphModel;\n55: import org.tigris.gef.presentation.Fig;\n56: import org.tigris.gef.presentation.FigPoly;\n57: import org.tigris.gef.presentation.FigRect;\n58: import org.tigris.gef.presentation.FigText;\n59: \n60: /**\n61:  * Class to display a UML comment in a diagram.\n62:  *\n63:  * @author Andreas Rueckert\n64:  */\n65: public class FigComment\n66:     extends FigNodeModelElement\n67:     implements VetoableChangeListener,\n68: \t       DelayedVChangeListener,\n69: \t       MouseListener,\n70: \t       KeyListener,\n71: \t       PropertyChangeListener {\n72:     /**\n73:      * Logger.\n74:      */\n75:     private static final Logger LOG = Logger.getLogger(FigComment.class);\n76: \n77:     ////////////////////////////////////////////////////////////////\n78:     // constants\n79: \n80:     private int x = 0;\n81:     private int y = 0;\n82:     private int width = 80;\n83:     private int height = 60;\n84:     private int dogear = 10; // a dog-ear = a bent corner in a book\n85: \n86:     private boolean readyToEdit = true;\n87: \n88:     ////////////////////////////////////////////////////////////////\n89:     // instance variables\n90: \n91:     // The figure that holds the text of the note.\n92:     private FigText bodyTextFig;\n93: \n94:     private FigPoly outlineFig;\n95:     private FigPoly urCorner; // the upper right corner\n96: \n97:     /**\n98:      * Flag to indicate that we have just been created. This is to fix the\n99:      * problem with loading comments that have stereotypes already\n100:      * defined.<p>\n101:      */\n102:     private boolean newlyCreated = false;\n103: \n104:     ////////////////////////////////////////////////////////////////\n105:     // constructors\n106: \n107:     /**\n108:      * The main constructor used for file loading.\n109:      */\n110:     public FigComment() {\n111: \n112:         outlineFig = new FigPoly(Color.black, Color.white);\n113:         outlineFig.addPoint(x, y);\n114:         outlineFig.addPoint(x + width - 1 - dogear, y);\n115:         outlineFig.addPoint(x + width - 1, y + dogear);\n116:         outlineFig.addPoint(x + width - 1, y + height - 1);\n117:         outlineFig.addPoint(x, y + height - 1);\n118:         outlineFig.addPoint(x, y);\n119:         outlineFig.setFilled(true);\n120:         outlineFig.setLineWidth(1);\n121: \n122:         urCorner = new FigPoly(Color.black, Color.white);\n123:         urCorner.addPoint(x + width - 1 - dogear, y);\n124:         urCorner.addPoint(x + width - 1, y + dogear);\n125:         urCorner.addPoint(x + width - 1 - dogear, y + dogear);\n126:         urCorner.addPoint(x + width - 1 - dogear, y);\n127:         urCorner.setFilled(true);\n128:         Color col = outlineFig.getFillColor();\n129:         urCorner.setFillColor(col.darker());\n130:         urCorner.setLineWidth(1);\n131: \n132:         setBigPort(new FigRect(x, y, width, height, null, null));\n133:         getBigPort().setFilled(false);\n134:         getBigPort().setLineWidth(0);\n135: \n136:         bodyTextFig = new FigMultiLineText(x + 2, y + 2, width - 2 - dogear, height - 4, true);\n137: \n138:         // add Figs to the FigNode in back-to-front order\n139:         addFig(getBigPort());\n140:         addFig(outlineFig);\n141:         addFig(urCorner);\n142:         addFig(getStereotypeFig());\n143:         addFig(bodyTextFig);\n144: \n145:         setBlinkPorts(false); //make port invisble unless mouse enters\n146:         Rectangle r = getBounds();\n147:         setBounds(r.x, r.y, r.width, r.height);\n148:         updateEdges();\n149: \n150:         readyToEdit = false;\n151:         // Mark this as newly created. This is to get round the problem with\n152:         // creating figs for loaded comments that had stereotypes. They are\n153:         // saved with their dimensions INCLUDING the stereotype, but since we\n154:         // pretend the stereotype is not visible, we add height the first time\n155:         // we render such a comment. This is a complete fudge, and really we\n156:         // ought to address how comment objects with stereotypes are saved. But\n157:         // that will be hard work.\n158:         newlyCreated = true;\n159:     }\n160: \n161:     /**\n162:      * Construct a new comment.\n163:      *\n164:      * @param gm the graphmodel\n165:      * @param node the underlying UML Comment\n166:      */\n167:     public FigComment(GraphModel gm, Object node) {\n168:         this();\n169:         setOwner(node);\n170:     }\n171: \n172:     /**\n173:      * Get the default text for this figure.\n174:      *\n175:      * @return The default text for this figure.\n176:      */\n177:     public String placeString() {\n178:         String placeString = retrieveBody();\n179:         if (placeString == null) {\n180:             placeString = \"new note\";\n181:         }\n182:         return placeString;\n183:     }\n184: \n185:     /**\n186:      * Clone this figure.\n187:      *\n188:      * @return The cloned figure.\n189:      */\n190:     public Object clone() {\n191:         FigComment figClone = (FigComment) super.clone();\n192:         Iterator thisIter = this.getFigs().iterator();\n193:         while (thisIter.hasNext()) {\n194:             Object thisFig = thisIter.next();\n195:             if (thisFig == outlineFig) {\n196:                 figClone.outlineFig = (FigPoly) thisFig;\n197:             }\n198:             if (thisFig == urCorner) {\n199:                 figClone.urCorner = (FigPoly) thisFig;\n200:             }\n201:             if (thisFig == bodyTextFig) {\n202:                 figClone.bodyTextFig = (FigText) thisFig;\n203:             }\n204:         }\n205:         return figClone;\n206:     }\n207: \n208:     /**\n209:      * @see org.tigris.gef.presentation.Fig#setOwner(java.lang.Object)\n210:      */\n211:     public void setOwner(Object own) {\n212:         super.setOwner(own);\n213:         if (own != null) {\n214:             String body = (String)Model.getFacade().getBody(getOwner());\n215:             if (body != null) {\n216:                 bodyTextFig.setText(body);\n217:             }\n218:         }\n219:     }\n220: \n221:     ////////////////////////////////////////////////////////////////\n222:     // event handlers\n223: \n224:     /**\n225:      * See FigNodeModelElement.java for more info on these methods.\n226:      */\n227: \n228:     /**\n229:      * If the user double clicks on any part of this FigNode, pass it\n230:      * down to one of the internal Figs.  This allows the user to\n231:      * initiate direct text editing.\n232:      *\n233:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n234:      */\n235:     public void mouseClicked(MouseEvent me) {\n236:         if (!readyToEdit) {\n237:             if (Model.getFacade().isAModelElement(getOwner())) {\n238:                 readyToEdit = true;\n239:             } else {\n240:                 LOG.debug(\"not ready to edit note\");\n241:                 return;\n242:             }\n243:         }\n244:         if (me.isConsumed()) {\n245:             return;\n246:         }\n247:         if (me.getClickCount() >= 2\n248: \t    && !(me.isPopupTrigger()\n249: \t\t || me.getModifiers() == InputEvent.BUTTON3_MASK)) {\n250:             if (getOwner() == null) {\n251:                 return;\n252:             }\n253:             Fig f = hitFig(new Rectangle(me.getX() - 2, me.getY() - 2, 4, 4));\n254:             if (f instanceof MouseListener) {\n255:                 ((MouseListener) f).mouseClicked(me);\n256:             }\n257:         }\n258:         me.consume();\n259:     }\n260: \n261:     /**\n262:      * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n263:      */\n264:     public void vetoableChange(PropertyChangeEvent pce) {\n265:         Object src = pce.getSource();\n266:         if (src == getOwner()) {\n267:             DelayedChangeNotify delayedNotify =\n268: \t\tnew DelayedChangeNotify(this, pce);\n269:             SwingUtilities.invokeLater(delayedNotify);\n270:         } else {\n271:             LOG.debug(\"FigNodeModelElement got vetoableChange\"\n272: \t\t      + \" from non-owner:\" + src);\n273:         }\n274:     }\n275: \n276:     /**\n277:      * @see org.argouml.kernel.DelayedVChangeListener#delayedVetoableChange(java.beans.PropertyChangeEvent)\n278:      */\n279:     public void delayedVetoableChange(PropertyChangeEvent pce) {\n280:         // update any text, colors, fonts, etc.\n281:         renderingChanged();\n282:         // update the relative sizes and positions of internel Figs\n283:         endTrans();\n284:     }\n285: \n286:     /**\n287:      * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n288:      */\n289:     public void propertyChange(PropertyChangeEvent pve) {\n290:         Object src = pve.getSource();\n291:         String pName = pve.getPropertyName();\n292:         if (pName.equals(\"editing\")\n293: \t    && Boolean.FALSE.equals(pve.getNewValue())) {\n294:             //parse the text that was edited\n295:             textEdited((FigText) src);\n296:             // resize the FigNode to accomodate the new text\n297:             Rectangle bbox = getBounds();\n298:             Dimension minSize = getMinimumSize();\n299:             bbox.width = Math.max(bbox.width, minSize.width);\n300:             bbox.height = Math.max(bbox.height, minSize.height);\n301:             setBounds(bbox.x, bbox.y, bbox.width, bbox.height);\n302:             endTrans();\n303:         } else {\n304:             super.propertyChange(pve);\n305:         }\n306:     }\n307: \n308:     /**\n309:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n310:      */\n311:     // TODO: Review - should be keyTyped()? - Bob\n312:     public void keyTyped(KeyEvent ke) {\n313:         if (!readyToEdit) {\n314:             if (Model.getFacade().isAModelElement(getOwner())) {\n315:                 storeBody(\"\");\n316:                 readyToEdit = true;\n317:             } else {\n318:                 LOG.debug(\"not ready to edit note\");\n319:                 return;\n320:             }\n321:         }\n322:         if (ke.isConsumed()) {\n323:             return;\n324:         }\n325:         if (getOwner() == null) {\n326:             return;\n327:         }\n328:         bodyTextFig.keyPressed(ke);\n329:     }\n330: \n331:     /**\n332:      * Not used, do nothing.\n333:      *\n334:      * @see java.awt.event.KeyListener#keyReleased(java.awt.event.KeyEvent)\n335:      */\n336:     public void keyReleased(KeyEvent ke) {\n337:     }\n338: \n339:     /**\n340:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n341:      */\n342:     public void keyPressed(KeyEvent ke) {\n343:     }\n344: \n345:     ////////////////////////////////////////////////////////////////\n346:     // Fig accessors\n347: \n348:     /**\n349:      * @see org.tigris.gef.presentation.Fig#makeSelection()\n350:      */\n351:     public Selection makeSelection() {\n352:         return new SelectionComment(this);\n353:     }\n354: \n355:     /**\n356:      * @see org.tigris.gef.presentation.Fig#setLineColor(java.awt.Color)\n357:      */\n358:     public void setLineColor(Color col) {\n359:         // The _text element has no border, so the line color doesn't matter.\n360:         outlineFig.setLineColor(col);\n361:         urCorner.setLineColor(col);\n362:     }\n363: \n364:     /**\n365:      * @see org.tigris.gef.presentation.Fig#getLineColor()\n366:      */\n367:     public Color getLineColor() {\n368:         return outlineFig.getLineColor();\n369:     }\n370: \n371:     /**\n372:      * @see org.tigris.gef.presentation.Fig#setFillColor(java.awt.Color)\n373:      */\n374:     public void setFillColor(Color col) {\n375:         outlineFig.setFillColor(col);\n376:         urCorner.setFillColor(col);\n377:     }\n378: \n379:     /**\n380:      * @see org.tigris.gef.presentation.Fig#getFillColor()\n381:      */\n382:     public Color getFillColor() {\n383:         return outlineFig.getFillColor();\n384:     }\n385: \n386:     /**\n387:      * @see org.tigris.gef.presentation.Fig#setFilled(boolean)\n388:      */\n389:     public void setFilled(boolean f) {\n390:         bodyTextFig.setFilled(false); // The text is always opaque.\n391:         outlineFig.setFilled(f);\n392:         urCorner.setFilled(f);\n393:     }\n394: \n395:     /**\n396:      * @see org.tigris.gef.presentation.Fig#getFilled()\n397:      */\n398:     public boolean getFilled() {\n399:         return outlineFig.getFilled();\n400:     }\n401: \n402:     /**\n403:      * @see org.tigris.gef.presentation.Fig#setLineWidth(int)\n404:      */\n405:     public void setLineWidth(int w) {\n406:         bodyTextFig.setLineWidth(0); // Make a seamless integration of the text\n407:         // in the note figure.\n408:         outlineFig.setLineWidth(w);\n409:         urCorner.setLineWidth(w);\n410:     }\n411: \n412:     /**\n413:      * @see org.tigris.gef.presentation.Fig#getLineWidth()\n414:      */\n415:     public int getLineWidth() {\n416:         return outlineFig.getLineWidth();\n417:     }\n418: \n419:     ////////////////////////////////////////////////////////////////\n420:     // user interaction methods\n421: \n422:     /**\n423:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEdited(org.tigris.gef.presentation.FigText)\n424:      */\n425:     protected void textEdited(FigText ft) {\n426:         if (ft == bodyTextFig) {\n427:             storeBody(ft.getText());\n428:         }\n429:     }\n430: \n431:     /**\n432:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEditStarted(org.tigris.gef.presentation.FigText)\n433:      */\n434:     protected void textEditStarted(FigText ft) {\n435:         showHelp(\"parsing.help.comment\");\n436:     }\n437: \n438:     /**\n439:      * @see org.tigris.gef.presentation.Fig#setEnclosingFig(org.tigris.gef.presentation.Fig)\n440:      */\n441:     public void setEnclosingFig(Fig encloser) {\n442:         super.setEnclosingFig(encloser);\n443:     }\n444: \n445:     ////////////////////////////////////////////////////////////////\n446:     // accessor methods\n447: \n448:     /**\n449:      * Stores the body text in the associated model element.\n450:      *\n451:      * @param note The body text to store.\n452:      */\n453:     public final void storeBody(String body) {\n454:         if (getOwner() != null) {\n455:             Model.getCoreHelper().setBody(getOwner(), body);\n456:         }\n457:     }\n458: \n459:     /**\n460:      * Retrieve the body text from the associated model element.\n461:      *\n462:      * @return The body from the associated model element.\n463:      */\n464:     private String retrieveBody() {\n465:         return (getOwner() != null)\n466:             ? (String) Model.getFacade().getBody(getOwner())\n467:             : null;\n468:     }\n469: \n470:     /**\n471:      * @see org.tigris.gef.presentation.Fig#getUseTrapRect()\n472:      */\n473:     public boolean getUseTrapRect() {\n474:         return true;\n475:     }\n476: \n477:     /**\n478:      * Get the minimum size for the note figure.\n479:      *\n480:      * @return The minimum size for the note figure.\n481:      */\n482:     public Dimension getMinimumSize() {\n483: \n484:         // Get the size of the text field.\n485:         Dimension aSize = bodyTextFig.getMinimumSize();\n486: \n487:         // If we have a stereotype displayed, then allow some space for that\n488:         // (width and height)\n489: \n490:         if (getStereotypeFig().isVisible()) {\n491:             Dimension stereoMin = getStereotypeFig().getMinimumSize();\n492:             aSize.width =\n493:                 Math.max(aSize.width,\n494:                          stereoMin.width);\n495:             aSize.height += stereoMin.height;\n496:         }\n497: \n498:         // And add the gaps around the textfield to get the minimum\n499:         // size of the note.\n500:         return new Dimension(aSize.width + 4 + dogear,\n501: \t\t\t     aSize.height + 4);\n502:     }\n503: \n504:     /**\n505:      * @see org.tigris.gef.presentation.Fig#setBounds(int, int, int, int)\n506:      */\n507:     protected void setBoundsImpl(int px, int py, int w, int h) {\n508:         if (bodyTextFig == null) {\n509:             return;\n510:         }\n511: \n512:         Dimension stereoMin = getStereotypeFig().getMinimumSize();\n513: \n514:         int stereotypeHeight = 0;\n515:         if (getStereotypeFig().isVisible()) {\n516:             stereotypeHeight = stereoMin.height;\n517:         }\n518: \n519:         Rectangle oldBounds = getBounds();\n520: \n521:         // Resize the text figure\n522:         bodyTextFig.setBounds(px + 2, py + 2 + stereotypeHeight,\n523:                 w - 4 - dogear, h - 4 - stereotypeHeight);\n524: \n525:         getStereotypeFig().setBounds(px + 2, py + 2,\n526:                 w - 4 - dogear, stereoMin.height);\n527: \n528:         // Resize the big port around the figure\n529:         getBigPort().setBounds(px, py, w, h);\n530: \n531:         // Since this is a complex polygon, there's no easy way to resize it.\n532:         Polygon newPoly = new Polygon();\n533:         newPoly.addPoint(px, py);\n534:         newPoly.addPoint(px + w - 1 - dogear, py);\n535:         newPoly.addPoint(px + w - 1, py + dogear);\n536:         newPoly.addPoint(px + w - 1, py + h - 1);\n537:         newPoly.addPoint(px, py + h - 1);\n538:         newPoly.addPoint(px, py);\n539:         outlineFig.setPolygon(newPoly);\n540: \n541:         // Just move the corner to it's new position.\n542:         urCorner.setBounds(px + w - 1 - dogear, py, dogear, dogear);\n543: \n544:         calcBounds(); //_x = x; _y = y; _w = w; _h = h;\n545:         firePropChange(\"bounds\", oldBounds, getBounds());\n546:     }\n547: \n548:     /**\n549:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateBounds()\n550:      */\n551:     protected void updateBounds() {\n552:         Rectangle bbox = getBounds();\n553:         Dimension minSize = getMinimumSize();\n554:         bbox.width = Math.max(bbox.width, minSize.width);\n555:         bbox.height = Math.max(bbox.height, minSize.height);\n556:         setBounds(bbox.x, bbox.y, bbox.width, bbox.height);\n557:     }\n558: \n559:     ///////////////////////////////////////////////////////////////////\n560:     // Internal methods\n561: \n562:     /**\n563:      * This is called after any part of the UML ModelElement (the comment) has\n564:      * changed. This method automatically updates the note FigText.\n565:      *\n566:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#modelChanged(java.beans.PropertyChangeEvent)\n567:      */\n568:     protected final void modelChanged(PropertyChangeEvent mee) {\n569:         super.modelChanged(mee);\n570: \n571:         if (mee instanceof AttributeChangeEvent\n572:                 && mee.getPropertyName().equals(\"body\")) {\n573: \n574:             bodyTextFig.setText(mee.getNewValue().toString());\n575:             calcBounds();\n576:             setBounds(getBounds());\n577:             damage();\n578:         }\n579:     }\n580: \n581: //    /**\n582: //     * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateNameText()\n583: //     */\n584: //    protected void updateNameText() {\n585: //        if (getOwner() != null) {\n586: //            String t = Model.getFacade().getName(getOwner());\n587: //            if (t != null) {\n588: //                bodyTextFig.setText(t);\n589: //                calcBounds();\n590: //                setBounds(getBounds());\n591: //            }\n592: //        }\n593: //    }\n594: \n595:     /**\n596:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateStereotypeText()\n597:      */\n598:     protected void updateStereotypeText() {\n599:         Object me = /*(MModelElement)*/ getOwner();\n600: \n601:         if (me == null) {\n602:             return;\n603:         }\n604: \n605:         Rectangle rect = getBounds();\n606: \n607:         Dimension stereoMin = getStereotypeFig().getMinimumSize();\n608: \n609:         if (Model.getFacade().getStereotypes(me).isEmpty()) {\n610: \n611:             if (getStereotypeFig().isVisible()) {\n612:                 getStereotypeFig().setVisible(false);\n613:                 rect.y += stereoMin.height;\n614:                 rect.height -= stereoMin.height;\n615:                 setBounds(rect.x, rect.y, rect.width, rect.height);\n616:                 calcBounds();\n617:             }\n618:         } else {\n619:             getStereotypeFig().setOwner(getOwner());\n620: \n621:             if (!getStereotypeFig().isVisible()) {\n622:                 getStereotypeFig().setVisible(true);\n623: \n624:                 // Only adjust the stereotype height if we are not newly\n625:                 // created. This gets round the problem of loading classes with\n626:                 // stereotypes defined, which have the height already including\n627:                 // the stereotype.\n628: \n629:                 if (!newlyCreated) {\n630:                     rect.y -= stereoMin.height;\n631:                     rect.height += stereoMin.height;\n632:                     rect.width =\n633:                         Math.max(getMinimumSize().width, rect.width);\n634:                     setBounds(rect.x, rect.y, rect.width, rect.height);\n635:                     calcBounds();\n636:                 }\n637:             }\n638:         }\n639:         // Whatever happened we are no longer newly created, so clear the\n640:         // flag. Then set the bounds for the rectangle we have defined.\n641:         newlyCreated = false;\n642:     }\n643: \n644:     /**\n645:      * @see org.tigris.gef.presentation.Fig#getClosestPoint(java.awt.Point)\n646:      */\n647:     public Point getClosestPoint(Point anotherPt) {\n648:         Rectangle r = getBounds();\n649:         int xs[] = {r.x, r.x + r.width - dogear, r.x + r.width,\n650:                     r.x + r.width,  r.x,            r.x};\n651:         int ys[] = {r.y, r.y,                    r.y + dogear,\n652:                     r.y + r.height, r.y + r.height, r.y};\n653:         Point p = Geometry.ptClosestTo(\n654:                 xs,\n655:                 ys,\n656:                 6 , anotherPt);\n657:         return p;\n658:     }\n659: \n660:     public void paint(Graphics g) {\n661:         Color col = outlineFig.getFillColor();\n662:         urCorner.setFillColor(col.darker());\n663:         super.paint(g);\n664:     }\n665: } /* end class FigComment */\n666: ",
                        "type": "human",
