ROVIDE MAINTENANCE, SUPPORT, UPDATES,\n25: // ENHANCEMENTS, OR MODIFICATIONS.\n26: \n27: \n28: package uci.uml.ui;\n29: \n30: import java.util.*;\n31: import java.beans.*;\n32: import java.awt.event.*;\n33: import com.sun.java.swing.*;\n34: import com.sun.java.swing.event.*;\n35: import com.sun.java.swing.tree.*;\n36: \n37: import uci.argo.kernel.*;\n38: import uci.uml.Foundation.Core.*;\n39: import uci.uml.Foundation.Data_Types.*;\n40: import uci.uml.Behavioral_Elements.Common_Behavior.*;\n41: import uci.uml.Behavioral_Elements.State_Machines.*;\n42: import uci.uml.Behavioral_Elements.Use_Cases.*;\n43: import uci.uml.Model_Management.*;\n44: import uci.uml.visual.*;\n45: \n46: public class Actions {\n47: \n48:   static Vector _allActions = new Vector(100);\n49:   \n50: \n51:   public static UMLAction New = new ActionNew();\n52:   public static UMLAction Open = new ActionOpen();\n53:   public static UMLAction Save = new ActionSave();\n54:   public static UMLAction SaveAs = new ActionSaveAs();\n55:   public static UMLAction AddToProj = new ActionAddToProj();\n56:   public static UMLAction Print = new ActionPrint();\n57:   public static UMLAction Exit = new ActionExit();\n58: \n59:   public static UMLAction Undo = new ActionUndo();\n60:   public static UMLAction Redo = new ActionRedo();\n61:   public static UMLAction Cut = new ActionCut();\n62:   public static UMLAction Copy = new ActionCopy();\n63:   public static UMLAction Paste = new ActionPaste();\n64: \n65:   public static UMLAction NavUp = new ActionNavUp();\n66:   public static UMLAction NavDown = new ActionNavDown();\n67:   public static UMLAction NavBack = new ActionNavBack();\n68:   public static UMLAction NavForw = new ActionNavForw();\n69:   public static UMLAction NavFavs = new ActionNavFavs();\n70:   public static UMLAction NextTab = new ActionNextTab();\n71:   public static UMLAction PrevTab = new ActionPrevTab();\n72:   public static UMLAction ShowDiagramTab = new ActionShowDiagramTab();\n73:   public static UMLAction ShowTableTab = new ActionShowTableTab();\n74:   public static UMLAction ShowTextTab = new ActionShowTextTab();\n75:   public static UMLAction AddToFavs = new ActionAddToFavs();\n76:   //public static UMLAction DefinePerspective = new ActionDefinePerspective();\n77: \n78:   \n79:   public static UMLAction CreateMultiple = new ActionCreateMultiple();\n80:   public static UMLAction ClassWizard = new ActionClassWizard();\n81: \n82:   public static UMLAction Model = new ActionModel();\n83:   public static UMLAction ClassDiagram = new ActionClassDiagram();\n84:   public static UMLAction UseCaseDiagram = new ActionUseCaseDiagram();\n85:   public static UMLAction StateDiagram = new ActionStateDiagram();\n86: \n87:   public static UMLAction Class = new ActionClass();\n88:   public static UMLAction Interface = new ActionInterface();\n89:   public static UMLAction Actor = new ActionActor();\n90:   public static UMLAction UseCase = new ActionUseCase();\n91:   public static UMLAction State = new ActionState();\n92:   public static UMLAction Pseudostate = new ActionPseudostate();\n93:   public static UMLAction Package = new ActionPackage();\n94:   public static UMLAction Instance = new ActionInstance();\n95:   public static UMLAction Attr = new ActionAttr();\n96:   public static UMLAction Oper = new ActionOper();\n97: \n98:   public static UMLAction AboutArgoUML = new ActionAboutArgoUML();\n99:   \n100: \n101:   public static UMLAction AutoCritique = new ActionAutoCritique();\n102:   public static UMLAction OpenDecisions = new ActionOpenDecisions();\n103:   public static UMLAction OpenGoals = new ActionOpenGoals();\n104:   public static UMLAction OpenCritics = new ActionOpenCritics();\n105: \n106:   public static UMLAction FlatToDo = new ActionFlatToDo();\n107: \n108:   public static UMLAction NewToDoItem = new ActionNewToDoItem();\n109:   public static UMLAction Resolve = new ActionResolve();\n110:   public static UMLAction EmailExpert = new ActionEmailExpert();\n111:   public static UMLAction MoreInfo = new ActionMoreInfo();\n112:   public static UMLAction Hush = new ActionHush();\n113:   public static UMLAction RecordFix = new ActionRecordFix();\n114:   public static UMLAction FixItBack = new ActionFixItBack();\n115:   public static UMLAction FixItFinish = new ActionFixItFinish();\n116: \n117: \n118:   public static void updateAllEnabled() {\n119:     java.util.Enumeration actions = _allActions.elements();\n120:     while (actions.hasMoreElements()) {\n121:       UMLAction a = (UMLAction) actions.nextElement();\n122:       a.updateEnabled();\n123:     }\n124:   }\n125: \n126:   \n127: }  /* end class Actions */\n128: \n129: \n130: class UMLAction extends AbstractAction {\n131: \n132:   public UMLAction(String name) { this(name, true); }\n133:   \n134:   public UMLAction(String name, boolean global) { \n135:     super(name, loadIconResource(imageName(name), name));\n136:     putValue(Action.SHORT_DESCRIPTION, name);\n137:     if (global) Actions._allActions.addElement(this);\n138:   }\n139: \n140:   protected static ImageIcon loadIconResource(String imgName, String desc) {\n141:     ImageIcon res = null;\n142:     try {\n143:       java.net.URL imgURL = UMLAction.class.getResource(imgName);\n144:       return new ImageIcon(imgURL, desc);\n145:     }\n146:     catch (Exception ex) {\n147:       return new ImageIcon(desc);\n148:     }\n149:   }\n150: \n151:   protected static String imageName(String name) {\n152:     return \"/uci/Images/\" + stripJunk(name) + \".gif\";\n153:   }\n154:   \n155: \n156:   /** Perform the work the action is supposed to do. */\n157:   // needs-more-work: should actions run in their own threads?\n158:   public void actionPerformed(ActionEvent e) {\n159:     System.out.println(\"pushed \" + getValue(Action.NAME));\n160:     StatusBar sb = ProjectBrowser.TheInstance.getStatusBar();\n161:     sb.doFakeProgress(stripJunk(getValue(Action.NAME).toString()), 100);\n162:     History.TheHistory.addItem(\"pushed \" + getValue(Action.NAME));\n163:     Actions.updateAllEnabled();\n164:   }\n165: \n166: \n167:   public void updateEnabled(Object target) { setEnabled(shouldBeEnabled()); }\n168:   public void updateEnabled() { setEnabled(shouldBeEnabled()); }\n169: \n170:   /** return true if this action should be available to the user. This\n171:    *  method should examine the ProjectBrowser that owns it.  Sublass\n172:    *  implementations of this method should always call\n173:    *  super.shouldBeEnabled first. */\n174:   public boolean shouldBeEnabled() { return true; }\n175: \n176: \n177:   protected static String stripJunk(String s) {\n178:     String res = \"\";\n179:     int len = s.length();\n180:     for (int i = 0; i < len; i++) {\n181:       char c = s.charAt(i);\n182:       if (Character.isJavaLetterOrDigit(c)) res += c;\n183:     }\n184:     return res;\n185:   }\n186: } /* end class UMLAction */\n187: \n188: ////////////////////////////////////////////////////////////////\n189: // file menu actions\n190: \n191: class ActionNew extends UMLAction {\n192:   public ActionNew() { super(\"New...\"); }\n193: } /* end class ActionNew */\n194: \n195: class ActionOpen extends UMLAction {\n196:   public ActionOpen() { super(\"Open...\"); }\n197: } /* end class ActionOpen */\n198: \n199: class ActionSave extends UMLAction {\n200:   public ActionSave() { super(\"Save\"); }\n201:   public boolean shouldBeEnabled() {\n202:     Project p = ProjectBrowser.TheInstance.getProject();\n203:     return super.shouldBeEnabled() && p != null && p.getNeedsSave();\n204:   }\n205: } /* end class ActionSave */\n206: \n207: class ActionSaveAs extends UMLAction {\n208:   public ActionSaveAs() { super(\"Save As...\"); }\n209:   public boolean shouldBeEnabled() {\n210:     Project p = ProjectBrowser.TheInstance.getProject();\n211:     return super.shouldBeEnabled() && p != null;\n212:   }\n213: } /* end class ActionSaveAS */\n214: \n215: class ActionPrint extends UMLAction {\n216:   public ActionPrint() { super(\"Print...\"); }\n217:   public boolean shouldBeEnabled() {\n218:     Project p = ProjectBrowser.TheInstance.getProject();\n219:     return super.shouldBeEnabled() && p != null;\n220:   }\n221: } /* end class ActionPrint */\n222: \n223: class ActionAddToProj extends UMLAction {\n224:   public ActionAddToProj() { super(\"Add To Project...\"); }\n225:   public boolean shouldBeEnabled() {\n226:     Project p = ProjectBrowser.TheInstance.getProject();\n227:     return super.shouldBeEnabled() && p != null;\n228:   }\n229: } /* end class ActionAddToProj */\n230: \n231: class ActionExit extends UMLAction {\n232:   public ActionExit() { super(\"Exit\"); }\n233: \n234:   public void actionPerformed(ActionEvent e) {\n235:     //needs-more-work: are you sure you want to quit?\n236:     System.exit(0);\n237:   }\n238: } /* end class ActionExit */\n239: \n240: ////////////////////////////////////////////////////////////////\n241: // generic editing actions\n242: \n243: class ActionUndo extends UMLAction {\n244:   public ActionUndo() { super(\"Undo\"); }\n245: } /* end class ActionUndo */\n246: \n247: class ActionRedo extends UMLAction {\n248:   public ActionRedo() { super(\"Redo\"); }\n249: } /* end class ActionRedo */\n250: \n251: class ActionCut extends UMLAction {\n252:   public ActionCut() { super(\"Cut\"); }\n253: } /* end class ActionCut */\n254: \n255: class ActionCopy extends UMLAction {\n256:   public ActionCopy() { super(\"Copy\"); }\n257: } /* end class ActionCopy */\n258: \n259: class ActionPaste extends UMLAction {\n260:   public ActionPaste() { super(\"Paste\"); }\n261: } /* end class ActionPaste */\n262: \n263: \n264: ////////////////////////////////////////////////////////////////\n265: // navigation actions\n266: \n267: class ActionNavUp extends UMLAction {\n268:   public ActionNavUp() { super(\"Navigate Up\"); }\n269:   public boolean shouldBeEnabled() {\n270:     Project p = ProjectBrowser.TheInstance.getProject();\n271:     return super.shouldBeEnabled() && p != null;\n272:   }\n273: } /* end class ActionNavUp */\n274: \n275: class ActionNavDown extends UMLAction {\n276:   public ActionNavDown() { super(\"Navigate Down\"); }\n277:   public boolean shouldBeEnabled() {\n278:     Project p = ProjectBrowser.TheInstance.getProject();\n279:     return super.shouldBeEnabled() && p != null;\n280:   }\n281: } /* end class ActionNavDown */\n282: \n283: class ActionNavBack extends UMLAction {\n284:   public ActionNavBack() { super(\"Back\"); }\n285:   public boolean shouldBeEnabled() {\n286:     Project p = ProjectBrowser.TheInstance.getProject();\n287:     return super.shouldBeEnabled() && p != null;\n288:   }\n289: } /* end class ActionNavBack */\n290: \n291: class ActionNavForw extends UMLAction {\n292:   public ActionNavForw() { super(\"Forward\"); }\n293:   public boolean shouldBeEnabled() {\n294:     Project p = ProjectBrowser.TheInstance.getProject();\n295:     return super.shouldBeEnabled() && p != null;\n296:   }\n297: } /* end class ActionNavForw */\n298: \n299: class ActionNavFavs extends UMLAction {\n300:   public ActionNavFavs() { super(\"Favorites\"); }\n301:   public boolean shouldBeEnabled() {\n302:     Project p = ProjectBrowser.TheInstance.getProject();\n303:     return super.shouldBeEnabled() && p != null;\n304:   }\n305: } /* end class ActionNavFavs */\n306: \n307: class ActionPrevTab extends UMLAction {\n308:   public ActionPrevTab() { super(\"Previous Tab\"); }\n309:   public boolean shouldBeEnabled() {\n310:     Project p = ProjectBrowser.TheInstance.getProject();\n311:     return super.shouldBeEnabled() && p != null;\n312:   }\n313: } /* end class ActionPrevTab */\n314: \n315: class ActionNextTab extends UMLAction {\n316:   public ActionNextTab() { super(\"Next Tab\"); }\n317:   public boolean shouldBeEnabled() {\n318:     Project p = ProjectBrowser.TheInstance.getProject();\n319:     return super.shouldBeEnabled() && p != null;\n320:   }\n321: } /* end class ActionNextTab */\n322: \n323: class ActionShowDiagramTab extends UMLAction {\n324:   public ActionShowDiagramTab() { super(\"Show Diagram Tab\"); }\n325:   public boolean shouldBeEnabled() {\n326:     Project p = ProjectBrowser.TheInstance.getProject();\n327:     return super.shouldBeEnabled() && p != null;\n328:   }\n329: } /* end class ActionShowDiagramTab */\n330: \n331: class ActionShowTableTab extends UMLAction {\n332:   public ActionShowTableTab() { super(\"Show Table Tab\"); }\n333:   public boolean shouldBeEnabled() {\n334:     Project p = ProjectBrowser.TheInstance.getProject();\n335:     return super.shouldBeEnabled() && p != null;\n336:   }\n337: } /* end class ActionShowTableTab */\n338: \n339: class ActionShowTextTab extends UMLAction {\n340:   public ActionShowTextTab() { super(\"Show Text Tab\"); }\n341:   public boolean shouldBeEnabled() {\n342:     Project p = ProjectBrowser.TheInstance.getProject();\n343:     return super.shouldBeEnabled() && p != null;\n344:   }\n345: } /* end class ActionShowTextTab */\n346: \n347: class ActionAddToFavs extends UMLAction {\n348:   public ActionAddToFavs() { super(\"Add To Favorites\"); }\n349:   public boolean shouldBeEnabled() {\n350:     Project p = ProjectBrowser.TheInstance.getProject();\n351:     return super.shouldBeEnabled() && p != null;\n352:   }\n353: } /* end class ActionAddToFavs */\n354: \n355: \n356: class ActionCreateMultiple extends UMLAction {\n357:   public ActionCreateMultiple() { super(\"Create Multiple...\"); }\n358:   public boolean shouldBeEnabled() {\n359:     Project p = ProjectBrowser.TheInstance.getProject();\n360:     return super.shouldBeEnabled() && p != null;\n361:   }\n362: } /* end class ActionCreateMultiple */\n363: \n364: class ActionClassWizard extends UMLAction {\n365:   public ActionClassWizard() { super(\"Class Wizard...\"); }\n366:   public boolean shouldBeEnabled() {\n367:     Project p = ProjectBrowser.TheInstance.getProject();\n368:     return super.shouldBeEnabled() && p != null;\n369:   }\n370: } /* end class ActionClassWizard */\n371: \n372: ////////////////////////////////////////////////////////////////\n373: // diagram creation actions\n374: \n375: class ActionClassDiagram extends UMLAction {\n376:   public ActionClassDiagram() { super(\"ClassDiagram\"); }\n377: \n378:   public void actionPerformed(ActionEvent e) {\n379:     System.out.println(\"making class diagram...\");\n380:     //_cmdCreateNode.doIt();\n381:     Project p = ProjectBrowser.TheInstance.getProject();\n382:     try {\n383:       p.addDiagram(new UMLClassDiagram(p.getCurrentModel()));\n384:     }\n385:     catch (PropertyVetoException pve) { }\n386:   }\n387:   public boolean shouldBeEnabled() {\n388:     Project p = ProjectBrowser.TheInstance.getProject();\n389:     return super.shouldBeEnabled() && p != null;\n390:   }\n391: } /* end class ActionClassDiagram */\n392: \n393: class ActionUseCaseDiagram extends UMLAction {\n394:   public ActionUseCaseDiagram() { super(\"UseCaseDiagram\"); }\n395: \n396:   public void actionPerformed(ActionEvent e) {\n397:     System.out.println(\"making use case diagram...\");\n398:     //_cmdCreateNode.doIt();\n399:     Project p = ProjectBrowser.TheInstance.getProject();\n400:     try {\n401:       p.addDiagram(new UMLUseCaseDiagram(p.getCurrentModel()));\n402:     }\n403:     catch (PropertyVetoException pve) { }\n404:   }\n405:   public boolean shouldBeEnabled() {\n406:     Project p = ProjectBrowser.TheInstance.getProject();\n407:     return super.shouldBeEnabled() && p != null;\n408:   }\n409: } /* end class ActionUseCaseDiagram */\n410: \n411: class ActionStateDiagram extends UMLAction {\n412:   public ActionStateDiagram() { super(\"StateDiagram\"); }\n413: \n414:   public void actionPerformed(ActionEvent e) {\n415:     System.out.println(\"making state diagram...\");\n416:     //_cmdCreateNode.doIt();\n417:     Project p = ProjectBrowser.TheInstance.getProject();\n418:     try {\n419:       p.addDiagram(new UMLStateDiagram(p.getCurrentModel()));\n420:     }\n421:     catch (PropertyVetoException pve) { }\n422:   }\n423:   public boolean shouldBeEnabled() {\n424:     Project p = ProjectBrowser.TheInstance.getProject();\n425:     return super.shouldBeEnabled() && p != null;\n426:   }\n427: } /* end class ActionStateDiagram */\n428: \n429: \n430: ////////////////////////////////////////////////////////////////\n431: // model element creation actions\n432: \n433: class ActionClass extends UMLAction {\n434:   uci.gef.Cmd _cmdCreateNode = new\n435:   uci.gef.CmdCreateNode(MMClass.class, \"Class\");\n436:   \n437:   public ActionClass() { super(\"Class\"); }\n438: \n439:   public void actionPerformed(ActionEvent e) {\n440:     System.out.println(\"making class...\");\n441:     _cmdCreateNode.doIt();\n442:   }\n443:   public boolean shouldBeEnabled() {\n444:     Project p = ProjectBrowser.TheInstance.getProject();\n445:     return super.shouldBeEnabled() && p != null;\n446:   }\n447: } /* end class ActionClass */\n448: \n449: class ActionInterface extends UMLAction {\n450:   uci.gef.Cmd _cmdCreateNode = new\n451:   uci.gef.CmdCreateNode(Interface.class, \"Interface\");\n452: \n453:   public ActionInterface() { super(\"Interface\"); }\n454: \n455:   public void actionPerformed(ActionEvent e) {\n456:     System.out.println(\"making interface...\");\n457:     _cmdCreateNode.doIt();\n458:   }\n459:   public boolean shouldBeEnabled() {\n460:     Project p = ProjectBrowser.TheInstance.getProject();\n461:     return super.shouldBeEnabled() && p != null;\n462:   }\n463: } /* end class ActionInterface */\n464: \n465: class ActionActor extends UMLAction {\n466:   uci.gef.Cmd _cmdCreateNode = new\n467:   uci.gef.CmdCreateNode(Actor.class, \"Actor\");\n468: \n469:   public ActionActor() { super(\"Actor\"); }\n470: \n471:   public void actionPerformed(ActionEvent e) {\n472:     System.out.println(\"making actor...\");\n473:     _cmdCreateNode.doIt();\n474:   }\n475:   public boolean shouldBeEnabled() {\n476:     Project p = ProjectBrowser.TheInstance.getProject();\n477:     return super.shouldBeEnabled() && p != null;\n478:   }\n479: } /* end class ActionActor */\n480: \n481: class ActionUseCase extends UMLAction {\n482:   uci.gef.Cmd _cmdCreateNode = new\n483:   uci.gef.CmdCreateNode(UseCase.class, \"UseCase\");\n484: \n485:   public ActionUseCase() { super(\"UseCase\"); }\n486: \n487:   public void actionPerformed(ActionEvent e) {\n488:     System.out.println(\"making Use Case...\");\n489:     _cmdCreateNode.doIt();\n490:   }\n491:   public boolean shouldBeEnabled() {\n492:     Project p = ProjectBrowser.TheInstance.getProject();\n493:     return super.shouldBeEnabled() && p != null;\n494:   }\n495: } /* end class ActionUseCase */\n496: \n497: class ActionState extends UMLAction {\n498:   uci.gef.Cmd _cmdCreateNode = new\n499:   uci.gef.CmdCreateNode(State.class, \"State\");\n500: \n501:   public ActionState() { super(\"State\"); }\n502: \n503:   public void actionPerformed(ActionEvent e) {\n504:     System.out.println(\"making state...\");\n505:     _cmdCreateNode.doIt();\n506:   }\n507:   public boolean shouldBeEnabled() {\n508:     Project p = ProjectBrowser.TheInstance.getProject();\n509:     return super.shouldBeEnabled() && p != null;\n510:   }\n511: } /* end class ActionState */\n512: \n513: class ActionPseudostate extends UMLAction {\n514:   uci.gef.Cmd _cmdCreateNode = new\n515:   uci.gef.CmdCreateNode(Pseudostate.class, \"Pseudostate\");\n516: \n517:   public ActionPseudostate() { super(\"Pseudostate\"); }\n518: \n519:   public void actionPerformed(ActionEvent e) {\n520:     System.out.println(\"making Pseudostate...\");\n521:     _cmdCreateNode.doIt();\n522:   }\n523:   public boolean shouldBeEnabled() {\n524:     Project p = ProjectBrowser.TheInstance.getProject();\n525:     return super.shouldBeEnabled() && p != null;\n526:   }\n527: } /* end class ActionPseudostate */\n528: \n529: class ActionPackage extends UMLAction {\n530:   uci.gef.Cmd _cmdCreateNode = new\n531: 