)\";\n153:     }\n154: \n155:     /**\n156:      * @see org.argouml.application.api.NotationProvider2#generateObjectFlowState(java.lang.Object)\n157:      */\n158:     public String generateObjectFlowState(Object m) {\n159:         Object c = ModelFacade.getType(m);\n160:         if (c == null) return \"\";\n161:         return ModelFacade.getName(c);\n162:     }\n163:     \n164:     /**\n165:      * Generates operation\n166:      *\n167:      * @param modelElement Model element to generate notation for.\n168:      * @param bAddDocs     Add documentation in front of notation?\n169:      *\n170:      * @return Generated notation for model element.\n171:      */\n172:     public String generateOperation(Object modelElement, boolean bAddDocs) {\n173:         if (!ModelFacade.isAOperation(modelElement)) {\n174:             throw new ClassCastException(modelElement.getClass()\n175:                     + \" has wrong object type, Operation required\");\n176:         }\n177: \n178:         String sOperation = \"\";\n179: \n180:         if (bAddDocs) {\n181:             PHPDocumentor objPHPDoc = null;\n182:             try {\n183:                 objPHPDoc = new PHPDocumentor(modelElement);\n184:             } catch (Exception exp) {\n185:                 LOG.error(\"Generating operation DocBlock FAILED: \"\n186:                     + exp.getMessage());\n187:             } finally {\n188:                 if (objPHPDoc != null) {\n189:                     sOperation += objPHPDoc.toString();\n190:                 }\n191:             }\n192:         }\n193: \n194:         String sVisibility = generate(ModelFacade.getVisibility(modelElement));\n195:         if (sVisibility != null && sVisibility != \"\") {\n196:             sOperation += sVisibility + \" \";\n197:         }\n198: \n199:         if (iLanguageMajorVersion > 4) {\n200:             /* scope */\n201:             Object ownerScope = ModelFacade.getOwnerScope(modelElement);\n202:             if (ModelFacade.CLASSIFIER_SCOPEKIND.equals(ownerScope)) {\n203:                 sOperation += \"static \";\n204:             }\n205: \n206:             /* changeability */\n207:             if (ModelFacade.isLeaf(modelElement)) {\n208:                 sOperation += \"final \";\n209:             }\n210: \n211:             /* abstractness */\n212:             if (ModelFacade.isAbstract(modelElement)) {\n213:                 sOperation += \"abstract \";\n214:             }\n215:         }\n216: \n217:         boolean bReturnByReference = false;\n218: \n219:         Iterator itTaggedValues = ModelFacade.getTaggedValues(modelElement);\n220:         if (itTaggedValues != null && itTaggedValues instanceof Iterator) {\n221:             while (itTaggedValues.hasNext()) {\n222:                 Object objTaggedValue = itTaggedValues.next();\n223:                 if (ModelFacade.getTagOfTag(objTaggedValue).equals(\"&\")) {\n224:                     if (ModelFacade.getValueOfTag(objTaggedValue)\n225:                             .equals(\"true\")) {\n226:                         bReturnByReference = true;\n227: \n228:                         break;\n229:                     }\n230:                 }\n231:             }\n232:         }\n233: \n234:         String sOperationName = NameGenerator.generate(modelElement,\n235:                 iLanguageMajorVersion);\n236: \n237:         if (bReturnByReference) {\n238:             sOperationName = \"&\" + sOperationName;\n239:         }\n240: \n241:         sOperation += \"function \" + sOperationName + \"(\";\n242: \n243:         Collection colParameters = ModelFacade.getParameters(modelElement);\n244:         if (colParameters != null) {\n245:             Iterator itParameters = colParameters.iterator();\n246:             boolean bFirst = true;\n247:             while (itParameters.hasNext()) {\n248:                 Object objParameter = itParameters.next();\n249:                 if (!ModelFacade.isReturn(objParameter)) {\n250:                     if (!bFirst