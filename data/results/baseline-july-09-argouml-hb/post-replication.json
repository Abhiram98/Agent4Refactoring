t java.util.ArrayList;\n33: import java.util.Collection;\n34: import java.util.Iterator;\n35: import java.util.List;\n36: \n37: import javax.swing.JFileChooser;\n38: import javax.swing.JOptionPane;\n39: import javax.swing.filechooser.FileFilter;\n40: \n41: import org.argouml.application.api.Configuration;\n42: import org.argouml.application.api.ConfigurationKey;\n43: import org.argouml.i18n.Translator;\n44: import org.argouml.kernel.Project;\n45: import org.argouml.ui.ProjectBrowser;\n46: import org.tigris.gef.util.UnexpectedException;\n47: \n48: \n49: /**\n50:  * This class shall be the only one that knows in which file formats\n51:  * ArgoUML is able to save and load. And all that knowledge is\n52:  * concentrated in the constructor... <p>\n53:  *\n54:  * The PersisterManager manages the list of persisters. <p>\n55:  *\n56:  * This class is a singleton, since this allows external modules to\n57:  * add extra persisters to the ArgoUML application.\n58:  *\n59:  * @author mvw@tigris.org\n60:  */\n61: public final class PersistenceManager {\n62:     /**\n63:      * The singleton instance.\n64:      */\n65:     private static final PersistenceManager INSTANCE =\n66:         new PersistenceManager();\n67: \n68:     private AbstractFilePersister defaultPersister;\n69:     private List otherPersisters = new ArrayList();\n70:     private UmlFilePersister quickViewDump;\n71:     private XmiFilePersister xmiPersister;\n72:     private XmiFilePersister xmlPersister;\n73:     private ZipFilePersister zipPersister;\n74: \n75:     /**\n76:      * The configuration key for the project file location.\n77:      */\n78:     public static final ConfigurationKey KEY_PROJECT_NAME_PATH =\n79:         Configuration.makeKey(\"project\", \"name\", \"path\");\n80: \n81:     /**\n82:      * The configuration key for the \"open project\" file location.\n83:      */\n84:     public static final ConfigurationKey KEY_OPEN_PROJECT_PATH =\n85:         Configuration.makeKey(\"project\", \"open\", \"path\");\n86: \n87:     /**\n88:      * The configuration key for the \"import xmi\" file location.\n89:      */\n90:     public static final ConfigurationKey KEY_IMPORT_XMI_PATH =\n91:         Configuration.makeKey(\"xmi\", \"import\", \"path\");\n92: \n93:     /**\n94:      * Create the default diagram persister.\n95:      */\n96:     private DiagramMemberFilePersister diagramMemberFilePersister\n97:         = new DiagramMemberFilePersister();\n98: \n99:     /**\n100:      * @return returns the singleton\n101:      */\n102:     public static PersistenceManager getInstance() {\n103:         return INSTANCE;\n104:     }\n105: \n106:     /**\n107:      * The constructor.\n108:      */\n109:     private PersistenceManager() {\n110:         // These are the file formats I know about:\n111:         defaultPersister = new ZargoFilePersister();\n112:         quickViewDump = new UmlFilePersister();\n113:         otherPersisters.add(quickViewDump);\n114:         xmiPersister = new XmiFilePersister();\n115:         otherPersisters.add(xmiPersister);\n116:         xmlPersister = new XmlFilePersister();\n117:         otherPersisters.add(xmlPersister);\n118:         zipPersister = new ZipFilePersister();\n119:         otherPersisters.add(zipPersister);\n120:     }\n121: \n122:     /**\n123:      * This function allows to add new persisters. This can be done e.g.\n124:      * by plugins/modules.\n125:      *\n126:      * @param fp the persister\n127:      */\n128:     public void register(AbstractFilePersister fp) {\n129:         otherPersisters.add(fp);\n130:     }\n131: \n132:     /**\n133:      * @param name the filename\n134:      * @return the persister\n135:      */\n136:     public AbstractFilePersister getPersisterFromFileName(String name) {\n137:         if (defaultPersister.isFileExtensionApplicable(name)) {\n138:             return defaultPersister;\n139:         }\n140:         Iterator iter = otherPersisters.iterator();\n141:         while (iter.hasNext()) {\n142:             AbstractFilePersister persister =\n143:                 (AbstractFilePersister) iter.next();\n144:             if (persister.isFileExtensionApplicable(name)) {\n145:                 return persister;\n146:             }\n147:         }\n148:         return null;\n149:     }\n150: \n151:     /**\n152:      * @param chooser the filechooser of which the filters will be set\n153:      * @param fileName the filename of the file to be saved (optional)\n154:      */\n155:     public void setSaveFileChooserFilters(JFileChooser chooser, \n156:             String fileName) {\n157:         \n158:         chooser.addChoosableFileFilter(defaultPersister);\n159:         AbstractFilePersister defaultFileFilter = defaultPersister;\n160:         \n161:         Iterator iter = otherPersisters.iterator();\n162:         while (iter.hasNext()) {\n163:             AbstractFilePersister fp = (AbstractFilePersister) iter.next();\n164:             if (!fp.equals(xmiPersister) && !fp.equals(xmlPersister)) {\n165:                 chooser.addChoosableFileFilter(fp);\n166:                 if (fileName != null \n167:                         && fp.isFileExtensionApplicable(fileName)) {\n168:                     defaultFileFilter = fp;\n169:                 }\n170:             }\n171:         }\n172:         chooser.setFileFilter(defaultFileFilter);\n173:     }\n174: \n175:     /**\n176:      * @param chooser the filechooser of which the filters will be set\n177:      */\n178:     public void setOpenFileChooserFilter(JFileChooser chooser) {\n179:         MultitypeFileFilter mf = new MultitypeFileFilter();\n180:         mf.add(defaultPersister);\n181:         chooser.addChoosableFileFilter(mf);\n182:         chooser.addChoosableFileFilter(defaultPersister);\n183:         Iterator iter = otherPersisters.iterator();\n184:         while (iter.hasNext()) {\n185:             AbstractFilePersister ff = (AbstractFilePersister) iter.next();\n186:             mf.add(ff);\n187:             chooser.addChoosableFileFilter(ff);\n188:         }\n189:         chooser.setFileFilter(mf);\n190:     }\n191: \n192:     /**\n193:      * @param chooser the filechooser of which the filters will be set\n194:      */\n195:     public void setXmiFileChooserFilter(JFileChooser chooser) {\n196:         chooser.addChoosableFileFilter(xmiPersister);\n197:         chooser.setFileFilter(xmiPersister);\n198:     }\n199: \n200:     /**\n201:      * @return the extension of the default persister\n202:      *         (just the text, not the \".\")\n203:      */\n204:     public String getDefaultExtension() {\n205:         return defaultPersister.getExtension();\n206:     }\n207: \n208:     /**\n209:      * @return the extension of the xmi persister\n210:      *         (just the text, not the \".\")\n211:      */\n212:     public String getXmiExtension() {\n213:         return xmiPersister.getExtension();\n214:     }\n215: \n216:     /**\n217:      * @param in the input file or path name which may or may not\n218:      *           have a recognised extension\n219:      * @return the amended file or pathname, guaranteed to have\n220:      *         a recognised extension\n221:      */\n222:     public String fixExtension(String in) {\n223:         if (getPersisterFromFileName(in) == null) {\n224:             in += \".\" + getDefaultExtension();\n225:         }\n226:         return in;\n227:     }\n228: \n229:     /**\n230:      * @param in the input file or path name which may or may not\n231:      *           have a \"xmi\" extension\n232:      * @return the amended file or pathname, guaranteed to have\n233:      *         a \"xmi\" extension\n234:      */\n235:     public String fixXmiExtension(String in) {\n236:         if (getPersisterFromFileName(in) != xmiPersister) {\n237:             in += \".\" + getXmiExtension();\n238:         }\n239:         return in;\n240:     }\n241: \n242: \n243:     /**\n244:      * @param in the input url which may or may not have a recognised extension\n245:      * @return the url with default extension added,\n246:      *         if it did not have a valid extension yet\n247:      */\n248:     public URL fixUriExtension(URL in) {\n249:         URL newUrl;\n250:         String n = in.toString();\n251:         n = fixExtension(n);\n252:         try {\n253:             newUrl = new URL(n);\n254:         } catch (java.net.MalformedURLException e) {\n255:             throw new UnexpectedException(e);\n256:         }\n257:         return newUrl;\n258:     }\n259: \n260:     /**\n261:      * Find the base name of the given filename.<p>\n262:      *\n263:      * This is the name minus any valid file extension.\n264:      * Invalid extensions are left alone.\n265:      *\n266:      * @param n the given file name\n267:      * @return the name (a String) without extension\n268:      */\n269:     public String getBaseName(String n) {\n270:         AbstractFilePersister p = getPersisterFromFileName(n);\n271:         if (p == null) {\n272:             return n;\n273:         }\n274:         int extLength = p.getExtension().length() + 1;\n275:         return n.substring(0, n.length() - extLength);\n276:     }\n277: \n278:     /**\n279:      * Generates a String dump of the current model for quick viewing.\n280:      *\n281:      * @param project The project to generate.\n282:      * @return The whole model in a String.\n283:      */\n284:     public String getQuickViewDump(Project project) {\n285:         OutputStream stream = new ByteArrayOutputStream();\n286:         try {\n287:             quickViewDump.writeProject(project, stream, null);\n288:         } catch (Exception e) {\n289:             // If anything goes wrong return the stack\n290:             // trace as a string so that we get some\n291:             // useful feedback.\n292:             e.printStackTrace(new PrintStream(stream));\n293:         }\n294:         return stream.toString();\n295:     }\n296: \n297:     /**\n298:      * Get the file persister for diagrams.\n299:      *\n300:      * @return the diagram file persister.\n301:      */\n302:     DiagramMemberFilePersister getDiagramMemberFilePersister() {\n303:     \treturn diagramMemberFilePersister;\n304:     }\n305: \n306:     /**\n307:      * Set an alternative file persister for diagrams.\n308:      *\n309:      * @param persister the persister to use instead of the default\n310:      */\n311:     public void setDiagramMemberFilePersister(\n312:             DiagramMemberFilePersister persister) {\n313:     \tdiagramMemberFilePersister = persister;\n314:     }\n315: \n316:     /**\n317:      * Returns true if we are allowed to overwrite the given file.\n318:      *\n319:      * @param overwrite if true, then the user is not asked\n320:      * @param file the given file\n321:      * @return true if we are allowed to overwrite the given file\n322:      */\n323:     public boolean confirmOverwrite(boolean overwrite, File file) {\n324:         if (file.exists() && !overwrite) {\n325:             String sConfirm =\n326:                 Translator.messageFormat(\n327:                     \"optionpane.confirm-overwrite\",\n328:                     new Object[] {file});\n329:             int nResult =\n330:                 JOptionPane.showConfirmDialog(\n331:                         ProjectBrowser.getInstance(),\n332:                         sConfirm,\n333:                         Translator.localize(\n334:                             \"optionpane.confirm-overwrite-title\"),\n335:                         JOptionPane.YES_NO_OPTION,\n336:                         JOptionPane.QUESTION_MESSAGE);\n337:             if (nResult != JOptionPane.YES_OPTION) {\n338:                 return false;\n339:             }\n340:         }\n341:         return true;\n342:     }\n343: }\n344: \n345: /**\n346:  * Composite file filter which will accept any\n347:  * file type added to it.\n348:  */\n349: class MultitypeFileFilter extends FileFilter {\n350:     private ArrayList filters;\n351:     private String desc;\n352: \n353:     /**\n354:      * Constructor\n355:      */\n356:     public MultitypeFileFilter() {\n357:         super();\n358:         filters = new ArrayList();\n359:     }\n360: \n361:     /**\n362:      * Add a FileFilter to list of file filters to be accepted\n363:      * \n364:      * @param filter FileFilter to be added\n365:      */\n366:     public void add(AbstractFilePersister filter) {\n367:         filters.add(filter);\n368:         desc =\n369:             ((desc == null)\n370:                 ? \"\"\n371:                 : desc + \", \")\n372:             + \"*.\" + filter.getExtension();\n373:     }\n374: \n375:     /**\n376:      * Return all added FileFilters.\n377:      * \n378:      * @return collection of FileFilters\n379:      */\n380:     public Collection getAll() {\n381:         return filters;\n382:     }\n383: \n384:     /**\n385:      * Accept any file that any of our filters will accept.\n386:      *\n387:      * @see javax.swing.filechooser.FileFilter#accept(java.io.File)\n388:      */\n389:     public boolean accept(File arg0) {\n390:         Iterator it = filters.iterator();\n391:         while (it.hasNext()) {\n392:             if (((FileFilter) it.next()).accept(arg0)) {\n393:                 return true;\n394:             }\n395:         }\n396:         return false;\n397:     }\n398: \n399:     /**\n400:      * @see javax.swing.filechooser.FileFilter#getDescription()\n401:      */\n402:     public String getDescription() {\n403:         Object[] s = {desc};\n404:         return Translator.messageFormat(\"filechooser.all-types-desc\", s);\n405:     }\n406: \n407: }\n408: ",
