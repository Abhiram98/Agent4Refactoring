f (model == member) {\n90:             model = null;\n91:             return true;\n92:         } else if (todoList == member) {\n93:             LOG.info(\"Removing todo list\");\n94:             setTodoList(null);\n95:             return true;\n96:         } else {\n97:             return members.remove(member);\n98:         }\n99:     }\n100:     \n101:     /**\n102:      * @see java.util.Collection#iterator()\n103:      */\n104:     public Iterator iterator() {\n105:         ArrayList temp = new ArrayList(size());\n106:         if (model != null) {\n107:             temp.add(model);\n108:         }\n109:         temp.addAll(members);\n110:         if (todoList != null) {\n111:             temp.add(todoList);\n112:         }\n113:         return temp.iterator();\n114:     }\n115: \n116:     /**\n117:      * @see java.util.List#listIterator()\n118:      */\n119:     public ListIterator listIterator() {\n120:         ArrayList temp = new ArrayList(size());\n121:         if (model != null) {\n122:             temp.add(model);\n123:         }\n124:         temp.addAll(members);\n125:         if (todoList != null) {\n126:             temp.add(todoList);\n127:         }\n128:         return temp.listIterator();\n129:     }\n130: \n131:     /**\n132:      * @see java.util.List#listIterator(int)\n133:      */\n134:     public ListIterator listIterator(int arg0) {\n135:         ArrayList temp = new ArrayList(size());\n136:         if (model != null) {\n137:             temp.add(model);\n138:         }\n139:         temp.addAll(members);\n140:         if (todoList != null) {\n141:             temp.add(todoList);\n142:         }\n143:         return temp.listIterator(arg0);\n144:     }\n145:     \n146:     private boolean removeDiagram(Diagram d) {\n147:         Iterator it = members.iterator();\n148:         while (it.hasNext()) {\n149:             Object obj = it.next();\n150:             ProjectMemberDiagram pmd = (ProjectMemberDiagram) obj;\n151:             if (pmd.getDiagram() == d) {\n152:                 pmd.remove();\n153:                 members.remove(pmd);\n154:                 return true;\n155:             }\n156:         }\n157:         return false;\n158:     }\n159: \n160:     \n161:     \n162:     /**\n163:      * @see java.util.Collection#size()\n164:      */\n165:     public int size() {\n166:         int size = members.size();\n167:         if (model != null) ++size;\n168:         if (todoList != null) ++size;\n169:         return size;\n170:     }\n171:     \n172:     /**\n173:      * @param uniqueName the name of the member to be found\n174:      * @return the member\n175:      */\n176:     public ProjectMember findDiagramMemberByName(String uniqueName) {\n177:         for (int i = 0; i < members.size(); i++) {\n178:             ProjectMember pm = (ProjectMember) members.get(i);\n179:             if (uniqueName.equals(pm.getPlainName()))\n180:                 return pm;\n181:         }\n182:         return null;\n183:     }\n184:     \n185:     /**\n186:      * @see java.util.Collection#contains(java.lang.Object)\n187:      */\n188:     public boolean contains(Object member) {\n189:         if (todoList == member) {\n190:             return true;\n191:         }\n192:         if (model == member) {\n193:             return true;\n194:         }\n195:         return members.contains(member);\n196:     }\n197:     \n198:     /**\n199:      * @see java.util.Collection#clear()\n200:      */\n201:     public void clear() {\n202:         LOG.info(\"Clearing members\");\n203:         if (model != null) {\n204:             model.remove();\n205:         }\n206:         if (todoList != null) {\n207:             todoList.remove();\n208:         }\n209:         Iterator membersIt = members.iterator();\n210:         while (membersIt.hasNext()) {\n211:             ((AbstractProjectMember) membersIt.next()).remove();\n212:         }\n213:         members.clear();\n214:     }\n215:     \n216:     /**\n217:      * @param type the type of the member\n218:      * @return the member of the project\n219:      */\n220:     public ProjectMember getMember(Class type) {\n221:         if (type == ProjectMemberModel.class) {\n222:             return model;\n223:         }\n224:         if (type == ProjectMemberTodoList.class) {\n225:             return todoList;\n226:         }\n227:         throw new IllegalArgumentException(\n228:             \"There is no single instance of a \" + type.getName() + \" member\");\n229:     }\n230:     \n231:     /**\n232:      * @see java.util.List#get(int)\n233:      */\n234:     public Object get(int i) {\n235:         if (model != null) {\n236:             if (i == 0) {\n237:                 return model;\n238:             }\n239:             --i;\n240:         }\n241:         \n242:         if (i == members.size()) {\n243:             return todoList;\n244:         }\n245:         \n246:         return (ProjectMember) members.get(i);\n247:     }\n248: \n249:     /**\n250:      * @see java.util.List#isEmpty()\n251:      */\n252:     public boolean isEmpty() {\n253:         return size() == 0;\n254:     }\n255: \n256:     /**\n257:      * @see java.util.List#toArray()\n258:      */\n259:     public Object[] toArray() {\n260:         Object[] temp = new Object[size()];\n261:         int pos = 0;\n262:         if (model != null) {\n263:             temp[pos++] = model;\n264:         }\n265:         for (int i = 0; i < members.size(); ++i) {\n266:             temp[pos++] = members.get(i);\n267:         }\n268:         if (todoList != null) {\n269:             temp[pos++] = todoList;\n270:         }\n271:         return temp;\n272:     }\n273: \n274:     private void setTodoList(AbstractProjectMember member) {\n275:         LOG.info(\"Setting todoList to \" + member);\n276:         todoList = member;\n277:     }\n278:     \n279:     /**\n280:      * @see java.util.List#toArray(java.lang.Object[])\n281:      */\n282:     public Object[] toArray(Object[] arg0) {\n283: 