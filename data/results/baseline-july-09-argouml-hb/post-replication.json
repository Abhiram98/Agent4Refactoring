;\n31: import java.io.FileOutputStream;\n32: import java.io.IOException;\n33: import java.io.InputStreamReader;\n34: import java.io.OutputStream;\n35: import java.io.OutputStreamWriter;\n36: import java.io.PrintWriter;\n37: import java.io.Reader;\n38: import java.io.UnsupportedEncodingException;\n39: import java.io.Writer;\n40: import java.net.URL;\n41: import java.util.Hashtable;\n42: import java.util.List;\n43: \n44: import javax.xml.transform.Result;\n45: import javax.xml.transform.Transformer;\n46: import javax.xml.transform.TransformerException;\n47: import javax.xml.transform.TransformerFactory;\n48: import javax.xml.transform.stream.StreamResult;\n49: import javax.xml.transform.stream.StreamSource;\n50: \n51: import org.apache.log4j.Logger;\n52: import org.argouml.application.ArgoVersion;\n53: import org.argouml.i18n.Translator;\n54: import org.argouml.kernel.Project;\n55: import org.argouml.kernel.ProjectMember;\n56: import org.argouml.uml.ProjectMemberModel;\n57: import org.argouml.uml.cognitive.ProjectMemberTodoList;\n58: import org.argouml.uml.diagram.ProjectMemberDiagram;\n59: import org.argouml.util.ThreadUtils;\n60: import org.tigris.gef.ocl.ExpansionException;\n61: import org.tigris.gef.ocl.OCLExpander;\n62: import org.tigris.gef.ocl.TemplateReader;\n63: import org.xml.sax.SAXException;\n64: \n65: /**\n66:  * To persist to and from argo (xml file) storage.\n67:  *\n68:  * @author Bob Tarling\n69:  */\n70: class UmlFilePersister extends AbstractFilePersister {\n71: \n72:     /**\n73:      * The PERSISTENCE_VERSION is increased every time the persistence format\n74:      * changes.\n75:      * This controls conversion of old persistence version files to be\n76:      * converted to the current one, keeping ArgoUML backwards compatible.\n77:      */\n78:     protected static final int PERSISTENCE_VERSION = 5;\n79:     \n80:     /**\n81:      * The TOTAL_PHASES_LOAD constant is the number of phases used by the load\n82:      * process.\n83:      */\n84:     protected static final int UML_PHASES_LOAD = 2;\n85:     \n86:     /**\n87:      * Logger.\n88:      */\n89:     private static final Logger LOG =\n90:         Logger.getLogger(UmlFilePersister.class);\n91: \n92:     private static final String ARGO_TEE =\n93: \t\"/org/argouml/persistence/argo.tee\";\n94: \n95:     /**\n96:      * The constructor.\n97:      */\n98:     public UmlFilePersister() {\n99:     }\n100: \n101:     /*\n102:      * @see org.argouml.persistence.AbstractFilePersister#getExtension()\n103:      */\n104:     public String getExtension() {\n105:         return \"uml\";\n106:     }\n107: \n108:     /*\n109:      * @see org.argouml.persistence.AbstractFilePersister#getDesc()\n110:      */\n111:     protected String getDesc() {\n112:         return Translator.localize(\"combobox.filefilter.uml\");\n113:     }\n114: \n115:     /**\n116:      * It is being considered to save out individual\n117:      * xmi's from individuals diagrams to make\n118:      * it easier to modularize the output of Argo.\n119:      *\n120:      * @param file The file to write.\n121:      * @param project the project to save\n122:      * @throws SaveException when anything goes wrong\n123:      * @throws InterruptedException     if the thread is interrupted\n124:      *\n125:      * @see org.argouml.persistence.ProjectFilePersister#save(\n126:      * org.argouml.kernel.Project, java.io.File)\n127:      */\n128:     public void doSave(Project project, File file)\n129:         throws SaveException, InterruptedException {\n130: \n131:         ProgressMgr progressMgr = new ProgressMgr();\n132:         progressMgr.setNumberOfPhases(4);\n133:         progressMgr.nextPhase();\n134:         \n135:         File lastArchiveFile = new File(file.getAbsolutePath() + \"~\");\n136:         File tempFile = null;\n137: \n138:         try {\n139:             tempFile = createTempFile(file);\n140:         } catch (FileNotFoundException e) {\n141:             throw new SaveException(\n142:                     \"Failed to archive the previous file version\", e);\n143:         } catch (IOException e) {\n144:             throw new SaveException(\n145:                     \"Failed to archive the previous file version\", e);\n146:         }\n147: \n148:         try {\n149:             project.setFile(file);\n150:             project.setVersion(ArgoVersion.getVersion());\n151:             project.setPersistenceVersion(PERSISTENCE_VERSION);\n152: \n153:             FileOutputStream stream =\n154:                 new FileOutputStream(file);\n155: \n156:             writeProject(project, stream, progressMgr);\n157: \n158:             stream.close();\n159: \n160:             progressMgr.nextPhase();\n161: \n162:             String path = file.getParent();\n163:             if (LOG.isInfoEnabled()) {\n164:                 LOG.info(\"Dir ==\" + path);\n165:             }\n166: \n167:             // if save did not raise an exception\n168:             // and name+\"#\" exists move name+\"#\" to name+\"~\"\n169:             // this is the correct backup file\n170:             if (lastArchiveFile.exists()) {\n171:                 lastArchiveFile.delete();\n172:             }\n173:             if (tempFile.exists() && !lastArchiveFile.exists()) {\n174:                 tempFile.renameTo(lastArchiveFile);\n175:             }\n176:             if (tempFile.exists()) {\n177:                 tempFile.delete();\n178:             }\n179:             \n180:             progressMgr.nextPhase();\n181:             \n182:         } catch (Exception e) {\n183:             LOG.error(\"Exception occured during save attempt\", e);\n184: \n185:             // frank: in case of exception\n186:             // delete name and mv name+\"#\" back to name if name+\"#\" exists\n187:             // this is the \"rollback\" to old file\n188:             file.delete();\n189:             tempFile.renameTo(file);\n190:             if (e instanceof InterruptedException) {\n191:                 throw (InterruptedException) e;\n192:             } else {\n193:                 // we have to give a message to user and set the system \n194:                 // to unsaved!\n195:                 throw new SaveException(e);\n196:             }\n197:         }\n198:     }\n199:     \n200:     /**\n201:      * The .uml save format is no longer available to save\n202:      * @see org.argouml.persistence.AbstractFilePersister#isSaveEnabled()\n203:      */\n204:     public boolean isSaveEnabled() {\n205:         return true;\n206:     }\n207: \n208:     /**\n209:      * Write the output for a project on the given stream.\n210:      *\n211:      * @param project The project to output.\n212:      * @param stream The stream to write to.\n213:      * @throws SaveException If something goes wrong.\n214:      * @throws InterruptedException     if the thread is interrupted\n215:      */\n216:     void writeProject(Project project, \n217:             OutputStream stream, \n218:             ProgressMgr progressMgr) throws SaveException, \n219:             InterruptedException {\n220:         OutputStreamWriter outputStreamWriter;\n221:         try {\n222:             outputStreamWriter = new OutputStreamWriter(stream, \"UTF-8\");\n223:         } catch (UnsupportedEncodingException e) {\n224:             throw new SaveException(e);\n225:         }\n226:         PrintWriter writer =\n227:             new PrintWriter(new BufferedWriter(outputStreamWriter));\n228: \n229:         try {\n230:             Integer indent = new Integer(4);\n231: \n232:             writer.println(\"<?xml version = \\\"1.0\\\" \"\n233:                     + \"encoding = \\\"\" \n234:                     + PersistenceManager.getEncoding() + \"\\\" ?>\");\n235:             writer.println(\"<uml version=\\\"\" + PERSISTENCE_VERSION + \"\\\">\");\n236:             // Write out header section\n237:             try {\n238:                 Hashtable templates =\n239:                     TemplateReader.getInstance().read(ARGO_TEE);\n240:                 OCLExpander expander = new OCLExpander(templates);\n241:                 expander.expand(writer, project, \"  \");\n242:             } catch (ExpansionException e) {\n243:                 throw new SaveException(e);\n244:             }\n245: \n246:             // Write out XMI section first\n247:             int size = project.getMembers().size();\n248:             for (int i = 0; i < size; i++) {\n249:                 ProjectMember projectMember =\n250:                     (ProjectMember) project.getMembers().get(i);\n251:                 if (projectMember.getType().equalsIgnoreCase(\"xmi\")) {\n252:                     if (LOG.isInfoEnabled()) {\n253:                         LOG.info(\"Saving member of type: \"\n254:                               + ((ProjectMember) project.getMembers()\n255:                                     .get(i)).getType());\n256:                     }\n257:                     MemberFilePersister persister\n258:                         = getMemberFilePersister(projectMember);\n259:                     persister.save(projectMember, writer, indent);\n260:                 }\n261:             }\n262: \n263:             if (progressMgr != null) {\n264:                 progressMgr.nextPhase();\n265:             }\n266: \n267:             // Write out all non-XMI sections\n268:             for (int i = 0; i < size; i++) {\n269:                 ProjectMember projectMember =\n270:                     (ProjectMember) project.getMembers().get(i);\n271:                 if (!projectMember.getType().equalsIgnoreCase(\"xmi\")) {\n272:                     if (LOG.isInfoEnabled()) {\n273:                         LOG.info(\"Saving member of type: \"\n274:                               + ((ProjectMember) project.getMembers().\n275:                                     get(i)).getType());\n276:                     }\n277:                     MemberFilePersister persister\n278:                         = getMemberFilePersister(projectMember);\n279:                     persister.save(projectMember, writer, indent);\n280:                 }\n281:             }\n282: \n283:             writer.println(\"</uml>\");\n284: \n285:             writer.flush();\n286:         } finally {\n287:             writer.close();\n288:         }\n289:     }\n290: \n291:     /*\n292:      * @see org.argouml.persistence.ProjectFilePersister#doLoad(java.io.File)\n293:      */\n294:     public Project doLoad(File file) throws OpenException, \n295:     InterruptedException {\n296:         // let's initialize the progressMgr\n297:         ProgressMgr progressMgr = new ProgressMgr();\n298:         progressMgr.setNumberOfPhases(UML_PHASES_LOAD);\n299:         \n300:         ThreadUtils.checkIfInterrupted();\n301:         return doLoad(file, file, progressMgr);\n302:     }\n303: \n304:     /*\n305:      * @see org.argouml.persistence.ProjectFilePersister#doLoad(java.io.File)\n306:      */\n307:     public Project doLoad(File originalFile, File file, ProgressMgr progressMgr)\n308:         throws OpenException, InterruptedException {\n309: \n310:         XmlInputStream inputStream = null;\n311:         try {\n312:             Project p = new Project(file.toURI());\n313:             \n314:             // Run through any stylesheet upgrades\n315:             int fileVersion = getPersistenceVersionFromFile(file);\n316: \n317:             // If we're trying to load a file from a future version\n318:             // complain and refuse.\n319:             if (fileVersion > PERSISTENCE_VERSION) {\n320:                 String release = getReleaseVersionFromFile(file);\n321:                 throw new VersionException(\n322:                     \"The file selected is from a more up to date version of \"\n323:                     + \"ArgoUML. It has been saved with ArgoUML version \"\n324:                     + release\n325:                     + \". Please load with that or a more up to date\"\n326:                     + \"release of ArgoUML\");\n327:             }\n328: \n329:             // If we're about to upgrade the file lets take an archive\n330:             // of it first.\n331:             if (fileVersion < PERSISTENCE_VERSION) {\n332:                 String release = getReleaseVersionFromFile(file);\n333:                 copyFile(\n334:                     originalFile,\n335:                     new File(originalFile.getAbsolutePath() + '~' + release));\n336:             }\n337:            \n338:             LOG.info(\"Loading uml file of version \" + fileVersion);\n339:             while (fileVersion < PERSISTENCE_VERSION) {\n340:                 ++fileVersion;\n341:                 LOG.info(\"Upgrading to version \" + fileVersion);\n342:                 long startTime = System.currentTimeMillis();\n343:                 file = transform(file, fileVersion);\n344:                 long endTime = System.currentTimeMillis();\n345:                 LOG.info(\"Upgrading took \"\n346:                         + ((endTime - startTime) / 1000)\n347:                         + \" seconds\");\n348:             }\n349:             progressMgr.nextPhase();\n350: \n351:             inputStream = new XmlInputStream(\n352:                         file.toURL().openStream(),\n353:                         \"argo\",\n354:                         file.length(),\n355:                         100000);\n356: \n357:             ArgoParser parser = new ArgoParser();\n358:             Reader reader =\n359:                     new InputStreamReader(inputStream, \n360:                             PersistenceManager.getEncoding());\n361:             parser.readProject(p, reader);\n362:             \n363:             List memberList = parser.getMemberList();\n364: \n365:             LOG.info(memberList.size() + \" members\");\n366: \n367:             for (int i = 0; i < memberList.size(); ++i) {\n368:                 MemberFilePersister persister\n369:                     = getMemberFilePersister((String) memberList.get(i));\n370:                 LOG.info(\"Loading member with \"\n371:                         + persister.getClass().getName());\n372:                 inputStream.reopen(persister.getMainTag());\n373:                 persister.load(p, inputStream);\n374:             }\n375:             \n376:             // let's update the progress\n377:             progressMgr.nextPhase();\n378:             ThreadUtils.checkIfInterrupted();\n379:             inputStream.realClose();\n380:             p.postLoad();\n381:             return p;\n382:         } catch (InterruptedException e) {\n383:             throw e;\n384:         } catch (OpenException e) {\n385:             throw e;\n386:         } catch (IOException e) {\n387:             throw new OpenException(e);\n388:         } catch (SAXException e) {\n389:             throw new OpenException(e);\n390:         }\n391:     }\n392: \n393: \n394:     \n395:     /**\n396:      * Transform a string of XML data according to the service required.\n397:      *\n398:      * @param file The XML file to be transformed\n399:      * @param version the version of the persistence format\n400:      *                the XML is to be transformed to.\n401:      * @return the transformed XML file\n402:      * @throws OpenException on XSLT transformation error or file read\n403:      */\n404:     public final File transform(File file, int version)\n405:         throws OpenException {\n406: \n407:         try {\n408:             String upgradeFilesPath = \"/org/argouml/persistence/upgrades/\";\n409:             String upgradeFile = \"upgrade\" + version + \".xsl\";\n410: \n411:             String xsltFileName = upgradeFilesPath + upgradeFile;\n412:             URL xsltUrl = UmlFilePersister.class.getResource(xsltFileName);\n413:             LOG.info(\"Resource is \" + xsltUrl);\n414: \n415:             // Read xsltStream into a temporary file\n416:             // Get url for temp file.\n417:             // openStream from url and wrap in StreamSource\n418:             StreamSource xsltStreamSource =\n419:                 new StreamSource(xsltUrl.openStream());\n420:             xsltStreamSource.setSystemId(xsltUrl.toExternalForm());\n421: \n422:             TransformerFactory factory = TransformerFactory.newInstance();\n423:             Transformer transformer = factory.newTransformer(xsltStreamSource);\n424: \n425:             File transformedFile =\n426:                 File.createTempFile(\"upgrade_\" + version + \"_\", \".uml\");\n427:             transformedFile.deleteOnExit();\n428: \n429:             FileOutputStream stream =\n430:                 new FileOutputStream(transformedFile);\n431:             Writer writer =\n432:                 new BufferedWriter(new OutputStreamWriter(stream, \n433:                         PersistenceManager.getEncoding()));\n434:             Result result = new StreamResult(writer);\n435: \n436:             StreamSource inputStreamSource = new StreamSource(file);\n437:             inputStreamSource.setSystemId(file);\n438:             transformer.transform(inputStreamSource, result);\n439: \n440:             writer.close();\n441:             return transformedFile;\n442:         } catch (IOException e) {\n443:             throw new OpenException(e);\n444:         } catch (TransformerException e) {\n445:             throw new OpenException(e);\n446:         }\n447:     }\n448: \n449:     /**\n450:      * Reads an XML file of uml format and extracts the\n451:      * persistence version number from the root tag.\n452:      *\n453:      * @param file the XML file\n454:      * @return The version number\n455:      * @throws OpenException on any error\n456:      */\n457:     private int getPersistenceVersionFromFile(File file) throws OpenException {\n458:         BufferedInputStream inputStream = null;\n459:         BufferedReader reader = null;\n460:         try {\n461:             inputStream = new BufferedInputStream(file.toURL().openStream());\n462:             reader = new BufferedReader(new InputStreamReader(inputStream, \n463:                     PersistenceManager.getEncoding()));\n464:             String rootLine = reader.readLine();\n465:             while (!rootLine.startsWith(\"<uml \")) {\n466:                 rootLine = reader.readLine();\n467:                 if (rootLine == null) {\n468:                     throw new OpenException(\n469:                             \"Failed to find the root <uml> tag\");\n470:                 }\n471:             }\n472:             return Integer.parseInt(getVersion(rootLine));\n473:         } catch (IOException e) {\n474:             throw new OpenException(e);\n475:         } catch (NumberFormatException e) {\n476:             throw new OpenException(e);\n477:         } finally {\n478:             try {\n479:                 if (inputStream != null) {\n480:                     inputStream.close();\n481:                 }\n482:                 if (reader != null) {\n483:                     reader.close();\n484:                 }\n485:             } catch (IOException e) {\n486:                 // No more we can do here on failure\n487:             }\n488:         }\n489:     }\n490: \n491: \n492:     /**\n493:      * Reads an XML file of uml format and extracts the\n494:      * persistence version number from the root tag.\n495:      *\n496:      * @param file the XML file\n497:      * @return The ArgoUML release number\n498:      * @throws OpenException on any error\n499:      */\n500:     private String getReleaseVersionFromFile(File file) throws OpenException {\n501:         BufferedInputStream inputStream = null;\n502:         BufferedReader reader = null;\n503:         try {\n504:             inputStream = new BufferedInputStream(file.toURL().openStream());\n505:             reader = new BufferedReader(new InputStreamReader(inputStream, \n506:                     PersistenceManager.getEncoding()));\n507:             String versionLine = reader.readLine();\n508:             while (!versionLine.trim().startsWith(\"<version>\")) {\n509:                 versionLine = reader.readLine();\n510:                 if (versionLine == null) {\n511:                     throw new OpenException(\n512:                             \"Failed to find the release <version> tag\");\n513:                 }\n514:             }\n515:             versionLine = versionLine.trim();\n516:             int end = versionLine.lastIndexOf(\"</version>\");\n517:             return versionLine.trim().substring(9, end);\n518:         } catch (IOException e) {\n519:             throw new OpenException(e);\n520:         } catch (NumberFormatException e) {\n521:             throw new OpenException(e);\n522:         } finally {\n523:             try {\n524:                 if (inputStream != null) {\n525:                     inputStream.close();\n526:                 }\n527:                 if (reader != null) {\n528:                     reader.close();\n529:                 }\n530:             } catch (IOException e) {\n531:                 // No more we can do here on failure\n532:             }\n533:         }\n534:     }\n535: \n536:     /**\n537:      * Get the version attribute value from a string of XML.\n538:      * @param rootLine the line\n539:      * @return the version\n540:      */\n541:     protected String getVersion(String rootLine) {\n542:         String version;\n543:         int versionPos = rootLine.indexOf(\"version=\\\"\");\n544:         if (versionPos > 0) {\n545:             int startPos = versionPos + 9;\n546:             int endPos = rootLine.indexOf(\"\\\"\", startPos);\n547:             version = rootLine.substring(startPos, endPos);\n548:         } else {\n549:             version = \"1\";\n550:         }\n551:         return version;\n552:     }\n553: \n554:     /**\n555:      * Get a MemberFilePersister based on a given ProjectMember.\n556:      *\n557:      * @param pm the project member\n558:      * @return the persister\n559:      */\n560:     protected MemberFilePersister getMemberFilePersister(ProjectMember pm) {\n561:         MemberFilePersister persister = null;\n562:         if (pm instanceof ProjectMemberDiagram) {\n563:             persister =\n564: \t\tPersistenceManager.getInstance()\n565: \t\t        .getDiagramMemberFilePersister();\n566:         } else if (pm instanceof ProjectMemberTodoList) {\n567:             persister = new TodoListMemberFilePersister();\n568:         } else if (pm instanceof ProjectMemberModel) {\n569:             persister = new ModelMemberFilePersister();\n570:         }\n571:         return persister;\n572:     }\n573: \n574:     /**\n575:      * Get a MemberFilePersister based on a given ProjectMember.\n576:      *\n577:      * @param tag The tag.\n578:      * @return the persister\n579:      */\n580:     private MemberFilePersister getMemberFilePersister(String tag) {\n581:         MemberFilePersister persister = null;\n582:         if (tag.equals(\"pgml\")) {\n583:             persister =\n584: \t\tPersistenceManager.getInstance()\n585:                         .getDiagramMemberFilePersister();\n586:         } else if (tag.equals(\"todo\")) {\n587:             persister = new TodoListMemberFilePersister();\n588:         } else if (tag.equals(\"xmi\")) {\n589:             persister = new ModelMemberFilePersister();\n590:         }\n591:         return persister;\n592:     }\n593: \n594:     /**\n595:      * Returns true. All Argo specific files have an icon.\n596:      * \n597:      * @see org.argouml.persistence.AbstractFilePersister#hasAnIcon()\n598:      */\n599:     public boolean hasAnIcon() {\n600:         return true;\n601:     }\n602: }\n603: ",
