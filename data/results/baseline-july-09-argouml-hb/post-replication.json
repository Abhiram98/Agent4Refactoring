                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/persistence/ZargoFilePersister.java: \n1: // $Id$\n2: // Copyright (c) 1996-2005 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.persistence;\n26: \n27: import java.io.BufferedReader;\n28: import java.io.BufferedWriter;\n29: import java.io.File;\n30: import java.io.FileNotFoundException;\n31: import java.io.FileOutputStream;\n32: import java.io.FilterInputStream;\n33: import java.io.IOException;\n34: import java.io.InputStreamReader;\n35: import java.io.OutputStreamWriter;\n36: import java.io.PrintWriter;\n37: import java.io.Reader;\n38: import java.io.Writer;\n39: import java.net.URL;\n40: import java.util.ArrayList;\n41: import java.util.Collection;\n42: import java.util.Hashtable;\n43: import java.util.zip.ZipEntry;\n44: import java.util.zip.ZipInputStream;\n45: import java.util.zip.ZipOutputStream;\n46: \n47: import javax.swing.JProgressBar;\n48: import javax.swing.text.JTextComponent;\n49: \n50: import org.apache.log4j.Logger;\n51: import org.argouml.application.ArgoVersion;\n52: import org.argouml.kernel.Project;\n53: import org.argouml.kernel.ProjectMember;\n54: import org.argouml.uml.ProjectMemberModel;\n55: import org.argouml.uml.cognitive.ProjectMemberTodoList;\n56: import org.argouml.uml.diagram.ProjectMemberDiagram;\n57: import org.argouml.util.FileConstants;\n58: import org.tigris.gef.ocl.OCLExpander;\n59: import org.tigris.gef.ocl.TemplateReader;\n60: \n61: /**\n62:  * To persist to and from zargo (zipped file) storage.\n63:  *\n64:  * @author Bob Tarling\n65:  */\n66: public class ZargoFilePersister extends UmlFilePersister {\n67:     /**\n68:      * Logger.\n69:      */\n70:     private static final Logger LOG = Logger\n71:             .getLogger(ZargoFilePersister.class);\n72: \n73:     /**\n74:      * This is the old version of the ArgoUML tee file which does not contain\n75:      * the detail of member elements.\n76:      */\n77:     private static final String ARGO_MINI_TEE =\n78:         \"/org/argouml/persistence/argo.tee\";\n79: \n80:     /**\n81:      * The constructor.\n82:      */\n83:     public ZargoFilePersister() {\n84:     }\n85: \n86:     /**\n87:      * @see org.argouml.persistence.AbstractFilePersister#getExtension()\n88:      */\n89:     public String getExtension() {\n90:         return \"zargo\";\n91:     }\n92: \n93:     /**\n94:      * @see org.argouml.persistence.AbstractFilePersister#getDesc()\n95:      */\n96:     protected String getDesc() {\n97:         return \"ArgoUML compressed project file\";\n98:     }\n99: \n100:     /**\n101:      * It is being considered to save out individual xmi's from individuals\n102:      * diagrams to make it easier to modularize the output of Argo.\n103:      *\n104:      * @param file\n105:      *            The file to write.\n106:      * @param project\n107:      *            the project to save\n108:      * @throws SaveException\n109:      *             when anything goes wrong\n110:      *\n111:      * @see org.argouml.persistence.ProjectFilePersister#save(\n112:      *      org.argouml.kernel.Project, java.io.File)\n113:      */\n114:     public void doSave(Project project, File file) throws SaveException {\n115: \n116:         File lastArchiveFile = new File(file.getAbsolutePath() + \"~\");\n117:         File tempFile = null;\n118:         \n119:         try {\n120:             tempFile = createTempFile(file);\n121:         } catch (FileNotFoundException e) {\n122:             throw new SaveException(\n123:                     \"Failed to archive the previous file version\", e);\n124:         } catch (IOException e) {\n125:             throw new SaveException(\n126:                     \"Failed to archive the previous file version\", e);\n127:         }\n128: \n129:         BufferedWriter writer = null;\n130:         try {\n131: \n132:             project.setFile(file);\n133:             project.setVersion(ArgoVersion.getVersion());\n134:             project.setPersistenceVersion(PERSISTENCE_VERSION);\n135: \n136:             ZipOutputStream stream = new ZipOutputStream(new FileOutputStream(\n137:                     file));\n138:             writer = new BufferedWriter(\n139:                     new OutputStreamWriter(stream, \"UTF-8\"));\n140: \n141:             ZipEntry zipEntry = new ZipEntry(project.getBaseName()\n142:                     + FileConstants.UNCOMPRESSED_FILE_EXT);\n143:             stream.putNextEntry(zipEntry);\n144: \n145:             Hashtable templates = TemplateReader.getInstance().read(\n146:                     ARGO_MINI_TEE);\n147:             OCLExpander expander = new OCLExpander(templates);\n148:             expander.expand(writer, project);\n149: \n150:             writer.flush();\n151: \n152:             stream.closeEntry();\n153: \n154:             // First we save all objects that are not XMI objects i.e. the\n155:             // diagrams (first for loop).\n156:             // Then we save all XMI objects (second for loop).\n157:             // This is because order is important on saving.\n158:             // Bob - Why not do it the other way around? Surely\n159:             // when reloading it is better to load XMI first\n160:             // then the diagrams.\n161:             Collection names = new ArrayList();\n162:             int counter = 0;\n163:             int size = project.getMembers().size();\n164:             for (int i = 0; i < size; i++) {\n165:                 ProjectMember projectMember = (ProjectMember) project\n166:                         .getMembers().get(i);\n167:                 if (!(projectMember.getType().equalsIgnoreCase(\"xmi\"))) {\n168:                     if (LOG.isInfoEnabled()) {\n169:                         LOG.info(\"Saving member: \"\n170:                                 + ((ProjectMember) project.getMembers()\n171:                                         .get(i)).getZipName());\n172:                     }\n173:                     String name = projectMember.getZipName();\n174:                     String originalName = name;\n175:                     while (names.contains(name)) {\n176:                         name = ++counter + originalName;\n177:                     }\n178:                     names.add(name);\n179:                     stream.putNextEntry(new ZipEntry(name));\n180:                     MemberFilePersister persister = null;\n181:                     if (projectMember instanceof ProjectMemberDiagram) {\n182:                         persister = new DiagramMemberFilePersister();\n183:                     } else if (projectMember instanceof ProjectMemberTodoList) {\n184:                         persister = new TodoListMemberFilePersister();\n185:                     } else if (projectMember instanceof ProjectMemberModel) {\n186:                         persister = new ModelMemberFilePersister();\n187:                     }\n188:                     persister.save(projectMember, writer, null);\n189:                     writer.flush();\n190:                     stream.closeEntry();\n191:                 }\n192:             }\n193: \n194:             for (int i = 0; i < size; i++) {\n195:                 ProjectMember projectMember = (ProjectMember) project\n196:                         .getMembers().get(i);\n197:                 if (projectMember.getType().equalsIgnoreCase(\"xmi\")) {\n198:                     if (LOG.isInfoEnabled()) {\n199:                         LOG.info(\"Saving member of type: \"\n200:                                 + ((ProjectMember) project.getMembers()\n201:                                         .get(i)).getType());\n202:                     }\n203:                     stream.putNextEntry(\n204:                             new ZipEntry(projectMember.getZipName()));\n205:                     MemberFilePersister persister = null;\n206:                     if (projectMember instanceof ProjectMemberDiagram) {\n207:                         persister = new DiagramMemberFilePersister();\n208:                     } else if (projectMember instanceof ProjectMemberTodoList) {\n209:                         persister = new TodoListMemberFilePersister();\n210:                     } else if (projectMember instanceof ProjectMemberModel) {\n211:                         persister = new ModelMemberFilePersister();\n212:                     }\n213:                     persister.save(projectMember, writer, null);\n214:                 }\n215:             }\n216:             // if save did not raise an exception\n217:             // and name+\"#\" exists move name+\"#\" to name+\"~\"\n218:             // this is the correct backup file\n219:             if (lastArchiveFile.exists()) {\n220:                 lastArchiveFile.delete();\n221:             }\n222:             if (tempFile.exists() && !lastArchiveFile.exists()) {\n223:                 tempFile.renameTo(lastArchiveFile);\n224:             }\n225:             if (tempFile.exists()) {\n226:                 tempFile.delete();\n227:             }\n228:         } catch (Exception e) {\n229:             LOG.error(\"Exception occured during save attempt\", e);\n230:             try {\n231:                 writer.close();\n232:             } catch (IOException ex) {\n233:                 // Do nothing.\n234:             }\n235: \n236:             // frank: in case of exception\n237:             // delete name and mv name+\"#\" back to name if name+\"#\" exists\n238:             // this is the \"rollback\" to old file\n239:             file.delete();\n240:             tempFile.renameTo(file);\n241:             // we have to give a message to user and set the system to unsaved!\n242:             throw new SaveException(e);\n243:         }\n244: \n245:         try {\n246:             writer.close();\n247:         } catch (IOException ex) {\n248:             LOG.error(\"Failed to close save output writer\", ex);\n249:         }\n250:     }\n251: \n252:     /**\n253:      * @see org.argouml.persistence.ProjectFilePersister#doLoad(java.net.URL,\n254:      * javax.swing.JProgressBar, javax.swing.text.JTextComponent)\n255:      */\n256:     public Project doLoad(URL file, JProgressBar progressBar, JTextComponent progressText) throws OpenException {\n257:         try {\n258:             File file = File.createTempFile(\"combinedzargo_\", \".uml\");\n259:             LOG.info(\n260:                 \"Combining old style zargo sub files into new style uml file \"\n261:                     + file.getAbsolutePath());\n262:             file.deleteOnExit();\n263: \n264:             String encoding = \"UTF-8\";\n265:             FileOutputStream stream = new FileOutputStream(file);\n266:             PrintWriter writer = new PrintWriter(new BufferedWriter(\n267:                     new OutputStreamWriter(stream, encoding)));\n268: \n269:             writer.println(\"<?xml version = \\\"1.0\\\" \" + \"encoding = \\\"\"\n270:                     + encoding + \"\\\" ?>\");\n271: \n272:             // first read the .argo file from Zip\n273:             ZipInputStream zis;\n274:             String line;\n275:             BufferedReader reader;\n276: \n277:             zis = openZipStreamAt(file, FileConstants.PROJECT_FILE_EXT);\n278:             reader = new BufferedReader(new InputStreamReader(zis, encoding));\n279:             // Keep reading till we hit the <argo> tag\n280:             String rootLine;\n281:             while (!(rootLine = reader.readLine()).startsWith(\"<argo\")) {\n282:                 if (rootLine == null) {\n283:                     throw new OpenException(\n284:                             \"Can't find an <argo> tag in the argo file\");\n285:                 }\n286:             }\n287:             // Get the version from the tag.\n288:             String version = getVersion(rootLine);\n289:             writer.println(\"<uml version=\\\"\" + version + \"\\\">\");\n290:             writer.println(rootLine);\n291:             while ((line = reader.readLine()) != null) {\n292:                 writer.println(line);\n293:             }\n294:             zis.close();\n295:             reader.close();\n296: \n297:             // then the xmi\n298:             zis = openZipStreamAt(file, \".xmi\");\n299:             reader = new BufferedReader(new InputStreamReader(zis, encoding));\n300:             // Skip 1 lines\n301:             reader.readLine();\n302: \n303:             readerToWriter(reader, writer);\n304: \n305:             zis.close();\n306:             reader.close();\n307: \n308:             // Loop round loading the diagrams\n309:             zis = new ZipInputStream(file.openStream());\n310:             SubInputStream sub = new SubInputStream(zis);\n311: \n312:             ZipEntry currentEntry = null;\n313:             while ((currentEntry = sub.getNextEntry()) != null) {\n314:                 if (currentEntry.getName().endsWith(\".pgml\")\n315:                         || currentEntry.getName().endsWith(\".todo\")) {\n316: \n317:                     reader = new BufferedReader(\n318:                             new InputStreamReader(sub, encoding));\n319:                     // Skip 2 lines\n320:                     reader.readLine();\n321:                     reader.readLine();\n322:                     readerToWriter(reader, writer);\n323:                     sub.close();\n324:                     reader.close();\n325:                 }\n326:             }\n327:             zis.close();\n328: \n329:             writer.println(\"</uml>\");\n330:             writer.close();\n331:             LOG.info(\"Complated combining files\");\n332:             Project p = super.doLoad(file.toURL(), progressBar, progressText);\n333:             p.setURL(file);\n334:             return p;\n335:         } catch (IOException e) {\n336:             throw new OpenException(e);\n337:         }\n338:     }\n339: \n340:     private void readerToWriter(\n341:             Reader reader,\n342:             Writer writer) throws IOException {\n343: \n344:         int ch;\n345:         while ((ch = reader.read()) != -1) {\n346:             if (ch != 0xFFFF) {\n347:                 writer.write(ch);\n348:             } else {\n349:                 LOG.info(\"Stripping out 0xFFFF from XMI\");\n350:             }\n351:         }\n352:     }\n353: \n354:     /**\n355:      * Open a ZipInputStream to the first file found with a given extension.\n356:      *\n357:      * @param url\n358:      *            The URL of the zip file.\n359:      * @param ext\n360:      *            The required extension.\n361:      * @return the zip stream positioned at the required location.\n362:      * @throws IOException\n363:      *             if there is a problem opening the file.\n364:      */\n365:     private ZipInputStream openZipStreamAt(URL url, String ext)\n366:         throws IOException {\n367:         ZipInputStream zis = new ZipInputStream(url.openStream());\n368:         ZipEntry entry = zis.getNextEntry();\n369:         while (entry != null && !entry.getName().endsWith(ext)) {\n370:             entry = zis.getNextEntry();\n371:         }\n372:         return zis;\n373:     }\n374: \n375:     /**\n376:      * A stream of input streams for reading the Zipped file.\n377:      */\n378:     private class SubInputStream extends FilterInputStream {\n379:         private ZipInputStream in;\n380: \n381:         /**\n382:          * The constructor.\n383:          *\n384:          * @param z\n385:          *            the zip input stream\n386:          */\n387:         public SubInputStream(ZipInputStream z) {\n388:             super(z);\n389:             in = z;\n390:         }\n391: \n392:         /**\n393:          * @see java.io.InputStream#close()\n394:          */\n395:         public void close() throws IOException {\n396:             in.closeEntry();\n397:         }\n398: \n399:         /**\n400:          * Reads the next ZIP file entry and positions stream at the beginning\n401:          * of the entry data.\n402:          *\n403:          * @return the ZipEntry just read\n404:          * @throws IOException\n405:          *             if an I/O error has occurred\n406:          */\n407:         public ZipEntry getNextEntry() throws IOException {\n408:             return in.getNextEntry();\n409:         }\n410:     }\n411: }\n412: ",
