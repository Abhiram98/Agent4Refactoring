gouml.application.api.Pluggable#inContext(java.lang.Object[])\n97:      */\n98:     public boolean inContext(Object[] context) {\n99:         if (context.length < 2) {\n100:             return false;\n101:         }\n102:         if ((context[0] instanceof JMenuItem)\n103:             && (\"Tools\".equals(context[1]))) {\n104:             return true;\n105:         }\n106:         return false;\n107:     }\n108: \n109:     /**\n110:      * @see org.argouml.application.api.ArgoModule#initializeModule()\n111:      */\n112:     public boolean initializeModule() {\n113:         LOG.info(\"+---------------------------------+\");\n114:         LOG.info(\"| Export XMI plugin enabled!      |\");\n115:         LOG.info(\"+---------------------------------+\");\n116: \n117:         return true;\n118:     }\n119: \n120:     /**\n121:      * @see org.argouml.application.api.ArgoModule#shutdownModule()\n122:      */\n123:     public boolean shutdownModule() {\n124:         return true;\n125:     }\n126: \n127:     /**\n128:      * @see org.argouml.application.api.ArgoModule#setModuleEnabled(boolean)\n129:      */\n130:     public void setModuleEnabled(boolean tf) {\n131:     }\n132: \n133:     /**\n134:      * @see org.argouml.application.api.ArgoModule#isModuleEnabled()\n135:      */\n136:     public boolean isModuleEnabled() {\n137:         return true;\n138:     }\n139: \n140:     /**\n141:      * @see org.argouml.application.api.ArgoModule#getModuleName()\n142:      */\n143:     public String getModuleName() {\n144:         return \"Export as XMI\";\n145:     }\n146: \n147:     /**\n148:      * @see org.argouml.application.api.ArgoModule#getTabPanel()\n149:      */\n150:     public String getTabPanel() {\n151:         return \"A module to export a projectfile as XMI\";\n152:     }\n153: \n154:     /**\n155:      * @see org.argouml.application.api.ArgoModule#getModuleVersion()\n156:      */\n157:     public String getModuleVersion() {\n158:         return \"0.1\";\n159:     }