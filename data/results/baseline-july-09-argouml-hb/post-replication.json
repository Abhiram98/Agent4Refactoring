.argouml.uml.diagram.UmlDiagramRenderer;\n33: import org.argouml.uml.diagram.static_structure.ui.CommentEdge;\n34: import org.argouml.uml.diagram.static_structure.ui.FigComment;\n35: import org.argouml.uml.diagram.static_structure.ui.FigEdgeBody;\n36: import org.argouml.uml.diagram.ui.FigDependency;\n37: import org.argouml.uml.diagram.ui.FigGeneralization;\n38: import org.argouml.uml.diagram.ui.FigMessage;\n39: import org.tigris.gef.base.Layer;\n40: import org.tigris.gef.graph.GraphModel;\n41: import org.tigris.gef.presentation.FigEdge;\n42: import org.tigris.gef.presentation.FigNode;\n43: \n44: /**\n45:  * This class defines a renderer object for UML Collaboration Diagrams.\n46:  * In a collaboration Diagram the following UML objects are displayed with the\n47:  * following Figs:<p>\n48:  *\n49:  * <pre>\n50:  *   UML Object       ---  Fig\n51:  *   ---------------------------------------\n52:  *   MClassifierRole  ---  FigClassifierRole\n53:  *   MMessage         ---  FigMessage\n54:  *   MComment         ---  FigComment\n55:  * </pre>\n56:  *\n57:  * Provides {@link #getFigNodeFor} to implement the\n58:  * {@link org.tigris.gef.graph.GraphNodeRenderer} interface and\n59:  * {@link #getFigEdgeFor} to implement the\n60:  * {@link org.tigris.gef.graph.GraphEdgeRenderer} interface.<p>\n61:  *\n62:  * <em>Note</em>. Should be implemented as a singleton - we don't really\n63:  * need a separate instance for each use case diagram.<p>\n64:  *\n65:  *\n66:  * @author agauthie\n67:  */\n68: public class CollabDiagramRenderer extends UmlDiagramRenderer {\n69:     /**\n70:      * Logger.\n71:      */\n72:     private static final Logger LOG =\n73: \tLogger.getLogger(CollabDiagramRenderer.class);\n74: \n75:     /**\n76:      * Return a Fig that can be used to represent the given node.\n77:      *\n78:      * @see org.tigris.gef.graph.GraphNodeRenderer#getFigNodeFor(\n79:      *         org.tigris.gef.graph.GraphModel, org.tigris.gef.base.Layer,\n80:      *         java.lang.Object, java.util.Map)\n81:      */\n82:     public FigNode getFigNodeFor(GraphModel gm, Layer lay,\n83: \t\t\t\t Object node, Map styleAttributes) {\n84: \tif (Model.getFacade().isAClassifierRole(node)) {\n85: \t    return new FigClassifierRole(gm, lay, node);\n86: \t}\n87: \tif (Model.getFacade().isAMessage(node)) {\n88: \t    return new FigMessage(gm, lay, node);\n89: \t}\n90: \tif (Model.getFacade().isAComment(node)) {\n91:             return new FigComment(gm, node);\n92:         }\n93: \tLOG.debug(\"TODO: CollabDiagramRenderer getFigNodeFor\");\n94: \treturn null;\n95:     }\n96: \n97:     /**\n98:      * Return a Fig that can be used to represent the given edge,\n99:      * Generally the same code as for the ClassDiagram, since its\n100:      * very related to it.\n101:      *\n102:      * @see org.tigris.gef.graph.GraphEdgeRenderer#getFigEdgeFor(\n103:      * org.tigris.gef.graph.GraphModel,\n104:      * org.tigris.gef.base.Layer, java.lang.Object, java.util.Map)\n105:      */\n106:     public FigEdge getFigEdgeFor(GraphModel gm, Layer lay,\n107: \t\t\t\t Object edge, Map styleAttributes) {\n108: \tif (Model.getFacade().isAAssociationRole(edge)) {\n109: \t    FigAssociationRole asrFig = new FigAssociationRole(edge, lay);\n110: \t    return asrFig;\n111: \t} else\n112: \t    if (Model.getFacade().isAGeneralization(edge)) {\n113: \t\tFigGeneralization genFig = new FigGeneralization(edge, lay);\n114: \t\treturn genFig;\n115: \t    }\n116: \tif (Model.getFacade().isADependency(edge)) {\n117: \t    FigDependency depFig = new FigDependency(edge , lay);\n118: \t    return depFig;\n119: \t}\n120: \tif (edge instanceof CommentEdge) {\n121:             return new FigEdgeBody(edge, lay);\n122:         }\n123: \n124: \tLOG.debug(\"TODO: CollabDiagramRenderer getFigEdgeFor\");\n125: \treturn null;\n126:     }\n127: \n128: } /* end class CollabDiagramRenderer */\n129: ",
