    if (showUI) {\n1553:             JDialog dialog =\n1554:                 new ExceptionDialog(\n1555:                         ProjectBrowser.getInstance(),\n1556:                         message,\n1557:                         error);\n1558:             dialog.setVisible(true);\n1559:         } else {\n1560:             // TODO:  Does anyone use command line?\n1561:             // If so, localization is needed - tfm\n1562:             reportError(\"Please report the error below to the ArgoUML\"\n1563:                     + \"development team at http://argouml.tigris.org.\\n\"\n1564:                     + message + \"\\n\\n\" + error, showUI);\n1565:         }\n1566:     }\n1567: \n1568:     /**\n1569:      * Open a Message Dialog with an error message.\n1570:      *\n1571:      * @param message the message to display.\n1572:      * @param showUI true if an error message may be shown to the user,\n1573:      *               false if run in commandline mode\n1574:      * @param ex The exception that was thrown.\n1575:      */\n1576:     private void reportError(String message, boolean showUI, Throwable ex) {\n1577:         if (showUI) {\n1578:             JDialog dialog =\n1579:                 new ExceptionDialog(\n1580:                         ProjectBrowser.getInstance(),\n1581:                         message,\n1582:                         ex,\n1583:                         ex instanceof OpenException);\n1584:             dialog.setVisible(true);\n1585:         } else {\n1586:             StringWriter sw = new StringWriter();\n1587:             PrintWriter pw = new PrintWriter(sw);\n1588:             ex.printStackTrace(pw);\n1589:             String exception = sw.toString();\n1590:             // TODO:  Does anyone use command line?\n1591:             // If so, localization is needed - tfm\n1592:             reportError(\"Please report the error below to the ArgoUML\"\n1593:                     + \"development team at http://argouml.tigris.org.\\n\"\n1594:                     + message + \"\\n\\n\" + exception, showUI);\n1595:         }\n1596:     }\n1597: \n1598:     /**\n1599:      * We should remove all open dialogs. They have as parent the\n1600:      * ProjectBrowser. This is needed for the non-modal dialogs\n1601:      * such as Find and Goto.\n1602:      */\n1603:     public void clearDialogs() {\n1604:         Window[] windows = getOwnedWindows();\n1605:         for (int i = 0; i < windows.length; i++) {\n1606:             windows[i].dispose();\n1607:         }\n1608:         FindDialog.getInstance().doClearTabs();\n1609:         FindDialog.getInstance().doResetFields();\n1610:     }\n1611: \n1612:     /**\n1613:      * Get the action that can undo the last user interaction on this project.\n1614:      * @return the undo action.\n1615:      */\n1616:     public Action getUndoAction() {\n1617:         return undoAction;\n1618:     }\n1619: \n1620:     /**\n1621:      * Get the action that can redo the last undone action.\n1622:      * @return the redo action.\n1623:      */\n1624:     public Action getRedoAction() {\n1625:         return redoAction;\n1626:     }\n1627: \n1628:     /**\n1629:      * Get the action that can save the current project.\n1630:      * @return the save action.\n1631:      */\n1632:     public Action getSaveAction() {\n1633:         return saveAction;\n1634:     }\n1635: \n1636:     /**\n1637:      * Get the action that removes selected figs from the diagram.\n1638:      * @return the remove from diagram action.\n1639:      */\n1640:     public Action getRemoveFromDiagramAction() {\n1641:         return removeFromDiagram;\n1642:     }\n1643: \n1644:     /**\n1645:      * @return the File to save to\n1646:      */\n1647:     protected File getNewFile() {\n1648:         ProjectBrowser pb = ProjectBrowser.getInstance();\n1649:         Project p = ProjectManager.getManager().getCurrentProject();\n1650: \n1651:         JFileChooser chooser = null;\n1652:         URL url = p.getURL();\n1653:   