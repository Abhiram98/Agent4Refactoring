ception\n1139:             //(\"Cannot execute creator method\", entity, e);\n1140:             LOG.error(\"Failed to invoke create method on factory.\", e);\n1141:             return null;\n1142:         }\n1143:         UmlFactory.getFactory().initialize(obj);\n1144:         \n1145:         // Allow for testing of the proxy capability\n1146:         if (jmiProxyCreated) {\n1147:         \t// TODO: implement RefPackageProxy handling\n1148:         \t\n1149: \t\t\t// if (obj instanceof MPackage) {\n1150: \t\t\t//     return RefPackageProxy.newInstance(obj);\n1151: \t\t\t// }\n1152: \t\t\treturn RefBaseObjectProxy.newInstance(obj);\n1153:         }\n1154:         return obj;\n1155:     }\n1156: \n1157: }\n1158: \n1159: ",
