wer();\n4517:             }\n4518:             return lower;\n4519:         }\n4520:         if (isAMultiplicity(handle)) {\n4521:             MMultiplicity low = (MMultiplicity) handle;\n4522:             return low.getLower();\n4523:         }\n4524:         if (isAMultiplicityRange(handle)) {\n4525:             MMultiplicityRange low = (MMultiplicityRange) handle;\n4526:             return low.getLower();\n4527:         }\n4528:         illegalArgument(handle);\n4529: \treturn 0;\n4530:     }\n4531: \n4532:     /**\n4533:      * Returns the transitions belonging to the given handle. The handle can be\n4534:      * a statemachine or a composite state or an event.\n4535:      * If it's a statemachine the\n4536:      * transitions will be given back belonging to that statemachine. If it's a\n4537:      * compositestate the internal transitions of that compositestate will be\n4538:      * given back.\n4539:      * If it's an event, all transitions triggered by this event\n4540:      * will be given back.\n4541:      *\n4542:      * @param handle is the model element\n4543:      * @return Collection\n4544:      */\n4545:     public static Collection getTransitions(Object handle) {\n4546:         if (isAStateMachine(handle)) {\n4547:             return ((MStateMachine) handle).getTransitions();\n4548:         } else if (isACompositeState(handle)) {\n4549:             return ((MCompositeState) handle).getInternalTransitions();\n4550:         } else if (isAEvent(handle)) {\n4551:             return ((MEvent) handle).getTransitions();\n4552:         }\n4553: \treturn illegalArgumentCollection(handle);\n4554:     }\n4555: \n4556:     /**\n4557:      * This method returns all attributes of a given Classifier.\n4558:      *\n4559:      * @param handle is the classifier you want to have the attributes for.\n4560:      * @return a collection of the attributes\n4561:      */\n4562:     public static Collection getStructuralFeatures(Object handle) {\n4563:         Collection result = new ArrayList();\n4564:         if (ModelFacade.isAClassifier(handle)) {\n4565:             MClassifier mclassifier = (MClassifier) handle;\n4566: \n4567:             Iterator features = mclassifier.getFeatures().iterator();\n4568:             while (features.hasNext()) {\n4569:                 MFeature feature = (MFeature) features.next();\n4570:                 if (ModelFacade.isAStructuralFeature(feature)) {\n4571:                     result.add(feature);\n4572:                 }\n4573:             }\n4574:             return result;\n4575:         }\n4576: \treturn illegalArgumentCollection(handle);\n4577:     }\n4578: \n4579:     /**\n4580:      * This method returns all operations of a given Classifier.\n4581:      *\n4582:      * @param mclassifier the classifier you want to have the operations for\n4583:      * @return a collection of the operations\n4584:      */\n4585:     protected static Collection getOperations(MClassifier mclassifier) {\n4586:         Collection result = new ArrayList();\n4587:         Iterator features = mclassifier.getFeatures().iterator();\n4588:         while (features.hasNext()) {\n4589:             MFeature feature = (MFeature) features.next();\n4590:             if (ModelFacade.isAOperation(feature)) {\n4591:                 result.add(feature);\n4592:             }\n4593:         }\n4594:         return result;\n4595:     }\n4596: \n4597:     /**\n4598:      * Returns the Specification of a given Reception.\n4599:      *\n4600:      * @param handle the Reception\n4601:      * @return String the Specification\n4602:      */\n4603:     public static String getSpecification(Object handle) {\n4604:         if (handle instanceof MReception) {\n4605:             return ((MReception) handle).getSpecification();\n4606:         }\n4607:         return illegalArgumentString(handle);\n4608:     }\n4609: \n4610:     /**\n4611:      * Returns all Interfaces of which this class is a realization.\n4612:      *\n4613:      * @param handle  the class you want to have the interfaces for\n4614:      * @return a collection of the Interfaces\n4615:      */\n4616:     public static Collection getSpecifications(Object handle) {\n4617:         Collection result = new Vector();\n4618:         if (handle instanceof MAssociationEnd) {\n4619:             return ((MAssociationEnd) handle).getSpecifications();\n4620:         }\n4621:         if (handle instanceof MClassifier) {\n4622:             Collection deps = ((MClassifier) handle).getClientDependencies();\n4623:             Iterator depIterator = deps.iterator();\n4624:             while (depIterator.hasNext()) {\n4625:                 MDependency dep = (MDependency) depIterator.next();\n4626:                 if ((dep instanceof MAbstraction)\n4627:                         && dep.getStereotype() != null\n4628:                         && dep.getStereotype().getName() != null\n4629:                         && dep.getStereotype().getName().equals(\"realize\")) {\n4630:                     MInterface i =\n4631: \t\t\t(MInterface) dep.getSuppliers().toArray()[0];\n4632:                     result.add(i);\n4633:                 }\n4634:             }\n4635:             return result;\n4636:         }\n4637: \treturn illegalArgumentCollection(handle);\n4638:     }\n4639: \n4640:     /**\n4641:      * Returns the suppliers of a dependency.\n4642:      *\n4643:      * @param handle is the dependency\n4644:      * @return a collection of the suppliers\n4645:      */\n4646:     public static Collection getSuppliers(Object handle) {\n4647:         if (handle instanceof MDependency) {\n4648:             return ((MDependency) handle).getSuppliers();\n4649:         }\n4650: \treturn illegalArgumentCollection(handle);\n4651:     }\n4652: \n4653:     /**\n4654:      * Returns the action belonging to some message.\n4655:      *\n4656:      * @param handle is the message\n4657:      * @return the action\n4658:      */\n4659:     public static Object getAction(Object handle) {\n4660:         if (handle instanceof MMessage) {\n4661:             return ((MMessage) handle).getAction();\n4662:         }\n4663: \treturn illegalArgumentObject(handle);\n4664:     }\n4665: \n4666:     /**\n4667:      * Returns the activator belonging to some message.\n4668:      *\n4669:      * @param handle is the message\n4670:      * @return the activator\n4671:      */\n4672:     public static Object getActivator(Object handle) {\n4673:         if (handle instanceof MMessage) {\n4674:             return ((MMessage) handle).getActivator();\n4675:         }\n4676: \treturn illegalArgumentObject(handle);\n4677:     }\n4678: \n4679:     /**\n4680:      * Returns the actual arguments for a given action.\n4681:      *\n4682:      * @param handle is the action\n4683:      * @return the actual arguments\n4684:      */\n4685:     public static Collection getActualArguments(Object handle) {\n4686:         if (handle instanceof MAction) {\n4687:             return ((MAction) handle).getActualArguments();\n4688:         }\n4689: \treturn illegalArgumentCollection(handle);\n4690:     }\n4691: \n4692:     /**\n4693:      * Returns an addition for a given inlcude.\n4694:      * There is a bug in NSUML which gets the addition and base\n4695:      * relationships back to front for include relationships. Solve\n4696:      * reversing their accessors in the code\n4697:      *\n4698:      * @param handle is the include\n4699:      * @return the addition\n4700:      */\n4701:     public static Object getAddition(Object handle) {\n4702:         if (handle instanceof MInclude) {\n4703:             return ((MInclude) handle).getBase();\n4704:         }\n4705: \treturn illegalArgumentObject(handle);\n4706:     }\n4707: \n4708:     /**\n4709:      * Returns the AggregationKind of a given AssociationEnd.\n4710:      *\n4711:      * @param handle the AssociationEnd\n4712:      * @return the AggregationKind\n4713:      */\n4714:     public static Object getAggregation(Object handle) {\