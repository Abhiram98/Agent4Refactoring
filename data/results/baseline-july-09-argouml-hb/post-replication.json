loyment.ui;\n30: \n31: import java.awt.*;\n32: import java.awt.event.*;\n33: import java.util.*;\n34: import java.beans.*;\n35: import javax.swing.*;\n36: import javax.swing.event.*;\n37: import javax.swing.tree.*;\n38: import javax.swing.text.*;\n39: import javax.swing.border.*;\n40: import javax.swing.plaf.metal.MetalLookAndFeel;\n41: \n42: import ru.novosoft.uml.foundation.core.*;\n43: import ru.novosoft.uml.foundation.data_types.*;\n44: import ru.novosoft.uml.behavior.common_behavior.*;\n45: import ru.novosoft.uml.model_management.*;\n46: \n47: import org.tigris.gef.base.*;\n48: import org.tigris.gef.graph.*;\n49: \n50: import org.argouml.ui.*;\n51: import org.argouml.uml.ui.*;\n52: import org.argouml.uml.diagram.deployment.*;\n53: \n54: /** User interface panel shown at the bottom of the screen that allows\n55:  *  the user to edit the properties of the selected UML model\n56:  *  element. */\n57: \n58: public class PropPanelComponentInstance extends PropPanel \n59: implements ItemListener, DocumentListener {\n60: \n61:   ////////////////////////////////////////////////////////////////\n62:   // constants\n63:   // needs-more-work \n64: \n65:   ////////////////////////////////////////////////////////////////\n66:   // instance vars\n67:   JLabel _baseLabel = new JLabel(\"Base : \"); \n68:   JTextField _baseField = new JTextField(); \n69:   public JLabel _deploymentLocationLabel = new JLabel(\"Node-Instance: \");\n70:   public static JTextField _deploymentLocationField = new JTextField();\n71: \n72:   // declare and initialize all widgets\n73:   ////////////////////////////////////////////////////////////////\n74:   // contructors\n75:   public PropPanelComponentInstance() {\n76:     super(\"ComponentInstance Properties\");\n77:     _deploymentLocationField.setEditable(false);\n78:     GridBagLayout gb = (GridBagLayout) getLayout();\n79:     GridBagConstraints c = new GridBagConstraints();\n80:     c.fill = GridBagConstraints.BOTH;\n81:     c.weightx = 0.0;\n82:     c.ipadx = 0; c.ipady = 0;\n83: \n84: \n85:     c.gridx = 0;\n86:     c.gridwidth = 1;\n87:     c.gridy = 1; \n88:     c.weightx = 0.0; \n89:     gb.setConstraints(_baseLabel, c); \n90:     add(_baseLabel); \n91:     c.gridy = 2;\n92:     gb.setConstraints(_deploymentLocationLabel, c);\n93:     add(_deploymentLocationLabel);\n94:         \n95:     c.weightx = 1.0; \n96:     c.gridx = 1; \n97:     c.gridy = 1; \n98:     _baseField.setMinimumSize(new Dimension(120, 20)); \n99:     gb.setConstraints(_baseField, c); \n100:     add(_baseField); \n101:     _baseField.getDocument().addDocumentListener(this); \n102:     _baseField.setFont(_stereoField.getFont()); \n103:     c.gridy = 2;\n104:     _deploymentLocationField.setMinimumSize(new Dimension(120, 20));\n105:     gb.setConstraints(_deploymentLocationField, c);\n106:     add(_deploymentLocationField);\n107:     _deploymentLocationField.getDocument().addDocumentListener(this);\n108:     _deploymentLocationField.setFont(_stereoField.getFont());\n109: \n110:   }\n111: \n112:   ////////////////////////////////////////////////////////////////\n113:   // accessors\n114: \n115:   /** Set the values to be shown in all widgets based on model */\n116:   protected void setTargetInternal(Object t) {\n117:     super.setTargetInternal(t);\n118:     MComponentInstance coi = (MComponentInstance) t;\n119:     if (coi.getNodeInstance() != null) {\n120:       MNodeInstance node = (MNodeInstance) coi.getNodeInstance();\n121:       _deploymentLocationField.setText(node.getName());\n122:     }\n123:     else {\n124:       _deploymentLocationField.setText(null);\n125:     }\n126: \n127:     if (coi.getClassifiers() != null) { \n128:       String baseStr = \"\";\n129:       Collection classifiers = coi.getClassifiers(); \n130:       Iterator it = classifiers.iterator(); \n131:       while (it.hasNext()) { \n132:         Object o = it.next(); \n133:         if (o != null && (o instanceof MClassifier)) { \n134:           MClassifier cls = (MClassifier) o; \n135:           if (cls != null) { \n136:             baseStr = cls.getName();\n137:           } \n138:         } \n139:       } \n140:       _baseField.setText(baseStr);\n141:     }  \n142:     else { \n143:       _baseField.setText(null); \n144:     } \n145: \n146:     validate();\n147:   }\n148:   \n149:   public void setTargetBase() {  \n150:     if (_target == null) return;  \n151:     if (_inChange) return; \n152:   \n153:     MComponentInstance coi = (MComponentInstance) _target; \n154:     MComponent classifier = new MComponentImpl();  \n155:     String baseStr = _baseField.getText();\n156:     Collection col = coi.getClassifiers(); \n157:     if ((col != null) && (col.size()>0)) {  \n158:       Iterator itcol = col.iterator();  \n159:       while (itcol.hasNext()) {  \n160:         MClassifier cls = (MClassifier) itcol.next();  \n161:         coi.removeClassifier(cls);  \n162:       }  \n163:     }  \n164:  \n165:     Vector diagrams = ProjectBrowser.TheInstance.getProject().getDiagrams(); \n166:     GraphModel model = null; \n167:     Vector v = new Vector(); \n168:     int size = diagrams.size(); \n169:     for (int i=0; i<size; i++) { \n170:       Object o = diagrams.elementAt(i); \n171:       if (!(o instanceof Diagram)) continue; \n172:       if (o instanceof MModel) continue; \n173:       Diagram d = (Diagram) o; \n174:       model = d.getGraphModel();  \n175:  \n176:       if (!(model instanceof DeploymentDiagramGraphModel)) continue; \n177:         \n178:       Vector nodes = model.getNodes(); \n179:       int s = nodes.size(); \n180:       for (int j=0; j<s; j++) { \n181:         MModelElement node = (MModelElement) nodes.elementAt(j); \n182:         if (node != null && (node instanceof MComponentImpl)) { \n183:           MComponent mcomp = (MComponent) node; \n184:           if (mcomp.getNamespace() != coi.getNamespace()) continue;\n185:           String comp_name = mcomp.getName(); \n186:           if (comp_name != null && (comp_name.equals(baseStr))) {\n187:             v.addElement(mcomp); \n188:             coi.setClassifiers(v); \n189:             return;  \n190:           }       \n191:         } \n192:       } \n193:     } \n194:  \n195:     classifier.setName(baseStr);\n196:     v.addElement(classifier); \n197:     coi.setClassifiers(v); \n198:  \n199:     //System.out.println(\"needs-more-work: baseClass = \" + base);  \n200:     // needs-more-work: this could involve changes to the graph model  \n201:   }  \n202:  \n203: \n204:   ////////////////////////////////////////////////////////////////\n205:   // event handlers\n206: \n207: \n208:   /** The user typed some text */\n209:   public void insertUpdate(DocumentEvent e) {\n210:     //System.out.println(getClass().getName() + \" insert\");\n211:     // check if it was one of my text fields\n212:     super.insertUpdate(e);\n213:     if (e.getDocument() == _baseField.getDocument()) { \n214:       setTargetBase(); \n215:     } \n216:  }\n217: \n218:   public void removeUpdate(DocumentEvent e) { insertUpdate(e); }\n219: \n220:   public void changedUpdate(DocumentEvent e) {\n221:     System.out.println(getClass().getName() + \" changed\");\n222:     // Apparently, this method is never called.\n223:   }\n224: \n225:   /** The user modified one of the widgets */\n226:   public void itemStateChanged(ItemEvent e) {\n227:     Object src = e.getSource(); \n228:     // check for each widget, and update the model with new value \n229:     if (src == _baseField) { \n230:       setTargetBase(); \n231:     }\n232:   }\n233: \n234:   static final long serialVersionUID = 4536645723645617622L;\n235:   \n236: } /* end class PropPanelComponentInstance */\n237: \n238: \n239: \n240: ",
