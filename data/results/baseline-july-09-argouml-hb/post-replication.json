   null);\n899:         return assoc;\n900:     }\n901: \n902:     /**\n903:      * Builds a default attribute.\n904:      *\n905:      * @see org.argouml.model.CoreFactory#buildAttribute(java.lang.Object,\n906:      *         java.lang.Object)\n907:      */\n908:     public Object buildAttribute(Object model, Object theIntType) {\n909:         //build the default attribute\n910:         // this should not be here via the ProjectBrowser but the CoreHelper\n911:         // should provide this functionality\n912:         MClassifier intType = (MClassifier) theIntType;\n913: //        Project p = ProjectManager.getManager().getCurrentProject();\n914: //        MClassifier intType = (MClassifier) p.findType(\"int\");\n915:         if (model != intType.getNamespace()\n916:                 && !(nsmodel.getModelManagementHelper()\n917:                     .getAllNamespaces(model)\n918:         \t        .contains(intType.getNamespace()))) {\n919:             intType.setNamespace((MModel) model);\n920:         }\n921:         MAttribute attr = (MAttribute) createAttribute();\n922:         attr.setName(\"newAttr\");\n923:         attr.setMultiplicity(\n924:                 (MMultiplicity) nsmodel.getDataTypesFactory()\n925:                 \t.createMultiplicity(1, 1));\n926:         attr.setStereotype(null);\n927:         attr.setOwner(null);\n928:         attr.setType(intType);\n929:         attr.setInitialValue(null);\n930:         attr.setVisibility(MVisibilityKind.PUBLIC);\n931:         attr.setOwnerScope(MScopeKind.INSTANCE);\n932:         attr.setChangeability(MChangeableKind.CHANGEABLE);\n933:         attr.setTaggedValue(\"transient\", \"false\");\n934:         attr.setTaggedValue(\"volatile\", \"false\");\n935:         attr.setTargetScope(MScopeKind.INSTANCE);\n936: \n937:         return attr;\n938:     }\n939: \n940:     /**\n941:      * Builds an attribute owned by some classifier cls. I don't know\n942:      * if this is legal for an interface (purely UML speaking