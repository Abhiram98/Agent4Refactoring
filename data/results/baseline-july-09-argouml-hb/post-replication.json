PropertyVetoException;\n34: \n35: import javax.swing.Action;\n36: \n37: import org.apache.log4j.Logger;\n38: \n39: import org.argouml.kernel.ProjectManager;\n40: import org.argouml.model.ModelFacade;\n41: import org.argouml.model.uml.UmlModelEventPump;\n42: import org.argouml.ui.CmdCreateNode;\n43: import org.argouml.ui.CmdSetMode;\n44: import org.argouml.uml.diagram.state.StateDiagramGraphModel;\n45: import org.argouml.uml.diagram.ui.UMLDiagram;\n46: import org.argouml.uml.diagram.ui.ActionAddNote;\n47: \n48: import org.tigris.gef.base.LayerPerspective;\n49: import org.tigris.gef.base.LayerPerspectiveMutable;\n50: import org.tigris.gef.base.ModeCreatePolyEdge;\n51: \n52: import ru.novosoft.uml.MElementEvent;\n53: \n54: \n55: /** The correct name for this class is \"UMLStatechartDiagram\". See issue 2306.\n56:  *\n57:  */\n58: public class UMLStateDiagram extends UMLDiagram {\n59:     /** logger */\n60:     private static final Logger LOG = Logger.getLogger(UMLStateDiagram.class);\n61: \n62:     /**\n63:      * this diagram needs to be deleted when its statemachine is deleted.\n64:      */\n65:     Object theStateMachine;\n66: \n67:     ////////////////\n68:     // actions for toolbar\n69: \n70:     protected static Action _actionState =\n71:         new CmdCreateNode(ModelFacade.STATE, \"State\");\n72: \n73:     protected static Action _actionCompositeState =\n74:         new CmdCreateNode(ModelFacade.COMPOSITESTATE, \"CompositeState\");\n75: \n76:     // start state, end state, forks, joins, etc.\n77:     protected static Action _actionStartPseudoState =\n78:         new ActionCreatePseudostate(\n79:             ModelFacade.INITIAL_PSEUDOSTATEKIND,\n80:             \"Initial\");\n81: \n82:     protected static Action _actionFinalPseudoState =\n83:         new CmdCreateNode(ModelFacade.FINALSTATE, \"FinalState\");\n84: \n85:     protected static Action _actionBranchPseudoState =\n86:         new ActionCreatePseudostate(\n87:             ModelFacade.BRANCH_PSEUDOSTATEKIND, \"Choice\");\n88: \n89:     protected static Action _actionForkPseudoState =\n90:         new ActionCreatePseudostate(ModelFacade.FORK_PSEUDOSTATEKIND, \"Fork\");\n91: \n92:     protected static Action _actionJoinPseudoState =\n93:         new ActionCreatePseudostate(ModelFacade.JOIN_PSEUDOSTATEKIND, \"Join\");\n94: \n95:     protected static Action _actionShallowHistoryPseudoState =\n96:         new ActionCreatePseudostate(\n97:             ModelFacade.SHALLOWHISTORY_PSEUDOSTATEKIND,\n98:             \"ShallowHistory\");\n99: \n100:     protected static Action _actionDeepHistoryPseudoState =\n101:         new ActionCreatePseudostate(\n102:             ModelFacade.DEEPHISTORY_PSEUDOSTATEKIND,\n103:             \"DeepHistory\");\n104: \n105:     protected static Action _actionTransition =\n106:         new CmdSetMode(\n107:             ModeCreatePolyEdge.class,\n108:             \"edgeClass\",\n109:             ModelFacade.TRANSITION,\n110:             \"Transition\");\n111: \n112:     protected static Action _actionJunctionPseudoState =\n113:         new ActionCreatePseudostate(\n114:             ModelFacade.JUNCTION_PSEUDOSTATEKIND,\n115:             \"Junction\"); \n116: \n117:     protected static int stateDiagramSerial = 1;\n118:     \n119:     ////////////////////////////////////////////////////////////////\n120:     // contructors\n121: \n122:     /** \n123:      *  this constructor is used to build a dummy statechart diagram so\n124:      *  that a project will load properly.\n125:      */\n126:     public UMLStateDiagram() {\n127: \n128:         try {\n129:             setName(getNewDiagramName());\n130:         } catch (PropertyVetoException pve) { }\n131:     }\n132: \n133:     /** constructor \n134:      * @param namespace the NameSpace for the new diagram\n135:      * @param sm the StateMachine\n136:      */\n137:     public UMLStateDiagram(Object namespace, Object sm) {\n138:         this();\n139: \n140:         if (!ModelFacade.isAStateMachine(sm))\n141:             throw new IllegalArgumentException();\n142: \n143:         if (sm != null && namespace == null) {\n144:             Object context = ModelFacade.getContext(sm);\n145:             if (ModelFacade.isAClassifier(context)) {\n146:                 namespace = context;\n147:             } else if (ModelFacade.isABehavioralFeature(context)) {\n148:                 namespace = ModelFacade.getOwner(context);\n149:             }\n150:         }\n151:         if (namespace != null && ModelFacade.getName(namespace) != null) {\n152:             String name = null, diagramName = ModelFacade.getName(namespace);\n153:             int number =\n154:                 (ModelFacade.getBehaviors(namespace)) == null\n155:                     ? 0\n156:                     : ModelFacade.getBehaviors(namespace).size();\n157:             name = diagramName + \" \" + (number++);\n158:             LOG.info(\"UMLStateDiagram constructor: String name = \" + name);\n159:             try {\n160:                 setName(name);\n161:             } catch (PropertyVetoException pve) { }\n162:         }\n163:         if (namespace != null) {\n164:             setup(namespace, sm);\n165:         }\n166:     }\n167: \n168:     /**\n169:      * The owner of a statechart diagram is the statechart diagram\n170:      * it's showing.\n171:      * @see org.argouml.uml.diagram.ui.UMLDiagram#getOwner()\n172:      */\n173:     public Object getOwner() {\n174:         StateDiagramGraphModel gm = (StateDiagramGraphModel) getGraphModel();\n175:         return gm.getMachine();\n176:     }\n177: \n178:     /**\n179:      * Called by the PGML parser to initialize the statechart\n180:      * diagram. First the parser creates a statechart diagram via the\n181:      * default constructor. Then this method is called.\n182:      *\n183:      * @see org.tigris.gef.base.Diagram#initialize(Object)\n184:      */\n185:     public void initialize(Object o) {\n186:         if (ModelFacade.isAStateMachine(o)) {\n187:             Object sm = /*(MStateMachine)*/ o;\n188:             Object context = ModelFacade.getContext(sm);\n189:             Object contextNamespace = null;\n190:             if (ModelFacade.isAClassifier(context)) {\n191:                 contextNamespace = context;\n192:             } else if (ModelFacade.isABehavioralFeature(context)) {\n193:                 contextNamespace =\n194:                     ModelFacade.getNamespace(ModelFacade.getOwner(context));\n195:             }\n196:             if (contextNamespace != null) {\n197:                 setup(contextNamespace, sm);\n198:             }\n199:         } else {\n200:             throw new IllegalStateException(\n201:                 \"Cannot find context namespace \"\n202:                     + \"while initializing \"\n203:                     + \"statechart diagram\");\n204:         }\n205:     }\n206: \n207:     /** \n208:      * Method to perform a number of important initializations of a\n209:      * StateDiagram.<p>\n210:      * \n211:      * Each diagram type has a similar <I>UMLxxxDiagram</I> class.<p>\n212:      *\n213:      * Changed <I>lay</I> from <I>LayerPerspective</I> to\n214:      * <I>LayerPerspectiveMutable</I>.  This class is a child of\n215:      * <I>LayerPerspective</I> and was implemented to correct some\n216:      * difficulties in changing the model. <I>lay</I> is used mainly\n217:      * in <I>LayerManager</I>(GEF) to control the adding, changing and\n218:      * deleting layers on the diagram...\n219:      *\n220:      * @param namespace MClass from the model in NSUML...connects the class to\n221:      * the Statechart diagram.\n222:      * @param sm MStateMachine from the model in NSUML...\n223:      * @author psager@tigris.org Jan. 24, 2oo2\n224:      */\n225:     public void setup(Object namespace,\n226: \t\t      Object /*MStateMachine*/ sm) {\n227:         setNamespace(namespace);\n228: \n229:         // add the diagram as a listener to the statemachine so\n230:   