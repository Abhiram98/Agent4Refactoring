avDown = new ActionNavDown();\n77:   public static UMLAction NavBack = new ActionNavBack();\n78:   public static UMLAction NavForw = new ActionNavForw();\n79:   public static UMLAction NavFavs = new ActionNavFavs();\n80:   public static UMLAction NavConfig = new ActionNavConfig();\n81: \n82:   public static UMLAction Find = new ActionFind();\n83:   public static UMLAction GotoDiagram = new ActionGotoDiagram();\n84: \n85:   public static UMLAction NextEditTab = new ActionNextEditTab();\n86:   public static UMLAction AddToFavs = new ActionAddToFavs();\n87:   public static UMLAction NextDetailsTab = new ActionNextDetailsTab();\n88: \n89:   public static UMLAction CreateMultiple = new ActionCreateMultiple();\n90:   public static UMLAction ClassWizard = new ActionClassWizard();\n91: \n92:   //public static UMLAction Model = new ActionModel();\n93:   public static UMLAction ClassDiagram = new ActionClassDiagram();\n94:   public static UMLAction UseCaseDiagram = new ActionUseCaseDiagram();\n95:   public static UMLAction StateDiagram = new ActionStateDiagram();\n96:   public static UMLAction ActivityDiagram = new ActionActivityDiagram();\n97:   public static UMLAction CollaborationDiagram = new ActionCollaborationDiagram();\n98: \n99:   //public static UMLAction Class = new ActionClass();\n100:   //public static UMLAction Interface = new ActionInterface();\n101:   //public static UMLAction Actor = new ActionActor();\n102:   //public static UMLAction UseCase = new ActionUseCase();\n103:   //public static UMLAction State = new ActionState();\n104:   //public static UMLAction Pseudostate = new ActionPseudostate();\n105:   //public static UMLAction Package = new ActionPackage();\n106:   //public static UMLAction Instance = new ActionInstance();\n107:   public static UMLAction Attr = new ActionAttr();\n108:   public static UMLAction Oper = new ActionAddOperation();\n109:   public static UMLAction Message = new ActionMessage();\n110:   public static UMLAction InternalTransition = new ActionInternalTransition();\n111: \n112:   public static UMLAction GenerateOne = new ActionGenerateOne();\n113:   public static UMLAction GenerateAll = new ActionGenerateAll();\n114:   public static UMLAction GenerateWeb = new ActionGenerateWeb();\n115: \n116: \n117:   public static UMLAction AutoCritique = new ActionAutoCritique();\n118:   public static UMLAction OpenDecisions = new ActionOpenDecisions();\n119:   public static UMLAction OpenGoals = new ActionOpenGoals();\n120:   public static UMLAction OpenCritics = new ActionOpenCritics();\n121: \n122:   public static UMLAction FlatToDo = new ActionFlatToDo();\n123: \n124:   public static UMLAction NewToDoItem = new ActionNewToDoItem();\n125:   public static UMLAction Resolve = new ActionResolve();\n126:   public static UMLAction EmailExpert = new ActionEmailExpert();\n127:   public static UMLAction MoreInfo = new ActionMoreInfo();\n128:   public static UMLAction Snooze = new ActionSnooze();\n129: \n130:   public static UMLAction RecordFix = new ActionRecordFix();\n131:   public static UMLAction ReplayFix = new ActionReplayFix();\n132: \n133:   //   public static UMLAction FixItNext = new ActionFixItNext();\n134:   //   public static UMLAction FixItBack = new ActionFixItBack();\n135:   //   public static UMLAction FixItFinish = new ActionFixItFinish();\n136: \n137:   public static UMLAction AboutArgoUML = new ActionAboutArgoUML();\n138: \n139: \n140: \n141: \n142:   public static void updateAllEnabled() {\n143:     java.util.Enumeration actions = _allActions.elements();\n144:     while (actions.hasMoreElements()) {\n145:       UMLAction a = (UMLAction) actions.nextElement();\n146:       a.updateEnabled();\n147:     }\n148:   }\n149: \n150: }  /* end class Actions */\n151: \n152: \n153: class UMLChangeAction extends UMLAction {\n154: \n155:   public UMLChangeAction(String s) { super(s); }\n156: \n157:   public void actionPerformed(ActionEvent e) {\n158:     markNeedsSave();\n159:     Actions.updateAllEnabled();\n160:   }\n161: } /* end class UMLChangeAction */\n162: \n163: \n164: ////////////////////////////////////////////////////////////////\n165: // file menu actions\n166: \n167: class ActionNew extends UMLAction {\n168:   public ActionNew() { super(\"New...\"); }\n169:   public void actionPerformed(ActionEvent e) {\n170:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n171:     Project p = pb.getProject();\n172:     if (p != null) { // && p.getNeedsSave()) {\n173:       String t = \"Save changes to \" + p.getName();\n174:       int response =\n175: \tJOptionPane.showConfirmDialog(pb, t, t,\n176: \t\t\t\t      JOptionPane.YES_NO_CANCEL_OPTION);\n177:       if (response == JOptionPane.CANCEL_OPTION) return;\n178:       if (response == JOptionPane.YES_OPTION)\n179: \tif (!((ActionSave)Actions.Save).trySave()) return;\n180:       //needs-more-work: if you cancel the save it should cancel open\n181:     }\n182:     p = Project.makeEmptyProject();\n183:     pb.setProject(p);\n184:   }\n185: } /* end class ActionNew */\n186: \n187: class ActionOpen extends UMLAction {\n188:   public ActionOpen() { super(\"Open...\"); }\n189:   public void actionPerformed(ActionEvent e) {\n190:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n191:     Project p = pb.getProject();\n192:     if (p != null) { // && p.getNeedsSave()) {\n193:       String t = \"Save changes to \" + p.getName();\n194:       int response =\n195: \tJOptionPane.showConfirmDialog(pb, t, t,\n196: \t\t\t\t      JOptionPane.YES_NO_CANCEL_OPTION);\n197:       if (response == JOptionPane.CANCEL_OPTION) return;\n198:       if (response == JOptionPane.YES_OPTION)\n199: \tif (!((ActionSave)Actions.Save).trySave()) return;\n200:     }\n201: \n202:     Hashtable stats;\n203: \n204:     try {\n205:       JFileChooser chooser;\n206:       if (p != null && p.getPathname() != null && p.getPathname().length()>0) {\n207: \tSystem.out.println(\"open initial path=\" + p.getPathname());\n208: \tchooser = new JFileChooser(p.getPathname());\n209:       }\n210:       else chooser = new JFileChooser();\n211:       \n212:       chooser.setDialogTitle(\"Open Project...\");\n213:       FileFilter filter = FileFilters.ArgoFilter;\n214:       chooser.addChoosableFileFilter(filter);\n215:       chooser.setFileFilter(filter);\n216:       int retval = chooser.showOpenDialog(pb);\n217:       if(retval == 0) {\n218: \tFile theFile = chooser.getSelectedFile();\n219: \tif(theFile != null) {\n220: \t  String pathname = chooser.getSelectedFile().getAbsolutePath();\n221:     \tpb.showStatus(\"Reading \" + pathname + \"...\");\n222:     \tFileInputStream fis = new FileInputStream(pathname);\n223:     \tObjectInput s = new ObjectInputStream(fis);\n224: \tstats = (Hashtable) s.readObject();\n225:     \tp = (Project) s.readObject();\n226: \tp.postLoad();\n227: \tDocumentationManager._docs = (Hashtable) s.readObject();\n228: \tif (fis != null) fis.close();\n229:     \tpb.showStatus(\"Read \" + pathname);\n230: \tpb.setProject(p);\n231: \tp.setStats(stats);\n232: \treturn;\n233: \t}\n234:       }\n235:     }\n236: //     try {\n237: //       JFileChooser chooser = new JFileChooser();\n238: //       ArgoFileFilter filter = new ArgoFileFilter();\n239: //       chooser.addChoosableFileFilter(filter);\n240: //       chooser.setFileFilter(filter);\n241: //       int retval = chooser.showOpenDialog(pb);\n242: //       if(retval == 0) {\n243: // \tFile theFile = chooser.getSelectedFile();\n244: // \tif(theFile != null) {\n245: // \t  String pathname = chooser.getSelectedFile().getAbsolutePath();\n246: //     \tpb.showStatus(\"Reading \" + pathname + \"...\");\n247: //     \tFileInputStream fis = new FileInputStream(pathname);\n248: //     \tObjectInput s = new ObjectInputStream(fis);\n249: //     \tProject p = (Project) s.readObject();\n250: // \tp.postLoad();\n251: // \tif (fis != null) fis.close();\n252: //     \tpb.showStatus(\"Read \" + pathname);\n253: // \tpb.setProject(p);\n254: // \treturn;\n255: // \t}\n256: //       }\n257: //     }\n258:     catch (FileNotFoundException ignore) {\n259:       System.out.println(\"got an FileNotFoundException\");\n260:      }\n261:     catch (java.lang.ClassNotFoundException ignore) {\n262:       System.out.println(\"got an ClassNotFoundException\");\n263:      }\n264:     catch (IOException ignore) {\n265:       System.out.println(\"got an IOException\");\n266:     }\n267:   }\n268: } /* end class ActionOpen */\n269: \n270: class ActionOpenXMI extends UMLAction {\n271:   public ActionOpenXMI() { super(\"Open XMI...\"); }\n272:   public void actionPerformed(ActionEvent e) {\n273:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n274:     Project p = pb.getProject();\n275:     if (p != null) { // && p.getNeedsSave()) {\n276:       String t = \"Save changes to \" + p.getName();\n277:       int response =\n278: \tJOptionPane.showConfirmDialog(pb, t, t,\n279: \t\t\t\t      JOptionPane.YES_NO_CANCEL_OPTION);\n280:       if (response == JOptionPane.CANCEL_OPTION) return;\n281:       if (response == JOptionPane.YES_OPTION)\n282: \tif (!((ActionSave)Actions.Save).trySave()) return;\n283:     }\n284: \n285:     //    try {\n286:       JFileChooser chooser;\n287:       if (p != null && p.getPathname() != null && p.getPathname().length()>0) {\n288: \tSystem.out.println(\"open initial path=\" + p.getPathname());\n289: \tchooser = new JFileChooser(p.getPathname());\n290:       }\n291:       else chooser = new JFileChooser();\n292: \n293:       chooser.setDialogTitle(\"Open Project...\");\n294:       FileFilter filter = FileFilters.XMIFilter;\n295:       chooser.addChoosableFileFilter(filter);\n296:       chooser.setFileFilter(filter);\n297:       int retval = chooser.showOpenDialog(pb);\n298:       if(retval == 0) {\n299: \tFile theFile = chooser.getSelectedFile();\n300: \tif(theFile != null) {\n301: \t  String pathname = chooser.getSelectedFile().getAbsolutePath();\n302:     \tSystem.out.println(\"Reading \" + pathname + \"...\");\n303: \tpb.showStatus(\"Reading \" + pathname + \"...\");\n304: \tXMIParserIBM.SINGLETON.readModels(\"\", pathname);\n305: \t//p.postLoad();\n306:     \tpb.showStatus(\"Read \" + pathname);\n307: \t//p.setStats(stats);\n308: \treturn;\n309: \t}\n310:       }\n311: //     }\n312: //     catch (FileNotFoundException ignore) {\n313: //       System.out.println(\"got an FileNotFoundException\");\n314: //      }\n315: //     catch (java.lang.ClassNotFoundException ignore) {\n316: //       System.out.println(\"got an ClassNotFoundException\");\n317: //      }\n318: //     catch (IOException ignore) {\n319: //       System.out.println(\"got an IOException\");\n320: //     }\n321:   }\n322: } /* end class ActionOpenXMI */\n323: \n324: class ActionSave extends UMLAction {\n325:   protected static Hashtable _templates = new Hashtable();\n326: \n327:   static {\n328:     _templates = TemplateReader.readFile(\"/uci/dtd/XMI.tee\");\n329:   }\n330: \n331:   public ActionSave() { super(\"Save\"); }\n332:   public boolean shouldBeEnabled() {\n333:     Project p = ProjectBrowser.TheInstance.getProject();\n334:     return super.shouldBeEnabled() && p != null; // && p.getNeedsSave();\n335:   }\n336:   public void actionPerformed(ActionEvent ae) {\n337:     // needs-more-work: should just save\n338:     trySave();\n339:   }\n340:   public boolean trySave() {\n341:     // needs-more-work: should just save\n342:     return ((ActionSaveAs)Actions.SaveAs).trySave();\n343:   }\n344: } /* end class ActionSave */\n345: \n346: class ActionSaveAs extends UMLAction {\n347:   public ActionSaveAs() { super(\"Save As...\"); }\n348:   public boolean shouldBeEnabled() {\n349:     Project p = ProjectBrowser.TheInstance.getProject();\n350:     return super.shouldBeEnabled() && p != null;\n351:   }\n352:   public void actionPerformed(ActionEvent ae) {\n353:     trySave();\n354:   }\n355: \n356:   public boolean trySave() {\n357:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n358:     Project p =  pb.getProject();\n359:     try {\n360:       JFileChooser chooser;\n361:       if (p != null && p.getPathname() != null && p.getPathname().length()>0) {\n362: \tchooser  = new JFileChooser(p.getPathname());\n363:       }\n364:       else chooser = new JFileChooser();\n365: \n366:       chooser.setDialogTitle(\"Save \" + p.getName());\n367:       FileFilter filter = FileFilters.ArgoFilter;\n368:       chooser.addChoosableFileFilter(filter);\n369:       chooser.setFileFilter(filter);\n370:       Hashtable stats = p.getStats();\n371: \n372:       int retval = chooser.showSaveDialog(pb);\n373:       if(retval == 0) {\n374: \tFile theFile = chooser.getSelectedFile();\n375: \tif (theFile != null) {\n376: \t  String pathname = chooser.getSelectedFile().getAbsolutePath();\n377: \t  pb.showStatus(\"Writing \" + pathname + \"...\");\n378: \t  p.setPathname(chooser.getSelectedFile().getParent());\n379: \t  String name = chooser.getSelectedFile().getName();\n380: \t  if (!name.endsWith(\".argo\")) name += \".argo\";\n381: \t  if (!pathname.endsWith(\".argo\")) pathname += \".argo\";\n382: \t  p.setName(name);\n383: \t  FileOutputStream fos = new FileOutputStream(pathname);\n384: \t  ObjectOutput oo = new ObjectOutputStream(fos);\n385: \t  p.preSave();\n386: \t  oo.writeObject(stats);\n387: \t  oo.writeObject(p);\n388: \t  oo.writeObject(DocumentationManager._docs);\n389: \t  p.postSave();\n390: \t  if (fos != null) fos.close();\n391: \t  pb.showStatus(\"Wrote \" + pathname);\n392: \t  pb.updateTitle();\n393: \t  return true;\n394: \t}\n395:       }\n396:     }\n397: //     try {\n398: //       JFileChooser chooser = new JFileChooser();\n399: //       ArgoFileFilter filter = new ArgoFileFilter();\n400: //       chooser.addChoosableFileFilter(filter);\n401: //       chooser.setFileFilter(filter);\n402: //       int retval = chooser.showSaveDialog(pb);\n403: //       if(retval == 0) {\n404: // \tFile theFile = chooser.getSelectedFile();\n405: // \tif (theFile != null) {\n406: // \t  String pathname = chooser.getSelectedFile().getAbsolutePath();\n407: // \t  pb.showStatus(\"Writing \" + pathname + \"...\");\n408: // \t  FileOutputStream fos = new FileOutputStream(pathname);\n409: // \t  ObjectOutput oo = new ObjectOutputStream(fos);\n410: // \t  p.preSave();\n411: // \t  oo.writeObject(p);\n412: // \t  p.postSave();\n413: // \t  if (fos != null) fos.close();\n414: // \t  pb.showStatus(\"Wrote \" + pathname);\n415: // \t  return true;\n416: // \t}\n417: //       }\n418: //     }\n419:     catch (FileNotFoundException ignore) {\n420:       System.out.println(\"got an FileNotFoundException\");\n421:     }\n422:     catch (PropertyVetoException ignore) {\n423:       System.out.println(\"got an PropertyVetoException in SaveAs\");\n424:     }\n425: //     catch (PropertyVetoException ignore) {\n426: //       System.out.println(\"got an PropertyVetoException\");\n427: //     }\n428:     //    catch (java.lang.ClassMismatchException ignore) {\n429:     //      System.out.println(\"got an ClassMismatchException\");\n430:     //    }\n431:     catch (IOException ignore) {\n432:       System.out.println(\"got an IOException\");\n433:       ignore.printStackTrace();\n434:     }\n435:     return false;\n436:   }\n437: } /* end class ActionSaveAS */\n438: \n439: class ActionSaveAsXMI extends UMLAction {\n440:   protected static OCLExpander expander = null;\n441:   public ActionSaveAsXMI() {\n442:     super(\"Save As XMI\");\n443:     Hashtable templates = TemplateReader.readFile(\"/uci/dtd/XMI.tee\");\n444:     expander = new OCLExpander(templates);\n445:   }\n446:   public boolean shouldBeEnabled() {\n447:     Project p = ProjectBrowser.TheInstance.getProject();\n448:     return super.shouldBeEnabled() && p != null;\n449:   }\n450:   public void actionPerformed(ActionEvent e) {\n451:     trySave();\n452:   }\n453: \n454:   public boolean trySave() {\n455:     //@@@: just for rapid edig-compile-debug \n456:     Hashtable templates = TemplateReader.readFile(\"/uci/dtd/XMI.tee\");\n457:     expander = new OCLExpander(templates);\n458: \n459:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n460:     Project p =  pb.getProject();\n461:     try {\n462:       JFileChooser chooser;\n463:       if (p != null && p.getPathname() != null && p.getPathname().length()>0) {\n464: \tchooser  = new JFileChooser(p.getPathname());\n465:       }\n466:       else chooser = new JFileChooser();\n467: \n468:       chooser.setDialogTitle(\"Save \" + p.getName());\n469:       FileFilter filter = FileFilters.XMIFilter;\n470:       chooser.addChoosableFileFilter(filter);\n471:       chooser.setFileFilter(filter);\n472:       Hashtable stats = p.getStats();\n473: \n474:       int retval = chooser.showSaveDialog(pb);\n475:       if(retval == 0) {\n476: \tFile theFile = chooser.getSelectedFile();\n477: \tif (theFile != null) {\n478: \t  String pathname = chooser.getSelectedFile().getAbsolutePath();\n479: \t  pb.showStatus(\"Writing \" + pathname + \"...\");\n480: \t  p.setPathname(chooser.getSelectedFile().getParent());\n481: \t  String name = chooser.getSelectedFile().getName();\n482: \t  if (!name.endsWith(\".xmi\")) name += \".xmi\";\n483: \t  if (!pathname.endsWith(\".xmi\")) pathname += \".xmi\";\n484: \t  p.setName(name);\n485: \t  FileWriter fw = new FileWriter(pathname);\n486: \t  p.preSave();\n487: \t  expander.expand(fw, p, \"\", \"\");\n488: \t  p.postSave();\n489: \t  fw.close();\n490: \t  pb.showStatus(\"Wrote \" + pathname);\n491: \t  pb.updateTitle();\n492: \t  return true;\n493: \t}\n494:       }\n495:     }\n496:     catch (FileNotFoundException ignore) {\n497:       System.out.println(\"got an FileNotFoundException\");\n498:     }\n499:     catch (PropertyVetoException ignore) {\n500:       System.out.println(\"got an PropertyVetoException in SaveAs\");\n501:     }\n502: //     catch (PropertyVetoException ignore) {\n503: //       System.out.println(\"got an PropertyVetoException\");\n504: //     }\n505:     //    catch (java.lang.ClassMismatchException ignore) {\n506:     //      System.out.println(\"got an ClassMismatchException\");\n507:     //    }\n508:     catch (IOException ignore) {\n509:       System.out.println(\"got an IOException\");\n510:       ignore.printStackTrace();\n511:     }\n512:     return false;\n513:   }\n514: } /* end class ActionSaveAsXMI */\n515: \n516: class ActionPrint extends UMLAction {\n517:   public ActionPrint() { super(\"Print...\"); }\n518:   public boolean shouldBeEnabled() {\n519:     Project p = ProjectBrowser.TheInstance.getProject();\n520:     return super.shouldBeEnabled() && p != null;\n521:   }\n522:   public void actionPerformed(ActionEvent ae) {\n523:     CmdPrint cmd = new CmdPrint();\n524:     Object target = ProjectBrowser.TheInstance.getTarget();\n525:     if (target instanceof Diagram) {\n526:       String n = ((Diagram)target).getName();\n527:       cmd.setDiagramName(n);\n528:       cmd.doIt();\n529:     }\n530:   }\n531: } /* end class ActionPrint */\n532: \n533: class ActionAddToProj extends UMLAction {\n534:   public ActionAddToProj() { super(\"Add To Project...\"); }\n535:   public boolean shouldBeEnabled() {\n536:     Project p = ProjectBrowser.TheInstance.getProject();\n537:     return super.shouldBeEnabled() && p != null;\n538:   }\n539: } /* end class ActionAddToProj */\n540: \n541: class ActionExit extends UMLAction {\n542:   public ActionExit() { super(\"Exit\"); }\n543: \n544:   public void actionPerformed(ActionEvent ae) {\n545:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n546:     Project p = pb.getProject();\n547:     if (p != null) { // && p.getNeedsSave()) {\n548:       String t = \"Save changes to \" + p.getName();\n549:       int response =\n550: \tJOptionPane.showConfirmDialog(pb, t, t,\n551: \t\t\t\t      JOptionPane.YES_NO_CANCEL_OPTION);\n552:       if (response == JOptionPane.CANCEL_OPTION) return;\n553:       if (response == JOptionPane.YES_OPTION)\n554: \tif (!((ActionSave)Actions.Save).trySave()) return;\n555:     }\n