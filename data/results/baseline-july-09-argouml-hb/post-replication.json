eption;\n32: import java.util.StringTokenizer;\n33: import java.util.Vector;\n34: \n35: import org.apache.log4j.Logger;\n36: import org.argouml.application.api.Notation;\n37: import org.argouml.kernel.Project;\n38: import org.argouml.kernel.ProjectManager;\n39: import org.argouml.model.ModelFacade;\n40: import org.argouml.model.uml.ActivityGraphsFactory;\n41: import org.argouml.model.uml.ActivityGraphsHelper;\n42: import org.argouml.model.uml.CommonBehaviorFactory;\n43: import org.argouml.model.uml.CoreFactory;\n44: import org.argouml.model.uml.CoreHelper;\n45: import org.argouml.model.uml.DataTypesFactory;\n46: import org.argouml.model.uml.ExtensionMechanismsFactory;\n47: import org.argouml.model.uml.ExtensionMechanismsHelper;\n48: import org.argouml.model.uml.ModelManagementHelper;\n49: import org.argouml.model.uml.StateMachinesHelper;\n50: import org.argouml.model.uml.UmlFactory;\n51: import org.argouml.ui.targetmanager.TargetManager;\n52: import org.argouml.uml.ProfileJava;\n53: import org.argouml.uml.generator.GeneratorDisplay.MsgPtr;\n54: import org.argouml.util.MyTokenizer;\n55: \n56: import ru.novosoft.uml.model_management.MModel;\n57: \n58: \n59: /**\n60:  * Interface specifying the operation to take when a PropertySpecialString is\n61:  * matched.\n62:  * \n63:  * @author Michael Stockman\n64:  * @since 0.11.2\n65:  * @see PropertySpecialString\n66:  */\n67: interface PropertyOperation {\n68:     /**\n69:      * Invoked by PropertySpecialString when it has matched a property name.\n70:      * \n71:      * @param element\n72:      *            The element on which the property was set.\n73:      * @param value\n74:      *            The value of the property, may be null if no value was given.\n75:      */\n76:     public void found(Object element, String value);\n77: }\n78: \n79: /**\n80:  * Declares a string that should take special action when it is found as a\n81:  * property in {@link ParserDisplay#setProperties ParserDisplay.setProperties}.\n82:  * \n83:  * <p>\n84:  * <b>Example: </b>\n85:  * \n86:  * <pre>\n87:  * attributeSpecialStrings[0] = new PropertySpecialString(&quot;frozen&quot;,\n88:  *         new PropertyOperation() {\n89:  *             public void found(Object element, String value) {\n90:  *                 if (ModelFacade.isAStructuralFeature(element))\n91:  *                     ModelFacade.setChangeable(element, \n92:  *                          (value != null &amp;&amp; value\n93:  *                             .equalsIgnoreCase(&quot;false&quot;)));\n94:  *             }\n95:  *         });\n96:  * </pre>\n97:  * \n98:  * <p>\n99:  * Taken from the ParserDisplay constructor. It creates a PropertySpecialString\n100:  * that is invoken when the String \"frozen\" is found as a property name. Then\n101:  * the found mehod in the anonymous inner class defined on the 2nd line is\n102:  * invoked and performs a custom action on the element on which the property was\n103:  * specified by the user. In this case it does a setChangeability on an\n104:  * attribute instead of setting a tagged value, which would not have the desired\n105:  * effect.\n106:  * \n107:  * @author Michael Stockman\n108:  * @since 0.11.2\n109:  * @see PropertyOperation\n110:  * @see ParserDisplay#setProperties\n111:  */\n112: class PropertySpecialString {\n113:     private String name;\n114: \n115:     private PropertyOperation op;\n116: \n117:     /**\n118:      * Constructs a new PropertySpecialString that will invoke the\n119:      * action in op when {@link #invoke(Object, String, String)} is\n120:      * called with name equal to str and then return true from invoke.\n121:      * \n122:      * @param str\n123:      *            The name of this PropertySpecialString.\n124:      * @param propop\n125:      *            An object containing the method to invoke on a match.\n126:      */\n127:     public PropertySpecialString(String str, PropertyOperation propop) {\n128:         name = str;\n129:         op = propop;\n130:     }\n131: \n132:     /**\n133:      * Called by {@link ParserDisplay#setProperties(Object, Vector,\n134:      * PropertySpecialString[])} while searching for an action to\n135:      * invoke for a property. If it returns true, then setProperties\n136:      * may assume that all required actions have been taken and stop\n137:      * searching.\n138:      * \n139:      * @param pname\n140:      *            The name of a property.\n141:      * @param value\n142:      *            The value of a property.\n143:      * @return <tt>true</tt> if an action is performed, otherwise\n144:      *         <tt>false</tt>.\n145:      */\n146:     public boolean invoke(Object element, String pname, String value) {\n147:         if (!name.equalsIgnoreCase(pname))\n148:             return false;\n149:         op.found(element, value);\n150:         return true;\n151:     }\n152: }\n153: \n154: /**\n155:  * This class is responsible for the parsing of the text that the user entered\n156:  * on the display, i.e. the diagram. Consequently, the UML elements represented\n157:  * by the text are created or adapted.<p>\n158:  * \n159:  * There is a certain relation in namegiving with the class GeneratorDisplay,\n160:  * which generates a textual representation of UML elements for displaying on\n161:  * diagrams.\n162:  * \n163:  * @stereotype singleton\n164:  */\n165: \n166: public class ParserDisplay extends Parser {\n167:     /** The one and only ParserDisplay */\n168:     public static final ParserDisplay SINGLETON = new ParserDisplay();\n169: \n170:     /**\n171:      * The standard error etc. logger\n172:      */\n173:     private static final Logger LOG = Logger.getLogger(ParserDisplay.class);\n174: \n175:     /** The array of special properties for attributes */\n176:     private PropertySpecialString attributeSpecialStrings[];\n177: \n178:     /** The vector of CustomSeparators to use when tokenizing attributes */\n179:     private Vector attributeCustomSep;\n180: \n181:     /** The array of special properties for operations */\n182:     private PropertySpecialString operationSpecialStrings[];\n183: \n184:     /** The vector of CustomSeparators to use when tokenizing attributes */\n185:     private Vector operationCustomSep;\n186: \n187:     /** The vector of CustomSeparators to use when tokenizing parameters */\n188:     private Vector parameterCustomSep;\n189: \n190:     /**\n191:      * The character with a meaning as a visibility at the start of an attribute\n192:      */\n193:     private static final String VISIBILITYCHARS = \"+#-\";\n194: \n195:     /**\n196:      * Constructs the object contained in SINGLETON and initializes some\n197:      * instance variables.\n198:      * \n199:      * @see #SINGLETON\n200:      */\n201:     private ParserDisplay() {\n202:         attributeSpecialStrings = new PropertySpecialString[2];\n203:         attributeSpecialStrings[0] = new PropertySpecialString(\"frozen\",\n204:                 new PropertyOperation() {\n205:                 public void found(Object element, String value) {\n206:                     if (ModelFacade.isAStructuralFeature(element)) {\n207:                         if (\"false\".equalsIgnoreCase(value)) {\n208:                             ModelFacade.setChangeability(element,\n209:                                         ModelFacade.CHANGEABLE_CHANGEABLEKIND);\n210:                         } else {\n211:                             ModelFacade.setChangeability(element,\n212:                                         ModelFacade.FROZEN_CHANGEABLEKIND);\n213:                         }\n214:                     }\n215:                 }\n216:             });\n217:         attributeSpecialStrings[1] = new PropertySpecialString(\"addonly\",\n218:                 new PropertyOperation() {\n219:                 public void found(Object element, String value) {\n220:                     if (ModelFacade.isAStructuralFeature(element)) {\n221:                         if (\"false\".equalsIgnoreCase(value)) {\n222:                             ModelFacade.setChangeability(element,\n223:                                         ModelFacade.CHANGEABLE_CHANGEABLEKIND);\n224:                         } else {\n225:                             ModelFacade.setChangeability(element,\n226:                                         ModelFacade.ADD_ONLY_CHANGEABLEKIND);\n227:                         }\n228:                     }\n229:                 }\n230:             });\n231:         attributeCustomSep = new Vector();\n232:         attributeCustomSep.add(MyTokenizer.SINGLE_QUOTED_SEPARATOR);\n233:         attributeCustomSep.add(MyTokenizer.DOUBLE_QUOTED_SEPARATOR);\n234:         attributeCustomSep.add(MyTokenizer.PAREN_EXPR_STRING_SEPARATOR);\n235: \n236:         operationSpecialStrings = new PropertySpecialString[8];\n237:         operationSpecialStrings[0] = new PropertySpecialString(\"sequential\",\n238:                 new PropertyOperation() {\n239:                 public void found(Object element, String value) {\n240:                     if (ModelFacade.isAOperation(element)) {\n241:                         ModelFacade.setConcurrency(element,\n242:                                     ModelFacade.SEQUENTIAL_CONCURRENCYKIND);\n243:                     }\n244:                 }\n245:             });\n246:         operationSpecialStrings[1] = new PropertySpecialString(\"guarded\",\n247:                 new PropertyOperation() {\n248:                 public void found(Object element, String value) {\n249:                     Object kind = ModelFacade.GUARDED_CONCURRENCYKIND;\n250:                     if (value != null && value.equalsIgnoreCase(\"false\"))\n251:                             kind = ModelFacade.SEQUENTIAL_CONCURRENCYKIND;\n252:                     if (ModelFacade.isAOperation(element))\n253:                             ModelFacade.setConcurrency(element, kind);\n254:                 }\n255:             });\n256:         operationSpecialStrings[2] = new PropertySpecialString(\"concurrent\",\n257:                 new PropertyOperation() {\n258:                 public void found(Object element, String value) {\n259:                     Object kind = ModelFacade.CONCURRENT_CONCURRENCYKIND;\n260:                     if (value != null && value.equalsIgnoreCase(\"false\"))\n261:                             kind = ModelFacade.SEQUENTIAL_CONCURRENCYKIND;\n262:                     if (ModelFacade.isAOperation(element))\n263:                             ModelFacade.setConcurrency(element, kind);\n264:                 }\n265:             });\n266:         operationSpecialStrings[3] = new PropertySpecialString(\"concurrency\",\n267:                 new PropertyOperation() {\n268:                 public void found(Object element, String value) {\n269:                     Object kind = ModelFacade.SEQUENTIAL_CONCURRENCYKIND;\n270:                     if (\"guarded\".equalsIgnoreCase(value))\n271:                             kind = ModelFacade.GUARDED_CONCURRENCYKIND;\n272:                     else if (\"concurrent\".equalsIgnoreCase(value))\n273:                             kind = ModelFacade.CONCURRENT_CONCURRENCYKIND;\n274:                     if (ModelFacade.isAOperation(element))\n275:                             ModelFacade.setConcurrency(element, kind);\n276:                 }\n277:             });\n278:         operationSpecialStrings[4] = new PropertySpecialString(\"abstract\",\n279:                 new PropertyOperation() {\n280:                 public void found(Object element, String value) {\n281:                     boolean isAbstract = true;\n282:                     if (value != null && value.equalsIgnoreCase(\"false\")) {\n283:                         isAbstract = false;\n284:                     }\n285:                     if (ModelFacade.isAOperation(element)) {\n286:                         ModelFacade.setAbstract(element, isAbstract);\n287:                     }\n288:                 }\n289:             });\n290:         operationSpecialStrings[5] = new PropertySpecialString(\"leaf\",\n291:                 new PropertyOperation() {\n292:                 public void found(Object element, String value) {\n293:                     boolean isLeaf = true;\n294:                     if (value != null && value.equalsIgnoreCase(\"false\")) {\n295:                         isLeaf = false;\n296:                     }\n297:                     if (ModelFacade.isAOperation(element)) {\n298:                         ModelFacade.setLeaf(element, isLeaf);\n299:                     }\n300:                 }\n301:             });\n302:         operationSpecialStrings[6] = new PropertySpecialString(\"query\",\n303:                 new PropertyOperation() {\n304:                 public void found(Object element, String value) {\n305:                     boolean isQuery = true;\n306:                     if (value != null && value.equalsIgnoreCase(\"false\"))\n307:                             isQuery = false;\n308:                     if (ModelFacade.isABehavioralFeature(element))\n309:                             ModelFacade.setQuery(element, isQuery);\n310:                 }\n311:             });\n312:         operationSpecialStrings[7] = new PropertySpecialString(\"root\",\n313:                 new PropertyOperation() {\n314:                 public void found(Object element, String value) {\n315:                     boolean isRoot = true;\n316:                     if (value != null && value.equalsIgnoreCase(\"false\"))\n317:                             isRoot = false;\n318:                     if (ModelFacade.isAOperation(element))\n319:                             ModelFacade.setRoot(element, isRoot);\n320:                 }\n321:             });\n322:         operationCustomSep = new Vector();\n323:         operationCustomSep.add(MyTokenizer.SINGLE_QUOTED_SEPARATOR);\n324:         operationCustomSep.add(MyTokenizer.DOUBLE_QUOTED_SEPARATOR);\n325:         operationCustomSep.add(MyTokenizer.PAREN_EXPR_STRING_SEPARATOR);\n326: \n327:         parameterCustomSep = new Vector();\n328:         parameterCustomSep.add(MyTokenizer.SINGLE_QUOTED_SEPARATOR);\n329:         parameterCustomSep.add(MyTokenizer.DOUBLE_QUOTED_SEPARATOR);\n330:         parameterCustomSep.add(MyTokenizer.PAREN_EXPR_STRING_SEPARATOR);\n331:     }\n332: \n333:     ////////////////////////////////////////////////////////////////\n334:     // parsing methods\n335: \n336:     /**\n337:      * Parse an extension point.<p>\n338:      * \n339:      * The syntax is \"name: location\", \"name:\", \"location\" or \"\". The fields of\n340:      * the extension point are updated appropriately.\n341:      * \n342:      * @param useCase The use case that owns this extension point\n343:      * @param ep      The extension point concerned\n344:      * @param text    The text to parse\n345:      */\n346:     public void parseExtensionPointFig(Object useCase, Object ep, String text) {\n347: \n348:         // We can do nothing if we don't have both the use case and extension\n349:         // point.\n350: \n351:         if ((useCase == null) || (ep == null)) {\n352:             return;\n353:         }\n354: \n355:         // Parse the string to creat a new extension point.\n356: \n357:         Object newEp = parseExtensionPoint(text);\n358: \n359:         // If we got back null we interpret this as meaning delete the\n360:         // reference to the extension point from the use case, otherwise we set\n361:         // the fields of the extension point to the values in newEp.\n362: \n363:         if (newEp == null) {\n364:             ModelFacade.removeExtensionPoint(useCase, ep);\n365:         } else {\n366:             ModelFacade.setName(ep, ModelFacade.getName(newEp));\n367:             ModelFacade.setLocation(ep, ModelFacade.getLocation(newEp));\n368:         }\n369:     }\n370: \n371:     /**\n372:      * Parses a model element, ie reads a string on the format: <br>\n373:      *     [ << stereotype >>] [name] \n374:      * <br> and assigns the properties to the passed MModelElement.\n375:      * \n376:      * @param me   The MModelElement <i>text </i> describes.\n377:      * @param text A String on the above format.\n378:      * @throws ParseException\n379:      *             when it detects an error in the attribute string. See also\n380:      *             ParseError.getErrorOffset().\n381:      */\n382:     public void parseModelElement(Object/* MModelElement */me, String text)\n383:         throws ParseException {\n384:         MyTokenizer st;\n385: \n386:         Vector path = null;\n387:         String name = null;\n388:         String stereotype = null;\n389:         String token;\n390: \n391:         try {\n392:             st = new MyTokenizer(text, \"<<,>>,::\");\n393:             while (st.hasMoreTokens()) {\n394:                 token = st.nextToken();\n395: \n396:                 if (\"<<\".equals(token)) {\n397:                     if (stereotype != null)\n398:                         throw new ParseException(\"Element cannot have \"\n399:                                 + \"two stereotypes\", st.getTokenIndex());\n400: \n401:                     stereotype = \"\";\n402:                     while (true) {\n403:                         token = st.nextToken();\n404:                         if (\">>\".equals(token))\n405:                             break;\n406:                         stereotype += token;\n407:                     }\n408:                 } else if (\"::\".equals(token)) {\n409:                     if (name != null)\n410:                         name = name.trim();\n411: \n412:                     if (path != null && (name == null || \"\".equals(name)))\n413:                         throw new ParseException(\"Element cannot have \"\n414:                                 + \"anonymous qualifiers\", st.getTokenIndex());\n415: \n416:                     if (path == null)\n417:                         path = new Vector();\n418:                     if (name != null)\n419:                         path.add(name);\n420:                     name = null;\n421:                 } else {\n422:                     if (name != null)\n423:                         throw new ParseException(\"Element cannot have \"\n424:                                 + \"two word names or qualifiers\", st\n425:                                 .getTokenIndex());\n426: \n427:                     name = token;\n428:                 }\n429:             }\n430:         } catch (NoSuchElementException nsee) {\n431:             throw new ParseException(\"Unexpected end of element\", \n432:                     text.length());\n433:         } catch (ParseException pre) {\n434:             throw pre;\n435:         }\n436: \n437:         if (name != null)\n438:             name = name.trim();\n439: \n440:         if (path != null && (name == null || \"\".equals(name)))\n441:             throw new ParseException(\"Qualified names must end with a name\", 0);\n442: \n443:         if (name != null)\n444:             ModelFacade.setName(me, name);\n445: \n446:         if (stereotype != null) {\n447:             stereotype = stereotype.trim();\n448:             Object stereo = getStereotype(me, stereotype);\n449: \n450:             if (stereo != null)\n451:                 ModelFacade.setStereotype(me, stereo);\n452:             else if (\"\".equals(stereotype))\n453:                 ModelFacade.setStereotype(me, null);\n454:         }\n455: \n456:         if (path != null) {\n457:             Object nspe = ModelManagementHelper.getHelper().getElement(path,\n458:                     ModelFacade.getModel(me));\n459: \n460:             if (nspe == null || !(ModelFacade.isANamespace(nspe)))\n461:                 throw new ParseException(\"Unable to resolve namespace\", 0);\n462:             Object model = ProjectManager.getManager().getCurrentProject().getRoot();\n463:             if (!CoreHelper.getHelper().getAllPossibleNamespaces(me, model).contains(\n464:                     nspe))\n465:                 throw new ParseException(\"Invalid namespace for element\", 0);\n466: \n467:             ModelFacade.addOwnedElement(nspe, me);\n468:         }\n469:     }\n470: \n471:     /**\n472:      * Checks for ';' in Strings or chars in ';' separated tokens in order to\n473:      * return an index to the next attribute or operation substring, -1\n474:      * otherwise (a ';' inside a String or char delimiters is ignored)\n475:      */\n476:     private int indexOfNextCheckedSemicolon(String s, int start) {\n477:         if (s == null || start < 0 || start >= s.length())\n478:             return -1;\n479:         int end;\n480:         boolean inside = false;\n481:         boolean backslashed = false;\n482:         char c;\n483:         for (end = start; end < s.length(); end++) {\n484:             c = s.charAt(end);\n485:             if (!inside && c == ';') {\n486:                 return end;\n487:             } else if (!backslashed && (c == '\\'' || c == '\\\"')) {\n488:                 inside = !inside;\n489:             }\n490:             backslashed = (!backslashed && c == '\\\\');\n491:         }\n492:         return end;\n493:     }\n494: \n495:     /**\n496:      * Parse a string representing one ore more ';' separated operations. The\n497:      * case that a String or char contains a ';' (e.g. in an initializer) is\n498:      * handled, but not other occurences of ';'.\n499:      * \n500:      * @param cls  Classifier The classifier the operation(s) belong to\n501:      * @param op   Operation The operation on which the editing happened\n502:      * @param text The string to parse\n503:      * @throws ParseException for invalid input\n504:      */\n505:     public void parseOperationFig(Object cls, Object op, String text)\n506:         throws ParseException {\n507:         if (cls == null || op == null) {\n508:             return;\n509:         }\n510:         ParseException pex = null;\n511:         int start = 0;\n512:         int end = indexOfNextCheckedSemicolon(text, start);\n513:         if (end == -1) {\n514:             //no text? remove op!\n515:             ProjectManager.getManager().getCurrentProject().moveToTrash(op);\n516:             TargetManager.getInstance().setTarget(cls);\n517:             return;\n518:         }\n519:         String s = text.substring(start, end).trim();\n520:         if (s == null || s.length() == 0) {\n521:             //no non-whitechars in text? remove op!\n522:             ProjectManager.getManager().getCurrentProject().moveToTrash(op);\n523:             TargetManager.getInstance().setTarget(cls);\n524:             return;\n525:         }\n526:         parseOperation(s, op);\n527:         int i = new ArrayList(ModelFacade.getFeatures(cls)).indexOf(op);\n528:         // check for more operations (';' separated):\n529:         start = end + 1;\n530:         end = indexOfNextCheckedSemicolon(text, start);\n531:         while (end > start && end <= text.length()) {\n532:             s = text.substring(start, end).trim();\n533:             if (s != null && s.length() > 0) {\n534:                 // yes, there are more:\n535:                 Object newOp = UmlFactory.getFactory().getCore()\n536:                         .buildOperation(cls);\n537:                 if (newOp != null) {\n538:                     try {\n539:                         parseOperation(s, newOp);\n540:                         //newOp.setOwnerScope(op.getOwnerScope()); //\n541:                         //not needed in case of operation\n542:                         if (i != -1) {\n543:                             ModelFacade.addFeature(cls, ++i, newOp);\n544:                         } else {\n545:                             ModelFacade.addFeature(cls, newOp);\n546:                         }\n547:                     } catch (ParseException ex) {\n548:                         if (pex == null)\n549:                             pex = ex;\n550:                     }\n551:                 }\n552:             }\n553:             start = end + 1;\n554:             end = indexOfNextCheckedSemicolon(text, start);\n555:         }\n556:         if (pex != null)\n557:             throw pex;\n558:     }\n559: \n560:     /**\n561:      * Parse a string representing one ore more ';' separated attributes. The\n562:      * case that a String or char contains a ';' (e.g. in an initializer) is\n563:      * handled, but not other occurences of ';'.\n564:      * \n565:      * @param cls  Classifier The classifier the attribute(s) belong to\n566:      * @param at   Attribute The attribute on which the editing happened\n567:      * @param text The string to parse\n568:      * @throws ParseException for invalid input\n569:      */\n570:     public void parseAttributeFig(Object cls, Object at, String text)\n571:         throws ParseException {\n572:         if (cls == null || at == null) {\n573:             return;\n574:         }\n575:         ParseException pex = null;\n576:         int start = 0;\n577:         int end = indexOfNextCheckedSemicolon(text, start);\n578:         if (end == -1) {\n579:             //no text? remove attr!\n580:             ProjectManager.getManager().getCurrentProject().moveToTrash(at);\n581:             TargetManager.getInstance().setTarget(cls);\n582:             return;\n583:         }\n584:         String s = text.substring(start, end).trim();\n585:         if (s == null || s.length() == 0) {\n586:             //no non-whitechars in text? remove attr!\n587:             ProjectManager.getManager().getCurrentProject().moveToTrash(at);\n588:             TargetManager.getInstance().setTarget(cls);\n589:             return;\n590:         }\n591:         parseAttribute(s, at);\n592:         int i = new ArrayList(ModelFacade.getFeatures(cls)).indexOf(at);\n593:         // check for more attributes (';' separated):\n594:         start = end + 1;\n595:         end = indexOfNextCheckedSemicolon(text, start);\n596:         while (end > start && end <= text.length()) {\n597:             s = text.substring(start, end).trim();\n598:             if (s != null && s.length() > 0) {\n599:                 // yes, there are more:\n600:                 Object newAt = UmlFactory.getFactory().getCore()\n601:                         .buildAttribute();\n602:                 if (newAt != null) {\n603:                     try {\n604:                         parseAttribute(s, newAt);\n605:                         ModelFacade.setOwnerScope(newAt, ModelFacade\n606:                                 .getOwnerScope(at));\n607:                         if (i != -1) {\n608:                             ModelFacade.addFeature(cls, ++i, newAt);\n609:                         } else {\n610:                             ModelFacade.addFeature(cls, newAt);\n611:                         }\n612:                     } catch (ParseException ex) {\n613:                         if (pex == null)\n614:                             pex = ex;\n615:                     }\n616:                 }\n617:             }\n618:             start = end + 1;\n619:             end = indexOfNextCheckedSemicolon(text, start);\n620:         }\n621:         if (pex != null)\n622:             throw pex;\n623:     }\n624: \n625:     /**\n626:      * Parse a string representing an extension point and return a new extension\n627:      * point.<p>\n628:      *\n629:      * The syntax is \"name: location\", \"name:\", \"location\" or \"\". <em>Note</em>.\n630:      * If either field is blank, it will be set to null in the extension point.\n631:      * \n632:      * <p>\n633:      * We break up the string into tokens at the \":\". We must keep the \":\" as a\n634:      * token, so we can distinguish between \"name:\" and \"location\". The number\n635:      * of tokens will distinguish our four cases.\n636:      * <p>\n637:      * \n638:      * TODO: This method needs to be replaced, since it by design cannot cope\n639:      * with the current design of the model component.\n640:      * \n641:      * @param text The string to parse\n642:      * \n643:      * @return A new extension point, with fields set appropriately, or\n644:      *         <code>null</code> if we are given <code>null</code> or a\n645:      *         blank string. <em>Note</em>. The string \":\" can be used to set\n646:      *         both name and location to null.\n647:      *\n648:      * @see org.argouml.uml.generator.Parser#parseExtensionPoint(java.lang.String)\n649:      */\n650:     public Object parseExtensionPoint(String text) {\n651: \n652:         // If we are given the null string, return immediately\n653: \n654:         if (text == null) {\n655:             return null;\n656:         }\n657: \n658:         // Build a new extension point\n659: \n660:         // This method has insufficient information to call buildExtensionPoint.\n661:         // Thus we'll need to create one, and pray that whomever called us knows\n662:         // what kind of mess they got.\n663:         Object ep = UmlFactory.getFactory().getUseCases()\n664:                 .createExtensionPoint();\n665: \n666:         StringTokenizer st = new StringTokenizer(text.trim(), \":\", true);\n667:         int numTokens = st.countTokens();\n668: \n669:         String epLocation;\n670:         String epName;\n671: \n672:         switch (numTokens) {\n673: \n674:         case 0:\n675: \n676:             // The empty string. Return null\n677: \n678:             ep = null;\n679: \n680:             break;\n681: \n682:         case 1:\n683: \n684:             // A string of the form \"location\". This will be confused by the\n685:             // string \":\", so we pick this out as an instruction to clear both\n686:             // name and location.\n687: \n688:             epLocation = st.nextToken().trim();\n689: \n690:             if (epLocation.equals(\":\")) {\n691:                 ModelFacade.setName(ep, null);\n692:                 ModelFacade.setLocation(ep, null);\n693:             } else {\n694:                 ModelFacade.setName(ep, null);\n695:                 ModelFacade.setLocation(ep, epLocation);\n696:             }\n697: \n698:             break;\n699: \n700:         case 2:\n701: \n702:             // A string of the form \"name:\"\n703: \n704:             epName = st.nextToken().trim();\n705: \n706:             ModelFacade.setName(ep, epName);\n707:             ModelFacade.setLocation(ep, null);\n708: \n709:             break;\n710: \n711:         case 3:\n712: \n713:             // A string of the form \"name:location\". Discard the middle token\n714:             // (\":\")\n715: \n716:             epName = st.nextToken().trim();\n717:             st.nextToken(); // Read past the colon.\n718:             epLocation = st.nextToken().trim();\n719: \n720:             ModelFacade.setName(ep, epName);\n721:             ModelFacade.setLocation(ep, epLocation);\n722: \n723:             break;\n724:         }\n725: \n726:         return ep;\n727:     }\n728: \n729:     /**\n730:      * Parse a line of text and aligns the MOperation to the specification\n731:      * given. The line should be on the following form:\n732:      * \n733:      * <br>\n734:      * visibility name (parameter list) : return-type-expression\n735:      * {property-string}\n736:      * \n737:      * <p>\n738:      * All elements are optional and, if left unspecified, will preserve their\n739:      * old values. <br>\n740:      * A <b>stereotype </b> can be given between any element in the line on the\n741:      * form: &lt;&lt;stereotype&gt;&gt;\n742:      * \n743:      * <p>\n744:      * The following properties are recognized to have special meaning:\n745:      * abstract, concurrency, concurrent, guarded, leaf, query, root and\n746:      * sequential.\n747:      * \n748:      * <p>\n749:      * This syntax is compatible with the UML 1.3 spec.\n750:      * \n751:      * (formerly visibility name (parameter list) : return-type-expression\n752: