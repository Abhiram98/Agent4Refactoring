33: import javax.swing.SwingUtilities;\n34: \n35: import org.argouml.model.Model;\n36: import org.argouml.model.RemoveAssociationEvent;\n37: import org.tigris.gef.base.Editor;\n38: import org.tigris.gef.base.Globals;\n39: import org.tigris.gef.base.Layer;\n40: import org.tigris.gef.graph.GraphEdgeRenderer;\n41: import org.tigris.gef.graph.GraphModel;\n42: import org.tigris.gef.graph.MutableGraphModel;\n43: import org.tigris.gef.presentation.Fig;\n44: import org.tigris.gef.presentation.FigDiamond;\n45: import org.tigris.gef.presentation.FigEdge;\n46: import org.tigris.gef.presentation.FigText;\n47: \n48: /**\n49:  * Class to display graphics for N-ary association (association node).\n50:  *\n51:  * @author pepargouml@yahoo.es\n52:  */\n53: public class FigNodeAssociation extends FigNodeModelElement {\n54: \n55:     ////////////////////////////////////////////////////////////////\n56:     // constants\n57: \n58:     /**\n59:      * The serialVersionUID (generated by Eclipse for rev. 1.15)\n60:      */\n61:     private static final long serialVersionUID = -821467628639654711L;\n62:     \n63:     private static final int X = 0;\n64:     private static final int Y = 0;\n65: \n66:     ////////////////////////////////////////////////////////////////\n67:     // instance variables\n68: \n69:     private FigDiamond head;\n70: \n71: \n72:     /**\n73:      * The constructor.\n74:      */\n75:     public FigNodeAssociation() {\n76:         setEditable(false);\n77:         setBigPort(new FigDiamond(0, 0, 70, 70, Color.cyan, Color.cyan));\n78:         head = new FigDiamond(0, 0, 70, 70, Color.black, Color.white);\n79:         // Add the following to allow name editing on the diagram\n80:         setNameFig(new FigText(X + 10, Y + 22, 0, 21, true));\n81:         getNameFig().setFilled(false);\n82:         getNameFig().setLineWidth(0);\n83:         getNameFig().setFont(getLabelFont());\n84:         getNameFig().setTextColor(Color.black);\n85:         getNameFig().setReturnAction(FigText.END_EDITING);\n86:         getNameFig().setTabAction(FigText.END_EDITING);\n87:         getNameFig().setJustificationByName(\"center\");\n88: \n89:         getStereotypeFig().setBounds(X + 10, Y + 22, 0, 21);\n90:         getStereotypeFig().setFilled(false);\n91:         getStereotypeFig().setLineWidth(0);\n92: \n93:         // add Figs to the FigNode in back-to-front order\n94:         addFig(getBigPort());\n95:         addFig(head);\n96:         addFig(getNameFig());\n97:         addFig(getStereotypeFig());\n98: \n99:         setBlinkPorts(false); //make port invisble unless mouse enters\n100:         Rectangle r = getBounds();\n101:         setBounds(r);\n102:         setResizable(true);\n103:     }\n104: \n105:     /**\n106:      * The constructor.\n107:      *\n108:      * @param gm the graphmodel\n109:      * @param node the owner (UML association)\n110:      */\n111:     public FigNodeAssociation(GraphModel gm, Object node) {\n112:         this();\n113:         setOwner(node);\n114:     }\n115: \n116:     /**\n117:      * @see java.lang.Object#clone()\n118:      */\n119:     public Object clone() {\n120:         FigNodeAssociation figClone = (FigNodeAssociation) super.clone();\n121:         Iterator it = figClone.getFigs().iterator();\n122:         figClone.setBigPort((FigDiamond) it.next());\n123:         figClone.head = (FigDiamond) it.next();\n124:         figClone.setNameFig((FigText) it.next());\n125:         return figClone;\n126:     }\n127: \n128: \n129:     /**\n130:      * Used when a n-ary association becomes a binary association.\n131:      *\n132:      * @param mee the event\n133:      */\n134:     protected void modelChanged(PropertyChangeEvent mee) {\n135:         super.modelChanged(mee);\n136:         if (mee == null || mee.getPropertyName().equals(\"isAbstract\")) {\n137:             updateAbstract();\n138:             damage();\n139:         }\n140:         if (mee.getPropertyName().equals(\"connection\")) {\n141:             if (mee instanceof RemoveAssociationEvent) {\n142:                 Object association =\n143:                     ((RemoveAssociationEvent) mee).getSource();\n144:                 if (Model.getFacade().getConnections(association).size()\n145:                         == 2) {\n146:                     reduceToBinary();\n147:                 }\n148:             }\n149:         }\n150:     }\n151: \n152:     /**\n153:      * When association end nr 3 is removed, \n154:      * from the model (OR from the diagram?), \n155:      * reduce this to a binary association.\n156:      */\n157:     void reduceToBinary() {\n158:         final Object association = getOwner();\n159:         final Fig oldNodeFig = this;\n160:         SwingUtilities.invokeLater(new Runnable() {\n161:             public void run() {\n162:                 oldNodeFig.setOwner(null);\n163:                 FigEdge figEdge = null;\n164:                 Editor editor = Globals.curEditor();\n165:                 GraphModel gm = editor.getGraphModel();\n166:                 GraphEdgeRenderer renderer =\n167:                     editor.getGraphEdgeRenderer();\n168:                 Layer lay = editor.getLayerManager().getActiveLayer();\n169:                 figEdge =\n170:                     renderer.getFigEdgeFor(gm, lay, association, null);\n171:                 editor.add(figEdge);\n172:                 if (gm instanceof MutableGraphModel) {\n173:                     MutableGraphModel mutableGraphModel =\n174:                         (MutableGraphModel) gm;\n175:                     mutableGraphModel.removeNode(association);\n176:                     mutableGraphModel.addEdge(association);\n177:                 }\n178:                 oldNodeFig.removeFromDiagram();\n179:                 editor.getSelectionManager().deselectAll();\n180:                 editor.damageAll();\n181:             }\n182:         });\n183:     }\n184:     \n185:     /**\n186:      * Updates the name if modelchanged receives an \"isAbstract\" event.\n187:      */\n188:     protected void updateAbstract() {\n189:         Rectangle rect = getBounds();\n190:         if (getOwner() == null) {\n191:             return;\n192:         }\n193:         Object assoc =  getOwner();\n194:         if (Model.getFacade().isAbstract(assoc)) {\n195:             getNameFig().setFont(getItalicLabelFont());\n196:         } else {\n197:             getNameFig().setFont(getLabelFont());\n198:         }\n199:         super.updateNameText();\n200:         setBounds(rect.x, rect.y, rect.width, rect.height);\n201:     }\n202: \n203:     /**\n204:      * Makes sure that the edges stick to the outline of the fig.\n205:      * @see org.tigris.gef.presentation.Fig#getGravityPoints()\n206:      */\n207:     public List getGravityPoints() {\n208:         return getBigPort().getGravityPoints();\n209:     }\n210: \n211:     /**\n212:      * @see org.tigris.gef.presentation.Fig#setLineColor(java.awt.Color)\n213:      */\n214:     public void setLineColor(Color col) {\n215:         head.setLineColor(col);\n216:     }\n217: \n218:     /**\n219:      * @see org.tigris.gef.presentation.Fig#getLineColor()\n220:      */\n221:     public Color getLineColor() {\n222:         return head.getLineColor();\n223:     }\n224: \n225:     /**\n226:      * @see org.tigris.gef.presentation.Fig#setFillColor(java.awt.Color)\n227:      */\n228:     public void setFillColor(Color col) {\n229:         head.setFillColor(col);\n230:     }\n231: \n232:     /**\n233:      * @see org.tigris.gef.presentation.Fig#getFillColor()\n234:      */\n235:     public Color getFillColor() {\n236:         return head.getFillColor();\n237:     }\n238: \n239:     /**\n240:      * @see org.tigris.gef.presentation.Fig#setFilled(boolean)\n241:      */\n242:     public void setFilled(boolean f) {\n243:     }\n244: \n245:     /**\n246:      * @see org.tigris.gef.presentation.Fig#getFilled()\n247:      */\n248:     public boolean getFilled() {\n249:         return true;\n250:     }\n25