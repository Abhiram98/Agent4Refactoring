s.put(Diagram.class, new PropPanelDiagram());\n83:     // FigText has no owner, so we do it directly\n84:     _panels.put(FigText.class, new PropPanelString());\n85:     _panels.put(MModelImpl.class, new PropPanelModel());\n86:     _panels.put(MUseCaseImpl.class, new PropPanelUseCase());\n87: \n88: \n89: \torg.argouml.application.Main.addPostLoadAction(new InitPanelsLater(_panels));\n90:   }\n91: \n92: \n93:   ////////////////////////////////////////////////////////////////\n94:   // accessors\n95: \tpublic void setTarget(Object t) {\n96: \t\t_target = t;\n97: \t\tif (_lastPanel != null) remove(_lastPanel);\n98: \t\tif (t == null) {\n99: \t\t\tadd(_blankPanel, BorderLayout.NORTH);\n100: \t\t\t_shouldBeEnabled = false;\n101: \t\t\t_lastPanel = _blankPanel;\n102: \t\t\treturn;\n103: \t\t}\n104: \t\t_shouldBeEnabled = true;\n105: \t\tTabModelTarget newPanel = null;\n106: \t\tClass targetClass = t.getClass();\n107: \t\twhile (targetClass != null && newPanel == null) {\n108: \t\t\tnewPanel = findPanelFor(targetClass);\n109: \t\t\ttargetClass = targetClass.getSuperclass();\n110: \t\t\tif (targetClass == java.lang.Object.class) break;\n111: \t\t}\n112: \t\tif (newPanel instanceof JPanel) {\n113: \t\t\tnewPanel.setTarget(_target);\n114: \t\t\tadd((JPanel) newPanel, BorderLayout.NORTH);\n115: \t\t\t_shouldBeEnabled = true;\n116: \t\t\t_lastPanel = (JPanel) newPanel;\n117: \t\t}\n118: \t\telse {\n119: \t\t\tadd(_blankPanel, BorderLayout.NORTH);\n120: \t\t\t_shouldBeEnabled = false;\n121: \t\t\t_lastPanel = _blankPanel;\n122: \t\t}\n123: \t\tvalidate();\n124: \t\trepaint();\n125: \t}\n126: \n127:   public void refresh() { setTarget(_target); }\n128: \n129:   public TabModelTarget findPanelFor(Class targetClass) {\n130:     TabModelTarget p = (TabModelTarget) _panels.get(targetClass);\n131:     // System.out.println(\"Getting prop panel for:\" + targetClass+\", found\"+p);\n132:     if (p == null) {\n133:       Class panelClass = panelClassFor(targetClass);\n134:       if (panelClass == null) return null;\n135:       try { p = (TabModelTarget) panelClass.newInstance(); }\n136:       catch (IllegalAccessException ignore) { return null; }\n137:       catch (InstantiationException ignore) { return null; }\n138:       _panels.put(targetClass, p);\n139:     }\n140:     //else System.out.println(\"found props for \" + targetClass.getName());\n141:     return p;\n142:   }\n143: \n144:   public Class panelClassFor(Class targetClass) {\n145:     String pack = \"org.argouml.ui\";\n146:     String base = getClassBaseName();\n147:     String targetClassName = targetClass.getName();\n148:     int lastDot = targetClassName.lastIndexOf(\".\");\n149:     if (lastDot > 0) targetClassName = targetClassName.substring(lastDot+1);\n150:     if (targetClassName.startsWith(\"M\"))\n151:       targetClassName = targetClassName.substring(2);\n152:     try {\n153:       String panelClassName = pack + \".\" + base + targetClassName;\n154:       return Class.forName(panelClassName);\n155:     }\n156:     catch (ClassNotFoundException ignore) { }\n157:     return null;\n158:   }\n159: \n160:   protected String getClassBaseName() { return _panelClassBaseName; }\n161: \n162:   public Object getTarget() { return _target; }\n163: \n164:   public boolean shouldBeEnabled() { return _shouldBeEnabled; }\n165: \n166: \n167: } /* end class TabProps */\n168: \n169: \n170: class InitPanelsLater implements Runnable {\n171:   Hashtable _panels = null;\n172:   public InitPanelsLater(Hashtable p) { _panels = p; }\n173: \n174:   /** Load commonly used property panels, but not those that are\n175:    *  commonly used within a few seconds of the tool being launched. */ \n176:   public void run() {\n177:   //   // preload commonly used property panels\n178: \n179: \t  //fill the Hashtable. alphabetical order please... ;-)\n180:     _panels.put(MActionStateImpl.class, new PropPanelActionState());\n181:     _panels.put(MActorImpl.class, new PropPanelActor());\n182:     _panels.put(MAssociationImpl.class, new PropPanelAssociation());\n183:     _panels.put(MAssociationRoleImpl.class, new PropPanelAssociationRole());\n184:     _panels.put(MAttributeImpl.class, new PropPanelAttribute());\n185:     // _panels.put(MClassImpl.class, new PropPanelClass());\n186:     _panels.put(MClassifierRoleImpl.class, new PropPanelClassifierRole());\n187:     _panels.put(MDependencyImpl.class, new PropPanelDependency());\n188:     //_panels.put(Diagram.class, new PropPanelDiagram());\n189:     _panels.put(MGeneralizationImpl.class, new PropPanelGeneralization());\n190:     _panels.put(MInstanceImpl.class, new PropPanelInstance());\n191:     _panels.put(MComponentInstanceImpl.class, new PropPanelComponentInstance());\n192:     _panels.put(MComponentImpl.class, new PropPanelComponent());\n193:     _panels.put(MNodeInstanceImpl.class, new PropPanelNodeInstance());\n194:     _panels.put(MNodeImpl.class, new PropPanelNode());\n195:     _panels.put(MObjectImpl.class, new PropPanelObject());\n196:     _panels.put(MInstanceImpl.class, new PropPanelInstance());\n197:     _panels.put(MInterfaceImpl.class, new PropPanelInterface());\n198:     _panels.put(MLinkImpl.class, new PropPanelLink());\n199:     _panels.put(MMessageImpl.class, new PropPanelMessage());\n200:     //_panels.put(MModelImpl.class, new PropPanelModel());\n201: \n202: \t// how are Notes handled? Toby, nsuml\n203:     //_panels.put(MNoteImpl.class, new PropPanelNote());\n204:     _panels.put(MOperationImpl.class, new PropPanelOperation());\n205:     _panels.put(MPseudostateImpl.class, new PropPanelPseudostate());\n206: \t//    _panels.put(Realization.class, new PropPanelRealization());\n207: \t// Realization in nsuml!!!\n208: \t_panels.put(UMLStateDiagram.class, new PropPanelUMLStateDiagram());\n209:     _panels.put(MStateImpl.class, new PropPanelState());\n210:     _panels.put(String.class, new PropPanelString());\n211:     _panels.put(MTransitionImpl.class, new PropPanelTransition());\n212:     //_panels.put(MUseCaseImpl.class, new PropPanelUseCase());\n213: \n214:  \tSystem.out.println(\"done preloading Property Panels\");\n215:   }\n216: } /* end class InitPanelsLater */\n217: ",
