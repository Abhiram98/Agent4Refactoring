 UMLAction NextEditTab = new ActionNextEditTab();\n79:   public static UMLAction PrevEditTab = new ActionPrevEditTab();\n80:   public static UMLAction ShowDiagramTab = new ActionShowDiagramTab();\n81:   public static UMLAction ShowTableTab = new ActionShowTableTab();\n82:   public static UMLAction ShowTextTab = new ActionShowTextTab();\n83:   public static UMLAction AddToFavs = new ActionAddToFavs();\n84:   public static UMLAction NextDetailsTab = new ActionNextDetailsTab();\n85:   public static UMLAction PrevDetailsTab = new ActionPrevDetailsTab();\n86: \n87: \n88:   \n89:   public static UMLAction CreateMultiple = new ActionCreateMultiple();\n90:   public static UMLAction ClassWizard = new ActionClassWizard();\n91: \n92:   public static UMLAction Model = new ActionModel();\n93:   public static UMLAction ClassDiagram = new ActionClassDiagram();\n94:   public static UMLAction UseCaseDiagram = new ActionUseCaseDiagram();\n95:   public static UMLAction StateDiagram = new ActionStateDiagram();\n96: \n97:   public static UMLAction Class = new ActionClass();\n98:   public static UMLAction Interface = new ActionInterface();\n99:   public static UMLAction Actor = new ActionActor();\n100:   public static UMLAction UseCase = new ActionUseCase();\n101:   public static UMLAction State = new ActionState();\n102:   public static UMLAction Pseudostate = new ActionPseudostate();\n103:   public static UMLAction Package = new ActionPackage();\n104:   public static UMLAction Instance = new ActionInstance();\n105:   public static UMLAction Attr = new ActionAttr();\n106:   public static UMLAction Oper = new ActionOper();\n107:   public static UMLAction InternalTransition = new ActionInternalTransition();\n108: \n109:   public static UMLAction GenerateOne = new ActionGenerateOne();\n110:   public static UMLAction GenerateAll = new ActionGenerateAll();\n111: \n112: \n113:   public static UMLAction AutoCritique = new ActionAutoCritique();\n114:   public static UMLAction OpenDecisions = new ActionOpenDecisions();\n115:   public static UMLAction OpenGoals = new ActionOpenGoals();\n116:   public static UMLAction OpenCritics = new ActionOpenCritics();\n117: \n118:   public static UMLAction FlatToDo = new ActionFlatToDo();\n119: \n120:   public static UMLAction NewToDoItem = new ActionNewToDoItem();\n121:   public static UMLAction Resolve = new ActionResolve();\n122:   public static UMLAction EmailExpert = new ActionEmailExpert();\n123:   public static UMLAction MoreInfo = new ActionMoreInfo();\n124:   public static UMLAction Snooze = new ActionSnooze();\n125: \n126:   public static UMLAction RecordFix = new ActionRecordFix();\n127:   public static UMLAction ReplayFix = new ActionReplayFix();\n128: \n129:   //   public static UMLAction FixItNext = new ActionFixItNext();\n130:   //   public static UMLAction FixItBack = new ActionFixItBack();\n131:   //   public static UMLAction FixItFinish = new ActionFixItFinish();\n132: \n133:   public static UMLAction AboutArgoUML = new ActionAboutArgoUML();\n134: \n135: \n136: \n137: \n138:   public static void updateAllEnabled() {\n139:     java.util.Enumeration actions = _allActions.elements();\n140:     while (actions.hasMoreElements()) {\n141:       UMLAction a = (UMLAction) actions.nextElement();\n142:       a.updateEnabled();\n143:     }\n144:   }\n145: \n146:   \n147: }  /* end class Actions */\n148: \n149: \n150: \n151: ////////////////////////////////////////////////////////////////\n152: // file menu actions\n153: \n154: class ActionNew extends UMLAction {\n155:   public ActionNew() { super(\"New...\"); }\n156:   public void actionPerformed(ActionEvent e) {\n157:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n158:     pb.setProject(new EmptyProject());\n159:   }\n160: } /* end class ActionNew */\n161: \n162: class ActionOpen extends UMLAction {\n163:   public ActionOpen() { super(\"Open...\"); }\n164:   public void actionPerformed(ActionEvent e) {\n165:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n166:     try {\n167:       JFileChooser chooser = new JFileChooser();\n168:       ArgoFileFilter filter = new ArgoFileFilter();\n169:       chooser.addChoosableFileFilter(filter);\n170:       chooser.setFileFilter(filter);\n171:       int retval = chooser.showOpenDialog(pb);\n172:       if(retval == 0) {\n173: \tFile theFile = chooser.getSelectedFile();\n174: \tif(theFile != null) {\n175: \t  String pathname = chooser.getSelectedFile().getAbsolutePath();\n176:     \tpb.showStatus(\"Reading \" + pathname + \"...\");\n177:     \tFileInputStream fis = new FileInputStream(pathname);\n178:     \tObjectInput s = new ObjectInputStream(fis);\n179:     \tProject p = (Project) s.readObject();\n180: \tp.postLoad();\n181: \tif (fis != null) fis.close();\n182:     \tpb.showStatus(\"Read \" + pathname);\n183: \tpb.setProject(p);\n184: \treturn;\n185: \t}\n186:       }\n187:       JOptionPane.showMessageDialog(pb, \"No file chosen\");\n188:     }\n189:     catch (FileNotFoundException ignore) {\n190:       System.out.println(\"got an FileNotFoundException\");\n191:      }\n192:     catch (java.lang.ClassNotFoundException ignore) {\n193:       System.out.println(\"got an ClassNotFoundException\");\n194:      }\n195:     catch (IOException ignore) {\n196:       System.out.println(\"got an IOException\");\n197:     }\n198: \n199:   }\n200: } /* end class ActionOpen */\n201: \n202: class ActionSave extends UMLAction {\n203:   public ActionSave() { super(\"Save\"); }\n204:   public boolean shouldBeEnabled() {\n205:     Project p = ProjectBrowser.TheInstance.getProject();\n206:     return super.shouldBeEnabled() && p != null && p.getNeedsSave();\n207:   }\n208:   public void actionPerformed(ActionEvent ae) {\n209:     // needs-more-work: should just save\n210:     Actions.SaveAs.actionPerformed(ae);\n211:   }\n212: } /* end class ActionSave */\n213: \n214: class ActionSaveAs extends UMLAction {\n215:   public ActionSaveAs() { super(\"Save As...\"); }\n216:   public boolean shouldBeEnabled() {\n217:     Project p = ProjectBrowser.TheInstance.getProject();\n218:     return super.shouldBeEnabled() && p != null;\n219:   }\n220:   public void actionPerformed(ActionEvent ae) {\n221:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n222:     Project p =  pb.getProject();\n223:     try {\n224:       JFileChooser chooser = new JFileChooser();\n225:       ArgoFileFilter filter = new ArgoFileFilter();\n226:       chooser.addChoosableFileFilter(filter);\n227:       chooser.setFileFilter(filter);\n228:       int retval = chooser.showSaveDialog(pb);\n229:       if(retval == 0) {\n230: \tFile theFile = chooser.getSelectedFile();\n231: \tif (theFile != null) {\n232: \t  String pathname = chooser.getSelectedFile().getAbsolutePath();\n233: \t  pb.showStatus(\"Writing \" + pathname + \"...\");\n234: \t  FileOutputStream fos = new FileOutputStream(pathname);\n235: \t  ObjectOutput oo = new ObjectOutputStream(fos);\n236: \t  p.preSave();\n237: \t  oo.writeObject(p);\n238: \t  p.postSave();\n239: \t  if (fos != null) fos.close();\n240: \t  pb.showStatus(\"Wrote \" + pathname);\n241: \t  return;\n242: \t}\n243:       }\n244:       JOptionPane.showMessageDialog(pb, \"No file chosen\");\n245:     }\n246:     catch (FileNotFoundException ignore) {\n247:       System.out.println(\"got an FileNotFoundException\");\n248:     }\n249: //     catch (PropertyVetoException ignore) {\n250: //       System.out.println(\"got an PropertyVetoException\");\n251: //     }\n252:     //    catch (java.lang.ClassMismatchException ignore) {\n253:     //      System.out.println(\"got an ClassMismatchException\");\n254:     //    }\n255:     catch (IOException ignore) {\n256:       System.out.println(\"got an IOException\");\n257:       ignore.printStackTrace();\n258:     }\n259:   }\n260: } /* end class ActionSaveAS */\n261: \n262: class ActionSaveAsXMI extends UMLAction {\n263:   public ActionSaveAsXMI() { super(\"Save As XMI\"); }\n264: \n265:   public boolean shouldBeEnabled() {\n266:     Project p = ProjectBrowser.TheInstance.getProject();\n267:     return super.shouldBeEnabled() && p != null;\n268:   }\n269: \n270:   public void actionPerformed(ActionEvent e) {\n271:     System.out.println(\"Dump XMI now.\");\n272:     Project p = ProjectBrowser.TheInstance.getProject();\n273: \n274:     //@ XMITraverse.traverse(p);\n275:   }\n276: } /* end class ActionSaveAsXMI */\n277: \n278: class ActionPrint extends UMLAction {\n279:   public ActionPrint() { super(\"Print...\"); }\n280:   public boolean shouldBeEnabled() {\n281:     Project p = ProjectBrowser.TheInstance.getProject();\n282:     return super.shouldBeEnabled() && p != null;\n283:   }\n284: } /* end class ActionPrint */\n285: \n286: class ActionAddToProj extends UMLAction {\n287:   public ActionAddToProj() { super(\"Add To Project...\"); }\n288:   public boolean shouldBeEnabled() {\n289:     Project p = ProjectBrowser.TheInstance.getProject();\n290:     return super.shouldBeEnabled() && p != null;\n291:   }\n292: } /* end class ActionAddToProj */\n293: \n294: class ActionExit extends UMLAction {\n295:   public ActionExit() { super(\"Exit\"); }\n296: \n297:   public void actionPerformed(ActionEvent e) {\n298:     //needs-more-work: are you sure you want to quit?\n299:     System.exit(0);\n300:   }\n301: } /* end class ActionExit */\n302: \n303: ////////////////////////////////////////////////////////////////\n304: // generic editing actions\n305: \n306: class ActionUndo extends UMLAction {\n307:   public ActionUndo() { super(\"Undo\"); }\n308: } /* end class ActionUndo */\n309: \n310: class ActionRedo extends UMLAction {\n311:   public ActionRedo() { super(\"Redo\"); }\n312: } /* end class ActionRedo */\n313: \n314: class ActionCut extends UMLAction {\n315:   public ActionCut() { super(\"Cut\"); }\n316: } /* end class ActionCut */\n317: \n318: class ActionCopy extends UMLAction {\n319:   public ActionCopy() { super(\"Copy\"); }\n320: } /* end class ActionCopy */\n321: \n322: class ActionPaste extends UMLAction {\n323:   public ActionPaste() { super(\"Paste\"); }\n324: } /* end class ActionPaste */\n325: \n326: \n327: ////////////////////////////////////////////////////////////////\n328: // navigation actions\n329: \n330: class ActionNavUp extends UMLAction {\n331:   public ActionNavUp() { super(\"Navigate Up\"); }\n332:   public boolean shouldBeEnabled() {\n333:     Project p = ProjectBrowser.TheInstance.getProject();\n334:     return super.shouldBeEnabled() && p != null;\n335:   }\n336: } /* end class ActionNavUp */\n337: \n338: class ActionNavDown extends UMLAction {\n339:   public ActionNavDown() { super(\"Navigate Down\"); }\n340:   public boolean shouldBeEnabled() {\n341:     Project p = ProjectBrowser.TheInstance.getProject();\n342:     return super.shouldBeEnabled() && p != null;\n343:   }\n344: } /* end class ActionNavDown */\n345: \n346: class ActionNavBack extends UMLAction {\n347:   public ActionNavBack() { super(\"Navigate Back\"); }\n348:   public boolean shouldBeEnabled() {\n349:     Project p = ProjectBrowser.TheInstance.getProject();\n350:     return super.shouldBeEnabled() && p != null;\n351:   }\n352: } /* end class ActionNavBack */\n353: \n354: class ActionNavForw extends UMLAction {\n355:   public ActionNavForw() { super(\"Navigate Forward\"); }\n356:   public boolean shouldBeEnabled() {\n357:     Project p = ProjectBrowser.TheInstance.getProject();\n358:     return super.shouldBeEnabled() && p != null;\n359:   }\n360: } /* end class ActionNavForw */\n361: \n362: class ActionNavFavs extends UMLAction {\n363:   public ActionNavFavs() { super(\"Favorites\"); }\n364:   public boolean shouldBeEnabled() {\n365:     Project p = ProjectBrowser.TheInstance.getProject();\n366:     return super.shouldBeEnabled() && p != null;\n367:   }\n368: } /* end class ActionNavFavs */\n369: \n370: class ActionNavConfig extends UMLAction {\n371:   public ActionNavConfig() { super(\"NavConfig\"); }\n372:   public void actionPerformed(ActionEvent ae) {\n373:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n374:     NavigatorPane nav = pb.getNavPane();\n375:     NavigatorConfigDialog ncd = new NavigatorConfigDialog(pb);\n376:     ncd.setVisible(true);\n377:   }\n378: } /* end class ActionNavConfig */\n379: \n380: class ActionNextEditTab extends UMLAction {\n381:   public ActionNextEditTab() { super(\"Next Editing Tab\"); }\n382:   public boolean shouldBeEnabled() {\n383:     Project p = ProjectBrowser.TheInstance.getProject();\n384:     return super.shouldBeEnabled() && p != null;\n385:   }\n386: } /* end class ActionNextEditTab */\n387: \n388: class ActionPrevEditTab extends UMLAction {\n389:   public ActionPrevEditTab() { super(\"Previous Editing Tab\"); }\n390:   public boolean shouldBeEnabled() {\n391:     Project p = ProjectBrowser.TheInstance.getProject();\n392:     return super.shouldBeEnabled() && p != null;\n393:   }\n394: } /* end class ActionPrevEditTab */\n395: \n396: class ActionShowDiagramTab extends UMLAction {\n397:   public ActionShowDiagramTab() { super(\"Show Diagram Tab\"); }\n398:   public boolean shouldBeEnabled() {\n399:     Project p = ProjectBrowser.TheInstance.getProject();\n400:     return super.shouldBeEnabled() && p != null;\n401:   }\n402: } /* end class ActionShowDiagramTab */\n403: \n404: class ActionShowTableTab extends UMLAction {\n405:   public ActionShowTableTab() { super(\"Show Table Tab\"); }\n406:   public boolean shouldBeEnabled() {\n407:     Project p = ProjectBrowser.TheInstance.getProject();\n408:     return super.shouldBeEnabled() && p != null;\n409:   }\n410: } /* end class ActionShowTableTab */\n411: \n412: class ActionShowTextTab extends UMLAction {\n413:   public ActionShowTextTab() { super(\"Show Text Tab\"); }\n414:   public boolean shouldBeEnabled() {\n415:     Project p = ProjectBrowser.TheInstance.getProject();\n416:     return super.shouldBeEnabled() && p != null;\n417:   }\n418: } /* end class ActionShowTextTab */\n419: \n420: class ActionAddToFavs extends UMLAction {\n421:   public ActionAddToFavs() { super(\"Add To Favorites\"); }\n422:   public boolean shouldBeEnabled() {\n423:     Project p = ProjectBrowser.TheInstance.getProject();\n424:     return super.shouldBeEnabled() && p != null;\n425:   }\n426: } /* end class ActionAddToFavs */\n427: \n428: class ActionNextDetailsTab extends UMLAction {\n429:   public ActionNextDetailsTab() { super(\"Next Details Tab\"); }\n430:   public boolean shouldBeEnabled() {\n431:     Project p = ProjectBrowser.TheInstance.getProject();\n432:     return super.shouldBeEnabled() && p != null;\n433:   }\n434:   public void actionPerformed(ActionEvent ae) {\n435:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n436:     DetailsPane dp = pb.getDetailsPane();\n437:     dp.selectNextTab();\n438:   }\n439: } /* end class ActionNextDetailsTab */\n440: \n441: class ActionPrevDetailsTab extends UMLAction {\n442:   public ActionPrevDetailsTab() { super(\"Previous Details Tab\"); }\n443:   public boolean shouldBeEnabled() {\n444:     Project p = ProjectBrowser.TheInstance.getProject();\n445:     return super.shouldBeEnabled() && p != null;\n446:   }\n447: } /* end class ActionPrevDetailsTab */\n448: \n449: ////////////////////////////////////////////////////////////////\n450: \n451: class ActionCreateMultiple extends UMLAction {\n452:   public ActionCreateMultiple() { super(\"Create Multiple...\"); }\n453:   public boolean shouldBeEnabled() {\n454:     Project p = ProjectBrowser.TheInstance.getProject();\n455:     return super.shouldBeEnabled() && p != null;\n456:   }\n457: } /* end class ActionCreateMultiple */\n458: \n459: class ActionClassWizard extends UMLAction {\n460:   public ActionClassWizard() { super(\"Class Wizard...\"); }\n461:   public boolean shouldBeEnabled() {\n462:     Project p = ProjectBrowser.TheInstance.getProject();\n463:     return super.shouldBeEnabled() && p != null;\n464:   }\n465: } /* end class ActionClassWizard */\n466: \n467: ////////////////////////////////////////