lue =\n1446:             ModelFacade.getTaggedValue(modelElement, \"constructor\");\n1447:         if (objTaggedValue != null) {\n1448:             String sTaggedValueConstructor =\n1449:                 ModelFacade.getValueOfTag(objTaggedValue);\n1450: \n1451:             if (sTaggedValueConstructor != null\n1452:                     && sTaggedValueConstructor.equals(\"true\")) {\n1453:                 if (findConstructor(modelElement) == null) {\n1454:                     String sConstructor = null;\n1455: \n1456:                     if (iLanguageMajorVersion < 5) {\n1457:                         sConstructor = \"function \" + NameGenerator.generate(\n1458:                                 modelElement, iLanguageMajorVersion);\n1459:                     } else {\n1460:                         sConstructor = \"public function __construct\";\n1461:                     }\n1462: \n1463:                     sClsOp += \"\\n\";\n1464:                     sClsOp += INDENT + \"/**\\n\";\n1465:                     sClsOp += INDENT + \" * Class constructor\\n\";\n1466:                     sClsOp += INDENT + \" *\\n\";\n1467:                     sClsOp += INDENT + \" * @access public\\n\";\n1468:                     sClsOp += INDENT + \" *\\n\";\n1469:                     sClsOp += INDENT + \" * @return void\\n\";\n1470:                     sClsOp += INDENT + \" *\\n\";\n1471:                     sClsOp += INDENT + \" * @author ArgoUML \"\n1472:                             + ArgoVersion.getVersion() + \"\\n\";\n1473:                     sClsOp += INDENT + \" */\\n\";\n1474: \n1475:                     sClsOp += INDENT + sConstructor + \"()\\n\";\n1476:                     sClsOp += INDENT + \"{\\n\";\n1477:                     sClsOp += generateSection(modelElement, INDENT,\n1478:                         sConstructor.substring(sConstructor.lastIndexOf(\" \")));\n1479:                     sClsOp += INDENT + \"}\\n\";\n1480:                 }\n1481:             }\n1482:         }\n1483: \n1484:         if (ModelFacade.isAClass(modelElement)) {\n1485:             Collection colSpec = ModelFacade.getSpecifications(modelElement);\n1486:             if (colSpec != null) {\n1487:                 Iterator itSpec = colSpec.iterator();\n1488:                 while (itSpec.hasNext()) {\n1489:                     Collection colIfOps =\n1490:                         ModelFacade.getOperations(itSpec.next());\n1491:                     if (colIfOps != null) {\n1492:                         Iterator itIfOps = colIfOps.iterator();\n1493:                         while (itIfOps.hasNext()) {\n1494:                             Object op = itIfOps.next();\n1495:                             sClsOp += \"\\n\";\n1496: \n1497:                             PHPDocumentor objPHPDoc = null;\n1498:                             try {\n1499:                                 objPHPDoc = new PHPDocumentor(op);\n1500:                             } catch (Exception exp) {\n1501:                                 LOG.error(\"Generating operation DocBlock \"\n1502:                                         + \"FAILED: \" + exp.getMessage());\n1503:                             } finally {\n1504:                                 if (objPHPDoc != null) {\n1505:                                     sClsOp += objPHPDoc.toString(INDENT);\n1506:                                 }\n1507:                             }\n1508: \n1509:                             sClsOp += INDENT + generate(op);\n1510:                             sClsOp += generateMethodBody(op, true);\n1511:                         }\n1512:                     }\n1513:                 }\n1514:             }\n1515:         }\n1516: \n1517:         Collection colOperations = ModelFacade.getOperations(modelElement);\n1518:         if (colOperations != null) {\n1519:             Iterator itOperations = colOperations.iterator();\n1520:             while (itOperations.hasNext()) {\n1521:                 Object op = itOperations.next();