.getElementResidences();\n136:       if (tt.getComponentInstance() != null) {\n137:         MComponentInstance comp_inst = tt.getComponentInstance();\n138:         _componentInstanceField.setText(comp_inst.getName());\n139:       }\n140:       else {\n141:         _componentInstanceField.setText(null);\n142:       }\n143:       if (residences != null && (residences.size() > 0)) {\n144:         Iterator it = residences.iterator();\n145:         while (it.hasNext()) {\n146:           MElementResidence residence = (MElementResidence) it.next();\n147:           if (residence != null) {\n148:             MComponent comp = (MComponent) residence.getImplementationLocation();\n149:             if (comp != null) {\n150:             _componentField.setText(comp.getName());\n151:             }\n152:           }\n153:         }\n154:       }\n155:       else {\n156:         _componentField.setText(null);\n157:       }\n158:       if (tt.getClassifiers() != null) {\n159:         String base = \"\";\n160:         Collection classifiers = tt.getClassifiers();\n161:         Iterator it = classifiers.iterator();\n162:         while (it.hasNext()) {\n163:           Object o = it.next();\n164:           if (o != null && (o instanceof MClassifier)) {\n165:             MClassifier cls = (MClassifier) o;\n166:             if (cls != null) {\n167:               base = cls.getName();\n168:             }\n169:           }\n170:         }\n171:         _baseField.setText(base);        \n172:       } \n173:       else {\n174:         _baseField.setText(null);\n175:       }\n176:     }\n177:    \n178:     // set the values to be shown in all widgets based on model\n179:       validate();\n180:   }\n181: \n182:   public void setTargetBase() { \n183:     if (_target == null) return; \n184:     if (_inChange) return;\n185:  \n186:     MObject tt = (MObject) _target;\n187:     MClass classifier = new MClassImpl(); \n188:     String base = _baseField.getText();\n189:     Collection col = tt.getClassifiers();\n190:     if ((col != null) && (col.size()>0)) { \n191:       Iterator itcol = col.iterator(); \n192:       while (itcol.hasNext()) { \n193:         MClassifier cls = (MClassifier) itcol.next(); \n194:         tt.removeClassifier(cls); \n195:       } \n196:     } \n197: \n198:     Vector diagrams = ProjectBrowser.TheInstance.getProject().getDiagrams();\n199:     GraphModel model = null;\n200:     Vector v = new Vector();\n201:     int size = diagrams.size();\n202:     for (int i=0; i<size; i++) {\n203:       Object o = diagrams.elementAt(i);\n204:       if (!(o instanceof Diagram)) continue;\n205:       if (o instanceof MModel) continue;\n206:       Diagram d = (Diagram) o;\n207:       model = d.getGraphModel(); \n208: \n209:       if (!(model instanceof ClassDiagramGraphModel || model instanceof DeploymentDiagramGraphModel)) continue;\n210:        \n211:       Vector nodes = model.getNodes();\n212:       int s = nodes.size();\n213:       for (int j=0; j<s; j++) {\n214:         MModelElement node = (MModelElement) nodes.elementAt(j);\n215:         if (node != null && (node instanceof MClassImpl)) {\n216:           MClass mclass = (MClass) node;\n217:           if (mclass.getNamespace() != tt.getNamespace()) continue;\n218:           String class_name = mclass.getName();\n219:           if (class_name != null && (class_name.equals(base))) {\n220:             v.addElement(mclass);\n221:             tt.setClassifiers(v);\n222:             return; \n223:           }      \n224:         }\n225:       }\n226:     }\n227: \n228:     classifier.setName(base);\n229:     v.addElement(classifier);\n230:     tt.setClassifiers(v);\n231: \n232:     //System.out.println(\"needs-more-work: baseClass = \" + base); \n233:     // needs-more-work: this could involve changes to the graph model \n234:   } \n235: \n236:  \n237:   ////////////////////////////////////////////////////////////////\n238:   // event handlers\n239: \n240: \n241:   /** The user typed some text */\n242: