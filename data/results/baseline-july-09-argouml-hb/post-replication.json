er pb = ProjectBrowser.TheInstance;\n584:     Object target = pb.getTarget();\n585:     return super.shouldBeEnabled() && target instanceof Classifier;\n586:   }\n587: } /* end class ActionAttr */\n588: \n589: class ActionOper extends UMLAction {\n590:   // needs-more-work: should be part of java binding or common elements\n591:   public static DataType VOID_TYPE = new DataType(\"void\");\n592: \n593:   public ActionOper() { super(\"Operation\"); }\n594: \n595:   public void actionPerformed(ActionEvent e) {\n596:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n597:     Object target = pb.getTarget();\n598:     if (!(target instanceof Classifier)) return;\n599:     Classifier cls = (Classifier) target;\n600:     try {\n601:       Operation oper = new Operation(VOID_TYPE, \"newOperation\");\n602:       oper.setVisibility(VisibilityKind.PUBLIC);\n603:       cls.addBehavioralFeature(oper);\n604:     }\n605:     catch (PropertyVetoException pve) {\n606:       System.out.println(\"PropertyVetoException in ActionOper\");\n607:     }\n608:   }\n609:   public boolean shouldBeEnabled() {\n610:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n611:     Object target = pb.getTarget();\n612:     return super.shouldBeEnabled() && target instanceof Classifier;\n613:   }\n614: } /* end class ActionOper */\n615: \n616: \n617: class ActionModel extends UMLAction {\n618:   //uci.gef.Cmd _cmdCreateNode = new\n619:   //uci.gef.CmdCreateNode(uci.uml.Model_Management.Model.class, \"Model\");\n620:   // needs-more-work: need FigModel and UMLPackageDiagram\n621:   public ActionModel() { super(\"Model\"); }\n622: \n623:   public void actionPerformed(ActionEvent e) {\n624:     System.out.println(\"making model...\");\n625:     //_cmdCreateNode.doIt();\n626:     Project p = ProjectBrowser.TheInstance.getProject();\n627:     try {\n628:       p.addModel(new Model());\n629:     }\n630:     catch (PropertyVetoException pve) { }\n631:   }\n632: \n633:   public boolean shouldBeEnabled() {\n