t.event.KeyEvent;\n33: import java.awt.event.KeyListener;\n34: import java.awt.event.MouseEvent;\n35: import java.awt.event.MouseListener;\n36: import java.beans.PropertyChangeEvent;\n37: import java.beans.PropertyChangeListener;\n38: import java.beans.VetoableChangeListener;\n39: import java.util.ArrayList;\n40: import java.util.Collection;\n41: import java.util.Iterator;\n42: import java.util.List;\n43: import java.util.Vector;\n44: \n45: import javax.swing.Action;\n46: import javax.swing.Icon;\n47: import javax.swing.JSeparator;\n48: import javax.swing.SwingUtilities;\n49: \n50: import org.apache.log4j.Logger;\n51: import org.argouml.application.events.ArgoEventPump;\n52: import org.argouml.application.events.ArgoEventTypes;\n53: import org.argouml.application.events.ArgoNotationEvent;\n54: import org.argouml.application.events.ArgoNotationEventListener;\n55: import org.argouml.cognitive.Designer;\n56: import org.argouml.cognitive.Highlightable;\n57: import org.argouml.cognitive.ItemUID;\n58: import org.argouml.cognitive.ToDoItem;\n59: import org.argouml.cognitive.ToDoList;\n60: import org.argouml.i18n.Translator;\n61: import org.argouml.kernel.DelayedChangeNotify;\n62: import org.argouml.kernel.DelayedVChangeListener;\n63: import org.argouml.kernel.Project;\n64: import org.argouml.kernel.ProjectManager;\n65: import org.argouml.kernel.ProjectSettings;\n66: import org.argouml.model.AddAssociationEvent;\n67: import org.argouml.model.DeleteInstanceEvent;\n68: import org.argouml.model.DiElement;\n69: import org.argouml.model.InvalidElementException;\n70: import org.argouml.model.Model;\n71: import org.argouml.model.RemoveAssociationEvent;\n72: import org.argouml.notation.NotationContext;\n73: import org.argouml.notation.NotationName;\n74: import org.argouml.notation.NotationProvider4;\n75: import org.argouml.notation.NotationProviderFactory2;\n76: import org.argouml.ui.ActionAutoResize;\n77: import org.argouml.ui.ActionGoToCritique;\n78: import org.argouml.ui.ArgoDiagram;\n79: import org.argouml.ui.ArgoJMenu;\n80: import org.argouml.ui.Clarifier;\n81: import org.argouml.ui.ProjectBrowser;\n82: import org.argouml.ui.cmd.CmdSetPreferredSize;\n83: import org.argouml.ui.targetmanager.TargetManager;\n84: import org.argouml.uml.ui.ActionDeleteModelElements;\n85: import org.tigris.gef.base.Globals;\n86: import org.tigris.gef.base.Layer;\n87: import org.tigris.gef.base.PathConvPercent;\n88: import org.tigris.gef.base.Selection;\n89: import org.tigris.gef.presentation.Fig;\n90: import org.tigris.gef.presentation.FigEdgePoly;\n91: import org.tigris.gef.presentation.FigNode;\n92: import org.tigris.gef.presentation.FigPoly;\n93: import org.tigris.gef.presentation.FigText;\n94: \n95: /**\n96:  * Abstract class to display diagram lines (edges) for UML ModelElements that\n97:  * look like lines and that have editable names.\n98:  */\n99: public abstract class FigEdgeModelElement\n100:     extends FigEdgePoly\n101:     implements\n102:         VetoableChangeListener,\n103:         DelayedVChangeListener,\n104:         MouseListener,\n105:         KeyListener,\n106:         PropertyChangeListener,\n107:         NotationContext,\n108:         ArgoNotationEventListener,\n109:         Highlightable {\n110: \n111:     private static final Logger LOG =\n112:         Logger.getLogger(FigEdgeModelElement.class);\n113: \n114:     private DiElement diElement = null;\n115: \n116:     /**\n117:      * Set the removeFromDiagram to false if this edge may not\n118:      * be removed from the diagram.\n119:      */\n120:     private boolean removeFromDiagram = true;\n121: \n122:     ////////////////////////////////////////////////////////////////\n123:     // constants\n124: \n125:     private static final Font LABEL_FONT;\n126:     private static final Font ITALIC_LABEL_FONT;\n127: \n128:     static {\n129:         LABEL_FONT = new Font(\"Dialog\", Font.PLAIN, 10);\n130:         ITALIC_LABEL_FONT =\n131:             new Font(LABEL_FONT.getFamily(), Font.ITALIC, LABEL_FONT.getSize());\n132:     }\n133: \n134:     /**\n135:      * Offset from the end of the set of popup actions at which new items\n136:      * should be inserted by concrete figures.\n137:     **/\n138:     private static int popupAddOffset;\n139: \n140:     ////////////////////////////////////////////////////////////////\n141:     // instance variables\n142: \n143:     protected NotationProvider4 notationProviderName;\n144: \n145:     /**\n146:      * The Fig that displays the name of this model element.\n147:      * Use getNameFig(), no setter should be required.\n148:      */\n149:     private FigText nameFig;\n150: \n151:     /**\n152:      * Use getStereotypeFig(), no setter should be required.\n153:      */\n154:     private Fig stereotypeFig;\n155: \n156:     private FigEdgePort edgePort;\n157: \n158:     private ItemUID itemUid;\n159: \n160:     /*\n161:      * List of model element listeners we've registered.\n162:      */\n163:     private Collection listeners = new ArrayList();\n164: \n165:     ////////////////////////////////////////////////////////////////\n166:     // constructors\n167: \n168:     /** Partially construct a new FigNode.  This method creates the\n169:      *  _name element that holds the name of the model element and adds\n170:      *  itself as a listener. */\n171:     public FigEdgeModelElement() {\n172: \n173:         nameFig = new FigSingleLineText(10, 30, 90, 20, false);\n174:         nameFig.setTextFilled(false);\n175: \n176:         stereotypeFig = new FigStereotypesCompartment(10, 10, 90, 15);\n177: \n178:         setBetweenNearestPoints(true);\n179: \n180:         ArgoEventPump.addListener(ArgoEventTypes.ANY_NOTATION_EVENT, this);\n181:     }\n182: \n183:     /**\n184:      * The constructor that hooks the Fig into the UML model element.\n185:      *\n186:      * @param edge the UML element\n187:      */\n188:     public FigEdgeModelElement(Object edge) {\n189:         this();\n190:         setOwner(edge);\n191:     }\n192: \n193:     /**\n194:      * Create a FigCommentPort if needed\n195:      */\n196:     public void makeEdgePort() {\n197:         if (edgePort == null) {\n198:             edgePort = new FigEdgePort();\n199:             edgePort.setOwner(getOwner());\n200:             edgePort.setVisible(false);\n201:             addPathItem(edgePort,\n202:                     new PathConvPercent(this, 50, 0));\n203:         }\n204:     }\n205: \n206:     /**\n207:      * @return the FigCommentPort\n208:      */\n209:     public FigEdgePort getEdgePort() {\n210:         return edgePort;\n211:     }\n212: \n213:     ////////////////////////////////////////////////////////////////\n214:     // accessors\n215: \n216:     /**\n217:      * Setter for the UID\n218:      * @param newId the new UID\n219:      */\n220:     public void setItemUID(ItemUID newId) {\n221:         itemUid = newId;\n222:     }\n223: \n224:     /**\n225:      * Getter for the UID\n226:      * @return the UID\n227:      */\n228:     public ItemUID getItemUID() {\n229:         return itemUid;\n230:     }\n231: \n232:     /**\n233:      * @see org.tigris.gef.presentation.Fig#getTipString(java.awt.event.MouseEvent)\n234:      */\n235:     public String getTipString(MouseEvent me) {\n236:         ToDoItem item = hitClarifier(me.getX(), me.getY());\n237:         String tip = \"\";\n238:         if (item != null\n239:             && Globals.curEditor().getSelectionManager().containsFig(this)) {\n240:             tip = item.getHeadline();\n241:         } else if (getOwner() != null) {\n242:             try {\n243:                 tip = Model.getFacade().getTipString(getOwner());\n244:             } catch (InvalidElementException e) {\n245:                 // We moused over an object just as it was deleted\n246:                 // transient condition - doesn't require I18N\n247:                 LOG.warn(\"A deleted element still exists on the diagram\");\n248:                 return Translator.localize(\"misc.name.deleted\");\n249:             }\n250:         } else {\n251:             tip = toString();\n252:         }\n253: \n254:         if (tip != null && tip.length() > 0 && !tip.endsWith(\" \")) {\n255:             tip += \" \";\n256:         }\n257:         return tip;\n258:     }\n259: \n260:     /**\n261:      * @see org.tigris.gef.ui.PopupGenerator#getPopUpActions(java.awt.event.MouseEvent)\n262:      */\n263:     public Vector getPopUpActions(MouseEvent me) {\n264:         Vector popUpActions = super.getPopUpActions(me);\n265:         \n266:         // TODO: Remove this line after 0.20.\n267:         // This is a hack that removes the ordering menu according to issue 3645\n268:         popUpActions.remove(0);\n269: \n270:         // popupAddOffset should be equal to the number of items added here:\n271:         popUpActions.addElement(new JSeparator());\n272:         popupAddOffset = 1;\n273:         if (removeFromDiagram) {\n274:             popUpActions.addElement(\n275:                     ProjectBrowser.getInstance().getRemoveFromDiagramAction());\n276:             popupAddOffset++;\n277:         }\n278:         popUpActions.addElement(new ActionDeleteModelElements());\n279:         popupAddOffset++;\n280: \n281:         /* Check if multiple items are selected: */\n282:         boolean ms = TargetManager.getInstance().getTargets().size() > 1;\n283:         if (!ms) {\n284:             ToDoList list = Designer.theDesigner().getToDoList();\n285:             Vector items =\n286:                 (Vector) list.elementsForOffender(getOwner()).clone();\n287:             if (items != null && items.size() > 0) {\n288:                 ArgoJMenu critiques = new ArgoJMenu(\"menu.popup.critiques\");\n289:                 ToDoItem itemUnderMouse = hitClarifier(me.getX(), me.getY());\n290:                 if (itemUnderMouse != null) {\n291:                     critiques.add(new ActionGoToCritique(itemUnderMouse));\n292:                     critiques.addSeparator();\n293:                 }\n294:                 int size = items.size();\n295:                 for (int i = 0; i < size; i++) {\n296:                     ToDoItem item = (ToDoItem) items.elementAt(i);\n297:                     if (item == itemUnderMouse)\n298:                         continue;\n299:                     critiques.add(new ActionGoToCritique(item));\n300:                 }\n301:                 popUpActions.insertElementAt(new JSeparator(), 0);\n302:                 popUpActions.insertElementAt(critiques, 0);\n303:             }\n304:         }\n305:         // Add stereotypes submenu\n306:         Action[] stereoActions = getApplyStereotypeActions();\n307:         if (stereoActions != null) {\n308:             popUpActions.insertElementAt(new JSeparator(), 0);\n309:             ArgoJMenu stereotypes = new ArgoJMenu(\n310:                     \"menu.popup.apply-stereotypes\");\n311:             for (int i = 0; i < stereoActions.length; ++i) {\n312:                 stereotypes.addCheckItem(stereoActions[i]);\n313:             }\n314:             popUpActions.insertElementAt(stereotypes, 0);\n315:         }\n316:         return popUpActions;\n317:     }\n318:     \n319:     /**\n320:      * Get the set of Actions which valid for adding/removing\n321:      * Stereotypes on the ModelElement of this Fig's owner.\n322:      *  \n323:      * @return array of Actions \n324:      */\n325:     protected Action[] getApplyStereotypeActions() {\n326:         return StereotypeUtility.getApplyStereotypeActions(getOwner());\n327:     }\n328: \n329:     /**\n330:      * distance formula: (x-h)^2 + (y-k)^2 = distance^2\n331:      *\n332:      * @param p1 point\n333:      * @param p2 point\n334:      * @return the square of the distance\n335:      */\n336:     protected int getSquaredDistance(Point p1, Point p2) {\n337:         int xSquared = p2.x - p1.x;\n338:         xSquared *= xSquared;\n339:         int ySquared = p2.y - p1.y;\n340:         ySquared *= ySquared;\n341:         return xSquared + ySquared;\n342:     }\n343: \n344:     /**\n345:      * @param g the <code>Graphics</code> object\n346:      */\n347:     protected void paintClarifiers(Graphics g) {\n348:         int iconPos = 25, gap = 1, xOff = -4, yOff = -4;\n349:         Point p = new Point();\n350:         ToDoList list = Designer.theDesigner().getToDoList();\n351:         Vector items = list.elementsForOffender(getOwner());\n352:         int size = items.size();\n353:         for (int i = 0; i < size; i++) {\n354:             ToDoItem item = (ToDoItem) items.elementAt(i);\n355:             Icon icon = item.getClarifier();\n356:             if (icon instanceof Clarifier) {\n357:                 ((Clarifier) icon).setFig(this);\n358:                 ((Clarifier) icon).setToDoItem(item);\n359:             }\n360:             if (icon != null) {\n361:                 stuffPointAlongPerimeter(iconPos, p);\n362:                 icon.paintIcon(null, g, p.x + xOff, p.y + yOff);\n363:                 iconPos += icon.getIconWidth() + gap;\n364:             }\n365:         }\n366:         items = list.elementsForOffender(this);\n367:         size = items.size();\n368:         for (int i = 0; i < size; i++) {\n369:             ToDoItem item = (ToDoItem) items.elementAt(i);\n370:             Icon icon = item.getClarifier();\n371:             if (icon instanceof Clarifier) {\n372:                 ((Clarifier) icon).setFig(this);\n373:                 ((Clarifier) icon).setToDoItem(item);\n374:             }\n375:             if (icon != null) {\n376:                 stuffPointAlongPerimeter(iconPos, p);\n377:                 icon.paintIcon(null, g, p.x + xOff, p.y + yOff);\n378:                 iconPos += icon.getIconWidth() + gap;\n379:             }\n380:         }\n381:     }\n382: \n383:     /**\n384:      * @param f the fig to indicate the bounds of\n385:      * @param g the graphics\n386:      */\n387:     protected void indicateBounds(FigText f, Graphics g) {\n388:         String text = f.getText();\n389:         if (text == null || text.length() == 0) {\n390:             Rectangle rect = f.getBounds();\n391:             Color c = g.getColor();\n392:             g.setColor(Globals.getPrefs().handleColorFor(f));\n393:             g.drawRect(rect.x, rect.y, rect.width, rect.height);\n394:             g.setColor(c); // TODO: Is this needed?\n395:         }\n396:     }\n397:     \n398:     /**\n399:      * The user clicked on the clarifier.\n400:      *\n401:      * @param x the x of the point clicked\n402:      * @param y the y of the point clicked\n403:      * @return the todo item clicked\n404:      */\n405:     public ToDoItem hitClarifier(int x, int y) {\n406:         int iconPos = 25, xOff = -4, yOff = -4;\n407:         Point p = new Point();\n408:         ToDoList list = Designer.theDesigner().getToDoList();\n409:         Vector items = list.elementsForOffender(getOwner());\n410:         int size = items.size();\n411:         for (int i = 0; i < size; i++) {\n412:             ToDoItem item = (ToDoItem) items.elementAt(i);\n413:             Icon icon = item.getClarifier();\n414:             stuffPointAlongPerimeter(iconPos, p);\n415:             int width = icon.getIconWidth();\n416:             int height = icon.getIconHeight();\n417:             if (y >= p.y + yOff\n418:                 && y <= p.y + height + yOff\n419:                 && x >= p.x + xOff\n420:                 && x <= p.x + width + xOff)\n421:                 return item;\n422:             iconPos += width;\n423:         }\n424:         for (int i = 0; i < size; i++) {\n425:             ToDoItem item = (ToDoItem) items.elementAt(i);\n426:             Icon icon = item.getClarifier();\n427:             if (icon instanceof Clarifier) {\n428:                 ((Clarifier) icon).setFig(this);\n429:                 ((Clarifier) icon).setToDoItem(item);\n430:                 if (((Clarifier) icon).hit(x, y))\n431:                     return item;\n432:             }\n433:         }\n434:         items = list.elementsForOffender(this);\n435:         size = items.size();\n436:         for (int i = 0; i < size; i++) {\n437:             ToDoItem item = (ToDoItem) items.elementAt(i);\n438:             Icon icon = item.getClarifier();\n439:             stuffPointAlongPerimeter(iconPos, p);\n440:             int width = icon.getIconWidth();\n441:             int height = icon.getIconHeight();\n442:             if (y >= p.y + yOff\n443:                 && y <= p.y + height + yOff\n444:                 && x >= p.x + xOff\n445:                 && x <= p.x + width + xOff)\n446:                 return item;\n447:             iconPos += width;\n448:         }\n449:         for (int i = 0; i < size; i++) {\n450:             ToDoItem item = (ToDoItem) items.elementAt(i);\n451:             Icon icon = item.getClarifier();\n452:             if (icon instanceof Clarifier) {\n453:                 ((Clarifier) icon).setFig(this);\n454:                 ((Clarifier) icon).setToDoItem(item);\n455:                 if (((Clarifier) icon).hit(x, y))\n456:                     return item;\n457:             }\n458:         }\n459:         return null;\n460:     }\n461: \n462:     /**\n463:      * Returns a {@link SelectionRerouteEdge} object that manages selection\n464:      * and rerouting of the edge.\n465:      *\n466:      * @return the SelectionRerouteEdge.\n467:      */\n468:     public Selection makeSelection() {\n469:         return new SelectionRerouteEdge(this);\n470:     }\n471: \n472:     /**\n473:      * Getter for name, the name Fig\n474:      * @return the nameFig\n475:      */\n476:     protected FigText getNameFig() {\n477:         return nameFig;\n478:     }\n479:     \n480:     /**\n481:      * Get the Rectangle in which the model elements name is displayed\n482:      */\n483:     public Rectangle getNameBounds() {\n484:         return nameFig.getBounds();\n485:     }\n486:     \n487:     public String getName() {\n488:         return nameFig.getText();\n489:     }\n490: \n491:     /**\n492:      * Getter for stereo, the stereotype Fig\n493:      * @return the stereo Fig\n494:      */\n495:     protected Fig getStereotypeFig() {\n496:         return stereotypeFig;\n497:     }\n498: \n499:     /**\n500:      * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n501:      */\n502:     public void vetoableChange(PropertyChangeEvent pce) {\n503:         Object src = pce.getSource();\n504:         if (src == getOwner()) {\n505:             DelayedChangeNotify delayedNotify =\n506:                 new DelayedChangeNotify(this, pce);\n507:             SwingUtilities.invokeLater(delayedNotify);\n508:         }\n509:     }\n510: \n511:     /**\n512:      * @see org.argouml.kernel.DelayedVChangeListener#delayedVetoableChange(java.beans.PropertyChangeEvent)\n513:      */\n514:     public void delayedVetoableChange(PropertyChangeEvent pce) {\n515:         // update any text, colors, fonts, etc.\n516:         renderingChanged();\n517:         // update the relative sizes and positions of internel Figs\n518:         Rectangle bbox = getBounds();\n519:         setBounds(bbox.x, bbox.y, bbox.width, bbox.height);\n520:         endTrans();\n521:     }\n522: \n523:     /**\n524:      * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n525:      */\n526:     public void propertyChange(PropertyChangeEvent pve) {\n527:         Object src = pve.getSource();\n528:         String pName = pve.getPropertyName();\n529:         if (pve instanceof DeleteInstanceEvent && src == getOwner()) {\n530:             removeFromDiagram();\n531:             return;\n532:         }\n533:         // We handle and consume editing events\n534:         if (pName.equals(\"editing\")\n535:                 && Boolean.FALSE.equals(pve.getNewValue())) {\n536:             LOG.debug(\"finished editing\");\n537:             // parse the text that was edited\n538:             textEdited((FigText) src);\n539:             calcBounds();\n540:             endTrans();\n541:         } else if (pName.equals(\"editing\")\n542:                 && Boolean.TRUE.equals(pve.getNewValue())) {\n543:             textEditStarted((FigText) src);\n544:         } else {\n545:             // Add/remove name change listeners for applied stereotypes\n546:             if (src == getOwner()\n547:                     && \"stereotype\".equals(pName)) {\n548:                 if (pve instanceof RemoveAssociationEvent) {\n549:                     removeElementListener(pve.getOldValue());\n550:                 } else if (pve instanceof AddAssociationEvent) {\n551:                     addElementListener(pve.getNewValue(), \"name\");\n552:                 }\n553:             }\n554:             // Pass everything except editing events to superclass\n555:             super.propertyChange(pve);\n556:         }\n557: \n558:         if (Model.getFacade().isAModelElement(src) \n559:                 && getOwner() != null\n560:                 && !Model.getUmlFactory().isRemoved(getOwner())) {\n561:             /* If the source of the event is an UML object,\n562:              * then the UML model has been changed.*/\n563:             modelChanged(pve);\n564:         }\n565:         damage();  // TODO: (MVW) Is this required?\n566:         // After all these events? I doubt it...\n567:     }\n568: \n569:     /**\n570:      * This method is called when the user doubleclicked on the text field,\n571:      * and starts editing. Subclasses should overrule this field to e.g.\n572:      * supply help to the user about the used format. <p>\n573:      *\n574:      * It is also possible to alter the text to be edited\n575:      * already here, e.g. by adding the stereotype in front of the name,\n576:      * but that seems not user-friendly.\n577:      *\n578:      * @param ft the FigText that will be edited and contains the start-text\n579:      */\n580:     protected void textEditStarted(FigText ft) {\n581:         if (ft == getNameFig()) {\n582:             showHelp(notationProviderName.getParsingHelp());\n583:             ft.setText(notationProviderName.toString());\n584:         }\n585:     }\n586: \n587:     /**\n588:      * Utility function to localize the given string with help text,\n589:      * and show it in the status bar of the ArgoUML window.\n590:      * This function is used in favour of the inline call\n591:      * to enable later improvements; e.g. it would be possible to\n592:      * show a help-balloon. TODO: Work this out.\n593:      * One matter to possibly improve: show multiple lines.\n594:      *\n595:      * @param s the given string to be localized and shown\n596:      */\n597:     protected void showHelp(String s) {\n598:         ProjectBrowser.getInstance().getStatusBar().showStatus(\n599:                 Translator.localize(s));\n600:     }\n601: \n602:     /**\n603:      * This method is called after the user finishes editing a text\n604:      * field that is in the FigEdgeModelElement.  Determine which field\n605:      * and update the model.  This class handles the name, subclasses\n606:      * should override to handle other text elements.\n607:      *\n608:      * @param ft the text Fig that has been edited\n609:      */\n610:     protected void textEdited(FigText ft) {\n611:         if (ft == nameFig) {\n612:             if (getOwner() == null)\n613:                 return;\n614:             ft.setText(notationProviderName.parse(ft.getText()));\n615:         }\n616:     }\n617: \n618:     /**\n619:      * @param f the Fig\n620:      * @return true if editable\n621:      */\n622:     protected boolean canEdit(Fig f) {\n623:         return true;\n624:     }\n625: \n626:     ////////////////////////////////////////////////////////////////\n627:     // event handlers - MouseListener implementation\n628: \n629:     /**\n630:      * @see java.awt.event.MouseListener#mousePressed(java.awt.event.MouseEvent)\n631:      */\n632:     public void mousePressed(MouseEvent me) {\n633:     }\n634: \n635:     /**\n636:      * @see java.awt.event.MouseListener#mouseReleased(java.awt.event.MouseEvent)\n637:      */\n638:     public void mouseReleased(MouseEvent me) {\n639:     }\n640: \n641:     /**\n642:      * @see java.awt.event.MouseListener#mouseEntered(java.awt.event.MouseEvent)\n643:      */\n644:     public void mouseEntered(MouseEvent me) {\n645:     }\n646: \n647:     /**\n648:      * @see java.awt.event.MouseListener#mouseExited(java.awt.event.MouseEvent)\n649:      */\n650:     public void mouseExited(MouseEvent me) {\n651:     }\n652: \n653:     /**\n654:      * If the user double clicks on anu part of this FigNode, pass it\n655:      * down to one of the internal Figs.  This allows the user to\n656:      * initiate direct text editing.\n657:      *\n658:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n659:      */\n660:     public void mouseClicked(MouseEvent me) {\n661:         if (me.isConsumed())\n662:             return;\n663:         if (me.getClickCount() >= 2) {\n664:             Fig f = hitFig(new Rectangle(me.getX() - 2, me.getY() - 2, 4, 4));\n665:             if (f instanceof MouseListener && canEdit(f))\n666: \t\t((MouseListener) f).mouseClicked(me);\n667:         }\n668:         me.consume();\n669:     }\n670: \n671:     /**\n672:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n673:      */\n674:     public void keyPressed(KeyEvent ke) {\n675:     }\n676: \n677:     /**\n678:      * @see java.awt.event.KeyListener#keyReleased(java.awt.event.KeyEvent)\n679:      */\n680:     public void keyReleased(KeyEvent ke) {\n681:     }\n682: \n683:     /**\n684:      * @see java.awt.event.KeyListener#keyTyped(java.awt.event.KeyEvent)\n685:      */\n686:     public void keyTyped(KeyEvent ke) {\n687:         if (ke.isConsumed())\n688:             return;\n689:         if (nameFig != null && canEdit(nameFig))\n690:             nameFig.keyTyped(ke);\n691:     }\n692: \n693: \n694:     /**\n695:      * Rerenders the fig if needed. This functionality was originally\n696:      * the functionality of modelChanged but modelChanged takes the\n697:      * event now into account.<p>\n698:      * \n699:      * NOTE: If you override this method you probably also want to \n700:      * override the modelChanged() method\n701:      * TODO: Call this method something sensible. What it does rather than\n702:      * one example of when it is called. Its purpose seems to be to update\n703:      * everything if anything has changed. Not very efficient.\n704:      */\n705:     protected void renderingChanged() {\n706:         updateNameText();\n707:         updateStereotypeText();\n708:         damage();\n709:     }\n710:     \n711:     ////////////////////////////////////////////////////////////////\n712:     // internal methods\n713: \n714:     /**\n715:      * This is called after any part of the UML ModelElement has\n716:      * changed. This method automatically updates the name FigText.\n717:      * Subclasses should override and update other parts.\n718:      *\n719:      * @param e the event\n720:      */\n721:     protected void modelChanged(PropertyChangeEvent e) {\n722:         if (e instanceof DeleteInstanceEvent) {\n723:             // No need to update if model element went away\n724:             return;\n725:         }\n726:         if (e.getSource() == getOwner()\n727:                 && \"name\".equals(e.getPropertyName())) {\n728:             updateNameText();\n729:         }\n730: \n731:         updateStereotypeText();\n732: \n733:         if (ActionAutoResize.isAutoResizable()) {\n734:             CmdSetPreferredSize cmdSPS =\n735:                 new CmdSetPreferredSize(CmdSetPreferredSize.MINIMUM_SIZE);\n736:             cmdSPS.setFigToResize(this);\n737:             cmdSPS.doIt();\n738:         }\n739: \n740:         // Update attached node figures\n741:         // TODO: Presumably this should only happen on a add or remove event\n742:         determineFigNodes();\n743:     }\n744:     \n745:     /**\n746:      * generate the notation for the modelelement and stuff it into the text Fig\n747:      */\n748:     protected void updateNameText() {\n749: \n750:         if (getOwner() == null) {\n751:             return;\n752:         }\n753:         if (notationProviderName != null) {\n754:             String nameStr = notationProviderName.toString();\n755:             nameFig.setText(nameStr);\n756:             calcBounds();\n757:             setBounds(getBounds());\n758:         }\n759:     }\n760: \n761:     /**\n762:      * generate the notation for the stereotype and stuff it into the text Fig\n763:      */\n764:     protected void updateStereotypeText() {\n765:         if (getOwner() == null) {\n766:             return;\n767:         }\n768:         Object modelElement = getOwner();\n769:         stereotypeFig.setOwner(modelElement);\n770:         ((FigStereotypesCompartment) stereotypeFig).populate();\n771:     }\n772: \n773:     /**\n774:      * This method should only be called once for any one Fig instance that\n775:      * represents a model element (ie not for a FigEdgeNote).\n776:      * It is called either by the constructor that takes an model element as an\n777:      * argument or it is called by PGMLStackParser after it has created the Fig\n778:      * by use of the empty constructor.\n779:      * The assigned model element (owner) must not change during the lifetime\n780:      * of the Fig.\n781:      * TODO: It is planned to refactor so that there is only one Fig\n782:      * constructor. When this is achieved this method can refactored out.\n783:      * \n784:      * @param owner the model element that this Fig represents.\n785:      * @throws IllegalArgumentException if the owner given is not a model\n786:      * element\n787:      * @see org.tigris.gef.presentation.Fig#setOwner(java.lang.Object)\n788:      */\n789:     public void setOwner(Object owner) {\n790:         if (owner == null) {\n791:             throw new IllegalArgumentException(\"An owner must be supplied\");\n792:         }\n793:         if (getOwner() != null) {\n794:             throw new IllegalStateException(\n795:                     \"The owner cannot be changed once set\");\n796:         }\n797:         if (!Model.getFacade().isAModelElement(owner)) {\n798:             throw new IllegalArgumentException(\n799:                     \"The owner must be a model element - got a \"\n800:                     + owner.getClass().getName());\n801:         }\n802:         super.setOwner(owner);\n803:         initNotationProviders(owner);\n804:         renderingChanged();\n805:         updateListeners(null, owner);\n806:     }\n807: \n808:     /**\n809:      * Create the NotationProviders.\n810:      * \n811:      * @param own the current owner\n812:      */\n813:     protected void initNotationProviders(Object own) {\n814:         if (Model.getFacade().isAModelElement(own)) {\n815:             notationProviderName =\n816:                 NotationProviderFactory2.getInstance().getNotationProvider(\n817:                         NotationProviderFactory2.TYPE_NAME, own);\n818:             notationProviderName.putValue(\"edge\", Boolean.TRUE);\n819:         }\n820:     }\n821:     \n822:     /**\n823:      * Implementations of this method should register/unregister the fig for all\n824:      * (model)events. For FigEdgeModelElement only the fig itself is registered\n825:      * as listening to events fired by the owner itself. But for, for example,\n826:      * FigAssociation the fig must also register for events fired by the\n827:      * stereotypes of the owner. <p>\n828:      * \n829:      * This function is used in UMLDiagram, which removes all listeners \n830:      * to all Figs when a diagram is not displayed, and restore them\n831:      * when it becomes visible again. <p>\n832:      * \n833:      * In this case, it is not imperative that indeed ALL listeners are \n834:      * updated, as long as the ones removed get added again and vice versa. <p>\n835:      * \n836:      * Additionally, this function may be used by the modelChanged() function.\n837:      * <p>\n838:      * \n839:      * In this case, it IS imperative that all listeners get removed / added.\n840:      * \n841:      * @param newOwner the new owner for the listeners\n842:      */\n843:     protected void updateListeners(Object oldOwner, Object newOwner) {\n844:         if (oldOwner == newOwner) {\n845:             LOG.warn(\"Listeners being added and removed from the same owner\");\n846:         }\n847:         if (oldOwner != null) {\n848:             removeElementListener(oldOwner);\n849:         }\n850:         if (newOwner != null) {\n851:             addElementListener(newOwner);\n852:         }\n853:     }\n854: \n855:     /**\n856:      * @see org.tigris.gef.presentation.Fig#setLayer(org.tigris.gef.base.Layer)\n857:      */\n858:     public void setLayer(Layer lay) {\n859:         super.setLayer(lay);\n860:         getFig().setLayer(lay);\n861:     }\n862: \n863:     /**\n864:      * @see org.tigris.gef.presentation.Fig#deleteFromModel()\n865:      */\n866:     public void deleteFromModel() {\n867:         Object own = getOwner();\n868:         if (own != null) {\n869:             ProjectManager.getManager().getCurrentProject().moveToTrash(own);\n870:         }\n871:         Iterator it = getPathItemFigs().iterator();\n872:         while (it.hasNext()) {\n873:             ((Fig) it.next()).deleteFromModel();\n874:         }\n875:         super.deleteFromModel();\n876:     }\n877: \n878:     /**\n879:      * This default implementation simply requests the default notation.\n880:      *\n881:      * @see org.argouml.notation.NotationContext#getContextNotation()\n882:      * @deprecated by MVW in V0.21.3. Replaced by \n883:      * {@link ProjectSettings#getNotationName()}\n884:      */\n885:     public NotationName getContextNotation() {\n886:         Project p = ProjectManager.getManager().getCurrentProject();\n887:         return p.getProjectSettings().getNotationName();\n888:     }\n889: \n890:     /**\n891:      * @see org.argouml.notation.NotationContext#setContextNotation(org.argouml.notation.NotationName)\n892:      */\n893:     public void setContextNotation(NotationName nn) {\n894:         // not supported - see issue 3140.\n895:     }\n896: \n897:     /**\n898:      * @see org.argouml.application.events.ArgoNotationEventListener#notationChanged(org.argouml.application.events.ArgoNotationEvent)\n899:      */\n900:     public void notationChanged(ArgoNotationEvent event) {\n901:         if (getOwner() == null) return;\n902:         initNotationProviders(getOwner());\n903:         renderingChanged();\n904:     }\n905: \n906:     /**\n907:      * @see org.argouml.application.events.ArgoNotationEventListener#notationAdded(org.argouml.application.events.ArgoNotationEvent)\n908:      */\n909:     public void notationAdded(ArgoNotationEvent event) {\n910:     }\n911: \n912:     /**\n913:      * @see org.argouml.application.events.ArgoNotationEventListener#notationRemoved(org.argouml.application.events.ArgoNotationEvent)\n914:      */\n915:     public void notationRemoved(ArgoNotationEvent event) {\n916:     }\n917: \n918:     /**\n919:      * @see org.argouml.application.events.ArgoNotationEventListener#notationProviderAdded(org.argouml.application.events.ArgoNotationEvent)\n920:      */\n921:     public void notationProviderAdded(ArgoNotationEvent event) {\n922:     }\n923: \n924:     /**\n925:      * @see org.argouml.application.events.ArgoNotationEventListener#notationProviderRemoved(org.argouml.application.events.ArgoNotationEvent)\n926:      */\n927:     public void notationProviderRemoved(ArgoNotationEvent event) {\n928:     }\n929: \n930:     /**\n931:      * @see org.tigris.gef.presentation.Fig#hit(java.awt.Rectangle)\n932:      */\n933:     public boolean hit(Rectangle r) {\n934: \t// Check if labels etc have been hit\n935: \t// Apparently GEF does require PathItems to be \"annotations\"\n936: \t// which ours aren't, so until that is resolved...\n937: \tIterator it = getPathItemFigs().iterator();\n938: \twhile (it.hasNext()) {\n939: \t    Fig f = (Fig) it.next();\n940: \t    if (f.hit(r))\n941: \t\treturn true;\n942: \t}\n943: \treturn super.hit(r);\n944:     }\n945: \n946:     /**\n947:      * @see org.tigris.gef.presentation.Fig#removeFromDiagram()\n948:      */\n949:     final public void removeFromDiagram() {\n950:         Fig delegate = getRemoveDelegate();\n951:         if (delegate instanceof FigNodeModelElement) {\n952:             ((FigNodeModelElement) delegate).removeFromDiagramImpl();\n953:         } else if (delegate instanceof FigEdgeModelElement) {\n954:             ((FigEdgeModelElement) delegate).removeFromDiagramImpl();\n955:         } else if (delegate != null) {\n956:             removeFromDiagramImpl();\n957:         }\n958:     }\n959:     \n960:     /**\n961:      * Subclasses should override this to redirect a remove request from\n962:      * one Fig to another.\n963:      * e.g. FigEdgeAssociationClass uses this to delegate the remove to\n964:      * its attached FigAssociationClass.\n965:      * @return\n966:      */\n967:     protected Fig getRemoveDelegate() {\n968:         return this;\n969:     }\n970:     \n971:     protected void removeFromDiagramImpl() {\n972:         Object o = getOwner();\n973:         if (o != null) {\n974:             removeElementListener(o);\n975:         }\n976:         ArgoEventPump.removeListener(this);\n977: \n978:         Iterator it = getPathItemFigs().iterator();\n979:         while (it.hasNext()) {\n980:             Fig fig = (Fig) it.next();\n981:             fig.removeFromDiagram();\n982:         }\n983: \n984:         /* TODO: MVW: Why the next action?\n985:          * Deleting a fig from 1 diagram should not influence others!\n986:          * */\n987:         // GEF does not take into account the multiple diagrams we have\n988:         // therefore we loop through our diagrams and delete each and every\n989:         // occurence on our own\n990:         it = ProjectManager.getManager().getCurrentProject().getDiagrams()\n991:                 .iterator();\n992:         while (it.hasNext()) {\n993:             ArgoDiagram diagram = (ArgoDiagram) it.next();\n994:             diagram.damage();\n995:         }\n996: \n997:         /* TODO: MVW: Should we not call damage()\n998:          * for diagrams AFTER the next step? */\n999:         super.removeFromDiagram();\n1000:     }\n1001:     \n1002:     protected void superRemoveFromDiagram() {\n1003:         super.removeFromDiagram();\n1004:     }\n1005: \n1006:     /**\n1007:      * @see org.tigris.gef.presentation.Fig#damage()\n1008:      */\n1009:     public void damage() {\n1010:         super.damage();\n1011:         getFig().damage();\n1012:     }\n1013: \n1014:     /**\n1015:      * <p>Updates the classifiers the edge is attached to.  <p>Calls a\n1016:      * helper method (layoutThisToSelf) to avoid this edge\n1017:      * disappearing if the new source and dest are the same node.\n1018:      *\n1019:      * @return boolean whether or not the update was sucessful\n1020:      */\n1021:     protected boolean determineFigNodes() {\n1022:         Object owner = getOwner();\n1023:         if (owner == null || getLayer() == null) {\n1024:             LOG.error(\"The FigEdge has no owner or its layer is null\");\n1025:             return false;\n1026:         }\n1027: \n1028:         Object newSource = getSource();\n1029:         Object newDest = getDestination();\n1030: \n1031:         Fig currentSourceFig = getSourceFigNode();\n1032:         Fig currentDestFig = getDestFigNode();\n1033:         Object currentSource = null;\n1034:         Object currentDestination = null;\n1035:         if (currentSourceFig != null && currentDestFig != null) {\n1036:             currentSource = currentSourceFig.getOwner();\n1037:             currentDestination = currentDestFig.getOwner();\n1038:         }\n1039:         if (newSource != currentSource || newDest != currentDestination) {\n1040:             Fig newSourceFig = getNoEdgePresentationFor(newSource);\n1041:             Fig newDestFig = getNoEdgePresentationFor(newDest);\n1042:             if (newSourceFig != currentSourceFig) {\n1043:                 setSourceFigNode((FigNode) newSourceFig);\n1044:                 setSourcePortFig(newSourceFig);\n1045: \n1046:             }\n1047:             if (newDestFig != currentDestFig) {\n1048:                 setDestFigNode((FigNode) newDestFig);\n1049:                 setDestPortFig(newDestFig);\n1050:             }\n1051:             ((FigNode) newSourceFig).updateEdges();\n1052:             ((FigNode) newDestFig).updateEdges();\n1053:             calcBounds();\n1054: \n1055:             // adapted from SelectionWButtons from line 280\n1056:             // calls a helper method to avoid this edge disappearing\n1057:             // if the new source and dest are the same node.\n1058:             if (newSourceFig == newDestFig) {\n1059: \n1060:                 layoutThisToSelf();\n1061:             }\n1062: \n1063:         }\n1064: \n1065:         return true;\n1066:     }\n1067: \n1068:     /**\n1069:      * A version of GEF's presentationFor() method which \n1070:      * @param element ModelElement to return presentation for\n1071:      * @return the Fig representing the presentation\n1072:      */\n1073:     private Fig getNoEdgePresentationFor(Object element) {\n1074:         if (element == null) {\n1075:             throw new IllegalArgumentException(\"Can't search for a null owner\");\n1076:         }\n1077:         List contents = getLayer().getContentsNoEdges();\n1078:         int figCount = contents.size();\n1079:         for (int figIndex = 0; figIndex < figCount; ++figIndex) {\n1080:             Fig fig = (Fig) contents.get(figIndex);\n1081:             if (fig.getOwner() == element) {\n1082:                 return fig;\n1083:             }\n1084:         }\n1085:         throw new IllegalStateException(\"Can't find a FigNode representing \"\n1086:                 + Model.getFacade().getName(element));\n1087:     }\n1088: \n1089: \n1090:     /**\n1091:      * helper method for updateClassifiers() in order to automatically\n1092:      * layout an edge that is now from and to the same node type.\n1093:      * <p>adapted from SelectionWButtons from line 280\n1094:      */\n1095:     private void layoutThisToSelf() {\n1096: \n1097:         FigPoly edgeShape = new FigPoly();\n1098:         //newFC = _content;\n1099:         Point fcCenter =\n1100:             new Point(getSourceFigNode().getX() / 2,\n1101:                     getSourceFigNode().getY() / 2);\n1102:         Point centerRight =\n1103:             new Point(\n1104: \t\t      (int) (fcCenter.x\n1105: \t\t\t     + getSourceFigNode().getSize().getWidth() / 2),\n1106: \t\t      fcCenter.y);\n1107: \n1108:         int yoffset = (int) ((getSourceFigNode().getSize().getHeight() / 2));\n1109:         edgeShape.addPoint(fcCenter.x, fcCenter.y);\n1110:         edgeShape.addPoint(centerRight.x, centerRight.y);\n1111:         edgeShape.addPoint(centerRight.x + 30, centerRight.y);\n1112:         edgeShape.addPoint(centerRight.x + 30, centerRight.y + yoffset);\n1113:         edgeShape.addPoint(centerRight.x, centerRight.y + yoffset);\n1114: \n1115:         // place the edge on the layer and update the diagram\n1116:         this.setBetweenNearestPoints(true);\n1117:         edgeShape.setLineColor(Color.black);\n1118:         edgeShape.setFilled(false);\n1119:         edgeShape.setComplete(true);\n1120:         this.setFig(edgeShape);\n1121:     }\n1122: \n1123:     /**\n1124:      * Returns the source of the edge. The source is the owner of the\n1125:      * node the edge travels from in a binary relationship. For\n1126:      * instance: for a classifierrole, this is the sender.\n1127:      * @return a model element\n1128:      */\n1129:     protected Object getSource() {\n1130:         Object owner = getOwner();\n1131:         if (owner != null) {\n1132:             return Model.getCoreHelper().getSource(owner);\n1133:         }\n1134:         return null;\n1135:     }\n1136:     /**\n1137:      * Returns the destination of the edge. The destination is the\n1138:      * owner of the node the edge travels to in a binary\n1139:      * relationship. For instance: for a classifierrole, this is the\n1140:      * receiver.\n1141:      * @return a model element\n1142:      */\n1143:     protected Object getDestination() {\n1144:         Object owner = getOwner();\n1145:         if (owner != null) {\n1146:             return Model.getCoreHelper().getDestination(owner);\n1147:         }\n1148:         return null;\n1149:     }\n1150: \n1151:     /**\n1152:      * @see org.tigris.gef.presentation.Fig#postLoad()\n1153:      */\n1154:     public void postLoad() {\n1155:         ArgoEventPump.removeListener(this);\n1156:         ArgoEventPump.addListener(this);\n1157:     }\n1158: \n1159:     /**\n1160:      * @return Returns the lABEL_FONT.\n1161:      */\n1162:     public static Font getLabelFont() {\n1163:         return LABEL_FONT;\n1164:     }\n1165: \n1166:     /**\n1167:      * @return Returns the iTALIC_LABEL_FONT.\n1168:      */\n1169:     public static Font getItalicLabelFont() {\n1170:         return ITALIC_LABEL_FONT;\n1171:     }\n1172: \n1173:     /**\n1174:      * @param allowed true if the function RemoveFromDiagram is allowed\n1175:      */\n1176:     protected void allowRemoveFromDiagram(boolean allowed) {\n1177:         this.removeFromDiagram = allowed;\n1178:     }\n1179: \n1180:     /**\n1181:      * Set the associated Diagram Interchange element.\n1182:      * \n1183:      * @param element the element to be associated with this Fig\n1184:      */\n1185:     public void setDiElement(DiElement element) {\n1186:         this.diEleme