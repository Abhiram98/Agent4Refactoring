on.data_types.MExpressionEditor;\n133: import ru.novosoft.uml.foundation.data_types.MIterationExpression;\n134: import ru.novosoft.uml.foundation.data_types.MMessageDirectionKind;\n135: import ru.novosoft.uml.foundation.data_types.MMultiplicity;\n136: import ru.novosoft.uml.foundation.data_types.MMultiplicityRange;\n137: import ru.novosoft.uml.foundation.data_types.MObjectSetExpression;\n138: import ru.novosoft.uml.foundation.data_types.MOperationDirectionKind;\n139: import ru.novosoft.uml.foundation.data_types.MOrderingKind;\n140: import ru.novosoft.uml.foundation.data_types.MParameterDirectionKind;\n141: import ru.novosoft.uml.foundation.data_types.MProcedureExpression;\n142: import ru.novosoft.uml.foundation.data_types.MPseudostateKind;\n143: import ru.novosoft.uml.foundation.data_types.MScopeKind;\n144: import ru.novosoft.uml.foundation.data_types.MTimeExpression;\n145: import ru.novosoft.uml.foundation.data_types.MVisibilityKind;\n146: import ru.novosoft.uml.foundation.extension_mechanisms.MStereotype;\n147: import ru.novosoft.uml.foundation.extension_mechanisms.MTaggedValue;\n148: import ru.novosoft.uml.model_management.MElementImport;\n149: import ru.novosoft.uml.model_management.MModel;\n150: import ru.novosoft.uml.model_management.MPackage;\n151: import ru.novosoft.uml.model_management.MSubsystem;\n152: \n153: /**\n154:  * Facade object for the Model component in ArgoUML.<p>\n155:  *\n156:  * The purpose of this Facade object is to allow for decoupling other modules\n157:  * from the insides of the model. For this purpose all of the methods in this\n158:  * class give away and accept handles (of type java.lang.Object) to the\n159:  * objects within the model.<p>\n160:  *\n161:  * This is just getters and recognizers. This is because the Model\n162:  * component has an extremely complicated internal data structure\n163:  * with lots of internal dependencies. To manipulate these there is\n164:  * a whole set of factories and helpers within the Model that is to\n165:  * be used but to use them you need knowledge of the internals of\n166:  * the Model, specifically the NS-UML objects.<p>\n167:  *\n168:  * All methods in this facade are static.<p>\n169:  *\n170:  * Signature for all recognizers in this Facade:\n171:  * <ul>\n172:  * <li>public static boolean isATYPE(Object handle)\n173:  * <li>public static boolean isPROPERTY(Object handle)\n174:  * </ul>\n175:  *\n176:  * Signature for all getters in this Facade:\n177:  * <ul>\n178:  * <li>public static Object getTYPE(Object handle) - 1..1\n179:  * <li>public static Iterator/Collection getTYPES(Object handle) - 0..*\n180:  * <li>public static String getName(Object handle) - Name\n181:  * </ul>\n182:  *\n183:  * @stereotype utility\n184:  * @author Linus Tolke\n185:  */\n186: public class ModelFacade {\n187:     ////////////////////////////////////////////////////////////////\n188:     // constants\n189: \n190:     /**\n191:      * Logger.\n192:      */\n193:     private static final Logger LOG = Logger.getLogger(ModelFacade.class);\n194: \n195:     // TODO: deprecate all of these constants in favor of a separate declaration\n196: \n197:     /**\n198:      * The constant ACC_PUBLIC determines visibility.\n199:      */\n200:     public static final short ACC_PUBLIC = 1;\n201: \n202:     /**\n203:      * The constant ACC_PRIVATE determines visibility.\n204:      */\n205:     public static final short ACC_PRIVATE = 2;\n206: \n207:     /**\n208:      * The constant ACC_PROTECTED determines visibility.\n209:      */\n210:     public static final short ACC_PROTECTED = 3;\n211: \n212:     /**\n213:      * The constant CLASSIFIER_SCOPE determines scope.\n214:      */\n215:     public static final short CLASSIFIER_SCOPE = 1;\n216:     /**\n217:      * The constant INSTANCE_SCOPE determines scope.\n218:      */\n219:     public static final short INSTANCE_SCOPE = 2;\n220: \n221:     /**\n222:      * The constant GUARDED determines concurrency.\n223:      */\n224:     public static final short GUARDED = 1;\n225: \n226:     /**\n227:      * The constant SEQUENTIAL determines concurrency.\n228:      */\n229:     public static final short SEQUENTIAL = 2;\n230: \n231:     // Types of line\n232:     /**\n233:      * Type of line: ABSTRACTION.\n234:      */\n235:     public static final Object ABSTRACTION = MAbstraction.class;\n236: \n237:     /**\n238:      * Type of line: ASSOCIATION.\n239:      */\n240:     public static final Object ASSOCIATION = MAssociation.class;\n241: \n242:     /**\n243:      * Type of line: ASSOCIATION_CLASS.\n244:      */\n245:     public static final Object ASSOCIATION_CLASS = MAssociationClass.class;\n246: \n247:     /**\n248:      * Type of line: ASSOCIATION_ROLE.\n249:      */\n250:     public static final Object ASSOCIATION_ROLE = MAssociationRole.class;\n251: \n252:     /**\n253:      * Type of line: COLLABORATION.\n254:      */\n255:     public static final Object COLLABORATION = MCollaboration.class;\n256: \n257:     /**\n258:      * Type of line: DEPENDENCY.\n259:      */\n260:     public static final Object DEPENDENCY = MDependency.class;\n261: \n262:     /**\n263:      * Type of line: EXTEND.\n264:      */\n265:     public static final Object EXTEND = MExtend.class;\n266: \n267:     /**\n268:      * Type of line: GENERALIZATION.\n269:      */\n270:     public static final Object GENERALIZATION = MGeneralization.class;\n271: \n272:     /**\n273:      * Type of line: INCLUDE.\n274:      */\n275:     public static final Object INCLUDE = MInclude.class;\n276: \n277:     /**\n278:      * Type of line: LINK.\n279:      */\n280:     public static final Object LINK = MLink.class;\n281: \n282:     /**\n283:      * Type of line: MESSAGE.\n284:      */\n285:     public static final Object MESSAGE = MMessage.class;\n286: \n287:     /**\n288:      * Type of line: PERMISSION.\n289:      */\n290:     public static final Object PERMISSION = MPermission.class;\n291: \n292:     /**\n293:      * Type of line: SIGNAL.\n294:      */