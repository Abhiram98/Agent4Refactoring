                        "content": "Here is the source code to modify: \nsrc_new/org/argouml/uml/diagram/static_structure/ui/FigInterface.java: \n1: // $Id$\n2: // Copyright (c) 1996-2004 The Regents of the University of California. All\n3: // Rights Reserved. Permission to use, copy, modify, and distribute this\n4: // software and its documentation without fee, and without a written\n5: // agreement is hereby granted, provided that the above copyright notice\n6: // and this paragraph appear in all copies.  This software program and\n7: // documentation are copyrighted by The Regents of the University of\n8: // California. The software program and documentation are supplied \"AS\n9: // IS\", without any accompanying services from The Regents. The Regents\n10: // does not warrant that the operation of the program will be\n11: // uninterrupted or error-free. The end-user understands that the program\n12: // was developed for research purposes and is advised not to rely\n13: // exclusively on the program for any reason.  IN NO EVENT SHALL THE\n14: // UNIVERSITY OF CALIFORNIA BE LIABLE TO ANY PARTY FOR DIRECT, INDIRECT,\n15: // SPECIAL, INCIDENTAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOST PROFITS,\n16: // ARISING OUT OF THE USE OF THIS SOFTWARE AND ITS DOCUMENTATION, EVEN IF\n17: // THE UNIVERSITY OF CALIFORNIA HAS BEEN ADVISED OF THE POSSIBILITY OF\n18: // SUCH DAMAGE. THE UNIVERSITY OF CALIFORNIA SPECIFICALLY DISCLAIMS ANY\n19: // WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\n20: // MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THE SOFTWARE\n21: // PROVIDED HEREUNDER IS ON AN \"AS IS\" BASIS, AND THE UNIVERSITY OF\n22: // CALIFORNIA HAS NO OBLIGATIONS TO PROVIDE MAINTENANCE, SUPPORT,\n23: // UPDATES, ENHANCEMENTS, OR MODIFICATIONS.\n24: \n25: package org.argouml.uml.diagram.static_structure.ui;\n26: \n27: import java.awt.Color;\n28: import java.awt.Dimension;\n29: import java.awt.Rectangle;\n30: import java.awt.event.InputEvent;\n31: import java.awt.event.KeyEvent;\n32: import java.awt.event.MouseEvent;\n33: import java.beans.PropertyVetoException;\n34: import java.text.ParseException;\n35: import java.util.Collection;\n36: import java.util.Iterator;\n37: import java.util.Vector;\n38: \n39: import org.apache.log4j.Logger;\n40: import org.argouml.application.api.Notation;\n41: import org.argouml.language.helpers.NotationHelper;\n42: import org.argouml.model.ModelFacade;\n43: import org.argouml.model.uml.UmlFactory;\n44: import org.argouml.model.uml.UmlModelEventPump;\n45: import org.argouml.ui.ArgoJMenu;\n46: import org.argouml.ui.ProjectBrowser;\n47: import org.argouml.ui.targetmanager.TargetManager;\n48: import org.argouml.uml.diagram.ui.CompartmentFigText;\n49: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n50: import org.argouml.uml.diagram.ui.FigOperationsCompartment;\n51: import org.argouml.uml.diagram.ui.OperationsCompartmentContainer;\n52: import org.argouml.uml.diagram.ui.UMLDiagram;\n53: import org.argouml.uml.diagram.ui.ActionAddNote;\n54: import org.argouml.uml.generator.ParserDisplay;\n55: import org.argouml.uml.diagram.ui.ActionAddOperation;\n56: import org.argouml.uml.diagram.ui.ActionCompartmentDisplay;\n57: import org.argouml.uml.diagram.ui.ActionModifier;\n58: import org.tigris.gef.base.Editor;\n59: import org.tigris.gef.base.Globals;\n60: import org.tigris.gef.base.Selection;\n61: import org.tigris.gef.graph.GraphModel;\n62: import org.tigris.gef.presentation.Fig;\n63: import org.tigris.gef.presentation.FigGroup;\n64: import org.tigris.gef.presentation.FigRect;\n65: import org.tigris.gef.presentation.FigText;\n66: \n67: import ru.novosoft.uml.MElementEvent;\n68: \n69: /** Class to display graphics for a UML Interface in a diagram. \n70:  * \n71:  */\n72: public class FigInterface extends FigNodeModelElement \n73:         implements OperationsCompartmentContainer {\n74:     \n75:     private static final Logger LOG = Logger.getLogger(FigInterface.class);\n76: \n77:     ////////////////////////////////////////////////////////////////\n78:     // constants\n79: \n80:     //These are the positions of child figs inside this fig\n81:     //They mst be added in the constructor in this order.\n82:     private static final int BLINDER_POSN = 3;\n83:     private static final int OPERATIONS_POSN = 4;\n84:     \n85:     ////////////////////////////////////////////////////////////////\n86:     // instance variables\n87: \n88:     /**\n89:      * The vector of graphics for operations (if any). First one is the\n90:      * rectangle for the entire operations box.<p>\n91:      */\n92:     private FigOperationsCompartment operVec;\n93: \n94:     /**\n95:      * A rectangle to blank out the line that would otherwise appear at the\n96:      * bottom of the stereotype text box.<p>\n97:      */\n98:     private FigRect stereoLineBlinder;\n99: \n100:     /**\n101:      * Manages residency of an interface within a component on a deployment\n102:      * diagram. Not clear why it is public, or even why it is an instance\n103:      * variable (rather than local to the method).<p>\n104:      */\n105:     public Object resident =\n106:         UmlFactory.getFactory().getCore().createElementResidence();\n107: \n108:     /**\n109:      * Text highlighted by mouse actions on the diagram.<p>\n110:      */\n111:     private CompartmentFigText highlightedFigText = null;\n112: \n113:     ////////////////////////////////////////////////////////////////\n114:     // constructors\n115: \n116:     /**\n117:      * Main constructor for a {@link FigInterface}.\n118:      *\n119:      * Parent {@link FigNodeModelElement} will have created the main\n120:      * box {@link #getBigPort()} and its name {@link #getNameFig()}\n121:      * and stereotype (@link #getStereotypeFig()}. This constructor\n122:      * creates a box for the operations.<p>\n123:      *\n124:      * The properties of all these graphic elements are adjusted\n125:      * appropriately. The main boxes are all filled and have outlines.<p>\n126:      *\n127:      * For reasons I don't understand the stereotype is created in a box\n128:      * with lines. So we have to created a blanking rectangle to overlay the\n129:      * bottom line, and avoid three compartments showing.<p>\n130:      *\n131:      * <em>Warning</em>. Much of the graphics positioning is hard coded. The\n132:      * overall figure is placed at location (10,10). The name compartment (in\n133:      * the parent {@link FigNodeModelElement} is 21 pixels high. The\n134:      * stereotype compartment is created 15 pixels high in the parent, but we\n135:      * change it to 19 pixels, 1 more than ({@link #STEREOHEIGHT} here. The\n136:      * operations box is created at 19 pixels, 2 more than\n137:      * {@link #ROWHEIGHT}.<p>\n138:      *\n139:      * CAUTION: This constructor (with no arguments) is the only one\n140:      * that does enableSizeChecking(false), all others must set it true.\n141:      * This is because this constructor is the only one called when loading\n142:      * a project. In this case, the parsed size must be maintained.<p>\n143:      */\n144:     public FigInterface() {\n145: \n146:         // Set name box. Note the upper line will be blanked out if there is\n147:         // eventually a stereotype above.\n148:         getNameFig().setLineWidth(1);\n149:         getNameFig().setFilled(true);\n150: \n151:         operVec = \n152:             new FigOperationsCompartment(10, 31 + ROWHEIGHT, 60, ROWHEIGHT + 2);\n153: \n154:         // Set properties of the stereotype box. Make it 1 pixel higher than\n155:         // before, so it overlaps the name box, and the blanking takes out both\n156:         // lines. Initially not set to be displayed, but this will be changed\n157:         // when we try to render it, if we find we have a stereotype.\n158:         setStereotype(NotationHelper.getLeftGuillemot()\n159: \t\t      + \"Interface\" + NotationHelper.getRightGuillemot());\n160:         getStereotypeFigText().setExpandOnly(true);\n161:         getStereotypeFig().setFilled(true);\n162:         getStereotypeFig().setLineWidth(1);\n163:         getStereotypeFigText().setEditable(false);\n164:         getStereotypeFig().setHeight(STEREOHEIGHT + 1);\n165:         // +1 to have 1 pixel overlap with getNameFig()\n166:         getStereotypeFig().setVisible(true);\n167: \n168:         // A thin rectangle to overlap the boundary line between stereotype\n169:         // and name. This is just 2 pixels high, and we rely on the line\n170:         // thickness, so the rectangle does not need to be filled. Whether to\n171:         // display is linked to whether to display the stereotype.\n172:         stereoLineBlinder =\n173: \t    new FigRect(11, 10 + STEREOHEIGHT, 58, 2,\n174: \t\t\tColor.white, Color.white);\n175:         stereoLineBlinder.setLineWidth(1);\n176:         stereoLineBlinder.setVisible(true);\n177: \n178:         // Put all the bits together, suppressing bounds calculations until\n179:         // we're all done for efficiency.\n180:         enableSizeChecking(false);\n181:         setSuppressCalcBounds(true);\n182:         addFig(getBigPort());\n183:         addFig(getStereotypeFig());\n184:         addFig(getNameFig());\n185:         addFig(stereoLineBlinder);\n186:         addFig(operVec);\n187:         setSuppressCalcBounds(false);\n188: \n189:         // Set the bounds of the figure to the total of the above (hardcoded)\n190:         enableSizeChecking(true);\n191:         setBounds(10, 10, 60, 21 + ROWHEIGHT);\n192:     }\n193: \n194:     /**\n195:      * Constructor for use if this figure is created for an\n196:      * existing interface node in the metamodel.<p>\n197:      *\n198:      * Set the figure's name according to this node. This is used when the\n199:      * user click's on 'add to diagram' in the navpane.  Don't know if this\n200:      * should rather be done in one of the super classes, since similar code\n201:      * is used in FigClass.java etc.  Andreas Rueckert\n202:      * &lt;a_rueckert@gmx.net&gt;<p>\n203:      *\n204:      * @param gm   Not actually used in the current implementation\n205:      *\n206:      * @param node The UML object being placed.\n207:      */\n208:     public FigInterface(GraphModel gm, Object node) {\n209:         this();\n210:         setOwner(node);\n211:         enableSizeChecking(true);\n212:         if (ModelFacade.isAInterface(node)\n213: \t        && (ModelFacade.getName(node) != null)) {\n214:             getNameFig().setText(ModelFacade.getName(node));\n215: \t}\n216:     }\n217: \n218:     /**\n219:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#getH()\n220:      */\n221:     public String placeString() {\n222:         return \"new Interface\";\n223:     }\n224: \n225:     /**\n226:      * @see java.lang.Object#clone()\n227:      */\n228:     public Object clone() {\n229:         FigInterface figClone = (FigInterface) super.clone();\n230:         Iterator it = figClone.getFigs(null).iterator();\n231:         figClone.setBigPort((FigRect) it.next());\n232:         figClone.setStereotypeFig((FigText) it.next());\n233:         figClone.setNameFig((FigText) it.next());\n234:         figClone.stereoLineBlinder = (FigRect) it.next();\n235:         figClone.operVec = (FigOperationsCompartment) it.next();\n236:         return figClone;\n237:     }\n238: \n239:     ////////////////////////////////////////////////////////////////\n240:     // accessors\n241: \n242:     /**\n243:      * @see org.tigris.gef.presentation.Fig#makeSelection()\n244:      */\n245:     public Selection makeSelection() {\n246:         return new SelectionInterface(this);\n247:     }\n248: \n249:     /**\n250:      * Build a collection of menu items relevant for a right-click\n251:      * popup menu on an Interface.\n252:      *\n253:      * @param     me     a mouse event\n254:      * @return           a collection of menu items\n255:      */\n256:     public Vector getPopUpActions(MouseEvent me) {\n257:         Vector popUpActions = super.getPopUpActions(me);\n258:         ArgoJMenu addMenu = new ArgoJMenu(BUNDLE, \"menu.popup.add\");\n259:         addMenu.add(ActionAddOperation.getSingleton());\n260:         addMenu.add(ActionAddNote.getSingleton());\n261:         popUpActions.insertElementAt(addMenu,\n262:             popUpActions.size() - POPUP_ADD_OFFSET);\n263:         ArgoJMenu showMenu = new ArgoJMenu(BUNDLE, \"menu.popup.show\");\n264:         if (operVec.isVisible()) {\n265:             showMenu.add(ActionCompartmentDisplay.HideOperCompartment);\n266:         } else {\n267:             showMenu.add(ActionCompartmentDisplay.ShowOperCompartment);\n268:         }\n269: \n270:         popUpActions.insertElementAt(showMenu,\n271:             popUpActions.size() - POPUP_ADD_OFFSET);\n272: \n273:         // Block added by BobTarling 7-Jan-2001\n274:         Object minterface = /*(MInterface)*/ getOwner();\n275:         ArgoJMenu modifierMenu = new ArgoJMenu(BUNDLE, \"menu.popup.modifiers\");\n276: \n277:         modifierMenu.addCheckItem(\n278: \t\tnew ActionModifier(\"Public\",\n279: \t\t\t\t   \"visibility\", \"getVisibility\",\n280: \t\t\t\t   \"setVisibility\",\n281: \t\t\t\t   /*(MInterface)*/ minterface,\n282: \t\t\t\t   (Class) ModelFacade.VISIBILITYKIND,\n283: \t\t\t\t   ModelFacade.PUBLIC_VISIBILITYKIND,\n284: \t\t\t\t   null));\n285:         modifierMenu.addCheckItem(\n286: \t\tnew ActionModifier(\"Abstract\",\n287: \t\t\t\t   \"isAbstract\", \"isAbstract\", \"setAbstract\",\n288: \t\t\t\t   minterface));\n289:         modifierMenu.addCheckItem(\n290: \t\tnew ActionModifier(\"Leaf\", \"isLeaf\", \"isLeaf\", \"setLeaf\",\n291: \t\t\t\t   minterface));\n292:         modifierMenu.addCheckItem(\n293: \t\tnew ActionModifier(\"Root\", \"isRoot\", \"isRoot\", \"setRoot\",\n294: \t\t\t\t   minterface));\n295: \n296:         popUpActions.insertElementAt(modifierMenu,\n297:             popUpActions.size() - POPUP_ADD_OFFSET);\n298:         // end of block\n299: \n300:         return popUpActions;\n301:     }\n302: \n303:     /**\n304:      * Getter for operVec\n305:      * @return operVec\n306:      */\n307:     public FigGroup getOperationsFig() {\n308:         return operVec;\n309:     }\n310: \n311:     /**\n312:      * Returns the status of the operation field.\n313:      * @return true if the operations are visible, false otherwise\n314:      */\n315:     public boolean isOperationsVisible() {\n316:         return operVec.isVisible();\n317:     }\n318: \n319:     /**\n320:      * @param isVisible true will show the operations compartiment\n321:      */\n322:     public void setOperationsVisible(boolean isVisible) {\n323:         Rectangle rect = getBounds();\n324:         int h =\n325: \t    isCheckSize()\n326: \t    ? ((ROWHEIGHT * Math.max(1, operVec.getFigs(null).size() - 1) + 2)\n327: \t       * rect.height\n328: \t       / getMinimumSize().height)\n329: \t    : 0;\n330:         if (operVec.isVisible()) {\n331:             if (!isVisible) {\n332:                 damage();\n333:                 Iterator it = operVec.getFigs(null).iterator();\n334:                 while (it.hasNext()) {\n335: \t\t    ((Fig) (it.next())).setVisible(false);\n336:                 }\n337:                 operVec.setVisible(false);\n338:                 setBounds(rect.x, rect.y, rect.width, rect.height - h);\n339:             }\n340:         } else {\n341:             if (isVisible) {\n342:                 Iterator it = operVec.getFigs(null).iterator();\n343:                 while (it.hasNext()) {\n344: \t\t    ((Fig) (it.next())).setVisible(true);\n345:                 }\n346:                 operVec.setVisible(true);\n347:                 setBounds(rect.x, rect.y, rect.width, rect.height + h);\n348:                 damage();\n349:             }\n350:         }\n351:     }\n352: \n353:     /**\n354:      * Gets the minimum size permitted for an interface on the diagram.<p>\n355:      *\n356:      * Parts of this are hardcoded, notably the fact that the name\n357:      * compartment has a minimum height of 21 pixels.<p>\n358:      *\n359:      * @return  the size of the minimum bounding box.\n360:      */\n361:     public Dimension getMinimumSize() {\n362: \n363:         // Use \"aSize\" to build up the minimum size. Start with the size of the\n364:         // name compartment and build up.\n365: \n366:         Dimension aSize = getNameFig().getMinimumSize();\n367:         if (aSize.height < 21) {\n368:             aSize.height = 21;\n369:         }\n370: \n371:         // If we have a stereotype displayed, then allow some space for that\n372:         // (width and height)\n373: \n374:         if (getStereotypeFig().isVisible()) {\n375:             aSize.width =\n376: \t\tMath.max(aSize.width,\n377: \t\t\t getStereotypeFig().getMinimumSize().width);\n378:             aSize.height += STEREOHEIGHT;\n379:         }\n380: \n381:         // Allow space for each of the operations we have\n382: \n383:         if (operVec.isVisible()) {\n384: \n385:             // Loop through all the operations, to find the widest (remember\n386:             // the first fig is the box for the whole lot, so ignore it).\n387: \n388:             Iterator it = operVec.getFigs(null).iterator();\n389:             it.next(); // ignore\n390: \n391:             while (it.hasNext()) {\n392:                 int elemWidth =\n393: \t\t    ((FigText) it.next()).getMinimumSize().width + 2;\n394:                 aSize.width = Math.max(aSize.width, elemWidth);\n395:             }\n396:             aSize.height +=\n397: \t\tROWHEIGHT * Math.max(1, operVec.getFigs(null).size() - 1) + 1;\n398:         }\n399: \n400:         // we want to maintain a minimum width for Interfaces\n401:         aSize.width = Math.max(60, aSize.width);\n402: \n403:         // And now aSize has the answer\n404: \n405:         return aSize;\n406:     }\n407: \n408:     /**\n409:      * @see org.tigris.gef.presentation.Fig#setFillColor(java.awt.Color)\n410:      */\n411:     public void setFillColor(Color lColor) {\n412:         super.setFillColor(lColor);\n413:         stereoLineBlinder.setLineColor(lColor);\n414:     }\n415: \n416:     /**\n417:      * @see org.tigris.gef.presentation.Fig#setLineColor(java.awt.Color)\n418:      */\n419:     public void setLineColor(Color lColor) {\n420:         super.setLineColor(lColor);\n421:         stereoLineBlinder.setLineColor(stereoLineBlinder.getFillColor());\n422:     }\n423: \n424:     /**\n425:      * @see org.tigris.gef.presentation.Fig#translate(int, int)\n426:      */\n427:     public void translate(int dx, int dy) {\n428:         super.translate(dx, dy);\n429:         Editor ce = Globals.curEditor();\n430:         Selection sel = ce.getSelectionManager().findSelectionFor(this);\n431:         if (sel instanceof SelectionClass) {\n432:             ((SelectionClass) sel).hideButtons();\n433:         }\n434:     }\n435: \n436:     ////////////////////////////////////////////////////////////////\n437:     // user interaction methods\n438: \n439:     /**\n440:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n441:      */\n442:     public void mouseClicked(MouseEvent me) {\n443:         super.mouseClicked(me);\n444: \tif (me.isShiftDown()\n445:                 && TargetManager.getInstance().getTargets().size() > 0) {\n446: \t    return;\n447:         }\n448: \n449:         int i = 0;\n450:         Editor ce = Globals.curEditor();\n451:         Selection sel = ce.getSelectionManager().findSelectionFor(this);\n452:         if (sel instanceof SelectionClass)\n453:              ((SelectionClass) sel).hideButtons();\n454:         unhighlight();\n455:         //display op properties if necessary:\n456:         Rectangle r = new Rectangle(me.getX() - 1, me.getY() - 1, 2, 2);\n457:         Fig f = hitFig(r);\n458:         if (f == operVec && operVec.getHeight() > 0) {\n459:             // TODO: in future version of GEF call getFigs returning array\n460:             Vector v = new Vector(operVec.getFigs(null));\n461:             i = (v.size() - 1)\n462: \t\t* (me.getY() - f.getY() - 3)\n463: \t\t/ operVec.getHeight();\n464:             if (i >= 0 && i < v.size() - 1) {\n465:                 me.consume();\n466:                 f = (Fig) v.elementAt(i + 1);\n467:                 ((CompartmentFigText) f).setHighlighted(true);\n468:                 highlightedFigText = (CompartmentFigText) f;\n469:                 TargetManager.getInstance().setTarget(f);\n470:             }\n471:         }\n472:     }\n473: \n474:     /**\n475:      * @see java.awt.event.MouseListener#mouseExited(java.awt.event.MouseEvent)\n476:      */\n477:     public void mouseExited(MouseEvent me) {\n478:         super.mouseExited(me);\n479:         unhighlight();\n480:     }\n481: \n482:     /**\n483:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n484:      */\n485:     public void keyPressed(KeyEvent ke) {\n486:         int key = ke.getKeyCode();\n487:         if (key == KeyEvent.VK_UP || key == KeyEvent.VK_DOWN) {\n488:             CompartmentFigText ft = unhighlight();\n489:             if (ft != null) {\n490:                 // TODO: in future version of GEF call getFigs returning array\n491:                 int i = new Vector(operVec.getFigs(null)).indexOf(ft);\n492:                 if (i != -1) {\n493:                     if (key == KeyEvent.VK_UP) {\n494:                         ft =\n495: \t\t\t    (CompartmentFigText)\n496: \t\t\t    getPreviousVisibleFeature(ft, i);\n497:                     } else {\n498:                         ft =\n499: \t\t\t    (CompartmentFigText)\n500: \t\t\t    getNextVisibleFeature(ft, i);\n501:                     }\n502:                     if (ft != null) {\n503:                         ft.setHighlighted(true);\n504:                         highlightedFigText = ft;\n505:                         return;\n506:                     }\n507:                 }\n508:             }\n509:         } else if (key == KeyEvent.VK_ENTER && highlightedFigText != null) {\n510:             highlightedFigText.startTextEditor(ke);\n511:             ke.consume();\n512:             return;\n513:         }\n514:         super.keyPressed(ke);\n515:     }\n516: \n517:     /**\n518:      * @see org.tigris.gef.presentation.Fig#setEnclosingFig(org.tigris.gef.presentation.Fig)\n519:      */\n520:     public void setEnclosingFig(Fig encloser) {\n521:         Fig oldEncloser = getEnclosingFig();\n522:         super.setEnclosingFig(encloser);\n523:         if (!(ModelFacade.isAModelElement(getOwner())))\n524:             return;\n525:         Object me = /*(MModelElement)*/ getOwner();\n526:         Object m = null;\n527: \n528:         try {\n529:             // If moved into an Package\n530:             if (encloser != null\n531:                     && oldEncloser != encloser\n532:                     && ModelFacade.isAPackage(encloser.getOwner())) {\n533:                 ModelFacade.setNamespace(me,\n534: \t\t\t\t\t /*(MNamespace)*/ encloser.getOwner());\n535:             }\n536: \n537:             // If default Namespace is not already set\n538:             if (ModelFacade.getNamespace(me) == null\n539: \t\t    && (TargetManager.getInstance().getTarget()\n540: \t\t       instanceof UMLDiagram)) {\n541:                 m = /*(MNamespace)*/\n542: \t\t    ((UMLDiagram) TargetManager.getInstance().getTarget())\n543: \t\t    .getNamespace();\n544:                 ModelFacade.setNamespace(me, m);\n545:             }\n546:         } catch (Exception e) {\n547:             LOG.error(\"could not set package due to:\" + e\n548: \t\t      + \"' at \" + encloser, e);\n549:         }\n550: \n551:         // The next if-clause is important for the Deployment-diagram\n552:         // it detects if the enclosing fig is a component, in this case\n553:         // the ImplementationLocation will be set for the owning MInterface\n554:         if (encloser != null\n555: \t        && (ModelFacade.isAComponent(encloser.getOwner()))) {\n556:             Object component = /*(MComponent)*/ encloser.getOwner();\n557:             Object in = /*(MInterface)*/ getOwner();\n558:             ModelFacade.setImplementationLocation(resident, component);\n559:             ModelFacade.setResident(resident, in);\n560:         } else {\n561:             ModelFacade.setImplementationLocation(resident, null);\n562:             ModelFacade.setResident(resident, null);\n563:         }\n564:     }\n565: \n566:     ////////////////////////////////////////////////////////////////\n567:     // internal methods\n568: \n569:     /**\n570:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEdited(org.tigris.gef.presentation.FigText)\n571:      */\n572:     protected void textEdited(FigText ft) throws PropertyVetoException {\n573:         super.textEdited(ft);\n574:         Object cls = /*(MClassifier)*/ getOwner();\n575:         if (cls == null) {\n576:             return;\n577:         }\n578:         // TODO: in future version of GEF call getFigs returning array\n579:         int i = new Vector(operVec.getFigs(null)).indexOf(ft);\n580:         if (i != -1) {\n581:             highlightedFigText = (CompartmentFigText) ft;\n582:             highlightedFigText.setHighlighted(true);\n583:             try {\n584:                 ParserDisplay.SINGLETON\n585: \t\t    .parseOperationFig(cls,\n586: \t\t\t\t       /*(MOperation)*/\n587: \t\t\t\t       highlightedFigText.getOwner(),\n588: \t\t\t\t       highlightedFigText.getText().trim());\n589:                 ProjectBrowser.getInstance().getStatusBar().showStatus(\"\");\n590:             } catch (ParseException pe) {\n591:                 ProjectBrowser.getInstance().getStatusBar()\n592: \t\t    .showStatus(\"Error: \" + pe + \" at \" + pe.getErrorOffset());\n593:             }\n594:             return;\n595:         }\n596:     }\n597: \n598:     /**\n599:      * @param ft the figtext holding t