r found.\n3137:      */\n3138:     private Object walk(Object/* MMessage */r, int steps, boolean strict) {\n3139:         Object/* MMessage */act = ModelFacade.getActivator(r);\n3140:         while (steps > 0) {\n3141:             Iterator it = ModelFacade.getMessages3(r).iterator();\n3142:             do {\n3143:                 if (!it.hasNext())\n3144:                     return (strict ? null : r);\n3145:                 r = /* (MMessage) */it.next();\n3146:             } while (ModelFacade.getActivator(r) != act);\n3147:             steps--;\n3148:         }\n3149:         return r;\n3150:     }\n3151: \n3152:     /**\n3153:      * Finds the root candidates in a collection c, ie the messages in c that\n3154:      * has the activator a (may be null) and has no predecessor with the same\n3155:      * activator. If veto isn't null, then the message in veto will not be\n3156:      * included in the Collection of candidates.\n3157:      */\n3158:     private Collection findCandidateRoots(Collection c, Object/* MMessage */a,\n3159:             Object/* MMessage */veto) {\n3160:         Iterator it = c.iterator();\n3161:         Vector v = new Vector();\n3162:         while (it.hasNext()) {\n3163:             Object m = /* (MMessage) */it.next();\n3164:             if (m == veto)\n3165:                 continue;\n3166:             if (ModelFacade.getActivator(m) != a)\n3167:                 continue;\n3168:             Iterator it2 = ModelFacade.getPredecessors(m).iterator();\n3169:             boolean candidate = true;\n3170:             while (it2.hasNext()) {\n3171:                 Object m2 = /* (MMessage) */it2.next();\n3172:                 if (ModelFacade.getActivator(m2) == a)\n3173:                     candidate = false;\n3174:             }\n3175:             if (candidate)\n3176:                 v.add(m);\n3177:         }\n3178:         return v;\n3179:     }\n3180: \n3181:     /**\n3182:      * Finds the messages in Collection c that has message a as activator.\n3183:      */\n3184:     private Collection filterWithActivator(Collection c, Object/*MMessage*/a) {\n3185:         Iterator it = c.iterator();\n3186:         Vector v = new Vector();\n3187:         while (it.hasNext()) {\n3188:             Object m = /* (MMessage) */it.next();\n3189:             if (ModelFacade.getActivator(m) == a)\n3190:                 v.add(m);\n3191:         }\n3192:         return v;\n3193:     }\n3194: \n3195:     /**\n3196:      * Finds the message in ClassifierRole r that has the message number written\n3197:      * in n. If it isn't found, null is returned.\n3198:      */\n3199:     private Object findMsg(Object/* MClassifierRole */r, String n) {\n3200:         Collection c = ModelFacade.getMessages1(r);\n3201:         Iterator it = c.iterator();\n3202:         while (it.hasNext()) {\n3203:             Object msg = /* (MMessage) */it.next();\n3204:             String gname = GeneratorDisplay.getInstance()\n3205:                     .generateMessageNumber(msg);\n3206:             if (compareMsgNumbers(gname, n))\n3207:                 return msg;\n3208:         }\n3209:         return null;\n3210:     }\n3211: \n3212:     /**\n3213:      * Compares two message numbers with each other to see if they are equal, in\n3214:      * the sense that they refer to the same position in a call tree.\n3215:      */\n3216:     private boolean compareMsgNumbers(String n1, String n2) {\n3217:         return isMsgNumberStartOf(n1, n2) && isMsgNumberStartOf(n2, n1);\n3218:     }\n3219: \n3220:     /**\n3221:      * Compares two message numbers n1, n2 with each other to determine if n1\n3222:      * specifies a the same position as n2 in a call tree or n1 specifies a\n3223:      * position that is a father of the position specified by n2.\n3224:      */\n3225:     private boolean isMsgNumberStartOf(String n1, String n2) {\n3226:         int i, j, len, jlen;\n3227:         len = n1.length();\n3228:         jlen = n2.length();\n3229:         i = 0;\n3230:         j = 0;\n3231:         for (; i < len;) {\n3232:             int ibv, isv;\n3233:             int jbv, jsv;\n3234: \n3235:             ibv = 0;\n3236:             for (; i < len; i++) {\n3237:                 char c = n1.charAt(i);\n3238:                 if (c < '0' || c > '9')\n3239:                     break;\n3240:                 ibv *= 10;\n3241:                 ibv += c - '0';\n3242:             }\n3243:             isv = 0;\n3244:             for (; i < len; i++) {\n3245:                 char c = n1.charAt(i);\n3246:                 if (c < 'a' || c > 'z')\n3247:                     break;\n3248:                 isv *= 26;\n3249:                 isv += c - 'a';\n3250:             }\n3251: \n3252:             jbv = 0;\n3253:             for (; j < jlen; j++) {\n3254:                 char c = n2.charAt(j);\n3255:                 if (c < '0' || c > '9')\n3256:                     break;\n3257:                 jbv *= 10;\n3258:                 jbv += c - '0';\n3259:             }\n3260:             jsv = 0;\n3261:             for (; j < jlen; j++) {\n3262:                 char c = n2.charAt(j);\n3263:                 if (c < 'a' || c > 'z')\n3264:                     break;\n3265:                 jsv *= 26;\n3266:                 jsv += c - 'a';\n3267:             }\n3268: \n3269:             if (ibv != jbv || isv != jsv) {\n3270:                 return false;\n3271:             }\n3272: \n3273:             if (i < len && n1.charAt(i) != '.') {\n3274:                 return false;\n3275:             } else\n3276:                 i++;\n3277: \n3278:             if (j < jlen && n2.charAt(j) != '.') {\n3279:                 return false;\n3280:             } else\n3281:                 j++;\n3282:         }\n3283:         return true;\n3284:     }\n3285: \n3286:     /**\n3287:      * Finds the operations in Collection c with name name and params number of\n3288:      * parameters. If no operation is found, one is created. The applicable\n3289:      * operations are returned.\n3290:      *\n3291:      * @param c the collection of operations to be searched\n3292:      * @param name the name of the operation to be found\n3293:      * @param params the number of parameters of the operation to be found\n3294:      * @return the sought operation\n3295:      */\n3296:     private Vector getOperation(Collection c, String name, int params) {\n3297:         Vector options = new Vector();\n3298:         Iterator it;\n3299: \n3300:         if (name == null || name.length() == 0)\n3301:             return options;\n3302: \n3303:         it = c.iterator();\n3304:         while (it.hasNext()) {\n3305:             Object clf = /* (MClassifier) */it.next();\n3306:             Collection oe = ModelFacade.getFeatures(clf);\n3307:             Iterator it2 = oe.iterator();\n3308:             while (it2.hasNext()) {\n3309:                 Object me = /* (MModelElement) */it2.next();\n3310:                 if (!(ModelFacade.isAOperation(me)))\n3311:                     continue;\n3312: \n3313:                 Object op = /* (MOperation) */me;\n3314:                 if (!name.equals(ModelFacade.getName(op)))\n3315:                     continue;\n3316:                 if (params != countParameters(op))\n3317:                     continue;\n3318:                 options.add(op);\n3319:             }\n3320:         }\n3321:         if (options.size() > 0)\n3322:             return options;\n3323: \n3324:         it = c.iterator();\n3325:         if (it.hasNext()) {\n3326:             String expr = name + \"(\";\n3327:             int i;\n3328:             for (i = 0; i < params; i++) {\n3329:                 if (i > 0)\n3330:                     expr += \", \";\n3331:                 expr += \"param\" + (i + 1);\n3332:             }\n3333:             expr += \")\";\n3334:             // Jaap Branderhorst 2002-23-09 added next lines to link\n3335:             // parameters and operations to the figs that represent\n3336:             // them\n3337:             Object cls = /* (MClassifier) */it.next();\n3338:             Object op = UmlFactory.getFactory().getCore().buildOperation(cls);\n3339: \n3340:             try {\n3341:                 parseOperation(expr, op);\n3342:             } catch (ParseException pe) {\n3343:                 LOG.error(\"Unexpected ParseException in getOperation: \" + pe,\n3344:                         pe);\n3345: \n3346:             }\n3347:             options.add(op);\n3348:         }\n3349:         return options;\n3350:     }\n3351: \n3352:     /**\n3353:      * Counts the number of parameters that are not return values.\n3354:      */\n3355:     private int countParameters(Object bf) {\n3356:         Collection c = ModelFacade.getParameters(bf);\n3357:         Iterator it = c.iterator();\n3358:         int count = 0;\n3359: \n3360:         while (it.hasNext()) {\n3361:             Object p = it.next();\n3362:             if (ModelFacade.isReturn(p))\n3363:                 continue;\n3364:             count++;\n3365:         }\n3366: \n3367:         return count;\n3368:     }\n3369: \n3370:     /**\n3371:      * Parses a message order specification.\n3372:      */\n3373:     private static int parseMsgOrder(String s) {\n3374:         int i, t;\n3375:         int v = 0;\n3376: \n3377:         t = s.length();\n3378:         for (i = 0; i < t; i++) {\n3379:             char c = s.charAt(i);\n3380:             if (c < 'a' || c > 'z')\n3381:                 throw new NumberFormatException();\n3382:             v *= 26;\n3383:             v += c - 'a';\n3384:         }\n3385: \n3386:         return v;\n3387:     }\n3388: \n3389:     /**\n3390:      * Finds the break between message number and (possibly) message order.\n3391:      */\n3392:     private static int findMsgOrderBreak(String s) {\n3393:         int i, t;\n3394: \n3395:         t = s.length();\n3396:         for (i = 0; i < t; i++) {\n3397:             char c = s.charAt(i);\n3398:             if (c < '0' || c > '9')\n3399:                 break;\n3400:         }\n3401:         return i;\n3402:     }\n3403: \n3404:     /**\n3405:      * Parse a line of the form: \"name: action\"\n3406:      * \n3407:      * @param sti\n3408:      *            the stimulus object to which the string applies\n3409:      * @param s\n3410:      *            the string to be parsed.\n3411:      */\n3412:     public void parseStimulus(Object sti, String s) {\n3413:         // strip any trailing semi-colons\n3414:         s = s.trim();\n3415:         if (s.length() == 0)\n3416:             return;\n3417:         if (s.charAt(s.length() - 1) == ';')\n3418:             s = s.substring(0, s.length() - 2);\n3419: \n3420:         //cut trailing string \"new Action\"\n3421:         s = s.trim();\n3422:         if (s.length() == 0)\n3423:             return;\n3424:         if (s.endsWith(\"new Action\"))\n3425:             s = s.substring(0, s.length() - 10);\n3426: \n3427:         String name = \"\";\n3428:         String action = \"\";\n3429:         String actionfirst = \"\";\n3430:         if (s.indexOf(\":\", 0) > -1) {\n3431:             name = s.substring(0, s.indexOf(\":\")).trim();\n3432:             actionfirst = s.substring(s.indexOf(\":\") + 1).trim();\n3433:             if (actionfirst.indexOf(\":\", 0) > 1) {\n3434:                 action = actionfirst.substring(0, actionfirst.indexOf(\":\"))\n3435:                         .trim();\n3436:             } else\n3437:                 action = actionfirst;\n3438:         } else\n3439:             name = s;\n3440: \n3441:         Object act = ModelFacade.getDispatchAction(sti);\n3442:         ModelFacade.setName(act, action);\n3443:         ModelFacade.setName(sti, name);\n3444:     }\n3445: \n3446:     /**\n3447:      * Parse a textual representatation of an Object, i.e. a line of the form:\n3448:      * <br>       \"name: base-classes\"\n3449:      * <br> with \"base-classes\" a comma-seperated list of class names.\n3450:      * \n3451:      * @param obj\n3452:      *            the UML Object to be parsed.\n3453:      * @param s\n3454:      *            the string to be parsed.\n3455:      */\n3456:     public void parseObject(Object/* MObject */obj, String s) {\n3457:         // strip any trailing semi-colons\n3458:         s = s.trim();\n3459: \n3460:         if (s.length() == 0)\n3461:             return;\n3462:         if (s.charAt(s.length() - 1) == ';')\n3463:             s = s.substring(0, s.length() - 2);\n3464: \n3465:         String name = \"\";\n3466:         String bases = \"\";\n3467:         StringTokenizer baseTokens = null;\n3468: \n3469:         if (s.indexOf(\":\", 0) > -1) {\n3470:             name = s.substring(0, s.indexOf(\":\", 0)).trim();\n3471:             bases = s.substring(s.indexOf(\":\", 0) + 1).trim();\n3472:             baseTokens = new StringTokenizer(bases, \",\");\n3473:         } else {\n3474:             name = s;\n3475:         }\n3476: \n3477:         ModelFacade.setName(obj, name);\n3478: \n3479:         ModelFacade.setClassifiers(obj, new Vector());\n3480:         if (baseTokens != null) {\n3481:             while (baseTokens.hasMoreElements()) {\n3482:                 String typeString = baseTokens.nextToken();\n3483:                 Object type =\n3484:                 /* (MClassifier) */ProjectManager.getManager()\n3485:                         .getCurrentProject().findType(typeString);\n3486:                 ModelFacade.addClassifier(obj, type);\n3487:             }\n3488:         }\n3489:     }\n3490: \n3491:     /**\n3492:      * Parse a line of the form: \"name : base-node\".\n3493:      * \n3494:      * @param noi\n3495:      *            the node instance on which the string applies.\n3496:      * @param s\n3497:      *            the string to be parsed.\n3498:      */\n3499:     public void parseNodeInstance(Object noi, String s) {\n3500:         // strip any trailing semi-colons\n3501:         s = s.trim();\n3502:         if (s.length() == 0)\n3503:             return;\n3504:         if (s.charAt(s.length() - 1) == ';')\n3505:             s = s.substring(0, s.length() - 2);\n3506: \n3507:         String name = \"\";\n3508:         String bases = \"\";\n3509:         StringTokenizer tokenizer = null;\n3510: \n3511:         if (s.indexOf(\":\", 0) > -1) {\n3512:             name = s.substring(0, s.indexOf(\":\")).trim();\n3513:             bases = s.substring(s.indexOf(\":\") + 1).trim();\n3514:         } else {\n3515:             name = s;\n3516:         }\n3517: \n3518:         tokenizer = new StringTokenizer(bases, \",\");\n3519: \n3520:         Vector v = new Vector();\n3521:         Object ns = ModelFacade.getNamespace(noi);\n3522:         if (ns != null) {\n3523:             while (tokenizer.hasMoreElements()) {\n3524:                 String newBase = tokenizer.nextToken();\n3525:                 Object cls = ModelFacade.lookupIn(ns, newBase.trim());\n3526:                 if (cls != null)\n3527:                     v.add(cls);\n3528:             }\n3529:         }\n3530: \n3531:         ModelFacade.setClassifiers(noi, v);\n3532:         ModelFacade.setName(noi, new String(name));\n3533: \n3534:     }\n3535: \n3536:     /**\n3537:      * Parse a line of the form: \"name : base-component\"\n3538:      * \n3539:      * @param coi\n3540:      *            the component instance on which the string applies.\n3541:      * @param s\n3542:      *            the string to parse.\n3543:      */\n3544:     public void parseComponentInstance(Object coi, String s) {\n3545:         // strip any trailing semi-colons\n3546:         s = s.trim();\n3547:         if (s.length() == 0)\n3548:             return;\n3549:         if (s.charAt(s.length() - 1) == ';')\n3550:             s = s.substring(0, s.length() - 2);\n3551: \n3552:         String name = \"\";\n3553:         String bases = \"\";\n3554:         StringTokenizer tokenizer = null;\n3555: \n3556:         if (s.indexOf(\":\", 0) > -1) {\n3557:             name = s.substring(0, s.indexOf(\":\")).trim();\n3558:             bases = s.substring(s.indexOf(\":\") + 1).trim();\n3559:         } else {\n3560:             name = s;\n3561:         }\n3562: \n3563:         tokenizer = new StringTokenizer(bases, \",\");\n3564: \n3565:         Vector v = new Vector();\n3566:         Object ns = ModelFacade.getNamespace(coi);\n3567:         if (ns != null) {\n3568:             while (tokenizer.hasMoreElements()) {\n3569:                 String newBase = tokenizer.nextToken();\n3570:                 Object cls = ModelFacade.lookupIn(ns, newBase.trim());\n3571:                 if (cls != null)\n3572:                     v.add(cls);\n3573:             }\n3574:         }\n3575: \n3576:         ModelFacade.setClassifiers(coi, v);\n3577:         ModelFacade.setName(coi, new String(name));\n3578: \n3579:     }\n3580: \n3581:     /**\n3582:      * This builds a CallAction with default attributes. But without Operation!\n3583:      * \n3584:      * @author MVW\n3585:      * @param s\n3586:      *            string representing the Script of the Action\n3587:      */\n3588:     private Object buildNewCallAction(String s) {\n3589:         Object a = UmlFactory.getFactory().getCommonBehavior()\n3590:                 .createCallAction();\n3591:         Object ae = UmlFactory.getFactory().getDataTypes()\n3592:                 .createActionExpression(\"Java\", s);\n3593:         ModelFacade.setScript(a, ae);\n3594:         ModelFacade.setName(a, \"anon\");\n3595:         return a;\n3596:     }\n3597: \n3598:     /**\n3599:      * Update an existing Action with a new Script.\n3600:      * \n3601:      * @author MVW\n3602:      * @param old the Action\n3603:      * @param s   a string representing a new Script for the ActionExpression\n3604:      */\n3605:     private void updateAction(Object old, String s) {\n3606:         Object ae = ModelFacade.getScript(old); // the ActionExpression\n3607:         String language = \"Java\";\n3608:         if (ae != null) {\n3609:             language = ModelFacade.getLanguage(ae);\n3610:             String body = (String) ModelFacade.getBody(ae);\n3611:             if (body.equals(s)) return;\n3612:         }\n3613:         ae = UmlFactory.getFactory().getDataTypes().createActionExpression(\n3614:                 language, s);\n3615:         ModelFacade.setScript(old, ae);\n3616:     }\n3617: \n3618:     /**\n3619:      * this deletes modelelements, and swallows null without barking\n3620:      * \n3621:      * @author MVW\n3622:      * @param obj\n3623:      *            the modelelement to be deleted\n3624:      */\n3625:     private void delete(Object obj) {\n3626:         if (obj != null)\n3627:             UmlFactory.getFactory().delete(obj);\n3628:     }\n3629: \n3630:     /**\n3631:      * An action state figure shows the action expression of the entry\n3632:      * action according to the UML spec.\n3633:      *\n3634:      * @see org.argouml.uml.generator.Parser#parseActionState(\n3635:      *         java.lang.String, java.lang.Object)\n3636:      */\n3637:     public Object parseActionState(String s, Object actionState) {\n3638:         Object entry = ModelFacade.getEntry(actionState);\n3639:         String language = \"\";\n3640:         if (entry == null) {\n3641:             entry = CommonBehaviorFactory.getFactory()\n3642:                 .buildUninterpretedAction(actionState);\n3643:         } else {\n3644:             language = ModelFacade.getLanguage(ModelFacade.getScript(entry));\n3645:         }\n3646:         Object actionExpression = DataTypesFactory.getFactory()\n3647:             .createActionExpression(language, s);\n3648:         ModelFacade.setScript(entry, actionExpression);\n3649:        return actionState;\n3650:     }\n3651:     \n3652:     /**\n3653:      * An objectFlowState is represented on a diagram by 2 strings:\n3654:      * 1. Classifier name\n3655:      * 2. State name\n3656:      * This function solely handles 1.\n3657:      * \n3658:      * @para