75:       ResourceLoaderWrapper.getResourceLoaderWrapper().lookupIconResource(\"TransitionDown\");\n76:   ////////////////////////////////////////////////////////////////\n77:   // instance varables\n78:   protected boolean _showIncomingLeft = true;\n79:     protected boolean _showIncomingAbove = true;\n80:   protected boolean _showOutgoingRight = true;\n81:     protected boolean _showOutgoingBelow = true;\n82: \n83:   ////////////////////////////////////////////////////////////////\n84:   // constructors\n85: \n86:   /** Construct a new SelectionActionState for the given Fig */\n87:   public SelectionActionState(Fig f) { super(f); }\n88: \n89:   ////////////////////////////////////////////////////////////////\n90:   // accessors\n91: \n92:   public void setOutgoingButtonEnabled(boolean b) {\n93:         setOutgoingRightButtonEnabled(b);\n94:         setIncomingAboveButtonEnabled(b);\n95:   }\n96: \n97:   public void setIncomingButtonEnabled(boolean b) {\n98:         setIncomingLeftButtonEnabled(b);\n99:         setOutgoingBelowButtonEnabled(b);\n100:   }\n101: \n102:   public void setIncomingLeftButtonEnabled(boolean b) {\n103:     _showIncomingLeft = b;\n104:   }\n105: \n106:   public void setOutgoingRightButtonEnabled(boolean b) {\n107:     _showOutgoingRight = b;\n108:   }\n109: \n110:    public void setIncomingAboveButtonEnabled(boolean b) {\n111:     _showIncomingAbove = b;\n112:   }\n113: \n114:   public void setOutgoingBelowButtonEnabled(boolean b) {\n115:     _showOutgoingBelow = b;\n116:   }\n117: \n118:   public void hitHandle(Rectangle r, Handle h) {\n119:     super.hitHandle(r, h);\n120:     if (h.index != -1) return;\n121:     if (!_paintButtons) return;\n122:     Editor ce = Globals.curEditor();\n123:     SelectionManager sm = ce.getSelectionManager();\n124:     if (sm.size() != 1) return;\n125:     ModeManager mm = ce.getModeManager();\n126:     if (mm.includes(ModeModify.class) && _pressedButton == -1) return;\n127:     int cx = _content.getX();\n128:     int cy = _content.getY();\n129:     int cw = _content.getWidth();\n130:     int ch = _content.getHeight();\n131:     int iw = trans.getIconWidth();\n132:     int ih = trans.getIconHeight();\n133:     int iwd = transDown.getIconWidth();\n134:     int ihd = transDown.getIconHeight();\n135:     if (_showOutgoingRight && hitLeft(cx + cw, cy + ch/2, iw, ih, r)) {\n136:       h.index = 12;\n137:       h.instructions = \"Add an outgoing transition\";\n138:     }\n139:     else if (_showIncomingLeft && hitRight(cx, cy + ch/2, iw, ih, r)) {\n140:       h.index = 13;\n141:       h.instructions = \"Add an incoming transition\";\n142:     }\n143:     else if (_showOutgoingBelow && hitAbove(cx+cw/2, cy, iwd, ihd, r)) {\n144:         h.index=14;\n145:         h.instructions = \"Add an incoming transaction\";\n146:     }\n147:     else if (_showIncomingAbove && hitBelow(cx+cw/2,cy+ch, iwd, ihd, r)) {\n148:         h.index=15;\n149:         h.instructions = \"Add an outgoing transaction\";\n150:     }\n151:     else {\n152:       h.index = -1;\n153:       h.instructions = \"Move object(s)\";\n154:     }\n155:   }\n156: \n157: \n158:   /** Paint the handles at the four corners and midway along each edge\n159:    * of the bounding box.  */\n160:   public void paintButtons(Graphics g) {\n161:     int cx = _content.getX();\n162:     int cy = _content.getY();\n163:     int cw = _content.getWidth();\n164:     int ch = _content.getHeight();\n165:     if (_showOutgoingRight) \n166:         paintButtonLeft(trans, g, cx + cw, cy + ch/2, 12);\n167:     if (_showIncomingLeft) \n168:         paintButtonRight(trans, g, cx, cy + ch/2, 13);\n169:     if (_showOutgoingBelow) \n170:         paintButtonAbove(transDown, g, cx + cw/2, cy , 14);\n171:     if (_showIncomingAbove) \n172:         paintButtonBelow(transDown, g, cx+cw/2, cy + ch, 15);\n173:   }\n174: \n175: \n176:   public void dragHandle(int mX, int mY, int anX, int anY, Handle hand) {\n177:     if (hand.index < 10) {\n178:       _paintButtons = false;\n179:       super.dragHandle(mX, mY, anX, anY, hand);\n180:       return;\n181:     }\n182:     int cx = _content.getX(), cy = _content.getY();\n183:     int cw = _content.getWidth(), ch = _content.getHeight();\n184:     int newX = cx, newY = cy, newW = cw, newH = ch;\n185:     Dimension minSize = _content.getMinimumSize();\n186:     int minWidth = minSize.width, minHeight = minSize.height;\n187:     Class edgeClass = null;\n188:     Class nodeClass = MActionStateImpl.class;\n189: \n190:     Editor ce = Globals.curEditor();\n191:     GraphModel gm = ce.getGraphModel();\n192:     if (!(gm instanceof MutableGraphModel)) return;\n193:    \n194:     MutableGraphModel mgm = (MutableGraphModel) gm;\n195: \n196:     int bx = mX, by = mY;\n197:     boolean reverse = false;\n198:     switch (hand.index) {\n199:     case 12: //add outgoing\n200:       edgeClass = MTransition.class;\n201:       by = cy + ch/2;\n202:       bx = cx + cw;\n203:       break;\n204:     case 13: // add incoming\n205:       edgeClass = MTransition.class;\n206:       reverse = true;\n207:       by = cy + ch/2;\n208:       bx = cx;\n209:       break;\n210:      case 14: // add incoming\n211:       edgeClass = MTransition.class;\n212:       reverse = true;\n213:       by = cy ;\n214:       bx = cx + cw/2;\n215:       break;\n216:      case 15: // add outgoing\n217:       edgeClass = MTransition.class;\n218:       by = cy + ch;\n219:       bx = cx + cw/2;\n220:       break;\n221:     default:\n222:       cat.warn(\"invalid handle number\");\n223:       break;\n224:     }\n225:     if (edgeClass != null && nodeClass != null) {\n226:       ModeCreateEdgeAndNode m = new\n227: \tModeCreateEdgeAndNode(ce, edgeClass, nodeClass, false);\n228:       m.setup((FigNode)_content, _content.getOwner(), bx, by, reverse);\n229:       ce.mode(m);\n230:     }\n231:   }\n232: \n233: \n234:   public void buttonClicked(int buttonCode) {\n235:     super.buttonClicked(buttonCode);\n236:     MActionState newNode =  UmlFactory.getFactory().getActivityGraphs().createActionState();\n237: \n238:     FigStateVertex fc = (FigStateVertex) _content;\n239:     MStateVertex oldNode = (MStateVertex) fc.getOwner();\n240: \n241:     Editor ce = Globals.curEditor();\n242:     GraphModel gm = ce.getGraphModel();\n243:     if (!(gm instanceof MutableGraphModel)) return;\n244:     MutableGraphModel mgm = (MutableGraphModel) gm;\n245: \n246:     if (!mgm.canAddNode(oldNode)) return;\n247:     GraphNodeRenderer renderer = ce.getGraphNodeRenderer();\n248:     LayerPerspective lay = (LayerPerspective)\n249:       ce.getLayerManager().getActiveLayer();\n250:     Fig newFC = renderer.getFigNodeFor(gm, lay, oldNode);\n251: \n252:     Rectangle outputRect = new Rectangle(Math.max(0, fc.getX() - 200),\n253: \t\t\t\t\t Math.max(0, fc.getY() - 200),\n254: \t\t\t\t\t fc.getWidth() + 400,\n255: \t\t\t\t\t fc.getHeight() + 400);\n256:     if (buttonCode >=10 && buttonCode <= 13) {\n257:             int x = 0;\n258:             int y = 0; \n259:             if (buttonCode == 10) {\n260:                 // superclass\n261:                 x = fc.getX();\n262:                 y = Math.max(0, fc.getY() - 200);\n263:             }\n264:             else if (buttonCode == 11) {\n265:                 x = fc.getX();\n266:                 y = fc.getY() + fc.getHeight() + 100;\n267:             }\n268:             else if (buttonCode == 12) {\n269:                 x = fc.getX() + fc.getWidth() + 100;\n270:                 y = fc.getY();\n271:             }\n272:             else if (buttonCode == 13) {\n273:                 x = Math.max(0, fc.getX() - 200);\n274:                 y = fc.getY();\n275:                 \n276:             }        \n277:             // place the fig if it is not a selfassociation       \n278:             if (!placeFig(newFC, lay, x, y, outputRect)) return;\n279:         }\n280:   \n281:     ce.add(newFC);\n282:     mgm.addNode(oldNode);\n283: \n284:     FigPoly edgeShape = new FigPoly();\n285:     Point fcCenter = fc.center();\n286:     edgeShape.addPoint(fcCenter.x, fcCenter.y);\n287:     Point newFCCenter = newFC.center();\n288:     edgeShape.addPoint(newFCCenter.x, newFCCenter.y);\n289:     Object newEdge = null;\n290:     if (buttonCode == 12) newEdge = addOutgoingTrans(mgm, oldNode, oldNode);\n291:     else if (buttonCode == 13) newEdge = addIncomingTrans(mgm, oldNode, oldNode);\n292:     else if (buttonCode == 14) newEdge = addIncomingTrans(mgm, oldNode, oldNode);\n293:     else if (buttonCode == 15) newEdge = addOutgoingTrans(mgm, oldNode, oldNode);\n294: \n295:     FigEdge fe = (FigEdge) lay.presentationFor(newEdge);\n296:     edgeShape.setLineColor(Color.black);\n297:     edgeShape.setFilled(false);\n298:     edgeShape._isComplete = true;\n299:     fe.setFig(edgeShape);\n300:     ce.getSelectionManager().select(fc);\n301:   }\n302: \n303:   public Object addOutgoingTrans(MutableGraphModel mgm, MStateVertex oldNode,\n304: \t\t\t    MStateVertex newCls) {\n305:     return mgm.connect(oldNode, newCls, MTransition.class);\n306:   }\n307: \n308:   public Object addIncomingTrans(MutableGraphModel mgm, MStateVertex newNode,\n309: \t\t\t    MStateVertex newCls) {\n310:     return mgm.connect(newCls, newNode, MTransition.class);\n311:   }\n312: \n313:   ////////////////////////////////////////////////////////////////\n314:   // event handlers\n315: \n316: \n317:   public void mouseEntered(MouseEvent me) {\n318:     super.mouseEntered(me);\n319:     //_reverse = me.isShiftDown();\n320:   }\n321: \n322: } /* end class SelectionActionState */\n323: \n324: \n325: \n326: \n327: ",
