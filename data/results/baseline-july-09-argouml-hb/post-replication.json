h(0);\n193:         lifeLine =\n194:             new FigLine(\n195:                 DEFAULT_WIDTH / 2,\n196:                 DEFAULT_HEIGHT,\n197:                 DEFAULT_WIDTH / 2,\n198:                 1000,\n199:                 Color.black);\n200:         lifeLine.setDashed(true);\n201:         linkPositions.add(new ObjectNode(this));\n202:         for (int i = 0;\n203:             i <= lifeLine.getHeight() / SequenceDiagramLayout.LINK_DISTANCE;\n204:             i++) {\n205:             linkPositions.add(new EmptyNode());\n206:         }\n207:         addFig(lifeLine);\n208:         addFig(backgroundBox);\n209:         addFig(getStereotypeFig());\n210:         addFig(getNameFig());\n211:         addFig(outerBox);\n212:     }\n213: \n214:     /**\n215:      * @param node the owner\n216:      */\n217:     public FigClassifierRole(Object node) {\n218:         this();\n219:         setOwner(node);\n220:     }\n221: \n222:     /**\n223:      * When the mouse button is released, this fig will be moved into position\n224:      *\n225:      * @see MouseListener#mouseReleased(MouseEvent)\n226:      */\n227:     public void mouseReleased(MouseEvent me) {\n228:         super.mouseReleased(me);\n229:         Layer lay = Globals.curEditor().getLayerManager().getActiveLayer();\n230:         if (lay instanceof SequenceDiagramLayout) {\n231:             ((SequenceDiagramLayout) lay).putInPosition(this);\n232:         }\n233:     }\n234: \n235:     /**\n236:      * Constructs the contents of the name text box and upates the name text box\n237:      * accordingly. The contents of the name text box itself are NOT updated.\n238:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateNameText()\n239:      */\n240:     protected void updateNameText() {\n241:         String nameText =\n242:             (objectName + \"/\" + classifierRoleNames + \":\" + baseNames)\n243:                 .trim();\n244:         getNameFig().setText(nameText);\n245:         center(getNameFig());\n246:         damage();\n247:     }\n248: \n249:     /**\n250:      * @see FigNodeModelElement#updateStereotypeText()\n251:      */\n252:     protected void updateStereotypeText() {\n253:         super.updateStereotypeText();\n254:         center(getStereotypeFigText());\n255:     }\n256: \n257:     private void center(FigText figText) {\n258:         int newX = this.getX() + this.getHalfWidth() - figText.getHalfWidth();\n259:         if (figText.getX() != newX) {\n260:             figText.setX(newX);\n261:             updateBounds();\n262:         }\n263:     }\n264: \n265:     /**\n266:      * Sets the bounds and coordinates of this Fig. The outerbox (the\n267:      * black box around the upper box) and the background box (the\n268:      * white box at the background) are scaled to the given size. The\n269:      * name text box and the stereo text box are moved to a correct\n270:      * position.\n271:      *\n272:      * @see Fig#setBounds(int, int, int, int)\n273:      */\n274:     public void setBounds(int x, int y, int w, int h) {\n275:         Rectangle oldBounds = getBounds();\n276:         if (getNameFig().getWidth() > w) {\n277:             w = getNameFig().getWidth() + 2 * MARGIN;\n278:         }\n279:         if (getStereotypeFig().getWidth() > w) {\n280:             w = getStereotypeFig().getWidth() + 2 * MARGIN;\n281:         }\n282:         getNameFig().setCenter(\n283:             new Point(x + w / 2,\n284: \t\t      getNameFig().getY() - oldBounds.y + y\n285: \t\t      + getNameFig().getHalfHeight()));\n286:         getStereotypeFig().setCenter(\n287:             new Point(\n288:                 x + w / 2,\n289:                 (getStereotypeFig().getY() - oldBounds.y\n290: \t\t + y + getStereotypeFig().getHalfHeight())));\n291:         reSize(outerBox, x, y, w, h);\n292:         reSize(backgroundBox, x, y, w, h);\n293:         lifeLine.setBounds(\n294:             outerBox.getX() + outerBox.getHalfWidth(),\n295:             outerBox.getY() + outerBox.getHeight(),\n296:             0,\n297:             h - outerBox.getHeight());\n298:         int factor = h / oldBounds.height;\n299:         for (int i = 0; i < figActivations.size(); i++) {\n300:             FigRect fig = (FigRect) figActivations.get(i);\n301:             fig.setBounds(\n302:                 x - oldBounds.x + fig.getX(),\n303:                 y - oldBounds.y + fig.getY(),\n304:                 fig.getWidth(),\n305:                 fig.getHeight());\n306:         }\n307:         for (int i = 0; i < figFigLinkPorts.size(); i++) {\n308:             FigLinkPort fig = (FigLinkPort) figFigLinkPorts.get(i);\n309:             fig.setBounds(\n310:                 x - oldBounds.x + fig.getX(),\n311:                 y - oldBounds.y + fig.getY(),\n312:                 fig.getWidth(),\n313:                 fig.getHeight());\n314:         }\n315:         calcBounds(); //_x = x; _height = y; _w = w; _h = h;\n316:         firePropChange(\"bounds\", oldBounds, getBounds());\n317:     }\n318: \n319:     /**\n320:      * Scales the given fig that must be part of this FigObject.<p>\n321:      *\n322:      * @param f the fig to scale\n323:      * @param x the new x coordinate for the FigObject\n324:      * @param y the new y coordinate for the FigObject\n325:      * @param w the new w coordinate for the FigObject\n326:      * @param h the new h coordinate for the FigObject\n327:      */\n328:     private void reSize(Fig f, int x, int y, int w, int h) {\n329:         if (f.isVisible()) {\n330:             int newX =\n331:                 (_w == 0)\n332:                     ? x\n333:                     : x + (int) ((f.getX() - _x) * ((float) w / (float) _w));\n334:             int newY =\n335:                 (_h == 0)\n336:                     ? y\n337:                     : y + (int) ((f.getY() - _y) * ((float) h / (float) _h));\n338:             int newW =\n339:                 (_w == 0)\n340:                     ? 0\n341:                     : (int) (((float) f.getWidth()) * ((float) w / (float) _w));\n342: \n343:             int newH =\n344:                 (_h == 0)\n345:                     ? 0\n346:                     : (int) (((float) f.getHeight())\n347: \t\t\t     * ((float) h / (float) _h));\n348: \n349:             f.setBounds(newX, newY, newW, newH);\n350:         }\n351:     }\n352: \n353:     /**\n354:      * Returns a beautified name to show in the name text box.<p>\n355:      *\n356:      * @param o is the object\n357:      * @return a name\n358:      */\n359:     private String getBeautifiedName(Object o) {\n360:         String name = Model.getFacade().getName(o);\n361:         if (name == null || name.equals(\"\")) {\n362:             name = \"(anon \" + Model.getFacade().getUMLClassName(o) + \")\";\n363:         }\n364:         return name;\n365:     }\n366: \n367:     /**\n368:      * @see Fig#calcBounds()\n369:      * @see FigNodeModelElement#calcBounds()\n370:      */\n371:     public void calcBounds() {\n372:         Rectangle bounds = outerBox.getBounds();\n373:         bounds.add(lifeLine.getBounds());\n374:         _x = bounds.x;\n375:         _y = bounds.y;\n376:         _h = bounds.height;\n377:         _w = bounds.width;\n378:     }\n379: \n380:     private void removeActivations() {\n381:         for (int i = 0; i < figActivations.size(); i++) {\n382:             getFigs().remove(figActivations.get(i));\n383:         }\n384:         figActivations = new ArrayList();\n385:         calcBounds();\n386:     }\n387: \n388:     private void addActivations() {\n389:         boolean startActivation = false;\n390:         ActivationNode startActivationNode = null;\n391:         ActivationNode endActivationNode = null;\n392:         int x = lifeLine.getX() - WIDTH / 2;\n393:         for (int i = 0; i < linkPositions.size(); i++) {\n394:             Node node = (Node) linkPositions.get(i);\n395:             if (node instanceof ActivationNode\n396:                 && ((ActivationNode) node).isStart()) {\n397:                 startActivationNode = (ActivationNode) node;\n398:                 endActivationNode = null;\n399:             }\n400:             if (node instanceof ActivationNode\n401:                 && ((ActivationNode) node).isEnd()) {\n402: \n403:                 if (startActivationNode == null) {\n404:                     throw new IllegalStateException(\n405: \t\t\t    \"End activation node without \"\n406: \t\t\t    + \"start activation node.\");\n407:                 }\n408: \n409:                 endActivationNode = (ActivationNode) node;\n410:                 int startPos =\n411:                     getYCoordinateForActivationBox(startActivationNode, true);\n412:                 int endPos = 0;\n413:                 if (!endActivationNode.isStart()) {\n414:                     endPos =\n415:                         getYCoordinateForActivationBox(\n416:                             endActivationNode,\n417:                             false);\n418:                 } else {\n419:                     endPos = getYCoordinate(endActivationNode);\n420:                     if (!endActivationNode.isCutOffBottom()) {\n421:                         endPos += SequenceDiagramLayout.LINK_DISTANCE / 2;\n422:                     }\n423:                 }\n424:                 FigRect activation =\n425:                     new FigRect(\n426:                         x,\n427:                         startPos,\n428:                         WIDTH,\n429:                         endPos - startPos,\n430:                         outerBox.getLineColor(),\n431:                         backgroundBox.getFillColor());\n432:                 figActivations.add(activation);\n433:                 addFig(activation);\n434:             }\n435:         }\n436:     }\n437: \n438:     /**\n439:      * First removes all current activation boxes, then add new ones\n440:      * to the figobject depending on the state of the nodes.\n441:      */\n442:     public void updateActivations() {\n443:         removeActivations();\n444:         addActivations();\n445:     }\n446: \n447:     /**\n448:      * The width of the FigObject should be equal to the width of the\n449:      * name or stereo text box.<p>\n450:      *\n451:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateBounds()\n452:      */\n453:     protected void updateBounds() {\n454:         Rectangle bounds = getBounds();\n455:         bounds.width =\n456:             Math.max(\n457:                 getNameFig().getWidth() + 2 * MARGIN,\n458:                 getStereotypeFig().getWidth() + 2 * MARGIN);\n459:         setBounds(bounds);\n460:     }\n461: \n462:     /**\n463:      * Changing the line width should only change the line width of the outerbox\n464:      * and the lifeline. 0 Values are ignored.\n465:      * @see org.tigris.gef.presentation.Fig#setLineWidth(int)\n466:      */\n467:     public void setLineWidth(int w) {\n468:         if (outerBox.getLineWidth() != w && w != 0) {\n469:             outerBox.setLineWidth(w);\n470:             lifeLine.setLineWidth(w);\n471:             damage();\n472:         }\n473:     }\n474: \n475:     /**\n476:      * @see org.tigris.gef.presentation.Fig#setFillColor(java.awt.Color)\n477:      */\n478:     public void setFillColor(Color col) {\n479:         if (col != null && col != backgroundBox.getFillColor()) {\n480:             backgroundBox.setFillColor(col);\n481:             damage();\n482:         }\n483:     }\n484: \n485:     /**\n486:      * @see org.tigris.gef.presentation.Fig#setFilled(boolean)\n487:      */\n488:     public void setFilled(boolean filled) {\n489:         if (backgroundBox.getFilled() != filled) {\n490:             backgroundBox.setFilled(filled);\n491:             damage();\n492:         }\n493:     }\n494: \n495:     /**\n496:      * @see org.tigris.gef.presentation.Fig#getFillColor()\n497:      */\n498:     public Color getFillColor() {\n499:         return backgroundBox.getFillColor();\n500:     }\n501: \n502:     /**\n503:      * @see org.tigris.gef.presentation.Fig#getFilled()\n504:      */\n505:     public boolean getFilled() {\n506:         return backgroundBox.getFilled();\n507:     }\n508: \n509:     /**\n510:      * @see org.tigris.gef.presentation.Fig#getLineColor()\n511:      */\n512:     public Color getLineColor() {\n513:         return outerBox.getLineColor();\n514:     }\n515: \n516:     /**\n517:      * @see org.tigris.gef.presentation.Fig#getLineWidth()\n518:      */\n519:     public int getLineWidth() {\n520:         return outerBox.getLineWidth();\n521:     }\n522: \n523:     /**\n524:      * @see FigNodeModelElement#updateListeners(java.lang.Object)\n525:      */\n526:     protected void updateListeners(Object newOwner) {\n527:         Object oldOwner = getOwner();\n528:         ModelEventPump pump = Model.getPump();\n529:         if (oldOwner != null) {\n530:             pump.removeModelEventListener(this, oldOwner);\n531:         }\n532:         if (Model.getFacade().isAInstance(newOwner)) {\n533:             pump.addModelEventListener(this,\n534: \t\t\t\t       newOwner,\n535: \t\t\t\t       new String[] {\n536: \t\t\t\t\t   \"name\",\n537: \t\t\t\t\t   \"stereotype\",\n538: \t\t\t\t       });\n539:             Iterator it = Model.getFacade().getClassifiers(newOwner).iterator();\n540:             while (it.hasNext()) {\n541:                 Object classifierRole = it.next();\n542:                 pump.removeModelEventListener(this, classifierRole);\n543:                 pump.addModelEventListener(\n544: \t\t\t\t\t   this,\n545: \t\t\t\t\t   classifierRole,\n546: \t\t\t\t\t   new String[] {\n547: \t\t\t\t\t       \"name\",\n548: \t\t\t\t\t       \"base\",\n549: \t\t\t\t\t   });\n550:                 Iterator it2 =\n551:                     Model.getFacade().getBases(classifierRole).iterator();\n552:                 while (it2.hasNext()) {\n553:                     Object base = it2.next();\n554:                     pump.addModelEventListener(this, base, \"name\");\n555:                 }\n556:             }\n557:         }\n558:     }\n559: \n560: \n561:     /**\n562:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#modelChanged(java.beans.PropertyChangeEvent)\n563:      */\n564:     protected void modelChanged(PropertyChangeEvent mee) {\n565:         boolean nameChanged = false;\n566:         if (mee.getSource() == getOwner()\n567:                 && mee.getPropertyName().equals(\"name\")) {\n568:             updateObjectName();\n569:             nameChanged = true;\n570:         } else if (\n571:             Model.getFacade().isAClassifierRole(mee.getSource())\n572:                 && mee.getPropertyName().equals(\"name\")) {\n573:             updateClassifierRoleNames();\n574:             nameChanged = true;\n575:         } else if (\n576:             mee.getSource() == getOwner()\n577:                 && mee.getPropertyName().equals(\"stereotype\")) {\n578:             updateStereotypeText();\n579:         } else if (mee.getPropertyName().equals(\"name\")) {\n580:             updateBaseNames();\n581:             nameChanged = true;\n582:         }\n583:         if (nameChanged) {\n584:             updateNameText();\n585:         }\n586:     }\n587: \n588:     private void updateClassifierRoleNames() {\n589:         String roleNames = \"\";\n590:         Iterator it = Model.getFacade().getClassifiers(getOwner()).iterator();\n591:         while (it.hasNext()) {\n592:             roleNames += getBeautifiedName(it.next());\n593:             if (it.hasNext()) {\n594:                 roleNames += \", \";\n595:             }\n596:         }\n597:         classifierRoleNames = roleNames;\n598:     }\n599: \n600:     private void updateBaseNames() {\n601:         String b = \"\";\n602:         Iterator it = Model.getFacade().getClassifiers(getOwner()).iterator();\n603:         while (it.hasNext()) {\n604:             Iterator it2 = Model.getFacade().getBases(it.next()).iterator();\n605:             while (it2.hasNext()) {\n606:                 b += getBeautifiedName(it2.next());\n607:                 if (it2.hasNext()) {\n608:                     b += \",\";\n609:                 }\n610:             }\n611:             if (it.hasNext()) {\n612:                 b += \",\";\n613:             }\n614:         }\n615:         baseNames = b;\n616:     }\n617: \n618:     private void updateObjectName() {\n619:         objectName = getBeautifiedName(getOwner());\n620:     }\n621: \n622:     /**\n623:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#renderingChanged()\n624:      */\n625:     public void renderingChanged() {\n626:         updateBaseNames();\n627:         updateClassifierRoleNames();\n628:         updateObjectName();\n629:         super.renderingChanged();\n630:     }\n631: \n632:     /**\n633:      * Returns the port for a given coordinate pair. Normally\n634:      * deepHitPort returns the owner of the fig in the FigGroup that\n635:      * is present at the given coordinate pair (returning figs that\n636:      * are added later first). In this case it returns a\n637:      * LinkPort.<p>\n638:      *\n639:      * This method has a side effect of creating a\n640:      * FigLinkPort if ???<p>\n641:      *\n642:      * @see org.tigris.gef.presentation.FigNode#deepHitPort(int, int)\n643:      */\n644:     public Object deepHitPort(int x, int y) {\n645:         Object port = null;\n646:         Rectangle rect = new Rectangle(getX(), y - 16, getWidth(), 32);\n647:         Node foundNode = null;\n648:         if (lifeLine.intersects(rect)) {\n649:             for (int i = linkPositions.indexOf(getObjectNode());\n650:                 i < linkPositions.size();\n651:                 i++) {\n652:                 Node node = (Node) linkPositions.get(i);\n653:                 int position = getYCoordinate(node);\n654:                 if (i < linkPositions.size() - 1) {\n655:                     int nextPosition =\n656:                         getYCoordinate((Node) linkPositions.get(i + 1));\n657:                     if (nextPosition >= y && position < y) {\n658:                         if ((y - position) <= (nextPosition - y)) {\n659:                             foundNode = node;\n660:                         } else {\n661:                             foundNode = (Node) linkPositions.get(i + 1);\n662:                         }\n663:                         break;\n664:                     }\n665:                 } else {\n666:                     foundNode =\n667:                         (Node) linkPositions.get(linkPositions.size() - 1);\n668:                     break;\n669:                 }\n670:             }\n671:             int yCoordinate = 0;\n672:             SequenceDiagramLayout layout = (SequenceDiagramLayout) getLayer();\n673:             if (!layout.getFigLinks(getYCoordinate(foundNode)).isEmpty()) {\n674:                 FigLinkPort figLinkPort =\n675:                     new FigLinkPort(\n676:                         lifeLine.getX() - WIDTH / 2,\n677:                         getYCoordinate(foundNode)\n678:                             + SequenceDiagramLayout.LINK_DISTANCE,\n679:                         lifeLine.getX() + WIDTH / 2);\n680:                 addFig(figLinkPort);\n681:                 figFigLinkPorts.add(figLinkPort);\n682:                 LinkNode linkNode = new LinkNode(getOwner(), figLinkPort);\n683:                 layout.addNode(getIndexOf(foundNode) + 1, linkNode);\n684:                 foundNode = linkNode;\n685:             } else {\n686:                 if (!(foundNode instanceof LinkPort)\n687:                     && !(foundNode instanceof ObjectNode)) {\n688:                     FigLinkPort figLinkPort =\n689:                         new FigLinkPort(\n690:                             lifeLine.getX() - WIDTH / 2,\n691:                             getYCoordinate(foundNode),\n692:                             lifeLine.getX() + WIDTH / 2);\n693:                     addFig(figLinkPort);\n694:                     figFigLinkPorts.add(figLinkPort);\n695:                     LinkNode linkNode = new LinkNode(getOwner(), figLinkPort);\n696:                     linkPositions.set(\n697:                         linkPositions.indexOf(foundNode),\n698:                         linkNode);\n699:                     foundNode = linkNode;\n700:                 }\n701: \n702:             }\n703:             return foundNode;\n704:         } else if (outerBox.intersects(rect)) {\n705:             ObjectNode objectNode = (ObjectNode) getObjectNode();\n706:             if (objectNode.getFigLinkPort() != null\n707:                 && getFigLink(objectNode.getFigLinkPort()) != null) {\n708:                 return null; // cannot connect here\n709:             }\n710:             if (objectNode.getFigLinkPort() == null) {\n711:                 FigLinkPort figLinkPort =\n712:                     new FigLinkPort(\n713:                         lifeLine.getX() - WIDTH / 2,\n714:                         getYCoordinate(foundNode),\n715:                         lifeLine.getX() + WIDTH / 2);\n716:                 objectNode.setFigLinkPort(figLinkPort);\n717:             }\n718:             objectNode.setObject(getOwner());\n719:             return objectNode;\n720:         } else {\n721:             return null;\n722:         }\n723:     }\n724: \n725:     private int getYCoordinate(Node node) {\n726:         int index = linkPositions.indexOf(node);\n727:         int y = 0;\n728:         if (index == 0) {\n729:             y = getY() + outerBox.getHalfHeight();\n730:         } else {\n731:             y =\n732:                 (index - 1) * SequenceDiagramLayout.LINK_DISTANCE\n733:                     + getY()\n734:                     + outerBox.getHeight();\n735:         }\n736:         return y;\n737:     }\n738: \n739:     private int getYCoordinateForActivationBox(Node node, boolean start) {\n740:         int y = getYCoordinate(node);\n741:         if (node instanceof ActivationNode) {\n742:             if (node instanceof ObjectNode) {\n743:                 y = y + outerBox.getHalfHeight();\n744:             } else {\n745:                 ActivationNode activationNode = (ActivationNode) node;\n746:                 if (start\n747:                     && activationNode.isStart()\n748:                     && !activationNode.isCutOffTop()) {\n749:                     y -= SequenceDiagramLayout.LINK_DISTANCE / 2;\n750:                 } else if (\n751:                     !start\n752:                         && activationNode.isEnd()\n753:                         && !activationNode.isCutOffBottom()) {\n754:                     y += SequenceDiagramLayout.LINK_DISTANCE / 2;\n755:                 }\n756:             }\n757:         }\n758:         return y;\n759:     }\n760: \n761:     /**\n762:      * @see org.tigris.gef.presentation.Fig#setOwner(java.lang.Object)\n763:      */\n764:     public void setOwner(Object own) {\n765:         super.setOwner(own);\n766:         bindPort(own, outerBox);\n767:     }\n768: \n769:     /**\n770:      * Gets the {@link FigLink} that is attached to the given\n771:      * {@link FigLinkPort}.\n772:      *\n773:      * @param portFig the given port\n774:      * @return the {@link FigLink} that is attached.\n775:      */\n776:     public FigLink getFigLink(FigLinkPort portFig) {\n777:         Iterator it = getFigEdges(null).iterator();\n778:         while (it.hasNext()) {\n779:             FigEdge figEdge = (FigEdge) it.next();\n780:             if (figEdge instanceof FigLink\n781:                 && (figEdge.getSourcePortFig() == portFig\n782:                     || figEdge.getDestPortFig() == portFig)) {\n783:                 return (FigLink) figEdge;\n784:             }\n785:         }\n786:         return null;\n787:     }\n788: \n789:     /**\n790:      * @return the lifeline Fig\n791:      */\n792:     public FigLine getLifeLine() {\n793:         return lifeLine;\n794:     }\n795: \n796:     /**\n797:      * Returns a list with all nodes that belong to the same\n798:      * activation as the given node.<p>\n799:      *\n800:      * TODO: Does not work for EmptyNode atm.\n801:      *\n802:      * @param node is the given node\n803:      * @return a List\n804:      */\n805:     public List getActivationNodes(Node node) {\n806:         int start = -1;\n807:         int end = -1;\n808:         if (node instanceof ActivationNode) {\n809:             ActivationNode activationNode = (ActivationNode) node;\n810:             if (activationNode.isStart()) {\n811:                 start = linkPositions.indexOf(activationNode);\n812:                 ListIterator it =\n813:                     linkPositions\n814:                         .subList(\n815:                             linkPositions.indexOf(activationNode),\n816:                             linkPositions.size())\n817:                         .listIterator();\n818:                 while (it.hasNext()) {\n819:                     Node node2 = (Node) it.next();\n820:                     if (node2 instanceof ActivationNode\n821:                         && ((ActivationNode) node2).isEnd()) {\n822:                         end = linkPositions.indexOf(node2);\n823:                         break;\n824:                     }\n825:                 }\n826:             } else if (activationNode.isEnd()) {\n827:                 end = linkPositions.indexOf(activationNode);\n828:                 for (int i = end - 1; i >= 1; i--) {\n829:                     Node node2 = (Node) linkPositions.get(i);\n830:                     if (node2 instanceof ActivationNode\n831:                         && ((ActivationNode) node2).isStart()) {\n832:                         start = linkPositions.indexOf(node2);\n833:                         break;\n834:                     }\n835:                 }\n836:             } else {\n837:                 // node is in between activations or does not belong\n838:                 // to activation (yet)\n839:                 if (!(nextNode(activationNode) instanceof ActivationNode)\n840:                     || !(previousNode(activationNode)\n841:                         instanceof ActivationNode)) {\n842:                     return new ArrayList();\n843:                 }\n844:                 for (int i = getIndexOf(activationNode) + 1;\n845:                     i < linkPositions.size();\n846:                     i++) {\n847:                     Node node2 = (Node) linkPositions.get(i);\n848:                     if (node2 instanceof ActivationNode\n849:                         && ((ActivationNode) node2).isEnd()) {\n850:                         end = getIndexOf(node2);\n851:                         break;\n852:                     }\n853:                 }\n854:                 for (int i = getIndexOf(activationNode) - 1; i >= 0; i--) {\n855:                     Node node2 = (Node) linkPositions.get(i);\n856:                     if (node2 instanceof ActivationNode\n857:                         && ((ActivationNode) node2).isStart()) {\n858:                         start = getIndexOf(node2);\n859:                         break;\n860:                     }\n861:                 }\n862: \n863:             }\n864:             if (end == -1 || start == -1) {\n865:                 return new ArrayList();\n866:             }\n867:             return linkPositions.subList(start, end);\n868: \n869:         }\n870:         return new ArrayList();\n871:     }\n872: \n873:     /**\n874:      * Returns the index of a given node.\n875:      *\n876:      * @param node is the given node\n877:      * @return the index\n878:      */\n879:     public int getIndexOf(Node node) {\n880:         return linkPositions.indexOf(node);\n881:     }\n882: \n883:     /**\n884:      * See makeActivation(int startIndex, int endIndex)\n885:      * @param startNode Node\n886:      * @param endNode Node\n887:      */\n888:     public void makeActivation(Node startNode, Node endNode) {\n889:         int startIndex = linkPositions.indexOf(startNode);\n890:         int endIndex = linkPositions.indexOf(endNode);\n891:         makeActivation(startIndex, endIndex);\n892:     }\n893: \n894:     /**\n895:      * Makes an activation from the node with index startindex to the\n896:      * node with index endindex. An activation means in this context\n897:      * that the starting and ending node will be an activation node\n898:      * after a call to this method.  The starting node is designated\n899:      * via the start property that's a starting node. The same is true\n900:      * for the ending node via the end property.<p>\n901:      *\n902:      * @param startIndex int\n903:      * @param endIndex int\n904:      */\n905:     public void makeActivation(int startIndex, int endIndex) {\n906:         for (int i = startIndex; i <= endIndex; i++) {\n907:             Object o = linkPositions.get(i);\n908:             if (!(o instanceof ActivationNode)) {\n909:                 linkPositions.set(i, new ActivationNode());\n910:             }\n911:         }\n912:         ((ActivationNode) linkPositions.get(startIndex)).setStart(true);\n913:         ((ActivationNode) linkPositions.get(endIndex)).setEnd(true);\n914:     }\n915: \n916:     /**\n917:      * Returns the node that's next to the given node.\n918:      *\n919:      * @param node is the given node\n920:      * @return the Node\n921:      */\n922:     public Node nextNode(Node node) {\n923:         if (getIndexOf(node) < linkPositions.size())\n924:             return (Node) linkPositions.get(getIndexOf(node) + 1);\n925:         else\n926:             return null;\n927:     }\n928: \n929:     /**\n930:      * Returns the node that's before the given node in the nodes list.\n931:      *\n932:      * @param node is the given node\n933:      * @return the node\n934:      */\n935:     public Node previousNode(Node node) {\n936:         if (getIndexOf(node) > 0) {\n937:             return (Node) linkPositions.get(getIndexOf(node