g.JComboBox;\n32: \n33: import org.argouml.application.api.Argo;\n34: \n35: import org.argouml.uml.ui.PropPanelButton;\n36: import org.argouml.uml.ui.UMLComboBox2;\n37: import org.argouml.uml.ui.UMLComboBoxNavigator;\n38: import org.argouml.uml.ui.foundation.core.PropPanelModelElement;\n39: import org.argouml.util.ConfigLoader;\n40: \n41: import ru.novosoft.uml.behavior.use_cases.MInclude;\n42: import ru.novosoft.uml.behavior.use_cases.MUseCase;\n43: import ru.novosoft.uml.foundation.core.MModelElement;\n44: \n45: \n46: /**\n47:  * <p>Builds the property panel for an Include relationship.</p>\n48:  *\n49:  * <p>This is a type of Relationship, but, since Relationship has no semantic\n50:  *   meaning of its own, we derive directly from PropPanelModelElement (as\n51:  *   other children of Relationship do).</p>\n52:  *\n53:  */\n54: \n55: public class PropPanelInclude extends PropPanelModelElement {\n56: \n57: \n58:     /**\n59:      * Constructor. Builds up the various fields required.\n60:      */\n61: \n62:     public PropPanelInclude() {\n63:         super(\"Include\", ConfigLoader.getTabPropsOrientation());\n64: \n65:         addField(Argo.localize(\"UMLMenu\", \"label.name\"), getNameTextField());\n66:         addField(Argo.localize(\"UMLMenu\", \"label.stereotype\"),\n67:             new UMLComboBoxNavigator(this, Argo.localize(\"UMLMenu\", \"tooltip.nav-stereo\"),getStereotypeBox()));\n68:         addField(Argo.localize(\"UMLMenu\", \"label.namespace\"), getNamespaceScroll());\n69: \n70:         addSeperator();\n71: \n72:         JComboBox baseBox = new UMLComboBox2(new UMLIncludeBaseComboBoxModel(), ActionSetIncludeBase.SINGLETON);\n73:         addField(Argo.localize(\"UMLMenu\", \"label.usecase-base\"), baseBox);\n74: \n75:         JComboBox additionBox = new UMLComboBox2(new UMLIncludeAdditionComboBoxModel(), ActionSetIncludeAddition.SINGLETON);\n76:         addField(Argo.localize(\"UMLMenu\", \"label.addition\"), additionBox);\n77: \n78:    /*\n79:         // FIXME - Why is this code commented out - is there work to do here - Bob Tarling\n80:     *\n81:         // The addition use case (reuse earlier variables). Note that because\n82:         // of the NSUML bug we look for the \"base\" event, rather than the\n83:         // \"addition\" event\" here.\n84: \n85:         addSeperator();\n86: \n87:         model = new UMLComboBoxModel(this, \"isAcceptableUseCase\",\n88:                                      \"base\", \"getAddition\",\n89:                                      \"setAddition\", true, MUseCase.class,\n90:                                      true);\n91:         box   = new UMLComboBox(model);\n92:         nav   = new UMLComboBoxNavigator(this, \"NavUseCase\", box);\n93: \n94:         addCaption(\"Addition:\", 1, 1, 0);\n95:         addField(nav, 1, 1, 0);\n96: */\n97:         // Add the toolbar. Just the four basic buttons for now.\n98: \n99:         new PropPanelButton(this, buttonPanel, _navUpIcon,\n100:                             Argo.localize(\"UMLMenu\", \"button.go-up\"), \"navigateNamespace\", null);\n101:         new PropPanelButton(this, buttonPanel, _deleteIcon,\n102:                             localize(\"Delete\"), \"removeElement\", null);\n103:     }\n104: \n105: \n106:     /**\n107:      * <p>Get the current base use case of the include relationship.</p>\n108:      *\n109:      * <p><em>Note</em>. There is a bug in NSUML, where the \"include\" and\n110:      *   \"include2\" associations of a use case are back to front, i.e \"include\"\n111:      *   is used as the opposite end of \"addition\" to point to an including use\n112:      *   case, rather than an included use case.  Fixed within the include\n113:      *   relationship, rather than the use case, by reversing the use of access\n114:      *   functions for the \"base\" and \"addition\" associations in the code.</p>\n115:      *\n116:      * @return  The {@link MUseCase} that is the base of this include\n117:      *          relationship or <code>null</code> if there is none. Returned as\n118:      *          type {@link MUseCase} to fit in with the type specified for\n119:      *          the {@link UMLComboBoxModel}.\n120:      */\n121:     public MUseCase getBase() {\n122:         MUseCase base   = null;\n123:         Object      target = getTarget();\n124: \n125:         // Note that because of the NSUML bug, we must use getAddition() rather\n126:         // than getBase() to get the base use case.\n127: \n128:         if (target instanceof MInclude) {\n129:             base = ((MInclude) target).getAddition();\n130:         }\n131: \n132:         return base;\n133:     }\n134: \n135:     /**\n136:      * <p>Set the base use case of the include relationship.</p>\n137:      *\n138:      * <p><em>Note</em>. There is a bug in NSUML, where the \"include\" and\n139:      *   \"include2\" associations of a use case are back to front, i.e \"include\"\n140:      *   is used as the opposite end of \"addition\" to point to an including use\n141:      *   case, rather than an included use case.  Fixed within the include\n142:      *   relationship, rather than the use case, by reversing the use of access\n143:      *   functions for the \"base\" and \"addition\" associations in the code.</p>\n144:      *\n145:      * @param base  The {@link MUseCase} to set as the base of this include\n146:      *              relationship. Supplied as type {@link MUseCase} to fit in\n147:      *              with the type specified for the {@link UMLComboBoxModel}.\n148:      */\n149: \n150:     public void setBase(MUseCase base) {\n151:         Object target = getTarget();\n152: \n153:         // Note that because of the NSUML bug, we must use setAddition() rather\n154:         // than setBase() to set the base use case.\n155: \n156:         if(target instanceof MInclude) {\n157:             ((MInclude) target).setAddition((MUseCase) base);\n158:         }\n159:     }\n160: \n161: \n162:     /**\n163:      * <p>Get the current addition use case of the include relationship.</p>\n164:      *\n165:      * <p><em>Note</em>. There is a bug in NSUML, where the \"include\" and\n166:      *   \"include2\" associations of a use case are back to front, i.e \"include\"\n167:      *   is used as the opposite end of \"addition\" to point to an including use\n168:      *   case, rather than an included use case.  Fixed within the include\n169:      *   relationship, rather than the use case, by reversing the use of access\n170:      *   functions for the \"base\" and \"addition\" associations in the code.</p>\n171:      *\n172:      * @return  The {@link MUseCase} that is the addition of this include\n173:      *          relationship or <code>null</code> if there is none. Returned as\n174:      *          type {@link MUseCase} to fit in with the type specified for the\n175:      *          {@link UMLComboBoxModel}.\n176:      */\n177: \n178:     public MUseCase getAddition() {\n179:         MUseCase addition   = null;\n180:         Object      target      = getTarget();\n181: \n182:         // Note that because of the NSUML bug, we must use getBase() rather\n183:         // than getAddition() to get the addition use case.\n184: \n185:         if (target instanceof MInclude) {\n186:             addition = ((MInclude) target).getBase();\n187:         }\n188: \n189:         return addition;\n190:     }\n191: \n192:     /**\n193:      * <p>Set the addition use case of the include relationship.</p>\n194:      *\n195:      * <p><em>Note</em>. There is a bug in NSUML, where the \"include\" and\n196:      *   \"include2\" associations of a use case are back to front, i.e \"include\"\n197:      *   is used as the opposite end of \"addition\" to point to an including use\n198:      *   case, rather than an included use case.  Fixed within the include\n199:      *   relationship, rather than the use case, by reversing the use of access\n200:      *   functions for the \"base\" and \"addition\" associations in the code.</p>\n201:      *\n202:      * @param addition  The {@link MUseCase} to set as the addition of this\n203:      *                   include relationship. Supplied as type {@link\n204:      *                   MUseCase} to fit in with the type specified for the\n205:      *                   {@link UMLComboBoxModel}.\n206:      */\n207: \n208:     public void setAddition(MUseCase addition) {\n209:         Object target = getTarget();\n210: \n211:         // Note that because of the NSUML bug, we must use setBase() rather\n212:         // than setAddition() to set the addition use case.\n213: \n214:         if(target instanceof MInclude) {\n215:             ((MInclude) target).setBase((MUseCase) addition);\n216:         }\n217:     }\n218: \n219: \n220:     /**\n221:      * <p>Predicate to test if a model element may appear in the list of\n222:      *   potential use cases.</p>\n223:      *\n224:      * <p><em>Note</em>. We don't try to prevent the user setting up circular\n225:      *   include relationships. This may be necessary temporarily, for example\n226:      *   while reversing a relationship. It is up to a critic to track\n227:      *   this.</p>\n228:      *\n229:      * @param modElem  the {@link MModelElement} to test.\n230:      *\n231:      * @return         <code>true</code> if modElem is a use case,\n232:      *                 <code>false</code> otherwise.\n233:      */\n234: \n235:     public boolean isAcceptableUseCase(MModelElement modElem) {\n236: \n237:         return modElem instanceof MUseCase;\n238:     }\n239: \n240: \n241: } /* end class PropPanelInclude */\n242: ",
