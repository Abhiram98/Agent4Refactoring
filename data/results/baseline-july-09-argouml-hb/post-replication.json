calize(BUNDLE, \"level.low\")\n438:         };\n439: \n440:         ////////////////////////////////////////////////////////////////\n441:         // instance variables\n442:         \n443:         JTextField headline = new JTextField(30);\n444:         JComboBox priority = new JComboBox(PRIORITIES);\n445:         JTextField moreinfo = new JTextField(30);\n446:         JTextArea description = new JTextArea(10, 30);\n447:     \n448:         JLabel headlineLabel = new JLabel(Argo.localize(BUNDLE, \"label.headline\"));\n449:         JLabel priorityLabel = new JLabel(Argo.localize(BUNDLE, \"label.priority\"));\n450:         JLabel moreInfoLabel = new JLabel(Argo.localize(BUNDLE, \"label.more-info-url\"));\n451: \n452:         int labelGap = 10;\n453:         int componentGap = 10;\n454:         \n455:         JPanel panel = new JPanel(new LabelledLayout(labelGap, componentGap));\n456: \n457:         priority.setSelectedItem(PRIORITIES[0]);\n458:     \n459:         headlineLabel.setLabelFor(headline);\n460:         panel.add(headlineLabel);\n461:         panel.add(headline);\n462: \n463:         priorityLabel.setLabelFor(priority);\n464:         panel.add(priorityLabel);\n465:         panel.add(priority);\n466: \n467:         moreInfoLabel.setLabelFor(moreinfo);\n468:         panel.add(moreInfoLabel);\n469:         panel.add(moreinfo);\n470:     \n471:         description.setText(Argo.localize(BUNDLE, \"label.enter-todo-item\") + \"\\n\");\n472:         JScrollPane descriptionScroller = new JScrollPane(description);\n473:         descriptionScroller.setPreferredSize(description.getPreferredSize());\n474:         panel.add(descriptionScroller);\n475:         \n476:         int response =\n477:             JOptionPane.showConfirmDialog(\n478:                 ProjectBrowser.getInstance(),\n479:                 panel, \n480:                 Argo.localize(BUNDLE, \"dialog.title.add-todo-item\"),\n481:                 JOptionPane.OK_CANCEL_OPTION,\n482:                 JOption