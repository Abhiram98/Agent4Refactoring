(ProjectManager.getManager().getCurrentProject()\n615: \t\t\t .getRoot()))\n616: \t{\n617:             setTarget(first);\n618:         }\n619:     }\n620: \n621:     ////////////////////////////////////////////////////////////////\n622:     // window operations\n623: \n624:     /**\n625:      * @see java.awt.Component#setVisible(boolean)\n626:      */\n627:     public void setVisible(boolean b) {\n628:         super.setVisible(b);\n629:         if (b)\n630:             org.tigris.gef.base.Globals.setStatusBar(this);\n631:     }\n632: \n633:     ////////////////////////////////////////////////////////////////\n634:     // IStatusBar\n635:     /**\n636:      * @see org.tigris.gef.ui.IStatusBar#showStatus(java.lang.String)\n637:      */\n638:     public void showStatus(String s) {\n639:         _statusBar.showStatus(s);\n640:     }\n641: \n642:     /**    Called by a user interface element when a request to\n643:      *    navigate to a model element has been received.\n644:      */\n645:     public void navigateTo(Object element) {  \n646:         setTarget(element);\n647:     }\n648: \n649:     /**   Called by a user interface element when a request to\n650:      *   open a model element in a new window has been recieved.\n651:      */\n652:     public void open(Object element) {\n653:     }\n654: \n655:     /**\n656:      * Save the positions of the screen splitters, sizes and postion\n657:      * of main window in the properties file\n658:      */\n659:     public void saveScreenConfiguration() {\n660:         if (_navPane != null)\n661: \t    Configuration.setInteger(Argo.KEY_SCREEN_WEST_WIDTH,\n662: \t\t\t\t     _navPane.getWidth());\n663:         if (_eastPane != null)\n664: \t    Configuration.setInteger(Argo.KEY_SCREEN_EAST_WIDTH,\n665: \t\t\t\t     _eastPane.getWidth());\n666:         if (_northPane != null)\n667: \t    Configuration.setInteger(Argo.KEY_SCREEN_NORTH_HEIGHT,\n668: \t\t\t\t     _northPane.getHeight());\n669:         if (_southPane != null)\n670