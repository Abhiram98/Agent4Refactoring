ism at a single point.\n799:      *\n800:      * TODO: Document the intention of this function.\n801:      * It is not used anywhere in ArgoUML.\n802:      * BTW: Does it work? I (MVW) once did a test, and it didn't.\n803:      *\n804:      * @param entity Class to create -\n805:      * must implement {@link org.argouml.model.UmlModelEntity}\n806:      * @return the created object or null if it cannot create the class.\n807:      */\n808:     public static Object create(ModelEntity entity) {\n809:         if (entity instanceof UmlModelEntity) {\n810:             return Model.getUmlFactory().create((UmlModelEntity) entity);\n811:         }\n812:         return null;\n813:     }\n814: \n815:     ////////////////////////////////////////////////////////////////\n816:     // Recognizer methods for the UML model (in alphabetic order)\n817: \n818:     /**\n819:      * Recognizer for Abstraction.\n820:      *\n821:      * @param handle candidate\n822:      * @return true if handle is an Abstraction\n823:      */\n824:     public static boolean isAAbstraction(Object handle) {\n825:         return handle instanceof MAbstraction;\n826:     }\n827: \n828:     /**\n829:      * Recognizer for Action.\n830:      *\n831:      * @param handle candidate\n832:      * @return true if handle is an Action\n833:      */\n834:     public static boolean isAAction(Object handle) {\n835:         return handle instanceof MAction;\n836:     }\n837: \n838:     /**\n839:      * Recognizer for ActionExpression.\n840:      *\n841:      * @param handle candidate\n842:      * @return true if handle is an ActionExpression\n843:      */\n844:     public static boolean isAActionExpression(Object handle) {\n845:         return handle instanceof MActionExpression;\n846:     }\n847: \n848:     /**\n849:      * Recognizer for ActionSequence.\n850:      *\n851:      * @param handle candidate\n852:      * @return true if handle is an action sequence\n853:      */\n854:     public static boolean isAActionSequence(Object handle) {\n855:         return handle instanceof MActionSequence;\n856:     }\n857: \n858:     /**\n859:      * Recognizer for Action state.\n860:      *\n861:      * @param handle candidate\n862:      * @return true if handle is an Action state\n863:      */\n864:     public static boolean isAActionState(Object handle) {\n865:         return handle instanceof MActionState;\n866:     }\n867: \n868:     /**\n869:      * Recognizer for CallState.\n870:      *\n871:      * @param handle candidate\n872:      * @return true if handle is an call state\n873:      */\n874:     public static boolean isACallState(Object handle) {\n875:         return handle instanceof MCallState;\n876:     }\n877: \n878:     /**\n879:      * Recognizer for ObjectFlowState.\n880:      *\n881:      * @param handle candidate\n882:      * @return true if handle is an objectflow state\n883:      */\n884:     public static boolean isAObjectFlowState(Object handle) {\n885:         return handle instanceof MObjectFlowState;\n886:     }\n887: \n888:     /**\n889:      * Recognizer for SubactivityState.\n890:      *\n891:      * @param handle candidate\n892:      * @return true if handle is an subactivity state\n893:      */\n894:     public static boolean isASubactivityState(Object handle) {\n895:         return handle instanceof MSubactivityState;\n896:     }\n897: \n898:     /**\n899:      * Recognizer for Actor.\n900:      *\n901:      * @param handle candidate\n902:      * @return true if handle is an Actor\n903:      */\n904:     public static boolean isAActor(Object handle) {\n905:         return handle instanceof MActor;\n906:     }\n907: \n908:     /**\n909:      * Recognizer for AggregationKind.\n910:      *\n911:      * @param handle candidate\n912:      * @return true if handle is an AggregationKind\n913:      */\n914:     public static boolean isAAggregationKind(Object handle) {\n915:         return handle instanceof MAggregationKind;\n916:     }\n917: \n918:     /**\n919:      