\n80:     ////////////////////////////////////////////////////////////////\n81:     // constants\n82: \n83:     /**\n84:      * Default name for a project.\n85:      */\n86:     private static final String UNTITLED_FILE = \"Untitled\";\n87: \n88:     ////////////////////////////////////////////////////////////////\n89:     // static variables\n90: \n91:     static final long serialVersionUID = 1399111233978692444L;\n92: \n93:     ////////////////////////////////////////////////////////////////\n94:     // instance variables\n95: \n96:     /**\n97:      * TODO: should just be the directory to write.\n98:      */\n99:     private URL file;\n100: //    private ChangeRegistry saveRegistry;\n101: \n102:     private String authorname;\n103:     private String description;\n104:     private String version;\n105: \n106:     private Vector searchpath;\n107: \n108:     // TODO: break into 3 main member types\n109:     // model, diagram and other\n110:     private MemberList members;\n111: \n112:     private String historyFile;\n113: \n114:     /**\n115:      * The version number of the persistence format that last\n116:      * saved this project.\n117:      */\n118:     private int persistenceVersion;\n119: \n120:     /**\n121:      * Instances of the uml model.\n122:      */\n123:     private Vector models;\n124: \n125:     /**\n126:      * Instances of the uml diagrams.\n127:      */\n128:     private Vector diagrams;\n129:     private Object defaultModel;\n130:     private Object currentNamespace;\n131:     private HashMap uuidRefs;\n132:     private GenerationPreferences cgPrefs;\n133:     private transient VetoableChangeSupport vetoSupport;\n134: \n135:     /**\n136:      * The root of the modeltree the user is working on. (The untitledModel in\n137:      * the navpane).\n138:      */\n139:     private Object treeRoot;\n140: \n141:     /**\n142:      * The active diagram, pointer to a diagram in the list with diagrams.\n143:      */\n144:     private ArgoDiagram activeDiagram;\n145: \n146:     /**\n147:      * Cache for the default model.\n148:      */\n149:     private HashMap defaultModelCache;\n150: \n151:     /**\n152:      * Constructor.\n153:      *\n154:      * @param theProjectUrl Url to read the project from.\n155:      */\n156:     public Project(URL theProjectUrl) {\n157:         this();\n158:         file = PersistenceManager.getInstance().fixFileExtension(theProjectUrl);\n159:     }\n160: \n161:     /**\n162:      * Constructor.\n163:      */\n164:     public Project() {\n165: \n166:         authorname = \"\";\n167:         description = \"\";\n168:         // this should be moved to a ui action.\n169:         version = ArgoVersion.getVersion();\n170: \n171:         searchpath = new Vector();\n172:         members = new MemberList();\n173:         historyFile = \"\";\n174:         models = new Vector();\n175:         diagrams = new Vector();\n176:         cgPrefs = new GenerationPreferences();\n177:         defaultModelCache = new HashMap();\n178: \n179: //        saveRegistry = new ChangeRegistry();\n180:         LOG.info(\"making empty project with empty model\");\n181:         // Jaap Branderhorst 2002-12-09\n182:         // load the default model\n183:         // this is NOT the way how it should be since this makes argo\n184:         // depend on Java even more.\n185:         setDefaultModel(ProfileJava.loadProfileModel());\n186:         addSearchPath(\"PROJECT_DIR\");\n187:         ProjectManager.getManager().setNeedsSave(false);\n188:         TargetManager.getInstance().addTargetListener(this);\n189: \n190:     }\n191: \n192:     /**\n193:      * Makes a just created project to an untitled project with a\n194:      * class diagram and a usecase diagram and an untitled model.\n195:      */\n196:     protected void makeUntitledProject() {\n197:         if (getRoot() != null) {\n198:             throw new IllegalStateException(\n199:                     \"Tried to make a non-empty project \"\n200:                     + \"to an untitled project\");\n201:         }\n202:         Object model =\n203:             Model.getModelManagementFactory().createModel();\n204:         ModelFacade.setName(model, \"untitledModel\");\n205:         setRoot(model);\n206:         setCurrentNamespace(model);\n207:         addMember(model);\n208:         addMember(new UMLClassDiagram(model));\n209:         addMember(new UMLUseCaseDiagram(model));\n210:         addMember(new ProjectMemberTodoList(\"\", this));\n211:         ProjectManager.getManager().setNeedsSave(false);\n212:         setActiveDiagram((ArgoDiagram) getDiagrams().get(0));\n213:     }\n214: \n215:     /**\n216:      * Find the base name of this project.<p>\n217:      *\n218:      * This is the name minus any valid file extension.\n219:      *\n220:      * @return The name (a String).\n221:      */\n222:     public String getBaseName() {\n223:         String n = getName();\n224:         n = PersistenceManager.getInstance().getBaseName(n);\n225:         return n;\n226:     }\n227: \n228:     /**\n229:      * @return the name of the project\n230:      */\n231:     public String getName() {\n232:         // TODO: maybe separate name\n233:         if (file == null) {\n234:             return UNTITLED_FILE;\n235:         }\n236:         String name = file.getFile();\n237:         int i = name.lastIndexOf('/');\n238:         return name.substring(i + 1);\n239:     }\n240: \n241:     /**\n242:      * Set the project URL.\n243:      *\n244:      * @param n The new URL (as a String).\n245:      * @throws MalformedURLException if the argument cannot be converted to\n246:      *         an URL.\n247:      */\n248:     public void setName(String n)\n249:         throws MalformedURLException {\n250:         String s = \"\";\n251:         if (getURL() != null) {\n252:             s = getURL().toString();\n253:         }\n254:         s = s.substring(0, s.lastIndexOf(\"/\") + 1) + n;\n255:         setURL(new URL(s));\n256:     }\n257: \n258:     /**\n259:      * Get the URL for this project.\n260:      *\n261:      * @return The URL.\n262:      */\n263:     public URL getURL() {\n264:         return file;\n265:     }\n266: \n267:     /**\n268:      * Set the URL for this project.\n269:      *\n270:      * @param theUrl The URL to set.\n271:      */\n272:     public void setURL(URL theUrl) {\n273:         if (theUrl != null) {\n274:             theUrl = PersistenceManager.getInstance().fixFileExtension(theUrl);\n275:         }\n276: \n277:         if (LOG.isDebugEnabled()) {\n278:             LOG.debug(\"Setting project URL from \\\"\" + file\n279:                       + \"\\\" to \\\"\" + theUrl + \"\\\".\");\n280:         }\n281: \n282:         file = theUrl;\n283:     }\n284: \n285:     /**\n286:      * Set the project file.\n287:      *\n288:      * This only works if it is possible to convert the File to an url.\n289:      *\n290:      * @param file File to set the project to.\n291:      */\n292:     public void setFile(File file) {\n293:         try {\n294:             URL theProjectUrl = Util.fileToURL(file);\n295: \n296:             if (LOG.isDebugEnabled()) {\n297:                 LOG.debug(\"Setting project file name from \\\"\"\n298:                           + this.file\n299:                           + \"\\\" to \\\"\"\n300:                           + theProjectUrl\n301:                           + \"\\\".\");\n302:             }\n303: \n304:             this.file = theProjectUrl;\n305:         } catch (MalformedURLException murle) {\n306:             LOG.error(\"problem in setFile:\" + file, murle);\n307:         } catch (IOException ex) {\n308:             LOG.error(\"problem in setFile:\" + file, ex);\n309:         }\n310:     }\n311: \n312:     /**\n313:      * @return the search path\n314:      */\n315:     public Vector getSearchPath() {\n316:         return searchpath;\n317:     }\n318: \n319:     /**\n320:      * @param searchPathElement the element to be added to the searchpath\n321:      */\n322:     public void addSearchPath(String searchPathElement) {\n323:         this.searchpath.addElement(searchPathElement);\n324:     }\n325: \n326:     /**\n327:      * Get all members of the project.\n328:      *\n329:      * @return a Vector with all members.\n330:      */\n331:     public MemberList getMembers() {\n332:         LOG.info(\"Getting the members there are \" + members.size());\n333:         return members;\n334:     }\n335: \n336:     /**\n337:      * @param d the diagram\n338:      */\n339:     private void addDiagramMember(ArgoDiagram d) {\n340:         ProjectMember pm = new ProjectMemberDiagram(d, this);\n341:         addDiagram(d);\n342:         // if diagram added successfully, add the member too\n343:         members.add(pm);\n344:     }\n345: \n346:     /**\n347:      * @param pm the member to be added\n348:      */\n349:     private void addTodoMember(ProjectMemberTodoList pm) {\n350:         // Adding a todo member removes any existing one.\n351:         members.add(pm);\n352:         LOG.info(\"Added todo member, there are now \" + members.size());\n353:     }\n354: \n355:     /**\n356:      * @param m the member to be added\n357:      */\n358:     public void addMember(Object m) {\n359: \n360:         if (m instanceof ArgoDiagram) {\n361:             LOG.info(\"Adding diagram member\");\n362:             addDiagramMember((ArgoDiagram) m);\n363:         } else if (m instanceof ProjectMemberTodoList) {\n364:             LOG.info(\"Adding todo member\");\n365:             addTodoMember((ProjectMemberTodoList) m);\n366:         } else if (ModelFacade.isAModel(m)) {\n367:             LOG.info(\"Adding model member\");\n368:             addModelMember(m);\n369:         } else {\n370:             throw new IllegalArgumentException(\n371:                     \"The member must be a UML model todo member or diagram.\"\n372:                     + \"It is \" + m.getClass().getName());\n373:         }\n374:         LOG.info(\"There are now \" + members.size() + \" members\");\n375:     }\n376: \n377:     /**\n378:      * @param m the model\n379:      */\n380:     private void addModelMember(Object m) {\n381: \n382:         boolean memberFound = false;\n383:         Object currentMember =\n384:             members.getMember(ProjectMemberModel.class);\n385:         if (currentMember != null) {\n386:             Object currentModel =\n387:                 ((ProjectMemberModel) currentMember).getModel();\n388:             if (currentModel == m) {\n389:                 memberFound = true;\n390:             }\n391:         }\n392: \n393:         if (!memberFound) {\n394:             if (!models.contains(m)) {\n395:                 addModel(m);\n396:             }\n397:             // got past the veto, add the member\n398:             ProjectMember pm = new ProjectMemberModel(m, this);\n399:             LOG.info(\"Adding model member to start of member list\");\n400:             members.add(pm);\n401:         } else {\n402:             LOG.info(\"Attempted to load 2 models\");\n403:             throw new IllegalArgumentException(\n404:                     \"Attempted to load 2 models\");\n405:         }\n406:     }\n407: \n408:     /**\n409:      * @param m a namespace\n410:      */\n411:     public void addModel(Object m) {\n412: \n413:         if (!ModelFacade.isANamespace(m)) {\n414:             throw new IllegalArgumentException();\n415: \t}\n416: \n417:         // fire indeterminate change to avoid copying vector\n418:         if (!models.contains(m)) {\n419:             models.addElement(m);\n420:         }\n421:         setCurrentNamespace(m);\n422:         ProjectManager.getManager().setNeedsSave(true);\n423:     }\n424: \n425:     /**\n426:      * Removes a project member diagram completely from the project.\n427:      * @param d the ArgoDiagram\n428:      */\n429:     protected void removeProjectMemberDiagram(ArgoDiagram d) {\n430: \n431:         removeDiagram(d);\n432:         members.remove(d);\n433: \n434:         /*\n435:          * Issue 2909: if there is no diagram left, then let's add a default\n436:          * new one...\n437:          */\n438:         if (diagrams.size() < 1) {\n439:             ArgoDiagram defaultDiagram = new UMLClassDiagram(treeRoot);\n440:             addMember(defaultDiagram);\n441:             setActiveDiagram(defaultDiagram);\n442:             TargetManager.getInstance().setTarget(defaultDiagram);\n443:         }\n444:     }\n445: \n446: \n447:     /**\n448:      * Get the author name.\n449:      *\n450:      * @return The author name.\n451:      */\n452:     public String getAuthorname() {\n453:         return authorname;\n454:     }\n455: \n456:     /**\n457:      * Set the author name.\n458:      *\n459:      * @param s The new author name.\n460:      */\n461:     public void setAuthorname(String s) {\n462:         authorname = s;\n463:     }\n464: \n465:     /**\n466:      * Get the version.\n467:      *\n468:      * @return the version.\n469:      */\n470:     public String getVersion() {\n471:         return version;\n472:     }\n473: \n474:     /**\n475:      * Set the new version.\n476:      * @param s The new version.\n477:      */\n478:     public void setVersion(String s) {\n479:         version = s;\n480:     }\n481: \n482:     /**\n483:      * Get the description.\n484:      *\n485:      * @return the description.\n486:      */\n487:     public String getDescription() {\n488:         return description;\n489:     }\n490: \n491:     /**\n492:      * Set a new description.\n493:      *\n494:      * @param s The new description.\n495:      */\n496:     public void setDescription(String s) {\n497:         description = s;\n498:     }\n499: \n500:     /**\n501:      * Get the history file.\n502:      *\n503:      * @return The history file.\n504:      */\n505:     public String getHistoryFile() {\n506:         return historyFile;\n507:     }\n508: \n509:     /**\n510:      * Set the history file.\n511:      *\n512:      * @param s The new history file.\n513:      */\n514:     public void setHistoryFile(String s) {\n515:         historyFile = s;\n516:     }\n517: \n518:     /**\n519:      * Returns all models defined by the user. I.e. this does not return the\n520:      * default model but all other models.\n521:      *\n522:      * @return A Vector of all user defined models.\n523:      */\n524:     public Vector getUserDefinedModels() {\n525:         return models;\n526:     }\n527: \n528:     /**\n529:      * Returns all models, including the default model (default.xmi).\n530:      *\n531:      * @return A Collection containing all models.\n532:      */\n533:     public Collection getModels() {\n534:         Set ret = new HashSet();\n535:         ret.addAll(models);\n536:         ret.add(defaultModel);\n537:         return ret;\n538:     }\n539: \n540:     /**\n541:      * Return the model.<p>\n542:      *\n543:      * If there isn't exactly one model, <code>null</code> is returned.\n544:      *\n545:      * @return the model.\n546:      */\n547:     public Object getModel() {\n548:         if (models.size() != 1) {\n549:             return null;\n550:         }\n551:         return models.elementAt(0);\n552:     }\n553: \n554:     /**\n555:      * Searches for a type/classifier with name s. If the type is not found,\n556:      * a new type is created and added to the current namespace.\n557:      * @param s the name of the type/classifier to be found\n558:      * @return MClassifier\n559:      */\n560:     public Object findType(String s) {\n561:         return findType(s, true);\n562:     }\n563: \n564:     /**\n565:      * Searches for a type/classifier with name s. If defineNew is\n566:      * true, a new type is defined if the type/classifier is not\n567:      * found. The newly created type is added to the currentNamespace\n568:      * and given the name s.\n569:      * @param s the name of the type/classifier to be found\n570:      * @param defineNew if true, define a new one\n571:      * @return MClassifier the found classifier\n572:      */\n573:     public Object findType(String s, boolean defineNew) {\n574:         if (s != null) {\n575:             s = s.trim();\n576:         }\n577:         if (s == null || s.length() == 0) {\n578:             return null;\n579:         }\n580:         Object cls = null;\n581:         int numModels = models.size();\n582:         for (int i = 0; i < numModels; i++) {\n583:             cls = findTypeInModel(s, models.elementAt(i));\n584:             if (cls != null) {\n585:                 return cls;\n586:             }\n587:         }\n588:         cls = findTypeInModel(s, defaultModel);\n589:         // hey, now we should move it to the model the user is working in\n590:         if (cls != null) {\n591:             cls =\n592:                 Model.getModelManagementHelper()\n593:                 \t.getCorrespondingElement(cls, getRoot());\n594:         }\n595:         if (cls == null && defineNew) {\n596:             LOG.debug(\"new Type defined!\");\n597:             cls =\n598:                 Model.getCoreFactory().buildClass(getCurrentNamespace());\n599:             ModelFacade.setName(cls, s);\n600:         }\n601:         return cls;\n602:     }\n603: \n604:     /**\n605:      * Finds all figs on the diagrams for some project member,\n606:      * including the figs containing the member (so for some\n607:      * operation, the containing figclass is returned).\n608:      *\n609:      * @param member The member we are looking for.\n610:      *               This can be a NSUML object but also another object.\n611:      * @return Collection The collection with the figs.\n612:      */\n613:     public Collection findFigsForMember(Object member) {\n614:         Collection figs = new ArrayList();\n615:         Iterator it = getDiagrams().iterator();\n616:         while (it.hasNext()) {\n617:             ArgoDiagram diagram = (ArgoDiagram) it.next();\n618:             Object fig = diagram.getContainingFig(member);\n619:             if (fig != null) {\n620:                 figs.add(fig);\n621:             }\n622:         }\n623:         return figs;\n624:     }\n625: \n626:     /**\n627:      * Finds a classifier with a certain name.<p>\n628:      *\n629:      * Will only return first classifier with the matching name.\n630:      *\n631:      * @param s is short name.\n632:      * @param ns Namespace where we do the search.\n633:      * @return the found classifier (or <code>null</code> if not found).\n634:      */\n635:     public Object findTypeInModel(String s, Object ns) {\n636: \n637:         if (!ModelFacade.isANamespace(ns)) {\n638:             throw new IllegalArgumentException();\n639:     \t}\n640: \n641:         Collection allClassifiers =\n642:             Model.getModelManagementHelper()\n643: \t        .getAllModelElementsOfKind(ns, ModelFacade.CLASSIFIER);\n644: \n645:         Object[] classifiers = allClassifiers.toArray();\n646:         Object classifier = null;\n647: \n648:         for (int i = 0; i < classifiers.length; i++) {\n649: \n650:             classifier = classifiers[i];\n651:             if (ModelFacade.getName(classifier) != null\n652:             \t\t&& ModelFacade.getName(classifier).equals(s)) {\n653:                 return classifier;\n654:             }\n655:         }\n656: \n657:         return null;\n658:     }\n659: \n660:     /**\n661:      * @param m the namespace\n662:      */\n663:     public void setCurrentNamespace(Object m) {\n664: \n665:         if (m != null && !ModelFacade.isANamespace(m)) {\n666:             throw new IllegalArgumentException();\n667:     \t}\n668: \n669:         currentNamespace = m;\n670:     }\n671: \n672:     /**\n673:      * @return the namespace\n674:      */\n675:     public Object getCurrentNamespace() {\n676:         return currentNamespace;\n677:     }\n678: \n679:     /**\n680:      * @return the diagrams\n681:      */\n682:     public Vector getDiagrams() {\n683:         return diagrams;\n684:     }\n685: \n686:     /**\n687:      * Get the number of diagrams in this project.\n688:      * Used by argo2.tee!!\n689:      * @return the number of diagrams in this project.\n690:      */\n691:     public int getDiagramCount() {\n692:         return diagrams.size();\n693:     }\n694: \n695:     /**\n696:      * Finds a diagram with a specific name or UID.\n697:      *\n698:      * @return the diagram object (if found). Otherwize null.\n699:      * @param name is the name to search for.\n700:      */\n701:     public ArgoDiagram getDiagram(String name) {\n702:         Iterator it = diagrams.iterator();\n703:         while (it.hasNext()) {\n704:             ArgoDiagram ad = (ArgoDiagram) it.next();\n705:             if (ad.getName() != null && ad.getName().equals(name)) {\n706:                 return ad;\n707:             }\n708:             if (ad.getItemUID() != null\n709:                     && ad.getItemUID().toString().equals(name)) {\n710:                 return ad;\n711:             }\n712:         }\n713:         return null;\n714:     }\n715: \n716:     /**\n717:      * @param d the diagram to be added\n718:      */\n719:     public void addDiagram(ArgoDiagram d) {\n720:         // send indeterminate new value instead of making copy of vector\n721:         diagrams.addElement(d);\n722:         d.addVetoableChangeListener(new Vcl());\n723:         ProjectManager.getManager().setNeedsSave(true);\n724:     }\n725: \n726:     /**\n727:      * Removes a diagram from the list with diagrams.\n728:      *\n729:      * Removes (hopefully) the event listeners for this diagram.  Does\n730:      * not remove the diagram from the project members. This should\n731:      * not be called directly. Use moveToTrash if you want to remove a\n732:      * diagram.\n733:      *\n734:      * @param d the ArgoDiagram\n735:      */\n736:     protected void removeDiagram(ArgoDiagram d) {\n737:         d.removeVetoableChangeListener(new Vcl());\n738:         diagrams.removeElement(d);\n739:         // if the diagram is a statechart,\n740:         // remove its associated statemachine model elements\n741:         if (d instanceof UMLStateDiagram) {\n742:             UMLStateDiagram statediagram = (UMLStateDiagram) d;\n743:             // if the statemachine has already been deleted,\n744:             // and is now null,\n745:             // don't attempt to delete it!\n746:             if (statediagram.getStateMachine() != null) {\n747:                 this.moveToTrash(statediagram.getStateMachine());\n748:             }\n749:         }\n750:     }\n751: \n752:     /**\n753:      * Listener to events from the Diagram class. <p>\n754:      *\n755:      * Purpose: changing the name of a diagram shall set the need save flag.\n756:      *\n757:      * @author mvw@tigris.org\n758:      */\n759:     private class Vcl implements VetoableChangeListener {\n760:         /**\n761:          * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n762:          */\n763:         public void vetoableChange(PropertyChangeEvent evt)\n764:             throws PropertyVetoException {\n765:             if (evt.getPropertyName().equals(\"name\")) {\n766:                 ProjectManager.getManager().setNeedsSave(true);\n767:             }\n768:         }\n769:     }\n770: \n771:     /**\n772:      * @param me the given modelelement\n773:      * @return the total number of presentation\n774:      *         for the given modelelement in the project\n775:      */\n776:     public int getPresentationCountFor(Object me) {\n777: \n778:         if (!ModelFacade.isAModelElement(me)) {\n779:             throw new IllegalArgumentException();\n780:     \t}\n781: \n782:         int presentations = 0;\n783:         int size = diagrams.size();\n784:         for (int i = 0; i < size; i++) {\n785:             Diagram d = (Diagram) diagrams.elementAt(i);\n786:             presentations += d.getLayer().presentationCountFor(me);\n787:         }\n788:         return presentations;\n789:     }\n790: \n791:     /**\n792:      * @return an initial target, in casu a diagram or a model\n793:      */\n794:     public Object getInitialTarget() {\n795:         if (diagrams.size() > 0) {\n796:             return diagrams.elementAt(0);\n797:         }\n798:         if (models.size() > 0) {\n799:             return models.elementAt(0);\n800:         }\n801:         return null;\n802:     }\n803: \n804: \n805:     /**\n806:      * @param cgp the generation preferences\n807:      */\n808:     public void setGenerationPrefs(GenerationPreferences cgp) {\n809:         cgPrefs = cgp;\n810:     }\n811: \n812:     /**\n813:      * @return the generation preferences\n814:      */\n815:     public GenerationPreferences getGenerationPrefs() {\n816:         return cgPrefs;\n817:     }\n818: \n819:     ////////////////////////////////////////////////////////////////\n820:     // event handling\n821: \n822:     /**\n823:      * @return the VetoableChangeSupport\n824:      */\n825:     public VetoableChangeSupport getVetoSupport() {\n826:         if (vetoSupport == null) {\n827:             vetoSupport = new VetoableChangeSupport(this);\n828:         }\n829:         return vetoSupport;\n830:     }\n831: \n832:     /**\n833:      * This is executed before a save.\n834:      */\n835:     public void preSave() {\n836:         for (int i = 0; i < diagrams.size(); i++) {\n837:             ((Diagram) diagrams.elementAt(i)).preSave();\n838:         }\n839:         // TODO: is preSave needed for models?\n840:     }\n841: \n842:     /**\n843:      * This is execcuted after a save.\n844:      */\n845:     public void postSave() {\n846:         for (int i = 0; i < diagrams.size(); i++) {\n847:             ((Diagram) diagrams.elementAt(i)).postSave();\n848:         }\n849:         // TODO: is postSave needed for models?\n850:         ProjectManager.getManager().setNeedsSave(false);\n851:     }\n852: \n853:     /**\n854:      * This is e