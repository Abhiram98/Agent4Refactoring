blic ActionOpenCritics() { super(\"Browse Critics...\"); }\n685: } /* end class ActionOpenCritics */\n686: \n687: \n688: class ActionFlatToDo extends UMLAction {\n689:   public ActionFlatToDo() { super(\"Toggle Flat View\"); }\n690:   public void actionPerformed(ActionEvent e) {\n691:     ProjectBrowser pb = ProjectBrowser.TheInstance;\n692:     ToDoPane pane = pb.getToDoPane();\n693:     pane.toggleFlat();\n694:   }\n695: } /* end class ActionFlatToDo */\n696: \n697: class ActionNewToDoItem extends UMLAction {\n698:   public ActionNewToDoItem() { super(\"New To Do Item...\"); }\n699:   public void actionPerformed(ActionEvent e) {\n700:     AddToDoItemDialog dialog = new AddToDoItemDialog();\n701:     dialog.show();\n702:   }\n703: } /* end class ActionNewToDoItem */\n704: \n705: class ToDoItemAction extends UMLAction {\n706:   Object _target = null;\n707:   public ToDoItemAction(String name) { super(name, false); }\n708: \n709:   public void updateEnabled(Object target) {\n710:     _target = target;\n711:     setEnabled(shouldBeEnabled(target));\n712:   }\n713:   \n714:   public boolean shouldBeEnabled(Object target) {\n715:     return target instanceof ToDoItem;\n716:   }  \n717: }\n718: \n719: class ActionFixItNext extends ToDoItemAction {\n720:   public ActionFixItNext() { super(\"Fix It Next...\"); }\n721: } /* end class ActionFixItNext */\n722: \n723: class ActionReplayFix extends ToDoItemAction {\n724:   public ActionReplayFix() { super(\"Fix It Back...\"); }\n725: } /* end class ActionFixItBack */\n726: \n727: class ActionFixItFinish extends ToDoItemAction {\n728:   public ActionFixItFinish() { super(\"Fix It Finish...\"); }\n729: } /* end class ActionFixItFinish */\n730: \n731: class ActionResolve extends ToDoItemAction {\n732:   public ActionResolve() { super(\"Resolve Item...\"); }\n733:   public void actionPerformed(ActionEvent e) {\n734:     DismissToDoItemDialog dialog = new DismissToDoItemDialog();\n735:     dialog.setTarget(_target);\n736:     dialog