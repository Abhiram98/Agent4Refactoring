urn generateFile(modelElement, sPath);\n794:     }\n795: \n796:     /**\n797:      * Generates file\n798:      *\n799:      * @param modelElement Model element to generate notation for.\n800:      * @param sPath        output base directory\n801:      *\n802:      * @return name of generated file on success;\n803:      *         <code>null</code> otherwise.\n804:      */\n805:     public String generateFile(Object modelElement, String sPath) {\n806:         if (!ModelFacade.isAClassifier(modelElement)) {\n807:             throw new ClassCastException(modelElement.getClass()\n808:                     + \" has wrong object type, Classifier required\");\n809:         }\n810: \n811:         String sFilename = NameGenerator.generateFilename(modelElement, sPath,\n812:                 iLanguageMajorVersion);\n813: \n814:         if (sFilename == null || sFilename.length() == 0) {\n815:             LOG.error(\"Can't generate a nameless class\");\n816: \n817:             return null;\n818:         }\n819: \n820:         File f = new File(sFilename);\n821:         if (f.exists()) {\n822:             LOG.info(getModuleName() + \" updates \" + f.getPath());\n823:             try {\n824:                 updateFile(modelElement, f);\n825:             } catch (Exception exp) {\n826:                 LOG.error(\"Update \" + f.getPath() + \" failed: \"\n827:                         + exp.getMessage());\n828: \n829:                 return null;\n830:             }\n831: \n832:             LOG.debug(\"Update \" + f.getPath() + \" successfull\");\n833: \n834:             return sFilename;\n835:         }\n836: \n837:         LOG.info(getModuleName() + \" creates \" + f.getPath());\n838: \n839:         File fPath = new File(sPath);\n840:         if (!fPath.isDirectory()) {\n841:             if (!fPath.mkdirs()) {\n842:                 LOG.error(getModuleName() + \" could not make directory \"\n843:                         + sPath);\n844:                 return null;\n845:             }\n