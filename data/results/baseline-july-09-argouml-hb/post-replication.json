mport java.util.ArrayList;\n32: import java.util.Enumeration;\n33: import java.util.Iterator;\n34: import java.util.jar.JarFile;\n35: import java.util.zip.ZipEntry;\n36: \n37: import org.argouml.kernel.Project;\n38: import org.argouml.uml.diagram.static_structure.layout.ClassdiagramLayouter;\n39: import org.argouml.uml.diagram.ui.UMLDiagram;\n40: import org.argouml.uml.reveng.DiagramInterface;\n41: import org.argouml.uml.reveng.FileImportSupport;\n42: import org.argouml.uml.reveng.Import;\n43: import org.argouml.util.FileFilters;\n44: import org.argouml.util.SuffixFilter;\n45: \n46: \n47: /**\n48:  * This is the main class for the classfile import.\n49:  *\n50:  * $Revision$\n51:  * $Date$\n52:  *\n53:  * @author Andreas Rueckert <a_rueckert@gmx.net>\n54:  */\n55: public class ClassfileImport extends FileImportSupport {\n56: \n57:     /////////////////////////////////////////////////////////\n58:     // Instance variables\n59: \n60:     // The instance for a singleton pattern.\n61:     private static ClassfileImport singleton = new ClassfileImport();\n62: \n63:     // Create a interface to the current diagram\n64:     private org.argouml.uml.reveng.DiagramInterface diagram;\n65: \n66:     /** The files that needs a second RE pass. */\n67:     private ArrayList secondPassFiles;\n68: \n69:     // The current project.\n70:     private Project currentProject = null;\n71: \n72:     private Import theImport;\n73: \n74:     /**\n75:      * Return the singleton instance of the Import class.\n76:      *\n77:      * @return The only instance of this class.\n78:      */\n79:     public static ClassfileImport getInstance() {\n80: \treturn singleton;\n81:     }\n82: \n83:     /**\n84:      * @see org.argouml.application.api.PluggableImport#parseFile(\n85:      * org.argouml.kernel.Project, java.lang.Object,\n86:      * org.argouml.uml.reveng.DiagramInterface, org.argouml.uml.reveng.Import)\n87:      */\n88:     public void parseFile( Project p, Object o,\n89:             DiagramInterface d, Import i)\n90: \tthrows Exception {\n91: \tif (o instanceof File ) {\n92: \t    File f = (File) o;\n93: \t    this.diagram = d;\n94: \t    this.theImport = i;\n95: \t    startImport(p, f);\n96: \t}\n97:     }\n98: \n99:     /**\n100:      * Start the import process for a project and a file.\n101:      *\n102:      * @param p The project, where the import results are added.\n103:      * @param f The file to start with.\n104:      *\n105:      * @throws Exception if something goes wrong\n106:      */\n107:     public void startImport(Project p, File f) throws Exception {\n108: \tsecondPassFiles = new ArrayList();\n109: \tcurrentProject = p;\n110: \n111: \t// Process the current file. If it's a directory,\n112: \t// process all the files in it.\n113: \tprocessFile(f, true);\n114: \n115: \tint secondPassCount = count2ndPassFiles(secondPassFiles);\n116: \n117:         if (secondPassCount > 0) {\n118: \n119: \t    // Process all the files, that need a second pass.\n120: \t    for (Iterator i = secondPassFiles.iterator(); i.hasNext();) {\n121: \t\tObject next = i.next();\n122: \n123: \t\tif (next instanceof ArrayList) {\n124: \t\t    do2ndJarPass((ArrayList) next);\n125: \t\t} else {\n126: \t\t    File nextFile = (File) next;\n127:                     String fileName = nextFile.getName();\n128: \t\t    do2ndFilePass(new FileInputStream(nextFile), fileName);\n129: \t\t}\n130: \t    }\n131: \t}\n132: \n133: \t// Layout the modified diagrams.\n134: \tfor (Enumeration e = diagram.getModifiedDiagrams().elements();\n135: \t                                        e.hasMoreElements(); ) {\n136: \t    ClassdiagramLayouter layouter =\n137: \t        new ClassdiagramLayouter((UMLDiagram) e.nextElement());\n138: \t    layouter.layout();\n139: \n140:         // Resize the diagram???\n141: \t}\n142: \n143: \t// Let the use close the status window.\n144: \t//_status.importCompleted();\n145:     }\n146: \n147:     /**\n148:      * Count all the files, we're going to process, so\n149:      * we can display a progress bar.\n150:      *\n151:      * @return The number of files to process\n152:      */\n153:     private int countFiles(File f, boolean subdirectories) throws Exception {\n154: \tif ( f.isDirectory() && subdirectories) {\n155: \t    return countDirectory(f);\n156: \t}\n157:         if (f.getName().endsWith(\".class\")) {\n158:         \treturn 1;\n159:         }\n160:         int total = 0;\n161:         if (f.getName().endsWith(\".jar\")) {\n162:             for ( Enumeration e =\n163:                     (new JarFile(f)).entries(); e.hasMoreElements(); ) {\n164:                 ZipEntry entry = (ZipEntry) e.nextElement();\n165:                 if ( !entry.isDirectory()\n166:                                 && entry.getName().endsWith(\".class\")) {\n167:                     total++;\n168:                 }\n169:             }\n170:         }\n171:         return total;\n172:     }\n173: \n174:     /**\n175:      * Count the files to process in a directory.\n176:      *\n177:      * @param f The directory as a file instance.\n178:      */\n179:     private int countDirectory(File f) throws Exception {\n180: \tint total = 0;\n181: \tString [] files = f.list();  // Get the content of the directory\n182: \n183: \tfor ( int i = 0; i < files.length; i++) {\n184: \t    total += countFiles( new File( f, files[i]),\n185: \t                        theImport.isDiscendDirectoriesRecursively());\n186: \n187:         }\n188: \n189: \treturn total;\n190:     }\n191: \n192:     /**\n193:      * Count the files in the 2nd pass buffer.\n194:      *\n195:      * @param buffer The buffer with the files for the 2nd pass.\n196:      */\n197:     private int count2ndPassFiles(ArrayList buffer) {\n198: \tint nfiles = 0;\n199: \n200: \tfor (Iterator i = secondPassFiles.iterator(); i.hasNext();) {\n201: \t    Object next = i.next();\n202: \t    nfiles += ((next instanceof ArrayList)\n203:                 ? ((ArrayList) next).size() - 1 : 1);\n204: \t}\n205: \treturn nfiles;\n206:     }\n207: \n208:     /**\n209:      * The main method for all parsing actions. It calls the\n210:      * actual parser methods depending on the type of the\n211:      * file.\n212:      *\n213:      * @param f The file or directory, we want to parse.\n214:      * @param subdirectories boolean true if subdirs are processed, too\n215:      * @throws Exception Parser exceptions\n216:      */\n217:     public void processFile(File f, boolean subdirectories) throws Exception {\n218: \n219: \tif ( f.isDirectory() && subdirectories) {\n220: \t    // If f is a directory and the subdirectory flag is set,\n221: \t    // import all the files in this directory\n222: \t    processDirectory(f);\n223: \t} else {\n224: \t    // Is this file a Jarfile?\n225: \t    if ( f.getName().endsWith(\".jar\")) {\n226: \t\tprocessJarFile(f);\n227: \t    } else {\n228: \t\tif ( f.getName().endsWith(\".class\")) {\n229:                     String fileName = f.getName();\n230: \t\t    try {    // Try to parse this file.\n231: \t\t\tparseFile(new FileInputStream(f), fileName);\n232: \t\t    } catch (Exception e1) {\n233: \t\t\te1.printStackTrace();\n234: \t\t\tsecondPassFiles.add(f);\n235: \t\t    }\n236: \t\t}\n237: \t    }\n238: \t}\n239:     }\n240: \n241:     /**\n242:      * This method imports an entire directory. It calls the parser for\n243:      * files and creates packages for the directories.\n244:      *\n245:      * @param f The directory.\n246:      *\n247:      * @throws Exception Parser exceptions.\n248:      */\n249:     protected void processDirectory(File f) throws Exception {\n250: \tboolean doSubdirs = theImport.isDiscendDirectoriesRecursively();\n251: \n252: \tString [] files = f.list();  // Get the content of the directory\n253: \n254: \tfor ( int i = 0; i < files.length; i++) {\n255: \t    processFile( new File( f, files[i]), doSubdirs);\n256: \t}\n257:     }\n258: \n259:     /**\n260:      * Process a Jar file, that contains classfiles.\n261:      *\n262:      * @param f The Jar file.\n263:      */\n264:     private void processJarFile(File f) throws Exception {\n265: \tJarFile jarfile = new JarFile(f);\n266: \t// A second pass buffer just for this jar.\n267: \tArrayList jarSecondPassFiles = new ArrayList();\n268: \n269: \tfor ( Enumeration e = jarfile.entries(); e.hasMoreElements(); ) {\n270: \t    ZipEntry entry = (ZipEntry) e.nextElement();\n271: \t    String entryName = entry.getName();\n272: \t    if ( !entry.isDirectory() && entryName.endsWith(\".class\")) {\n273: \t\ttry {\n274: \t\t    parseFile(jarfile.getInputStream(entry), entryName);\n275: \t\t} catch (Exception e1) {\n276: \t\t    if (jarSecondPassFiles.isEmpty()) {\n277: \t\t        // If there are no files tagged for a second pass,\n278: \t\t        // add the jar files as the 1st element.\n279: \t\t\tjarSecondPassFiles.add(f);\n280: \t\t    }\n281: \t\t    System.out.println(\"Exception in \" + entryName + \" : \"\n282: \t\t                                        + e1.getMessage());\n283: \t\t    e1.printStackTrace();\n284: \t\t    // Store the entry to be parsed a 2nd time.\n285: \t\t    jarSecondPassFiles.add(entryName);\n286: \t\t}\n287: \t\tThread.sleep(10);\n288: \t    }\n289: \t}\n290: \n291: \t// If there are files to parse again, add the jar to the 2nd pass.\n292: \tif ( !jarSecondPassFiles.isEmpty()) {\n293: \t    secondPassFiles.add(jarSecondPassFiles);\n294:         }\n295: \n296: \tjarfile.close();\n297:     }\n298: \n299:     /**\n300:      * Do a 2nd pass on a Jar file.\n301:      *\n302:      * @param secondPassBuffer A buffer, that holds the jarfile and\n303:      *                         the names of the entries to parse again.\n304:      */\n305:     private void do2ndJarPass(ArrayList secondPassBuffer) throws Exception {\n306: \tif ( !secondPassBuffer.isEmpty()) {\n307: \t    Iterator iterator = secondPassBuffer.iterator();\n308: \t    JarFile jarfile = new JarFile( (File) iterator.next());\n309: \n310: \t    while (iterator.hasNext()) {\n311: \t\tString filename = (String) iterator.next();\n312: \t\tdo2ndFilePass(\n313: \t\t        jarfile.getInputStream(jarfile.getEntry(filename)),\n314: \t\t        filename);\n315: \t    }\n316: \t    jarfile.close();\n317: \t}\n318:     }\n319: \n320:     /**\n321:      * Parse a file for 2nd time. The main difference\n322:      * is, that the exceptions are printed,\n323:      * instead of storing the file for a 2nd pass.\n324:      *\n325:      * @param is The input stream of the file.\n326:      */\n327:     private void do2ndFilePass(InputStream is, String fileName) {\n328: \ttry {                    // Try to parse the file.\n329: \t    parseFile(is, fileName);\n330: \t} catch (Exception e2) {    // If there were errors, show them.\n331: \t    System.out.println(\"ERROR: \" + e2.getMessage());\n332: \t    e2.printStackTrace();\n333: \t}\n334:     }\n335: \n336:     /**\n337:      * This method parses 1 Java classfile.\n338:      *\n339:      * @param is The inputStream for the file to parse.\n340:      * @param fileName the name of the file to parse\n341:      * @throws Exception Parser exception.\n342:      *\n343:      */\n344:     public void parseFile(InputStream is, String fileName) throws Exception {\n345: \n346:         int lastSlash = fileName.lastIndexOf('/');\n347: \tif (lastSlash != -1) {\n348: \t    fileName = fileName.substring(lastSlash + 1);\n349: \t}\n350: \n351:         ClassfileParser parser = new ClassfileParser(\n352:                                  new SimpleByteLexer(\n353:                                  new BufferedInputStream(is)));\n354: \n355:         // start parsing at the classfile rule\n356:         parser.classfile();\n357: \n358:         // Create a modeller for the parser\n359:         org.argouml.uml.reveng.java.Modeller modeller =\n360:             new org.argouml.uml.reveng.java.Modeller(\n361:                                                  currentProject.getModel(),\n362: \t\t\t\t\t\t diagram, theImport,\n363:                                                  getAttribute().isSelected(),\n364:                                                  getDatatype().isSelected(),\n365:                                                  fileName);\n366: \n367: \t// do something with the tree\n368: \tClassfileTreeParser tparser = new ClassfileTreeParser();\n369: \ttparser.classfile(parser.getAST(), modeller);\n370: \n371:         // Was there an exception thrown during modelling?\n372:         //Exception e = modeller.getException();\n373:         //if(e != null) {\n374:         //    throw e;\n375:         //}\n376:     }\n377: \n378:     /**\n379:      * If we have modified any diagrams, the project was modified and\n380:      * should be saved. I don't consider a import, that only modifies\n381:      * the metamodel, at this point (Andreas Rueckert <a_rueckert@gmx.net> ).\n382:      * Calling Project.setNeedsSave(true) doesn't work here, because\n383:      * Project.postLoad() is called after the import and it sets the\n384:      * _needsSave flag to false.\n385:      *\n386:      * @return true, if any diagrams where modified and\n387:      *         the project should be saved before exit.\n388:      */\n389:     public boolean needsSave() {\n390: \treturn ( !diagram.getModifiedDiagrams().isEmpty());\n391:     }\n392: \n393:     /**\n394:      * Textual description of the module.\n395:      *\n396:      * @see org.argouml.application.api.ArgoModule#getModuleDescription()\n397:      */\n398:     public String getModuleDescription() {\n399: \treturn \"Java import from class or jar files\";\n400:     }\n401: \n402:     /**\n403:      * @see org.argouml.application.api.ArgoModule#getModuleKey()\n404:      */\n405:     public String getModuleKey() {\n406: \treturn \"module.import.java-classes\";\n407:     }\n408: \n409:     /**\n410:      * @see org.argouml.application.api.ArgoModule#initializeModule()\n411:      */\n412:     public boolean initializeModule() {\n413: \n4