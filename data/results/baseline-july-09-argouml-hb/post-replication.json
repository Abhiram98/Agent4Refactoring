wing.BorderFactory;\n34: import javax.swing.ComboBoxEditor;\n35: import javax.swing.Icon;\n36: import javax.swing.JLabel;\n37: import javax.swing.JPanel;\n38: import javax.swing.JTextField;\n39: import javax.swing.border.BevelBorder;\n40: import javax.swing.plaf.basic.BasicComboBoxEditor;\n41: \n42: import org.argouml.application.helpers.ResourceLoaderWrapper;\n43: \n44: /**\n45:  * An editable combobox. Upon pressing enter the text entered by the user is\n46:  * sent as an actioncommand to the actionlistener (this). The item that's being\n47:  * edited is sent to the method doIt after that. The developer should implement\n48:  * this method \n49:  * @author jaap.branderhorst@xs4all.nl\t\n50:  * @since Jan 4, 2003\n51:  */\n52: public abstract class UMLEditableComboBox extends UMLComboBox2 {\n53: \n54:     /**\n55:      * The comboboxeditor for editable uml comboboxes. This has to be changed\n56:      * since it controls the rendering of the textfield where the user can edit\n57:      * the list elements. Setitem has to give the correct value. Furthermore,\n58:      * the standard comboboxeditor (BasicComboBoxEditor) does not support\n59:      * showing icons.\n60:      * \n61:      * @author jaap.branderhorst@xs4all.nl\t\n62:      * @since Jan 5, 2003\n63:      */\n64:     protected class UMLComboBoxEditor extends BasicComboBoxEditor {\n65: \n66:         /**\n67:          * A panel which helps us to show the editable textfield for this\n68:          * combobox (including the Icon).\n69:          * \n70:          * @author jaap.branderhorst@xs4all.nl\t\n71:          * @since Jan 5, 2003\n72:          */\n73:         private class UMLImagePanel extends JPanel {\n74: \n75:             /**\n76:              * The label that shows the icon.\n77:              */\n78:             private JLabel _imageIconLabel = new JLabel();\n79:             /**\n80:              * The textfield the user can edit.\n81:              */\n82:             private JTextField _textField;\n83:             \n84:             /**\n85:              * Constructs a UMLImagePanel\n86:              * @param textField The textfield the user can edit\n87:              * @param showIcon boolean which must be true if an icon is to be\n88:              * shown.\n89:              */\n90:             public UMLImagePanel(JTextField textField, boolean showIcon) {\n91:                 setLayout(new BorderLayout());\n92:                 _textField = textField;\n93:                 setBorder(BorderFactory.createBevelBorder(BevelBorder.LOWERED));\n94:                 if (showIcon) {\n95:                     // we don't want to show some nasty gray background color, now do we?\n96:                     _imageIconLabel.setOpaque(true);\n97:                     _imageIconLabel.setBackground(_textField.getBackground());\n98:                     add(_imageIconLabel, BorderLayout.WEST);\n99:                 }\n100:                 add(_textField, BorderLayout.CENTER);\n101:             }\n102: \n103:             public void setText(String text) {\n104:                 _textField.setText(text);\n105:             }\n106: \n107:             public String getText() {\n108:                 return _textField.getText();\n109:             }\n110: \n111:             /**\n112:              * Sets the icon. Calls repaint to redraw the panel\n113:              * @param i The icon to be shown.\n114:              */\n115:             public void setIcon(Icon i) {\n116:                 if (i != null) {\n117:                     _imageIconLabel.setIcon(i);\n118:                     // necessary to create distance between the textfield and the icon.\n119:                     _imageIconLabel.setBorder(BorderFactory.createEmptyBorder(0, 2, 0, 2));\n120: \n121:                 } else {\n122:                     _imageIconLabel.setIcon(null);\n123:                     _imageIconLabel.setBorder(null);\n124:                 }\n125:                 _imageIconLabel.invalidate();\n126:                 validate();\n127:                 repaint();\n128:             }\n129: \n130:             public void selectAll() {\n131:                 _textField.selectAll();\n132:             }\n133:             \n134:             public void addActionListener(ActionListener l) {\n135:                 _textField.addActionListener(l);                \n136:             }\n137:             \n138:             public void removeActionListener(ActionListener l) {\n139:                 _textField.removeActionListener(l);\n140:             }\n141: \n142:         }\n143: \n144:         private UMLImagePanel _panel;\n145: \n146:         /**\n147:          * True if an icon should be shown.\n148:          */\n149:         private boolean _showIcon;\n150: \n151: \n152:         /**\n153:          * Constructor for UMLComboBoxEditor.\n154:          */\n155:         public UMLComboBoxEditor(boolean showIcon) {\n156:             super();\n157:             _panel = new UMLImagePanel(editor, showIcon);\n158:             setShowIcon(showIcon);\n159:         }\n160: \n161:         /**\n162:          * @see javax.swing.ComboBoxEditor#setItem(java.lang.Object)\n163:          */\n164:         public void setItem(Object anObject) {\n165:             if (((UMLComboBoxModel2) getModel()).contains(anObject)) {\n166:                 editor.setText(((UMLListCellRenderer2) getRenderer()).makeText(anObject));\n167:                 if (_showIcon)\n168:                     _panel.setIcon(ResourceLoaderWrapper.getResourceLoaderWrapper().lookupIcon(anObject));\n169:             } else\n170:                 super.setItem(anObject);\n171: \n172:         }\n173: \n174:         /**\n175:          * Returns the showIcon.\n176:          * @return boolean\n177:          */\n178:         public boolean isShowIcon() {\n179:             return _showIcon;\n180:         }\n181: \n182:         /**\n183:          * Sets the showIcon.\n184:          * @param showIcon The showIcon to set\n185:          */\n186:         public void setShowIcon(boolean showIcon) {\n187:             _showIcon = showIcon;\n188:         }\n189: \n190:         /**\n191:          * @see javax.swing.ComboBoxEditor#getEditorComponent()\n192:          */\n193:         public Component getEditorComponent() {\n194:             return _panel;\n195:         }\n196: \n197:         /**\n198:          * @see javax.swing.ComboBoxEditor#addActionListener(java.awt.event.ActionListener)\n199:          */\n200:         public void addActionListener(ActionListener l) {\n201:             _panel.addActionListener(l);\n202:         }\n203:         \n204:         \n205: \n206:         /**\n207:          * @see javax.swing.ComboBoxEditor#removeActionListener(java.awt.event.ActionListener)\n208:          */\n209:         public void removeActionListener(ActionListener l) {\n210:             _panel.removeActionListener(l);\n211:         }\n212: \n213:         /**\n214:          * @see javax.swing.ComboBoxEditor#selectAll()\n215:          */\n216:         public void selectAll() {\n217:             super.selectAll();\n218:         }\n219: \n220:         /**\n221:          * @see javax.swing.ComboBoxEditor#getItem()\n222:          */\n223:         public Object getItem() {\n224:             return _panel.getText();\n225:         }\n226: \n227:     }\n228: \n229:     /**\n230:      * @see org.argouml.uml.ui.UMLComboBox2#UMLComboBox2(UMLComboBoxModel2, UMLAction, boolean)\n231:      */\n232:     public UMLEditableComboBox(UMLComboBoxModel2 model, UMLAction selectAction, boolean showIcon) {\n233:         super(model, selectAction, showIcon);\n234:         setEditable(true);\n235:         setEditor(new UMLComboBoxEditor(showIcon));\n236:         getEditor().addActionListener(this);\n237:     }\n238: \n239:     /**\n240:      * @see org.argouml.uml.ui.UMLComboBox2#UMLComboBox2(UMLComboBoxModel2, UMLAction)\n241:      */\n242:     public UMLEditableComboBox(UMLComboBoxModel2 arg0, UMLAction selectAction) {\n243:         this(arg0, selectAction, fa