 aggregation type of the second Associaton end\n441:      * @return MAssociation\n442:      * @throws IllegalArgumentException if either Classifier is null\n443:      */\n444:     private MAssociation buildAssociation(MClassifier c1,\n445: \t\t\t\t\t boolean nav1,\n446: \t\t\t\t\t MAggregationKind agg1,\n447: \t\t\t\t\t MClassifier c2,\n448: \t\t\t\t\t boolean nav2,\n449: \t\t\t\t\t MAggregationKind agg2) {\n450:         if (c1 == null || c2 == null) {\n451:             throw new IllegalArgumentException(\"one of \"\n452: \t\t\t\t\t       + \"the classifiers to be \"\n453: \t\t\t\t\t       + \"connected is null\");\n454:         }\n455:         MNamespace ns1 = c1.getNamespace();\n456:         MNamespace ns2 = c2.getNamespace();\n457:         if (ns1 == null || ns2 == null) {\n458:             throw new IllegalArgumentException(\"one of \"\n459: \t\t\t\t\t       + \"the classifiers does not \"\n460: \t\t\t\t\t       + \"belong to a namespace\");\n461:         }\n462:         MAssociation assoc =\n463:             UmlFactory.getFactory().getCore().createAssociation();\n464:         assoc.setName(\"\");\n465:         assoc.setNamespace(CoreHelper.getHelper().getFirstSharedNamespace(ns1,\n466:         \t\t\t\t\t\t\t\t  ns2));\n467:         buildAssociationEnd(\n468: \t\t\t    assoc,\n469: \t\t\t    null,\n470: \t\t\t    c1,\n471: \t\t\t    null,\n472: \t\t\t    null,\n473: \t\t\t    nav1,\n474: \t\t\t    null,\n475: \t\t\t    agg1,\n476: \t\t\t    null,\n477: \t\t\t    null,\n478: \t\t\t    null);\n479:         buildAssociationEnd(\n480: \t\t\t    assoc,\n481: \t\t\t    null,\n482: \t\t\t    c2,\n483: \t\t\t    null,\n484: \t\t\t    null,\n485: \t\t\t    nav2,\n486: \t\t\t    null,\n487: \t\t\t    agg2,\n488: \t\t\t    null,\n489: \t\t\t    null,\n490: \t\t\t    null);\n491:         return assoc;\n492:     }\n493: \n494:     /**\n495:      * Builds a binary associationrole on basis of two classifierroles,\n496:      * navigation and aggregation.\n497:      *\n498:      * @param fromClassifier   the first given classifier\n499:      * @param aggregationKind1 the first aggregationkind\n500:      * @param toClassifier     the second given classifier\n501:      * @param aggregationKind2 the second aggregationkind\n502:      * @param unidirectional true if unidirectional\n503:      * @return the newly build binary associationrole\n504:      */\n505:     public Object buildAssociation(\n506: \t\t\t\t\t Object fromClassifier,\n507: \t\t\t\t\t Object aggregationKind1,\n508: \t\t\t\t\t Object toClassifier,\n509: \t\t\t\t\t Object aggregationKind2,\n510: \t\t\t\t\t Boolean unidirectional) {\n511:         if (fromClassifier == null || toClassifier == null)\n512:                 throw new IllegalArgumentException(\"one of \"\n513:         \t\t\t\t       + \"the classifiers to be \"\n514:         \t\t\t\t       + \"connected is null\");\n515:         MClassifier from = (MClassifier) fromClassifier;\n516:         MClassifier to = (MClassifier) toClassifier;\n517:         MAggregationKind agg1 = (MAggregationKind) aggregationKind1;\n518:         MAggregationKind agg2 = (MAggregationKind) aggregationKind2;\n519:         \n520:         MNamespace ns1 = from.getNamespace();\n521:         MNamespace ns2 = to.getNamespace();\n522:         if (ns1 == null || ns2 == null)\n523:                 throw new IllegalArgumentException(\"one of \"\n524:         \t\t\t\t       + \"the classifiers does not \"\n525:         \t\t\t\t       + \"belong to a namespace\");\n526:         MAssociation assoc =\n527:                 UmlFactory.getFactory().getCore().createAssociation();\n528:         assoc.setName(\"\");\n529:         assoc.setNamespace(\n530:         \t\t   CoreHelper.getHelper().getFirstSharedNamespace(ns1,\n531:         \t\t\t\t\t\t\t\t  ns2));\n532:         \n533:         boolean nav1 = true;\n534:         boolean nav2 = true;\n535: \n536:         if (from instanceof MInterface) {\n537:             nav2 = false;\n538:             agg2 = agg1;\n539:             agg1 = null;\n540:         } else if (to instanceof MInterface) {\n541:             nav1 = false;\n542:         } else {\n543:             nav1 = !Boolean.TRUE.equals(unidirectional);\n544:             nav2 = true;\n545:         }\n546: \n547:         buildAssociationEnd(\n548: \t\t\t    assoc,\n549: \t\t\t    null,\n550: \t\t\t    from,\n551: \t\t\t    null,\n552: \t\t\t    null,\n553: \t\t\t    nav1,\n554: \t\t\t    null,\n555: \t\t\t    agg1,\n556: \t\t\t    null,\n557: \t\t\t    null,\n558: \t\t\t    null);\n559:         buildAssociationEnd(\n560: \t\t\t    assoc,\n561: \t\t\t    null,\n562: \t\t\t    to,\n563: \t\t\t    null,\n564: \t\t\t    null,\n565: \t\t\t    nav2,\n566: \t\t\t    null,\n567: \t\t\t    agg2,\n568: \t\t\t    null,\n569: \t\t\t    null,\n570: \t\t\t    null);\n571: \n572:         return assoc;\n573:     }\n574: \n575: \n576:     /**\n577:      * Builds a binary associations between two classifiers with\n578:      * default values for the association ends and the association\n579:      * itself.<p>\n580:      *\n581:      * @param classifier1 The first classifier to connect\n582:      * @param classifier2 The second classifier to connect\n583:      * @return MAssociation\n584:      */\n585:     public MAssociation buildAssociation(\n586:             Object classifier1,\n587: \t\t\tObject classifier2) {\n588:         MClassifier c1 = (MClassifier) classifier1;\n589:         MClassifier c2 = (MClassifier) classifier2;\n590:         return buildAssociation(c1, true, MAggregationKind.NONE,\n591:                                 c2, true, MAggregationKind.NONE);\n592:     }\n593: \n594:     /**\n595:      * Builds a binary association with a direction, aggregation\n596:      * and a given name.\n597:      *\n598:      * @param c1 The first classifier to connect to\n599:      * @param nav1 The navigability of the Associaton end\n600:      * @param c2 The second classifier to connect to\n601:      * @param nav2 The navigability of the second Associaton end\n602:      * @param name the given name\n603:      * @return association\n604:      */\n605:     public Object buildAssociation(Object c1, boolean nav1,\n606: \t\t\t\t   Object c2, boolean nav2, String name)\n607:     {\n608:         MAssociation assoc =\n609: \t    buildAssociation((MClassifier) c1, nav1, MAggregationKind.NONE,\n610: \t\t\t     (MClassifier) c2, nav2, MAggregationKind.NONE);\n611:         if (assoc != null)\n612:             assoc.setName(name);\n613:         return assoc;\n614:     }\n615: \n616:     /**\n617:      * Builds an associationClass between classifier end1 and end2 with a\n618:      * default class.<p>\n619:      *\n620:      * @param end1 the first given classifier\n621:      * @param end2 the second given classifier\n622:      * @return MAssociationClass\n623:      */\n624:     public MAssociationClass buildAssociationClass(\n625: \t\t\t\t\t\t   MClassifier end1,\n626: \t\t\t\t\t\t   MClassifier end2) {\n627:         if (end1 == null\n628:                 || end2 == null\n629:                 || end1 instanceof MAssociationClass\n630:                 || end2 instanceof MAssociationClass)\n631:             throw new IllegalArgumentException(\"\"\n632:         \t\t\t\t       + \"either one of the arguments \"\n633:         \t\t\t\t       + \"was null or \"\n634:         \t\t\t\t       + \"was instanceof \"\n635:         \t\t\t\t       + \"MAssociationClass\");\n636:         return buildAssociationClass((MClass) buildClass(), end1, end2);\n637:     }\n638: \n639:     /**\n640:      * Builds a fully configurable association end. All variables for\n641:      * an associationend can be given as parameter.\n642:      * @param assoc The associaton this end will be part of\n643:      * @param name The name of the association end\n644:      * @param type The type (classifier) the end will connect. The end\n645:      * is a connection piece between an association and a classifier\n646:      * @param multi The multiplicity\n647:      * @param stereo The stereotype\n648:      * @param navigable The navigability. True if this association end\n649:      *                  can be 'passed' from the other classifier.\n650:      * @param order Ordering of the association\n651:      * @param aggregation the aggregationkind\n652:      * @param scope the scope kind\n653:      * @param changeable the changeablekind\n654:      * @param visibility the visibilitykind\n655:      * @return MAssociationEnd\n656:      */\n657:     private MAssociationEnd buildAssociationEnd(\n658: \t\t\t\t\t       MAssociation assoc,\n659: \t\t\t\t\t       String name,\n660: \t\t\t\t\t       MClassifier type,\n661: \t\t\t\t\t       MMultiplicity multi,\n662: \t\t\t\t\t       MStereotype stereo,\n663: \t\t\t\t\t       boolean navigable,\n664: \t\t\t\t\t       MOrderingKind order,\n665: \t\t\t\t\t       MAggregationKind aggregation,\n666: \t\t\t\t\t       MScopeKind scope,\n667: \t\t\t\t\t       MChangeableKind changeable,\n668: \t\t\t\t\t       MVisibilityKind visibility) {\n669:         // wellformednessrules and preconditions\n670:         if (assoc == null || type == null) {\n671:             throw new IllegalArgumentException(\"either type or association \"\n672: \t\t\t\t\t       + \"are null\");\n673:         }\n674:         if (type instanceof MDataType || type instanceof MInterface) {\n675:             if (!navigable) {\n676:                 throw new IllegalArgumentException(\n677:                         \"Wellformedness rule 2.5.3.3 [1] is broken. \"\n678:                         + \"The Classifier of an AssociationEnd cannot be an \"\n679:                         + \"Interface or a DataType if the association is \"\n680:                         + \"navigable away from that end.\");\n681:             }\n682:             List ends = new ArrayList();\n683:             ends.addAll(assoc.getConnections());\n684:             Iterator it = ends.iterator();\n685:             while (it.hasNext()) {\n686:                 MAssociationEnd end = (MAssociationEnd) it.next();\n687:                 if (end.isNavigable()) {\n688:                     throw new IllegalArgumentException(\"type is either \"\n689: \t\t\t\t\t\t       + \"datatype or \"\n690: \t\t\t\t\t\t       + \"interface and is \"\n691: \t\t\t\t\t\t       + \"navigable to\");\n692:                 }\n693:             }\n694:         }\n695:         if (aggregation != null\n696:                 && aggregation.equals(MAggregationKind.COMPOSITE)\n697:                 && multi != null\n698:                 && multi.getUpper() > 1) {\n699:             throw new IllegalArgumentException(\"aggregation is composite \"\n700: \t\t\t\t\t   + \"and multiplicity > 1\");\n701:         }\n702: \n703:         MAssociationEnd end =\n704:             UmlFactory.getFactory().getCore().createAssociationEnd();\n705:         end.setAssociation(assoc);\n706:         end.setType(type);\n707:         end.setName(name);\n708:         if (multi != null) {\n709:             end.setMultiplicity(multi);\n710:         } else {\n711:             end.setMultiplicity(MMultiplicity.M1_1);\n712:         }\n713:         if (stereo != null) {\n714:             end.setStereotype(stereo);\n715:         }\n716:         end.setNavigable(navigable);\n717:         if (order != null) {\n718:             end.setOrdering(order);\n719:         } else {\n720:             end.setOrdering(MOrderingKind.UNORDERED);\n721:         }\n722:         if (aggregation != null) {\n723:             end.setAggregation(aggregation);\n724:         } else {\n725:             end.setAggregation(MAggregationKind.NONE);\n726:         }\n727:         if (scope != null) {\n728:             end.setTargetScope(scope);\n729:         } else {\n730:             end.setTargetScope(MScopeKind.INSTANCE);\n731:         }\n732:         if (changeable != null) {\n733:             end.setChangeability(changeable);\n734:         } else {\n735:             end.setChangeability(MChangeableKind.CHANGEABLE);\n736:         }\n737:         if (visibility != null) {\n738:             end.setVisibility(visibility);\n739:         } else {\n740:             end.setVisibility(MVisibilityKind.PUBLIC);\n741:         }\n742:         return end;\n743:     }\n744: \n745:     /**\n746:      * Builds an association class from a class and two classifiers\n747:      * that should be associated. Both ends of the associationclass\n748:      * are navigable.<p>\n749:      *\n750:      * @param cl the class\n751:      * @param end1 the first classifier\n752:      * @param end2 the second classifier\n753:      * @return MAssociationClass\n754:      */\n755:     private MAssociationClass buildAssociationClass(MClass cl,\n756: \t\t\t\t\t\t  MClassifier end1,\n757: \t\t\t\t\t\t  MClassifier end2) {\n758:         if (end1 == null\n759:                 || end2 == null\n760:                 || cl == null\n761:                 || end1 instanceof MAssociationClass\n762:                 || end2 instanceof MAssociationClass)\n763:             throw new IllegalArgumentException(\"either one of the arguments \"\n764:         \t\t\t\t       + \"was null or was instanceof \"\n765:         \t\t\t\t       + \"MAssociationClass\");\n766:         MAssociationClass assoc = createAssociationClass();\n767:         assoc.setName(cl.getName());\n768:         assoc.setAbstract(cl.isAbstract());\n769:         assoc.setActive(cl.isActive());\n770:         assoc.setAssociationEnds(cl.getAssociationEnds());\n771:         assoc.setClassifierRoles(cl.getClassifierRoles());\n772:         assoc.setClassifierRoles1(cl.getClassifierRoles1());\n773:         assoc.setClassifiersInState(cl.getClassifiersInState());\n774:         assoc.setClientDependencies(cl.getClientDependencies());\n775:         assoc.setCollaborations(cl.getCollaborations());\n776:         assoc.setCollaborations1(cl.getCollaborations1());\n777:         assoc.setComments(cl.getComments());\n778:         assoc.setConstraints(cl.getConstraints());\n779:         assoc.setCreateActions(cl.getCreateActions());\n780:         assoc.setFeatures(cl.getFeatures());\n781:         assoc.setExtensions(cl.getExtensions());\n782:         assoc.setGeneralizations(cl.getGeneralizations());\n783:         assoc.setInstances(cl.getInstances());\n784:         assoc.setLeaf(cl.isLeaf());\n785:         assoc.setNamespace(cl.getNamespace());\n786:         assoc.setObjectFlowStates(cl.getObjectFlowStates());\n787:         assoc.setParameters(cl.getParameters());\n788:         assoc.setParticipants(cl.getParticipants());\n789:         assoc.setPartitions1(cl.getPartitions1());\n790:         assoc.setPowertypeRanges(cl.getPowertypeRanges());\n791:         assoc.setPresentations(cl.getPresentations());\n792:         assoc.setRoot(cl.isRoot());\n793:         assoc.setSourceFlows(cl.getSourceFlows());\n794:         assoc.setSpecification(cl.isSpecification());\n795:         assoc.setStereotype(cl.getStereotype());\n796:         assoc.setStructuralFeatures(cl.getStructuralFeatures());\n797:         assoc.setTaggedValues(cl.getTaggedValues());\n798:         assoc.setVisibility(cl.getVisibility());\n799:         buildAssociationEnd(\n800:         \t\t    assoc,\n801:         \t\t    null,\n802:         \t\t    end1,\n803:         \t\t    null,\n804:         \t\t    null,\n805:         \t\t    true,\n806:         \t\t    null,\n807:         \t\t    null,\n808:         \t\t    null,\n809:         \t\t    null,\n810:         \t\t    null);\n811:         buildAssociationEnd(\n812:         \t\t    assoc,\n813:         \t\t    null,\n814:         \t\t    end2,\n815:         \t\t    null,\n816:         \t\t    null,\n817:         \t\t    true,\n818:         \t\t    null,\n819:         \t\t    null,\n820:         \t\t    null,\n821:         \t\t    null,\n822:         \t\t    null);\n823:         return assoc;\n824:     }\n825: \n826:     /**\n827:      * Builds a default attribute.\n828:      * @return MAttribute\n829:      */\n830:     public Object buildAttribute() {\n831:         //build the default attribute\n832:         // this should not be here via the ProjectBrowser but the CoreHelper\n833:         // should provide this functionality\n834:         Project p = ProjectManager.getManager().getCurrentProject();\n835:         MClassifier intType = (MClassifier) p.findType(\"int\");\n836:         if (p.getModel() != intType.getNamespace()\n837:                 && !(ModelManagementHelper.getHelper()\n838:                     .getAllNamespaces(p.getModel())\n839:         \t        .contains(intType.getNamespace()))) {\n840:             intType.setNamespace((MModel) p.getModel());\n841:         }\n842:         MAttribute element = createAttribute();\n843:         element.setName(\"newAttr\");\n844:         element.setMultiplicity(\n845:             UmlFactory.getFactory().getDataTypes().createMultiplicity(1, 1));\n846:         element.setStereotype(null);\n847:         element.setOwner(null);\n848:         element.setType(intType);\n849:         element.setInitialValue(null);\n850:         element.setVisibility(MVisibilityKind.PUBLIC);\n851:         element.setOwnerScope(MScopeKind.INSTANCE);\n852:         element.setChangeability(MChangeableKind.CHANGEABLE);\n853:         element.setTaggedValue(\"transient\", \"false\");\n854:         element.setTaggedValue(\"volatile\", \"false\");\n855:         element.setTargetScope(MScopeKind.INSTANCE);\n856:         \n857:         return element;\n858:     }\n859: \n860:     /**\n861:      * Builds an attribute owned by some classifier cls. I don't know\n862:      * if this is legal for an interface (purely UML speaking). In\n863:      * this method it is.<p>\n864:      *\n865:      * @param handle the given classifier\n866:      * @return the newly build attribute\n867:      */\n868:     public Object buildAttribute(Object handle) {\n869:         if (!ModelFacade.isAClassifier(handle)) {\n870:             return null;\n871:         }\n872:         MClassifier cls = (MClassifier) handle;\n873:         MAttribute attr = (MAttribute) buildAttribute();\n874:         cls.addFeature(attr);\n875:         // we set the listeners to the figs here too\n876:         // it would be better to do that in the figs themselves\n877:         Project p = ProjectManager.getManager().getCurrentProject();\n878:         Iterator it = p.findFigsForMember(cls).iterator();\n879:         while (it.hasNext()) {\n880:             PropertyChangeListener listener = \n881:                 (PropertyChangeListener) it.next();\n882:             // Model.getPump().removeModelEventListener(listener, attr);\n883:             Model.getPump().addModelEventListener(listener, attr);\n884:         }\n885:         return attr;\n886:     }\n887: \n888:     /**\n889:      * Builds a default implementation for a class. The class is not owned by\n890:      * any model element by default. Users should not forget to add ownership\n891:      * @return MClass\n892:      */\n893:     public Object buildClass() {\n894:         MClass cl = createClass();\n895:         // cl.setNamespace(ProjectBrowser.getInstance().getProject()\n896:         // .getModel());\n897:         cl.setName(\"\");\n898:         cl.setStereotype(null);\n899:         cl.setAbstract(false);\n900:         cl.setActive(false);\n901:         cl.setRoot(false);\n902:         cl.setLeaf(false);\n903:         cl.setSpecification(false);\n904:         cl.setVisibility(MVisibilityKind.PUBLIC);\n905:         return cl;\n906:     }\n907: \n908:     /**\n909:      * Builds a class with a given namespace.\n910:      *\n911:      * @param owner the namespace\n912:      * @return MClass\n913:      * @see #buildClass()\n914:      */\n915:     public Object buildClass(Object owner) {\n916:         Object clazz = buildClass();\n917:         if (owner instanceof MNamespace)\n918:             ModelFacade.setNamespace(clazz, /*MNamespace*/ owner);\n919:         return clazz;\n920:     }\n921: \n922:     /**\n923:      * Builds a class with a given name.\n924:      *\n925:      * @param name the given name\n926:      * @return MClass\n927:      * @see #buildClass()\n928:      */\n929:     public Object buildClass(String name) {\n930:         Object clazz = buildClass();\n931:         ModelFacade.setName(clazz, name);\n932:         return clazz;\n933:     }\n934: \n935:     /**\n936:      * Builds a class with a given name and namespace.\n937:      *\n938:      * @param name the given name\n939:      * @param owner the namespace\n940:      * @return MClass\n941:      * @see #buildClass()\n942:      */\n943:     public Object buildClass(String name, Object owner) {\n944:         Object clazz = buildClass();\n945:         ModelFacade.setName(clazz, name);\n946:         if (owner instanceof MNamespace) {\n947:             ModelFacade.setNamespace(clazz, /*MNamespace*/ owner);\n948:         }\n949:         return clazz;\n950:     }\n951: \n952:     /**\n953:      * Builds a default implementation for an interface. The interface\n954:      * is not owned by any model element by default. Users should not\n955:      * forget to add ownership.\n956:      *\n957:      * @return MInterface\n958:      */\n959:     public Object buildInterface() {\n960: \tMInterface cl = createInterface();\n961: \t// cl.setNamespace(ProjectBrowser.getInstance().getProject()\n962: \t// .getModel());\n963: \tcl.setName(\"\");\n964: \tcl.setStereotype(null);\n965: \tcl.setAbstract(false);\n966: \tcl.setRoot(false);\n967: \tcl.setLeaf(false);\n968: \tcl.setSpecification(false);\n969: \tcl.setVisibility(MVisibilityKind.PUBLIC);\n970: \treturn cl;\n971:     }\n972: \n973:     /**\n974:      * Builds an interface with a given namespace.\n975:      *\n976:      * @param owner is the owner\n977:      * @return MInterface\n978:      * @see #buildInterface()\n979:      */\n980:     public Object buildInterface(Object owner) {\n981: \tMInterface cl = (MInterface) buildInterface();\n982: \tif (owner instanceof MNamespace)\n983: \t    cl.setNamespace((MNamespace) owner);\n984: \treturn cl;\n985:     }\n986: \n987:     /**\n988:      * Builds an interface with a given name.\n989:      *\n990:      * @param name is the given name.\n991:      * @return MInterface\n992:      * @see #buildInterface()\n993:      */\n994:     public Object buildInterface(String name) {\n995: \tMInterface cl = (MInterface) buildInterface();\n996: \tcl.setName(name);\n997: \treturn cl;\n998:     }\n999: \n1000:     /**\n1001:      * Builds an interface with a given name and namespace.\n1002:      *\n1003:      * @param name is the given name\n1004:      * @param owner is the namespace\n1005:      * @return MInterface\n1006:      * @see #buildInterface()\n1007:      */\n1008:     public Object buildInterface(String name, Object owner) {\n1009: \tMInterface cl = (MInterface) buildInterface();\n1010: \tcl.setName(name);\n1011: \tif (owner instanceof MNamespace)\n1012: \t    cl.setNamespace((MNamespace) owner);\n1013: \treturn cl;\n1014:     }\n1015: \n1016:     /**\n1017:      * Builds a datatype with a given name and namespace.\n1018:      *\n1019:      * @param name is the name\n1020:      * @param owner is the namespace\n1021:      * @return an initialized UML DataType instance.\n1022:      */\n1023:     public Object buildDataType(String name, Object owner) {\n1024: \tMDataType dt = createDataType();\n1025: \tdt.setName(name);\n1026: \tif (owner instanceof MNamespace)\n1027: \t    dt.setNamespace((MNamespace) owner);\n1028: \treturn dt;\n1029:     }\n1030: \n1031:     /**\n1032:      * Builds a modelelement dependency between two modelelements.<p>\n1033:      *\n1034:      * @param clientObj is the client\n1035:      * @param supplierObj is the supplier\n1036:      * @return MDependency\n1037:      */\n1038:     public Object buildDependency(Object clientObj,\n1039: \t\t\t\t       Object supplierObj) {\n1040: \n1041: \tMModelElement client = (MModelElement) clientObj;\n1042: \tMModelElement supplier = (MModelElement) supplierObj;\n1043: \tif (client == null\n1044:                 || supplier == null\n1045:                 || client.getNamespace() == null\n1046:                 || supplier.getNamespace() == null) {\n1047: \t    throw new IllegalArgumentException(\"client or supplier is null \"\n1048: \t\t\t\t\t       + \"or their namespaces.\");\n1049: \t}\n1050: \tMDependency dep = createDependency();\n1051: \tdep.addSupplier(supplier);\n1052: \tdep.addClient(client);\n1053: \tif (supplier.getNamespace() != null) {\n1054: \t    dep.setNamespace(supplier.getNamespace());\n1055: \t} else if (client.getNamespace() != null) {\n1056: \t    dep.setNamespace(client.getNamespace());\n1057: \t}\n1058: \treturn dep;\n1059:     }\n1060: \n1061:     /**\n1062:      * Builds a modelelement permission between two modelelements.\n1063:      *\n1064:      * @param clientObj is the client\n1065:      * @param supplierObj is the supplier\n1066:      * @return MPermission\n1067:      */\n1068:     public MPermission buildPermission(Object clientObj,\n1069: \t\t\t\t       Object supplierObj) {\n1070: \n1071: \tMModelElement client = (MModelElement) clientObj;\n1072: \tMModelElement supplier = (MModelElement) supplierObj;\n1073: \tif (client == null\n1074: \t    || supplier == null\n1075: \t    || client.getNamespace() == null\n1076: \t    || supplier.getNamespace() == null)\n1077: \t    throw new IllegalArgumentException(\"client or supplier is null \"\n1078: \t\t\t\t\t       + \"or their namespaces.\");\n1079: \tMPermission per = createPermission();\n1080: \tper.addSupplier(supplier);\n1081: \tper.addClient(client);\n1082: \tif (supplier.getNamespace() != null)\n1083: \t    per.setNamespace(supplier.getNamespace());\n1084: \telse if (client.getNamespace() != null)\n1085: \t    per.setNamespace(client.getNamespace());\n1086: \tExtensionMechanismsFactory.getFactory()\n1087: \t    .buildStereotype(per, \"import\", per.getNamespace());\n1088: \treturn per;\n1089:     }\n1090: \n1091:     /**\n1092:      * Builds a generalization between a parent and a child with a given name.\n1093:      *\n1094:      * @param child is the child\n1095:      * @param parent is the parent\n1096:      * @param name is the given name\n1097:      * @return generalization\n1098:      */\n1099:     public Object buildGeneralization(Object child, Object parent,\n1100: \t\t\t\t      String name)\n1101:     {\n1102:         if (child == null\n1103: \t    || parent == null\n1104: \t    || !(child instanceof MGeneralizableElement)\n1105: \t    || !(parent instanceof MGeneralizableElement))\n1106:             return null;\n1107:         Object gen = buildGeneralization(child, parent);\n1108:         if (gen != null)\n1109:             ((MGeneralization) gen).setName(name);\n1110:         return gen;\n1111:     }\n1112: \n1113:     /**\n1114:      * Builds a generalization between a parent and a child. Does not check if\n1115:      * multiple inheritance is allowed for the current notation.\n1116:      *\n1117:      * @param child1 is the child\n1118:      * @param parent1 is the parent\n1119:      * @return MGeneralization\n1120:      */\n1121:     public MGeneralization buildGeneralization(Object child1, Object parent1)\n1122:     {\n1123:         if (!(child1 instanceof MGeneralizableElement)\n1124: \t    || !(parent1 instanceof MGeneralizableElement))\n1125:             throw new IllegalArgumentException();\n1126: \n1127:         MGeneralizableElement child = (MGeneralizableElement) child1;\n1128:         MGeneralizableElement parent = (MGeneralizableElement) parent1;\n1129: \n1130:         if (parent.getParents().contains(child))\n1131:             return null;\n1132:         if (!child.getClass().equals(parent.getClass()))\n1133:             return null;\n1134:         Iterator it = parent.getGeneralizations().iterator();\n1135:         while (it.hasNext()) {\n1136:             MGeneralization gen = (MGeneralization) it.next();\n1137:             if (gen.getParent().equals(child))\n1138:                 return null;\n1139:         }\n1140:         if (parent.getNamespace() == null)\n1141:             return null;\n1142:         if (parent.isLeaf())\n1143:             return null;\n1144:         if (child.isRoot())\n1145:             return null;\n1146: \n1147:         MGeneralization gen = createGeneralization();\n1148:         gen.setParent(parent);\n1149:         gen.setChild(child);\n1150:         if (parent.getNamespace() != null)\n1151:             gen.setNamespace(parent.getNamespace());\n1152:         else if (child.getNamespace() != null)\n1153:             gen.setNamespace(child.getNamespace());\n1154:         return gen;\n1155:     }\n1156: \n1157:     /**\n1158:      * Builds a default method belonging to a certain operation. The\n1159:      * language of the body is set to the selected Notation\n1160:      * language. The body of the method is set to an emtpy string.\n1161:      *\n1162:      * @param op is the operation\n1163:      * @return MMethod\n1164:      */\n1165:     public MMethod buildMethod(MOperation op) {\n1166: \treturn buildMethod(op, Notation.getDefaultNotation(), \"\");\n1167:     }\n1168: \n1169:     /**\n1170:      * Builds a method belonging to a certain operation.\n1171:      * @param op The operation this method belongs to\n1172:      * @param notation The notationname (language name) of the body\n1173:      * @param body The actual body of the method\n1174:      * @return MMethod\n1175:      */\n1176:     public MMethod buildMethod(\n1177: \t\t\t       MOperation op,\n1178: \t\t\t       NotationName notation,\n1179: \t\t\t       String body) {\n1180: \tMMethod method = createMethod();\n1181: \tif (op != null) {\n1182: \t    method.setSpecification(op);\n1183: \t    MClassifier owner = op.getOwner();\n1184: \t    if (owner != null) {\n1185: \t\tmethod.setOwner(owner);\n1186: \t    }\n1187: \t}\n1188: \tif (notation != null && notation.getName() != null) {\n1189: \t    method.setBody(\n1190: \t\t\t   UmlFactory\n1191: \t\t\t   .getFactory()\n1192: \t\t\t   .getDataTypes()\n1193: \t\t\t   .createProcedureExpression(\n1194: \t\t\t\t\t\t      notation.getName(),\n1195: \t\t\t\t\t\t      body));\n1196: \t}\n1197: \treturn method;\n1198:     }\n1199: \n1200:     /**\n1201:      * Builds a method with a given name.\n1202:      *\n1203:      * @param name is the given name\n1204:      * @return method\n1205:      */\n1206:     public MMethod buildMethod(String name) {\n1207:         MMethod method = createMethod();\n1208:         if (method != null)\n1209:             method.setName(name);\n1210:         return method;\n1211:     }\n1212: \n1213:     /**\n1214:      * Builds an operation for a classifier.<p>\n1215:      *\n1216:      * @param handle is the classifier.\n1217:      * @return MOperation\n1218:      */\n1219:     public MOperation buildOperation(Object handle) {\n1220:         if (!(handle instanceof MClassifier)) {\n1221:             throw new IllegalArgumentException(\"Handle is not a classifier\");\n1222:         }\n1223:         MClassifier cls = (MClassifier) handle;\n1224: \tMOperation oper = createOperation();\n1225: \toper.setName(\"newOperation\");\n1226: \toper.setStereotype(null);\n1227: \toper.setOwner(cls);\n1228: \toper.setVisibility(MVisibilityKind.PUBLIC);\n1229: \toper.setAbstract(false);\n1230: \toper.setLeaf(false);\n1231: \toper.setRoot(false);\n1232: \toper.setQuery(false);\n1233: \toper.setOwnerScope(MScopeKind.INSTANCE);\n1234:         // Jaap Branderhorst 6-4-2003 commented out next line since an\n1235:         // operation cannot have two owners.  the owner must be the\n1236:         // owning classifier which must be set via the setOwner\n1237:         // method, not via the namespace.\n1238: \t//\n1239:         // oper.setNamespace(cls);\n1240: \toper.setConcurrency(MCallConcurrencyKind.SEQUENTIAL);\n1241: \n1242: \tMParameter returnParameter = buildParameter(oper);\n1243: \treturnParameter.setKind(MParameterDirectionKind.RETURN);\n1244: \treturnParameter.setName(\"return\");\n1245: \t// we set the listeners to the figs here too it would be\n1246: \t// better to do that in the figs themselves the\n1247: \t// elementlistener for the parameter is allready set in\n1248: \t// buildparameter(oper)\n1249: \tProject p = ProjectManager.getManager().getCurrentProject();\n1250: \tIterator it = p.findFigsForMember(cls).iterator();\n1251: \twhile (it.hasNext()) {\n1252: \t    PropertyChangeListener listener = \n1253: \t        (PropertyChangeListener) it.next();\n1254: \t    // UmlModelEventPump.getPump().removeModelEventListener(listener,\n1255: \t    // oper);\n1256: \t    Model.getPump().addModelEventListener(listener, oper);\n1257: \t}\n1258: \treturn oper;\n1259:     }\n1260: \n1261:     /**\n1262:      * Builds an operation with a given name for classifier.\n1263:      *\n1264:      * @param cls is the classifier.\n1265:      * @param name is the given name.\n1266:      * @return MOperation\n1267:      */\n1268:     public Object buildOperation(Object cls, String name) {\n1269:         MOperation oper = buildOperation(cls);\n1270:         if (oper != null)\n1271:             oper.setName(name);\n1272:         return oper;\n1273:     }\n1274: \n1275:     /**\n1276:      * Constructs a default parameter.\n1277:      *\n1278:      * @return      The newly created parameter.\n1279:      */\n1280:     public MParameter buildParameter() {\n1281: \t// this should not be here via the ProjectBrowser but the CoreHelper\n1282: \t// should provide this functionality\n1283: \tProject p = ProjectManager.getManager().getCurrentProject();\n1284: \tMClassifier voidType = (MClassifier) p.findType(\"void\");\n1285: \tif (voidType.getModel() != p.getModel()) {\n1286: \t    voidType.setNamespace((MModel) p.getModel());\n1287: \t}\n1288: \tMParameter res = UmlFactory.getFactory().getCore().createParameter();\n1289: \tres.setName(\"\");\n1290: \tres.setStereotype(null);\n1291: \tres.setType(voidType);\n1292: \tres.setKind(MParameterDirectionKind.IN);\n1293: \tres.setDefaultValue(null);\n1294: \n1295: \treturn res;\n1296:     }\n1297: \n1298:     /**\n1299:      * Constructs a default parameter and adds it to oper. The name is\n1300:      * unique in the operation so no code generation problems will\n1301:      * exist.\n1302:      *\n1303:      * @param oper  The operation where it is added to.\n1304:      *          If null, it is not added.\n1305:      * @return      The newly created parameter.\n1306:      */\n1307:     public MParameter buildParameter(MBehavioralFeature oper) {\n1308: \tif (oper == null || oper.getOwner() == null)\n1309: \t    throw new IllegalArgumentException(\"operation is null or does not \"\n1310: \t\t\t\t\t       + \"have an owner\");\n1311: \tMParameter res = buildParameter();\n1312: \tString name = \"arg\";\n1313: \tint counter = 1;\n1314: \n1315: \toper.addParameter(res);\n1316: \tIterator it = oper.getParameters().iterator();\n1317: \twhile (it.hasNext()) {\n1318: \t    MParameter para = (MParameter) it.next();\n1319: \t    if ((name + counter).equals(para.getName())) {\n1320: \t\tcounter++;\n1321: \t    }\n1322: \t}\n1323: \n1324: \tres.setName(name + counter);\n1325: \n1326: \t// we set the listeners to the figs here too\n1327: \t// it would be better to do that in the figs themselves\n1328: \tProject p = ProjectManager.getManager().getCurrentProject();\n1329: \tit = p.findFigsForMember(oper).iterator();\n1330: \twhile (it.hasNext()) {\n1331: \t    PropertyChangeListener listener = \n1332: \t        (PropertyChangeListener) it.next();\n1333: \t    // Model.getPump().removeModelEventListener(listener, res);\n1334: \t    Model.getPump().addModelEventListener(listener, res);\n1335: \t}\n1336: \n1337: \treturn res;\n1338:     }\n1339: \n1340:     /**\n1341:      * Constructs a default parameter, adds it to oper and sets its type\n1342:      * (return etc.).<p>\n1343:      *\n1344:      * @param feature The operation where it is added to.\n1345:      *          If null, it is not added.\n1346:      * @param dk The directionkind. If null it is not set.\n1347:      * @return      The newly created parameter.\n1348:      */\n1349:     public Object buildParameter(Object feature, Object dk) {\n1350:         MBehavioralFeature oper = (MBehavioralFeature) feature;\n1351:         MParameterDirectionKind directionKind = (MParameterDirectionKind) dk;\n1352: \tMParameter res = buildParameter(oper);\n1353: \tif (directionKind != null) {\n1354: \t    ModelFacade.setKind(res, directionKind);\n1355: \t}\n1356: \treturn res;\n1357:     }\n1358: \n1359:     /**\n1360:      * Adds a parameter initialized to default values to a given event\n1361:      * or behavioral feature\n1362:      * @param o an event or behavioral feature\n1363:      * @return MParameter\n1364:      */\n1365:     public MParameter buildParameter(Object o) {\n1366: \tif (o instanceof MEvent) {\n1367: \t    MEvent event = (MEvent) o;\n1368: \t    MParameter res = buildParameter();\n1369: \t    res.setKind(MParameterDirectionKind.IN);\n1370: \t    //    removing this next line solves issue 2209\n1371: \t    //res.setNamespace(event.getNamespace()); \n1372:             event.addParameter(res);\n1373: \t    return res;\n1374: \t} else if (o instanceof MBehavioralFeature) {\n1375: \t    return buildParameter((MBehavioralFeature) o);\n1376: \t} else\n1377: \t    return null;\n1378:     }\n1379: \n1380:     /**\n1381:      * Builds a realization between some supplier (for example an\n1382:      * interface in Java) and a client who implements the realization.\n1383:      *\n1384:      * @param client is the client\n1385:      * @param supplier is the supplier\n1386:      * @return Object the created abstraction\n1387:      */\n1388:     public Object buildRealization(MModelElement client,\n1389: \t\t\t\t   MModelElement supplier)\n1390:     {\n1391: \tif (client == null\n1392: \t    || supplier == null\n1393: \t    || client.getNamespace() == null\n1394: \t    || supplier.getNamespace() == null)\n1395: \t{\n1396: \t    throw new IllegalArgumentException(\"faulty arguments.\");\n1397: \t}\n1398: \tObject realization =\n1399: \t    UmlFactory.getFactory().getCore().createAbstraction();\n1400: \tMNamespace nsc = client.getNamespace();\n1401: \tMNamespace nss = supplier.getNamespace();\n1402: \tMNamespace ns = null;\n1403: \tif (nsc != null && nsc.equals(nss)) {\n1404: \t    ns = nsc;\n1405: \t} else {\n1406: \t    ns =\n1407: \t\t(MModel) ProjectManager.getManager().getCurrentProject()\n1408: \t\t    .getModel();\n1409: \t}\n1410: \tExtensionMechanismsFactory.getFactory().buildStereotype(realization,\n1411: \t\t\t\t\t\t\t\t\"realize\", ns);\n1412: \tModelFacade.addClientDependency(client, realization);\n1413: \tModelFacade.addSupplierDependency(supplier, realization);\n1414: \treturn realization;\n1415:     }\n1416: \n1417:     /**\n1418:      * Builds a usage between some client and a supplier. If client\n1419:      * and supplier do not have the same model, an\n1420:      * {@link IllegalArgumentException} is thrown.\n1421:      *\n1422:      * @param client is the client\n1423:      * @param supplier is the supplier\n1424:      * @return MUsage\n1425:      */\n1426:     public MUsage buildUsage(MModelElement client, MModelElement supplier) {\n1427: \tif (client == null || supplier == null) {\n1428: \t    throw new IllegalArgumentException(\"In buildUsage null arguments.\");\n1429: \t}\n1430: \tif (client.getModel() != supplier.getModel()) {\n1431: \t    throw new IllegalArgumentException(\"To construct a usage, the \"\n1432: \t\t\t\t\t       + \"client and the supplier \"\n1433: \t\t\t\t\t       + \"must be part of the same \"\n1434: \t\t\t\t\t       + \"model.\");\n1435: \t}\n1436: \tMUsage usage = UmlFactory.getFactory().getCore().createUsage();\n1437: \tusage.addSupplier(supplier);\n1438: \tusage.addClient(client);\n1439: \tif (supplier.getNamespace() != null)\n1440: \t    usage.setNamespace(supplier.getNamespace());\n1441: \telse if (client.getNamespa