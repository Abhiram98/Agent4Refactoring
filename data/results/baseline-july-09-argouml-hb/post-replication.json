es a classifierrole and adds it to the given collaboration\n138:      * @param collaboration the given collaboration\n139:      * @return the created classifier role\n140:      */\n141:     public Object buildClassifierRole(Object collaboration) {\n142:         if (ModelFacade.isACollaboration(collaboration)) {\n143:             Object classifierRole = createClassifierRole();\n144:             ModelFacade.addOwnedElement(collaboration, classifierRole);\n145:             return classifierRole;\n146:         }\n147:         throw new IllegalArgumentException(\"Argument is not a collaboration\");\n148:     }\n149: \n150:     /**\n151:      * Builds a default collaboration not attached to a classifier\n152:      *\n153:      * @param handle the namespace for the collaboration\n154:      * @return the created collaboration\n155:      */\n156:     public MCollaboration buildCollaboration(Object handle) {\n157:         if (ModelFacade.isANamespace(handle)) {\n158:             MNamespace namespace = (MNamespace) handle;\n159:             MCollaboration modelelement = createCollaboration();\n160:             modelelement.setNamespace(namespace);\n161:             modelelement.setName(\"newCollaboration\");\n162:             modelelement.setAbstract(false);\n163:             if (namespace instanceof MClassifier) {\n164:                 modelelement.setRepresentedClassifier((MClassifier) namespace);\n165:             }\n166:             return modelelement;\n167: \n168:         }\n169:         throw new IllegalArgumentException(\"Argument is not a namespace\");\n170:     }\n171: \n172:     /**\n173:      * Builds a collaboration that is owned by a certain namespace and\n174:      * represents the given represented element.\n175:      *\n176:      * @param namespace the namespace for the collaboration\n177:      * @param representedElement the represented element\n178:      * @return the created collaboration\n179:      */\n180:     public Object buildCollaboration(\n181:         Object namespace,\n182:         Object representedElement) {\n183:         if (ModelFacade.isANamespace(namespace)\n184:             && (ModelFacade.isAClassifier(representedElement)\n185:                 || ModelFacade.isAObject(representedElement))) {\n186:             Object collaboration = buildCollaboration(namespace);\n187:             if (ModelFacade.isAClassifier(representedElement)) {\n188:                 ModelFacade.setRepresentedClassifier(\n189:                     collaboration,\n190:                     representedElement);\n191: \t    }\n192:             if (ModelFacade.isAOperation(representedElement)) {\n193:                 ModelFacade.setRepresentedOperation(\n194:                     collaboration,\n195:                     representedElement);\n196: \t    }\n197:             return collaboration;\n198:         }\n199:         throw new IllegalArgumentException(\"Argument is not \"\n200: \t\t\t\t\t   + \"a namespace or element \"\n201: \t\t\t\t\t   + \"that can be represented \"\n202: \t\t\t\t\t   + \"by a collaboration\");\n203:     }\n204: \n205:     /**\n206:      * Builds an interaction belonging to some collaboration\n207:      *\n208:      * @param handle the collaboration that will be the context \n209:      * for the new interaction\n210:      * @return the newly build interaction\n211:      */\n212:     public MInteraction buildInteraction(Object handle) {\n213:         if (ModelFacade.isACollaboration(handle)) {\n214:             MCollaboration collab = (MCollaboration) handle;\n215:             MInteraction inter = createInteraction();\n216:             inter.setContext(collab);\n217:             inter.setName(\"newInteraction\");\n218:             return inter;\n219:         }\n220:         throw new IllegalArgumentException(\"Argument is not a collaboration\");\n221: \n222:     }\n223: \n224:     /**\n225:      * Builds an associationendrole based on some classifierrole\n226:      *\n227:      * @param atype the classifierrole\n228:      * @return the associationendrole\n229:      */\n230:     public MAssociationEndRole buildAssociationEndRole(Object atype) {\n231:         MClassifierRole type = (MClassifierRole) atype;\n232:         MAssociationEndRole end = createAssociationEndRole();\n233:         end.setType(type);\n234:         return end;\n235:     }\n236: \n237:     /**\n238:      * Builds a binary associationrole on basis of two classifierroles\n239:      *\n240:      * @param from the first classifierrole\n241:      * @param to the second classifierrole\n242:      * @return the newly build associationrole\n243:      */\n244:     public MAssociationRole buildAssociationRole(Object /*MClassifierRole*/\n245:     from, Object\n246:     /*MClassifierRole*/\n247:     to) {\n248:         MCollaboration colFrom =\n249: \t    (MCollaboration) ModelFacade.getNamespace(from);\n250:         MCollaboration colTo = (MCollaboration) ModelFacade.getNamespace(to);\n251:         if (colFrom != null && colFrom.equals(colTo)) {\n252:             MAssociationRole role = createAssociationRole();\n253:             // we do not create on basis of associations between the\n254:             // bases of the classifierroles\n255:             role.addConnection(buildAssociationEndRole(from));\n256:             role.addConnection(buildAssociationEndRole(to));\n257:             colFrom.addOwnedElement(role);\n258:             return role;\n259:         }\n260:         return null;\n261:     }\n262: \n263:     /**\n264:      * Builds a binary associationrole on basis of two classifierroles,\n265:      * navigation and aggregation\n266:      *\n267:      * @param from   the first classifierrole\n268:      * @param agg1   the first aggregationkind\n269:      * @param to     the second classifierrole\n270:      * @param agg2   the second aggregationkind\n271:      * @param unidirectional true if unidirectional\n272:      * @return the newly build assoc. role\n273:      */\n274:     public MAssociationRole buildAssociationRole(\n275:         MClassifierRole from,\n276:         MAggregationKind agg1,\n277:         MClassifierRole to,\n278:         MAggregationKind agg2,\n279:         Boolean unidirectional) {\n280:         MCollaboration colFrom = (MCollaboration) from.getNamespace();\n281:         MCollaboration colTo = (MCollaboration) to.getNamespace();\n282:         if (agg1 == null)\n283:             agg1 = MAggregationKind.NONE;\n284:         if (agg2 == null)\n285:             agg2 = MAggregationKind.NONE;\n286:         if (colFrom != null && colFrom.equals(colTo)) {\n287:             boolean nav1 = Boolean.FALSE.equals(unidirectional);\n288:             boolean nav2 = true;\n289:             MAssociationRole role = createAssociationRole();\n290:             // we do not create on basis of associations between the\n291:             // bases of the classifierroles\n292:             MAssociationEndRole fromEnd = buildAssociationEndRole(from);\n293:             fromEnd.setNavigable(nav1);\n294:             fromEnd.setAggregation(agg1);\n295:             role.addConnection(fromEnd);\n296: \n297:             MAssociationEndRole toEnd = buildAssociationEndRole(to);\n298:             toEnd.setNavigable(nav2);\n299:             toEnd.setAggregation(agg2);\n300:             role.addConnection(toEnd);\n301: \n302:             colFrom.addOwnedElement(role);\n303:             return role;\n304:         }\n305:         return null;\n306:     }\n307: \n308:     /**\n309:      * Builds an associationrole based on a given link. The link must\n310:      * have a source and a destination instance that both have a\n311:      * classifierrole as classifier.  The classifierroles must have\n312:      * the same collaboration as owner. This collaboration will be the\n313:      * new owner of the associationrole.\n314:      *\n315:      * @param link a UML Link\n316:      * @return the newly created association role (an Object)\n317:      */\n318:     public Object buildAssociationRole(Object link) {\n319:         if (ModelFacade.isALink(link)) {\n320:             Object from = org.argouml.model.uml.UmlHelperImpl.getHelper().getCore().getSource(link);\n321:             Object to = org.argouml.model.uml.UmlHelperImpl.getHelper().getCore().getDestination(link);\n322:             Object classifierRoleFrom =\n323:                 ModelFacade.getClassifiers(from).iterator().next();\n324:             Object classifierRoleTo =\n325:                 ModelFacade.getClassifiers(to).iterator().next();\n326:             Object collaboration = ModelFacade.getNamespace(classifierRoleFrom);\n327:             if (collaboration != ModelFacade.getNamespace(classifierRoleTo)) {\n328:                 throw new IllegalStateException(\"ClassifierRoles do not belong \"\n329: \t\t\t\t\t\t+ \"to the same collaboration\");\n330:             }\n331:             if (collaboration == null) {\n332:                 throw new IllegalStateException(\"Collaboration may not be \"\n333: \t\t\t\t\t\t+ \"null\");\n334:             }\n335:             Object associationRole = createAssociationRole();\n336:             ModelFacade.setNamespace(associationRole, collaboration);\n337:             ModelFacade.addLink(associationRole, link);\n338:             return associationRole;\n339:         }\n340:         throw new IllegalArgumentException(\"Argument is not a link\");\n341:     }\n342: \n343:     /**\n344:      * Builds a message within some interaction related to some\n345:      * assocationrole. The message is added as the last in the\n346:      * interaction sequence. Furthermore, the message is added as the\n347:      * last to the list of messages allready attached to the\n348:      * role. Effectively, the allready attached messages become\n349:      * predecessors of this message.\n350:      */\n351:     private MMessage buildMessageInteraction(MInteraction inter,\n352: \t\t\t\t\t     MAssociationRole role) {\n353:         if (inter == null || role == null)\n354:             return null;\n355: \n356:         MMessage message = createMessage();\n357: \n358:         inter.addMessage(message);\n359: \n360:         message.setCommunicationConnection(role);\n361: \n362:         if (role.getConnections().size() == 2) {\n363:             message.setSender(\n364:                     (MClassifierRole) role.getConnection(0).getType());\n365:             message.setReceiver(\n366:                 (MClassifierRole) role.getConnection(1).getType());\n367: \n368:             Collection messages = message.getSender().getMessages1();\n369:             MMessage lastMsg = lastMessage(messages, message);\n370: \n371:             if (lastMsg != null) {\n372:                 message.setActivator(lastMsg);\n373:                 messages = lastMsg.getMessages4();\n374:             } else {\n375:                 messages = message.getSender().getMessages2();\n376:             }\n377: \n378:             lastMsg = lastMessage(messages, message);\n379:             if (lastMsg != null)\n380:                 message.addPredecessor(findEnd(lastMsg));\n381: \n382:         }\n383: \n384:         return message;\n385:     }\n386: \n387:     /**\n388:      * Finds the last message in the collection not equal to null and not\n389:      * equal to m.\n390:      *\n391:      * @param c A collection containing exclusively MMessages.\n392:      * @param m A MMessage.\n393:      * @return The last message in the collection, or null.\n394:      */\n395:     private MMessage lastMessage(Collection c, MMessage m) {\n396:         MMessage last = null;\n397:         Iterator it = c.iterator();\n398:         while (it.hasNext()) {\n399:             MMessage msg = (MMessage) it.next();\n400:             if (msg != null && msg != m)\n401:                 last = msg;\n402:         }\n403:         return last;\n404:     }\n405: \n406:     /**\n407:      * Walks the tree of successors to m rooted until a leaf is found. The\n408:      * leaf is the returned. If m is itself a leaf, then m is returned.\n409:      *\n410:      * @param m A MMessage.\n411:      * @return The last message in one branch of the tree rooted at m.\n412:      */\n413:     private MMessage findEnd(MMessage m) {\n414:         while (true) {\n415:             Collection c = m.getMessages3();\n416:             Iterator it = c.iterator();\n417:             if (!it.hasNext())\n418:                 return m;\n419:             m = (MMessage) it.next();\n420:         }\n421:     }\n422: \n423:     /**\n424:      * Builds a message within some collaboration or interaction.\n425:      *\n426:      * @param acollab a collaboration or interaction\n427:      * @param arole an associationrole\n428:      * @return the newly build message\n429:      */\n430:     public Object buildMessage(Object acollab, Object arole) {\n431: \tif (ModelFacade.isACollaboration(acollab)) {\n432: \t    return buildMessageCollab(acollab, arole);\n433: \t} \n434: \tif (ModelFacade.isAInteraction(acollab)) {\n435: \t    return buildMessageInteraction((MInteraction) acollab,\n436: \t\t\t\t\t   (MAssociationRole) arole);\n437: \t}\n438: \tthrow new IllegalArgumentException(\"No valid object \" + acollab);\n439:     }\n440: \n441:     private Object buildMessageCollab(Object acollab, Object arole) {\n442:         MCollaboration collab = (MCollaboration) acollab;\n443:         MAssociationRole role = (MAssociationRole) arole;\n444:         MInteraction inter = null;\n445:         if (collab.getInteractions().size() == 0) {\n446:             inter = buildInteraction(collab);\n447:         } else {\n448:             inter = (MInteraction) (collab.getInteractions().toArray())[0];\n449:         }\n450:         return buildMessageInteraction(inter, role);\n451:     }\n452: \n453:     /**\n454:      * Builds an activator for some message\n455:      *\n456:      * @param owner the owner\n457:      * @param interaction the interaction\n458:      * @return the newly build message\n459:      */\n460:     public MMessage buildActivator(MM