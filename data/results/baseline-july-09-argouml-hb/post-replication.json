vent.MouseListener;\n32: import java.beans.PropertyChangeEvent;\n33: import java.util.ArrayList;\n34: import java.util.Iterator;\n35: import java.util.List;\n36: import java.util.ListIterator;\n37: \n38: import org.argouml.model.Model;\n39: import org.argouml.model.ModelEventPump;\n40: import org.argouml.uml.diagram.sequence.ActivationNode;\n41: import org.argouml.uml.diagram.sequence.EmptyNode;\n42: import org.argouml.uml.diagram.sequence.LifeLinePort;\n43: import org.argouml.uml.diagram.sequence.LinkNode;\n44: import org.argouml.uml.diagram.sequence.LinkPort;\n45: import org.argouml.uml.diagram.sequence.Node;\n46: import org.argouml.uml.diagram.sequence.ObjectNode;\n47: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n48: import org.tigris.gef.base.Globals;\n49: import org.tigris.gef.base.Layer;\n50: import org.tigris.gef.presentation.Fig;\n51: import org.tigris.gef.presentation.FigEdge;\n52: import org.tigris.gef.presentation.FigLine;\n53: import org.tigris.gef.presentation.FigRect;\n54: import org.tigris.gef.presentation.FigText;\n55: \n56: /**\n57:  * Fig to show an object on a sequence diagram. The fig consists of an\n58:  * upper box that shows the name of the object (the owner) and a\n59:  * lifeline. The lifeline consists of lifeline elements. An element\n60:  * can be a dashed line (no link attached) or a rectangle (link\n61:  * attached).\n62:  * @author jaap.branderhorst@xs4all.nl\n63:  * Aug 11, 2003\n64:  */\n65: public class FigClassifierRole extends FigNodeModelElement implements MouseListener {\n66:     /**\n67:     * The width of an activation box\n68:     */\n69:     public static final int WIDTH = 20;\n70: \n71:     /**\n72:      * The margin between the outer box and the name and stereotype text box.\n73:      */\n74:     public static final int MARGIN = 10;\n75: \n76:     /**\n77:      * The distance between two rows in the object rectangle.\n78:      */\n79:     public static final int ROWDISTANCE = 2;\n80: \n81:     /**\n82:      * The defaultheight of the object rectangle. That's 3 times the rowheight +\n83:      * 3 times a distance of 2 between the rows + the stereoheight.\n84:      */\n85:     public static final int DEFAULT_HEIGHT =\n86:         (3 * ROWHEIGHT + 3 * ROWDISTANCE + STEREOHEIGHT);\n87: \n88:     /**\n89:     * The defaultwidth of the object rectangle\n90:     */\n91:     public static final int DEFAULT_WIDTH = 3 * DEFAULT_HEIGHT / 2;\n92: \n93:     /**\n94:      * The outer black rectangle of the object box (object fig without\n95:      * lifeline).\n96:      */\n97:     private FigRect outerBox;\n98: \n99:     /**\n100:      * The filled box for the object box (object fig without lifeline).\n101:      */\n102:     private FigRect backgroundBox;\n103: \n104:     /**\n105:      * The lifeline (dashed line under the object box to which activations are\n106:      * attached)\n107:      */\n108:     private FigLine lifeLine;\n109: \n110:     /**\n111:      * The owner of the lifeline.\n112:      */\n113:     private LifeLinePort lifeLinePort;\n114: \n115:     /**\n116:      * The list where the nodes to which links can be attached are stored\n117:      */\n118:     private List linkPositions = new ArrayList();\n119: \n120:     /**\n121:      * The list where the figrects are stored that are the activation\n122:      * boxes. The list is only here for performance issues. When\n123:      * removing a figrect, it should also be removed from this list,\n124:      * not only from the figs list.\n125:      */\n126:     private List figActivations = new ArrayList();\n127: \n128:     /**\n129:      * The list with the figLinkPorts. The list is only here for\n130:      * performance issues. When deleting a figLinkPort, it should also\n131:      * be removed from this list, not only from the figs list.\n132:      */\n133:     private List figFigLinkPorts = new ArrayList();\n134: \n135:     /**\n136:      * The comma seperated list of base names of the classifierRole(s)\n137:      * that this