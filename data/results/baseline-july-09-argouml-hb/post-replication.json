ble unless mouse enters\n86:         Rectangle r = getBounds();\n87:         setBoundsInternal(r.x, r.y, r.width, r.height);\n88:     }\n89: \n90:     /**\n91:      * Constructor FigActionState\n92:      * @param gm ignored!\n93:      * @param node owner\n94:      */\n95:     public FigActionState(GraphModel gm, Object node) {\n96:         this();\n97:         setOwner(node);\n98:     }\n99: \n100:     /**\n101:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#placeString()\n102:      */\n103:     public String placeString() {\n104:         return \"new ActionState\";\n105:     }\n106: \n107:     /**\n108:      * @see java.lang.Object#clone()\n109:      */\n110:     public Object clone() {\n111:         FigActionState figClone = (FigActionState) super.clone();\n112:         Iterator it = figClone.getFigs().iterator();\n113:         figClone.setBigPort((FigRRect) it.next());\n114:         figClone.cover = (FigRRect) it.next();\n115:         figClone.setNameFig((FigText) it.next());\n116:         return figClone;\n117:     }\n118: \n119:     ////////////////////////////////////////////////////////////////\n120:     // Fig accessors\n121: \n122:     /**\n123:      * @see org.tigris.gef.presentation.Fig#getMinimumSize()\n124:      */\n125:     public Dimension getMinimumSize() {\n126:         Dimension nameDim = getNameFig().getMinimumSize();\n127:         int w = nameDim.width + PADDING * 2;\n128:         int h = nameDim.height + PADDING;\n129:         return new Dimension(w, h);\n130:     }\n131: \n132:     /**\n133:      * Override setBounds to keep shapes looking right\n134:      * @see org.tigris.gef.presentation.Fig#setBounds(int, int, int, int)\n135:      */\n136:     public void setBoundsInternal(int x, int y, int w, int h) {\n137:         if (getNameFig() == null) return;\n138:         Rectangle oldBounds = getBounds();\n139: \n140:         getNameFig().setBounds(x + PADDING, y, w - PADDING * 2, h - PADDING);\n141:         getBigPort().setBounds(x + 1, y + 1, w - 2, h - 2);\n142:         cover.setBounds(x, y, w, h);\n143:         ((FigRRect) getBigPort()).setCornerRadius(h);\n144:         cover.setCornerRadius(h);\n145: \n146:         calcBounds();\n147:         updateEdges();\n148:         firePropChange(\"bounds\", oldBounds, getBounds());\n149:     }\n150: \n151:     /**\n152:      * @see org.tigris.gef.presentation.Fig#setLineColor(java.awt.Color)\n153:      */\n154:     public void setLineColor(Color col) {\n155:         cover.setLineColor(col);\n156:     }\n157: \n158:     /**\n159:      * @see org.tigris.gef.presentation.Fig#getLineColor()\n160:      */\n161:     public Color getLineColor() {\n162:         return cover.getLineColor();\n163:     }\n164: \n165:     /**\n166:      * @see org.tigris.gef.presentation.Fig#setFillColor(java.awt.Color)\n167:      */\n168:     public void setFillColor(Color col) {\n169:         cover.setFillColor(col);\n170:     }\n171: \n172:     /**\n173:      * @see org.tigris.gef.presentation.Fig#getFillColor()\n174:      */\n175:     public Color getFillColor() {\n176:         return cover.getFillColor();\n177:     }\n178: \n179:     /**\n180:      * @see org.tigris.gef.presentation.Fig#setFilled(boolean)\n181:      */\n182:     public void setFilled(boolean f) {\n183:         cover.setFilled(f);\n184:     }\n185: \n186:     /**\n187:      * @see org.tigris.gef.presentation.Fig#getFilled()\n188:      */\n189:     public boolean getFilled() {\n190:         return cover.getFilled();\n191:     }\n192: \n193:     /**\n194:      * @see org.tigris.gef.presentation.Fig#setLineWidth(int)\n195:      */\n196:     public void setLineWidth(int w) {\n197:         cover.setLineWidth(w);\n198:     }\n199: \n200:     /**\n201:      * @see org.tigris.gef.presentation.Fig#getLineWidth()\n202:      */\n203:     public int getLineWidth() {\n204:         return cover.getLineWidth();\n205:     }\n206: \n207:     /**\n208:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#modelChanged(java