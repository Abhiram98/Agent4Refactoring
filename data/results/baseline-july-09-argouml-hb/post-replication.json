Polygon;\n32: import java.awt.Rectangle;\n33: import java.awt.event.InputEvent;\n34: import java.awt.event.KeyEvent;\n35: import java.awt.event.KeyListener;\n36: import java.awt.event.MouseEvent;\n37: import java.awt.event.MouseListener;\n38: import java.beans.PropertyChangeEvent;\n39: import java.beans.PropertyChangeListener;\n40: import java.beans.VetoableChangeListener;\n41: import java.util.Iterator;\n42: \n43: import javax.swing.SwingUtilities;\n44: \n45: import org.apache.log4j.Logger;\n46: import org.argouml.kernel.DelayedChangeNotify;\n47: import org.argouml.kernel.DelayedVChangeListener;\n48: import org.argouml.model.AttributeChangeEvent;\n49: import org.argouml.model.Model;\n50: import org.argouml.uml.diagram.ui.FigMultiLineText;\n51: import org.argouml.uml.diagram.ui.FigNodeModelElement;\n52: import org.tigris.gef.base.Geometry;\n53: import org.tigris.gef.base.Selection;\n54: import org.tigris.gef.graph.GraphModel;\n55: import org.tigris.gef.presentation.Fig;\n56: import org.tigris.gef.presentation.FigPoly;\n57: import org.tigris.gef.presentation.FigRect;\n58: import org.tigris.gef.presentation.FigText;\n59: \n60: /**\n61:  * Class to display a UML comment in a diagram.\n62:  *\n63:  * @author Andreas Rueckert\n64:  */\n65: public class FigComment\n66:     extends FigNodeModelElement\n67:     implements VetoableChangeListener,\n68: \t       DelayedVChangeListener,\n69: \t       MouseListener,\n70: \t       KeyListener,\n71: \t       PropertyChangeListener {\n72:     /**\n73:      * Logger.\n74:      */\n75:     private static final Logger LOG = Logger.getLogger(FigComment.class);\n76: \n77:     ////////////////////////////////////////////////////////////////\n78:     // constants\n79: \n80:     private int x = 0;\n81:     private int y = 0;\n82:     private int width = 80;\n83:     private int height = 60;\n84:     private int dogear = 10; // a dog-ear = a bent corner in a book\n85: \n86:     private boolean readyToEdit = true;\n87: \n88:     ////////////////////////////////////////////////////////////////\n89:     // instance variables\n90: \n91:     // The figure that holds the text of the body.\n92:     private FigText bodyTextFig;\n93: \n94:     private FigPoly outlineFig;\n95:     private FigPoly urCorner; // the upper right corner\n96:     \n97:     /**\n98:      * Flag to indicate that we have just been created. This is to fix the\n99:      * problem with loading comments that have stereotypes already\n100:      * defined.<p>\n101:      */\n102:     private boolean newlyCreated = false;\n103: \n104:     ////////////////////////////////////////////////////////////////\n105:     // constructors\n106: \n107:     /**\n108:      * The main constructor used for file loading.\n109:      */\n110:     public FigComment() {\n111: \n112:         outlineFig = new FigPoly(Color.black, Color.white);\n113:         outlineFig.addPoint(x, y);\n114:         outlineFig.addPoint(x + width - 1 - dogear, y);\n115:         outlineFig.addPoint(x + width - 1, y + dogear);\n116:         outlineFig.addPoint(x + width - 1, y + height - 1);\n117:         outlineFig.addPoint(x, y + height - 1);\n118:         outlineFig.addPoint(x, y);\n119:         outlineFig.setFilled(true);\n120:         outlineFig.setLineWidth(1);\n121: \n122:         urCorner = new FigPoly(Color.black, Color.white);\n123:         urCorner.addPoint(x + width - 1 - dogear, y);\n124:         urCorner.addPoint(x + width - 1, y + dogear);\n125:         urCorner.addPoint(x + width - 1 - dogear, y + dogear);\n126:         urCorner.addPoint(x + width - 1 - dogear, y);\n127:         urCorner.setFilled(true);\n128:         Color col = outlineFig.getFillColor();\n129:         urCorner.setFillColor(col.darker());\n130:         urCorner.setLineWidth(1);\n131: \n132:         setBigPort(new FigRect(x, y, width, height, null, null));\n133:         getBigPort().setFilled(false);\n134:         getBigPort().setLineWidth(0);\n135: \n136:         bodyTextFig = new FigMultiLineText(x + 2, y + 2, width - 2 - dogear, height - 4, true);\n137: \n138:         // add Figs to the FigNode in back-to-front order\n139:         addFig(getBigPort());\n140:         addFig(outlineFig);\n141:         addFig(urCorner);\n142:         addFig(getStereotypeFig());\n143:         addFig(bodyTextFig);\n144: \n145:         setBlinkPorts(false); //make port invisble unless mouse enters\n146:         Rectangle r = getBounds();\n147:         setBounds(r.x, r.y, r.width, r.height);\n148:         updateEdges();\n149: \n150:         readyToEdit = false;\n151:         // Mark this as newly created. This is to get round the problem with\n152:         // creating figs for loaded comments that had stereotypes. They are\n153:         // saved with their dimensions INCLUDING the stereotype, but since we\n154:         // pretend the stereotype is not visible, we add height the first time\n155:         // we render such a comment. This is a complete fudge, and really we\n156:         // ought to address how comment objects with stereotypes are saved. But\n157:         // that will be hard work.\n158:         newlyCreated = true;\n159:     }\n160: \n161:     /**\n162:      * Construct a new comment.\n163:      *\n164:      * @param gm the graphmodel\n165:      * @param node the underlying UML Comment\n166:      */\n167:     public FigComment(GraphModel gm, Object node) {\n168:         this();\n169:         setOwner(node);\n170:     }\n171: \n172:     /**\n173:      * Get the default text for this figure.\n174:      *\n175:      * @return The default text for this figure.\n176:      */\n177:     public String placeString() {\n178:         String placeString = retrieveBody();\n179:         if (placeString == null) {\n180:             placeString = \"new note\";\n181:         }\n182:         return placeString;\n183:     }\n184: \n185:     /**\n186:      * Clone this figure.\n187:      *\n188:      * @return The cloned figure.\n189:      */\n190:     public Object clone() {\n191:         FigComment figClone = (FigComment) super.clone();\n192:         Iterator thisIter = this.getFigs().iterator();\n193:         while (thisIter.hasNext()) {\n194:             Object thisFig = thisIter.next();\n195:             if (thisFig == outlineFig) {\n196:                 figClone.outlineFig = (FigPoly) thisFig;\n197:             }\n198:             if (thisFig == urCorner) {\n199:                 figClone.urCorner = (FigPoly) thisFig;\n200:             }\n201:             if (thisFig == bodyTextFig) {\n202:                 figClone.bodyTextFig = (FigText) thisFig;\n203:             }\n204:         }\n205:         return figClone;\n206:     }\n207: \n208:     ////////////////////////////////////////////////////////////////\n209:     // event handlers\n210: \n211:     /**\n212:      * See FigNodeModelElement.java for more info on these methods.\n213:      */\n214: \n215:     /**\n216:      * If the user double clicks on any part of this FigNode, pass it\n217:      * down to one of the internal Figs.  This allows the user to\n218:      * initiate direct text editing.\n219:      *\n220:      * @see java.awt.event.MouseListener#mouseClicked(java.awt.event.MouseEvent)\n221:      */\n222:     public void mouseClicked(MouseEvent me) {\n223:         if (!readyToEdit) {\n224:             if (Model.getFacade().isAModelElement(getOwner())) {\n225:                 readyToEdit = true;\n226:             } else {\n227:                 LOG.debug(\"not ready to edit note\");\n228:                 return;\n229:             }\n230:         }\n231:         if (me.isConsumed()) {\n232:             return;\n233:         }\n234:         if (me.getClickCount() >= 2\n235: \t    && !(me.isPopupTrigger()\n236: \t\t || me.getModifiers() == InputEvent.BUTTON3_MASK)) {\n237:             if (getOwner() == null) {\n238:                 return;\n239:             }\n240:             Fig f = hitFig(new Rectangle(me.getX() - 2, me.getY() - 2, 4, 4));\n241:             if (f instanceof MouseListener) {\n242:                 ((MouseListener) f).mouseClicked(me);\n243:             }\n244:         }\n245:         me.consume();\n246:     }\n247: \n248:     /**\n249:      * @see java.beans.VetoableChangeListener#vetoableChange(java.beans.PropertyChangeEvent)\n250:      */\n251:     public void vetoableChange(PropertyChangeEvent pce) {\n252:         Object src = pce.getSource();\n253:         if (src == getOwner()) {\n254:             DelayedChangeNotify delayedNotify =\n255: \t\tnew DelayedChangeNotify(this, pce);\n256:             SwingUtilities.invokeLater(delayedNotify);\n257:         } else {\n258:             LOG.debug(\"FigNodeModelElement got vetoableChange\"\n259: \t\t      + \" from non-owner:\" + src);\n260:         }\n261:     }\n262: \n263:     /**\n264:      * @see org.argouml.kernel.DelayedVChangeListener#delayedVetoableChange(java.beans.PropertyChangeEvent)\n265:      */\n266:     public void delayedVetoableChange(PropertyChangeEvent pce) {\n267:         // update any text, colors, fonts, etc.\n268:         renderingChanged();\n269:         // update the relative sizes and positions of internel Figs\n270:         endTrans();\n271:     }\n272: \n273:     /**\n274:      * @see java.beans.PropertyChangeListener#propertyChange(java.beans.PropertyChangeEvent)\n275:      */\n276:     public void propertyChange(PropertyChangeEvent pve) {\n277:         Object src = pve.getSource();\n278:         String pName = pve.getPropertyName();\n279:         if (pName.equals(\"editing\")\n280: \t    && Boolean.FALSE.equals(pve.getNewValue())) {\n281:             //parse the text that was edited\n282:             textEdited((FigText) src);\n283:             // resize the FigNode to accomodate the new text\n284:             Rectangle bbox = getBounds();\n285:             Dimension minSize = getMinimumSize();\n286:             bbox.width = Math.max(bbox.width, minSize.width);\n287:             bbox.height = Math.max(bbox.height, minSize.height);\n288:             setBounds(bbox.x, bbox.y, bbox.width, bbox.height);\n289:             endTrans();\n290:         } else {\n291:             super.propertyChange(pve);\n292:         }\n293:     }\n294: \n295:     /**\n296:      * @see java.awt.event.KeyListener#keyPressed(java.awt.event.KeyEvent)\n297:      */\n298:     public void keyPressed(KeyEvent ke) {\n299:         if (!readyToEdit) {\n300:             if (Model.getFacade().isAModelElement(getOwner())) {\n301:                 storeBody(\"\");\n302:                 readyToEdit = true;\n303:             } else {\n304:                 LOG.debug(\"not ready to edit note\");\n305:                 return;\n306:             }\n307:         }\n308:         if (ke.isConsumed()) {\n309:             return;\n310:         }\n311:         if (getOwner() == null) {\n312:             return;\n313:         }\n314:         bodyTextFig.keyPressed(ke);\n315:     }\n316: \n317:     /**\n318:      * Not used, do nothing.\n319:      *\n320:      * @see java.awt.event.KeyListener#keyReleased(java.awt.event.KeyEvent)\n321:      */\n322:     public void keyReleased(KeyEvent ke) {\n323:     }\n324: \n325:     /**\n326:      * @see java.awt.event.KeyListener#keyTyped(java.awt.event.KeyEvent)\n327:      */\n328:     public void keyTyped(KeyEvent ke) {\n329:     }\n330: \n331:     ////////////////////////////////////////////////////////////////\n332:     // Fig accessors\n333: \n334:     /**\n335:      * @see org.tigris.gef.presentation.Fig#makeSelection()\n336:      */\n337:     public Selection makeSelection() {\n338:         return new SelectionComment(this);\n339:     }\n340: \n341:     /**\n342:      * @see org.tigris.gef.presentation.Fig#setLineColor(java.awt.Color)\n343:      */\n344:     public void setLineColor(Color col) {\n345:         // The _text element has no border, so the line color doesn't matter.\n346:         outlineFig.setLineColor(col);\n347:         urCorner.setLineColor(col);\n348:     }\n349: \n350:     /**\n351:      * @see org.tigris.gef.presentation.Fig#getLineColor()\n352:      */\n353:     public Color getLineColor() {\n354:         return outlineFig.getLineColor();\n355:     }\n356: \n357:     /**\n358:      * @see org.tigris.gef.presentation.Fig#setFillColor(java.awt.Color)\n359:      */\n360:     public void setFillColor(Color col) {\n361:         outlineFig.setFillColor(col);\n362:         urCorner.setFillColor(col);\n363:     }\n364: \n365:     /**\n366:      * @see org.tigris.gef.presentation.Fig#getFillColor()\n367:      */\n368:     public Color getFillColor() {\n369:         return outlineFig.getFillColor();\n370:     }\n371: \n372:     /**\n373:      * @see org.tigris.gef.presentation.Fig#setFilled(boolean)\n374:      */\n375:     public void setFilled(boolean f) {\n376:         bodyTextFig.setFilled(false); // The text is always opaque.\n377:         outlineFig.setFilled(f);\n378:         urCorner.setFilled(f);\n379:     }\n380: \n381:     /**\n382:      * @see org.tigris.gef.presentation.Fig#getFilled()\n383:      */\n384:     public boolean getFilled() {\n385:         return outlineFig.getFilled();\n386:     }\n387: \n388:     /**\n389:      * @see org.tigris.gef.presentation.Fig#setLineWidth(int)\n390:      */\n391:     public void setLineWidth(int w) {\n392:         bodyTextFig.setLineWidth(0); // Make a seamless integration of the text\n393:         // in the note figure.\n394:         outlineFig.setLineWidth(w);\n395:         urCorner.setLineWidth(w);\n396:     }\n397: \n398:     /**\n399:      * @see org.tigris.gef.presentation.Fig#getLineWidth()\n400:      */\n401:     public int getLineWidth() {\n402:         return outlineFig.getLineWidth();\n403:     }\n404: \n405:     ////////////////////////////////////////////////////////////////\n406:     // user interaction methods\n407: \n408:     /**\n409:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEdited(org.tigris.gef.presentation.FigText)\n410:      */\n411:     protected void textEdited(FigText ft) {\n412:         if (ft == bodyTextFig) {\n413:             storeBody(ft.getText());\n414:         }\n415:     }\n416:     \n417:     /**\n418:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#textEditStarted(org.tigris.gef.presentation.FigText)\n419:      */\n420:     protected void textEditStarted(FigText ft) {\n421:         showHelp(\"parsing.help.comment\");\n422:     }\n423:     \n424:     /**\n425:      * @see org.tigris.gef.presentation.Fig#setEnclosingFig(org.tigris.gef.presentation.Fig)\n426:      */\n427:     public void setEnclosingFig(Fig encloser) {\n428:         super.setEnclosingFig(encloser);\n429:     }\n430: \n431:     ////////////////////////////////////////////////////////////////\n432:     // accessor methods\n433: \n434:     /**\n435:      * Store the body in the associated model element.\n436:      *\n437:      * @param body The note to store.\n438:      */\n439:     public final void storeBody(String body) {\n440:         if (getOwner() != null) {\n441:             Model.getCoreHelper().setBody(getOwner(), body);\n442:         }\n443:     }\n444: \n445:     /**\n446:      * Retrieve the note from the associated model element.\n447:      *\n448:      * @return The note from the associated model element.\n449:      */\n450:     private String retrieveBody() {\n451:         return (getOwner() != null)\n452:             ? (String) Model.getFacade().getBody(getOwner())\n453:             : null;\n454:     }\n455: \n456:     /**\n457:      * @see org.tigris.gef.presentation.Fig#getUseTrapRect()\n458:      */\n459:     public boolean getUseTrapRect() {\n460:         return true;\n461:     }\n462: \n463:     /**\n464:      * Get the minimum size for the note figure.\n465:      *\n466:      * @return The minimum size for the note figure.\n467:      */\n468:     public Dimension getMinimumSize() {\n469: \n470:         // Get the size of the text field.\n471:         Dimension aSize = bodyTextFig.getMinimumSize();\n472: \n473:         // If we have a stereotype displayed, then allow some space for that\n474:         // (width and height)\n475: \n476:         if (getStereotypeFig().isVisible()) {\n477:             Dimension stereoMin = getStereotypeFig().getMinimumSize();\n478:             aSize.width =\n479:                 Math.max(aSize.width,\n480:                          stereoMin.width);\n481:             aSize.height += stereoMin.height;\n482:         }\n483:         \n484:         // And add the gaps around the textfield to get the minimum\n485:         // size of the note.\n486:         return new Dimension(aSize.width + 4 + dogear,\n487: \t\t\t     aSize.height + 4);\n488:     }\n489: \n490:     /**\n491:      * @see org.tigris.gef.presentation.Fig#setBounds(int, int, int, int)\n492:      */\n493:     protected void setBoundsImpl(int px, int py, int w, int h) {\n494:         if (bodyTextFig == null) {\n495:             return;\n496:         }\n497:         \n498:         Dimension stereoMin = getStereotypeFig().getMinimumSize();\n499:         \n500:         int stereotypeHeight = 0;\n501:         if (getStereotypeFig().isVisible()) {\n502:             stereotypeHeight = stereoMin.height;\n503:         }\n504:         \n505:         Rectangle oldBounds = getBounds();\n506: \n507:         // Resize the text figure\n508:         bodyTextFig.setBounds(px + 2, py + 2 + stereotypeHeight, \n509:                 w - 4 - dogear, h - 4 - stereotypeHeight);\n510: \n511:         getStereotypeFig().setBounds(px + 2, py + 2,\n512:                 w - 4 - dogear, stereoMin.height);\n513:         \n514:         // Resize the big port around the figure\n515:         getBigPort().setBounds(px, py, w, h);\n516: \n517:         // Since this is a complex polygon, there's no easy way to resize it.\n518:         Polygon newPoly = new Polygon();\n519:         newPoly.addPoint(px, py);\n520:         newPoly.addPoint(px + w - 1 - dogear, py);\n521:         newPoly.addPoint(px + w - 1, py + dogear);\n522:         newPoly.addPoint(px + w - 1, py + h - 1);\n523:         newPoly.addPoint(px, py + h - 1);\n524:         newPoly.addPoint(px, py);\n525:         outlineFig.setPolygon(newPoly);\n526: \n527:         // Just move the corner to it's new position.\n528:         urCorner.setBounds(px + w - 1 - dogear, py, dogear, dogear);\n529: \n530:         calcBounds(); //_x = x; _y = y; _w = w; _h = h;\n531:         firePropChange(\"bounds\", oldBounds, getBounds());\n532:     }\n533: \n534:     /**\n535:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateBounds()\n536:      */\n537:     protected void updateBounds() {\n538:         Rectangle bbox = getBounds();\n539:         Dimension minSize = getMinimumSize();\n540:         bbox.width = Math.max(bbox.width, minSize.width);\n541:         bbox.height = Math.max(bbox.height, minSize.height);\n542:         setBounds(bbox.x, bbox.y, bbox.width, bbox.height);\n543:     }\n544: \n545:     ///////////////////////////////////////////////////////////////////\n546:     // Internal methods\n547: \n548:     /**\n549:      * This is called after any part of the UML ModelElement (the comment) has\n550:      * changed. This method automatically updates the note FigText.\n551:      *\n552:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#modelChanged(java.beans.PropertyChangeEvent)\n553:      */\n554:     protected final void modelChanged(PropertyChangeEvent mee) {\n555:         super.modelChanged(mee);\n556: \n557:         if (mee instanceof AttributeChangeEvent\n558:                 && mee.getPropertyName().equals(\"body\")) {\n559:             \n560:             bodyTextFig.setText(mee.getNewValue().toString());\n561:             calcBounds();\n562:             setBounds(getBounds());\n563:             damage();\n564:         }\n565:     }\n566: \n567: //    /**\n568: //     * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateNameText()\n569: //     */\n570: //    protected void updateNameText() {\n571: //        if (getOwner() != null) {\n572: //            String t = Model.getFacade().getName(getOwner());\n573: //            if (t != null) {\n574: //                bodyTextFig.setText(t);\n575: //                calcBounds();\n576: //                setBounds(getBounds());\n577: //            }\n578: //        }\n579: //    }\n580: \n581:     /**\n582:      * @see org.argouml.uml.diagram.ui.FigNodeModelElement#updateStereotypeText()\n583:      */\n584:     protected void updateStereotypeText() {\n585:         Object me = /*(MModelElement)*/ getOwner();\n586: \n587:         if (me == null) {\n588:             return;\n589:         }\n590: \n591:         Rectangle rect = getBounds();\n592: \n593:         Dimension stereoMin = getStereotypeFig().getMinimumSize();\n594:         \n595:         if (Model.getFacade().getStereotypes(me).isEmpty()) {\n596: \n597:             if (getStereotypeFig().isVisible()) {\n598:                 getStereotypeFig().setVisible(false);\n599:                 rect.y += stereoMin.height;\n600:                 rect.height -= stereoMin.height;\n601:                 setBounds(rect.x, rect.y, rect.width, rect.height);\n602:                 calcBounds();\n603:             }\n604:         } else {\n605:             getStereotypeFig().setOwner(getOwner());\n606: \n607:             if (!getStereotypeFig().isVisible()) {\n608:                 getStereotypeFig().setVisible(true);\n609: \n610:                 // Only adjust the stereotype height if we are not newly\n611:                 // created. This gets round the problem of loading classes with\n612:                 // stereotypes defined, which have the height already including\n613:                 // the stereotype.\n614: \n615:                 if (!newlyCreated) {\n616:                     rect.y -= stereoMin.height;\n617:                     rect.height += stereoMin.height;\n618:                     rect.width = \n619:                         Math.max(getMinimumSize().width, rect.width);\n620:                     setBounds(rect.x, rect.y, rect.width, rect.height);\n621:                     calcBounds();\n622:                 }\n623:             }\n624:         }\n625:         // Whatever happened we are no longer newly created, so clear the\n626:         // flag. Then set the bounds for the rectangle we have defined.\n627:         newlyCreated = false;\n628:     }\n629: \n630:     /**\n631:      * @see org.tigris.gef.presentation.Fig#getClosestPoint(java.awt.Point)\n632:      */\n633:     public Point getClosestPoint(Point anotherPt) {\n634:         Rectangle r = getBounds();\n635:         int xs[] = {r.x, r.x + r.width - dogear, r.x + r.width, \n636:                     r.x + r.width,  r.x,            r.x};\n637:         int ys[] = {r.y, r.y,                    r.y + dogear,\n638:                     r.y + r.height, r.y + r.height, r.y};\n639:         Point p = Geometry.ptClosestTo(\n640:                 xs, \n641:                 ys,\n642:                 6 , anotherPt);\n643:         return p;\n644:     }\n645: \n646:     public void paint(Graphics g) {\n647:         Color col = outlineFig.getFillColor();\n648:         urCorner.setFillColor(col.darker());\n649:         super.paint(g);\n650:     }\n651: } /* end class FigComment */\n652: ",
